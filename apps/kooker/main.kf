import content
import kof.process

Bool printUsage() {
    println("Usage:")
    println("  kooker cook <glb|aseprite|vox|map|blockbench|png|wav> <input> <output>")
    println("  kooker cook dust3d <input.ds3> <export.glb> <output>")
    println("  kooker package <chunk-kind> <input> <logical-path> <output.kpkg>")
    println("  kooker inspect-package <input.kpkg>")
    println("  kooker validate-package <input.kpkg>")
    return false
}

Bool cookPaths(
    String kind, String input, String paired, String output
) {
    var kooker = BoundedSourceFileKooker(16777216)
    if (!kooker.cook(kind, input, paired, output, 1, 1, 1, 1, 1, 1000)) {
        println("cook-rejected diagnostic=" + kooker.diagnostic() +
            " source=" + kooker.result().diagnostic())
        return false
    }
    var result = kooker.result()
    if (kind == "blockbench") {
        var character = kooker.blockbench()
        println("cooked kind=" + result.sourceKind() +
            " source=" + result.sourceChecksum() +
            " model=" + character.modelFormatChecksum() +
            " character=" + result.geometryChecksum() +
            " bones=" + result.metadataChecksum() +
            " animation=" + result.entityChecksum() +
            " canonical=" + result.visibilityChecksum() +
            " bone-count=" + character.boneCount() +
            " cube-count=" + character.cubeCount() +
            " clip-count=" + character.animationCount() +
            " keyframe-count=" + character.keyframeCount() +
            " bytes=" + kooker.outputLength())
        return true
    }
    if (kind == "png") {
        var image = kooker.png()
        println("cooked kind=" + result.sourceKind() +
            " source=" + result.sourceChecksum() +
            " pixels=" + result.materialChecksum() +
            " metadata=" + result.metadataChecksum() +
            " canonical=" + result.visibilityChecksum() +
            " width=" + image.width() +
            " height=" + image.height() +
            " color-type=" + image.sourceColorType() +
            " palette=" + image.paletteCount() +
            " idat-count=" + image.idatCount() +
            " bytes=" + kooker.outputLength())
        return true
    }
    if (kind == "wav") {
        var audio = kooker.wav()
        println("cooked kind=" + result.sourceKind() +
            " source=" + result.sourceChecksum() +
            " samples=" + result.materialChecksum() +
            " metadata=" + result.metadataChecksum() +
            " canonical=" + result.visibilityChecksum() +
            " sample-rate=" + audio.sampleRate() +
            " channels=" + audio.channelCount() +
            " source-bits=" + audio.sourceBits() +
            " frames=" + audio.frameCount() +
            " duration-ms=" + audio.durationMillis() +
            " bytes=" + kooker.outputLength())
        return true
    }
    println("cooked kind=" + result.sourceKind() +
        " source=" + result.sourceChecksum() +
        " geometry=" + result.geometryChecksum() +
        " collision=" + result.collisionChecksum() +
        " metadata=" + result.metadataChecksum() +
        " entity=" + result.entityChecksum() +
        " visibility=" + result.visibilityChecksum() +
        " primary=" + result.primaryCount() +
        " secondary=" + result.secondaryCount() +
        " bytes=" + kooker.outputLength())
    return true
}

Bool cookCommand(List<String> args, Int offset) {
    if (args.size() - offset < 4) { return printUsage() }
    var kind = args.get(offset + 1)
    var input = args.get(offset + 2)
    var paired = ""
    var output = args.get(offset + 3)
    if (kind == "dust3d") {
        if (args.size() - offset != 5) { return printUsage() }
        paired = args.get(offset + 3)
        output = args.get(offset + 4)
    } else if (args.size() - offset != 4) {
        return printUsage()
    }
    return cookPaths(kind, input, paired, output)
}

Bool nativeCookCommand() {
    var marker = File(".kooker-native-kind").readRange(0, 2)
    if (marker.length != 1) { return printUsage() }
    var kind = ""
    if (marker[0] == 49) {
        kind = "glb"
    } else if (marker[0] == 50) {
        kind = "dust3d"
    } else if (marker[0] == 51) {
        kind = "aseprite"
    } else if (marker[0] == 52) {
        kind = "vox"
    } else if (marker[0] == 53) {
        kind = "map"
    } else if (marker[0] == 54) {
        kind = "blockbench"
    } else if (marker[0] == 55) {
        kind = "png"
    } else if (marker[0] == 56) {
        kind = "wav"
    } else {
        return printUsage()
    }
    var paired = ""
    if (kind == "dust3d") { paired = "paired.input" }
    return cookPaths(kind, "source.input", paired, "product.output")
}

Int parseChunkKind(String value) {
    if (value.length() <= 0 || value.length() > 2) { return 0 }
    var result = 0
    for (var index = 0; index < value.length(); index = index + 1) {
        var digit = (value.charAt(index) as Int) - 48
        if (digit < 0 || digit > 9) { return 0 }
        result = result * 10 + digit
    }
    if (result <= 0 || result > 64) { return 0 }
    return result
}

Bool packageCommand(List<String> args, Int offset) {
    if (args.size() - offset != 5) { return printUsage() }
    var chunkKind = parseChunkKind(args.get(offset + 1))
    var payload = File(args.get(offset + 2)).readRange(0, 10000001)
    if (chunkKind <= 0 || payload.length <= 0 || payload.length > 10000000) {
        println("package-rejected diagnostic=input")
        return false
    }
    var files = BoundedContentPackageFileStore(1, 1, 1, 10000000)
    var packageValue = BoundedContentPackage(1, 1, 1)
    var assetKind = chunkKind
    if (assetKind > 32) { assetKind = 32 }
    var paths = new String[1]
    paths[0] = args.get(offset + 3)
    if (!packageValue.configureHeader(7, 1, 1, 1, 1000) ||
        !packageValue.addAsset(
            1, 1, assetKind, 1,
            files.chunkHashLow(payload, 0, payload.length),
            files.chunkHashHigh(payload, 0, payload.length), 1) ||
        !packageValue.addChunk(
            1, chunkKind, 0, payload.length,
            files.chunkHashLow(payload, 0, payload.length),
            files.chunkHashHigh(payload, 0, payload.length), 1) ||
        !packageValue.seal() ||
        !files.write(args.get(offset + 4), packageValue, payload, paths)) {
        println("package-rejected diagnostic=" + files.diagnostic())
        return false
    }
    println("packaged checksum=" + packageValue.checksum() +
        " kind=" + chunkKind + " payload-bytes=" + payload.length)
    return true
}

Bool inspectPackage(String path) {
    var files = BoundedContentPackageFileStore(32, 32, 64, 16777216)
    var packageValue = BoundedContentPackage(32, 32, 64)
    if (!files.read(path, packageValue)) {
        println("package-rejected diagnostic=" + files.diagnostic())
        return false
    }
    var identity = packageValue.identity()
    println("package checksum=" + packageValue.checksum() +
        " engine=" + identity.engineVersion() +
        " tool=" + identity.toolVersion() +
        " content=" + identity.contentVersion() +
        " assets=" + packageValue.assetCount() +
        " dependencies=" + packageValue.dependencyCount() +
        " chunks=" + packageValue.chunkCount() +
        " payload-bytes=" + files.payloadLength())
    for (var index = 0; index < packageValue.chunkCount(); index = index + 1) {
        println("chunk id=" + packageValue.chunkId(index) +
            " kind=" + packageValue.chunkKind(index) +
            " offset=" + packageValue.chunkOffset(index) +
            " length=" + packageValue.chunkLength(index))
    }
    return true
}

Bool validatePackage(String path) {
    var runtime = BoundedExternalPackageRuntime(16777216)
    if (!runtime.load(path)) {
        println("external-package-rejected diagnostic=" + runtime.diagnostic())
        return false
    }
    println("external-package-valid generation=" + runtime.generation() +
        " checksum=" + runtime.packageChecksum() +
        " extensions=" + runtime.extensions().manifestCount() +
        " enemies=" + runtime.definitions().count() +
        " hooks=" + runtime.hooks().count())
    return true
}

main(List<String> args) {
    var accepted = false
    var offset = 0
    if (args.size() > 1 &&
        (args.get(1) == "cook" || args.get(1) == "package" ||
        args.get(1) == "inspect-package" ||
        args.get(1) == "validate-package")) {
        offset = 1
    }
    var count = args.size() - offset
    if (count > 0 && args.get(offset) == "cook") {
        accepted = cookCommand(args, offset)
    } else if (count > 0 && args.get(offset) == "package") {
        accepted = packageCommand(args, offset)
    } else if (count == 2 && args.get(offset) == "inspect-package") {
        accepted = inspectPackage(args.get(offset + 1))
    } else if (count == 2 && args.get(offset) == "validate-package") {
        accepted = validatePackage(args.get(offset + 1))
    } else if (count == 0) {
        accepted = nativeCookCommand()
    } else {
        printUsage()
    }
    if (!accepted) { process.exit(2) }
}
