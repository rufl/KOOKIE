extern "./lib/libkookie_web_server.so" kookie_web_server_accept(): Bool
extern "./lib/libkookie_web_server.so" kookie_web_server_read_byte(): Int
extern "./lib/libkookie_web_server.so" kookie_web_server_send_begin(Int length): Bool
extern "./lib/libkookie_web_server.so" kookie_web_server_send_byte(Int index, Int value): Bool
