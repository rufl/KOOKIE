Int webMaximumRequestBytes() { return 8192 }
Int webMaximumWebSocketPayloadBytes() { return 1296 }
Int webMaximumResponseBytes() { return 16384 }
Int webWebSocketOpcodeBinary() { return 2 }
Int webWebSocketOpcodeClose() { return 8 }
Int webWebSocketOpcodePing() { return 9 }
Int webWebSocketOpcodePong() { return 10 }

Int webAsciiLower(Int value) {
    if (value >= 65 && value <= 90) { return value + 32 }
    return value
}
Bool webRangeEquals(Int[] source, Int start, Int end, String expected) {
    if (start < 0 || end < start || end - start != expected.length() || end > source.length) { return false }
    for (var index = 0; index < expected.length(); index = index + 1) {
        if (source[start + index] != (expected.charAt(index) as Int)) { return false }
    }
    return true
}
Bool webRangeEqualsIgnoreCase(Int[] source, Int start, Int end, String expected) {
    if (start < 0 || end < start || end - start != expected.length() || end > source.length) { return false }
    for (var index = 0; index < expected.length(); index = index + 1) {
        if (webAsciiLower(source[start + index]) != webAsciiLower(expected.charAt(index) as Int)) { return false }
    }
    return true
}
Int webFindCrlf(Int[] source, Int start, Int limit) {
    if (start < 0 || limit < start || limit > source.length) { return -1 }
    for (var index = start; index + 1 < limit; index = index + 1) {
        if (source[index] == 13 && source[index + 1] == 10) { return index }
    }
    return -1
}
Int webFindHeaderValueStart(Int[] source, Int requestLength, String name) {
    var firstLineEnd = webFindCrlf(source, 0, requestLength)
    if (firstLineEnd < 0) { return -1 }
    var cursor = firstLineEnd + 2
    while (cursor < requestLength) {
        var lineEnd = webFindCrlf(source, cursor, requestLength)
        if (lineEnd < 0 || lineEnd == cursor) { return -1 }
        if (lineEnd - cursor > name.length() &&
            webRangeEqualsIgnoreCase(source, cursor, cursor + name.length(), name) &&
            source[cursor + name.length()] == 58) {
            var value = cursor + name.length() + 1
            while (value < lineEnd && (source[value] == 32 || source[value] == 9)) { value = value + 1 }
            return value * 100000 + lineEnd
        }
        cursor = lineEnd + 2
    }
    return -1
}
Bool webHeaderContainsToken(Int[] source, Int requestLength, String name, String expected) {
    var packed = webFindHeaderValueStart(source, requestLength, name)
    if (packed < 0) { return false }
    var start = packed / 100000
    var end = packed % 100000
    var cursor = start
    while (cursor < end) {
        while (cursor < end && (source[cursor] == 32 || source[cursor] == 9 || source[cursor] == 44)) {
            cursor = cursor + 1
        }
        var tokenEnd = cursor
        while (tokenEnd < end && source[tokenEnd] != 44) { tokenEnd = tokenEnd + 1 }
        while (tokenEnd > cursor && (source[tokenEnd - 1] == 32 || source[tokenEnd - 1] == 9)) {
            tokenEnd = tokenEnd - 1
        }
        if (webRangeEqualsIgnoreCase(source, cursor, tokenEnd, expected)) { return true }
        cursor = tokenEnd + 1
    }
    return false
}
Bool webRequestLine(Int[] source, Int requestLength, String method, String path) {
    var lineEnd = webFindCrlf(source, 0, requestLength)
    if (lineEnd < 0) { return false }
    return webRangeEquals(source, 0, lineEnd, method + " " + path + " HTTP/1.1")
}

Int webWireChecksum(Int[] wire) {
    if (wire.length < 16) { return -1 }
    var result = 0
    for (var index = 0; index < wire.length; index = index + 1) {
        var value = wire[index]
        if (index == 14 || index == 15) { value = 0 }
        result = (result + value * (index + 1)) % 65536
    }
    return result
}
Int[] webEncodeSessionFrame(Int kind, Int sequence, Int[] words) {
    if (sequence <= 0 || sequence > 1000000 || words.length <= 0 ||
        words.length > sessionWebMaximumWords() || words[0] != sessionWebGameProtocolVersion() ||
        words[1] != kind || words[2] != sequence) { return new Int[0] }
    var wire = new Int[16 + words.length * 4]
    wire[0] = 75; wire[1] = 87; wire[2] = 83; wire[3] = 49
    wire[4] = sessionWebFrameVersion(); wire[5] = kind; wire[6] = 0; wire[7] = 0
    wire[8] = (sequence >>> 24) & 255; wire[9] = (sequence >>> 16) & 255
    wire[10] = (sequence >>> 8) & 255; wire[11] = sequence & 255
    wire[12] = (words.length >>> 8) & 255; wire[13] = words.length & 255
    for (var index = 0; index < words.length; index = index + 1) {
        var value = words[index]
        var offset = 16 + index * 4
        wire[offset] = (value >>> 24) & 255; wire[offset + 1] = (value >>> 16) & 255
        wire[offset + 2] = (value >>> 8) & 255; wire[offset + 3] = value & 255
    }
    var checksum = webWireChecksum(wire)
    wire[14] = (checksum >>> 8) & 255; wire[15] = checksum & 255
    return wire
}
Bool webSendBytes(Int connectionId, Int[] bytes) {
    if (bytes.length <= 0 || bytes.length > webMaximumResponseBytes() ||
        !kookie_web_server_output_begin(connectionId, bytes.length)) { return false }
    for (var index = 0; index < bytes.length; index = index + 1) {
        if (!kookie_web_server_output_write_byte(index, bytes[index])) { return false }
    }
    return kookie_web_server_output_commit()
}
Bool webSendAscii(Int connectionId, String text) {
    if (text.length() <= 0 || text.length() > webMaximumResponseBytes()) { return false }
    var bytes = new Int[text.length()]
    for (var index = 0; index < bytes.length; index = index + 1) { bytes[index] = text.charAt(index) as Int }
    return webSendBytes(connectionId, bytes)
}
Bool webSendTextResponse(Int connectionId, String status, String contentType, String body) {
    return webSendAscii(connectionId, "HTTP/1.1 " + status + "\r\n" +
        "Content-Type: " + contentType + "\r\nContent-Length: " + body.length() +
        "\r\nConnection: close\r\nAccess-Control-Allow-Origin: *\r\n\r\n" + body)
}
Bool webSendWsFrame(Int connectionId, Int opcode, Int[] payload) {
    if (payload.length > webMaximumWebSocketPayloadBytes() || (opcode >= 8 && payload.length > 125)) { return false }
    var headerLength = if (payload.length < 126) 2 else 4
    var frame = new Int[headerLength + payload.length]
    frame[0] = 128 | opcode
    if (payload.length < 126) { frame[1] = payload.length }
    else { frame[1] = 126; frame[2] = (payload.length >>> 8) & 255; frame[3] = payload.length & 255 }
    for (var index = 0; index < payload.length; index = index + 1) { frame[headerLength + index] = payload[index] }
    return webSendBytes(connectionId, frame)
}
Bool webSendSessionWords(Int connectionId, Int kind, Int sequence, Int[] words) {
    var wire = webEncodeSessionFrame(kind, sequence, words)
    return wire.length > 0 && webSendWsFrame(connectionId, webWebSocketOpcodeBinary(), wire)
}

class WebSessionFrame {
    Int kindValue
    Int sequenceValue
    Int[] wordsValue
    Bool validValue
    public constructor(Int[] wire) {
        kindValue = 0
        sequenceValue = 0
        wordsValue = new Int[0]
        validValue = false
        if (wire.length < 16 || wire.length > sessionWebMaximumFrameBytes() ||
            wire[0] != 75 || wire[1] != 87 || wire[2] != 83 || wire[3] != 49 ||
            wire[4] != sessionWebFrameVersion() || wire[6] != 0 || wire[7] != 0) { return }
        kindValue = wire[5]
        sequenceValue = (wire[8] << 24) | (wire[9] << 16) | (wire[10] << 8) | wire[11]
        var count = wire[12] * 256 + wire[13]
        if (sequenceValue <= 0 || sequenceValue > 1000000 || count <= 0 ||
            count > sessionWebMaximumWords() || wire.length != 16 + count * 4 ||
            webWireChecksum(wire) != wire[14] * 256 + wire[15]) { return }
        wordsValue = new Int[count]
        for (var i = 0; i < count; i = i + 1) {
            var offset = 16 + i * 4
            wordsValue[i] = (wire[offset] << 24) | (wire[offset + 1] << 16) |
                (wire[offset + 2] << 8) | wire[offset + 3]
        }
        validValue = wordsValue[0] == sessionWebGameProtocolVersion() &&
            wordsValue[1] == kindValue && wordsValue[2] == sequenceValue &&
            wordsValue[wordsValue.length - 1] ==
                sessionWebMessageChecksum(wordsValue, wordsValue.length - 1)
    }
    Bool valid() { return validValue }
    Int kind() { return kindValue }
    Int sequence() { return sequenceValue }
    Int[] words() { return wordsValue }
}

class WebServerMetrics {
    WebMultiplayerSimulation simulation
    BoundedKutterLevelEditor kutterEditor
    Int kutterImportOwner
    Int kutterImportTotal
    Int kutterImportReceived
    Int[] kutterImportWords
    Int[] connectionIds
    Bool[] connectionUsed
    Bool[] connectionWebSocket
    Bool[] connectionAdmin
    Bool[] connectionSpectatorRoute
    Bool[] connectionKutter
    Bool[] connectionHello
    Bool[] connectionJoined
    Bool[] connectionSpectators
    Int[] connectionPlayerIds
    Int[] connectionAnimal
    Int[] connectionTeam
    Int[] connectionInputSequence
    Int[] connectionAppliedInputSequence
    Int[] connectionMoveX
    Int[] connectionMoveZ
    Int[] connectionLookYaw
    Int[] connectionLookPitch
    Int[] connectionHeldActions
    Int[] connectionEdgeActions
    Int[] connectionOutputSequence
    Int[] connectionLastSequence
    Int[] connectionMapVote
    Int nextChatSequenceValue
    Int[] chatLengthValues
    Int[] chatWordStorage
    Int[] connectionChatLastTick
    Int nextPlayerIdValue
    Int serverTickValue
    Int matchPhaseValue
    Int matchPhaseEndsAt
    Long nextTickNanosecondsValue
    Int acceptedConnectionsValue
    Int rejectionCountValue
    Int frameCountValue
    Int upgradeCountValue
    Int healthCountValue
    Int metricsCountValue
    Int tickScheduleOverrunsValue

    public constructor() {
        simulation = WebMultiplayerSimulation()
        kutterEditor = BoundedKutterLevelEditor()
        kutterImportOwner = 0
        kutterImportTotal = 0
        kutterImportReceived = 0
        kutterImportWords = new Int[11 + 64 * 13 + 32 * 5]
        connectionIds = new Int[12]
        connectionUsed = new Bool[12]
        connectionWebSocket = new Bool[12]
        connectionAdmin = new Bool[12]
        connectionSpectatorRoute = new Bool[12]
        connectionHello = new Bool[12]
        connectionJoined = new Bool[12]
        connectionKutter = new Bool[12]
        connectionSpectators = new Bool[12]
        connectionPlayerIds = new Int[12]
        connectionAnimal = new Int[12]
        connectionTeam = new Int[12]
        connectionInputSequence = new Int[12]
        connectionAppliedInputSequence = new Int[12]
        connectionMoveX = new Int[12]
        connectionMoveZ = new Int[12]
        connectionLookYaw = new Int[12]
        connectionLookPitch = new Int[12]
        connectionHeldActions = new Int[12]
        connectionEdgeActions = new Int[12]
        connectionOutputSequence = new Int[12]
        connectionLastSequence = new Int[12]
        nextChatSequenceValue = 1
        chatLengthValues = new Int[32]
        chatWordStorage = new Int[32 * 89]
        connectionMapVote = new Int[12]
        connectionChatLastTick = new Int[12]
        serverTickValue = 0
        matchPhaseValue = sessionWebGameMatchActive()
        matchPhaseEndsAt = 2400
        nextPlayerIdValue = 1
        nextTickNanosecondsValue = 0L
        acceptedConnectionsValue = 0
        rejectionCountValue = 0
        frameCountValue = 0
        upgradeCountValue = 0
        healthCountValue = 0
        metricsCountValue = 0
        tickScheduleOverrunsValue = 0
        for (var i = 0; i < 12; i = i + 1) { connectionUsed[i] = false }
        for (var chat = 0; chat < 32; chat = chat + 1) {
            chatLengthValues[chat] = 0
        }
    }
    Int find(Int id) {
        for (var i = 0; i < 12; i = i + 1) { if (connectionUsed[i] && connectionIds[i] == id) { return i } }
        return -1
    }
    Int reserve(Int id) {
        if (find(id) >= 0) { return -1 }
        for (var i = 0; i < 12; i = i + 1) {
            if (!connectionUsed[i]) {
                connectionUsed[i] = true; connectionIds[i] = id
                connectionWebSocket[i] = false; connectionSpectatorRoute[i] = false
                connectionAdmin[i] = false
                connectionHello[i] = false; connectionJoined[i] = false
                connectionSpectators[i] = false; connectionPlayerIds[i] = 0
                connectionAnimal[i] = 1; connectionTeam[i] = 0
                connectionInputSequence[i] = 0; connectionMoveX[i] = 0; connectionMoveZ[i] = 0
                connectionAppliedInputSequence[i] = 0
                connectionLookYaw[i] = 0; connectionLookPitch[i] = 0
                connectionHeldActions[i] = 0; connectionEdgeActions[i] = 0
                connectionOutputSequence[i] = 1; connectionLastSequence[i] = 0
                connectionMapVote[i] = 0
                connectionKutter[i] = false
                acceptedConnectionsValue = acceptedConnectionsValue + 1
                connectionChatLastTick[i] = -1000
                return i
            }
        }
        return -1
    }
    Bool release(Int id) {
        var slot = find(id)
        if (slot < 0) { return false }
        if (kutterImportOwner == id) {
            kutterImportOwner = 0
            kutterImportTotal = 0
            kutterImportReceived = 0
        }
        if (connectionJoined[slot] && !connectionSpectators[slot]) {
            simulation.removePlayer(connectionPlayerIds[slot])
        }
        connectionUsed[slot] = false; connectionIds[slot] = 0
        connectionJoined[slot] = false; connectionWebSocket[slot] = false
        return true
    }
    Int playerCount() { return simulation.playerCount() }
    Int spectatorCount() {
        var count = 0
        for (var i = 0; i < 12; i = i + 1) {
            if (connectionUsed[i] && connectionJoined[i] && connectionSpectators[i]) {
                count = count + 1
            }
        }
        return count
    }
    Int activeSessions() {
        var count = 0
        for (var i = 0; i < 12; i = i + 1) {
            if (connectionUsed[i] && connectionWebSocket[i]) { count = count + 1 }
        }
        return count
    }
    String healthBody() {
        return "{\"status\":\"ok\",\"protocol\":\"kookie.v1\",\"transport\":\"tcp\",\"auth_required\":false," +
            "\"active_sessions\":" + activeSessions() + "}\n"
    }
    String metricsBody() {
        return "# TYPE kookie_gateway_active_sessions gauge\nkookie_gateway_active_sessions " + activeSessions() +
            "\n# TYPE kookie_gateway_rejections_total counter\nkookie_gateway_rejections_total " + rejectionCountValue +
            "\n# TYPE kookie_gateway_frames_total counter\nkookie_gateway_frames_total " + frameCountValue +
            "\n# TYPE kookie_gateway_upgrades_total counter\nkookie_gateway_upgrades_total " + upgradeCountValue +
            "\n# TYPE kookie_gateway_health_requests_total counter\n" +
            "kookie_gateway_health_requests_total " + healthCountValue +
            "\n# TYPE kookie_gateway_metrics_requests_total counter\n" +
            "kookie_gateway_metrics_requests_total " + metricsCountValue +
            "\n# TYPE kookie_gateway_tick_schedule_overruns_total counter\n" +
            "kookie_gateway_tick_schedule_overruns_total " +
            tickScheduleOverrunsValue +
            "\n"
    }
}
Int[] webKutterResponse(
    WebServerMetrics metrics, Int sequence, Int command, Int status,
    Int offset, Int total
) {
    var editor = metrics.kutterEditor
    var dataLength = 0
    if (status == 0 && total > 0) {
        dataLength = total - offset
        if (dataLength > sessionWebKutterTransferWords()) {
            dataLength = sessionWebKutterTransferWords()
        }
    }
    var words = new Int[16 + dataLength]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebGameKind()
    words[2] = sequence
    words[3] = sessionWebKutterResponseMarker()
    words[4] = command
    words[5] = status
    words[6] = editor.generation()
    words[7] = editor.selectedNode()
    words[8] = editor.tool()
    words[9] = editor.cursorX()
    words[10] = editor.cursorZ()
    words[11] = editor.gridSize()
    words[12] = editor.validationMask() |
        (if (editor.previewActive()) 8 else 0)
    words[13] = offset
    words[14] = total
    for (var index = 0; index < dataLength; index = index + 1) {
        words[15 + index] = editor.document().encodedWord(offset + index)
    }
    words[words.length - 1] =
        sessionWebMessageChecksum(words, words.length - 1)
    return words
}
Bool webSendKutterState(
    WebServerMetrics metrics, Int slot, Int sequence, Int command,
    Int status
) {
    var editor = metrics.kutterEditor
    var total = 0
    if (status == 0 && editor.document().validate() &&
        editor.document().encode()) {
        total = editor.document().encodedLength()
    }
    if (total <= 0) {
        var response = webKutterResponse(
            metrics, sequence, command, if (status == 0) 1 else status,
            0, 0)
        return webSendSessionWords(
            metrics.connectionIds[slot], sessionWebGameKind(),
            sequence, response)
    }
    var offset = 0
    while (offset < total) {
        var response = webKutterResponse(
            metrics, sequence, command, 0, offset, total)
        if (!webSendSessionWords(metrics.connectionIds[slot],
                sessionWebGameKind(), sequence, response)) {
            return false
        }
        offset = offset + sessionWebKutterTransferWords()
    }
    return true
}
Bool webBroadcastKutterState(WebServerMetrics metrics, Int exceptSlot) {
    for (var slot = 0; slot < 12; slot = slot + 1) {
        if (slot != exceptSlot && metrics.connectionUsed[slot] &&
            metrics.connectionWebSocket[slot] &&
            metrics.connectionKutter[slot]) {
            if (!webSendKutterState(
                    metrics, slot, 1000000,
                    sessionWebKutterGet(), 0)) {
                var id = metrics.connectionIds[slot]
                kookie_web_server_close_client(id)
                metrics.release(id)
            }
        }
    }
    return true
}
Bool webHandleKutter(WebServerMetrics metrics, Int slot, WebSessionFrame frame) {
    var words = frame.words()
    if (!validSessionWebKutterRequest(words)) { return false }
    if (frame.sequence() <= metrics.connectionLastSequence[slot]) {
        return false
    }
    metrics.connectionLastSequence[slot] = frame.sequence()
    metrics.connectionKutter[slot] = true
    var beforeChecksum = metrics.kutterEditor.document().checksum()
    var beforePreview = metrics.kutterEditor.previewActive()
    var beforeSelected = metrics.kutterEditor.selectedNode()
    var beforeTool = metrics.kutterEditor.tool()
    var beforeCursorX = metrics.kutterEditor.cursorX()
    var beforeCursorZ = metrics.kutterEditor.cursorZ()
    var beforeGrid = metrics.kutterEditor.gridSize()
    var command = words[4]
    var editor = metrics.kutterEditor
    var accepted = false
    if (command == sessionWebKutterGet()) {
        accepted = editor.document().validate()
    } else if (command == sessionWebKutterTool() && words.length == 7) {
        accepted = editor.selectTool(words[5])
    } else if (command == sessionWebKutterCursor() && words.length == 8) {
        accepted = editor.setCursor(words[5], words[6])
    } else if (command == sessionWebKutterApplyTool() && words.length == 6) {
        accepted = editor.applyTool()
    } else if (command == sessionWebKutterSelect() && words.length == 7) {
        accepted = editor.selectNode(words[5])
    } else if (command == sessionWebKutterMove() && words.length == 8) {
        accepted = editor.setCursor(words[5], words[6]) &&
            editor.moveSelectedToCursor()
    } else if (command == sessionWebKutterRotate() && words.length == 7) {
        accepted = editor.rotateSelected(words[5])
    } else if (command == sessionWebKutterResize() && words.length == 8) {
        accepted = editor.resizeSelected(words[5], words[6])
    } else if (command == sessionWebKutterRecolor() && words.length == 7) {
        accepted = editor.recolorSelected(words[5])
    } else if (command == sessionWebKutterDuplicate() && words.length == 6) {
        accepted = editor.duplicateSelected()
    } else if (command == sessionWebKutterRemove() && words.length == 6) {
        accepted = editor.removeSelected()
    } else if (command == sessionWebKutterGroup() && words.length == 7) {
        accepted = editor.groupSelectedWith(words[5])
    } else if (command == sessionWebKutterUngroup() && words.length == 6) {
        accepted = editor.ungroupSelected()
    } else if (command == sessionWebKutterUndo() && words.length == 6) {
        accepted = editor.undo()
    } else if (command == sessionWebKutterRedo() && words.length == 6) {
        accepted = editor.redo()
    } else if (command == sessionWebKutterGrid() && words.length == 7) {
        accepted = editor.setGridSize(words[5])
    } else if (command == sessionWebKutterUpdate() && words.length == 15) {
        accepted = editor.updateSelectedNode(
            words[5], words[6], words[7], words[8],
            words[9], words[10], words[11], words[12], words[13])
    } else if (command == sessionWebKutterHeight() && words.length == 7) {
        accepted = editor.adjustSelectedHeight(words[5])
    } else if (command == sessionWebKutterPreview() && words.length == 6) {
        accepted = editor.togglePreview()
    } else if (command == sessionWebKutterImportChunk() && words.length >= 9) {
        var total = words[5]
        var offset = words[6]
        var count = words.length - 8
        accepted = total >= 11 && total <= metrics.kutterImportWords.length &&
            offset >= 0 && count > 0 && offset + count <= total
        if (accepted && offset == 0) {
            metrics.kutterImportOwner = metrics.connectionIds[slot]
            metrics.kutterImportTotal = total
            metrics.kutterImportReceived = 0
        }
        accepted = accepted &&
            metrics.kutterImportOwner == metrics.connectionIds[slot] &&
            metrics.kutterImportTotal == total &&
            metrics.kutterImportReceived == offset
        if (accepted) {
            for (var index = 0; index < count; index = index + 1) {
                metrics.kutterImportWords[offset + index] = words[7 + index]
            }
            metrics.kutterImportReceived = offset + count
            if (metrics.kutterImportReceived == total) {
                var upload = new Int[total]
                for (var index = 0; index < total; index = index + 1) {
                    upload[index] = metrics.kutterImportWords[index]
                }
                accepted = editor.importDocument(upload)
                metrics.kutterImportOwner = 0
                metrics.kutterImportTotal = 0
                metrics.kutterImportReceived = 0
            } else {
                var pending = webKutterResponse(
                    metrics, frame.sequence(), command, 0, 0, 0)
                return webSendSessionWords(
                    metrics.connectionIds[slot], sessionWebGameKind(),
                    frame.sequence(), pending)
            }
        }
    } else {
        return false
    }
    var sent = webSendKutterState(
        metrics, slot, frame.sequence(), command, if (accepted) 0 else 1)
    if (!sent) { return false }
    if (accepted &&
        (metrics.kutterEditor.document().checksum() != beforeChecksum ||
            metrics.kutterEditor.previewActive() != beforePreview ||
            metrics.kutterEditor.selectedNode() != beforeSelected ||
            metrics.kutterEditor.tool() != beforeTool ||
            metrics.kutterEditor.cursorX() != beforeCursorX ||
            metrics.kutterEditor.cursorZ() != beforeCursorZ ||
            metrics.kutterEditor.gridSize() != beforeGrid)) {
        return webBroadcastKutterState(metrics, slot)
    }
    return true
}

Int[] webEventBytes(Int length) {
    if (length < 0 || length > webMaximumRequestBytes()) { return new Int[0] }
    var bytes = new Int[length]
    for (var i = 0; i < length; i = i + 1) { bytes[i] = kookie_web_server_event_payload_byte(i) }
    return bytes
}
Int webOutputSequence(WebServerMetrics metrics, Int slot) {
    var sequence = metrics.connectionOutputSequence[slot]
    if (sequence <= 0 || sequence > 1000000) { sequence = 1 }
    metrics.connectionOutputSequence[slot] = sequence + 1
    return sequence
}
Bool webSendHelloAck(WebServerMetrics metrics, Int slot, Int sequence) {
    return webSendSessionWords(
        metrics.connectionIds[slot], sessionWebAckKind(), sequence,
        newSessionWebAck(sequence, true))
}
Bool webSendPong(WebServerMetrics metrics, Int slot, Int sequence) {
    return webSendSessionWords(
        metrics.connectionIds[slot], sessionWebPongKind(), sequence,
        newSessionWebPing(sessionWebPongKind(), sequence))
}
Int webActorYaw(Int yaw) {
    var value = yaw % 360
    if (value < 0) { value = value + 360 }
    return value
}
Int[] webMultiplayerSnapshot(WebServerMetrics metrics, Int slot) {
    var id = metrics.connectionPlayerIds[slot]
    var spectator = metrics.connectionSpectators[slot]
    var x = sessionWebGameWorldMinimumX()
    var y = sessionWebGameWorldMinimumY()
    var z = sessionWebGameWorldMinimumZ()
    var yaw = 0
    var pitch = 0
    var health = sessionWebGameMaximumHealth()
    var ammo = sessionWebGameMaximumAmmo()
    if (!spectator) {
        var own = metrics.simulation.playerState(id)
        if (!own.active) { return new Int[0] }
        x = own.x; y = own.y; z = own.z; yaw = own.yaw; pitch = own.pitch
        health = own.health; ammo = own.ammo
    }
    var actors = new Int[
        (metrics.simulation.playerCount() +
            metrics.simulation.trainingDummyCount()) * 8]
    var cursor = 0
    for (var actorSlot = 0; actorSlot < 12; actorSlot = actorSlot + 1) {
        if (metrics.connectionUsed[actorSlot] && metrics.connectionJoined[actorSlot] &&
            !metrics.connectionSpectators[actorSlot]) {
            var actor = metrics.simulation.playerState(metrics.connectionPlayerIds[actorSlot])
            if (actor.active) {
                actors[cursor] = actor.playerId; actors[cursor + 1] = actor.x
                actors[cursor + 2] = actor.y; actors[cursor + 3] = actor.z
                actors[cursor + 4] = actor.health; actors[cursor + 5] = actor.state
                actors[cursor + 6] = actor.animal; actors[cursor + 7] = webActorYaw(actor.yaw)
                cursor = cursor + 8
            }
        }
    }
    for (var dummy = 0;
        dummy < metrics.simulation.trainingDummyCount(); dummy = dummy + 1) {
        actors[cursor] = -(dummy + 1)
        actors[cursor + 1] = metrics.simulation.trainingDummyX(dummy)
        actors[cursor + 2] = metrics.simulation.trainingDummyY(dummy)
        actors[cursor + 3] = metrics.simulation.trainingDummyZ(dummy)
        actors[cursor + 4] = metrics.simulation.trainingDummyHealth(dummy)
        actors[cursor + 5] = 0
        actors[cursor + 6] = 3
        actors[cursor + 7] = 0
        cursor = cursor + 8
    }
    if (cursor != actors.length) { return new Int[0] }
    var sequence = webOutputSequence(metrics, slot)
    var base = newSessionWebGameMultiplayerSnapshot(sequence, metrics.serverTickValue,
        if (spectator) sessionWebRoleSpectator()
        else if (metrics.simulation.trainingMode()) sessionWebRoleTraining()
        else sessionWebRolePlayer(),
        if (spectator) 0 else id, x, y, z, webActorYaw(yaw), pitch,
        metrics.playerCount(), metrics.spectatorCount(), actors)
    base[12] = health
    base[14] = ammo
    var projectileCount = metrics.simulation.projectileCount()
    var throwableCount = metrics.simulation.throwableCount()
    var impactCount = metrics.simulation.impactCount()
    var trailer = 18 + actors.length
    var sliceCount = metrics.simulation.sliceCount()
    var extended = new Int[base.length + 4 + projectileCount * 8 +
        throwableCount * 8 + impactCount * 8 + 10 + sliceCount * 4 + 6]
    for (var i = 0; i < base.length; i = i + 1) {
        extended[i] = base[i]
    }
    extended[trailer] = metrics.connectionAppliedInputSequence[slot]
    extended[trailer + 1] = projectileCount
    extended[trailer + 2] = throwableCount
    extended[trailer + 3] = impactCount
    cursor = trailer + 4
    for (var i = 0; i < projectileCount; i = i + 1) {
        var item = metrics.simulation.projectileAt(i)
        extended[cursor] = item.id; extended[cursor + 1] = item.ownerId
        extended[cursor + 2] = item.targetId; extended[cursor + 3] = item.x
        extended[cursor + 4] = item.y; extended[cursor + 5] = item.z
        extended[cursor + 6] = item.ttl
        extended[cursor + 7] = item.kind; cursor = cursor + 8
    }
    for (var i = 0; i < throwableCount; i = i + 1) {
        var item = metrics.simulation.throwableAt(i)
        extended[cursor] = item.id; extended[cursor + 1] = item.ownerId
        extended[cursor + 2] = item.x; extended[cursor + 3] = item.y
        extended[cursor + 4] = item.z; extended[cursor + 5] = item.ttl
        extended[cursor + 6] = item.kind; extended[cursor + 7] = item.fuseTicks
        cursor = cursor + 8
    }
    for (var i = 0; i < impactCount; i = i + 1) {
        var item = metrics.simulation.impactAt(i)
        extended[cursor] = item.sequence; extended[cursor + 1] = item.kind
        extended[cursor + 2] = item.sourceId; extended[cursor + 3] = item.targetId
        extended[cursor + 4] = item.x; extended[cursor + 5] = item.y
        extended[cursor + 6] = item.z; extended[cursor + 7] = item.damage
        cursor = cursor + 8
    }
    extended[cursor] = if (metrics.simulation.throwablePickupIsActive()) 1 else 0
    extended[cursor + 1] = metrics.simulation.throwablePickupPositionX()
    extended[cursor + 2] = metrics.simulation.throwablePickupPositionY()
    extended[cursor + 3] = metrics.simulation.throwablePickupPositionZ()
    extended[cursor + 4] =
        if (metrics.simulation.throwablePickupIsActive()) metrics.simulation.throwablePickupTypeValue() else 0
    extended[cursor + 5] =
        if (!spectator && metrics.simulation.playerCarriesThrowable(id)) 1 else 0
    extended[cursor + 6] =
        if (!spectator) metrics.simulation.playerThrowableChargeTicks(id) else 0
    extended[cursor + 7] =
        if (!spectator && metrics.simulation.playerCarriesThrowable(id))
            metrics.simulation.playerThrowableType(id) else 0
    extended[cursor + 8] =
        if (!spectator) metrics.simulation.playerSeedAmmo(id) else 0
    extended[cursor + 9] = sliceCount
    cursor = cursor + 10
    for (var i = 0; i < sliceCount; i = i + 1) {
        var item = metrics.simulation.sliceAt(i)
        extended[cursor] = item.id
        extended[cursor + 1] = item.x
        extended[cursor + 2] = item.y
        extended[cursor + 3] = item.z
        cursor = cursor + 4
    }
    extended[cursor] = metrics.simulation.mapId()
    extended[cursor + 1] = metrics.matchPhaseValue
    extended[cursor + 2] =
        if (metrics.matchPhaseEndsAt > metrics.serverTickValue)
            metrics.matchPhaseEndsAt - metrics.serverTickValue else 0
    extended[cursor + 3] =
        webMapVoteCount(metrics, sessionWebGameMapOne())
    extended[cursor + 4] =
        webMapVoteCount(metrics, sessionWebGameMapTwo())
    extended[cursor + 5] =
        extended[cursor + 3] + extended[cursor + 4]
    extended[extended.length - 1] = sessionWebMessageChecksum(extended, extended.length - 1)
    if (!validSessionWebGameMultiplayerSnapshot(extended)) {
        println("invalid snapshot len=" + extended.length +
            " tick=" + metrics.serverTickValue +
            " players=" + metrics.playerCount() +
            " actors=" + extended[17] +
            " map=" + extended[extended.length - 7] +
            " phase=" + extended[extended.length - 6] +
            " remaining=" + extended[extended.length - 5] +
            " votes1=" + extended[extended.length - 4] +
            " votes2=" + extended[extended.length - 3] +
            " total=" + extended[extended.length - 2])
        return new Int[0]
    }
    return extended
}
Bool webBroadcastSnapshots(WebServerMetrics metrics) {
    for (var slot = 0; slot < 12; slot = slot + 1) {
        if (metrics.connectionUsed[slot] && metrics.connectionJoined[slot]) {
            var snapshot = webMultiplayerSnapshot(metrics, slot)
            var sequence = metrics.connectionOutputSequence[slot] - 1
            if (snapshot.length <= 0) {
                println("KOOKIE snapshot validation failed connection=" +
                    metrics.connectionIds[slot] + " player=" +
                    metrics.connectionPlayerIds[slot] + " tick=" +
                    metrics.simulation.tick())
                kookie_web_server_close_client(metrics.connectionIds[slot])
                metrics.release(metrics.connectionIds[slot])
            } else if (!webSendSessionWords(metrics.connectionIds[slot],
                    sessionWebGameKind(), sequence, snapshot)) {
                println("KOOKIE snapshot send failed connection=" +
                    metrics.connectionIds[slot] + " player=" +
                    metrics.connectionPlayerIds[slot] + " tick=" +
                    metrics.simulation.tick())
                kookie_web_server_close_client(metrics.connectionIds[slot])
                metrics.release(metrics.connectionIds[slot])
            }
        }
    }
    return true
}
Int webMapVoteCount(WebServerMetrics metrics, Int mapId) {
    var count = 0
    for (var slot = 0; slot < 12; slot = slot + 1) {
        if (metrics.connectionUsed[slot] && metrics.connectionJoined[slot] &&
            !metrics.connectionSpectators[slot] &&
            metrics.connectionMapVote[slot] == mapId) {
            count = count + 1
        }
    }
    return count
}
Bool webBeginMapIntermission(WebServerMetrics metrics) {
    if (metrics.matchPhaseValue == sessionWebGameMatchIntermission() ||
        metrics.simulation.trainingMode()) { return false }
    metrics.matchPhaseValue = sessionWebGameMatchIntermission()
    metrics.matchPhaseEndsAt = metrics.serverTickValue + 300
    for (var slot = 0; slot < 12; slot = slot + 1) {
        metrics.connectionMapVote[slot] = 0
        metrics.connectionMoveX[slot] = 0
        metrics.connectionMoveZ[slot] = 0
        metrics.connectionLookYaw[slot] = 0
        metrics.connectionLookPitch[slot] = 0
        metrics.connectionHeldActions[slot] = 0
        metrics.connectionEdgeActions[slot] = 0
    }
    return true
}
Bool webTransitionMap(WebServerMetrics metrics) {
    var mapId = metrics.simulation.mapId()
    var mapOneVotes = webMapVoteCount(metrics, sessionWebGameMapOne())
    var mapTwoVotes = webMapVoteCount(metrics, sessionWebGameMapTwo())
    if (mapTwoVotes > mapOneVotes) {
        mapId = sessionWebGameMapTwo()
    } else if (mapOneVotes > mapTwoVotes) {
        mapId = sessionWebGameMapOne()
    }
    metrics.simulation.destroyBox3DArena()
    var nextSimulation = WebMultiplayerSimulation()
    if (!nextSimulation.selectArenaMap(mapId) || !nextSimulation.configure()) {
        return false
    }
    for (var slot = 0; slot < 12; slot = slot + 1) {
        if (!metrics.connectionUsed[slot] || !metrics.connectionJoined[slot] ||
            metrics.connectionSpectators[slot]) { continue }
        var playerId = metrics.connectionPlayerIds[slot]
        var spawnX = 24 + (playerId % 4) * 12
        var spawnZ = 24 + (playerId % 3) * 12
        if (!nextSimulation.addPlayer(
                playerId, metrics.connectionAnimal[slot], spawnX, 1, spawnZ) ||
            (metrics.connectionTeam[slot] > 0 &&
                !nextSimulation.setPlayerTeam(
                    playerId, metrics.connectionTeam[slot]))) {
            nextSimulation.destroyBox3DArena()
            return false
        }
        metrics.connectionAppliedInputSequence[slot] =
            metrics.connectionInputSequence[slot]
        metrics.connectionMapVote[slot] = 0
    }
    metrics.simulation = nextSimulation
    metrics.matchPhaseValue = sessionWebGameMatchActive()
    metrics.matchPhaseEndsAt = metrics.serverTickValue + 2400
    return true
}

Bool webTick(WebServerMetrics metrics) {
    metrics.serverTickValue = metrics.serverTickValue + 1
    if (metrics.matchPhaseValue == sessionWebGameMatchActive() &&
        metrics.serverTickValue >= metrics.matchPhaseEndsAt &&
        metrics.playerCount() > 0) {
        webBeginMapIntermission(metrics)
    } else if (metrics.matchPhaseValue ==
            sessionWebGameMatchIntermission() &&
        metrics.serverTickValue >= metrics.matchPhaseEndsAt) {
        if (!webTransitionMap(metrics)) {
            println("KOOKIE map transition failed")
            return false
        }
    }
    var nextTick = metrics.simulation.tick() + 1
    for (var slot = 0; slot < 12; slot = slot + 1) {
        if (metrics.connectionUsed[slot] && metrics.connectionJoined[slot] && !metrics.connectionSpectators[slot]) {
            var id = metrics.connectionPlayerIds[slot]
            var moveX = if (metrics.matchPhaseValue == sessionWebGameMatchIntermission()) 0 else metrics.connectionMoveX[slot]
            var moveZ = if (metrics.matchPhaseValue == sessionWebGameMatchIntermission()) 0 else metrics.connectionMoveZ[slot]
            var lookYaw = if (metrics.matchPhaseValue == sessionWebGameMatchIntermission()) 0 else metrics.connectionLookYaw[slot]
            var lookPitch = if (metrics.matchPhaseValue == sessionWebGameMatchIntermission()) 0 else metrics.connectionLookPitch[slot]
            var held = if (metrics.matchPhaseValue == sessionWebGameMatchIntermission()) 0 else metrics.connectionHeldActions[slot]
            var edge = if (metrics.matchPhaseValue == sessionWebGameMatchIntermission()) 0 else metrics.connectionEdgeActions[slot]
            if (metrics.simulation.applyInputFrame(id, nextTick, nextTick,
                    moveX, moveZ, lookYaw, lookPitch, held, edge)) {
                metrics.connectionAppliedInputSequence[slot] =
                    metrics.connectionInputSequence[slot]
                metrics.connectionLookYaw[slot] = 0
                metrics.connectionLookPitch[slot] = 0
                metrics.connectionEdgeActions[slot] = 0
            } else {
                metrics.connectionMoveX[slot] = 0
                metrics.connectionMoveZ[slot] = 0
                metrics.connectionLookYaw[slot] = 0
                metrics.connectionLookPitch[slot] = 0
                metrics.connectionHeldActions[slot] = 0
                metrics.connectionEdgeActions[slot] = 0
            }
        }
    }
    if (!metrics.simulation.advanceTick()) {
        println("KOOKIE authoritative simulation tick failed")
        return false
    }
    if (!webBroadcastSnapshots(metrics)) {
        println("KOOKIE authoritative snapshot broadcast failed")
        return false
    }
    return true
}

Bool webChatVisibleTo(
    WebServerMetrics metrics, Int slot, Int channel, Int target, Int sender
) {
    if (!metrics.connectionUsed[slot] || !metrics.connectionJoined[slot]) {
        return false
    }
    if (channel == sessionWebChatGlobal()) { return true }
    if (metrics.connectionSpectators[slot]) { return false }
    var recipient = metrics.connectionPlayerIds[slot]
    if (channel == sessionWebChatTeam()) {
        return metrics.simulation.playerTeam(recipient) == target
    }
    if (channel == sessionWebChatWhisper()) {
        return recipient == sender || recipient == target
    }
    return false
}

Bool webSendChatPacket(
    WebServerMetrics metrics, Int slot, Int[] words
) {
    var sequence = webOutputSequence(metrics, slot)
    var outgoing = new Int[words.length]
    for (var index = 0; index < words.length; index = index + 1) {
        outgoing[index] = words[index]
    }
    outgoing[2] = sequence
    outgoing[3] = sessionWebGameChatResponseMarker()
    outgoing[words.length - 1] =
        sessionWebMessageChecksum(outgoing, words.length - 1)
    return validSessionWebGameChat(outgoing) &&
        webSendSessionWords(metrics.connectionIds[slot],
            sessionWebGameKind(), sequence, outgoing)
}

Bool webDistributeChat(WebServerMetrics metrics, Int[] words) {
    var sender = words[7]
    var channel = words[4]
    var target = words[5]
    var sequence = metrics.nextChatSequenceValue
    if (sequence <= 0 || sequence > 1000000) { return false }
    var ringSlot = (sequence - 1) % 32
    metrics.nextChatSequenceValue = sequence + 1
    metrics.chatLengthValues[ringSlot] = words.length
    var base = ringSlot * 89
    for (var index = 0; index < words.length; index = index + 1) {
        metrics.chatWordStorage[base + index] = words[index]
    }
    var accepted = true
    for (var slot = 0; slot < 12; slot = slot + 1) {
        if (webChatVisibleTo(metrics, slot, channel, target, sender) &&
            !webSendChatPacket(metrics, slot, words)) {
            accepted = false
        }
    }
    return accepted
}

Bool webReplayChatHistory(WebServerMetrics metrics, Int slot) {
    var count = metrics.nextChatSequenceValue - 1
    if (count > 32) { count = 32 }
    var first = metrics.nextChatSequenceValue - count
    for (var sequence = first;
        sequence < metrics.nextChatSequenceValue; sequence = sequence + 1) {
        var ringSlot = (sequence - 1) % 32
        var length = metrics.chatLengthValues[ringSlot]
        if (length <= 0) { continue }
        var stored = new Int[length]
        var base = ringSlot * 89
        for (var index = 0; index < length; index = index + 1) {
            stored[index] = metrics.chatWordStorage[base + index]
        }
        if (webChatVisibleTo(metrics, slot, stored[4], stored[5],
                stored[7]) &&
            !webSendChatPacket(metrics, slot, stored)) {
            return false
        }
    }
    return true
}

Bool webHandleChat(
    WebServerMetrics metrics, Int slot, WebSessionFrame frame
) {
    var words = frame.words()
    if (!validSessionWebGameChat(words) ||
        words[3] != sessionWebGameChatMarker() ||
        frame.sequence() <= metrics.connectionLastSequence[slot] ||
        metrics.simulation.tick() - metrics.connectionChatLastTick[slot] < 6) {
        return false
    }
    var sender = metrics.connectionPlayerIds[slot]
    if (metrics.connectionSpectators[slot]) {
        if (words[4] != sessionWebChatGlobal()) { return false }
    } else if (words[4] == sessionWebChatTeam()) {
        if (metrics.simulation.playerTeam(sender) != words[5]) { return false }
    } else if (words[4] == sessionWebChatWhisper()) {
        if (words[5] == sender || metrics.simulation.playerState(words[5]).active == false) {
            return false
        }
    }
    words[7] = sender
    words[words.length - 1] =
        sessionWebMessageChecksum(words, words.length - 1)
    metrics.connectionLastSequence[slot] = frame.sequence()
    metrics.connectionChatLastTick[slot] = metrics.simulation.tick()
    return webDistributeChat(metrics, words)
}

Bool webHandleJoin(WebServerMetrics metrics, Int slot, Int[] words) {
    if (!validSessionWebGameJoinRequest(words) ||
        (metrics.connectionSpectatorRoute[slot] &&
            words[4] != sessionWebRoleSpectator()) ||
        (!metrics.connectionSpectatorRoute[slot] &&
            words[4] != sessionWebRolePlayer() &&
            words[4] != sessionWebRoleTraining())) { return false }
    var role = words[4]
    var playerId = metrics.nextPlayerIdValue
    var selectedTeam = if (words.length == 7) words[5]
        else metrics.connectionTeam[slot]
    var accepted = false
    if (role == sessionWebRoleTraining()) {
        if (!metrics.simulation.trainingMode() &&
            metrics.playerCount() == 0) {
            metrics.simulation.enableTrainingMode()
        }
        if (metrics.simulation.trainingMode() &&
            metrics.playerCount() < 4 && playerId <= 1000000) {
            var spawnX = 24 + (playerId % 4) * 12
            var spawnZ = 24 + (playerId % 3) * 12
            accepted = metrics.simulation.addPlayer(
                playerId, 1, spawnX, 1, spawnZ)
        }
    } else if (role == sessionWebRolePlayer()) {
        if (!metrics.simulation.trainingMode() &&
            metrics.playerCount() < 8 && playerId <= 1000000) {
            var spawnX = 24 + (playerId % 4) * 12
            var spawnZ = 24 + (playerId % 3) * 12
            accepted = metrics.simulation.addPlayer(
                playerId, metrics.connectionAnimal[slot],
                spawnX, 1, spawnZ)
            if (accepted && selectedTeam > 0) {
                accepted = metrics.simulation.setPlayerTeam(
                    playerId, selectedTeam)
            }
        }
    } else {
        accepted = metrics.spectatorCount() < 4 && playerId <= 1000000
    }
    if (accepted) {
        metrics.nextPlayerIdValue = metrics.nextPlayerIdValue + 1
        metrics.connectionJoined[slot] = true
        metrics.connectionSpectators[slot] = role == sessionWebRoleSpectator()
        metrics.connectionPlayerIds[slot] = playerId
        metrics.connectionTeam[slot] = selectedTeam
    } else { playerId = 0 }
    var response = newSessionWebGameJoinResponse(words[2], accepted, role, playerId,
        metrics.playerCount(), metrics.spectatorCount())
    if (response.length <= 0 || !webSendSessionWords(metrics.connectionIds[slot],
            sessionWebGameKind(), words[2], response)) { return false }
    if (!accepted) {
        kookie_web_server_close_client_after_output(metrics.connectionIds[slot])
    } else if (!webReplayChatHistory(metrics, slot)) {
        return false
    }
    return true
}
Bool webHandleMapVote(
    WebServerMetrics metrics, Int slot, WebSessionFrame frame
) {
    var words = frame.words()
    if (words.length != 6 || words[3] != sessionWebGameMapVoteMarker() ||
        metrics.matchPhaseValue != sessionWebGameMatchIntermission() ||
        metrics.connectionSpectators[slot] ||
        (words[4] != sessionWebGameMapOne() &&
            words[4] != sessionWebGameMapTwo()) ||
        words[5] != sessionWebMessageChecksum(words, 5) ||
        frame.sequence() <= metrics.connectionLastSequence[slot]) {
        return false
    }
    metrics.connectionLastSequence[slot] = frame.sequence()
    metrics.connectionMapVote[slot] = words[4]
    return true
}

Bool webSendAdminResponse(
    WebServerMetrics metrics, Int slot, Int sequence, Int operation, Int result
) {
    var outgoingSequence = webOutputSequence(metrics, slot)
    var words = new Int[10]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebGameKind()
    words[2] = outgoingSequence
    words[3] = sessionWebGameAdminResponseMarker()
    words[4] = operation
    words[5] = result
    words[6] = metrics.simulation.tick()
    words[7] = metrics.playerCount()
    words[8] = metrics.spectatorCount()
    words[9] = sessionWebMessageChecksum(words, 9)
    return webSendSessionWords(metrics.connectionIds[slot],
        sessionWebGameKind(), outgoingSequence, words)
}

Bool webHandleAdmin(
    WebServerMetrics metrics, Int slot, WebSessionFrame frame
) {
    var words = frame.words()
    if (!metrics.connectionAdmin[slot] ||
        words.length < 6 ||
        words[0] != sessionWebGameProtocolVersion() ||
        words[1] != sessionWebGameKind() ||
        words[2] != frame.sequence() ||
        words[3] != sessionWebGameAdminMarker() ||
        words[words.length - 1] !=
            sessionWebMessageChecksum(words, words.length - 1) ||
        frame.sequence() <= metrics.connectionLastSequence[slot]) {
        return false
    }
    var operation = words[4]
    var result = 1
    if (operation == sessionWebGameAdminStatus() && words.length == 6) {
        result = 0
    } else if (operation == sessionWebGameAdminKick() &&
        words.length == 7 && words[5] > 0 && words[5] <= 1000000) {
        var targetSlot = -1
        for (var client = 0; client < 12; client = client + 1) {
            if (metrics.connectionUsed[client] &&
                metrics.connectionJoined[client] &&
                !metrics.connectionSpectators[client] &&
                metrics.connectionPlayerIds[client] == words[5]) {
                targetSlot = client
                break
            }
        }
        if (targetSlot >= 0 &&
            metrics.simulation.removePlayer(words[5])) {
            metrics.connectionJoined[targetSlot] = false
            kookie_web_server_close_client_after_output(
                metrics.connectionIds[targetSlot])
            result = 0
        } else { result = 2 }
    } else if (operation == sessionWebGameAdminSetTeam() &&
        words.length == 8 && words[5] > 0 && words[5] <= 1000000 &&
        words[6] >= 0 && words[6] <= 2) {
        if (metrics.simulation.setPlayerTeam(words[5], words[6])) {
            for (var client = 0; client < 12; client = client + 1) {
                if (metrics.connectionUsed[client] &&
                    metrics.connectionJoined[client] &&
                    metrics.connectionPlayerIds[client] == words[5]) {
                    metrics.connectionTeam[client] = words[6]
                }
            }
            result = 0
        } else { result = 2 }
    } else if (operation == sessionWebGameAdminSay() &&
        words.length >= 8 && words[5] >= 1 && words[5] <= 80 &&
        words.length == 7 + words[5]) {
        var message = new Int[9 + words[5]]
        message[0] = sessionWebGameProtocolVersion()
        message[1] = sessionWebGameKind()
        message[2] = frame.sequence()
        message[3] = sessionWebGameChatMarker()
        message[4] = sessionWebChatGlobal()
        message[5] = 0
        message[6] = words[5]
        message[7] = 1000000
        var validText = true
        for (var index = 0; index < words[5]; index = index + 1) {
            var character = words[6 + index]
            if (character < 32 || character > 126) { validText = false }
            message[8 + index] = character
        }
        if (validText) {
            message[message.length - 1] =
                sessionWebMessageChecksum(message, message.length - 1)
            if (webDistributeChat(metrics, message)) { result = 0 }
        }
    } else if (operation == sessionWebGameAdminMapVoteStart() &&
        words.length == 6) {
        result = if (webBeginMapIntermission(metrics)) 0 else 1
    }
    metrics.connectionLastSequence[slot] = frame.sequence()
    return webSendAdminResponse(metrics, slot, frame.sequence(), operation, result)
}

Bool webHandleGame(WebServerMetrics metrics, Int slot, WebSessionFrame frame) {
    var words = frame.words()
    if (metrics.connectionAdmin[slot]) {
        return webHandleAdmin(metrics, slot, frame)
    }
    if (words.length > 3 &&
        words[3] == sessionWebKutterRequestMarker()) {
        return webHandleKutter(metrics, slot, frame)
    }
    if (!metrics.connectionJoined[slot]) {
        if (words.length > 3 && words[3] == sessionWebGameJoinRequestMarker()) {
            return webHandleJoin(metrics, slot, words)
        }
        return false
    }
    if (words.length > 3 &&
        words[3] == sessionWebGameChatMarker()) {
        return webHandleChat(metrics, slot, frame)
    }
    if (words.length > 3 &&
        words[3] == sessionWebGameMapVoteMarker()) {
        return webHandleMapVote(metrics, slot, frame)
    }
    if (metrics.connectionSpectators[slot]) {
        if (validSessionWebGameChat(words)) {
            return webHandleChat(metrics, slot, frame)
        }
        return false
    }
    if (validSessionWebGameInput(words)) {
        if (frame.sequence() <= metrics.connectionLastSequence[slot]) { return false }
        metrics.connectionLastSequence[slot] = frame.sequence()
        if (metrics.matchPhaseValue ==
            sessionWebGameMatchIntermission()) {
            metrics.connectionInputSequence[slot] = frame.sequence()
            metrics.connectionAppliedInputSequence[slot] = frame.sequence()
            metrics.connectionMoveX[slot] = 0
            metrics.connectionMoveZ[slot] = 0
            metrics.connectionLookYaw[slot] = 0
            metrics.connectionLookPitch[slot] = 0
            metrics.connectionHeldActions[slot] = 0
            metrics.connectionEdgeActions[slot] = 0
            return true
        }
        metrics.connectionInputSequence[slot] = frame.sequence()
        metrics.connectionMoveX[slot] = words[5]; metrics.connectionMoveZ[slot] = words[6]
        metrics.connectionLookYaw[slot] = metrics.connectionLookYaw[slot] + words[7]
        metrics.connectionLookPitch[slot] = metrics.connectionLookPitch[slot] + words[8]
        if (metrics.connectionLookYaw[slot] > 1800) { metrics.connectionLookYaw[slot] = 1800 }
        if (metrics.connectionLookYaw[slot] < -1800) { metrics.connectionLookYaw[slot] = -1800 }
        if (metrics.connectionLookPitch[slot] > 1800) { metrics.connectionLookPitch[slot] = 1800 }
        if (metrics.connectionLookPitch[slot] < -1800) { metrics.connectionLookPitch[slot] = -1800 }
        metrics.connectionHeldActions[slot] = words[9]
        metrics.connectionEdgeActions[slot] = metrics.connectionEdgeActions[slot] | words[10]
        return true
    }
    if (validSessionWebGameProbe(words)) {
        return webSendSessionWords(
            metrics.connectionIds[slot], sessionWebGameKind(), frame.sequence(), words)
    }
    if (validSessionWebGameCommand(words)) {
        if (words[4] == sessionWebGameResetCommand()) {
            var id = metrics.connectionPlayerIds[slot]
            metrics.simulation.removePlayer(id)
            var reset = metrics.simulation.addPlayer(id, 1, 36, 1, 36)
            if (!reset) { return false }
            metrics.connectionMoveX[slot] = 0; metrics.connectionMoveZ[slot] = 0
            metrics.connectionHeldActions[slot] = 0; metrics.connectionEdgeActions[slot] = 0
            return true
        }
    }
    return false
}
Bool webHandleWebSocketEvent(WebServerMetrics metrics, Int slot) {
    var opcode = kookie_web_server_event_opcode()
    var length = kookie_web_server_event_payload_length()
    if (length < 0 || length > webMaximumWebSocketPayloadBytes()) { return false }
    var payload = webEventBytes(length)
    if (opcode == webWebSocketOpcodePing()) {
        return webSendWsFrame(metrics.connectionIds[slot], webWebSocketOpcodePong(), payload)
    }
    if (opcode == webWebSocketOpcodePong()) { return true }
    if (opcode == webWebSocketOpcodeClose()) {
        webSendWsFrame(metrics.connectionIds[slot], webWebSocketOpcodeClose(), payload)
        kookie_web_server_close_client_after_output(metrics.connectionIds[slot])
        return true
    }
    if (opcode != webWebSocketOpcodeBinary()) { return false }
    var frame = WebSessionFrame(payload)
    if (!frame.valid()) { return false }
    metrics.frameCountValue = metrics.frameCountValue + 1
    if (!metrics.connectionHello[slot]) {
        if (frame.kind() != sessionWebHelloKind() || !validSessionWebHello(frame.words())) { return false }
        if (!webSendHelloAck(metrics, slot, frame.sequence())) { return false }
        metrics.connectionHello[slot] = true
        return true
    }
    if (frame.kind() == sessionWebPingKind()) {
        if (!validSessionWebPing(frame.words(), sessionWebPingKind())) { return false }
        return webSendPong(metrics, slot, frame.sequence())
    }
    if (frame.kind() == sessionWebGameKind()) { return webHandleGame(metrics, slot, frame) }
    return false
}
Bool webHandleHttp(WebServerMetrics metrics, Int slot, Int[] request, Int length) {
    var id = metrics.connectionIds[slot]
    if (webRequestLine(request, length, "GET", "/healthz")) {
        metrics.healthCountValue = metrics.healthCountValue + 1
        if (!webSendTextResponse(
            id, "200 OK", "application/json; charset=utf-8", metrics.healthBody())) {
            return false
        }
        return kookie_web_server_close_client_after_output(id)
    }
    if (webRequestLine(request, length, "GET", "/metrics")) {
        metrics.metricsCountValue = metrics.metricsCountValue + 1
        if (!webSendTextResponse(
            id, "200 OK", "text/plain; version=0.0.4; charset=utf-8", metrics.metricsBody())) {
            return false
        }
        return kookie_web_server_close_client_after_output(id)
    }
    var adminRoute = webRequestLine(request, length, "GET", "/admin")
    var spectator = webRequestLine(request, length, "GET", "/spectate")
    var gooseBot = webRequestLine(request, length, "GET", "/session/goose")
    var catBot = webRequestLine(request, length, "GET", "/session/cat")
    if (adminRoute && !kookie_web_server_rcon_authorized()) {
        metrics.rejectionCountValue = metrics.rejectionCountValue + 1
        webSendTextResponse(id, "401 Unauthorized",
            "text/plain; charset=utf-8", "admin authentication required\n")
        return kookie_web_server_close_client_after_output(id)
    }
    if (!adminRoute && !spectator && !gooseBot && !catBot &&
        !webRequestLine(request, length, "GET", "/session")) {
        webSendTextResponse(id, "404 Not Found", "text/plain; charset=utf-8", "not found\n")
        return kookie_web_server_close_client_after_output(id)
    }
    if (gooseBot) {
        metrics.connectionAnimal[slot] = 1
        metrics.connectionTeam[slot] = 1
    } else if (catBot) {
        metrics.connectionAnimal[slot] = 2
        metrics.connectionTeam[slot] = 2
    }
    if (!webHeaderContainsToken(request, length, "Upgrade", "websocket") ||
        !webHeaderContainsToken(request, length, "Connection", "Upgrade") ||
        !webHeaderContainsToken(request, length, "Sec-WebSocket-Protocol", "kookie.v1")) {
        metrics.rejectionCountValue = metrics.rejectionCountValue + 1
        webSendTextResponse(id, "400 Bad Request", "text/plain; charset=utf-8", "bad websocket request\n")
        return kookie_web_server_close_client_after_output(id)
    }
    var version = webFindHeaderValueStart(request, length, "Sec-WebSocket-Version")
    if (version < 0 || !webRangeEquals(request, version / 100000, version % 100000, "13")) { return false }
    if (!kookie_web_server_upgrade_websocket(id)) { return false }
    metrics.connectionWebSocket[slot] = true
    metrics.connectionAdmin[slot] = adminRoute
    metrics.connectionSpectatorRoute[slot] = spectator
    metrics.upgradeCountValue = metrics.upgradeCountValue + 1
    return true
}
Bool webTickDue(WebServerMetrics metrics, Long now) {
    return now >= metrics.nextTickNanosecondsValue
}
main() {
    var port = kookie_web_server_port()
    if (!kookie_web_server_open(port)) { println("KOOKIE Kof web server bind rejected"); process.exit(1) }
    var metrics = WebServerMetrics()
    if (!metrics.simulation.configure()) {
        println("KOOKIE multiplayer simulation setup failed")
        metrics.simulation.destroyBox3DArena()
        kookie_web_server_close()
        process.exit(1)
    }
    metrics.nextTickNanosecondsValue = kookie_web_server_monotonic_nanoseconds() + 16667000L
    println("KOOKIE authoritative web multiplayer listening port=" + port)
    while (true) {
        var now = kookie_web_server_monotonic_nanoseconds()
        var timeout = 0
        if (now < metrics.nextTickNanosecondsValue) {
            timeout = ((metrics.nextTickNanosecondsValue - now) / 1000000L) as Int
            if (timeout > 50) { timeout = 50 }
        }
        var event = kookie_web_server_poll_event(timeout)
        if (event < 0) {
            println("KOOKIE web transport poll returned fatal status")
            metrics.simulation.destroyBox3DArena()
            kookie_web_server_close()
            process.exit(1)
        }
        var connectionId = kookie_web_server_event_connection_id()
        if (event == 1) {
            if (metrics.reserve(connectionId) < 0) { kookie_web_server_close_client(connectionId) }
        } else if (event == 2) {
            var slot = metrics.find(connectionId)
            var length = kookie_web_server_event_payload_length()
            if (slot < 0 || length <= 0 || length > webMaximumRequestBytes() ||
                !webHandleHttp(metrics, slot, webEventBytes(length), length)) {
                metrics.rejectionCountValue = metrics.rejectionCountValue + 1
                kookie_web_server_close_client(connectionId)
                metrics.release(connectionId)
            }
        } else if (event == 3) {
            var slot = metrics.find(connectionId)
            if (slot < 0 || !metrics.connectionWebSocket[slot] || !webHandleWebSocketEvent(metrics, slot)) {
                metrics.rejectionCountValue = metrics.rejectionCountValue + 1
                kookie_web_server_close_client(connectionId)
                metrics.release(connectionId)
            }
        } else if (event == 4) {
            metrics.release(connectionId)
        }
        now = kookie_web_server_monotonic_nanoseconds()
        if (webTickDue(metrics, now)) {
            var scheduledDeadline = metrics.nextTickNanosecondsValue
            if (!webTick(metrics)) {
                println("KOOKIE authoritative tick failed")
                process.exit(1)
            }
            metrics.nextTickNanosecondsValue =
                scheduledDeadline + metrics.simulation.tickNanoseconds()
            if (webTickDue(metrics, now)) {
                metrics.tickScheduleOverrunsValue =
                    metrics.tickScheduleOverrunsValue + 1
                metrics.nextTickNanosecondsValue =
                    now + metrics.simulation.tickNanoseconds()
            }
        }
    }
}
