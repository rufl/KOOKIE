import core
import session
import content

extern "./build/libkookie_sdl_adapter.so" kookie_sdl_init(Int flags): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_sdl_shutdown(): void
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_open_headless_ready(): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_close_headless(): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_scene_capacity(): Int
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_scene_reserve_capacity(
    Int vertexCapacity
): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_scene_begin(Int vertexCount): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_scene_push_vertex_resource(
    Int resource, Int x, Int y, Int depth, Int u, Int v
): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_scene_commit(): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_scene_count(): Int
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_scene_batch_calls(): Int
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_scene_scalar_calls(): Int
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_scene_draw_calls(): Int
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_capture_headless_scene(): Int
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_scene_instances(): Int
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_measure_reference_scene(
    Int warmupFrames, Int measuredFrames, Int width, Int height
): Int
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_world_begin(
    Int vertexCount
): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_world_push_vertex_uv(
    Int x, Int y, Int z, Int textureU, Int textureV
): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_world_commit(): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_world_camera_stage_begin(): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_world_camera_stage_word(
    Int index, Int value
): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_world_camera_stage_commit(): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_render_set_passes(
    Int world, Int scene
): Bool


Bool uploadReferenceFrame(FrameStaging frame) {
    if (kookie_gpu_scene_encode_batch(frame, 1)) {
        return true
    }
    for (var index = 0; index < frame.stagedCount(); index = index + 1) {
        if (!kookie_gpu_scene_push_vertex_resource(
                frame.resourceAt(index), frame.xAt(index), frame.yAt(index),
                frame.depthAt(index), frame.uAt(index), frame.vAt(index))) {
            return false
        }
    }
    return true
}

Bool stageVfxWorld(
    BoundedWorldTextureAsset texture, CameraState camera
) {
    if (!texture.buildWithVfx(0, 0, 0, 0, true) ||
        !stageGpuWorldTextureBatch(texture) ||
        !camera.buildGpuCameraMatrix(320, 240) ||
        !kookie_gpu_world_camera_stage_begin()) {
        return false
    }
    for (var index = 0; index < 16; index = index + 1) {
        if (!kookie_gpu_world_camera_stage_word(
                index, camera.gpuCameraMatrixElement(index))) {
            return false
        }
    }
    if (!kookie_gpu_world_camera_stage_commit()) {
        return false
    }
    var resource = worldVfxResource(worldVfxParticleSlashAsset(), 0)
    var leftU = texture.textureU(resource, 0)
    var rightU = texture.textureU(resource, 100)
    var bottomV = texture.textureV(resource, 0)
    var topV = texture.textureV(resource, 100)
    return leftU >= 0 && rightU > leftU &&
        bottomV >= 0 && topV > bottomV &&
        kookie_gpu_world_begin(6) &&
        kookie_gpu_world_push_vertex_uv(-20, -5, 100, leftU, bottomV) &&
        kookie_gpu_world_push_vertex_uv(20, -5, 100, rightU, bottomV) &&
        kookie_gpu_world_push_vertex_uv(20, 25, 100, rightU, topV) &&
        kookie_gpu_world_push_vertex_uv(-20, -5, 100, leftU, bottomV) &&
        kookie_gpu_world_push_vertex_uv(20, 25, 100, rightU, topV) &&
        kookie_gpu_world_push_vertex_uv(-20, 25, 100, leftU, topV) &&
        kookie_gpu_world_commit()
}

main() {
    assert(kookie_sdl_init(32), "SDL video adapter must initialize")
    assert(kookie_gpu_open_headless_ready(),
        "isolated SDL GPU device must open headlessly")
    var server = BoundedDedicatedServer(64, 256, 512, 16, 64, 128)
    var renderer = BoundedScaleReferenceRenderer()
    var frame = FrameStaging(renderer.vertexCount())
    var vfxTexture = BoundedWorldTextureAsset()
    var camera = CameraState(-450, 450)
    assert(server.configureReferenceWorkload(),
        "reference server must configure authored collision")
    assert(server.runTicks(8), "reference server must advance")
    assert(renderer.vertexCount() == 2952 &&
        renderer.environmentVertices() == 192 &&
        renderer.entityInstances() == 832 &&
        renderer.dynamicEffectInstances() == 88 &&
        renderer.batchedDrawCalls() == 1,
        "reference renderer counts must match the bounded scene")
    assert(kookie_gpu_scene_reserve_capacity(renderer.vertexCount()) &&
        kookie_gpu_scene_capacity() >= renderer.vertexCount(),
        "GPU scene buffer must fit the reference batch")
    assert(renderer.stage(server, frame, 1),
        "Kof renderer must stage the reference batch")
    assert(kookie_gpu_scene_begin(frame.stagedCount()) &&
        uploadReferenceFrame(frame) &&
        kookie_gpu_scene_commit(),
        "native adapter must accept the complete staged batch")
    var instanceCount = kookie_gpu_scene_instances()
    assert(kookie_gpu_scene_count() == renderer.vertexCount() &&
        instanceCount == 984 &&
        kookie_gpu_scene_batch_calls() == 1 &&
        kookie_gpu_scene_scalar_calls() == 0,
        "GPU scene must use one V1 batch without scalar fallback")
    assert(stageVfxWorld(vfxTexture, camera),
        "native adapter must stage the complete VFX atlas and world quad")
    assert(kookie_gpu_render_set_passes(0, 0),
        "headless capture must accept the empty render policy")
    var baselineChecksum = kookie_gpu_capture_headless_scene()
    assert(baselineChecksum > 0 && kookie_gpu_scene_draw_calls() == 0,
        "headless capture must produce the clear-frame baseline")
    assert(kookie_gpu_render_set_passes(1, 0),
        "headless capture must select the world VFX pass")
    var vfxChecksum = kookie_gpu_capture_headless_scene()
    assert(vfxChecksum > 0 && vfxChecksum != baselineChecksum &&
        kookie_gpu_scene_draw_calls() == 1,
        "hardware renderer must capture visible VFX atlas pixels")
    assert(kookie_gpu_render_set_passes(0, 1),
        "headless capture must select the reference UI pass")
    var referenceChecksum = kookie_gpu_capture_headless_scene()
    assert(referenceChecksum > 0 && kookie_gpu_scene_draw_calls() == 1,
        "hardware renderer must capture the reference scene")
    var p95Micros = kookie_gpu_measure_reference_scene(
        60, 600, 1920, 1080)
    assert(p95Micros > 0 && p95Micros <= 8333 &&
        kookie_gpu_scene_draw_calls() == 1 && frame.retire(1),
        "G5 reference batch must fit the 1920x1080 120 Hz frame budget")
    assert(kookie_gpu_close_headless(), "headless GPU device must close")
    kookie_sdl_shutdown()
    println("KOOKIE G5 native reference renderer verified")
    println("g5-renderer-vertices")
    println(renderer.vertexCount())
    println("g5-renderer-draw-calls")
    println(renderer.batchedDrawCalls())
    println("g5-renderer-instances")
    println(instanceCount)
    println("g5-renderer-batch-calls")
    println(kookie_gpu_scene_batch_calls())
    println("g5-renderer-scalar-calls")
    println(kookie_gpu_scene_scalar_calls())
    println("g5-renderer-vfx-baseline-checksum")
    println(baselineChecksum)
    println("g5-renderer-vfx-checksum")
    println(vfxChecksum)
    println("g5-renderer-reference-checksum")
    println(referenceChecksum)
    println("g5-renderer-p95-us")
    println(p95Micros)
}
