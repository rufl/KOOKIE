import ui

main() {
    var studio = BoundedCreatorStudio(16, 8)
    assert(studio.configure(4, 1001, 7) &&
        studio.addNode(10, 0, creatorModeWorld(), 100, 200, 300, 45, 1000) &&
        studio.addNode(20, 10, creatorModeEntity(), -5, 6, 7, 90, 1250) &&
        studio.addAsset(501, 1, 2, 712345, 3) &&
        studio.seal(),
        "Studio must seal bounded hierarchy, transforms, and assets")
    var checksum = studio.checksum()
    var path = "build/creator_studio.kstudio"
    assert(studio.save(path), "Studio must persist canonical binary state")

    var reopened = BoundedCreatorStudio(16, 8)
    assert(reopened.load(path) && reopened.checksum() == checksum &&
        reopened.nodeCount() == 2 && reopened.nodeParent(1) == 10 &&
        reopened.nodeXValue(1) == -5 && reopened.nodeScaleValue(1) == 1250 &&
        reopened.assetCount() == 1 && reopened.assetStatus(0) == 2,
        "Studio must reopen hierarchy and asset registry deterministically")

    var badBytes = File(path).readRange(0, 100000)
    assert(badBytes.length > 0, "Studio package bytes must be readable")
    badBytes[badBytes.length - 1] = (badBytes[badBytes.length - 1] ^ 1) as Int
    var badPath = "build/creator_studio_bad.kstudio"
    assert(File(badPath).writeBytes(badBytes),
        "Studio tamper fixture must be writable")
    assert(!reopened.load(badPath) && reopened.checksum() == checksum &&
        reopened.nodeCount() == 2,
        "failed Studio open must preserve active project")

    var workspace = BoundedCreatorWorkspace()
    assert(workspace.begin(1) && workspace.stageEntity(7, 11, 22, 33) &&
        workspace.stageAsset(501) && workspace.publish(),
        "workspace transaction must publish before Studio capture")
    var captured = BoundedCreatorStudio(16, 8)
    assert(captured.captureWorkspace(workspace) && captured.nodeCount() == 1 &&
        captured.nodeXValue(0) == 11 && captured.assetId(0) == 501,
        "Studio must capture the existing bounded creator workspace")

    println("KOOKIE G6 persistent Studio verified")
    println("studio-checksum=" + checksum)
    println("studio-nodes=" + reopened.nodeCount())
    println("studio-assets=" + reopened.assetCount())
    println("studio-capture-generation=" + captured.generation())
}
