Int kookieModelGoose() { return 1 }
Int kookieModelCat() { return 2 }


Int lobbyProtocolMagic() { return 1263488843 }
Int lobbyMessageHello() { return 1 }
Int lobbyMessageAccept() { return 2 }
Int lobbyMessageLeave() { return 3 }
Int lobbyMessageWait() { return 4 }
Int lobbyMessagePeer() { return 5 }
Int lobbyMessageReady() { return 6 }
Int lobbyMessageUnready() { return 7 }

class NativeLobbyState {
    Bool wanRendezvousValue
    Bool wanPeerReadyValue
    Bool hostValue
    Int remoteNameIdValue

    public constructor() {
        wanRendezvousValue = false
        wanPeerReadyValue = false
        hostValue = true
        remoteNameIdValue = 2
    }

    Bool wanRendezvous() { return wanRendezvousValue }
    Bool peerReady() { return wanPeerReadyValue }
    Bool host() { return hostValue }
    Int remoteNameId() { return remoteNameIdValue }
    void setWanRendezvous(Bool value) { wanRendezvousValue = value }
    void setPeerReady(Bool value) { wanPeerReadyValue = value }
    void setHost(Bool value) { hostValue = value }
    void setRemoteNameId(Int value) { remoteNameIdValue = value }
}

Bool configureLobbyKey() {
    if (kookie_transport_set_key_from_environment()) { return true }
    if (kookie_transport_wan_rendezvous_enabled()) { return false }
    return kookie_transport_set_key(
        1263488843, 1330332754, 1229737803, 1162760019)
}

Bool sendLobbyMessage(Int operation, Int role) {
    var room = kookie_transport_room_code()
    var name = kookie_transport_player_name_id()
    return kookie_transport_send_begin(6) &&
        kookie_transport_send_word(0, lobbyProtocolMagic()) &&
        kookie_transport_send_word(1, 1) &&
        kookie_transport_send_word(2, operation) &&
        kookie_transport_send_word(3, room) &&
        kookie_transport_send_word(4, role) &&
        kookie_transport_send_word(5, name) &&
        kookie_transport_send_commit()
}

Int lobbyRole(Int operation) {
    if (operation == gameShellNetworkHostRequest()) { return 1 }
    return 2
}

Bool serviceNetworkRequest(GameShell shell, NativeLobbyState state) {
    var operation = shell.networkRequest()
    if (operation == 0) { return true }
    if (operation == gameShellNetworkLeaveRequest()) {
        if (shell.networkStatus() == gameShellNetworkConnected()) {
            sendLobbyMessage(
                lobbyMessageLeave(),
                if (state.host()) 1 else 2)
        }
        state.setWanRendezvous(false)
        state.setPeerReady(false)
        state.setHost(true)
        kookie_transport_close()
        return shell.completeNetworkRequest(operation, true)
    }
    kookie_transport_close()
    state.setWanRendezvous(kookie_transport_wan_rendezvous_enabled())
    state.setPeerReady(false)
    state.setHost(operation == gameShellNetworkHostRequest())
    state.setRemoteNameId(
        if (operation == gameShellNetworkHostRequest()) 2 else 1)
    var success = kookie_transport_select_slot(0) && configureLobbyKey()
    if (success && state.wanRendezvous() &&
        (operation == gameShellNetworkHostRequest() ||
            operation == gameShellNetworkJoinRequest())) {
        success = kookie_transport_open_rendezvous_environment(shell.port()) &&
            sendLobbyMessage(lobbyMessageHello(), lobbyRole(operation))
    } else if (success && operation == gameShellNetworkHostRequest()) {
        success = kookie_transport_open_listen_ipv4(shell.port())
    } else if (success && operation == gameShellNetworkJoinRequest()) {
        success = kookie_transport_open_remote_ipv4(
            shell.addressOne(), shell.addressTwo(),
            shell.addressThree(), shell.addressFour(), shell.port()) &&
            sendLobbyMessage(lobbyMessageHello(), lobbyRole(operation))
    }
    if (!success) { kookie_transport_close() }
    return shell.completeNetworkRequest(operation, success)
}

Bool validLobbyEnvelope(Int received) {
    return received >= 4 &&
        kookie_transport_receive_word(0) == lobbyProtocolMagic() &&
        kookie_transport_receive_word(1) == 1 &&
        kookie_transport_receive_word(3) == kookie_transport_room_code()
}

Bool serviceNetworkHandshake(
    GameShell shell, NativeLobbyState state
) {
    var status = shell.networkStatus()
    if (status != gameShellNetworkHosting() &&
        status != gameShellNetworkJoining() &&
        status != gameShellNetworkConnected()) {
        return true
    }
    if (state.wanRendezvous() &&
        status != gameShellNetworkConnected() &&
        !sendLobbyMessage(
            lobbyMessageHello(),
            if (status == gameShellNetworkHosting()) 1 else 2)) {
        return false
    }
    if (status == gameShellNetworkConnected() &&
        !sendLobbyMessage(
            if (shell.lobby().localReady())
                lobbyMessageReady() else lobbyMessageUnready(),
            if (state.host()) 1 else 2)) {
        return false
    }
    var received = kookie_transport_receive_available()
    if (received == 0 || !validLobbyEnvelope(received)) { return true }
    var operation = kookie_transport_receive_word(2)
    if (operation == lobbyMessageWait()) { return true }
    if (operation == lobbyMessagePeer() && state.wanRendezvous() &&
        received == 9 &&
        kookie_transport_receive_word(8) > 0) {
        if (!kookie_transport_set_peer_ipv4(
                kookie_transport_receive_word(4),
                kookie_transport_receive_word(5),
                kookie_transport_receive_word(6),
                kookie_transport_receive_word(7),
                kookie_transport_receive_word(8)) ||
            !kookie_transport_reset_session()) {
            return false
        }
        state.setPeerReady(true)
        return sendLobbyMessage(
            lobbyMessageHello(),
            if (status == gameShellNetworkHosting()) 1 else 2)
    }
    if (operation == lobbyMessageLeave()) {
        kookie_transport_close()
        state.setPeerReady(false)
        return shell.markNetworkDisconnected()
    }
    if (received < 6) { return true }
    var remoteNameId = kookie_transport_receive_word(5)
    if (remoteNameId < 1 || remoteNameId > 4) { return false }
    state.setRemoteNameId(remoteNameId)
    if (operation == lobbyMessageHello()) {
        return kookie_transport_set_peer_last_sender() &&
            sendLobbyMessage(lobbyMessageAccept(),
                if (status == gameShellNetworkHosting()) 1 else 2) &&
            shell.markNetworkConnected()
    }
    if (operation == lobbyMessageAccept()) {
        return shell.markNetworkConnected()
    }
    if ((operation == lobbyMessageReady() ||
            operation == lobbyMessageUnready()) &&
        status == gameShellNetworkConnected()) {
        return shell.lobby().setRemoteReady(
            operation == lobbyMessageReady())
    }
    return true
}

class NativeGameNetworkState {
    Int[] receiveValues
    Int receiveCountValue
    Int localSequenceValue
    Int remoteSequenceValue
    Int remoteMoveValue
    Int remoteMoveZValue
    Int remoteJumpValue
    Bool remoteFireValue
    Int remoteInputSequenceValue
    Int remoteSnapshotAckValue
    Int remoteFireTickValue
    Int lastRemoteSnapshotSequenceValue
    Int lastRemoteInputAckValue
    Int remotePlayerOneHealthValue
    Int remotePlayerTwoHealthValue
    Bool remoteStatusReadyValue
    NetcodeInputHistory localInputHistoryValue

    public constructor(Int capacity) {
        var actualCapacity = capacity
        if (actualCapacity <= 0) { actualCapacity = 1 }
        receiveValues = new Int[actualCapacity]
        localSequenceValue = 0
        remoteSequenceValue = 0
        remoteMoveValue = 0
        remoteMoveZValue = 0
        remoteJumpValue = 0
        remoteFireValue = false
        remoteInputSequenceValue = 0
        remoteSnapshotAckValue = 0
        remoteFireTickValue = 0
        lastRemoteSnapshotSequenceValue = 0
        lastRemoteInputAckValue = 0
        remotePlayerOneHealthValue = 100
        remotePlayerTwoHealthValue = 100
        remoteStatusReadyValue = false
        localInputHistoryValue = NetcodeInputHistory(
            netcodeMaximumInputHistory())
    }

    void reset() {
        receiveCountValue = 0
        localSequenceValue = 0
        remoteSequenceValue = 0
        remoteMoveValue = 0
        remoteMoveZValue = 0
        remoteJumpValue = 0
        remoteFireValue = false
        remoteFireTickValue = 0
        lastRemoteSnapshotSequenceValue = 0
        lastRemoteInputAckValue = 0
        remotePlayerOneHealthValue = 100
        remotePlayerTwoHealthValue = 100
        remoteStatusReadyValue = false
        localInputHistoryValue.clear()
    }

    Int nextLocalSequence() {
        localSequenceValue = localSequenceValue + 1
        if (localSequenceValue > 1000000) { localSequenceValue = 1 }
        return localSequenceValue
    }

    Int nextRemoteSequence() {
        remoteSequenceValue = remoteSequenceValue + 1
        if (remoteSequenceValue > 1000000) { remoteSequenceValue = 1 }
        return remoteSequenceValue
    }

    Bool recordLocalInput(
        Int tick, Int sequence, Int moveX, Int moveZ,
        Int fire, Int jump
    ) {
        return localInputHistoryValue.push(
            tick, sequence, moveX, moveZ, fire, jump)
    }

    Int[] localInputWords() {
        return localInputHistoryValue.commandWords()
    }

    Bool acknowledgeLocalInput(Int sequence) {
        if (sequence <= 0) { return true }
        if (sequence > localInputHistoryValue.latestSequence()) {
            return false
        }
        return localInputHistoryValue.acknowledge(sequence)
    }

    Int localInputCount() { return localInputHistoryValue.count() }
    Int localInputAck() { return localInputHistoryValue.acknowledgedSequence() }

    void setRemoteMove(Int value) {
        remoteMoveValue = value
        if (remoteMoveValue < -4) { remoteMoveValue = -4 }
        if (remoteMoveValue > 4) { remoteMoveValue = 4 }
    }
    void setRemoteMoveZ(Int value) {
        remoteMoveZValue = value
        if (remoteMoveZValue < -4) { remoteMoveZValue = -4 }
        if (remoteMoveZValue > 4) { remoteMoveZValue = 4 }
    }
    void setRemoteJump(Int value) {
        remoteJumpValue = value
        if (remoteJumpValue < 0) { remoteJumpValue = 0 }
        if (remoteJumpValue > 1) { remoteJumpValue = 1 }
    }

    Int remoteJump() { return remoteJumpValue }

    Int remoteMoveZ() { return remoteMoveZValue }

    Int remoteMove() { return remoteMoveValue }
    void setRemoteFire() { setRemoteFireAt(0) }
    void setRemoteFireAt(Int tick) {
        remoteFireValue = true
        remoteFireTickValue = tick
    }
    Bool consumeRemoteFire() {
        var result = remoteFireValue
        remoteFireValue = false
        return result
    }

    void setRemoteInputSequence(Int sequence) {
        if (sequence > remoteInputSequenceValue) {
            remoteInputSequenceValue = sequence
        }
    }


    void setRemoteSnapshotAck(Int sequence) {
        if (sequence > remoteSnapshotAckValue) {
            remoteSnapshotAckValue = sequence
        }
    }

    Int remoteSnapshotAck() { return remoteSnapshotAckValue }
    Int remoteFireTick() { return remoteFireTickValue }
    Int remoteInputSequence() { return remoteInputSequenceValue }

    void setRemoteSnapshotSequence(Int sequence) {
        if (sequence > lastRemoteSnapshotSequenceValue) {
            lastRemoteSnapshotSequenceValue = sequence
        }
    }

    Int lastRemoteSnapshotSequence() {
        return lastRemoteSnapshotSequenceValue
    }

    void setRemoteInputAck(Int sequence) {
        if (sequence > lastRemoteInputAckValue) {
            lastRemoteInputAckValue = sequence
        }
    }

    Int lastRemoteInputAck() { return lastRemoteInputAckValue }

    void setRemotePlayerHealth(Int playerOne, Int playerTwo) {
        remotePlayerOneHealthValue = playerOne
        remotePlayerTwoHealthValue = playerTwo
        if (remotePlayerOneHealthValue < 0) { remotePlayerOneHealthValue = 0 }
        if (remotePlayerOneHealthValue > 100) { remotePlayerOneHealthValue = 100 }
        if (remotePlayerTwoHealthValue < 0) { remotePlayerTwoHealthValue = 0 }
        if (remotePlayerTwoHealthValue > 100) { remotePlayerTwoHealthValue = 100 }
        remoteStatusReadyValue = true
    }
    Bool remoteStatusReady() { return remoteStatusReadyValue }
    Int remotePlayerOneHealth() { return remotePlayerOneHealthValue }
    Int remotePlayerTwoHealth() { return remotePlayerTwoHealthValue }

    Bool capturePacket() {
        receiveCountValue = kookie_transport_receive_available()
        if (receiveCountValue <= 0 || receiveCountValue > receiveValues.length) {
            receiveCountValue = 0
            return false
        }
        for (var index = 0;
            index < receiveCountValue; index = index + 1) {
            receiveValues[index] = kookie_transport_receive_word(index)
        }
        return true
    }

    Int received() { return receiveCountValue }
    Int word(Int index) {
        if (index < 0 || index >= receiveCountValue) { return 0 }
        return receiveValues[index]
    }

    Int[] packet() {
        var result = new Int[receiveCountValue]
        for (var index = 0; index < receiveCountValue; index = index + 1) {
            result[index] = receiveValues[index]
        }
        return result
    }
}

Bool sendGamePayload(Int[] payload) {
    if (payload.length <= 0 ||
        payload.length > maximumSessionTransportWords() ||
        !kookie_transport_send_begin(payload.length)) {
        return false
    }
    for (var index = 0; index < payload.length; index = index + 1) {
        if (!kookie_transport_send_word(index, payload[index])) {
            return false
        }
    }
    return kookie_transport_send_commit()
}

Int localMoveForwardAxis() {
    return movementForwardAxis(
        kookie_input_state(1), kookie_input_state(2))
}

Int localMoveStrafeAxis() {
    return movementStrafeAxis(
        kookie_input_state(3), kookie_input_state(4))
}

Int gooseStatusMagic() { return 1196384339 }

Bool validGooseStatusMessage(Int[] words) {
    return words.length == 5 &&
        words[0] == gooseStatusMagic() &&
        words[1] == 1 &&
        words[2] >= 0 && words[2] <= 1000000 &&
        words[3] >= 0 && words[3] <= 100 &&
        words[4] >= 0 && words[4] <= 100
}

Bool processGamePackets(
    LoopbackSession session, NativeGameNetworkState state,
    MatchScoreboardState scoreboard, Bool host
) {
    for (var packet = 0; packet < 8; packet = packet + 1) {
        if (!state.capturePacket()) { return true }
        var words = state.packet()
        if (host && validGameplayInputBundleMessage(words) &&
            gameplayInputBundlePlayer(words) == 2) {
            var count = gameplayInputBundleCount(words)
            state.setRemoteSnapshotAck(
                gameplayInputBundleSnapshotAck(words))
            for (var index = 0; index < count; index = index + 1) {
                var tick = gameplayInputBundleValue(words, index, 0)
                if (tick == session.currentServerTick() + 1) {
                    state.setRemoteMove(
                        gameplayInputBundleValue(words, index, 2))
                    state.setRemoteMoveZ(
                        gameplayInputBundleValue(words, index, 3))
                    if (gameplayInputBundleValue(words, index, 4) != 0) {
                        state.setRemoteFireAt(tick)
                    }
                    state.setRemoteJump(
                        gameplayInputBundleValue(words, index, 5))
                    state.setRemoteInputSequence(
                        gameplayInputBundleValue(words, index, 1))
                }
            }
        } else if (host && validGameplayCommandMessage(words) &&
            gameplayCommandPlayer(words) == 2) {
            if (gameplayCommandAction(words) == gameplayMoveAction()) {
                state.setRemoteMove(gameplayCommandValue(words, 0))
            } else if (gameplayCommandAction(words) == gameplayFireAction()) {
                state.setRemoteFire()
            }
        } else if (!host && validGameplayStateMessage(words)) {
            if (session.applyRemoteGameplayState(words)) {
                state.setRemoteSnapshotSequence(words[3])
            }
        } else if (!host && validGameplayInputAckMessage(words)) {
            var acknowledged = gameplayInputAckSequence(words)
            state.setRemoteInputAck(acknowledged)
            state.acknowledgeLocalInput(acknowledged)
        } else if (!host && validEnemyEncounterStateMessage(words)) {
            session.applyRemoteEnemyEncounterState(words)
        } else if (!host && validMultiplayerScoreboardMessage(words)) {
            scoreboard.apply(words)
        } else if (!host && validGooseStatusMessage(words)) {
            state.setRemotePlayerHealth(words[3], words[4])
        }
    }
    return true
}

Bool sendLocalGameInput(
    LoopbackSession session, NativeGameNetworkState state,
    Int player, Int moveX, Int moveZ, Int fire, Int jump
) {
    var tick = session.currentServerTick() + 1
    var sequence = state.nextLocalSequence()
    if (!state.recordLocalInput(
            tick, sequence, moveX, moveZ, fire, jump)) {
        return false
    }
    var bundle = newGameplayInputBundleMessage(
        player, 1, state.lastRemoteSnapshotSequence(),
        state.localInputWords())
    return bundle.length > 0 && sendGamePayload(bundle)
}
class G1NativePresentation {
    G1Demo scenario
    G4KutterDemo kutterScenario
    G1Arena arena
    LoopbackSession interactionSession
    BoundedRayTargetWorld playerAimTargets
    BoundedHostGameplaySaveOwner saveOwner
    ArenaAnimalMeshes animalMeshes
    ShooterHud hud
    GooseStatusOverlay gooseOverlay
    GooseMinimap minimap
    Bool nativeAnimalModelsValue
    Int gooseModelVertexCountValue
    Int catModelVertexCountValue
    MultiplayerScoreboard scoreboardUi
    MatchScoreboardState scoreboardState
    CameraState camera
    FrameStaging worldFrame
    FrameStaging hudFrame
    FrameStaging doorFrame
    FrameStaging actorFrame
    FrameStaging animalFrame
    FrameStaging minimapFrame
    FrameStaging scoreboardFrame
    GooseProjectileOverlay projectileOverlay
    FrameStaging projectileFrame
    Int worldCapacity
    Int hudCapacity
    Int doorCapacity
    Int actorCapacity
    Int animalCapacity
    Int minimapCapacity
    Int projectileCapacity
    Int scoreboardCapacity
    Bool cooperativeModeValue
    Bool mirrorRemoteValue
    Int localNameIdValue
    Int remoteNameIdValue
    Int playerKillsOneValue
    Int playerKillsTwoValue
    Int playerDeathsOneValue
    Int playerDeathsTwoValue
    Bool localShotValue
    Bool remoteShotValue
    public constructor() {
        scenario = G1Demo()
        kutterScenario = G4KutterDemo()
        arena = scenario.authoredArena()
        hud = ShooterHud(100, 3)
        gooseOverlay = GooseStatusOverlay(6)
        minimap = GooseMinimap(8)
        animalMeshes = ArenaAnimalMeshes(6)
        scoreboardUi = MultiplayerScoreboard()
        scoreboardState = MatchScoreboardState(2)
        projectileOverlay = GooseProjectileOverlay(8)
        camera = CameraState(-450, 450)
        interactionSession = LoopbackSession(16, 8)
        playerAimTargets = BoundedRayTargetWorld(3, 64)
        saveOwner = BoundedHostGameplaySaveOwner(interactionSession)
        nativeAnimalModelsValue = false
        gooseModelVertexCountValue = 0
        catModelVertexCountValue = 0
        worldFrame = FrameStaging(arena.renderVertexCount())
        doorFrame = FrameStaging(36)
        hudFrame = FrameStaging(hud.renderVertexCount())
        animalFrame = FrameStaging(animalMeshes.renderVertexCapacity())
        actorFrame = FrameStaging(gooseOverlay.renderVertexCapacity())
        minimapFrame = FrameStaging(minimap.renderVertexCapacity())
        scoreboardFrame = FrameStaging(scoreboardUi.renderVertexCapacity())
        projectileFrame = FrameStaging(projectileOverlay.renderVertexCapacity())
        worldCapacity = worldFrame.vertexCapacity()
        doorCapacity = doorFrame.vertexCapacity()
        hudCapacity = hudFrame.vertexCapacity()
        actorCapacity = actorFrame.vertexCapacity()
        animalCapacity = animalFrame.vertexCapacity()
        minimapCapacity = minimapFrame.vertexCapacity()
        scoreboardCapacity = scoreboardFrame.vertexCapacity()
        projectileCapacity = projectileFrame.vertexCapacity()
        cooperativeModeValue = true
        mirrorRemoteValue = false
        localNameIdValue = 1
        remoteNameIdValue = 2
        playerKillsOneValue = 0
        playerKillsTwoValue = 0
        playerDeathsOneValue = 0
        playerDeathsTwoValue = 0
        localShotValue = false
        remoteShotValue = false
    }
    Bool setCooperativeMode(Bool cooperative) {
        cooperativeModeValue = cooperative
        return true
    }

    Bool cooperativeMode() { return cooperativeModeValue }

    Bool applyUiSettings(GameShell shell) {
        return hud.setScale(shell.hudScalePercent()) &&
            hud.setHighContrast(shell.highContrast()) &&
            gooseOverlay.setHighContrast(shell.highContrast()) &&
            scoreboardUi.setHighContrast(shell.highContrast()) &&
            minimap.setVisible(shell.tacticalMapVisible())
    }
    Bool prepareGooseSession() {
        if (!interactionSession.loadAuthoredBroadPhase(
                arena.authoredCollision()) ||
            !interactionSession.enableFpsMovement(true) ||
            !interactionSession.configureEnemyRules(320, 35, 15) ||
            !interactionSession.defineEnemyWeapon(7, 10, 0, 3, 1) ||
            !interactionSession.setEnemyWeaponRange(7, 40) ||
            !interactionSession.setEnemyWeaponCooldown(7, 15) ||
            !interactionSession.defineEnemyEncounter(4, 4, 12) ||
            !interactionSession.configureEnemyEncounterZone(
                4, g1ArenaMaxX() / 2, 1, g1ArenaMaxZ() / 2, 140) ||
            !interactionSession.configureEnemySpatialBounds(
                0, -4, 0, g1ArenaMaxX(), g1ArenaMaxY(), g1ArenaMaxZ()) ||
            !interactionSession.definePlayerWeapon(7, 10, 0, 3, 1) ||
            !interactionSession.setPlayerWeaponRange(7, 40) ||
            !interactionSession.addEnemyCombatActor(1, 100, 0) ||
            !interactionSession.addEnemyCombatActor(2, 100, 0) ||
            !interactionSession.equipEnemyCombatWeapon(1, 7) ||
            !interactionSession.equipEnemyCombatWeapon(2, 7) ||
            !interactionSession.defineWorldKey(1, 30, 0, 0, 0) ||
            !interactionSession.defineWorldDoor(
                2, 1, 0, 5, 5, 3, 5, 1, 8) ||
            !interactionSession.start()) {
            return false
        }
        if (interactionSession.connectPlayer() != 1 ||
            interactionSession.connectPlayer() != 2) {
            return false
        }
        if (!interactionSession.addPlayerCombatActor(1, 100, 0) ||
            !interactionSession.addPlayerCombatActor(2, 100, 0) ||
            !interactionSession.equipPlayerCombatWeapon(1, 7) ||
            !interactionSession.equipPlayerCombatWeapon(2, 7)) {
            return false
        }
        if (!interactionSession.setEnemySpatialPosition(1, 40, 1, 60) ||
            !interactionSession.setEnemySpatialPosition(2, 56, 1, 60) ||
            !interactionSession.admitEnemyAt(
                4, 3, 0, 80, 0, 7, 90, 1, 60) ||
            !interactionSession.admitEnemyAt(
                4, 4, 0, 80, 0, 7, 260, 1, 56) ||
            !interactionSession.admitEnemyAt(
                4, 5, 0, 80, 0, 7, 264, 1, 224) ||
            !interactionSession.configureEnemyRole(3, 1, 1, 1, 0) ||
            !interactionSession.configureEnemyRole(4, 1, 1, 1, 0) ||
            !interactionSession.configureEnemyRole(5, 2, 1, 2, 0) ||
            !hud.update(100, 3, 3, 0, true) ||
            !hud.updateEncounterReplication(3, 9, true, 1, 1)) {
            return false
        }
        return true
    }

    Bool resetGooseSession() {
        var preservedScale = hud.scalePercent()
        var preservedContrast = hud.highContrast()
        playerAimTargets = BoundedRayTargetWorld(3, 64)
        var preservedMinimap = minimap.visible()
        interactionSession = LoopbackSession(16, 8)
        if (!saveOwner.bind(interactionSession)) {
            return false
        }
        hud = ShooterHud(100, 3)
        if (!hud.setScale(preservedScale) ||
            !hud.setHighContrast(preservedContrast) ||
            !animalMeshes.clear() ||
            !minimap.clear() ||
            !minimap.setVisible(preservedMinimap) ||
            !camera.clearFollowTarget() ||
            !projectileOverlay.clear()) {
            return false
        }
        scoreboardState = MatchScoreboardState(2)
        scoreboardUi.setVisible(false)
        playerKillsOneValue = 0
        playerKillsTwoValue = 0
        playerDeathsOneValue = 0
        playerDeathsTwoValue = 0
        localShotValue = false
        remoteShotValue = false
        if (!prepareGooseSession() ||
            !saveOwner.recoverAndRestore()) {
            return false
        }
        return true
    }

    Bool prepare() {
        var modelsRequired = kookie_gpu_model_assets_required()
        var modelsAvailable =
            kookie_gpu_model_available(kookieModelGoose()) &&
            kookie_gpu_model_available(kookieModelCat())
        if (modelsAvailable) {
            gooseModelVertexCountValue =
                kookie_gpu_model_vertex_count(kookieModelGoose())
            catModelVertexCountValue =
                kookie_gpu_model_vertex_count(kookieModelCat())
            modelsAvailable =
                gooseModelVertexCountValue == 708 &&
                catModelVertexCountValue == 2400 &&
                gooseModelVertexCountValue % 3 == 0 &&
                catModelVertexCountValue % 3 == 0
        }
        nativeAnimalModelsValue = modelsAvailable
        if (modelsRequired && !modelsAvailable) {
            println("KOOKIE prototype animal models required but unavailable")
            return false
        }
        if (!scenario.run()) {
            return false
        }
        println("KOOKIE D1 authoritative gameplay verified")
        if (!kutterScenario.run() ||
            !hud.updateKutterPublication(
                kutterScenario.publicationStatus(),
                kutterScenario.publishedGeneration(),
                kutterScenario.publicationDiagnostic(),
                kutterScenario.completed()) ||
            !camera.applyLook(20, -20) ||
            !prepareGooseSession()) {
            return false
        }
        if (!saveOwner.recoverAndRestore()) {
            return false
        }
        var blocked = interactionSession.queryWorldDoorPath(
            SpatialPoint(-5, 5, 5), SpatialPoint(5, 5, 5))
        var above = interactionSession.queryWorldDoorPath(
            SpatialPoint(-5, 12, 5), SpatialPoint(5, 12, 5))
        if (!blocked.accepted() || !blocked.collided() ||
            !above.accepted() || above.collided()) {
            return false
        }
        if (nativeAnimalModelsValue) {
            println("KOOKIE G1 native animal mesh coverage verified")
        }
        return true
    }

    Bool upload(FrameStaging frame) {
        var index = 0
        while (index < frame.stagedCount()) {
            var span = frame.primitiveSpanAt(index)
            if (span == 6) {
                if (!kookie_gpu_scene_push_quad_depth(
                        frame.resourceAt(index),
                        frame.xAt(index), frame.yAt(index),
                        frame.xAt(index + 1), frame.yAt(index + 2),
                        frame.depthAt(index))) {
                    println("KOOKIE gameplay quad upload failed")
                    println(index)
                    return false
                }
                index = index + 6
                continue
            }
            if (span == 3) {
                if (!kookie_gpu_scene_push_triangle(
                        frame.resourceAt(index),
                        frame.xAt(index), frame.yAt(index),
                        frame.xAt(index + 1), frame.yAt(index + 1),
                        frame.xAt(index + 2), frame.yAt(index + 2))) {
                    println("KOOKIE gameplay triangle upload failed")
                    println(index)
                    return false
                }
                index = index + 3
                continue
            }
            if (!kookie_gpu_scene_push_vertex_depth(
                    frame.resourceAt(index),
                    frame.xAt(index), frame.yAt(index),
                    frame.depthAt(index),
                    frame.uAt(index), frame.vAt(index))) {
                println("KOOKIE gameplay vertex upload failed")
                println(index)
                return false
            }
            index = index + 1
        }
        return true
    }

    Bool uploadWorld(FrameStaging frame) {
        for (var index = 0; index < frame.stagedCount(); index = index + 1) {
            if (!kookie_gpu_world_push_vertex(
                    frame.resourceAt(index),
                    frame.xAt(index), frame.yAt(index), frame.zAt(index),
                    frame.uAt(index), frame.vAt(index))) {
                println("KOOKIE gameplay world vertex upload failed")
                println(index)
                println(frame.resourceAt(index))
                println(frame.xAt(index))
                println(frame.yAt(index))
                println(frame.zAt(index))
                return false
            }
        }
        return true
    }
    Bool uploadAnimalModels() {
        for (var index = 0; index < animalMeshes.actorCapacity();
             index = index + 1) {
            if (!animalMeshes.actorCurrentAt(index)) { continue }
            var kind = animalMeshes.actorKindAt(index)
            var model = kookieModelGoose()
            var animationState = animalMeshes.gooseAnimationState()
            var animationTick = animalMeshes.gooseAnimationTick()
            if (kind == 2) {
                model = kookieModelCat()
                animationState = animalMeshes.catAnimationState()
                animationTick = animalMeshes.catAnimationTick()
            }
            if (!kookie_gpu_world_push_model(
                    model, if (model == kookieModelGoose()) 9 else 12,
                    animalMeshes.actorXAt(index),
                    animalMeshes.actorYAt(index),
                    animalMeshes.actorZAt(index),
                    animalMeshes.actorFacingAt(index),
                    animalMeshes.actorPhaseAt(index),
                    animationState, animationTick,
                    if (animalMeshes.actorMovingAt(index)) 1 else 0,
                    if (animalMeshes.actorAttackingAt(index)) 1 else 0)) {
                println("KOOKIE gameplay native animal model upload failed")
                println(animalMeshes.actorIdAt(index))
                return false
            }
        }
        return true
    }

    Bool configureIdentity(
        Bool mirrorRemote, Int localNameId, Int remoteNameId
    ) {
        if (localNameId < 1 || localNameId > 4 ||
            remoteNameId < 1 || remoteNameId > 4) {
            return false
        }

        mirrorRemoteValue = mirrorRemote
        localNameIdValue = localNameId
        remoteNameIdValue = remoteNameId
        return true
    }
    LoopbackSession gameplaySession() {
        return interactionSession
    }
    Bool saveGameplay() {
        return saveOwner.publish()
    }

    MatchScoreboardState scoreboard() {
        return scoreboardState
    }
    Bool toggleScoreboard() {
        return scoreboardUi.toggle()
    }

    Bool refreshScoreboard(GameShell shell, Bool host) {
        if (!host || !scoreboardState.clear()) { return !host }
        var playerOneHealth = interactionSession.enemyCombatHealth(1)
        var playerTwoHealth = interactionSession.enemyCombatHealth(2)
        var playerOneFlags =
            multiplayerScoreboardFlagConnected() +
            multiplayerScoreboardFlagAlive() +
            multiplayerScoreboardFlagHost()
        var playerTwoFlags =
            multiplayerScoreboardFlagConnected() +
            multiplayerScoreboardFlagAlive()
        if (playerOneHealth <= 0) {
            playerOneFlags = playerOneFlags -
                multiplayerScoreboardFlagAlive()
        }
        if (playerTwoHealth <= 0) {
            playerTwoFlags = playerTwoFlags -
                multiplayerScoreboardFlagAlive()
        }
        if (shell.lobby().localReady()) {
            playerOneFlags = playerOneFlags + multiplayerScoreboardFlagReady()
        }
        if (shell.lobby().remoteReady()) {
            playerTwoFlags = playerTwoFlags + multiplayerScoreboardFlagReady()
        }
        return scoreboardState.setPlayer(
                1, localNameIdValue, 0, playerOneFlags,
                playerOneHealth, 100, playerKillsOneValue,
                playerDeathsOneValue, playerKillsOneValue * 100, 0,
                interactionSession.currentServerTick()) &&
            scoreboardState.setPlayer(
                2, remoteNameIdValue, 0, playerTwoFlags,
                playerTwoHealth, 100, playerKillsTwoValue,
                playerDeathsTwoValue, playerKillsTwoValue * 100, 0,
                interactionSession.currentServerTick())
    }

    Bool stageGooseActors(Int frame, NativeGameNetworkState network) {
        if (!gooseOverlay.clear() || !minimap.clear()) {
            println("KOOKIE gameplay actor/minimap clear failed")
            return false
        }
        var playerOneX = interactionSession.serverPosition(1)
        var playerOneY = 1
        var playerOneZ = 6
        var playerTwoX = interactionSession.serverPosition(2)
        var playerTwoY = 1
        var playerTwoZ = 6
        if (interactionSession.fpsMovementEnabled()) {
            playerOneX = interactionSession.fpsPositionX(1)
            playerOneY = interactionSession.fpsPositionY(1)
            playerOneZ = interactionSession.fpsPositionZ(1)
            playerTwoX = interactionSession.fpsPositionX(2)
            playerTwoY = interactionSession.fpsPositionY(2)
            playerTwoZ = interactionSession.fpsPositionZ(2)
        }
        var playerOneHealth = interactionSession.enemyCombatHealth(1)
        var playerTwoHealth = interactionSession.enemyCombatHealth(2)
        var renderTick = netcodeRemoteRenderTick(
            interactionSession.currentClientTick())
        if (mirrorRemoteValue &&
            interactionSession.clientRemoteBaselineReady() &&
            interactionSession.remotePlayerSnapshotCount(1) > 0 &&
            interactionSession.remotePlayerSnapshotCount(2) > 0) {
            playerOneX = interactionSession.interpolatedRemotePlayerPosition(
                1, renderTick)
            playerOneY = interactionSession.clientRemotePlayerY(1)
            playerOneZ = interactionSession.clientRemotePlayerZ(1)
            playerTwoX = interactionSession.interpolatedRemotePlayerPosition(
                2, renderTick)
            playerTwoY = interactionSession.clientRemotePlayerY(2)
            playerTwoZ = interactionSession.clientRemotePlayerZ(2)
            if (interactionSession.clientRemotePlayer() == 1) {
                playerOneHealth = interactionSession.clientRemoteCombatHealth()
            }
        }
        if (mirrorRemoteValue && network.remoteStatusReady()) {
            playerOneHealth = network.remotePlayerOneHealth()
            playerTwoHealth = network.remotePlayerTwoHealth()
        }
        if (playerOneHealth < 0) { playerOneHealth = 0 }
        if (playerTwoHealth < 0) { playerTwoHealth = 0 }
        if (playerOneHealth > 100) { playerOneHealth = 100 }
        if (playerTwoHealth > 100) { playerTwoHealth = 100 }
        var playerOneName = remoteNameIdValue
        var playerTwoName = localNameIdValue
        if (!mirrorRemoteValue) {
            playerOneName = localNameIdValue
            playerTwoName = remoteNameIdValue
        }
        var remotePlayerId = if (mirrorRemoteValue) 1 else 2
        var remotePlayerX = if (remotePlayerId == 1) playerOneX else playerTwoX
        var remotePlayerY = if (remotePlayerId == 1) playerOneY else playerTwoY
        var remotePlayerZ = if (remotePlayerId == 1) playerOneZ else playerTwoZ
        var remotePlayerHealth =
            if (remotePlayerId == 1) playerOneHealth else playerTwoHealth
        var remotePlayerName =
            if (remotePlayerId == 1) playerOneName else playerTwoName
        if (!gooseOverlay.addDepth(
                remotePlayerId,
                arena.projectX(remotePlayerX, remotePlayerZ, camera),
                arena.projectY(
                    remotePlayerX, remotePlayerY, remotePlayerZ, camera),
                arena.projectDepthAt(
                    remotePlayerX, remotePlayerY, remotePlayerZ, camera),
                remotePlayerHealth, 100, remotePlayerName, false)) {
            println("KOOKIE gameplay remote actor overlay failed")
            return false
        }
        if (!minimap.addMarker(
                gooseMinimapMarkerLocalPlayer(), playerOneX, playerOneZ) ||
            !minimap.addMarker(
                gooseMinimapMarkerRemotePlayer(), playerTwoX, playerTwoZ)) {
            println("KOOKIE gameplay player minimap marker failed")
            return false
        }
        for (var bot = 3; bot <= 5; bot = bot + 1) {
            var botX = interactionSession.enemySpatialPositionX(bot)
            var botY = interactionSession.enemySpatialPositionY(bot)
            var botZ = interactionSession.enemySpatialPositionZ(bot)
            var botHealth = interactionSession.enemyCombatHealth(bot)
            if (mirrorRemoteValue &&
                interactionSession.clientRemoteEnemyIndex(bot) >= 0) {
                botX = interactionSession.clientRemoteEnemyPositionX(bot)
                botY = interactionSession.clientRemoteEnemyPositionY(bot)
                botZ = interactionSession.clientRemoteEnemyPositionZ(bot)
                botHealth = interactionSession.clientRemoteEnemyHealth(bot)
            }
            if (botHealth < 0) { botHealth = 0 }
            if (botHealth > 80) { botHealth = 80 }
            if (!gooseOverlay.addDepth(
                    bot,
                    arena.projectX(botX, botZ, camera),
                    arena.projectY(botX, botY, botZ, camera),
                    arena.projectDepthAt(botX, botY, botZ, camera),
                    botHealth, 80, bot - 2, true)) {
                println("KOOKIE gameplay bot overlay failed")
                println(bot)
                return false

            }
            if (!minimap.addMarker(
                    gooseMinimapMarkerEnemy(), botX, botZ)) {
                println("KOOKIE gameplay enemy minimap marker failed")
                return false
            }
        }
        if (!gooseOverlay.stage(actorFrame, frame, 9)) {
            println("KOOKIE gameplay actor frame stage failed")
            return false
        }
        return true
    }
    Bool stageMinimap(Int frame) {
        if (!minimap.stage(
                minimapFrame, frame, 9,
                camera.normalizedYaw(), cooperativeModeValue)) {
            println("KOOKIE gameplay minimap stage failed")
            return false
        }
        return true
    }
    Bool stageAnimalMeshes(
        Int frame, NativeGameNetworkState network
    ) {
        if (!animalMeshes.beginFrame()) {
            println("KOOKIE gameplay animal frame begin failed")
            return false
        }
        var playerOneX = interactionSession.serverPosition(1)
        var playerOneY = interactionSession.enemySpatialPositionY(1)
        var playerOneZ = interactionSession.enemySpatialPositionZ(1)
        var playerTwoX = interactionSession.serverPosition(2)
        var playerTwoY = interactionSession.enemySpatialPositionY(2)
        var playerTwoZ = interactionSession.enemySpatialPositionZ(2)
        var playerOneMoving = false
        var playerTwoMoving = false
        if (interactionSession.fpsMovementEnabled()) {
            playerOneX = interactionSession.fpsPositionX(1)
            playerOneY = interactionSession.fpsPositionY(1)
            playerOneZ = interactionSession.fpsPositionZ(1)
            playerTwoX = interactionSession.fpsPositionX(2)
            playerTwoY = interactionSession.fpsPositionY(2)
            playerTwoZ = interactionSession.fpsPositionZ(2)
            playerOneMoving =
                interactionSession.fpsVelocityX(1) != 0 ||
                interactionSession.fpsVelocityZ(1) != 0
            playerTwoMoving =
                interactionSession.fpsVelocityX(2) != 0 ||
                interactionSession.fpsVelocityZ(2) != 0
        }
        var renderTick = netcodeRemoteRenderTick(
            interactionSession.currentClientTick())
        if (mirrorRemoteValue &&
            interactionSession.clientRemoteBaselineReady() &&
            interactionSession.remotePlayerSnapshotCount(1) > 0 &&
            interactionSession.remotePlayerSnapshotCount(2) > 0) {
            playerOneX = interactionSession.interpolatedRemotePlayerPosition(
                1, renderTick)
            playerOneY = interactionSession.clientRemotePlayerY(1)
            playerOneZ = interactionSession.clientRemotePlayerZ(1)
            playerTwoX = interactionSession.interpolatedRemotePlayerPosition(
                2, renderTick)
            playerTwoY = interactionSession.clientRemotePlayerY(2)
            playerTwoZ = interactionSession.clientRemotePlayerZ(2)
        }
        var playerOneAttack =
            interactionSession.lastInputEdges(1).firePressed() != 0
        var playerTwoAttack =
            interactionSession.lastInputEdges(2).firePressed() != 0
        var remotePlayerId = if (mirrorRemoteValue) 1 else 2
        var remotePlayerX = if (remotePlayerId == 1) playerOneX else playerTwoX
        var remotePlayerY = if (remotePlayerId == 1) playerOneY else playerTwoY
        var remotePlayerZ = if (remotePlayerId == 1) playerOneZ else playerTwoZ
        var remotePlayerMoving =
            if (remotePlayerId == 1) playerOneMoving else playerTwoMoving
        var remotePlayerAttack =
            if (remotePlayerId == 1) playerOneAttack else playerTwoAttack
        var remotePlayerKind = if (remotePlayerId == 1) 1 else 2
        if (!animalMeshes.setActor(
                remotePlayerId, remotePlayerKind,
                remotePlayerX, remotePlayerY, remotePlayerZ,
                remotePlayerMoving, remotePlayerAttack)) {
            println("KOOKIE gameplay remote player mesh staging failed")
            return false
        }
        for (var bot = 3; bot <= 5; bot = bot + 1) {
            var botX = interactionSession.enemySpatialPositionX(bot)
            var botY = interactionSession.enemySpatialPositionY(bot)
            var botZ = interactionSession.enemySpatialPositionZ(bot)
            if (mirrorRemoteValue &&
                interactionSession.clientRemoteEnemyIndex(bot) >= 0) {
                botX = interactionSession.clientRemoteEnemyPositionX(bot)
                botY = interactionSession.clientRemoteEnemyPositionY(bot)
                botZ = interactionSession.clientRemoteEnemyPositionZ(bot)
            }
            var kind = if (bot % 2 == 0) 2 else 1
            if (!animalMeshes.setActor(
                    bot, kind, botX, botY, botZ, false, false)) {
                println("KOOKIE gameplay bot mesh staging failed")
                println(bot)
                return false
            }
        }
        if (nativeAnimalModelsValue) {
            if (!animalMeshes.stepNative()) {
                println("KOOKIE gameplay animal animation step failed")
                return false
            }
        } else if (!animalMeshes.stage(animalFrame, frame, 3)) {
            println("KOOKIE gameplay animal fallback staging failed")
            return false
        }
        return true
    }

    Bool updateFollowCamera(Int player) {
        if (player != 1 && player != 2) { return false }
        var targetX = interactionSession.serverPosition(player)
        var targetY = 1
        var targetZ = 6
        if (interactionSession.fpsMovementEnabled()) {
            targetX = interactionSession.fpsPositionX(player)
            targetY = interactionSession.fpsPositionY(player)
            targetZ = interactionSession.fpsPositionZ(player)
        }
        var hadTarget = camera.hasFollowTarget()
        if (!camera.setFollowTarget(targetX, targetY, targetZ)) {
            return false
        }
        var moved = false
        if (!hadTarget) {
            moved = camera.snapFollowTarget()
        } else {
            moved = camera.stepFollow()
        }
        return moved && camera.resolveFollowCollision(
            arena.collisionGeometry())
    }

    Bool applyMouseLook() {
        return camera.applyZoom(kookie_consume_mouse_wheel_y()) &&
            camera.applyLook(
                kookie_consume_mouse_delta_x() / 2,
                -kookie_consume_mouse_delta_y() / 2)
    }

    Int aimTargetForPlayer(Int player) {
        if (player != 1 && player != 2) { return 0 }
        for (var bot = 3; bot <= 5; bot = bot + 1) {
            var live = interactionSession.enemyState(bot) != 7 &&
                interactionSession.enemyCombatHealth(bot) > 0
            if (!live) {
                playerAimTargets.removeTarget(bot)
                continue
            }
            var botX = interactionSession.enemySpatialPositionX(bot)
            var botY = interactionSession.enemySpatialPositionY(bot)
            var botZ = interactionSession.enemySpatialPositionZ(bot)
            if (mirrorRemoteValue &&
                interactionSession.clientRemoteEnemyIndex(bot) >= 0) {
                botX = interactionSession.clientRemoteEnemyPositionX(bot)
                botY = interactionSession.clientRemoteEnemyPositionY(bot)
                botZ = interactionSession.clientRemoteEnemyPositionZ(bot)
            }
            if (!playerAimTargets.setTarget(bot, botX, botY + 3, botZ)) {
                return 0
            }
        }
        var range = 64
        var aim = SpatialAimContract(
            player,
            camera.currentX(), camera.currentY(), camera.currentZ(),
            camera.aimEndX(range), camera.aimEndY(range),
            camera.aimEndZ(range), range, 5)
        var result = playerAimTargets.queryAim(aim)
        if (!result.accepted() || !result.hit()) {
            return 0
        }
        return result.targetId()
    }

    Bool spawnPlayerProjectile(
        Int player, Int target, Bool cameraAim
    ) {
        if (player != 1 && player != 2) { return false }
        var sourceX = interactionSession.enemySpatialPositionX(player)
        var sourceY = interactionSession.enemySpatialPositionY(player)
        var sourceZ = interactionSession.enemySpatialPositionZ(player)
        if (interactionSession.fpsMovementEnabled()) {
            sourceX = interactionSession.fpsPositionX(player)
            sourceY = interactionSession.fpsPositionY(player)
            sourceZ = interactionSession.fpsPositionZ(player)
        }
        if (cameraAim) {
            var targetX = camera.aimEndX(48)
            var targetY = camera.aimEndY(48)
            var targetZ = camera.aimEndZ(48)
            if (target > 0) {
                targetX = interactionSession.enemySpatialPositionX(target)
                targetY = interactionSession.enemySpatialPositionY(target)
                targetZ = interactionSession.enemySpatialPositionZ(target)
            }
            return projectileOverlay.addShot(
                0, 0, 1,
                arena.projectX(targetX, targetZ, camera),
                arena.projectY(targetX, targetY, targetZ, camera),
                arena.projectDepthAt(targetX, targetY, targetZ, camera))
        }
        var targetX = sourceX + 12
        var targetY = sourceY
        var targetZ = sourceZ
        if (target > 0) {
            targetX = interactionSession.enemySpatialPositionX(target)
            targetY = interactionSession.enemySpatialPositionY(target)
            targetZ = interactionSession.enemySpatialPositionZ(target)
        }
        return projectileOverlay.addShot(
            arena.projectX(sourceX, sourceZ, camera),
            arena.projectY(sourceX, sourceY, sourceZ, camera),
            arena.projectDepthAt(sourceX, sourceY, sourceZ, camera),
            arena.projectX(targetX, targetZ, camera),
            arena.projectY(targetX, targetY, targetZ, camera),
            arena.projectDepthAt(targetX, targetY, targetZ, camera))
    }

    Bool drainPlayerWeaponPresentations() {
        localShotValue = false
        remoteShotValue = false
        while (interactionSession.playerWeaponPresentationCount() > 0) {
            if (!interactionSession.dequeuePlayerWeaponPresentation()) {
                return false
            }
            var presentation = interactionSession.lastPlayerWeaponPresentation()
            if (presentation.kind() == 1) {
                if (presentation.actorId() == 1) {
                    localShotValue = true
                } else if (presentation.actorId() == 2) {
                    remoteShotValue = true
                }
            }
        }
        return true
    }

    Bool fireNearestBot(
        Int player, Int shotTick, Bool visualShot, Bool cameraAim
    ) {
        if ((player != 1 && player != 2) || shotTick < 0) { return false }
        var target = 0
        var distance = 1000001
        if (cameraAim) {
            target = aimTargetForPlayer(player)
            if (target > 0) {
                distance = interactionSession.enemyDistanceAt(
                    player, target, shotTick)
                if (distance < 0) { target = 0 }
            }
        } else {
            for (var bot = 3; bot <= 5; bot = bot + 1) {
                if (interactionSession.enemyState(bot) != 7 &&
                    interactionSession.enemyCombatHealth(bot) > 0) {
                    var candidateDistance = interactionSession.enemyDistanceAt(
                        player, bot, shotTick)
                    if (candidateDistance >= 0 &&
                        candidateDistance < distance) {
                        distance = candidateDistance
                        target = bot
                    }
                }
            }
        }
        if (target > 0) {
            var result = interactionSession.resolveEnemyHitscanAt(
                player, target, interactionSession.currentServerTick(),
                shotTick, distance, 0)
            if (result.accepted() && result.died()) {
                if (player == 1) {
                    playerKillsOneValue = playerKillsOneValue + 1
                } else {
                    playerKillsTwoValue = playerKillsTwoValue + 1
                }
            }
        }
        return !visualShot ||
            spawnPlayerProjectile(player, target, cameraAim)
    }

    Bool advanceGameplayInput(
        Bool host, NativeGameNetworkState state,
        Int moveForward, Int moveStrafe, Int fire, Int jump
    ) {
        if (!projectileOverlay.advance()) { return false }
        var player = if (host) 1 else 2
        var tick = interactionSession.currentServerTick() + 1
        var playerOneHealthBefore = interactionSession.enemyCombatHealth(1)
        var playerTwoHealthBefore = interactionSession.enemyCombatHealth(2)
        var moveX = camera.movementWorldX(moveForward, moveStrafe)
        var moveZ = camera.movementWorldZ(moveForward, moveStrafe)
        if (!host &&
            !sendLocalGameInput(
                interactionSession, state, player, moveX, moveZ, fire, jump)) {
            return false
        }
        if (!interactionSession.receiveInput(
                player, tick, state.nextLocalSequence(),
                moveX, moveZ, 0, 0, fire, jump)) {
            println("KOOKIE gameplay input admission failed")
            return false
        }
        if (host &&
            !interactionSession.receiveInput(
                2, tick, state.nextRemoteSequence(),
                state.remoteMove(), state.remoteMoveZ(), 0, 0,
                0, state.remoteJump())) {
            println("KOOKIE gameplay remote input admission failed")
            return false
        }
        var steps = interactionSession.advance(16667)
        if (steps != 1) {
            println("KOOKIE gameplay step result")
            println(steps)
            println(interactionSession.currentServerTick())
            return false
        }
        if (!drainPlayerWeaponPresentations()) {
            println("KOOKIE player weapon presentation drain failed")
            return false
        }
        if (!updateFollowCamera(player)) {
            println("KOOKIE follow camera update failed")
            return false
        }
        var playerOneHealthAfter = interactionSession.enemyCombatHealth(1)
        var playerTwoHealthAfter = interactionSession.enemyCombatHealth(2)
        if (playerOneHealthBefore > 0 && playerOneHealthAfter <= 0) {
            playerDeathsOneValue = playerDeathsOneValue + 1
        }
        if (playerTwoHealthBefore > 0 && playerTwoHealthAfter <= 0) {
            playerDeathsTwoValue = playerDeathsTwoValue + 1
        }
        var localShotTick = interactionSession.currentServerTick()
        if (interactionSession.lastInputEdges(player).firePressed() != 0 &&
            !fireNearestBot(
                player, localShotTick, localShotValue, true)) {
            return false
        }
        remoteShotValue = false
        if (host) {
            remoteShotValue = state.consumeRemoteFire()
        }
        if (host && remoteShotValue) {
            var remoteShotTick = netcodeLagCompensationTick(
                interactionSession.currentServerTick(),
                interactionSession.latestSnapshotSequence(),
                state.remoteSnapshotAck(),
                netcodeDefaultRenderDelayTicks())
            if (state.remoteFireTick() > 0 &&
                state.remoteFireTick() < remoteShotTick) {
                remoteShotTick = state.remoteFireTick()
            }
            if (!fireNearestBot(2, remoteShotTick, true, false)) {
                return false
            }
        }
        return true
    }

    Bool advanceGameplay(
        Bool host, NativeGameNetworkState state
    ) {
        return advanceGameplayInput(
            host, state, localMoveForwardAxis(), localMoveStrafeAxis(),
            kookie_input_state(5), kookie_input_state(6))
    }
    Int projectileOverlayCount() {
        return projectileOverlay.activeCount()
    }
    Int visibleAnimalActorCount() {
        return animalMeshes.actorCount()
    }

    Bool drawGameFrame(Int frame, NativeGameNetworkState network) {
        var scoreboardVisible = scoreboardUi.visible()
        var scoreboardCount = 0
        if (scoreboardVisible) {
            if (!scoreboardUi.stage(scoreboardFrame, frame, scoreboardState)) {
                println("KOOKIE gameplay scoreboard stage failed")
                return false
            }
            scoreboardCount = scoreboardFrame.stagedCount()
        }
        if (!arena.stageWorld(worldFrame, frame, 1)) {
            println("KOOKIE gameplay arena world stage failed")
            return false
        }
        if (!stageGooseActors(frame, network) ||
            !stageAnimalMeshes(frame, network)) {
            println("KOOKIE gameplay animal stage failed")
            return false
        }
        if (!stageMinimap(frame)) {
            return false
        }
        if (!interactionSession.stageWorldInteractionGeometry3d(
                doorFrame, frame, 7)) {
            println("KOOKIE gameplay door world stage failed")
            return false
        }
        if (!hud.stage(hudFrame, frame, 9)) {
            println("KOOKIE gameplay HUD stage failed")
            return false
        }
        var projectileCount = 0
        if (projectileOverlay.activeCount() > 0) {
            if (!projectileOverlay.stage(projectileFrame, frame, 6)) {
                println("KOOKIE gameplay projectile stage failed")
                return false
            }
            projectileCount = projectileFrame.stagedCount()
        }
        var animalVertexCount = 0
        if (nativeAnimalModelsValue) {
            animalVertexCount = animalMeshes.modelVertexCount(
                gooseModelVertexCountValue, catModelVertexCountValue)
        } else {
            animalVertexCount = animalFrame.stagedCount()
        }
        var worldVertexCount =
            worldFrame.stagedCount() + doorFrame.stagedCount() +
            animalVertexCount
        if (animalVertexCount <= 0) {
            println("KOOKIE gameplay animal model count failed")
            println(animalVertexCount)
            return false
        }
        if (!kookie_gpu_world_set_camera(
                camera.currentX(), camera.currentY(), camera.currentZ(),
                camera.currentYaw(), camera.currentPitch())) {
            println("KOOKIE gameplay world camera failed")
            return false
        }
        if (!kookie_gpu_world_begin(worldVertexCount) ||
            kookie_gpu_world_capacity() < worldVertexCount ||
            !uploadWorld(worldFrame) || !uploadWorld(doorFrame) ||
            (nativeAnimalModelsValue && !uploadAnimalModels()) ||
            (!nativeAnimalModelsValue && !uploadWorld(animalFrame)) ||
            !kookie_gpu_world_commit() ||
            kookie_gpu_world_count() != worldVertexCount) {
            println("KOOKIE gameplay world GPU pass failed")
            println(worldVertexCount)
            println(kookie_gpu_world_count())
            return false
        }
        var vertexCount =
            actorFrame.stagedCount() + hudFrame.stagedCount() +
            minimapFrame.stagedCount() + scoreboardCount + projectileCount
        if (!kookie_gpu_scene_begin(vertexCount) ||
            kookie_gpu_scene_capacity() < vertexCount) {
            println("KOOKIE gameplay GPU scene begin failed")
            println(vertexCount)
            return false
        }
        if (!upload(actorFrame) ||
            (projectileCount > 0 && !upload(projectileFrame)) ||
            !upload(hudFrame) ||
            !upload(minimapFrame) ||
            (scoreboardVisible && !upload(scoreboardFrame))) {
            println("KOOKIE gameplay GPU scene upload failed")
            return false
        }
        if (!kookie_gpu_scene_commit()) {
            println("KOOKIE gameplay GPU scene commit failed")
            return false
        }
        if (kookie_gpu_scene_count() != vertexCount) {
            println("KOOKIE gameplay GPU scene count failed")
            println(vertexCount)
            println(kookie_gpu_scene_count())
            return false
        }
        if (!kookie_gpu_draw_scene()) {
            println("KOOKIE gameplay GPU scene draw failed")
            return false
        }
        if (!worldFrame.retire(frame) ||
            (!nativeAnimalModelsValue && !animalFrame.retire(frame)) ||
            !actorFrame.retire(frame) ||
            !doorFrame.retire(frame) ||
            !hudFrame.retire(frame) ||
            !minimapFrame.retire(frame) ||
            (projectileCount > 0 && !projectileFrame.retire(frame))) {
            println("KOOKIE gameplay frame retire failed")
            return false
        }
        if (scoreboardVisible && !scoreboardFrame.retire(frame)) {
            println("KOOKIE gameplay scoreboard retire failed")
            return false
        }
        return true
    }


    Bool drawShellFrame(GameShell shell, FrameStaging shellFrame, Int frame) {
        if (!shell.stage(shellFrame, frame)) { return false }
        var vertexCount = shellFrame.stagedCount()
        if (!kookie_gpu_scene_begin(vertexCount) ||
            !upload(shellFrame) || !kookie_gpu_scene_commit() ||
            kookie_gpu_scene_count() != vertexCount ||
            !kookie_gpu_draw_scene()) {
            return false
        }
        return shellFrame.retire(frame)
    }

    Bool capacitiesStable() {
        return worldFrame.vertexCapacity() == worldCapacity &&
            actorFrame.vertexCapacity() == actorCapacity &&
            animalFrame.vertexCapacity() == animalCapacity &&
            doorFrame.vertexCapacity() == doorCapacity &&
            hudFrame.vertexCapacity() == hudCapacity &&
            minimapFrame.vertexCapacity() == minimapCapacity &&
            projectileFrame.vertexCapacity() == projectileCapacity &&
            scoreboardFrame.vertexCapacity() == scoreboardCapacity
    }

    Bool dequeueCombatFeedbackAudio() {
        return scenario.dequeueCombatFeedbackAudio()
    }

    Int combatFeedbackClip() { return scenario.combatFeedbackClip() }
    Int combatFeedbackGain() { return scenario.combatFeedbackGain() }
    Int combatFeedbackLeftGain() { return scenario.combatFeedbackLeftGain() }
    Int combatFeedbackRightGain() { return scenario.combatFeedbackRightGain() }
}

Bool sendHostGameState(
    LoopbackSession session, MatchScoreboardState scoreboard,
    NativeGameNetworkState state
) {
    var tick = session.currentServerTick()
    var playerState = session.gameplayStateMessage(tick, 1, 1)
    if (playerState.length == 0 || !sendGamePayload(playerState)) {
        return false
    }
    var enemyState = session.enemyEncounterStateMessage(tick, 4)
    if (enemyState.length == 0 || !sendGamePayload(enemyState)) {
        return false
    }
    var status = new Int[5]
    status[0] = gooseStatusMagic()
    status[1] = 1
    status[2] = tick
    status[3] = session.enemyCombatHealth(1)
    status[4] = session.enemyCombatHealth(2)
    if (!sendGamePayload(status)) { return false }
    var scoreboardMessage = scoreboard.publish(tick)
    if (scoreboardMessage.length == 0 ||
        !sendGamePayload(scoreboardMessage)) {
        return false
    }
    var acknowledgement = newGameplayInputAckMessage(
        tick, state.remoteInputSequence(), playerState[3])
    return acknowledgement.length > 0 &&
        sendGamePayload(acknowledgement)
}
Int menuUiSoundForAction(
    Int action, Int beforeScreen, Int afterScreen, Bool handled
) {
    if (!handled) { return 1020 }
    if (action == gameShellActionUp()) { return 1001 }
    if (action == gameShellActionDown()) { return 1002 }
    if (action == gameShellActionLeft()) { return 1050 }
    if (action == gameShellActionRight()) { return 1051 }
    if (action == gameShellActionActivate()) {
        if (beforeScreen != afterScreen) { return 1031 }
        return 1040
    }
    if (action == gameShellActionBack()) {
        if (beforeScreen == gameShellScreenMain()) { return 1010 }
        return 1030
    }
    return 0
}

Bool playMenuUiSound(Int audio, Int clip) {
    if (audio <= 0 || clip <= 0) { return true }
    return kookie_audio_play_ui_clip(clip)
}

Bool driveSmokeKeyboardAction(
    GameShell shell, G1NativePresentation presentation,
    Int key, Int expectedAction
) {
    if (!kookie_push_key_event(key) || kookie_poll_event() != 7 ||
        kookie_last_event_a() != expectedAction) {
        return false
    }
    var gameplayBefore = shell.gameplayVisible()
    if (!shell.handleAction(kookie_last_event_a())) {
        return false
    }
    if (gameplayBefore && expectedAction == gameShellActionBack()) {
        return presentation.saveGameplay()
    }
    return true
}

main() {

    println("KOOKIE native SDL game shell")
    assert(kookie_sdl_init(48), "SDL video/audio adapter init must succeed")
    var window = kookie_window_create(1280, 720, 0)
    assert(window > 0, "visible SDL window must create")
    assert(kookie_window_is_resizable(window),
        "desktop window must be resizable and maximizable")

    var gpu = kookie_gpu_open(window)
    assert(gpu > 0, "GPU must claim the visible SDL window")
    var presentation = G1NativePresentation()
    assert(presentation.prepare(), "authored bounded game scene must prepare")
    var shell = GameShell()
    var lobby = NativeLobbyState()
    var network = NativeGameNetworkState(300)
    var localNameId = kookie_transport_player_name_id()
    var defaultRemoteNameId = if (localNameId == 1) 2 else 1
    assert(presentation.configureIdentity(
            false, localNameId, defaultRemoteNameId),
        "goose identity must have bounded local and remote names")
    assert(shell.configureLobbyIdentity(
            localNameId, defaultRemoteNameId, kookie_transport_room_code()),
        "lobby identity must remain bounded")
    assert(presentation.applyUiSettings(shell),
        "accessibility settings must configure HUD scale and tactical map")
    var appliedUiSettingsRevision = shell.settingsRevision()
    var shellFrame = FrameStaging(shell.renderVertexCapacity())
    assert(kookie_gpu_scene_capacity() >= shell.renderVertexCapacity(),
        "native scene must hold menu geometry")
    var reload = BoundedGpuReloadCoordinator()
    var shellWorldChecksum = shell.kutter().worldChecksum()
    var shellCollisionChecksum = shell.kutter().collisionChecksum()
    var shellRenderChecksum = shell.kutter().renderChecksum()
    var shellVertexCount = shell.renderVertexCapacity()
    var reloadBound = reload.bindInitial(
        1, shellWorldChecksum, shellCollisionChecksum,
        shellRenderChecksum, shellVertexCount, 0)
    assert(reloadBound &&
        kookie_gpu_reload_active_generation() == 1,
        "native GPU and kutter reload generations must start aligned")

    var audio = kookie_audio_open()
    var appliedSettingsRevision = 0
    if (audio > 0) {
        assert(kookie_audio_ui_assets_loaded() == 14,
            "uploaded UI OGG assets must load into SDL mixer tracks")
        assert(kookie_audio_set_volumes(
            shell.effectsVolume(), shell.musicVolume()),
            "SDL mixer FX and music buses must accept initial gains")
        appliedSettingsRevision = shell.settingsRevision()
    }

    var smoke = kookie_presentation_smoke_requested()
    var frame = 1
    var gameplayMouseMode = false
    if (smoke) {
        assert(kookie_window_apply_display(window, 0, 960, 540) &&
            kookie_window_apply_display(window, 0, 1280, 720),
            "display Apply must commit and restore a windowed resolution")
        assert(driveSmokeKeyboardAction(
                shell, presentation, 13, gameShellActionActivate()) &&
            shell.gameplayVisible() &&
            shell.consumeGameplayEntry() &&
            presentation.resetGooseSession(),
            "main Play must arrive through the SDL key event path")
        assert(processGamePackets(
                presentation.gameplaySession(), network,
                presentation.scoreboard(), true) &&
            presentation.applyMouseLook() &&
            presentation.advanceGameplay(true, network),
            "fresh goose gameplay must process and advance one fixed tick")
        var movementStartX = presentation.gameplaySession().fpsPositionX(1)
        var movementStartZ = presentation.gameplaySession().fpsPositionZ(1)
        for (var movementTick = 0; movementTick < 4;
             movementTick = movementTick + 1) {
            assert(presentation.advanceGameplayInput(
                    true, network, 1, 0, 0, 0),
                "WASD movement must advance the authoritative FPS pose")
        }
        assert(
            presentation.gameplaySession().fpsPositionX(1) != movementStartX ||
            presentation.gameplaySession().fpsPositionZ(1) != movementStartZ,
            "WASD movement must change the authoritative FPS pose")
        for (var shotTick = 0; shotTick < 40;
             shotTick = shotTick + 1) {
            assert(presentation.advanceGameplayInput(
                    true, network, 0, 0,
                    if (shotTick % 2 == 0) 1 else 0, 0),
                "repeated fire edges must keep gameplay fixed-step healthy")
        }
        assert(presentation.projectileOverlayCount() > 0,
            "a confirmed player shot must stage a visible projectile tracer")
        assert(presentation.gameplaySession().addPlayerItem(1, 900, 2) &&
            presentation.gameplaySession().playerItemQuantity(1, 900) == 2,
            "presentation player session must expose the durable-save fixture")
        assert(driveSmokeKeyboardAction(
                shell, presentation, 27, gameShellActionBack()) &&
            !shell.gameplayVisible(),
            "leaving gameplay must arrive through the SDL escape event path")
        assert(driveSmokeKeyboardAction(
                shell, presentation, 13, gameShellActionActivate()) &&
            shell.gameplayVisible() &&
            shell.consumeGameplayEntry() &&
            presentation.resetGooseSession() &&
            presentation.gameplaySession().playerItemQuantity(1, 900) == 2,
            "restarting Play must arrive through the SDL return event path")
        assert(presentation.drawGameFrame(frame, network),
            "authored arena and authoritative HUD must draw")
        assert(presentation.visibleAnimalActorCount() == 4,
            "first-person presentation must omit the local goose world mesh")
        assert(driveSmokeKeyboardAction(
                shell, presentation, 27, gameShellActionBack()) &&
            !shell.gameplayVisible(),
            "second gameplay exit must arrive through the SDL escape event path")
        println("KOOKIE G7 native presentation durable save verified")
        println("KOOKIE D1 Play restart exit verified")
        frame = frame + 1
        assert(kookie_gpu_reload_stage(
                2, shell.kutter().renderChecksum()) &&
            kookie_gpu_scene_begin(3) &&
            kookie_gpu_scene_push_vertex(1, 0, 0, 0, 0) &&
            !kookie_gpu_scene_push_vertex(0, 0, 0, 0, 0) &&
            kookie_gpu_reload_cancel(2) &&
            kookie_gpu_reload_pending_generation() == 0 &&
            kookie_gpu_reload_active_generation() == 1 &&
            kookie_gpu_scene_count() > 0 &&
            kookie_gpu_draw_scene(),
            "failed staged reload must preserve the active GPU scene")
        println("KOOKIE G1 native arena HUD verified")
        println("KOOKIE G2 native 3D door verified")
        assert(shell.handleAction(gameShellActionDown()) &&
            shell.handleAction(gameShellActionDown()) &&
            shell.handleAction(gameShellActionDown()) &&
            shell.handleAction(gameShellActionActivate()) &&
            shell.screen() == gameShellScreenKutter() &&
            shell.handleAction(gameShellActionActivate()) &&
            shell.kutter().generation() == 2,
            "presentation smoke must enter kutter and stage an inspector edit")
    }

    var running = true
    var menuFrames = 0
    var smokeQuitQueued = false
    while (running && !shell.quitRequested()) {
        var eventKind = kookie_poll_event()
        while (eventKind != 0) {
            if (eventKind == 1 || eventKind == 4) {
                if (shell.gameplayVisible()) {
                    assert(presentation.saveGameplay(),
                        "closing gameplay must publish a durable save")
                }
                running = false
                if (smoke && eventKind == 1) {
                    println("KOOKIE D1 SDL black-box quit verified")
                }
            } else if (eventKind == 7) {
                var beforeScreen = shell.screen()
                var action = kookie_last_event_a()
                var gameplayBefore = shell.gameplayVisible()
                var handled = shell.handleAction(action)
                if (gameplayBefore &&
                    action == gameShellActionBack() && handled) {
                    assert(presentation.saveGameplay(),
                        "leaving gameplay must publish a durable save")
                }
                var clip = 0
                if (gameplayBefore) {
                    if (action == gameShellActionBack() && handled) {
                        clip = 1030
                    } else if (action == gameShellActionActivate()) {
                        clip = 1041
                    }
                } else {
                    clip = menuUiSoundForAction(
                        action, beforeScreen, shell.screen(), handled)
                }
                assert(playMenuUiSound(audio, clip),
                    "keyboard UI interaction must play its mapped sound")
            } else if (eventKind == 8) {
                var gameplayBefore = shell.gameplayVisible()
                var beforeScreen = shell.screen()
                var clicked = shell.handlePointer(
                    kookie_last_event_a(), kookie_last_event_b())
                var clip = 0
                if (gameplayBefore) {
                    clip = 1041
                } else if (clicked) {
                    clip = menuUiSoundForAction(
                        gameShellActionActivate(), beforeScreen,
                        shell.screen(), true)
                }
                assert(playMenuUiSound(audio, clip),
                    "pointer UI interaction must play its mapped sound")
            }
            eventKind = kookie_poll_event()
        }
        if (kookie_consume_scoreboard_toggle() != 0 &&
            shell.gameplayVisible()) {
            var scoreboardVisible = presentation.toggleScoreboard()
            assert(playMenuUiSound(
                    audio, if (scoreboardVisible) 1031 else 1030),
                "scoreboard toggle must play its mapped sound")
        }

        if (shell.networkRequest() != 0) {
            network.reset()
        }
        assert(serviceNetworkRequest(shell, lobby),
            "lobby request must reach the authenticated UDP transport")
        assert(serviceNetworkHandshake(shell, lobby),
            "lobby handshake must remain valid")
        assert(shell.configureLobbyIdentity(
                localNameId, lobby.remoteNameId(),
                kookie_transport_room_code()),
            "lobby screen must expose the current bounded peer identity")
        if (shell.networkStatus() == gameShellNetworkConnected() &&
            shell.lobby().phase() == multiplayerLobbyPhaseReady() &&
            !shell.gameplayVisible()) {
            assert(shell.enterGameplay(),
                "ready lobby must enter the playable goose scene")
        }
        if (shell.consumeGameplayEntry()) {
            network.reset()
            assert(presentation.resetGooseSession(),
                "entering gameplay must create a fresh bot encounter")
        }
        var wantsGameplayMouseMode = shell.gameplayVisible()
        if (wantsGameplayMouseMode != gameplayMouseMode) {
            assert(kookie_window_set_gameplay_mouse_mode(
                    window, if (wantsGameplayMouseMode) 1 else 0),
                "gameplay mouse mode must follow the active screen")
            gameplayMouseMode = wantsGameplayMouseMode
        }
        if (shell.settingsRevision() != appliedUiSettingsRevision) {
            assert(presentation.applyUiSettings(shell),
                "accessibility settings must update the live HUD")
            appliedUiSettingsRevision = shell.settingsRevision()
        }


        if (audio > 0 &&
            shell.settingsRevision() != appliedSettingsRevision) {
            assert(kookie_audio_set_volumes(
                shell.effectsVolume(), shell.musicVolume()),
                "SDL mixer FX and music gains must update")
            appliedSettingsRevision = shell.settingsRevision()
        }
        if (shell.displayApplyPending()) {
            var displayApplied = kookie_window_apply_display(
                window, shell.displayMode(),
                shell.resolutionWidth(), shell.resolutionHeight())
            assert(shell.acknowledgeDisplayApply(displayApplied),
                "display transaction must complete")
            assert(playMenuUiSound(
                    audio, if (displayApplied) 1040 else 1020),
                "display apply result must play its mapped sound")
        }

        if (shell.kutter().generation() > reload.activeGeneration() &&
            reload.pendingGeneration() == 0) {
            assert(reload.stage(
                    reload.activeGeneration(), shell.kutter().generation(),
                    shell.kutter().worldChecksum(),
                    shell.kutter().collisionChecksum(),
                    shell.kutter().renderChecksum(),
                    shell.renderVertexCapacity()) &&
                kookie_gpu_reload_stage(
                    shell.kutter().generation(),
                    shell.kutter().renderChecksum()),
                "validated kutter products must stage before GPU upload")
        }

        if (shell.gameplayVisible()) {
            var hostGameplay = true
            if (shell.networkStatus() == gameShellNetworkConnected()) {
                hostGameplay = lobby.host()
            }
            assert(processGamePackets(
                    presentation.gameplaySession(), network,
                    presentation.scoreboard(), hostGameplay),
                "gameplay packets must remain bounded and authenticated")
            assert(presentation.applyMouseLook(),
                "mouse look input must update the deterministic camera")
            assert(presentation.advanceGameplay(hostGameplay, network),
                "goose gameplay must advance one fixed tick")
            assert(presentation.refreshScoreboard(
                    shell, hostGameplay),
                "authoritative scoreboard must remain bounded")
            if (hostGameplay &&
                shell.networkStatus() == gameShellNetworkConnected()) {
                assert(sendHostGameState(
                        presentation.gameplaySession(),
                        presentation.scoreboard(), network),
                    "host must publish player, bot and scoreboard snapshots")
            }
            assert(presentation.configureIdentity(
                    !hostGameplay &&
                        shell.networkStatus() == gameShellNetworkConnected(),
                    localNameId, lobby.remoteNameId()),
                "network identity must drive goose nameplates")
        }

        if (running && !shell.quitRequested()) {
            if (shell.gameplayVisible()) {
                assert(presentation.drawGameFrame(frame, network),
                    "gameplay scene must draw")
            } else {
                assert(presentation.drawShellFrame(shell, shellFrame, frame),
                    "menu screen must draw")
                menuFrames = menuFrames + 1
            }
            if (reload.pendingGeneration() != 0) {
                var activatedGeneration = reload.pendingGeneration()
                var completedFence = kookie_gpu_reload_completed_fence()
                assert(kookie_gpu_reload_pending_generation() == 0 &&
                    kookie_gpu_reload_active_generation() == activatedGeneration &&
                    kookie_gpu_reload_active_checksum() ==
                        shell.kutter().renderChecksum() &&
                    reload.markUploaded(activatedGeneration, completedFence) &&
                    reload.activateAtFrame(
                        activatedGeneration, frame, completedFence) &&
                    kookie_gpu_reload_retired_generation() ==
                        reload.retiringGeneration() &&
                    reload.retire(completedFence),
                    "GPU fence completion must activate and retire whole generations")
                println("KOOKIE G4 GPU-safe kutter reload verified")
            }
            frame = frame + 1
        }

        if (smoke && menuFrames >= 3 && !smokeQuitQueued) {
            assert(kookie_gpu_capture_window(),
                "main menu screenshot capture must succeed")
            assert(kookie_gpu_report_window_present_capabilities(),
                "window must expose a present capability")
            assert(kookie_gpu_report_window_draw(),
                "GPU draw timing must be positive")
            assert(presentation.capacitiesStable(),
                "scene staging capacities must remain fixed")
            println("KOOKIE native main menu verified")
            if (audio > 0) {
                assert(presentation.dequeueCombatFeedbackAudio() &&
                    presentation.combatFeedbackClip() == 201 &&
                    presentation.combatFeedbackGain() == 100,
                    "authoritative combat feedback must remain available")
                assert(kookie_audio_queue_spatial_clip(
                    presentation.combatFeedbackClip(), 240,
                    presentation.combatFeedbackLeftGain(),
                    presentation.combatFeedbackRightGain()),
                    "combat feedback must reach SDL mixer")
                assert(kookie_audio_queue_silence(480),
                    "bounded PCM silence must queue")
                println("audio-open")
            }
            println("KOOKIE native kutter screen verified")
            println("gpu-open")
            assert(kookie_push_quit_event(),
                "SDL quit event must enqueue for black-box shutdown")
            smokeQuitQueued = true
        }
        if (running) { kookie_delay(16) }
    }

    if (gameplayMouseMode) {
        assert(kookie_window_set_gameplay_mouse_mode(window, 0),
            "gameplay mouse mode must release before shutdown")
    }
    kookie_transport_close()
    if (audio > 0) {
        assert(kookie_audio_close(audio), "live SDL mixer token must close")
    }
    assert(kookie_gpu_close(gpu), "live GPU token must close")
    assert(kookie_window_destroy(window), "live SDL window token must close")
    kookie_sdl_shutdown()
    println("KOOKIE G0 native SDL adapter verified")
}
