    Int phaseWave(Int phase, Int period) {
        var value = phase % period
        if (value < 0) { value = value + period }
        return if (value < period / 2) -1 else 1
    }

    Bool uploadModel(
        BoundedExternalGlbModelReader reader,
        Int model,
        Int resourceBase,
        Int x,
        Int y,
        Int z,
        Int facing,
        Int phase,
        Int animationState,
        Int animationTick,
        Int moving,
        Int attacking,
        Bool flashed
    ) {
        if (!reader.valid() || facing == 0) { return false }
        var authoredPose = reader.prepareAnimationPose(
            animationState, animationTick)
        if (authoredPose) { authoredPoseCountValue = authoredPoseCountValue + 1 }
        var idleBob = 0
        if (!authoredPose &&
            animationState == 1 && phaseWave(animationTick, 8) > 0) {
            idleBob = 1
        }
        var gaitBob = 0
        if (!authoredPose &&
            moving != 0 && phaseWave(phase, 8) > 0) { gaitBob = 1 }
        var attackLift = if (!authoredPose && attacking != 0) 2 else 0
        var bob = idleBob + gaitBob + attackLift
        for (var index = 0; index < reader.vertexCount(); index = index + 1) {
            var localX = reader.vertexX(index)
            var localY = reader.vertexY(index) + bob
            if (!authoredPose) {
                localY = localY + reader.vertexAnimationLift(
                    index, animationState, animationTick, moving, attacking)
            }
            var localZ = reader.vertexZ(index)
            var worldX = x
            var worldZ = z
            if (facing > 0) {
                worldX = x - localZ
                worldZ = z + localX
            } else {
                worldX = x + localZ
                worldZ = z - localX
            }
            var resource = resourceBase + reader.vertexMaterial(index)
            var hasTexture = reader.textureOffset() >= 0 &&
                reader.textureLength() > 0
            if (flashed) {
                resource = 3
            } else if (hasTexture && model == kookieModelGoose()) {
                resource = 16
            } else if (hasTexture && model == kookieModelCat()) {
                resource = 15
            }
            var textureU = worldTextureAsset.textureU(
                resource, reader.vertexU(index))
            var textureV = worldTextureAsset.textureV(
                resource, reader.vertexV(index))
            if (textureU < 0 || textureV < 0 ||
                !kookie_gpu_world_push_vertex_uv(
                    worldX, y + localY, worldZ, textureU, textureV)) {
                return false
            }
        }
        return true
    }

    Bool uploadAnimalModels() {
        for (var index = 0; index < animalMeshes.actorCapacity();
             index = index + 1) {
            if (!animalMeshes.actorCurrentAt(index)) { continue }
            var kind = animalMeshes.actorKindAt(index)
            var model = kookieModelGoose()
            var reader = gooseModelReader
            var resourceBase = 9
            var animationState = animalMeshes.gooseAnimationState()
            var animationTick = animalMeshes.gooseAnimationTick()
            if (kind == 2) {
                model = kookieModelCat()
                reader = catModelReader
                resourceBase = 12
                animationState = animalMeshes.catAnimationState()
                animationTick = animalMeshes.catAnimationTick()
            }
            if (!uploadModel(
                    reader, model, resourceBase,
                    animalMeshes.actorXAt(index),
                    animalMeshes.actorYAt(index),
                    animalMeshes.actorZAt(index),
                    animalMeshes.actorFacingAt(index),
                    animalMeshes.actorPhaseAt(index),
                    animationState, animationTick,
                    if (animalMeshes.actorMovingAt(index)) 1 else 0,
                    if (animalMeshes.actorAttackingAt(index)) 1 else 0,
                    damageFlashAt(animalMeshes.actorIdAt(index)))) {
                println("KOOKIE gameplay native animal model upload failed")
                println(animalMeshes.actorIdAt(index))
                return false
            }
        }
        return true
    }

    Bool configureIdentity(
        Bool mirrorRemote, Int localNameId, Int remoteNameId,
        Int localAnimalKind, Int remoteAnimalKind
    ) {
        if (localNameId < 1 || localNameId > 4 ||
            remoteNameId < 1 || remoteNameId > 4 ||
            (localAnimalKind != multiplayerAnimalGoose() &&
                localAnimalKind != multiplayerAnimalCat()) ||
            (remoteAnimalKind != multiplayerAnimalGoose() &&
                remoteAnimalKind != multiplayerAnimalCat())) {
            return false
        }

        mirrorRemoteValue = mirrorRemote
        localNameIdValue = localNameId
        remoteNameIdValue = remoteNameId
        localAnimalKindValue = localAnimalKind
        remoteAnimalKindValue = remoteAnimalKind
        return true
    }
