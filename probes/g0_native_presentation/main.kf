import core
import demo
import world
import ui

extern "./build/libkookie_sdl_adapter.so" kookie_sdl_init(Int flags): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_sdl_shutdown(): void
extern "./build/libkookie_sdl_adapter.so" kookie_window_create(Int width, Int height, Int hidden): Int
extern "./build/libkookie_sdl_adapter.so" kookie_window_destroy(Int token): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_open(Int windowToken): Int
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_report_window_present_capabilities(): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_capture_window(): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_close(Int token): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_draw_test(): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_report_window_draw(): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_scene_capacity(): Int
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_scene_begin(Int vertexCount): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_scene_push_vertex(Int resource, Int x, Int y, Int u, Int v): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_scene_commit(): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_scene_count(): Int
extern "./build/libkookie_sdl_adapter.so" kookie_gpu_draw_scene(): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_drain_events(Int maxEvents): Int
extern "./build/libkookie_sdl_adapter.so" kookie_poll_event(): Int
extern "./build/libkookie_sdl_adapter.so" kookie_last_event_a(): Int
extern "./build/libkookie_sdl_adapter.so" kookie_last_event_b(): Int
extern "./build/libkookie_sdl_adapter.so" kookie_push_resize_event(Int width, Int height): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_push_focus_event(Int focused): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_audio_open(): Int
extern "./build/libkookie_sdl_adapter.so" kookie_audio_queue_silence(Int frames): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_audio_close(Int token): Bool
extern "./build/libkookie_sdl_adapter.so" kookie_audio_queue_spatial_clip(
    Int clipId, Int frames, Int leftGain, Int rightGain
): Bool

class G1NativePresentation {
    G1Demo scenario
    G4CreatorDemo creatorScenario
    G1Arena arena
    LoopbackSession interactionSession
    ShooterHud hud
    CameraState camera
    FrameStaging worldFrame
    FrameStaging hudFrame
    FrameStaging doorFrame
    Int worldCapacity
    Int hudCapacity
    Int nativeCapacity
    Int doorCapacity

    public constructor() {
        scenario = G1Demo()
        creatorScenario = G4CreatorDemo()
        arena = scenario.authoredArena()
        hud = scenario.shooterHud()
        camera = CameraState(-450, 450)
        interactionSession = LoopbackSession(1, 1)
        worldFrame = FrameStaging(arena.renderVertexCount())
        doorFrame = FrameStaging(36)
        hudFrame = FrameStaging(hud.renderVertexCount())
        worldCapacity = worldFrame.vertexCapacity()
        doorCapacity = doorFrame.vertexCapacity()
        hudCapacity = hudFrame.vertexCapacity()
        nativeCapacity = 0
    }

    Bool prepare() {
        if (!scenario.run() || !creatorScenario.run() ||
            !hud.updateCreatorPublication(
                creatorScenario.publicationStatus(),
                creatorScenario.publishedGeneration(),
                creatorScenario.publicationDiagnostic(),
                creatorScenario.completed()) ||
            !camera.applyLook(20, -20) ||
            !interactionSession.defineWorldKey(
                1, 30, 0, 0, 0) ||
            !interactionSession.defineWorldDoor(
                2, 1, 0, 5, 5, 3, 5, 1, 8) ||
            !interactionSession.start()) {
            return false
        }
        var blocked = interactionSession.queryWorldDoorPath(
            SpatialPoint(-5, 5, 5), SpatialPoint(5, 5, 5))
        var above = interactionSession.queryWorldDoorPath(
            SpatialPoint(-5, 12, 5), SpatialPoint(5, 12, 5))
        if (!blocked.accepted() || !blocked.collided() ||
            !above.accepted() || above.collided()) {
            return false
        }
        nativeCapacity = kookie_gpu_scene_capacity()
        return nativeCapacity >=
            worldCapacity + doorCapacity + hudCapacity
    }

    Bool upload(FrameStaging frame) {
        for (var index = 0; index < frame.stagedCount(); index = index + 1) {
            if (!kookie_gpu_scene_push_vertex(
                    frame.resourceAt(index),
                    frame.xAt(index), frame.yAt(index),
                    frame.uAt(index), frame.vAt(index))) {
                return false
            }
        }
        return true
    }

    Bool drawFrame(Int frame) {
        var vertexCount =
            worldCapacity + doorCapacity + hudCapacity
        if (!arena.stage(worldFrame, frame, 1, camera) ||
            !interactionSession.stageWorldInteractionGeometry(
                doorFrame, frame, 7, camera) ||
            !hud.stage(hudFrame, frame, 9) ||
            !kookie_gpu_scene_begin(vertexCount) ||
            !upload(worldFrame) || !upload(doorFrame) ||
            !upload(hudFrame) ||
            !kookie_gpu_scene_commit() ||
            kookie_gpu_scene_count() != vertexCount ||
            !kookie_gpu_draw_scene()) {
            return false
        }
        return worldFrame.retire(frame) &&
            doorFrame.retire(frame) &&
            hudFrame.retire(frame)
    }

    Bool capacitiesStable() {
        return worldFrame.vertexCapacity() == worldCapacity &&
            doorFrame.vertexCapacity() == doorCapacity &&
            hudFrame.vertexCapacity() == hudCapacity &&
            kookie_gpu_scene_capacity() == nativeCapacity
    }

    Bool dequeueCombatFeedbackAudio() {
        return scenario.dequeueCombatFeedbackAudio()
    }

    Int combatFeedbackClip() {
        return scenario.combatFeedbackClip()
    }

    Int combatFeedbackGain() {
        return scenario.combatFeedbackGain()
    }

    Int combatFeedbackLeftGain() {
        return scenario.combatFeedbackLeftGain()
    }

    Int combatFeedbackRightGain() {
        return scenario.combatFeedbackRightGain()
    }

}

main() {
    println("KOOKIE G0 native SDL presentation probe")
    assert(kookie_sdl_init(48), "SDL video/audio adapter init must succeed")
    var window = kookie_window_create(320, 240, 0)
    assert(window > 0, "visible SDL window must create")
    var state = WindowStateTracker(320, 240)
    kookie_drain_events(32)

    assert(kookie_push_resize_event(640, 480), "SDL resize event must enqueue")
    var eventKind = kookie_poll_event()
    assert(eventKind == 2, "resize event must flatten to kind 2")
    assert(kookie_last_event_a() == 640 && kookie_last_event_b() == 480,
        "resize payload must copy")
    assert(state.applyNativeEvent(eventKind, kookie_last_event_a(), kookie_last_event_b()),
        "resize event must update Kof state")

    assert(kookie_push_focus_event(1), "SDL focus event must enqueue")
    eventKind = kookie_poll_event()
    assert(eventKind == 3, "focus event must flatten to kind 3")
    assert(state.applyNativeEvent(eventKind, kookie_last_event_a(), kookie_last_event_b()),
        "focus event must update Kof state")
    var snapshot = state.snapshot()
    assert(snapshot.width() == 640 && snapshot.height() == 480 && snapshot.focused(),
        "native resize and focus must reach Kof state")

    var gpu = kookie_gpu_open(window)
    assert(gpu > 0, "GPU must claim the visible SDL window")
    assert(kookie_gpu_draw_test(), "first SDL GPU upload and draw must succeed")
    var presentation = G1NativePresentation()
    assert(presentation.prepare(), "G1 scenario and bounded scene must prepare")
    for (var frame = 1; frame <= 3; frame = frame + 1) {
        assert(presentation.drawFrame(frame),
            "authored arena and authoritative HUD must draw")
    }
    assert(presentation.capacitiesStable(),
        "scene staging capacities must remain fixed")
    assert(kookie_gpu_capture_window(),
        "G1 arena, G2 door and HUD screenshot capture must succeed")
    println("KOOKIE G1 native arena HUD verified")
    println("KOOKIE G2 native 3D door verified")
    assert(kookie_gpu_report_window_present_capabilities(),
        "window must expose a present capability")
    assert(kookie_gpu_report_window_draw(),
        "GPU draw timing must be positive")
    var audio = kookie_audio_open()
    assert(audio > 0, "dummy SDL audio device must open")
    assert(presentation.dequeueCombatFeedbackAudio() &&
        presentation.combatFeedbackClip() == 201 &&
        presentation.combatFeedbackGain() == 100 &&
        presentation.combatFeedbackLeftGain() == 100 &&
        presentation.combatFeedbackRightGain() == 100,
        "authoritative kill must expose bounded stereo feedback audio")
    assert(kookie_audio_queue_spatial_clip(
            presentation.combatFeedbackClip(), 240,
            presentation.combatFeedbackLeftGain(),
            presentation.combatFeedbackRightGain()),
        "authoritative combat feedback must reach native SDL channels")
    assert(kookie_audio_queue_silence(480), "bounded PCM silence must queue")
    assert(kookie_audio_close(audio), "live audio token must close")
    println("combat-feedback-audio-open")

    assert(kookie_window_destroy(window), "live SDL window token must close")
    kookie_sdl_shutdown()
    println("gpu-open")
    println("KOOKIE G0 native SDL adapter verified")
}
