    Int lootBeamResource(Int rank) {
        if (rank >= 3) { return 7 }
        if (rank == 2) { return 6 }
        return 5
    }

    Bool pushLootBeamQuad(
        Int resource,
        Int ax, Int ay, Int az,
        Int bx, Int by, Int bz,
        Int cx, Int cy, Int cz,
        Int dx, Int dy, Int dz
    ) {
        return lootBeamFrame.pushWorldVertex(resource, ax, ay, az, 0, 0) &&
            lootBeamFrame.pushWorldVertex(resource, bx, by, bz, 100, 0) &&
            lootBeamFrame.pushWorldVertex(resource, cx, cy, cz, 100, 100) &&
            lootBeamFrame.pushWorldVertex(resource, ax, ay, az, 0, 0) &&
            lootBeamFrame.pushWorldVertex(resource, cx, cy, cz, 100, 100) &&
            lootBeamFrame.pushWorldVertex(resource, dx, dy, dz, 0, 100)
    }

    Bool pushLootBeamTriangle(
        Int resource,
        Int ax, Int ay, Int az,
        Int bx, Int by, Int bz,
        Int cx, Int cy, Int cz
    ) {
        return lootBeamFrame.pushWorldVertex(resource, ax, ay, az, 0, 0) &&
            lootBeamFrame.pushWorldVertex(resource, bx, by, bz, 100, 0) &&
            lootBeamFrame.pushWorldVertex(resource, cx, cy, cz, 50, 100)
    }

    Bool stageLootBeams(Int frame) {
        lootBeamActiveValue = false
        var count = worldLootCountForRender()
        if (count <= 0) { return true }
        if (count > 8) { count = 8 }
        if (!lootBeamFrame.begin(frame)) { return false }
        for (var index = 0; index < count; index = index + 1) {
            var x = worldLootPositionXForRender(index)
            var y = worldLootPositionYForRender(index)
            var z = worldLootPositionZForRender(index)
            var width = 2 + ((frame + index) % 4)
            var height = 9 + ((frame + index) % 5)
            var top = y + height
            var resource = lootBeamResource(
                worldLootRankForRender(index))
            if (!pushLootBeamQuad(
                    resource,
                    x - width, y + 1, z,
                    x + width, y + 1, z,
                    x + width / 2, top, z,
                    x - width / 2, top, z) ||
                !pushLootBeamQuad(
                    resource,
                    x, y + 1, z - width,
                    x, y + 1, z + width,
                    x, top, z + width / 2,
                    x, top, z - width / 2) ||
                !pushLootBeamTriangle(
                    resource, x, y + 1, z - 3,
                    x + 3, y + 1, z,
                    x, y + 1, z + 3) ||
                !pushLootBeamTriangle(
                    resource, x, y + 1, z - 3,
                    x, y + 1, z + 3,
                    x - 3, y + 1, z)) {
                lootBeamFrame.discard()
                return false
            }
        }
        if (!lootBeamFrame.publish()) {
            lootBeamFrame.discard()
            return false
        }
        lootBeamActiveValue = true
        return true
    }

    Int highestWorldLootRank() {
        var highest = 0
        var count = worldLootCountForRender()
        if (count > 8) { count = 8 }
        for (var index = 0; index < count; index = index + 1) {
            var rank = worldLootRankForRender(index)
            if (rank > highest) { highest = rank }
        }
        return highest
    }

