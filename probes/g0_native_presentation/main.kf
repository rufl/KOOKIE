Int kookieModelGoose() { return 1 }
Int kookieModelCat() { return 2 }


Int lobbyProtocolMagic() { return 1263488843 }
Int lobbyProtocolVersion() { return 3 }
Int lobbyMessageHello() { return 1 }
Int lobbyMessageAccept() { return 2 }
Int lobbyMessageLeave() { return 3 }
Int lobbyMessageWait() { return 4 }
Int lobbyMessagePeer() { return 5 }
Int lobbyMessageReady() { return 6 }
Int lobbyMessageUnready() { return 7 }

class NativeLobbyState {
    Bool wanRendezvousValue
    Bool wanPeerReadyValue
    Bool hostValue
    Int remoteNameIdValue
    Int remoteColorIdValue
    Int remoteAnimalKindValue

    public constructor() {
        wanRendezvousValue = false
        wanPeerReadyValue = false
        hostValue = true
        remoteNameIdValue = 2
        remoteColorIdValue = 4
        remoteAnimalKindValue = multiplayerAnimalCat()
    }

    Bool wanRendezvous() { return wanRendezvousValue }
    Bool peerReady() { return wanPeerReadyValue }
    Bool host() { return hostValue }
    Int remoteNameId() { return remoteNameIdValue }
    Int remoteColorId() { return remoteColorIdValue }
    Int remoteAnimalKind() { return remoteAnimalKindValue }
    void setWanRendezvous(Bool value) { wanRendezvousValue = value }
    void setPeerReady(Bool value) { wanPeerReadyValue = value }
    void setHost(Bool value) { hostValue = value }
    void setRemoteNameId(Int value) { remoteNameIdValue = value }
    void setRemoteColorId(Int value) { remoteColorIdValue = value }
    void setRemoteAnimalKind(Int value) { remoteAnimalKindValue = value }


}

Bool configureLobbyKey() {
    if (kookie_transport_set_key_from_environment()) { return true }
    if (kookie_transport_wan_rendezvous_enabled()) { return false }
    return kookie_transport_set_key(
        1263488843, 1330332754, 1229737803, 1162760019)
}

String lobbyNicknameCharacter(Int value) {
    if (value == 65) { return "A" }
    if (value == 66) { return "B" }
    if (value == 67) { return "C" }
    if (value == 68) { return "D" }
    if (value == 69) { return "E" }
    if (value == 70) { return "F" }
    if (value == 71) { return "G" }
    if (value == 72) { return "H" }
    if (value == 73) { return "I" }
    if (value == 74) { return "J" }
    if (value == 75) { return "K" }
    if (value == 76) { return "L" }
    if (value == 77) { return "M" }
    if (value == 78) { return "N" }
    if (value == 79) { return "O" }
    if (value == 80) { return "P" }
    if (value == 81) { return "Q" }
    if (value == 82) { return "R" }
    if (value == 83) { return "S" }
    if (value == 84) { return "T" }
    if (value == 85) { return "U" }
    if (value == 86) { return "V" }
    if (value == 87) { return "W" }
    if (value == 88) { return "X" }
    if (value == 89) { return "Y" }
    if (value == 90) { return "Z" }
    if (value == 48) { return "0" }
    if (value == 49) { return "1" }
    if (value == 50) { return "2" }
    if (value == 51) { return "3" }
    if (value == 52) { return "4" }
    if (value == 53) { return "5" }
    if (value == 54) { return "6" }
    if (value == 55) { return "7" }
    if (value == 56) { return "8" }
    if (value == 57) { return "9" }
    if (value == 32) { return " " }
    if (value == 45) { return "-" }
    if (value == 95) { return "_" }
    return ""
}

Bool sendLobbyMessage(GameShell shell, Int operation, Int role) {
    var room = kookie_transport_room_code()
    var name = shell.lobby().localNameId()
    var color = shell.lobby().localColorId()
    var animalKind = shell.lobby().localAnimalKind()
    var nickname = shell.lobby().localNickname()
    var length = nickname.length()
    if (length < 1 || length > 12) { return false }
    if (!kookie_transport_send_begin(9 + length) ||
        !kookie_transport_send_word(0, lobbyProtocolMagic()) ||
        !kookie_transport_send_word(1, lobbyProtocolVersion()) ||
        !kookie_transport_send_word(2, operation) ||
        !kookie_transport_send_word(3, room) ||
        !kookie_transport_send_word(4, role) ||
        !kookie_transport_send_word(5, name) ||
        !kookie_transport_send_word(6, color) ||
        !kookie_transport_send_word(7, length) ||
        !kookie_transport_send_word(8, animalKind)) {
        return false
    }
    for (var index = 0; index < length; index = index + 1) {
        if (!kookie_transport_send_word(
                9 + index, nickname.charAt(index) as Int)) {
            return false
        }
    }
    return kookie_transport_send_commit()
}

Int lobbyRole(Int operation) {
    if (operation == gameShellNetworkHostRequest()) { return 1 }
    return 2
}

Bool serviceNetworkRequest(GameShell shell, NativeLobbyState state) {
    var operation = shell.networkRequest()
    if (operation == 0) { return true }
    if (operation == gameShellNetworkLeaveRequest()) {
        if (shell.networkStatus() == gameShellNetworkConnected()) {
            sendLobbyMessage(
                shell, lobbyMessageLeave(),
                if (state.host()) 1 else 2)
        }
        state.setWanRendezvous(false)
        state.setPeerReady(false)
        state.setHost(true)
        kookie_transport_close()
        return shell.completeNetworkRequest(operation, true)
    }
    kookie_transport_close()
    state.setWanRendezvous(kookie_transport_wan_rendezvous_enabled())
    state.setPeerReady(false)
    state.setHost(operation == gameShellNetworkHostRequest())
    state.setRemoteNameId(
        if (operation == gameShellNetworkHostRequest()) 2 else 1)
    var success = kookie_transport_select_slot(0) && configureLobbyKey()
    if (success && state.wanRendezvous() &&
        (operation == gameShellNetworkHostRequest() ||
            operation == gameShellNetworkJoinRequest())) {
        success = kookie_transport_open_rendezvous_environment(shell.port()) &&
            sendLobbyMessage(shell, lobbyMessageHello(), lobbyRole(operation))
    } else if (success && operation == gameShellNetworkHostRequest()) {
        success = kookie_transport_open_listen_ipv4(shell.port())
    } else if (success && operation == gameShellNetworkJoinRequest()) {
        success = kookie_transport_open_remote_ipv4(
            shell.addressOne(), shell.addressTwo(),
            shell.addressThree(), shell.addressFour(), shell.port()) &&
            sendLobbyMessage(shell, lobbyMessageHello(), lobbyRole(operation))
    }
    if (!success) { kookie_transport_close() }
    return shell.completeNetworkRequest(operation, success)
}

Bool validLobbyEnvelope(Int received) {
    return received >= 4 &&
        kookie_transport_receive_word(0) == lobbyProtocolMagic() &&
        kookie_transport_receive_word(1) == lobbyProtocolVersion() &&
        kookie_transport_receive_word(3) == kookie_transport_room_code()
}

Bool serviceNetworkHandshake(
    GameShell shell, NativeLobbyState state
) {
    var status = shell.networkStatus()
    if (status != gameShellNetworkHosting() &&
        status != gameShellNetworkJoining() &&
        status != gameShellNetworkConnected()) {
        return true
    }
    if (state.wanRendezvous() &&
        status != gameShellNetworkConnected() &&
        !sendLobbyMessage(
            shell, lobbyMessageHello(),
            if (status == gameShellNetworkHosting()) 1 else 2)) {
        return false
    }
    if (status == gameShellNetworkConnected() &&
        !sendLobbyMessage(
            shell,
            if (shell.lobby().localReady())
                lobbyMessageReady() else lobbyMessageUnready(),
            if (state.host()) 1 else 2)) {
        return false
    }
    var received = kookie_transport_receive_available()
    if (received == 0 || !validLobbyEnvelope(received)) { return true }
    var operation = kookie_transport_receive_word(2)
    if (operation == lobbyMessageWait()) { return true }
    if (operation == lobbyMessagePeer() && state.wanRendezvous() &&
        received == 9 &&
        kookie_transport_receive_word(8) > 0) {
        if (!kookie_transport_set_peer_ipv4(
                kookie_transport_receive_word(4),
                kookie_transport_receive_word(5),
                kookie_transport_receive_word(6),
                kookie_transport_receive_word(7),
                kookie_transport_receive_word(8)) ||
            !kookie_transport_reset_session()) {
            return false
        }
        state.setPeerReady(true)
        return sendLobbyMessage(
            shell, lobbyMessageHello(),
            if (status == gameShellNetworkHosting()) 1 else 2)
    }
    if (operation == lobbyMessageLeave()) {
        kookie_transport_close()
        state.setPeerReady(false)
        return shell.markNetworkDisconnected()
    }
    if (received < 9) { return false }
    var remoteNameId = kookie_transport_receive_word(5)
    var remoteColorId = kookie_transport_receive_word(6)
    var nicknameLength = kookie_transport_receive_word(7)
    var remoteAnimalKind = kookie_transport_receive_word(8)
    if (remoteNameId < 1 || remoteNameId > 4 ||
        remoteColorId < 0 || remoteColorId > 4 ||
        (remoteAnimalKind != multiplayerAnimalGoose() &&
            remoteAnimalKind != multiplayerAnimalCat()) ||
        nicknameLength < 1 || nicknameLength > 12 ||
        received != 9 + nicknameLength) {
        return false
    }
    var remoteNickname = ""
    for (var index = 0; index < nicknameLength; index = index + 1) {
        var character = lobbyNicknameCharacter(
            kookie_transport_receive_word(9 + index))
        if (character.length() != 1) { return false }
        remoteNickname = remoteNickname + character
    }
    state.setRemoteNameId(remoteNameId)
    state.setRemoteColorId(remoteColorId)
    state.setRemoteAnimalKind(remoteAnimalKind)
    if (!shell.setRemoteNameId(remoteNameId) ||
        !shell.setRemoteAnimalKind(remoteAnimalKind) ||
        !shell.setRemoteProfile(remoteNickname, remoteColorId)) {
        return false
    }
    if (operation == lobbyMessageHello()) {
        return kookie_transport_set_peer_last_sender() &&
            sendLobbyMessage(shell, lobbyMessageAccept(),
                if (status == gameShellNetworkHosting()) 1 else 2) &&
            shell.markNetworkConnected()
    }
    if (operation == lobbyMessageAccept()) {
        return shell.markNetworkConnected()
    }
    if ((operation == lobbyMessageReady() ||
            operation == lobbyMessageUnready()) &&
        status == gameShellNetworkConnected()) {
        return shell.lobby().setRemoteReady(
            operation == lobbyMessageReady())
    }
    return true
}

class NativeGameNetworkState {
    Int[] receiveValues
    Int receiveCountValue
    Int localSequenceValue
    Int remoteSequenceValue
    Int remoteMoveValue
    Int remoteMoveZValue
    Int remoteJumpValue
    Int remoteButtonsValue
    Bool remoteFireValue
    Int remoteInputSequenceValue
    Int remoteSnapshotAckValue
    Int remoteFireTickValue
    Int lastRemoteSnapshotSequenceValue
    Int lastRemoteInputAckValue
    Int remotePlayerOneHealthValue
    Int remotePlayerTwoHealthValue
    Bool remoteStatusReadyValue
    NetcodeInputHistory localInputHistoryValue

    public constructor(Int capacity) {
        var actualCapacity = capacity
        if (actualCapacity <= 0) { actualCapacity = 1 }
        receiveValues = new Int[actualCapacity]
        localSequenceValue = 0
        remoteSequenceValue = 0
        remoteMoveValue = 0
        remoteMoveZValue = 0
        remoteJumpValue = 0
        remoteButtonsValue = 0
        remoteFireValue = false
        remoteInputSequenceValue = 0
        remoteSnapshotAckValue = 0
        remoteFireTickValue = 0
        lastRemoteSnapshotSequenceValue = 0
        lastRemoteInputAckValue = 0
        remotePlayerOneHealthValue = 100
        remotePlayerTwoHealthValue = 100
        remoteStatusReadyValue = false
        localInputHistoryValue = NetcodeInputHistory(
            netcodeMaximumInputHistory())
    }

    void reset() {
        receiveCountValue = 0
        localSequenceValue = 0
        remoteSequenceValue = 0
        remoteMoveValue = 0
        remoteMoveZValue = 0
        remoteJumpValue = 0
        remoteButtonsValue = 0
        remoteFireValue = false
        lastRemoteSnapshotSequenceValue = 0
        lastRemoteInputAckValue = 0
        remotePlayerOneHealthValue = 100
        remotePlayerTwoHealthValue = 100
        remoteStatusReadyValue = false
        localInputHistoryValue.clear()
    }

    Int nextLocalSequence() {
        localSequenceValue = localSequenceValue + 1
        if (localSequenceValue > 1000000) { localSequenceValue = 1 }
        return localSequenceValue
    }

    Int nextRemoteSequence() {
        remoteSequenceValue = remoteSequenceValue + 1
        if (remoteSequenceValue > 1000000) { remoteSequenceValue = 1 }
        return remoteSequenceValue
    }

    Bool recordLocalInput(
        Int tick, Int sequence, Int moveX, Int moveZ,
        Int fire, Int jump, Int buttons
    ) {
        return localInputHistoryValue.push(
            tick, sequence, moveX, moveZ, fire, jump, buttons)
    }

    Int[] localInputWords() {
        return localInputHistoryValue.commandWords()
    }

    Bool acknowledgeLocalInput(Int sequence) {
        if (sequence <= 0) { return true }
        if (sequence > localInputHistoryValue.latestSequence()) {
            return false
        }
        return localInputHistoryValue.acknowledge(sequence)
    }

    Int localInputCount() { return localInputHistoryValue.count() }
    Int localInputAck() { return localInputHistoryValue.acknowledgedSequence() }

    void setRemoteMove(Int value) {
        remoteMoveValue = value
        if (remoteMoveValue < -4) { remoteMoveValue = -4 }
        if (remoteMoveValue > 4) { remoteMoveValue = 4 }
    }
    void setRemoteMoveZ(Int value) {
        remoteMoveZValue = value
        if (remoteMoveZValue < -4) { remoteMoveZValue = -4 }
        if (remoteMoveZValue > 4) { remoteMoveZValue = 4 }
    }
    void setRemoteJump(Int value) {
        remoteJumpValue = value
        if (remoteJumpValue < 0) { remoteJumpValue = 0 }
        if (remoteJumpValue > 1) { remoteJumpValue = 1 }
    }
    void setRemoteButtons(Int value) {
        remoteButtonsValue = value
        if (remoteButtonsValue < 0 ||
            remoteButtonsValue > inputButtonMask()) {
            remoteButtonsValue = 0
        }
    }

    Int consumeRemoteButtons() {
        var result = remoteButtonsValue
        remoteButtonsValue = 0
        return result
    }

    Int remoteJump() { return remoteJumpValue }

    Int remoteMoveZ() { return remoteMoveZValue }

    Int remoteMove() { return remoteMoveValue }
    void setRemoteFire() { setRemoteFireAt(0) }
    void setRemoteFireAt(Int tick) {
        remoteFireValue = true
        remoteFireTickValue = tick
    }
    Bool consumeRemoteFire() {
        var result = remoteFireValue
        remoteFireValue = false
        return result
    }

    void setRemoteInputSequence(Int sequence) {
        if (sequence > remoteInputSequenceValue) {
            remoteInputSequenceValue = sequence
        }
    }


    void setRemoteSnapshotAck(Int sequence) {
        if (sequence > remoteSnapshotAckValue) {
            remoteSnapshotAckValue = sequence
        }
    }

    Int remoteSnapshotAck() { return remoteSnapshotAckValue }
    Int remoteFireTick() { return remoteFireTickValue }
    Int remoteInputSequence() { return remoteInputSequenceValue }

    void setRemoteSnapshotSequence(Int sequence) {
        if (sequence > lastRemoteSnapshotSequenceValue) {
            lastRemoteSnapshotSequenceValue = sequence
        }
    }

    Int lastRemoteSnapshotSequence() {
        return lastRemoteSnapshotSequenceValue
    }

    void setRemoteInputAck(Int sequence) {
        if (sequence > lastRemoteInputAckValue) {
            lastRemoteInputAckValue = sequence
        }
    }

    Int lastRemoteInputAck() { return lastRemoteInputAckValue }

    void setRemotePlayerHealth(Int playerOne, Int playerTwo) {
        remotePlayerOneHealthValue = playerOne
        remotePlayerTwoHealthValue = playerTwo
        if (remotePlayerOneHealthValue < 0) { remotePlayerOneHealthValue = 0 }
        if (remotePlayerOneHealthValue > 100) { remotePlayerOneHealthValue = 100 }
        if (remotePlayerTwoHealthValue < 0) { remotePlayerTwoHealthValue = 0 }
        if (remotePlayerTwoHealthValue > 100) { remotePlayerTwoHealthValue = 100 }
        remoteStatusReadyValue = true
    }
    Bool remoteStatusReady() { return remoteStatusReadyValue }
    Int remotePlayerOneHealth() { return remotePlayerOneHealthValue }
    Int remotePlayerTwoHealth() { return remotePlayerTwoHealthValue }

    Bool capturePacket() {
        receiveCountValue = kookie_transport_receive_available()
        if (receiveCountValue <= 0 || receiveCountValue > receiveValues.length) {
            receiveCountValue = 0
            return false
        }
        for (var index = 0;
            index < receiveCountValue; index = index + 1) {
            receiveValues[index] = kookie_transport_receive_word(index)
        }
        return true
    }

    Int received() { return receiveCountValue }
    Int word(Int index) {
        if (index < 0 || index >= receiveCountValue) { return 0 }
        return receiveValues[index]
    }

    Int[] packet() {
        var result = new Int[receiveCountValue]
        for (var index = 0; index < receiveCountValue; index = index + 1) {
            result[index] = receiveValues[index]
        }
        return result
    }
}

Bool sendGamePayload(Int[] payload) {
    if (payload.length <= 0 ||
        payload.length > maximumSessionTransportWords() ||
        !kookie_transport_send_begin(payload.length)) {
        return false
    }
    for (var index = 0; index < payload.length; index = index + 1) {
        if (!kookie_transport_send_word(index, payload[index])) {
            return false
        }
    }
    return kookie_transport_send_commit()
}

Int localMoveForwardAxis(NativeInputState input) {
    return movementForwardAxis(
        input.forwardHeld(), input.backwardHeld())
}

Int localMoveStrafeAxis(NativeInputState input) {
    return movementStrafeAxis(
        input.leftHeld(), input.rightHeld())
}

Int gooseStatusMagic() { return 1196384339 }

Bool validGooseStatusMessage(Int[] words) {
    return words.length == 5 &&
        words[0] == gooseStatusMagic() &&
        words[1] == 1 &&
        words[2] >= 0 && words[2] <= 1000000 &&
        words[3] >= 0 && words[3] <= 100 &&
        words[4] >= 0 && words[4] <= 100
}

Bool processGamePackets(
    LoopbackSession session, NativeGameNetworkState state,
    MatchScoreboardState scoreboard, Bool host
) {
    for (var packet = 0; packet < 8; packet = packet + 1) {
        if (!state.capturePacket()) { return true }
        var words = state.packet()
        if (host && validGameplayInputBundleMessage(words) &&
            gameplayInputBundlePlayer(words) == 2) {
            var count = gameplayInputBundleCount(words)
            state.setRemoteSnapshotAck(
                gameplayInputBundleSnapshotAck(words))
            for (var index = 0; index < count; index = index + 1) {
                var tick = gameplayInputBundleValue(words, index, 0)
                if (tick == session.currentServerTick() + 1) {
                    state.setRemoteMove(
                        gameplayInputBundleValue(words, index, 2))
                    state.setRemoteMoveZ(
                        gameplayInputBundleValue(words, index, 3))
                    if (gameplayInputBundleValue(words, index, 4) != 0) {
                        state.setRemoteFireAt(tick)
                    }
                    state.setRemoteJump(
                        gameplayInputBundleValue(words, index, 5))
                    state.setRemoteButtons(
                        gameplayInputBundleValue(words, index, 6))
                    state.setRemoteInputSequence(
                        gameplayInputBundleValue(words, index, 1))
                }
            }
        } else if (host && validGameplayCommandMessage(words) &&
            gameplayCommandPlayer(words) == 2) {
            if (gameplayCommandAction(words) == gameplayMoveAction()) {
                state.setRemoteMove(gameplayCommandValue(words, 0))
            } else if (gameplayCommandAction(words) == gameplayFireAction()) {
                state.setRemoteFire()
            }
        } else if (!host && validGameplayStateMessage(words)) {
            if (session.applyRemoteGameplayState(words)) {
                state.setRemoteSnapshotSequence(words[3])
            }
        } else if (!host && validWorldLootStateMessage(words)) {
            session.applyRemoteWorldLootState(words)
        } else if (!host && validGameplayInputAckMessage(words)) {
            var acknowledged = gameplayInputAckSequence(words)
            state.setRemoteInputAck(acknowledged)
            state.acknowledgeLocalInput(acknowledged)
        } else if (!host && validEnemyEncounterStateMessage(words)) {
            session.applyRemoteEnemyEncounterState(words)
        } else if (!host && validMultiplayerScoreboardMessage(words)) {
            scoreboard.apply(words)
        } else if (!host && validGooseStatusMessage(words)) {
            state.setRemotePlayerHealth(words[3], words[4])
        }
    }
    return true
}

Bool sendLocalGameInput(
    LoopbackSession session, NativeGameNetworkState state,
    Int player, Int moveX, Int moveZ, Int fire, Int jump, Int buttons
) {
    var tick = session.currentServerTick() + 1
    var sequence = state.nextLocalSequence()
    if (!state.recordLocalInput(
            tick, sequence, moveX, moveZ, fire, jump, buttons)) {
        return false
    }
    var bundle = newGameplayInputBundleMessage(
        player, 1, state.lastRemoteSnapshotSequence(),
        state.localInputWords())
    return bundle.length > 0 && sendGamePayload(bundle)
}
