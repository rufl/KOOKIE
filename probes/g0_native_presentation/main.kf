        return inputStateValue.applyMouseButtonCode(button, pressed)
    }

    Int consumeActionButtons() {
        return inputStateValue.consumeActionButtons()
    }

    Bool applyNativeWindowEvent(Int kind, Int dataA, Int dataB) {
        if (!windowStateValue.applyNativeEvent(kind, dataA, dataB)) {
            return false
        }
        if (kind == 3 && dataA == 0) {
            if (!inputStateValue.clearHeld()) { return false }
            kookie_consume_mouse_delta_x()
            kookie_consume_mouse_delta_y()
            kookie_consume_mouse_wheel_y()
        }
        return true
    }

    Int inputForwardHeld() { return inputStateValue.forwardHeld() }
