        return inputStateValue.consumeScoreboardToggle()
    }
    Bool setCooperativeMode(Bool cooperative) {
        cooperativeModeValue = cooperative
        return true
    }

    Bool cooperativeMode() { return cooperativeModeValue }

    Bool applyUiSettings(GameShell shell) {
        return hud.setScale(shell.hudScalePercent()) &&
            hud.setHighContrast(shell.highContrast()) &&
            gooseOverlay.setHighContrast(shell.highContrast()) &&
            scoreboardUi.setHighContrast(shell.highContrast()) &&
            minimap.setVisible(shell.tacticalMapVisible())
    }
    Bool prepareLiquidContent() {
        var loader = LiquidConfigFileLoader()
        if (!loader.loadPhysics(
                liquidPhysicsValue,
                liquidRuntimeConfigPath("liquid_physics.json")) ||
            !loader.loadWaterBody(
                waterPoolConfigValue,
                liquidRuntimeConfigPath("water_bodies/pool.json")) ||
            !loader.loadWaterBody(
                waterChannelConfigValue,
                liquidRuntimeConfigPath("water_bodies/channel.json")) ||
            !loader.loadFloatable(
                crateConfigValue,
                liquidRuntimeConfigPath("floatables/crate.json")) ||
            !loader.loadFloatable(
                stoneConfigValue,
                liquidRuntimeConfigPath("floatables/stone.json"))) {
            return false
        }
        var powerUpLoader = PowerUpConfigFileLoader()
        if (!powerUpLoader.load(
                coffeeMugConfigValue,
                liquidRuntimeConfigPath("power_ups/coffee_mug.json")) ||
            !powerUpLoader.load(
                jetpackConfigValue,
                liquidRuntimeConfigPath("power_ups/jetpack.json")) ||
            !powerUpLoader.load(
                megaphoneConfigValue,
                liquidRuntimeConfigPath("power_ups/megaphone.json")) ||
            !powerUpLoader.load(
                scubaKitConfigValue,
                liquidRuntimeConfigPath("power_ups/scuba_kit.json")) ||
            !powerUpLoader.load(
                watermelonConfigValue,
                liquidRuntimeConfigPath("power_ups/watermelon.json")) ||
            !powerUpLoader.load(
                woolBallConfigValue,
                liquidRuntimeConfigPath("power_ups/wool_ball.json"))) {
            return false
        }
        liquidWorldValue = BoundedLiquidWorld(liquidMaximumBodies())
        if (!liquidWorldValue.addBody(waterPoolConfigValue.definition()) ||
            !liquidWorldValue.addBody(waterChannelConfigValue.definition())) {
            return false
        }
        liquidObjectsValue = LiquidObjectWorld(liquidDefaultObjectCapacity())
        if (!liquidObjectsValue.addObject(
                crateConfigValue.objectId(), crateConfigValue.x(),
                crateConfigValue.y(), crateConfigValue.z(),
                crateConfigValue.halfExtent(), crateConfigValue.floatable(),
                crateConfigValue.density(), crateConfigValue.buoyancy(),
                crateConfigValue.drag(), crateConfigValue.gravity(),
                crateConfigValue.maxFallSpeed(), crateConfigValue.resource()) ||
            !liquidObjectsValue.addObject(
                stoneConfigValue.objectId(), stoneConfigValue.x(),
                stoneConfigValue.y(), stoneConfigValue.z(),
                stoneConfigValue.halfExtent(), stoneConfigValue.floatable(),
                stoneConfigValue.density(), stoneConfigValue.buoyancy(),
                stoneConfigValue.drag(), stoneConfigValue.gravity(),
                stoneConfigValue.maxFallSpeed(), stoneConfigValue.resource())) {
            return false
        }
        powerUpWorldValue = PowerUpWorld(powerUpMaximumDefinitions())
        if (!powerUpWorldValue.add(coffeeMugConfigValue.definition()) ||
            !powerUpWorldValue.add(jetpackConfigValue.definition()) ||
            !powerUpWorldValue.add(megaphoneConfigValue.definition()) ||
            !powerUpWorldValue.add(scubaKitConfigValue.definition()) ||
            !powerUpWorldValue.add(watermelonConfigValue.definition()) ||
            !powerUpWorldValue.add(woolBallConfigValue.definition())) {
            return false
        }
        if (!oxygenMeterValue.configure(
                liquidPhysicsValue.oxygenCapacity(),
                liquidPhysicsValue.oxygenDrainPerTick(),
                liquidPhysicsValue.oxygenRecoveryPerTick()) ||
            !waterSplashVfxValue.clear()) {
            return false
        }
        playerOneUnderwaterValue = false
        playerTwoUnderwaterValue = false
        playerOneLiquidBodyValue = 0
        playerTwoLiquidBodyValue = 0
        return true
    }

    Bool prepareGooseSession() {
        if (!prepareLiquidContent()) { return false }
        if (!interactionSession.loadAuthoredBroadPhase(
                arena.authoredCollision()) ||
            !interactionSession.enableFpsMovement(true) ||
            !interactionSession.configureLiquid(
                liquidWorldValue, liquidPhysicsValue.movementProfile(),
                liquidPhysicsValue.actorHeight()) ||
            !interactionSession.configurePowerUps(powerUpWorldValue) ||
            !interactionSession.configurePlayerAnimal(
                1, localAnimalKindValue) ||
            !interactionSession.configurePlayerAnimal(
                2, remoteAnimalKindValue) ||
            !interactionSession.configureEnemyRules(320, 35, 15) ||
            !interactionSession.defineEnemyWeapon(7, 10, 0, 20, 1) ||
            !interactionSession.setEnemyWeaponRange(7, 40) ||
            !interactionSession.setEnemyWeaponCooldown(7, 15) ||
            !interactionSession.defineEnemyEncounter(4, 4, 12) ||
            !interactionSession.configureEnemyEncounterZone(
                4, g1ArenaMaxX() / 2, 1, g1ArenaMaxZ() / 2, 140) ||
            !interactionSession.configureEnemySpatialBounds(
                0, -4, 0, g1ArenaMaxX(), g1ArenaMaxY(), g1ArenaMaxZ()) ||
            !interactionSession.definePlayerWeapon(7, 10, 0, 20, 1) ||
            !interactionSession.setPlayerWeaponRange(7, 40) ||
            !interactionSession.addEnemyCombatActor(1, 100, 0) ||
            !interactionSession.addEnemyCombatActor(2, 100, 0) ||
            !interactionSession.equipEnemyCombatWeapon(1, 7) ||
            !interactionSession.equipEnemyCombatWeapon(2, 7) ||
            !interactionSession.defineWorldKey(1, 30, 0, 0, 0) ||
            !interactionSession.defineWorldDoor(
                2, 1, 0, 5, 5, 3, 5, 1, 8) ||
            !interactionSession.start()) {
            return false
        }
        if (interactionSession.connectPlayer() != 1 ||
            interactionSession.connectPlayer() != 2) {
            return false
        }
        if (!interactionSession.addPlayerCombatActor(1, 100, 0) ||
            !interactionSession.addPlayerCombatActor(2, 100, 0) ||
            !interactionSession.equipPlayerCombatWeapon(1, 7) ||
            !interactionSession.equipPlayerCombatWeapon(2, 7)) {
            return false
        }
        if (!interactionSession.setEnemySpatialPosition(1, 40, 1, 60) ||
            !interactionSession.setEnemySpatialPosition(2, 56, 1, 60) ||
            !interactionSession.admitEnemyAt(
                4, 3, 0, 80, 0, 7, 90, 1, 60) ||
            !interactionSession.admitEnemyAt(
                4, 4, 0, 80, 0, 7, 260, 1, 56) ||
            !interactionSession.admitEnemyAt(
                4, 5, 0, 80, 0, 7, 264, 1, 224) ||
            !interactionSession.configureEnemyRole(3, 1, 1, 1, 0) ||
            !interactionSession.configureEnemyRole(4, 1, 1, 1, 0) ||
            !interactionSession.configureEnemyRole(5, 2, 1, 2, 0) ||
            !hud.update(100, 3, 3, 0, true) ||
            !hud.updateEncounterReplication(3, 9, true, 1, 1)) {
            return false
        }
        return true
    }

    Bool resetGooseSession() {
        if (!inputStateValue.clearHeld()) { return false }
        var preservedScale = hud.scalePercent()
        var preservedContrast = hud.highContrast()
        playerAimTargets = BoundedRayTargetWorld(3, 64)
        var preservedMinimap = minimap.visible()
        interactionSession = LoopbackSession(16, 8)
        if (!saveOwner.bind(interactionSession)) {
            return false
        }
        hud = ShooterHud(100, 3)
        if (!hud.setScale(preservedScale) ||
            !hud.setHighContrast(preservedContrast) ||
            !animalMeshes.clear() ||
            !minimap.clear() ||
            !minimap.setVisible(preservedMinimap) ||
            !camera.clearFollowTarget() ||
            !projectileOverlay.clear() ||
            !texturedVfx.clear()) {
            return false
        }
        scoreboardState = MatchScoreboardState(2)
        scoreboardUi.setVisible(false)
        playerKillsOneValue = 0
        playerKillsTwoValue = 0
        playerDeathsOneValue = 0
        playerDeathsTwoValue = 0
        localShotValue = false
        remoteShotValue = false
        localActionButtonsValue = 0
        remoteActionButtonsValue = 0
        for (var flashIndex = 0;
             flashIndex < damageFlashTicks.length;
             flashIndex = flashIndex + 1) {
            damageFlashTicks[flashIndex] = 0
        }
        if (!prepareGooseSession() ||
            !saveOwner.recoverAndRestore()) {
            return false
        }
        return true
    }
    Bool loadModel(
        BoundedExternalGlbModelReader reader, Int model
    ) {
        var source = modelAssets.bytes(model)
        return source.length > 0 &&
            reader.read(source, model) && reader.valid()
    }

    Bool stageModelTexture(
        BoundedExternalGlbModelReader reader, Int model
    ) {
        if (!reader.valid()) { return false }
        var textureOffset = reader.textureOffset()
        var textureLength = reader.textureLength()
        if (textureOffset < 0 || textureLength <= 0) {
            return true
        }
        if (reader.textureWidth() <= 0 || reader.textureHeight() <= 0 ||
            !kookie_gpu_model_texture_stage_begin(model, textureLength)) {
            return false
        }
        for (var index = 0; index < textureLength; index = index + 1) {
            var value = reader.textureByte(index)
            if (value < 0 ||
                !kookie_gpu_model_texture_stage_byte(model, index, value)) {
                return false
            }
        }
        return kookie_gpu_model_texture_stage_commit(model)
    }

    Bool prepareModelAssets() {
        var modelsAvailable =
            modelAssets.available(kookieModelGoose()) &&
            modelAssets.available(kookieModelCat()) &&
            loadModel(gooseModelReader, kookieModelGoose()) &&
            loadModel(catModelReader, kookieModelCat())
        if (!modelsAvailable) { return false }
        if (!gooseModelReader.authoredAnimationAvailable() ||
            !catModelReader.authoredAnimationAvailable()) {
            println("KOOKIE authored GLB animation parse failed")
            println(gooseModelReader.authoredAnimationChannelCount())
            println(catModelReader.authoredAnimationChannelCount())
            return false
        }
        gooseModelVertexCountValue = gooseModelReader.vertexCount()
        catModelVertexCountValue = catModelReader.vertexCount()
        if (gooseModelVertexCountValue != 708 ||
            catModelVertexCountValue != 2400 ||
            gooseModelVertexCountValue % 3 != 0 ||
            catModelVertexCountValue % 3 != 0) {
            return false
        }
        return stageModelTexture(gooseModelReader, kookieModelGoose()) &&
            stageModelTexture(catModelReader, kookieModelCat())
    }
    Bool prepareWorldTexture() {
        var gooseWidth = gooseModelReader.textureWidth()
        var gooseHeight = gooseModelReader.textureHeight()
        if (!gooseModelReader.valid() || gooseWidth <= 0 || gooseHeight <= 0) {
            gooseWidth = 0
            gooseHeight = 0
        }
        var catWidth = catModelReader.textureWidth()
        var catHeight = catModelReader.textureHeight()
        if (!catModelReader.valid() || catWidth <= 0 || catHeight <= 0) {
            catWidth = 0
            catHeight = 0
        }
        if (!worldTextureAsset.buildWithVfx(
                gooseWidth, gooseHeight, catWidth, catHeight,
                nativeAnimalModelsValue) ||
            !kookie_gpu_world_texture_stage_begin(
                worldTextureAsset.width(), worldTextureAsset.height(),
                worldTextureAsset.vfxX(),
                worldTextureAsset.gooseX(), worldTextureAsset.gooseY(),
                worldTextureAsset.gooseWidth(), worldTextureAsset.gooseHeight(),
                worldTextureAsset.catX(), worldTextureAsset.catY(),
                worldTextureAsset.catWidth(), worldTextureAsset.catHeight())) {
            return false
        }
        for (var index = 0;
             index < worldTextureAsset.wordCount();
             index = index + 1) {
            if (!kookie_gpu_world_texture_stage_word(
                    index, worldTextureAsset.word(index))) {
                return false
            }
        }
        return kookie_gpu_world_texture_stage_commit()
    }



    Bool prepare() {
        var modelsRequired = modelAssets.required()
        var modelsAvailable = prepareModelAssets()
        nativeAnimalModelsValue = modelsAvailable
        if (modelsRequired && !modelsAvailable) {
            println("KOOKIE prototype animal models required but unavailable")
            return false
        }
        if (!prepareWorldTexture()) {
            return false
        }
        if (!scenario.run()) {
            return false
        }
        println("KOOKIE D1 authoritative gameplay verified")
        if (!kutterScenario.run() ||
            !hud.updateKutterPublication(
                kutterScenario.publicationStatus(),
                kutterScenario.publishedGeneration(),
                kutterScenario.publicationDiagnostic(),
                kutterScenario.completed()) ||
            !camera.applyLook(20, -20) ||
            !prepareGooseSession()) {
            return false
        }
        if (!saveOwner.recoverAndRestore()) {
            return false
        }
        var blocked = interactionSession.queryWorldDoorPath(
            SpatialPoint(-5, 5, 5), SpatialPoint(5, 5, 5))
        var above = interactionSession.queryWorldDoorPath(
            SpatialPoint(-5, 12, 5), SpatialPoint(5, 12, 5))
        if (!blocked.accepted() || !blocked.collided() ||
            !above.accepted() || above.collided()) {
            return false
        }
        if (nativeAnimalModelsValue) {
            println("KOOKIE G1 native animal mesh coverage verified")
        }
        return true
    }

    Bool uploadSceneVertex(FrameStaging frame, Int index) {
        return kookie_gpu_scene_push_vertex_resource(
            frame.resourceAt(index), frame.xAt(index), frame.yAt(index),
            frame.depthAt(index), frame.uAt(index), frame.vAt(index))
    }


    Bool uploadTextRuns(FrameStaging frame) {
        for (var run = 0; run < frame.textRuns(); run = run + 1) {
            if (!kookie_gpu_scene_text_run_begin(
                    frame.textFontAt(run), frame.textColorAt(run),
                    frame.textLeftAt(run), frame.textBottomAt(run),
                    frame.textScaleAt(run))) {
                return false
            }
            for (var index = 0;
                index < frame.textCodepointCountAt(run); index = index + 1) {
                if (!kookie_gpu_scene_text_codepoint(
                        frame.textCodepointAt(run, index))) {
                    return false
                }
            }
            if (!kookie_gpu_scene_text_run_commit()) { return false }
        }
        return true
    }

    Bool uploadScalar(FrameStaging frame) {
        var index = 0
        while (index < frame.stagedCount()) {
            var span = frame.primitiveSpanAt(index)
            if (span == 6 || span == 3) {
                for (var vertex = 0; vertex < span; vertex = vertex + 1) {
                    if (!uploadSceneVertex(frame, index + vertex)) {
                        println("KOOKIE gameplay primitive upload failed")
                        println(index)
                        return false
                    }
                }
                index = index + span
                continue
            }
            if (!uploadSceneVertex(frame, index)) {
                println("KOOKIE gameplay vertex upload failed")
                println(index)
                return false
            }
            index = index + 1
        }
        return true
    }

    Bool upload(FrameStaging frame) {
        var generation = kookie_gpu_reload_pending_generation()
        if (generation == 0) {
            generation = kookie_gpu_reload_active_generation()
        }
        if (!kookie_gpu_scene_encode_batch(frame, generation) &&
            !uploadScalar(frame)) {
            return false
        }
        return uploadTextRuns(frame)
    }

    Bool uploadWorldVertex(FrameStaging frame, Int index) {
        var resource = frame.resourceAt(index)
        var textureU = 0
        var textureV = 0
        if (resource >= liquidWaterVertexResourceBase() &&
            resource < liquidWaterVertexResourceBase() + liquidMaximumStyles()) {
            var style = resource - liquidWaterVertexResourceBase()
            textureU = liquidWaterMarkerCoordinateBase() +
                style * liquidWaterMarkerCoordinateStride()
            textureV = liquidWaterMarkerCoordinateBase()
        } else {
            textureU = worldTextureAsset.textureU(resource, frame.uAt(index))
            textureV = worldTextureAsset.textureV(resource, frame.vAt(index))
        }
        if (textureU < 0 || textureV < 0 ||
            textureU > liquidWaterMarkerCoordinateLimit() ||
            textureV > liquidWaterMarkerCoordinateLimit()) {
            return false
        }
        return kookie_gpu_world_push_vertex_uv(
            frame.xAt(index), frame.yAt(index), frame.zAt(index),
            textureU, textureV)
    }

    Bool uploadWorld(FrameStaging frame) {
        for (var index = 0; index < frame.stagedCount(); index = index + 1) {
            if (!uploadWorldVertex(frame, index)) {
                println("KOOKIE gameplay world vertex upload failed")
                println(index)
                println(frame.resourceAt(index))
                println(frame.xAt(index))
                println(frame.yAt(index))
                println(frame.zAt(index))
                return false
            }
        }
        return true
    }
    Bool pushBlobShadowTriangle(
        Int centerX, Int centerZ,
        Int ax, Int az, Int au, Int av,
        Int bx, Int bz, Int bu, Int bv
    ) {
        return shadowFrame.pushWorldVertex(
                8, centerX, 1, centerZ, 50, 50) &&
            shadowFrame.pushWorldVertex(
                8, ax, 1, az, au, av) &&
            shadowFrame.pushWorldVertex(
                8, bx, 1, bz, bu, bv)
    }
    Bool stageBlobShadows(Int frame) {
        if (!shadowFrame.begin(frame)) { return false }
        for (var index = 0; index < animalMeshes.actorCapacity();
             index = index + 1) {
            if (!animalMeshes.actorCurrentAt(index)) { continue }
            var centerX = animalMeshes.actorXAt(index)
            var centerZ = animalMeshes.actorZAt(index)
            if (!pushBlobShadowTriangle(
                    centerX, centerZ,
                    centerX - 4, centerZ, 0, 50,
                    centerX - 3, centerZ - 2, 15, 20) ||
                !pushBlobShadowTriangle(
                    centerX, centerZ,
                    centerX - 3, centerZ - 2, 15, 20,
                    centerX, centerZ - 3, 50, 0) ||
                !pushBlobShadowTriangle(
                    centerX, centerZ,
                    centerX, centerZ - 3, 50, 0,
                    centerX + 3, centerZ - 2, 85, 20) ||
                !pushBlobShadowTriangle(
                    centerX, centerZ,
                    centerX + 3, centerZ - 2, 85, 20,
                    centerX + 4, centerZ, 100, 50) ||
                !pushBlobShadowTriangle(
                    centerX, centerZ,
                    centerX + 4, centerZ, 100, 50,
                    centerX + 3, centerZ + 2, 85, 80) ||
                !pushBlobShadowTriangle(
                    centerX, centerZ,
                    centerX + 3, centerZ + 2, 85, 80,
                    centerX, centerZ + 3, 50, 100) ||
                !pushBlobShadowTriangle(
                    centerX, centerZ,
                    centerX, centerZ + 3, 50, 100,
                    centerX - 3, centerZ + 2, 15, 80) ||
                !pushBlobShadowTriangle(
                    centerX, centerZ,
                    centerX - 3, centerZ + 2, 15, 80,
                    centerX - 4, centerZ, 0, 50)) {
                return false
            }
        }
        return shadowFrame.publish()
    }
