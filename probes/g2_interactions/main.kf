import core
import session

Bool verifyWorldProgression() {
    var world = BoundedInteractionWorld(6, 100)
    assert(!world.defineDoor(2, 1, 0, 0, 0, 1, 2, 1, 1))
    assert(world.defineKey(1, 0, 0, 0, 1))
    assert(!world.defineSecret(1, 0, 0, 0, 1) && !world.defineKey(9, 101, 0, 0, 1))
    assert(world.defineDoor(2, 1, 0, 0, 0, 1, 2, 1, 1))
    assert(world.defineSecret(3, 0, 0, 0, 1) && world.defineSecret(4, 0, 0, 0, 1))
    assert(!world.defineExit(5, 1, 2, 0, 0, 0, 1))
    assert(!world.defineExit(5, 2, 3, 0, 0, 0, 1))
    assert(world.defineExit(5, 2, 2, 0, 0, 0, 1) && world.defineKey(6, 0, 0, 0, 1))
    assert(!world.defineKey(7, 0, 0, 0, 1) && !world.interact(1, 0, 0, 0))
    assert(world.seal() && !world.seal())
    assert(!world.interact(2, 0, 0, 0) && !world.interact(1, 0, 0, 2) && world.revision() == 0)
    assert(world.interact(1, -1, 1, 1) && world.interact(2, 0, 0, 0))
    assert(world.activated(1) && world.activated(2) && !world.interact(1, 0, 0, 0))
    assert(world.interact(3, 0, 0, 0) && !world.interact(5, 0, 0, 0))
    assert(world.interact(4, 0, 0, 0) && world.secretCount() == 2)
    assert(world.interact(5, 0, 0, 0) && world.completed() && world.revision() == 5)
    assert(!world.interact(6, 0, 0, 0) && !world.activated(6) && world.revision() == 5)
    return true
}

Bool verifyWorldRestore() {
    var world = BoundedInteractionWorld(4, 100)
    assert(world.defineKey(10, 0, 0, 0, 0) && world.defineDoor(20, 10, 0, 0, 0, 1, 2, 1, 0))
    assert(world.defineSecret(30, 0, 0, 0, 0) && world.defineExit(40, 20, 1, 0, 0, 0, 0))
    assert(world.seal() && world.interact(10, 0, 0, 0) && world.interact(20, 0, 0, 0))
    var state = new Int[world.replayStateLength()]
    assert(world.encodeReplayState(state))
    assert(world.interact(30, 0, 0, 0) && world.interact(40, 0, 0, 0))
    state[11] = 0
    assert(!world.restoreReplayState(state) && world.completed() && world.secretCount() == 1,
        "invalid door/key dependency must reject without changing live state")
    state[11] = 1
    state[2] = 0
    assert(!world.restoreReplayState(state) && world.completed(), "replay cannot unseal authored content")
    state[2] = 1
    state[7] = 1
    assert(!world.restoreReplayState(state) && world.completed(), "replay cannot replace authored geometry")
    state[7] = 0
    assert(world.restoreReplayState(state) && !world.completed() && world.secretCount() == 0)
    assert(world.activated(10) && world.activated(20) && !world.activated(30) && world.revision() == 2)
    return true
}

Bool verifyCooperativeSession() {
    var session = LoopbackSession(4, 2)
    assert(session.defineWorldKey(1, 0, 0, 0, 0))
    assert(session.defineWorldDoor(2, 1, 0, 0, 0, 1, 2, 1, 0))
    assert(session.defineWorldSecret(3, 0, 0, 0, 0))
    assert(session.defineWorldExit(4, 2, 1, 0, 0, 0, 0))
    assert(session.start() && session.connectPlayer() == 1 && session.connectPlayer() == 2)
    assert(!session.defineWorldKey(5, 0, 0, 0, 0))
    assert(!session.receiveInteraction(0, 1, 1, 1) && !session.receiveInteraction(3, 1, 1, 1))
    assert(!session.receiveInteraction(1, 0, 1, 1) && !session.receiveInteraction(1, 5, 1, 1))
    assert(session.receiveInteraction(1, 1, 1, 1) && session.receiveInteraction(2, 1, 1, 2))
    assert(!session.receiveInteraction(1, 1, 2, 3) && !session.worldInteractionActive(1))
    assert(session.advance(16667) == 1)
    assert(session.lastInteractionAccepted(1) && session.lastInteractionAccepted(2),
        "same-tick key then door must use deterministic player ordering")
    assert(session.clientWorldInteractionActive(1) && session.clientWorldInteractionActive(2))
    assert(!session.receiveInteraction(1, 2, 1, 3), "stale interaction sequence must reject")
    assert(session.receiveInteraction(1, 2, 2, 3) && session.receiveInteraction(2, 2, 2, 3))
    assert(session.advance(16667) == 1)
    assert(session.lastInteractionAccepted(1) && !session.lastInteractionAccepted(2))
    assert(session.worldSecretCount() == 1 && session.clientWorldSecretCount() == 1,
        "two players must not duplicate secret credit")
    assert(session.receiveInteraction(2, 3, 3, 4) && session.advance(16667) == 1)
    assert(session.levelCompleted() && session.clientLevelCompleted())
    assert(session.worldInteractionRevision() == 4 && session.clientWorldInteractionRevision() == 4)
    assert(!session.receiveInteraction(1, 4, 3, 1), "completed level must reject further interactions")
    return true
}

Bool verifyInteractionAdmission() {
    var session = LoopbackSession(4, 2)
    assert(session.defineWorldKey(1, 4, 0, 0, 0) && session.start() && session.connectPlayer() == 1)
    assert(!session.receiveInteraction(2, 1, 1, 1), "unconnected player must not interact")
    assert(session.receiveInteraction(1, 1, 1, 1) && session.advance(16667) == 1)
    assert(!session.lastInteractionAccepted(1) && !session.worldInteractionActive(1),
        "server position, not client target selection, determines reach")
    assert(session.receiveInteraction(1, 2, 2, 1) && session.applyPlayerFocus(1, 0))
    assert(!session.receiveInteraction(1, 2, 3, 1) && session.applyPlayerFocus(1, 1))
    assert(!session.receiveInteraction(1, 2, 2, 1), "focus reset must retain sequence watermark")
    assert(session.receiveInteraction(1, 2, 3, 1) && session.setPaused(1))
    assert(session.advance(1000000) == 0 && !session.receiveInteraction(1, 2, 4, 1))
    assert(session.setPaused(0) && session.receiveInput(1, 2, 1, 4, 0, 0, 0, 0, 0))
    assert(session.advance(16667) == 1 && !session.worldInteractionActive(1),
        "focus loss and pause must discard queued interactions")
    assert(session.receiveInteraction(1, 3, 4, 1) && session.advance(16667) == 1)
    assert(session.lastInteractionAccepted(1) && session.clientWorldInteractionActive(1))
    return true
}

Bool verifyInteractionCheckpoint() {
    var session = LoopbackSession(4, 2)
    assert(session.defineWorldKey(1, 0, 0, 0, 0))
    assert(session.defineWorldDoor(2, 1, 0, 0, 0, 1, 2, 1, 0))
    assert(session.defineWorldSecret(3, 0, 0, 0, 0))
    assert(session.start() && session.connectPlayer() == 1)
    assert(session.receiveInteraction(1, 1, 1, 1) &&
        session.advance(16667) == 1)
    assert(session.receiveInteraction(1, 2, 2, 2))
    var timeline = BoundedReplayTimeline(4, 2)
    assert(session.appendReplayCheckpointBundle(timeline, 1, 71))
    assert(session.advance(16667) == 1 &&
        session.worldInteractionActive(2))
    assert(session.receiveInteraction(1, 3, 3, 3) &&
        session.advance(16667) == 1)
    assert(session.appendReplayCheckpointBundle(timeline, 3, 73))
    var store = BoundedReplayBundleFileStore(4)
    assert(store.writeTimeline(
        "interaction-replay.dat", timeline, 1, 1, 99))
    var loaded = BoundedReplayTimeline(4, 2)
    assert(store.readTimeline("interaction-replay.dat", loaded))
    assert(session.applyReplayCheckpointBundle(loaded, 1))
    assert(session.currentServerTick() == 1 &&
        session.worldInteractionActive(1))
    assert(!session.worldInteractionActive(2) &&
        !session.clientWorldInteractionActive(2))
    assert(session.worldSecretCount() == 0 &&
        session.clientWorldSecretCount() == 0)
    assert(!session.receiveInteraction(1, 2, 3, 3),
        "restored pending command must retain its queue slot")
    assert(session.advance(16667) == 1 &&
        session.worldInteractionActive(2))
    assert(session.lastInteractionTarget(1) == 2 &&
        session.lastInteractionTick(1) == 2)
    assert(!session.receiveInteraction(1, 3, 2, 3),
        "restored sequence watermark must reject duplicates")
    assert(session.applyReplayCheckpointBundle(loaded, 3) &&
        session.worldSecretCount() == 1,
        "second checkpoint must use independent primary and sidecar strides")
    var state = new Int[session.replayCheckpointLength()]
    assert(session.encodeReplayCheckpoint(state))
    var worldOffset = state.length -
        session.worldInteractionReplayStateLength() - 16
    state[worldOffset + 11] = 0
    var invalid = BoundedReplayTimeline(1, 1)
    assert(invalid.appendCheckpointSnapshot(3, 73, state))
    assert(!session.applyReplayCheckpoint(invalid, 3) &&
        session.worldSecretCount() == 1)
    assert(session.worldInteractionActive(1) &&
        session.worldInteractionActive(2))
    return true
}

Bool verifySpatialCheckpointRows() {
    var world = EnemySpatialWorld(2, 100)
    assert(world.configureBounds(0, 0, 0, 100, 100, 100))
    assert(world.setPosition(7, 1, 2, 3) && world.setPosition(8, 4, 5, 6))
    var state = new Int[world.replayStateLength()]
    assert(world.encodeReplayState(state))
    assert(world.setPosition(7, 9, 9, 9) && world.setPosition(8, 9, 9, 9))
    assert(world.restoreReplayState(state))
    assert(world.positionX(7) == 1 && world.positionY(7) == 2 && world.positionZ(7) == 3 &&
        world.positionX(8) == 4 && world.positionY(8) == 5 && world.positionZ(8) == 6,
        "spatial checkpoint rows must not overwrite the preceding actor Z coordinate")
    state[1] = 1
    assert(!world.restoreReplayState(state) && world.positionZ(7) == 3 && world.positionZ(8) == 6,
        "overlapping v1 spatial records are not recoverable and must leave live state intact")
    return true
}

Bool verifyCatchupTicks() {
    var session = LoopbackSession(4, 2)
    assert(session.start() && session.connectPlayer() == 1)
    assert(session.definePlayerWeapon(9, 2, 1, 1, 4, 1, 20))
    assert(session.addPlayerCombatActor(1, 20, 0) && session.equipPlayerCombatWeapon(1, 9))
    assert(session.receiveInput(1, 3, 1, 0, 0, 0, 0, 1, 0))
    assert(session.advance(66668) == 4 && session.dequeuePlayerWeaponPresentation())
    assert(session.lastPlayerWeaponPresentation().nextReadyTick() == 4,
        "catch-up fire cooldown must start at the command's simulation tick, not the frame's final tick")
    assert(session.replayPresentationAt(0).tick() == 3,
        "replay fire event must preserve the simulation tick")
    return true
}

Bool verifyDoorArenaIntegration() {
    var session = LoopbackSession(4, 2)
    assert(session.defineWorldKey(1, 0, 0, 0, 0))
    assert(session.defineWorldDoor(2, 1, 2, 0, 0, 1, 2, 1, 2))
    assert(session.start() && session.connectPlayer() == 1)
    var blocked = session.queryWorldDoorPath(
        SpatialPoint(0, 0, 0), SpatialPoint(4, 0, 0))
    var above = session.queryWorldDoorPath(
        SpatialPoint(0, 4, 0), SpatialPoint(4, 4, 0))
    var around = session.queryWorldDoorPath(
        SpatialPoint(0, 0, 3), SpatialPoint(4, 0, 3))
    assert(blocked.accepted() && blocked.collided() &&
        above.accepted() && !above.collided() &&
        around.accepted() && !around.collided(),
        "closed door collision must use its complete authored 3D volume")
    assert(session.worldInteractionRenderVertexCount() == 36)
    var camera = CameraState(-450, 450)
    var closedGeometry = FrameStaging(36)
    assert(session.stageWorldInteractionGeometry(
        closedGeometry, 1, 7, camera))
    assert(closedGeometry.stagedCount() == 36 &&
        closedGeometry.scalarWrites() == 180)
    var closedChecksum = closedGeometry.checksum()
    assert(session.receiveInteraction(1, 1, 1, 1))
    assert(session.receiveInput(1, 1, 1, 4, 0, 0, 0, 0, 0))
    assert(session.advance(16667) == 1 && session.serverPosition(1) == 0,
        "closed authored doors must block authoritative movement across their plane")
    assert(session.receiveInteraction(1, 2, 2, 2) && session.advance(16667) == 1)
    assert(session.worldInteractionActive(2))
    var opened = session.queryWorldDoorPath(
        SpatialPoint(0, 0, 0), SpatialPoint(4, 0, 0))
    assert(opened.accepted() && !opened.collided(),
        "open doors must leave their complete collision volume")
    assert(session.receiveInput(1, 3, 2, 4, 0, 0, 0, 0, 0))
    assert(session.advance(16667) == 1 && session.serverPosition(1) == 4,
        "opening the door must update the authoritative collision path")
    var openGeometry = FrameStaging(36)
    assert(session.stageWorldInteractionGeometry(
        openGeometry, 2, 7, camera))
    assert(openGeometry.checksum() != closedChecksum,
        "client door cuboid must visibly move when opened")
    assert(!session.stageWorldInteractionGeometry(
            openGeometry, 2, 7, camera),
        "published frame ownership must prevent duplicate staging")
    return true
}

Bool verifyClientReconnectAndStaleInput() {
    var session = LoopbackSession(4, 2)
    assert(session.start() && session.connectPlayer() == 1 && session.connectPlayer() == 2)
    assert(session.receiveInput(2, 1, 1, 2, 0, 0, 0, 0, 0))
    assert(session.advance(16667) == 1 && session.serverPosition(2) == 2)
    assert(session.disconnectPlayer(2, 1) && session.playerCount() == 1 &&
        !session.playerConnected(2))
    assert(!session.receiveInput(2, 2, 2, 2, 0, 0, 0, 0, 0),
        "disconnected clients cannot submit input")
    assert(session.connectPlayer() == 2 && session.playerConnected(2) &&
        session.serverPosition(2) == 2 && session.clientPosition(2) == 2,
        "reconnect must preserve authoritative position")
    assert(session.receiveInput(2, 2, 1, 1, 0, 0, 0, 0, 0),
        "reconnect must start a fresh input sequence epoch")
    assert(session.advance(16667) == 1 && session.serverPosition(2) == 3)
    assert(session.receiveInput(2, 3, 2, 1, 0, 0, 0, 0, 0))
    assert(session.disconnectPlayer(2, 2) && session.connectPlayer() == 2)
    assert(session.advance(16667) == 1 && session.serverPosition(2) == 3,
        "disconnect must discard pending stale movement")
    assert(session.receiveInput(2, 4, 1, -1, 0, 0, 0, 0, 0) &&
        session.advance(16667) == 1 && session.serverPosition(2) == 2)
    return true
}

Bool verifyCheckpointInitialization() {
    var inventory = BoundedItemInventory(1, 2)
    assert(inventory.addItem(500, 1))
    var state = new Int[inventory.replayStateLength()]
    for (var index = 0; index < state.length; index = index + 1) {
        state[index] = 1000001
    }
    assert(inventory.encodeReplayState(state))
    var timeline = BoundedReplayTimeline(1, 1)
    assert(timeline.appendCheckpointSnapshot(0, 1, state),
        "unused inventory roll fields must not leak stale storage into checkpoint files")
    var world = BoundedTriangleCollection(2, 20)
    assert(world.configureBounds(0, 0, 0, 10, 10, 10))
    assert(world.addTriangle(0, 0, 0, 1, 0, 0, 0, 1, 0))
    var geometry = new Int[world.replayStateLength()]
    for (var index = 0; index < geometry.length; index = index + 1) {
        geometry[index] = 1000001
    }
    assert(world.encodeReplayState(geometry) && timeline.reset())
    assert(timeline.appendCheckpointSnapshot(0, 1, geometry),
        "unused triangle rows must not leak stale storage into checkpoint files")
    return true
}

Bool verifyConsumedInteractionReplay() {
    var session = LoopbackSession(4, 2)
    assert(session.defineWorldKey(10, 2, 0, 0, 0))
    assert(session.defineWorldDoor(20, 10, 4, 0, 0, 1, 2, 1, 4))
    assert(session.defineWorldSecret(30, 2, 0, 0, 0))
    assert(session.defineWorldExit(40, 20, 1, 0, 0, 0, 2))
    assert(session.start() && session.connectPlayer() == 1 && session.connectPlayer() == 2)
    assert(session.definePlayerWeapon(9, 4, 0, 0, 4, 1, 20))
    assert(session.addPlayerCombatActor(1, 20, 0) && session.equipPlayerCombatWeapon(1, 9))
    var timeline = BoundedReplayTimeline(8, 2)
    assert(session.appendReplayCheckpointBundle(timeline, 0, 90))
    assert(session.setInputReplayEnabled(true))
    assert(session.receiveInteraction(1, 1, 1, 10) && session.advance(16667) == 1)
    assert(!session.lastInteractionAccepted(1), "out-of-reach attempts must remain replayable")
    assert(session.receiveInput(1, 2, 1, 2, 0, 0, 0, 1, 0))
    assert(session.receiveInteraction(1, 2, 2, 10) && session.receiveInteraction(2, 2, 1, 20))
    assert(session.appendReplayCheckpointBundle(timeline, 1, 91))
    assert(!session.appendReplayCheckpointBundle(timeline, 0, 92), "checkpoints cannot mislabel live ticks")
    assert(session.advance(16667) == 1 && session.worldInteractionActive(20))
    assert(session.receiveInteraction(1, 3, 3, 30) && session.advance(16667) == 1)
    assert(session.receiveInteraction(2, 4, 2, 40) && session.advance(16667) == 1)
    assert(session.levelCompleted() && session.interactionReplayCount() == 5)
    assert(session.exportInteractionReplay(timeline))
    while (session.playPlayerReplay(1)) {
        assert(timeline.append(session.lastPlayerReplay(1)))
    }
    assert(session.setInputReplayEnabled(false))
    assert(!session.queueReplayCommands(1, timeline, 4), "movement-only playback must not drop interactions")
    var store = BoundedReplayBundleFileStore(8)
    assert(store.writeTimeline("consumed-interactions.dat", timeline, 1, 7, 33))
    var loaded = BoundedReplayTimeline(8, 2)
    assert(store.readTimeline("consumed-interactions.dat", loaded) && loaded.interactionCount() == 5)
    assert(session.replayTimelineToTick(1, loaded, 1))
    assert(!session.worldInteractionActive(10) && !session.lastInteractionAccepted(1))
    assert(!session.receiveInteraction(1, 2, 3, 30), "checkpoint pending commands retain their queue slots")
    for (var replay = 0; replay < 2; replay = replay + 1) {
        assert(session.replayTimelineToTick(1, loaded, 4))
        assert(session.currentServerTick() == 4 && session.serverPosition(1) == 2)
        assert(session.worldInteractionActive(10) && session.worldInteractionActive(20))
        assert(session.worldSecretCount() == 1 && session.levelCompleted() && session.clientLevelCompleted())
        assert(session.lastInteractionTick(2) == 4 && session.lastInteractionAccepted(2))
        assert(session.dequeuePlayerWeaponPresentation())
        assert(session.lastPlayerWeaponPresentation().sequence() == 1 &&
            session.lastPlayerWeaponPresentation().magazine() == 3,
            "repeated playback must restore ammunition and presentation sequence, not reuse live queues")
    }
    assert(!session.replayTimelineToTick(1, loaded, 5000) && session.currentServerTick() == 4)
    return true
}

Bool verifyHeldInputReplay() {
    var session = LoopbackSession(4, 2)
    assert(session.start() && session.connectPlayer() == 1)
    assert(session.definePlayerWeapon(9, 4, 0, 0, 4, 1, 20))
    assert(session.addPlayerCombatActor(1, 20, 0) && session.equipPlayerCombatWeapon(1, 9))
    assert(session.setInputReplayEnabled(true))
    assert(session.receiveInput(1, 1, 1, 0, 0, 0, 0, 1, 0))
    assert(session.receiveInput(1, 1, 2, 1, 0, 0, 0, 1, 0))
    assert(session.advance(16667) == 1 && session.dequeuePlayerWeaponPresentation())
    var timeline = BoundedReplayTimeline(2, 1)
    assert(session.appendReplayCheckpointBundle(timeline, 1, 1))
    assert(session.advance(16667) == 1 && session.serverPosition(1) == 1)
    assert(!session.dequeuePlayerWeaponPresentation())
    while (session.playPlayerReplay(1)) {
        assert(timeline.append(session.lastPlayerReplay(1)))
    }
    assert(session.setInputReplayEnabled(false) && session.replayTimelineToTick(1, timeline, 2))
    assert(session.serverPosition(1) == 1, "replay must schedule movement at its consumed tick")
    assert(!session.dequeuePlayerWeaponPresentation(), "checkpoint seek must not turn held fire into a new press")
    return true
}

Bool verifyInteractionCaptureReservation() {
    var session = LoopbackSession(2, 2)
    assert(session.defineWorldKey(1, 10, 0, 0, 0))
    assert(session.start() && session.connectPlayer() == 1 && session.connectPlayer() == 2)
    assert(session.setInputReplayEnabled(true))
    for (var tick = 1; tick <= 63; tick = tick + 1) {
        assert(session.receiveInteraction(1, tick, tick, 1) && session.advance(16667) == 1)
    }
    assert(session.receiveInteraction(1, 64, 64, 1))
    assert(!session.receiveInteraction(2, 64, 1, 1),
        "the final recording slot must be reserved before another player is admitted")
    assert(session.advance(16667) == 1 && session.interactionReplayCount() == 64)
    assert(!session.receiveInteraction(2, 65, 1, 1))
    assert(session.setInputReplayEnabled(false) && session.receiveInteraction(2, 65, 1, 1),
        "recording overflow must not advance rejected player sequence watermarks")
    return true
}

Bool writeReplayFixture(String path, Int[] words) {
    var bytes = new Int[words.length * 6]
    for (var index = 0; index < words.length; index = index + 1) {
        var value = words[index] * 2
        if (words[index] < 0) {
            value = -value - 1
        }
        for (var digit = 0; digit < 6; digit = digit + 1) {
            bytes[index * 6 + digit] = value % 64
            value = value / 64
        }
    }
    var file = File(path)
    return file.writeBytes(bytes)
}

Bool verifyReplayFileBoundaries() {
    var timeline = BoundedReplayTimeline(2, 1)
    var initial = new Int[1]
    initial[0] = 4
    assert(timeline.setInitialSnapshot(initial))
    assert(timeline.append(InputCommand(2, 1, 2, 0, 0, 0, 0, 0)))
    assert(timeline.appendInteraction(2, 1, 1, 10))
    var store = BoundedReplayBundleFileStore(2)
    assert(store.writeTimeline("replay-boundaries.dat", timeline, 1, 1, 7))
    var words = store.readWords("replay-boundaries.dat")
    var target = BoundedReplayTimeline(2, 1)
    initial[0] = 9
    assert(target.setInitialSnapshot(initial) && target.appendInteraction(1, 2, 1, 99))
    words[18] = 3
    assert(writeReplayFixture("replay-boundaries.dat", words))
    assert(!store.readTimeline("replay-boundaries.dat", target))
    assert(target.initialSnapshotValue(0) == 9 && target.interactionAt(0).targetId() == 99)
    words[18] = 1
    var truncated = new Int[words.length - 1]
    for (var index = 0; index < truncated.length; index = index + 1) {
        truncated[index] = words[index]
    }
    assert(writeReplayFixture("replay-boundaries.dat", truncated))
    assert(!store.readTimeline("replay-boundaries.dat", target) && target.initialSnapshotValue(0) == 9)
    var trailing = new Int[words.length + 1]
    for (var index = 0; index < words.length; index = index + 1) {
        trailing[index] = words[index]
    }
    trailing[words.length] = 0
    assert(writeReplayFixture("replay-boundaries.dat", trailing))
    assert(!store.readTimeline("replay-boundaries.dat", target))
    var legacy = new Int[9]
    legacy[0] = 22557799
    legacy[1] = 1
    legacy[2] = 1
    legacy[3] = 1
    legacy[4] = 7
    legacy[5] = 0
    legacy[6] = 0
    legacy[7] = 1
    legacy[8] = 42
    assert(writeReplayFixture("replay-boundaries.dat", legacy) && store.readTimeline("replay-boundaries.dat", target))
    assert(target.interactionCount() == 0 && target.initialSnapshotValue(0) == 42,
        "genuine v1 files must replace interaction history with an empty log")
    return true
}

Bool verifyLevelSaveIdentity() {
    var source = BoundedInteractionWorld(4, 100)
    assert(source.defineKey(10, 0, 0, 0, 0) && source.defineDoor(20, 10, 0, 0, 0, 1, 2, 1, 0))
    assert(source.defineSecret(30, 0, 0, 0, 0) && source.defineExit(40, 20, 1, 0, 0, 0, 0))
    assert(source.seal() && source.interact(10, 0, 0, 0) && source.interact(20, 0, 0, 0))
    var sections = BoundedSaveSections(12, 160)
    assert(sections.setRevision(7) && source.encodeLevelProgression(sections, 100, 3))
    var target = BoundedInteractionWorld(4, 100)
    assert(target.defineSecret(30, 0, 0, 0, 0) && target.defineKey(10, 0, 0, 0, 0))
    assert(target.defineDoor(20, 10, 0, 0, 0, 1, 2, 1, 0) && target.defineExit(40, 20, 1, 0, 0, 0, 0))
    assert(target.seal() && target.restoreLevelProgression(sections, 100, 3))
    assert(target.activated(10) && target.activated(20) && !target.activated(30),
        "stable IDs, not authoring order, identify persisted interactions")
    assert(!target.restoreLevelProgression(sections, 101, 3) && !target.restoreLevelProgression(sections, 100, 4))
    var payload = new Int[11]
    for (var index = 0; index < payload.length; index = index + 1) {
        payload[index] = sections.sectionValue(0, index)
    }
    payload[3] = 20
    var duplicate = BoundedSaveSections(12, 160)
    assert(duplicate.setRevision(7) && duplicate.put(11, 1, payload))
    assert(!target.restoreLevelProgression(duplicate, 100, 3) && target.activated(10))
    payload[3] = 10
    payload[4] = 0
    var orphanDoor = BoundedSaveSections(12, 160)
    assert(orphanDoor.setRevision(7) && orphanDoor.put(11, 1, payload))
    assert(!target.restoreLevelProgression(orphanDoor, 100, 3) && target.activated(10) && target.activated(20),
        "an active door with an inactive key must reject without changing live progress")
    var missing = BoundedSaveSections(12, 160)
    assert(missing.setRevision(8) && !target.restoreLevelProgression(missing, 100, 3))
    return true
}

Bool verifyLevelSaveCapacityAndRecovery() {
    var world = BoundedInteractionWorld(64, 100)
    for (var id = 1; id <= 64; id = id + 1) {
        assert(world.defineKey(id, 0, 0, 0, 0))
    }
    assert(world.seal() && world.interact(1, 0, 0, 0) && world.interact(64, 0, 0, 0))
    var sections = BoundedSaveSections(12, 160)
    assert(sections.setRevision(91) && world.encodeLevelProgression(sections, 7, 2))
    for (var id = 1; id <= 10; id = id + 1) {
        var payload = new Int[1]
        payload[0] = id
        var version = 1
        if (id == 2 || id == 3) {
            version = 2
        }
        assert(sections.put(id, version, payload))
    }
    var store = BoundedSaveSchemaFileStore(12, 160)
    assert(store.write("level-progress.dat", sections))
    var restored = BoundedSaveSections(12, 160)
    assert(store.read("level-progress.dat", restored) && restored.sectionCount() == 11)
    assert(world.restoreLevelProgression(restored, 7, 2) && world.activated(1) && world.activated(64))
    var words = store.readWords("level-progress.dat")
    var slotWords = words[2]
    words[4] = words[4] + 1
    assert(store.writeWords("level-progress.dat", words) && store.read("level-progress.dat", restored))
    assert(store.repair("level-progress.dat"))
    words = store.readWords("level-progress.dat")
    words[4 + slotWords] = words[4 + slotWords] + 1
    assert(store.writeWords("level-progress.dat", words) && store.read("level-progress.dat", restored))
    words[4] = words[4] + 1
    assert(store.writeWords("level-progress.dat", words) && !store.read("level-progress.dat", restored))
    assert(restored.revision() == 91 && restored.sectionValue(restored.find(11), 4) == 1,
        "two corrupt copies must not erase the destination")
    return true
}

Bool verifyLegacyLevelSaveFile() {
    var sections = BoundedSaveSections(8, 16)
    var payload = new Int[2]
    payload[0] = 303
    payload[1] = 404
    assert(sections.setRevision(12) && sections.put(1, 1, payload))
    var codec = BoundedSaveSchemaWireCodec(8, 16)
    assert(codec.encode(sections))
    var legacy = new Int[316]
    for (var index = 0; index < legacy.length; index = index + 1) {
        legacy[index] = 0
    }
    legacy[0] = 11773399
    legacy[1] = 1
    legacy[2] = codec.encodedLength()
    legacy[159] = codec.encodedLength()
    for (var index = 0; index < codec.encodedLength(); index = index + 1) {
        legacy[3 + index] = codec.encodedWord(index)
        legacy[160 + index] = codec.encodedWord(index)
    }
    var store = BoundedSaveSchemaFileStore(12, 160)
    var restored = BoundedSaveSections(12, 160)
    assert(store.writeWords("legacy-level-save.dat", legacy) && store.read("legacy-level-save.dat", restored))
    assert(restored.revision() == 12 && restored.sectionValue(0, 0) == 303 && restored.find(11) == -1)
    assert(store.repair("legacy-level-save.dat") && store.read("legacy-level-save.dat", restored))
    return true
}

Bool verifySessionLevelSaveRestore() {
    var session = LoopbackSession(2, 2)
    assert(session.defineWorldKey(1, 0, 0, 0, 0) && session.defineWorldDoor(2, 1, 0, 0, 0, 1, 2, 1, 0))
    assert(session.start() && session.connectPlayer() == 1)
    var initial = BoundedSaveSections(12, 160)
    assert(initial.setRevision(1) && session.encodeLevelProgression(initial, 7, 2))
    assert(session.receiveInteraction(1, 1, 1, 1) && session.advance(16667) == 1)
    assert(session.receiveInteraction(1, 2, 2, 2) && session.restoreLevelProgression(initial, 7, 2))
    assert(!session.worldInteractionActive(1) && !session.clientWorldInteractionActive(1))
    assert(session.advance(16667) == 1 && !session.worldInteractionActive(2),
        "loading progress must cancel queued interactions and publish a decreasing world revision")
    assert(!session.receiveInteraction(1, 3, 2, 1) && session.receiveInteraction(1, 3, 3, 1))
    assert(session.setInputReplayEnabled(true) && !session.restoreLevelProgression(initial, 7, 2),
        "loading cannot create an unrecorded state change inside a capture epoch")
    return true
}

Bool verifyRemoteGameplayAuthority() {
    var host = LoopbackSession(8, 4)
    var clientA = LoopbackSession(4, 4)
    var clientB = LoopbackSession(4, 4)
    assert(host.defineWorldKey(1, 2, 0, 0, 0) &&
        host.defineWorldDoor(2, 1, 4, 0, 0, 1, 2, 1, 4) &&
        host.defineWorldSecret(3, 2, 0, 0, 0) &&
        host.defineWorldExit(4, 2, 1, 0, 0, 0, 0) &&
        clientA.defineWorldKey(1, 2, 0, 0, 0) &&
        clientA.defineWorldDoor(2, 1, 4, 0, 0, 1, 2, 1, 4) &&
        clientA.defineWorldSecret(3, 2, 0, 0, 0) &&
        clientA.defineWorldExit(4, 2, 1, 0, 0, 0, 0) &&
        clientB.defineWorldKey(1, 2, 0, 0, 0) &&
        clientB.defineWorldDoor(2, 1, 4, 0, 0, 1, 2, 1, 4) &&
        clientB.defineWorldSecret(3, 2, 0, 0, 0) &&
        clientB.defineWorldExit(4, 2, 1, 0, 0, 0, 0) &&
        host.start() && host.connectPlayer() == 1 &&
        host.connectPlayer() == 2 && clientA.start() && clientB.start(),
        "remote gameplay sessions must share authored interaction identity")
    assert(host.configureEnemyRules(100, 20, 2) &&
        host.defineEnemyWeapon(9, 2, 0, 0, 4, 1, 20) &&
        host.defineEnemyEncounter(4, 1, 1) &&
        host.addEnemyCombatActor(1, 20, 0) &&
        host.equipEnemyCombatWeapon(1, 9) &&
        host.admitEnemyAt(4, 3, 0, 8, 0, 9, 6, 0, 0) &&
        host.defineEnemyCombatReward(3, 25),
        "host must own enemy encounter combat and reward configuration")

    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
        1, 1, 1, gameplayFireAction(), 3, 10, 0, 1)) &&
        host.lastRemoteGameplayAccepted())
    var state = host.gameplayStateMessage(1, 3, 1)
    var feedback = host.multiplayerFeedbackStateMessage(1)
    var encounter = host.enemyEncounterStateMessage(1, 4)
    assert(clientA.applyRemoteGameplayState(state) &&
        clientA.applyRemoteMultiplayerFeedback(feedback) &&
        clientA.applyRemoteEnemyEncounterState(encounter) &&
        clientA.clientRemoteCombatActor() == 3 &&
        clientA.clientRemoteCombatHealth() == 4 &&
        clientA.clientRemoteEnemyHealth(3) == 4 &&
        clientA.clientRemoteEncounterActiveCount() == 1 &&
        clientA.clientRemoteImpactSequence() == 1 &&
        clientA.clientRemoteCurrency() == 0 &&
        clientA.clientRemoteDiagnostic() == gameplayFireDiagnostic() &&
        clientA.pendingImpactPresentations() == 1 &&
        clientA.dequeueImpactPresentation(),
        "first remote shot must publish authoritative enemy damage")
    var firstImpact = clientA.lastImpactPresentation()
    assert(firstImpact.targetId() == 3 &&
        firstImpact.applied() == 4 && !firstImpact.died())
    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
        1, 2, 2, gameplayFireAction(), 3, 10, 0, 1)) &&
        host.lastRemoteGameplayAccepted())
    state = host.gameplayStateMessage(2, 3, 1)
    feedback = host.multiplayerFeedbackStateMessage(2)
    encounter = host.enemyEncounterStateMessage(2, 4)
    assert(clientA.applyRemoteGameplayState(state) &&
        clientA.applyRemoteMultiplayerFeedback(feedback) &&
        clientA.applyRemoteEnemyEncounterState(encounter) &&
        clientA.clientRemoteCombatHealth() == 0 &&
        clientA.clientRemoteEnemyHealth(3) == 0 &&
        clientA.clientRemoteEnemyState(3) == 7 &&
        clientA.clientRemoteEncounterActiveCount() == 0 &&
        clientA.clientRemoteImpactSequence() == 2 &&
        clientA.clientRemoteCurrency() == 25 &&
        host.playerCurrency(1) == 25 &&
        clientA.pendingImpactPresentations() == 1 &&
        clientA.dequeueImpactPresentation(),
        "terminal remote shot must replicate enemy death, feedback and reward")
    var terminalImpact = clientA.lastImpactPresentation()
    assert(terminalImpact.targetId() == 3 &&
        terminalImpact.applied() == 4 && terminalImpact.died())

    assert(clientA.predictRemoteGameplayInput(1, 3, 2, 1) &&
        clientA.predictRemoteGameplayInput(1, 4, 1, 1) &&
        clientA.clientRemotePredictedPosition() == 3 &&
        clientA.clientRemotePendingPredictionInputs() == 2,
        "remote client must predict ordered local movement inputs")
    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
        1, 3, 3, gameplayMoveAction(), 2, 0, 0, 1)),
        "remote movement command must pass wire validation")
    assert(host.lastRemoteGameplayAccepted(),
        "remote movement command must enter the authoritative tick")
    assert(host.serverPosition(1) == 2,
        "remote movement must change the authoritative position")
    state = host.gameplayStateMessage(3, 3, 1)
    assert(clientA.applyRemoteGameplayState(state) &&
        clientA.clientRemotePlayerPosition(1) == 2 &&
        clientA.clientRemoteAuthoritativePosition() == 2 &&
        clientA.clientRemotePredictedPosition() == 3 &&
        clientA.clientRemotePredictionCorrection() == 1 &&
        clientA.clientRemotePendingPredictionInputs() == 1,
        "reconciliation must replay inputs newer than the server tick")
    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
        1, 4, 4, gameplayInteractAction(), 1, 0, 0, 1)) &&
        host.lastRemoteGameplayAccepted())
    state = host.gameplayStateMessage(4, 3, 1)
    assert(clientA.applyRemoteGameplayState(state) &&
        clientA.clientWorldInteractionActive(1) &&
        clientA.clientRemotePredictedPosition() == 2 &&
        clientA.clientRemotePredictionCorrection() == 0 &&
        clientA.clientRemotePendingPredictionInputs() == 0,
        "later authority must correct an unacknowledged prediction")
    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
        1, 5, 4, gameplayInteractAction(), 3, 0, 0, 1)) &&
        !host.lastRemoteGameplayAccepted() &&
        host.lastRemoteGameplayDiagnostic() == gameplayStaleDiagnostic())
    state = host.gameplayStateMessage(
        host.currentServerTick(), 3, 1)
    assert(clientA.applyRemoteGameplayState(state) &&
        clientA.clientRemoteDiagnostic() == gameplayStaleDiagnostic(),
        "stale remote command must return an explicit client diagnostic")

    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
        2, 1, 1, gameplayDisconnectAction(), 2, 0, 0, 1)) &&
        host.lastRemoteGameplayAccepted())
    var lifecycle = host.gameplayStateMessage(
        host.currentServerTick(), 3, 2)
    assert(clientB.applyRemoteGameplayState(lifecycle) &&
        !clientB.clientRemoteConnected() &&
        clientB.clientRemoteDisconnectReason() == 2 &&
        clientB.clientRemoteConnectionGeneration() == 1 &&
        clientB.clientRemoteDiagnostic() == gameplayDisconnectDiagnostic(),
        "disconnect must publish bounded reason and generation")
    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
        2, 1, 2, gameplayReconnectAction(), 0, 0, 0, 1)) &&
        host.lastRemoteGameplayAccepted())
    lifecycle = host.gameplayStateMessage(
        host.currentServerTick(), 3, 2)
    assert(clientB.applyRemoteGameplayState(lifecycle) &&
        clientB.clientRemoteConnected() &&
        clientB.clientRemoteDisconnectReason() == 0 &&
        clientB.clientRemoteConnectionGeneration() == 2 &&
        clientB.clientRemoteDiagnostic() == gameplayReconnectDiagnostic(),
        "reconnect must preserve identity and advance its generation")
    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
            2, 5, 999, gameplayMoveAction(), 3, 0, 0, 1)) &&
        !host.lastRemoteGameplayAccepted() &&
        host.lastRemoteGameplayDiagnostic() ==
            gameplayGenerationDiagnostic(),
        "old connection generation must reject before sequence admission")
    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
            2, 5, 1, gameplayMoveAction(), 2, 0, 0, 2)) &&
        host.lastRemoteGameplayAccepted(),
        "new connection epoch must accept a reset sequence watermark")
    lifecycle = host.gameplayStateMessage(
        host.currentServerTick(), 3, 2)
    assert(clientB.applyRemoteGameplayState(lifecycle) &&
        clientB.clientRemotePlayerPosition(2) == 2 &&
        clientB.clientRemoteConnectionGeneration() == 2,
        "recovered identity must resume authoritative movement")
    return true
}

Bool verifyMultiplayerFeedbackRecovery() {
    var host = LoopbackSession(4, 2)
    var client = LoopbackSession(4, 2)
    assert(host.start() && host.connectPlayer() == 1 &&
        host.addPlayerCombatActor(1, 20, 0) &&
        client.start() &&
        client.applyRemoteGameplayState(
            host.gameplayStateMessage(0, 1, 1)),
        "feedback client must establish a generation baseline")

    var batch = newMultiplayerFeedbackMessage(0, 1, 2)
    var first = ImpactPresentationEvent(
        1, 1, 1, 3, 8, 0, 0, 4, false, 201, 70)
    var second = ImpactPresentationEvent(
        2, 2, 3, 1, 2, 0, 0, 6, true, 202, 100)
    assert(setMultiplayerFeedbackEvent(batch, 0, first) &&
        setMultiplayerFeedbackEvent(batch, 1, second) &&
        sealMultiplayerFeedbackMessage(batch) &&
        client.applyRemoteMultiplayerFeedback(batch) &&
        client.clientRemoteImpactSequence() == 2 &&
        client.pendingImpactPresentations() == 2 &&
        client.pendingImpactAudio() == 2,
        "ordered feedback batches must preserve every presentation")
    assert(!client.applyRemoteMultiplayerFeedback(batch),
        "duplicate feedback state must reject")

    var gap = newMultiplayerFeedbackMessage(0, 2, 1)
    var skipped = ImpactPresentationEvent(
        4, 1, 1, 3, 9, 0, 0, 1, false, 201, 70)
    assert(setMultiplayerFeedbackEvent(gap, 0, skipped) &&
        sealMultiplayerFeedbackMessage(gap) &&
        !client.applyRemoteMultiplayerFeedback(gap) &&
        client.clientRemoteImpactSequence() == 2 &&
        client.pendingImpactPresentations() == 2,
        "feedback gaps must reject without partial presentation")
    assert(client.dequeueImpactPresentation() &&
        client.lastImpactPresentation().targetId() == 3 &&
        client.dequeueImpactPresentation() &&
        client.lastImpactPresentation().targetId() == 1,
        "batched feedback must retain presentation order")

    assert(host.disconnectPlayer(1, 2) &&
        host.reconnectPlayer(1) &&
        client.applyRemoteGameplayState(
            host.gameplayStateMessage(0, 1, 1)) &&
        client.clientRemoteConnectionGeneration() == 2 &&
        client.clientRemoteImpactSequence() == 0 &&
        client.pendingImpactPresentations() == 0 &&
        client.pendingImpactAudio() == 0,
        "reconnect baseline must discard stale feedback")
    var recovered = newMultiplayerFeedbackMessage(0, 3, 1)
    var resumed = ImpactPresentationEvent(
        10, 3, 1, 0, 0, 0, 0, 1, false, 203, 80)
    assert(setMultiplayerFeedbackEvent(recovered, 0, resumed) &&
        sealMultiplayerFeedbackMessage(recovered) &&
        client.applyRemoteMultiplayerFeedback(recovered) &&
        client.clientRemoteImpactSequence() == 10 &&
        client.pendingImpactPresentations() == 1 &&
        client.pendingImpactAudio() == 1,
        "new generation must accept a recovered feedback sequence baseline")
    return true
}

main() {
    assert(verifyWorldProgression())
    assert(verifyDoorArenaIntegration())
    assert(verifyClientReconnectAndStaleInput())
    assert(verifyRemoteGameplayAuthority())
    assert(verifyMultiplayerFeedbackRecovery())
    assert(verifyCooperativeSession())
    assert(verifyInteractionAdmission())
    assert(verifyInteractionCheckpoint())
    assert(verifySpatialCheckpointRows())
    assert(verifyCatchupTicks())
    assert(verifyCheckpointInitialization())
    assert(verifyConsumedInteractionReplay())
    assert(verifyHeldInputReplay())
    assert(verifyInteractionCaptureReservation())
    assert(verifyReplayFileBoundaries())
    assert(verifyLevelSaveIdentity())
    assert(verifyLevelSaveCapacityAndRecovery())
    assert(verifyLegacyLevelSaveFile())
    assert(verifySessionLevelSaveRestore())
    println("KOOKIE G2 progression, bounded command replay, versioned saves and recovery verified")
}
