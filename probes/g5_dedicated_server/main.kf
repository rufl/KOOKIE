import session

main() {
    var enemyHistory = EnemySnapshotHistory(2)
    assert(enemyHistory.push(EnemyAuthoritySnapshot(1, 1, 1001, 1, 1)) &&
        enemyHistory.push(EnemyAuthoritySnapshot(2, 2, 1002, 2, 1)) &&
        enemyHistory.push(EnemyAuthoritySnapshot(3, 3, 1003, 3, 1)) &&
        enemyHistory.size() == 2 &&
        enemyHistory.latestSequence() == 3 &&
        enemyHistory.latest().enemyId() == 1003 &&
        !enemyHistory.push(EnemyAuthoritySnapshot(2, 2, 1002, 2, 1)),
        "enemy snapshot history must evict oldest entries without shifting")
    var impactHistory = EnemyImpactSnapshotHistory(2)
    assert(impactHistory.push(
            EnemyImpactSnapshot(1, 1, 1, 1, 1, 2, 3, 4, 5, 6, false)) &&
        impactHistory.push(
            EnemyImpactSnapshot(2, 2, 2, 2, 1, 2, 4, 5, 6, 7, true)) &&
        impactHistory.push(
            EnemyImpactSnapshot(3, 3, 3, 3, 1, 2, 5, 6, 7, 8, false)) &&
        impactHistory.size() == 2 &&
        impactHistory.latestSequence() == 3 &&
        impactHistory.latest().projectileId() == 3 &&
        !impactHistory.push(
            EnemyImpactSnapshot(2, 2, 2, 2, 1, 2, 4, 5, 6, 7, true)),
        "enemy impact history must retain monotonic order in a ring")

    var invalid = BoundedDedicatedServer(65, 256, 512, 16, 64, 128)
    assert(!invalid.configureReferenceWorkload(),
        "reference workload must reject capacities above the declared G5 ceiling")

    var server = BoundedDedicatedServer(64, 256, 512, 16, 64, 128)
    assert(server.configureReferenceWorkload() && server.configured() &&
        server.healthy(),
        "dedicated server must configure the complete bounded reference workload")
    var baseline = server.baselineResourceSignature()
    assert(baseline > 0 && server.enemyCount() == 64 &&
        server.projectileCount() == 256 && server.pickupCount() == 512,
        "reference workload must own 64 enemies 256 projectiles and 512 pickups")
    assert(server.referenceTriangleCount() == 64 &&
        server.loadedReferenceTriangleCount() == 64 &&
        server.referenceLevelChecksum() > 0 &&
        server.referenceLightCount() == 24 &&
        server.referenceEffectCount() == 64 &&
        server.referenceDynamicChecksum() > 0,
        "reference scene must retain authored collision lights and effects")
    assert(!server.advance(-1) && server.ticksProcessed() == 0,
        "dedicated server must reject invalid elapsed time without advancing")
    assert(server.runTicks(256),
        "dedicated server must complete repeated full workload cycles without graphics")
    assert(server.ticksProcessed() == 256 &&
        server.lastAiWork() == 16 && server.peakAiWork() == 16 &&
        server.lastProjectileWork() == 64 &&
        server.peakProjectileWork() == 64 &&
        server.lastProjectileMoved() == 64 &&
        server.lastPickupWork() == 128 && server.peakPickupWork() == 128,
        "every tick must remain inside the declared AI projectile and pickup budgets")
    assert(server.enemyCount() == 64 && server.projectileCount() == 256 &&
        server.pickupCount() == 512 && server.resourcePlateau() &&
        server.baselineResourceSignature() == baseline &&
        server.droppedMicros() == 0 && server.overloadCount() == 0,
        "logical resource counts and capacities must plateau after warm-up")
    assert(server.workloadChecksum() > 0,
        "bounded workload must produce observable deterministic work")
    var configuration = BoundedDedicatedRunConfiguration()
    assert(configuration.setMeasuredTicks(512) &&
        configuration.setWarmupTicks(128) &&
        configuration.setRssSampleInterval(32) &&
        configuration.setRealtime(true) && configuration.ready() &&
        configuration.measuredTicks() == 512 &&
        configuration.warmupTicks() == 128 &&
        configuration.rssSampleInterval() == 32 &&
        configuration.realtime() &&
        !configuration.setMeasuredTicks(0),
        "dedicated runtime configuration must retain validated FFI values")
    var telemetry = BoundedTickTelemetry(10)
    assert(telemetry.valid() &&
        telemetry.recordTick(1) && telemetry.recordTick(2) &&
        telemetry.recordTick(3) && telemetry.recordTick(15) &&
        telemetry.tickSamples() == 4 &&
        telemetry.p50Micros() == 2 &&
        telemetry.p95Micros() == 10 &&
        telemetry.p99Micros() == 10 &&
        telemetry.maximumTickMicros() == 15,
        "bounded telemetry must retain percentile and overflow observations")
    assert(telemetry.recordRss(100) && telemetry.recordRss(120) &&
        telemetry.recordRss(110) && telemetry.rssSamples() == 3 &&
        telemetry.firstRssKib() == 100 && telemetry.lastRssKib() == 110 &&
        telemetry.minimumRssKib() == 100 &&
        telemetry.maximumRssKib() == 120 &&
        telemetry.rssGrowthKib() == 10 && telemetry.rssRangeKib() == 20,
        "bounded telemetry must retain RSS growth and range")
    var phases = BoundedPhaseTelemetry(10)
    assert(phases.valid() &&
        phases.recordPhase(dedicatedPhaseClock(), 1) &&
        phases.recordPhase(dedicatedPhaseCollision(), 2) &&
        phases.recordPhase(dedicatedPhaseAi(), 3) &&
        phases.recordPhase(dedicatedPhaseProjectile(), 4) &&
        phases.recordPhase(dedicatedPhasePickup(), 5) &&
        phases.recordPhase(dedicatedPhaseFinalize(), 15) &&
        phases.samples(dedicatedPhaseFinalize()) == 1 &&
        phases.p50Micros(dedicatedPhaseFinalize()) == 10 &&
        phases.p95Micros(dedicatedPhaseFinalize()) == 10 &&
        phases.p99Micros(dedicatedPhaseFinalize()) == 10 &&
        phases.maximumMicros(dedicatedPhaseFinalize()) == 15 &&
        !phases.recordPhase(0, 1) &&
        !phases.recordPhase(dedicatedPhaseCount() + 1, 1),
        "phase telemetry must retain bounded per-phase percentiles")
    var admission = BoundedDedicatedClientAdmission(1)
    var client = BoundedDedicatedClientView(1)
    assert(admission.valid() && client.valid() &&
        admission.admitCompatibleGeneration(1, 0) &&
        client.beginCompatibleGeneration(1, 0),
        "dedicated client generation one must require compatibility admission")
    var request = newDedicatedWorkloadRequest(
        1, 1, 1, 0, dedicatedWorkloadPollAction())
    assert(admission.applyRequest(request) &&
        admission.lastRequestSequence() == 1,
        "dedicated admission must accept the first monotonic poll")
    var stateChecksum = dedicatedReferenceStateChecksum(server)
    var replay = newDedicatedWorkloadStateChunk(
        server, 1, 1, 1, true,
        dedicatedWorkloadSnapshotDiagnostic(), stateChecksum, 0)
    for (var chunk = 0; chunk < dedicatedWorkloadStateChunkCount();
        chunk = chunk + 1) {
        var state = newDedicatedWorkloadStateChunk(
            server, 1, 1, 1, true,
            dedicatedWorkloadSnapshotDiagnostic(), stateChecksum, chunk)
        assert(validDedicatedWorkloadStateChunk(state) &&
            client.applyStateChunk(state),
            "dedicated client must apply every complete-state chunk")
    }
    assert(client.connected() && client.tick() == 256 &&
        client.fullReferenceStateObserved() &&
        client.referenceStateChecksum() ==
            client.replicatedReferenceStateChecksum() &&
        client.resourceSignature() == baseline &&
        !client.applyStateChunk(replay),
        "dedicated state must preserve the full workload and reject replay")
    var tampered = newDedicatedWorkloadStateChunk(
        server, 1, 1, 2, true,
        dedicatedWorkloadSnapshotDiagnostic(), stateChecksum, 0)
    tampered[dedicatedWorkloadStateHeaderLength()] =
        tampered[dedicatedWorkloadStateHeaderLength()] + 1
    tampered[tampered.length - 1] =
        dedicatedWorkloadMessageChecksum(tampered, tampered.length - 1)
    assert(validDedicatedWorkloadStateChunk(tampered) &&
        client.applyStateChunk(tampered))
    for (var chunk = 1; chunk < dedicatedWorkloadStateChunkCount();
        chunk = chunk + 1) {
        var candidate = newDedicatedWorkloadStateChunk(
            server, 1, 1, 2, true,
            dedicatedWorkloadSnapshotDiagnostic(), stateChecksum, chunk)
        if (chunk + 1 < dedicatedWorkloadStateChunkCount()) {
            assert(client.applyStateChunk(candidate))
        } else {
            assert(!client.applyStateChunk(candidate))
        }
    }
    assert(client.stateSequence() == 1 && client.tick() == 256 &&
        client.updateCount() == 1 &&
        client.referenceStateChecksum() ==
            client.replicatedReferenceStateChecksum(),
        "checksum rejection must preserve the prior complete client state")
    var disconnect = newDedicatedWorkloadRequest(
        1, 1, 2, 256, dedicatedWorkloadDisconnectAction())
    assert(admission.applyRequest(disconnect) && !admission.connected(),
        "dedicated disconnect request must close admission")
    for (var chunk = 0; chunk < dedicatedWorkloadStateChunkCount();
        chunk = chunk + 1) {
        var state = newDedicatedWorkloadStateChunk(
            server, 1, 1, 2, false,
            dedicatedWorkloadDisconnectDiagnostic(), stateChecksum, chunk)
        assert(client.applyStateChunk(state),
            "dedicated client must consume complete disconnect state")
    }
    assert(!client.connected() &&
        !admission.applyRequest(newDedicatedWorkloadRequest(
            1, 1, 3, 256, dedicatedWorkloadPollAction())) &&
        !admission.admitCompatibleGeneration(2, 255) &&
        admission.admitCompatibleGeneration(2, 256) &&
        !client.beginCompatibleGeneration(2, 255) &&
        client.beginCompatibleGeneration(2, 256) &&
        admission.applyRequest(newDedicatedWorkloadRequest(
            1, 2, 1, 256, dedicatedWorkloadPollAction())),
        "dedicated reconnect must reject rollback and bind the resume tick")
    for (var chunk = 0; chunk < dedicatedWorkloadStateChunkCount();
        chunk = chunk + 1) {
        var state = newDedicatedWorkloadStateChunk(
            server, 1, 2, 1, true,
            dedicatedWorkloadReconnectDiagnostic(), stateChecksum, chunk)
        assert(client.applyStateChunk(state),
            "dedicated client must consume complete reconnect state")
    }
    assert(client.connected() && client.generation() == 2 &&
        client.stateSequence() == 1 && client.updateCount() == 3 &&
        client.resourceSignature() == baseline,
        "dedicated reconnect state must preserve resource identity")
    println("KOOKIE G5 dedicated headless workload verified")
    println(server.workloadChecksum())
    println(server.baselineResourceSignature())
}
