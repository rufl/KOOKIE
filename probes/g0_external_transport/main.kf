import core
import session
import world
import content

Int receivedPayloadSum(Int count) {
    if (count < 0) { return -1 }
    var sum = 0
    for (var index = 0; index < count; index = index + 1) {
        sum = sum + kookie_transport_receive_word(index)
    }
    return sum
}

Bool sendPayload(Int[] payload) {
    if (!kookie_transport_send_begin(payload.length)) {
        return false
    }
    for (var index = 0; index < payload.length; index = index + 1) {
        if (!kookie_transport_send_word(index, payload[index])) {
            return false
        }
    }
    if (!kookie_transport_send_commit()) {
        return false
    }
    return true
}

Bool receivePayload(LoopbackSession session, Int[] payload, Bool host) {
    var received = kookie_transport_receive()
    if (received != payload.length || kookie_transport_last_status() != 1) {
        return false
    }
    var expectedSum = 0
    for (var index = 0; index < payload.length; index = index + 1) {
        expectedSum = expectedSum + payload[index]
    }
    var headerMatches =
        kookie_transport_receive_word(0) == payload[0] &&
        kookie_transport_receive_word(1) == payload[1] &&
        kookie_transport_receive_word(2) == payload[2] &&
        kookie_transport_receive_word(3) == payload[3] &&
        kookie_transport_receive_word(4) == payload[4] &&
        kookie_transport_receive_word(5) == payload[5]
    if (!headerMatches || receivedPayloadSum(payload.length) != expectedSum) {
        return false
    }
    if (host) {
        return session.applyBroadPhaseSnapshot(payload)
    }
    return session.applyRemoteBroadPhaseSnapshot(payload)
}

Int externalRoleDerivedChecksum(Int value, Int salt) {
    var result = (value + salt) % 1000003
    if (result <= 0) { return 1 }
    return result
}


BoundedContentCompatibility externalRoleCompatibility(
    G1Arena arena,
    Int configChecksum,
    Int extensionNetworkSchema,
    Int engineVersion,
    Int contentApiVersion,
    Int contentGeneration,
    Int contentRevision
) {
    var identity = BoundedContentCompatibility()
    var collisionChecksum = arena.authoredCollision().checksum()
    var networkChecksum = externalRoleDerivedChecksum(
        protocolVersion() * 31 + maximumSessionTransportWords() * 17 +
        configChecksum * 13 + multiplayerFeedbackEntryWidth() * 7,
        extensionNetworkSchema)
    assert(collisionChecksum > 0 && networkChecksum > 0 &&
        identity.configureVersions(
            engineVersion, contentApiVersion, networkChecksum) &&
        identity.configureContent(
            collisionChecksum, configChecksum, configChecksum, configChecksum) &&
        identity.configurePublication(
            contentGeneration, contentRevision, configChecksum) &&
        identity.seal() && identity.encode(),
        "external role compatibility identity must seal")
    return identity
}

Bool externalRoleConfigureG3Definition(LoopbackSession host) {
    var config = BoundedG3Config()
    assert(config.load("config/g3/external_lan.json"),
        "external role G3 config must load")
    return config.loaded() &&
        host.registerExtensionManifest(
            config.value("extensionNamespace"),
            config.value("extensionOwner"),
            config.value("extensionApiVersion"),
            config.value("extensionSchemaVersion"),
            config.value("extensionRole")) &&
        host.configureExtensionLoadOrder(
            config.value("extensionNamespace"),
            config.value("extensionOwner"),
            config.value("extensionLoadOrder")) &&
        host.configureExtensionProvenance(
            config.value("extensionNamespace"),
            config.value("extensionOwner"),
            config.value("extensionProvenance")) &&
        host.configureExtensionSchemas(
            config.value("extensionNamespace"),
            config.value("extensionOwner"),
            config.value("extensionMigrationVersion"),
            config.value("extensionNetworkSchema")) &&
        host.grantExtensionCapability(
            config.value("extensionNamespace"),
            config.value("extensionOwner"),
            extensionContributionEnemyDefinitionKind()) &&
        host.registerExtensionContribution(
            config.value("extensionNamespace"),
            config.value("extensionOwner"),
            extensionContributionEnemyDefinitionKind(),
            config.value("enemyDefinitionId"),
            config.value("enemyDefinitionPriority")) &&
        host.defineEnemyDefinition(
            config.value("extensionNamespace"),
            config.value("extensionOwner"),
            config.value("enemyDefinitionId"),
            config.value("enemyDefinitionRevision"),
            config.value("enemyKind")) &&
        host.setEnemyDefinitionCombat(
            config.value("extensionNamespace"),
            config.value("enemyDefinitionId"),
            config.value("enemyHealth"),
            config.value("enemyArmor"),
            config.value("enemyWeaponId")) &&
        host.setEnemyDefinitionBehavior(
            config.value("extensionNamespace"),
            config.value("enemyDefinitionId"),
            config.value("enemyRole"),
            config.value("enemyMoveStep"),
            config.value("enemyProjectileStep")) &&
        host.setEnemyDefinitionCritical(
            config.value("extensionNamespace"),
            config.value("enemyDefinitionId"),
            config.value("enemyCritical")) &&
        host.setEnemyDefinitionLoot(
            config.value("extensionNamespace"),
            config.value("enemyDefinitionId"),
            config.value("enemyLootStableBase"),
            config.value("enemyLootSeedSalt"),
            config.value("enemyLootLevel")) &&
        host.setEnemyDefinitionRankCurrency(
            config.value("extensionNamespace"),
            config.value("enemyDefinitionId"),
            config.value("enemyLootRank"),
            config.value("enemyCurrency")) &&
        host.setEnemyDefinitionProgression(
            config.value("extensionNamespace"),
            config.value("enemyDefinitionId"),
            config.value("enemySkillId"),
            config.value("enemyExperience"))
}

Bool externalRoleConfigureG3Runtime(LoopbackSession host) {
    var config = BoundedG3Config()
    assert(config.load("config/g3/external_lan.json"),
        "external role G3 config must load")
    var playerId = config.value("playerActorId")
    var secondaryPlayerId = config.value("secondaryPlayerId")
    return config.loaded() &&
        host.configureEnemyRules(
            config.value("enemyRuleActorCapacity"),
            config.value("enemyRuleMaxDistance"),
            config.value("enemyRuleMaxProjectiles")) &&
        host.defineEnemyWeapon(
            config.value("enemyWeaponId"),
            config.value("enemyWeaponMagazineSize"),
            config.value("enemyWeaponReserveCapacity"),
            config.value("enemyWeaponDamage"),
            config.value("enemyWeaponChannel")) &&
        host.setEnemyWeaponRange(
            config.value("enemyWeaponId"),
            config.value("enemyWeaponRange")) &&
        host.definePlayerWeapon(
            config.value("playerWeaponId"),
            config.value("playerWeaponMagazineSize"),
            config.value("playerWeaponReserveCapacity"),
            config.value("playerWeaponDamage"),
            config.value("playerWeaponChannel")) &&
        host.setPlayerWeaponRange(
            config.value("playerWeaponId"),
            config.value("playerWeaponRange")) &&
        host.definePlayerSkill(
            config.value("playerSkillId"),
            config.value("playerSkillMaximumRank"),
            config.value("playerSkillExperienceCost")) &&
        host.setPlayerSkillDamagePercent(
            config.value("playerSkillId"),
            config.value("playerSkillDamagePercent")) &&
        host.definePlayerStatus(
            config.value("playerStatusId"),
            config.value("playerStatusDurationCap"),
            config.value("playerStatusStackCap")) &&
        host.setPlayerStatusDamageModifier(
            config.value("playerStatusId"),
            config.value("playerStatusDamageFlat"),
            config.value("playerStatusDamagePercent")) &&
        host.setPlayerStatusDefenseModifier(
            config.value("playerStatusId"),
            config.value("playerStatusDefenseFlat"),
            config.value("playerStatusDefensePercent")) &&
        host.setPlayerStatusPeriodicDamage(
            config.value("playerStatusId"),
            config.value("playerStatusPeriodicDamage"),
            config.value("playerStatusPeriodicChannel")) &&
        host.defineEnemyEncounter(
            config.value("encounterId"),
            config.value("encounterMaxActive"),
            config.value("encounterBudget")) &&
        host.addEnemyCombatActor(
            config.value("enemyActorId"),
            config.value("enemyActorHealth"),
            config.value("enemyActorArmor")) &&
        host.equipEnemyCombatWeapon(
            config.value("enemyActorId"),
            config.value("enemyWeaponId")) &&
        host.addPlayerCombatActor(
            playerId,
            config.value("playerActorHealth"),
            config.value("playerActorArmor")) &&
        host.addPlayerCombatActor(
            secondaryPlayerId,
            config.value("playerActorHealth"),
            config.value("playerActorArmor")) &&
        host.applyPlayerStatus(
            playerId,
            config.value("playerStatusId"),
            config.value("playerStatusDuration"),
            config.value("playerStatusStacks")) &&
        host.applyPlayerStatus(
            secondaryPlayerId,
            config.value("playerStatusId"),
            config.value("playerStatusDuration"),
            config.value("playerStatusStacks")) &&
        host.defineLootAffixPool(config.value("affixPoolId")) &&
        host.addLootAffix(
            config.value("affixPoolId"),
            config.value("affixId"),
            config.value("affixWeight")) &&
        host.defineLootAffixStat(
            config.value("affixId"),
            config.value("affixFlatValue"),
            config.value("affixAdditivePercent"),
            config.value("affixMultiplicativePercent")) &&
        host.defineLootItem(
            config.value("lootItemDefinitionId"),
            config.value("lootItemBaseValue"),
            config.value("lootItemMinimumLevel"),
            config.value("lootItemMaximumLevel"),
            config.value("lootItemAffixPool")) &&
        host.addLootTableEntry(
            config.value("lootItemDefinitionId"),
            config.value("lootTableWeight")) &&
        host.admitDefinedEnemy(
            config.value("encounterId"),
            config.value("admittedEnemyId"),
            config.value("extensionNamespace"),
            config.value("enemyDefinitionId")) &&
        host.setEnemySpatialPosition(
            config.value("admittedEnemyId"),
            config.value("enemyActorX"),
            config.value("enemyActorY"),
            config.value("enemyActorZ"))
}


Bool externalRoleHostCompatibility(
    BoundedContentCompatibility local, Int expectedSequence
) {
    var received = kookie_transport_receive()
    if (received != compatibilityHandshakeOfferLength() ||
        kookie_transport_last_status() != 1) {
        return false
    }
    var offer = new Int[compatibilityHandshakeOfferLength()]
    for (var index = 0; index < offer.length; index = index + 1) {
        offer[index] = kookie_transport_receive_word(index)
    }
    var remote = BoundedContentCompatibility()
    if (offer[3] != expectedSequence ||
        !decodeCompatibilityHandshakeOffer(offer, remote)) {
        return false
    }
    var response = newCompatibilityHandshakeResponse(
        local, remote, expectedSequence)
    if (response.length != compatibilityHandshakeResponseLength() ||
        !kookie_transport_set_peer_last_sender() ||
        !sendPayload(response)) {
        return false
    }
    return compatibilityHandshakeAccepted(response)
}

Bool externalRoleClientCompatibility(
    LoopbackSession client,
    BoundedContentCompatibility local,
    Int sequence
) {
    var offer = client.remoteCompatibilityOffer(sequence)
    if (offer.length != compatibilityHandshakeOfferLength() ||
        !sendPayload(offer)) {
        return false
    }
    var received = kookie_transport_receive()
    if (received != compatibilityHandshakeResponseLength() ||
        kookie_transport_last_status() != 1) {
        return false
    }
    var response = new Int[compatibilityHandshakeResponseLength()]
    for (var index = 0; index < response.length; index = index + 1) {
        response[index] = kookie_transport_receive_word(index)
    }
    return client.acceptRemoteCompatibilityResponse(response, sequence) &&
        client.remoteSessionReady() && client.remoteCompatible() &&
        client.remoteCompatibilityDiagnostic() == kutterDiagnosticNone() &&
        local.checksum() == response[5]
}

Bool externalRoleLocalCompatibility(
    LoopbackSession client,
    BoundedContentCompatibility local,
    Int clientSlot, Int hostSlot, Int sequence
) {
    var offer = client.remoteCompatibilityOffer(sequence)
    if (offer.length != compatibilityHandshakeOfferLength() ||
        !kookie_transport_select_slot(clientSlot) ||
        !sendPayload(offer) ||
        !kookie_transport_select_slot(hostSlot) ||
        !externalRoleHostCompatibility(local, sequence) ||
        !kookie_transport_select_slot(clientSlot) ||
        kookie_transport_receive() != compatibilityHandshakeResponseLength() ||
        kookie_transport_last_status() != 1) {
        return false
    }
    var response = new Int[compatibilityHandshakeResponseLength()]
    for (var index = 0; index < response.length; index = index + 1) {
        response[index] = kookie_transport_receive_word(index)
    }
    return client.acceptRemoteCompatibilityResponse(response, sequence) &&
        client.remoteSessionReady() && client.remoteCompatible()
}

Bool openRemoteSlot(Int slot, Int hostPort) {
    return kookie_transport_select_slot(slot) &&
        kookie_transport_set_key_from_environment() &&
        kookie_transport_open_remote_ipv4(127, 0, 0, 1, hostPort)
}


Bool externalRoleReceiveState(LoopbackSession client) {
    var received = kookie_transport_receive()
    if (received != gameplayStateMessageLength() ||
        kookie_transport_last_status() != 1) {
        println("external-state-receive-failed")
        println(received)
        println(kookie_transport_last_status())
        return false
    }
    var state = new Int[gameplayStateMessageLength()]
    for (var index = 0;
        index < gameplayStateMessageLength(); index = index + 1) {
        state[index] = kookie_transport_receive_word(index)
    }
    if (!validGameplayStateMessage(state)) {
        println("external-state-invalid")
        println(state[state.length - 1])
        println(gameplayMessageChecksum(state, state.length - 1))
        return false
    }
    return client.applyRemoteGameplayState(state)
}

Bool externalRoleReceiveFeedback(LoopbackSession client) {
    var received = kookie_transport_receive()
    if (received < 6 ||
        received > maximumSessionTransportWords() ||
        kookie_transport_last_status() != 1) {
        println("external-feedback-receive-failed")
        println(received)
        return false
    }
    var count = kookie_transport_receive_word(4)
    if (count < 0 ||
        count > maximumMultiplayerFeedbackEvents() ||
        received != 6 + count * multiplayerFeedbackEntryWidth()) {
        println("external-feedback-shape-invalid")
        return false
    }
    var feedback = newMultiplayerFeedbackMessage(
        kookie_transport_receive_word(2),
        kookie_transport_receive_word(3), count)
    if (feedback.length == 0) {
        return false
    }
    for (var index = 0;
        index < feedback.length;
        index = index + 1) {
        feedback[index] = kookie_transport_receive_word(index)
    }
    return validMultiplayerFeedbackMessage(feedback) &&
        client.applyRemoteMultiplayerFeedback(feedback)
}

Bool externalRoleReceiveEncounter(LoopbackSession client) {
    var received = kookie_transport_receive()
    if (received < 20 || received > maximumSessionTransportWords() ||
        kookie_transport_last_status() != 1) {
        println("external-encounter-receive-failed")
        println(received)
        println(kookie_transport_last_status())
        return false
    }
    var enemyCount = kookie_transport_receive_word(7)
    var expectedLength = 20 +
        enemyCount * enemyEncounterStateEntryWidth()
    if (kookie_transport_receive_word(0) != protocolVersion() ||
        kookie_transport_receive_word(1) !=
            enemyEncounterStateMessageKind() ||
        enemyCount < 0 ||
        enemyCount > maximumEnemyEncounterStateEnemies() ||
        received != expectedLength) {
        println("external-encounter-shape-invalid")
        return false
    }
    var state = newEnemyEncounterStateMessage(
        kookie_transport_receive_word(2),
        kookie_transport_receive_word(3),
        kookie_transport_receive_word(4),
        kookie_transport_receive_word(5),
        kookie_transport_receive_word(6),
        enemyCount)
    if (state.length == 0) {
        println("external-encounter-header-invalid")
        return false
    }
    for (var index = 8; index < state.length; index = index + 1) {
        state[index] = kookie_transport_receive_word(index)
    }
    if (!validEnemyEncounterStateMessage(state)) {
        println("external-encounter-invalid")
        println(state[state.length - 1])
        println(gameplayMessageChecksum(state, state.length - 1))
        return false
    }
    return client.applyRemoteEnemyEncounterState(state)
}

Int[] newExternalPlayerAuthorityStorage(Int[] counts) {
    if (counts.length != 5 ||
        counts[0] < 0 || counts[0] > maximumPlayerAuthorityItems() ||
        counts[1] < 0 || counts[1] > maximumPlayerAuthorityEquipment() ||
        counts[2] < 0 || counts[2] > maximumPlayerAuthoritySkills() ||
        counts[3] < 0 || counts[3] > maximumPlayerAuthorityStatuses()) {
        return new Int[0]
    }
    return new Int[13 +
        counts[0] * playerAuthorityItemEntryWidth() +
        counts[1] * playerAuthorityEquipmentEntryWidth() +
        counts[2] * playerAuthoritySkillEntryWidth() +
        counts[3] * playerAuthorityStatusEntryWidth()]
}

Int[] newExternalWorldLootStorage(Int dropCount) {
    if (dropCount < 0 || dropCount > maximumWorldLootStateDrops()) {
        return new Int[0]
    }
    return new Int[9 + dropCount * worldLootStateEntryWidth()]
}

Bool externalRoleReceivePlayerAuthority(LoopbackSession client) {
    var received = kookie_transport_receive()
    if (received < 13 ||
        received > maximumSessionTransportWords() ||
        kookie_transport_last_status() != 1) {
        println("external-player-authority-receive-failed")
        return false
    }
    var counts = new Int[5]
    counts[4] = received
    counts[0] = kookie_transport_receive_word(8)
    counts[1] = kookie_transport_receive_word(9)
    counts[2] = kookie_transport_receive_word(10)
    counts[3] = kookie_transport_receive_word(11)
    var state = newExternalPlayerAuthorityStorage(counts)
    if (state.length != counts[4]) {
        println("external-player-authority-shape-invalid")
        return false
    }
    for (var index = 0; index < state.length; index = index + 1) {
        state[index] = kookie_transport_receive_word(index)
    }
    if (!validPlayerAuthorityStateMessage(state)) {
        println("external-player-authority-invalid")
        return false
    }
    if (!client.applyRemotePlayerAuthorityState(state)) {
        println("external-player-authority-apply-failed")
        return false
    }
    return true
}

Bool externalRoleReceiveWorldLoot(LoopbackSession client) {
    var received = kookie_transport_receive()
    if (received < 9 ||
        received > maximumSessionTransportWords() ||
        kookie_transport_last_status() != 1) {
        println("external-world-loot-receive-failed")
        return false
    }
    var shape = new Int[2]
    shape[0] = received
    shape[1] = kookie_transport_receive_word(7)
    var state = newExternalWorldLootStorage(shape[1])
    if (state.length != shape[0]) {
        println("external-world-loot-shape-invalid")
        return false
    }
    for (var index = 0; index < state.length; index = index + 1) {
        state[index] = kookie_transport_receive_word(index)
    }
    return validWorldLootStateMessage(state) &&
        client.applyRemoteWorldLootState(state)
}


Bool externalRoleSendCommand(
    LoopbackSession client, Int[] command
) {
    if (!sendPayload(command) ||
        !externalRoleReceiveState(client) ||
        !externalRoleReceiveFeedback(client) ||
        !externalRoleReceiveEncounter(client)) {
        return false
    }
    if (!client.clientRemoteConnected()) {
        return true
    }
    return externalRoleReceivePlayerAuthority(client) &&
        externalRoleReceiveWorldLoot(client)
}

Bool externalRoleHostState(
    LoopbackSession host, Int tick, Int player
) {
    tick = host.currentServerTick()
    if (!kookie_transport_set_peer_last_sender()) {
        return false
    }
    var state = host.gameplayStateMessage(tick, 3, player)
    if (!validGameplayStateMessage(state) ||
        !sendPayload(state)) {
        return false
    }
    var feedback = host.multiplayerFeedbackStateMessage(tick)
    if (!validMultiplayerFeedbackMessage(feedback) ||
        !sendPayload(feedback)) {
        return false
    }
    var encounter = host.enemyEncounterStateMessage(tick, 4)
    if (!validEnemyEncounterStateMessage(encounter) ||
        !sendPayload(encounter)) {
        return false
    }
    if (!host.playerConnected(player)) {
        return true
    }
    var authority = host.playerAuthorityStateMessage(tick, player)
    if (!validPlayerAuthorityStateMessage(authority) ||
        !sendPayload(authority)) {
        return false
    }
    var loot = host.worldLootStateMessage(tick, player)
    return validWorldLootStateMessage(loot) && sendPayload(loot)
}

Bool externalRoleHostReceiveSnapshot(
    LoopbackSession host, Int[] expected, Int player
) {
    if (!receivePayload(host, expected, true) ||
        !kookie_transport_set_peer_last_sender() ||
        !sendPayload(expected)) {
        return false
    }
    return externalRoleHostState(
        host, host.currentServerTick(), player)
}

Bool externalRoleHostReceiveCommand(
    LoopbackSession host, Int slot,
    Int player, Int sequence, Int action
) {
    if (!kookie_transport_select_slot(slot) ||
        kookie_transport_receive() != 11 ||
        kookie_transport_last_status() != 1) {
        return false
    }
    var command = new Int[11]
    for (var index = 0; index < 11; index = index + 1) {
        command[index] = kookie_transport_receive_word(index)
    }
    if (!validGameplayCommandMessage(command) ||
        gameplayCommandPlayer(command) != player ||
        gameplayCommandSequence(command) != sequence ||
        gameplayCommandAction(command) != action ||
        !host.applyRemoteGameplayCommand(command)) {
        return false
    }
    return externalRoleHostState(
        host, gameplayCommandTick(command), player)
}

Bool externalRoleSaveReload(LoopbackSession host) {
    var config = BoundedG3Config()
    assert(config.load("config/g3/external_lan.json"),
        "external role G3 config must load")
    var playerId = config.value("playerActorId")
    var itemId = host.playerEquipmentItem(playerId, 0)
    var currencyBefore = host.playerCurrency(playerId)
    var itemQuantityBefore = host.playerItemQuantity(playerId, itemId)
    var skillRankBefore = host.playerSkillRank(
        playerId, config.value("playerSkillId"))
    var lootCountBefore = host.worldLootCount()
    var rewardClaimedBefore = host.combatRewardClaimed(
        config.value("admittedEnemyId"))
    var savePath = "external-g3-authority-save.bin"
    var saveFile = File(savePath)
    if (saveFile.exists() && !saveFile.delete()) {
        return false
    }
    var store = BoundedSaveSchemaFileStore(12, 160)
    var saved = BoundedSaveSections(12, 160)
    if (!saved.setRevision(host.currentServerTick()) ||
        !host.encodeG3Authority(playerId, saved) ||
        !store.write(savePath, saved)) {
        return false
    }
    var loaded = BoundedSaveSections(12, 160)
    var restored = store.read(savePath, loaded) &&
        host.decodeG3Authority(playerId, loaded) &&
        host.playerCurrency(playerId) == currencyBefore &&
        host.playerItemQuantity(playerId, itemId) == itemQuantityBefore &&
        host.playerEquipmentItem(playerId, 0) == itemId &&
        host.playerSkillRank(
            playerId, config.value("playerSkillId")) == skillRankBefore &&
        host.worldLootCount() == lootCountBefore &&
        host.combatRewardClaimed(
            config.value("admittedEnemyId")) == rewardClaimedBefore
    var removed = !saveFile.exists() || saveFile.delete()
    if (!restored || !removed) {
        return false
    }
    println("external-g3-save-reload")
    println(1)
    return true
}


Bool externalRoleHostQualification() {
    var arena = G1Arena()
    var config = BoundedG3Config()
    assert(config.load("config/g3/external_lan.json"),
        "external role G3 config must load")
    var compatibility = externalRoleCompatibility(
        arena,
        config.checksum(),
        config.value("extensionNetworkSchema"),
        config.value("engineVersion"),
        config.value("contentApiVersion"),
        config.value("contentGeneration"),
        config.value("contentRevision"))
    var host = LoopbackSession(
        config.value("sessionEnemyCapacity"),
        config.value("sessionPlayerCapacity"))
    var playerId = config.value("playerActorId")
    var enemyId = config.value("admittedEnemyId")
    var skillId = config.value("playerSkillId")
    assert(arena.ready() &&
        kookie_transport_max_words() == maximumSessionTransportWords() &&
        host.defineWorldKey(1, 2, 0, 0, 0) &&
        host.defineWorldDoor(2, 1, 4, 0, 0, 1, 2, 1, 4) &&
        host.defineWorldSecret(3, 2, 0, 0, 0) &&
        host.defineWorldExit(4, 2, 1, 0, 0, 0, 0) &&
        externalRoleConfigureG3Definition(host) &&
        host.start() && host.connectPlayer() == 1 && host.connectPlayer() == 2 &&
        host.loadAuthoredBroadPhase(arena.authoredCollision()) &&
        host.broadPhaseTriangleCount() == arena.triangleCount() &&
        externalRoleConfigureG3Runtime(host),
        "external host must configure replicated combat loot and progression")
    var healthBeforeShot = host.enemyCombatHealth(enemyId)
    assert(kookie_transport_select_slot(0) &&
        kookie_transport_set_key_from_environment() &&
        kookie_transport_open_listen_ipv4(47101) &&
        kookie_transport_select_slot(1) &&
        kookie_transport_set_key_from_environment() &&
        kookie_transport_open_listen_ipv4(47102),
        "external host must bind two authenticated listeners")
    assert(kookie_transport_select_slot(0) &&
        externalRoleHostCompatibility(compatibility, 1) &&
        kookie_transport_select_slot(1) &&
        externalRoleHostCompatibility(compatibility, 1),
        "external host must admit matching content before gameplay")
    var expectedA = host.broadPhaseSnapshot(6, 6)
    var expectedB = host.broadPhaseSnapshot(7, 7)
    assert(kookie_transport_select_slot(0) &&
        externalRoleHostReceiveSnapshot(host, expectedA, 1) &&
        kookie_transport_select_slot(1) &&
        externalRoleHostReceiveSnapshot(host, expectedB, 2),
        "external host must authenticate two client snapshots")
    assert(host.clientBroadPhaseTriangleCount() == arena.triangleCount(),
        "external host must receive the complete authored arena")
    var upperFloor = host.queryClientBroadPhasePath(
        host.clientBroadPhaseRevision(),
        SpatialPoint(24, 12, 20), SpatialPoint(24, 6, 20))
    assert(upperFloor.accepted() && upperFloor.collided(),
        "transported arena must retain stacked-room collision")

    assert(externalRoleHostReceiveCommand(
            host, 0, 1, 1, gameplayProgressionAction()) &&
        host.lastRemoteGameplayAccepted() &&
        host.playerSkillRank(playerId, skillId) == 0,
        "external progression request must enter server authority")
    assert(externalRoleHostReceiveCommand(
            host, 0, 1, 2, gameplayFireAction()) &&
        host.lastRemoteGameplayAccepted(),
        "external first fire command must enter authority")
    var healthAfterFirstShot = host.enemyCombatHealth(enemyId)
    assert(healthAfterFirstShot < healthBeforeShot &&
        healthAfterFirstShot > 0,
        "external first fire must apply authoritative damage")
    assert(externalRoleHostReceiveCommand(
            host, 0, 1, 3, gameplayFireAction()) &&
        host.lastRemoteGameplayAccepted())
    var itemId = host.worldLootStableId(0)
    assert(host.enemyCombatHealth(enemyId) == 0 &&
        host.playerCurrency(playerId) == config.value("enemyCurrency") &&
        host.playerSkillRank(playerId, skillId) >= 1 &&
        host.worldLootCount() == 1 &&
        itemId > 0,
        "external terminal fire must award server-owned G3 state")
    assert(externalRoleHostReceiveCommand(
            host, 1, 2, 1, gameplayDisconnectAction()) &&
        host.lastRemoteGameplayAccepted() &&
        !host.playerConnected(2) &&
        host.playerDisconnectReason(2) == 2,
        "external client disconnect must preserve its player identity")
    assert(kookie_transport_select_slot(1) &&
        externalRoleHostCompatibility(compatibility, 2),
        "external reconnect must repeat compatibility admission")
    assert(externalRoleHostReceiveCommand(
            host, 1, 2, 2, gameplayReconnectAction()) &&
        host.lastRemoteGameplayAccepted() &&
        host.playerConnected(2) &&
        host.playerConnectionGeneration(2) == 2,
        "external client reconnect must preserve identity and advance diagnostics")
    assert(externalRoleHostReceiveCommand(
            host, 0, 1, 4, gameplayMoveAction()) &&
        host.lastRemoteGameplayAccepted() &&
        host.serverPosition(1) == 2,
        "external movement must update authoritative position")
    assert(externalRoleHostReceiveCommand(
            host, 0, 1, 5, gameplayPickupAction()) &&
        host.lastRemoteGameplayAccepted() &&
        host.worldLootCount() == 0 &&
        host.playerItemQuantity(playerId, itemId) == 1,
        "external pickup must atomically move replicated loot into inventory")
    assert(externalRoleHostReceiveCommand(
            host, 0, 1, 6, gameplayEquipAction()) &&
        host.lastRemoteGameplayAccepted() &&
        host.playerEquipmentItem(playerId, 0) == itemId,
        "external equip must publish the authoritative loadout")
    assert(externalRoleHostReceiveCommand(
            host, 0, 1, 7, gameplayInteractAction()) &&
        host.lastRemoteGameplayAccepted() &&
        host.worldInteractionActive(1) &&
        externalRoleHostReceiveCommand(
            host, 1, 2, 1, gameplayInteractAction()) &&
        host.lastRemoteGameplayAccepted() &&
        host.worldInteractionActive(2),
        "external clients must complete key and door actions")
    assert(externalRoleHostReceiveCommand(
            host, 0, 1, 7, gameplayInteractAction()) &&
        !host.lastRemoteGameplayAccepted() &&
        host.lastRemoteGameplayDiagnostic() == gameplayStaleDiagnostic() &&
        externalRoleHostReceiveCommand(
            host, 0, 1, 8, gameplayInteractAction()) &&
        host.lastRemoteGameplayAccepted() &&
        host.worldSecretCount() == 1,
        "external host must diagnose stale input and admit the next secret")
    assert(externalRoleHostReceiveCommand(
            host, 1, 2, 2, gameplayInteractAction()) &&
        host.lastRemoteGameplayAccepted() &&
        host.levelCompleted() &&
        host.worldInteractionRevision() == 4,
        "external host must complete the authoritative interaction path")
    assert(externalRoleSaveReload(host),
        "external host must round-trip authoritative G3 state")

    println("external-role-processes")
    println("external-gameplay")
    println("external-host-port-a")
    println(47101)
    println("external-host-port-b")
    println(47102)
    println("external-host-reconnect")
    println("external-reconnect-generation")
    println(host.playerConnectionGeneration(2))
    println("external-combat-damage")
    println(healthBeforeShot - host.enemyCombatHealth(enemyId))
    println("external-combat-death")
    println(1)
    println("external-combat-reward")
    println(host.playerCurrency(playerId))
    println("external-enemy-encounter")
    println(host.enemyEncounterActiveCount(config.value("encounterId")))
    println("external-enemy-state")
    println(host.enemyState(enemyId))
    println("external-enemy-health")
    println(host.enemyCombatHealth(enemyId))
    println("external-g3-config-checksum")
    println(config.checksum())
    println("external-impact-sequence")
    println(host.remoteImpactSequence())
    println("external-player-position")
    println(host.serverPosition(1))
    println("external-arena-triangles")
    println(host.clientBroadPhaseTriangleCount())
    println("external-interaction-revision")
    println(host.worldInteractionRevision())
    println("external-authenticated-two-clients")
    println("external-stale-rejection")
    println("external-stale-diagnostic")
    println(gameplayStaleDiagnostic())
    println("external-authentication-status")
    println(1)
    println("external-compatibility-handshake")
    println(compatibility.checksum())
    assert(kookie_transport_select_slot(0) &&
        kookie_transport_received_sequence_at_least(10),
        "external host must inspect client A sequence")
    assert(kookie_transport_select_slot(1) &&
        kookie_transport_received_sequence_at_least(5),
        "external host must inspect client B sequence")
    println("external-transport-sequence-a")
    println(10)
    println("external-transport-sequence-b")
    println(5)
    kookie_transport_select_slot(0)
    kookie_transport_close()
    kookie_transport_select_slot(1)
    kookie_transport_close()
    println("KOOKIE external-style authenticated host/two-client transport verified")
    return true
}

Bool externalRoleClientQualification(Int clientId) {
    var arena = G1Arena()
    var config = BoundedG3Config()
    assert(config.load("config/g3/external_lan.json"),
        "external role G3 config must load")
    var compatibility = externalRoleCompatibility(
        arena,
        config.checksum(),
        config.value("extensionNetworkSchema"),
        config.value("engineVersion"),
        config.value("contentApiVersion"),
        config.value("contentGeneration"),
        config.value("contentRevision"))
    var client = LoopbackSession(
        config.value("sessionEnemyCapacity"),
        config.value("sessionPlayerCapacity"))
    var enemyId = config.value("admittedEnemyId")
    var skillId = config.value("playerSkillId")
    var hostFirstOctet = kookie_transport_external_host_octet(0)
    var hostSecondOctet = kookie_transport_external_host_octet(1)
    var hostThirdOctet = kookie_transport_external_host_octet(2)
    var hostFourthOctet = kookie_transport_external_host_octet(3)
    var hostPort = 47101
    var snapshotTick = 6
    if (clientId == 2) {
        hostPort = 47102
        snapshotTick = 7
    }
    var endpoint = RemoteSessionEndpoint(
        hostFirstOctet, hostSecondOctet, hostThirdOctet, hostFourthOctet,
        hostPort, 1, 2, 3, 4)
    assert(arena.ready() && endpoint.valid() &&
        kookie_transport_max_words() == maximumSessionTransportWords() &&
        client.defineWorldKey(1, 2, 0, 0, 0) &&
        client.defineWorldDoor(2, 1, 4, 0, 0, 1, 2, 1, 4) &&
        client.defineWorldSecret(3, 2, 0, 0, 0) &&
        client.defineWorldExit(4, 2, 1, 0, 0, 0, 0) &&
        client.start() &&
        client.loadAuthoredBroadPhase(arena.authoredCollision()) &&
        kookie_transport_select_slot(0) &&
        kookie_transport_set_key_from_environment() &&
        kookie_transport_open_remote_environment(hostPort) &&
        client.configureRemoteEndpoint(
            hostFirstOctet, hostSecondOctet, hostThirdOctet, hostFourthOctet,
            hostPort,
            endpoint.keyWord(0), endpoint.keyWord(1),
            endpoint.keyWord(2), endpoint.keyWord(3)) &&
        client.requireRemoteCompatibility(compatibility) &&
        client.openRemoteSession() &&
        externalRoleClientCompatibility(client, compatibility, 1) &&
        client.pumpRemoteBroadPhaseSnapshot(snapshotTick),
        "external client must authenticate and stage the authored arena")
    var snapshot = client.broadPhaseSnapshot(
        snapshotTick, client.remoteSendSequence())
    assert(snapshot.length == 12 + arena.triangleCount() * 9 &&
        snapshot.length <= kookie_transport_max_words() &&
        sendPayload(snapshot) &&
        receivePayload(client, snapshot, false),
        "external client must complete authenticated snapshot join")
    assert(externalRoleReceiveState(client),
        "external client must receive its join gameplay baseline")
    assert(externalRoleReceiveFeedback(client),
        "external client must receive its join feedback baseline")
    assert(externalRoleReceiveEncounter(client),
        "external client must receive its join encounter baseline")
    assert(externalRoleReceivePlayerAuthority(client),
        "external client must receive its join player-authority baseline")
    assert(externalRoleReceiveWorldLoot(client),
        "external client must receive its join world-loot baseline")
    assert(client.clientBroadPhaseTriangleCount() ==
            arena.triangleCount(),
        "external client join must restore authored arena")
    assert(client.clientRemoteBaselineReady() &&
        client.clientRemotePlayer() == clientId &&
        client.clientRemoteConnectionGeneration() == 1,
        "external client join must establish identity generation")
    if (clientId == 1) {
        assert(externalRoleSendCommand(client, newGameplayProgressionCommand(
                1, 1, 1, skillId, 1, 1)) &&
            client.clientRemoteSkillRank(skillId) == 0 &&
            client.clientRemoteItemCount() == 0 &&
            client.clientRemoteWorldLootCount() == 0,
            "client one must receive its initial G3 authority baseline")
        var enemyHealthBeforeFirstShot =
            client.clientRemoteEnemyHealth(enemyId)
        assert(externalRoleSendCommand(client, newGameplayCommandMessage(
                1, 2, 2, gameplayFireAction(), enemyId,
                config.value("playerAttackDistance"),
                config.value("playerAttackCritical"), 1)) &&
            client.clientRemoteCombatActor() == enemyId &&
            client.clientRemoteCombatHealth() < enemyHealthBeforeFirstShot &&
            client.clientRemoteCombatHealth() > 0 &&
            client.clientRemoteEnemyHealth(enemyId) ==
                client.clientRemoteCombatHealth() &&
            client.clientRemoteEnemyState(enemyId) >= 0 &&
            client.clientRemoteEncounterActiveCount() == 1 &&
            client.clientRemoteImpactSequence() == 1 &&
            client.clientRemoteCurrency() == 0 &&
            client.clientRemoteDiagnostic() == gameplayFireDiagnostic() &&
            client.pendingImpactPresentations() == 1 &&
            client.dequeueImpactPresentation(),
            "client one must receive first authoritative enemy impact")
        var firstImpact = client.lastImpactPresentation()
        assert(firstImpact.targetId() == enemyId &&
            firstImpact.applied() > 0 && !firstImpact.died(),
            "first replicated impact must preserve damage identity")
        assert(externalRoleSendCommand(client, newGameplayCommandMessage(
                1, 3, 3, gameplayFireAction(), enemyId,
                config.value("playerAttackDistance"),
                config.value("playerAttackCritical"), 1)) &&
            client.clientRemoteCombatHealth() == 0 &&
            client.clientRemoteEnemyHealth(enemyId) == 0 &&
            client.clientRemoteEnemyState(enemyId) == 7 &&
            client.clientRemoteEncounterActiveCount() == 0 &&
            client.clientRemoteImpactSequence() == 2 &&
            client.clientRemoteCurrency() == config.value("enemyCurrency") &&
            client.clientRemoteSkillRank(skillId) >= 1 &&
            client.clientRemoteWorldLootCount() == 1 &&
            client.clientRemoteWorldLootStableId(0) > 0 &&
            client.clientRemoteWorldLootRank(0) > 0 &&
            client.pendingImpactPresentations() == 1 &&
            client.dequeueImpactPresentation(),
            "client one must receive terminal combat loot and progression")
        var itemId = client.clientRemoteWorldLootStableId(0)
        var terminalImpact = client.lastImpactPresentation()
        assert(terminalImpact.targetId() == enemyId &&
            terminalImpact.applied() > 0 && terminalImpact.died(),
            "terminal replicated impact must preserve death feedback")
        assert(client.predictRemoteGameplayInput(1, 4, 2, 1) &&
            client.clientRemotePredictedPosition() == 2,
            "external client must predict local movement before round trip")
        assert(externalRoleSendCommand(client, newGameplayCommandMessage(
                1, 4, 4, gameplayMoveAction(), 2, 0, 0, 1)) &&
            client.clientRemotePlayerPosition(1) == 2 &&
            client.clientRemotePredictedPosition() == 2 &&
            client.clientRemotePendingPredictionInputs() == 0 &&
            client.clientRemoteDiagnostic() == gameplayMoveDiagnostic(),
            "client one must reconcile authoritative movement")
        assert(externalRoleSendCommand(client, newGameplayPickupCommand(
                1, 5, 5, itemId, 1)) &&
            client.clientRemoteItemCount() == 1 &&
            client.clientRemoteItemId(0) == itemId &&
            client.clientRemoteWorldLootCount() == 0,
            "client one must receive authoritative pickup state")
        assert(externalRoleSendCommand(client, newGameplayEquipCommand(
                1, 6, 6, 0, itemId, 1)) &&
            client.clientRemoteEquipmentItem(0) == itemId,
            "client one must receive authoritative equipment state")
        assert(externalRoleSendCommand(client, newGameplayCommandMessage(
                1, 7, 7, gameplayInteractAction(), 1, 0, 0, 1)) &&
            client.clientWorldInteractionActive(1),
            "client one must receive key activation")
        assert(externalRoleSendCommand(client, newGameplayCommandMessage(
                1, 9, 7, gameplayInteractAction(), 3, 0, 0, 1)) &&
            client.clientRemoteDiagnostic() == gameplayStaleDiagnostic() &&
            client.clientWorldInteractionRevision() == 2,
            "client one must receive explicit stale-command diagnosis")
        assert(externalRoleSendCommand(client, newGameplayCommandMessage(
                1, 9, 8, gameplayInteractAction(), 3, 0, 0, 1)) &&
            client.clientWorldInteractionActive(3) &&
            client.clientWorldSecretCount() == 1 &&
            client.clientWorldInteractionRevision() == 3,
            "client one must receive accepted secret progression")
        println("external-player-authority-kind")
        println(playerAuthorityStateMessageKind())
        println("external-world-loot-kind")
        println(worldLootStateMessageKind())
        println("external-client-g3-item")
        println(client.clientRemoteItemId(0))
        println("external-client-g3-equipment")
        println(client.clientRemoteEquipmentItem(0))
        println("external-client-g3-skill-rank")
        println(client.clientRemoteSkillRank(skillId))
        println("external-client-g3-world-loot-count")
        println(client.clientRemoteWorldLootCount())
    } else {
        assert(client.closeRemoteSession(),
            "client two must close its first remote session")
        assert(client.configureRemoteEndpoint(
                hostFirstOctet, hostSecondOctet, hostThirdOctet, hostFourthOctet,
                hostPort,
                endpoint.keyWord(0), endpoint.keyWord(1),
                endpoint.keyWord(2), endpoint.keyWord(3)) &&
            client.openRemoteSession(),
            "client two must reopen its remote session")
        assert(externalRoleSendCommand(client, newGameplayCommandMessage(
                2, 1, 1, gameplayDisconnectAction(), 2, 0, 0, 1)) &&
            !client.clientRemoteConnected() &&
            client.clientRemoteDisconnectReason() == 2 &&
            client.clientRemoteConnectionGeneration() == 1 &&
            client.clientRemoteDiagnostic() == gameplayDisconnectDiagnostic(),
            "client two must receive bounded disconnect diagnostics")
        assert(externalRoleClientCompatibility(client, compatibility, 2),
            "client reconnect must repeat compatibility admission")
        assert(externalRoleSendCommand(client, newGameplayCommandMessage(
                2, 1, 2, gameplayReconnectAction(), 0, 0, 0, 1)) &&
            client.clientRemoteConnected() &&
            client.clientRemoteDisconnectReason() == 0 &&
            client.clientRemoteConnectionGeneration() == 2 &&
            client.clientRemoteDiagnostic() == gameplayReconnectDiagnostic(),
            "client two must receive reconnect generation")
        assert(externalRoleSendCommand(client, newGameplayCommandMessage(
                2, 8, 1, gameplayInteractAction(), 2, 0, 0, 2)) &&
            client.clientWorldInteractionActive(1) &&
            client.clientWorldInteractionActive(2) &&
            client.clientWorldInteractionRevision() == 2,
            "client two must receive key and door progression")
        assert(externalRoleSendCommand(client, newGameplayCommandMessage(
                2, 10, 2, gameplayInteractAction(), 4, 0, 0, 2)) &&
            client.clientWorldInteractionActive(3) &&
            client.clientLevelCompleted() &&
            client.clientWorldInteractionRevision() == 4,
            "client two must receive completed authoritative state")
    }
    client.closeRemoteSession()
    kookie_transport_close()
    return true
}

main() {
    var hostRole = kookie_transport_external_is_host()
    var clientARole = kookie_transport_external_is_client_a()
    var clientBRole = kookie_transport_external_is_client_b()
    if (hostRole) {
        println("external-role-host")
    } else if (clientARole) {
        println("external-role-client-a")
    } else if (clientBRole) {
        println("external-role-client-b")
    } else {
        println("external-role-default")
    }
    if (hostRole) {
        assert(externalRoleHostQualification(),
            "external host role must qualify")
    } else if (clientARole) {
        assert(externalRoleClientQualification(1),
            "external client A role must qualify")
    } else if (clientBRole) {
        assert(externalRoleClientQualification(2),
            "external client B role must qualify")
    } else {
        var arena = G1Arena()
        var config = BoundedG3Config()
        assert(config.load("config/g3/external_lan.json"),
            "external role G3 config must load")
        var compatibility = externalRoleCompatibility(
            arena,
            config.checksum(),
            config.value("extensionNetworkSchema"),
            config.value("engineVersion"),
            config.value("contentApiVersion"),
            config.value("contentGeneration"),
            config.value("contentRevision"))
        var enemyCapacity = config.value("sessionEnemyCapacity")
        var playerCapacity = config.value("sessionPlayerCapacity")
        var host = LoopbackSession(enemyCapacity, playerCapacity)
        var clientA = LoopbackSession(enemyCapacity, playerCapacity)
        var clientB = LoopbackSession(enemyCapacity, playerCapacity)
        var playerId = config.value("playerActorId")
        var enemyId = config.value("admittedEnemyId")
        var skillId = config.value("playerSkillId")
        var endpointA = RemoteSessionEndpoint(
            127, 0, 0, 1, 47101, 1, 2, 3, 4)
        var endpointB = RemoteSessionEndpoint(
            127, 0, 0, 1, 47102, 1, 2, 3, 4)
    assert(arena.ready(), "transport arena must initialize")
    assert(
        kookie_transport_max_words() == maximumSessionTransportWords(),
        "transport backend must expose matching word capacity")
    assert(endpointA.valid() && endpointB.valid(),
        "transport endpoints must initialize")
    assert(
        host.defineWorldKey(1, 2, 0, 0, 0) &&
        host.defineWorldDoor(2, 1, 4, 0, 0, 1, 2, 1, 4) &&
        host.defineWorldSecret(3, 2, 0, 0, 0) &&
        host.defineWorldExit(4, 2, 1, 0, 0, 0, 0) &&
        clientA.defineWorldKey(1, 2, 0, 0, 0) &&
        clientA.defineWorldDoor(2, 1, 4, 0, 0, 1, 2, 1, 4) &&
        clientA.defineWorldSecret(3, 2, 0, 0, 0) &&
        clientA.defineWorldExit(4, 2, 1, 0, 0, 0, 0) &&
        clientB.defineWorldKey(1, 2, 0, 0, 0) &&
        clientB.defineWorldDoor(2, 1, 4, 0, 0, 1, 2, 1, 4) &&
        clientB.defineWorldSecret(3, 2, 0, 0, 0) &&
        clientB.defineWorldExit(4, 2, 1, 0, 0, 0, 0),
        "transport sessions must define matching world state")
    assert(externalRoleConfigureG3Definition(host),
        "transport host must configure extension gameplay")
    assert(host.start() && host.connectPlayer() == 1 &&
        host.connectPlayer() == 2,
        "transport host must start with two players")
    assert(clientA.start() && clientB.start(),
        "transport clients must start")
    assert(host.loadAuthoredBroadPhase(arena.authoredCollision()) &&
        clientA.loadAuthoredBroadPhase(arena.authoredCollision()) &&
        clientB.loadAuthoredBroadPhase(arena.authoredCollision()),
        "transport sessions must configure matching authored gameplay")
    var hostPortA = 47101
    var hostPortB = 47102
    assert(kookie_transport_select_slot(0), "host slot A must select")
    assert(kookie_transport_set_key_from_environment(),
        "host slot A must authenticate")
    assert(kookie_transport_open_listen_ipv4(hostPortA),
        "host slot A must bind")
    assert(kookie_transport_select_slot(1), "host slot B must select")
    assert(kookie_transport_set_key_from_environment(),
        "host slot B must authenticate")
    assert(kookie_transport_open_listen_ipv4(hostPortB),
        "host slot B must bind")
    assert(openRemoteSlot(2, hostPortA),
        "client A must bind and target host listener A")
    var clientPortA = kookie_transport_local_port()
    assert(openRemoteSlot(3, hostPortB),
        "client B must bind and target host listener B")
    var clientPortB = kookie_transport_local_port()
    assert(clientPortA > 0 && clientPortB > 0 &&
        clientA.configureRemoteEndpoint(
            127, 0, 0, 1, hostPortA,
            endpointA.keyWord(0), endpointA.keyWord(1),
            endpointA.keyWord(2), endpointA.keyWord(3)) &&
        clientA.requireRemoteCompatibility(compatibility) &&
        clientA.openRemoteSession() &&
        clientB.configureRemoteEndpoint(
            127, 0, 0, 1, hostPortB,
            endpointB.keyWord(0), endpointB.keyWord(1),
            endpointB.keyWord(2), endpointB.keyWord(3)) &&
        clientB.requireRemoteCompatibility(compatibility) &&
        clientB.openRemoteSession(),
        "two clients must authenticate against host endpoints")
    assert(externalRoleLocalCompatibility(clientA, compatibility, 2, 0, 1) &&
        externalRoleLocalCompatibility(clientB, compatibility, 3, 1, 1),
        "two clients must complete compatibility admission")
    assert(clientA.pumpRemoteBroadPhaseSnapshot(6) &&
        clientB.pumpRemoteBroadPhaseSnapshot(7),
        "clients must stage authoritative snapshots")
    var payloadA = clientA.broadPhaseSnapshot(6, clientA.remoteSendSequence())
    var payloadB = clientB.broadPhaseSnapshot(7, clientB.remoteSendSequence())
    assert(kookie_transport_select_slot(2), "client A transport slot must select")
    assert(sendPayload(payloadA), "client A must send snapshot")
    assert(kookie_transport_select_slot(0), "host A transport slot must select")
    assert(receivePayload(host, payloadA, true),
        "host must receive client A snapshot")
    assert(kookie_transport_select_slot(3), "client B transport slot must select")
    assert(sendPayload(payloadB), "client B must send snapshot")
    assert(kookie_transport_select_slot(1), "host B transport slot must select")
    assert(receivePayload(host, payloadB, true),
        "host must receive client B snapshot")
    assert(clientB.closeRemoteSession() &&
        kookie_transport_select_slot(3) &&
        kookie_transport_set_peer_ipv4(127, 0, 0, 1, hostPortB),
        "client B must close and reopen its authenticated session")
    var reconnectClientPortB = kookie_transport_local_port()
    assert(reconnectClientPortB > 0 &&
        clientB.configureRemoteEndpoint(
            127, 0, 0, 1, hostPortB,
            endpointB.keyWord(0), endpointB.keyWord(1),
            endpointB.keyWord(2), endpointB.keyWord(3)) &&
        clientB.openRemoteSession(),
        "client B must reopen the production session link")
    assert(externalRoleLocalCompatibility(
            clientB, compatibility, 3, 1, 2),
        "client B reconnect must repeat compatibility admission")
    assert(clientB.pumpRemoteBroadPhaseSnapshot(8),
        "client B must stage its reconnect snapshot")
    var reconnectPayloadB = clientB.broadPhaseSnapshot(
        8, clientB.remoteSendSequence())
    assert(kookie_transport_select_slot(3) &&
        sendPayload(reconnectPayloadB) &&
        kookie_transport_select_slot(1) &&
        receivePayload(host, reconnectPayloadB, true),
        "host must accept client B after reconnect")
    assert(externalRoleConfigureG3Runtime(host),
        "host must configure replicated combat loot and progression")
    var state = host.gameplayStateMessage(0, enemyId, 1)
    var feedback = host.multiplayerFeedbackStateMessage(0)
    var encounter = host.enemyEncounterStateMessage(
        0, config.value("encounterId"))
    var authority = host.playerAuthorityStateMessage(0, 1)
    var loot = host.worldLootStateMessage(0, 1)
    assert(clientA.applyRemoteGameplayState(state) &&
        clientA.applyRemoteMultiplayerFeedback(feedback) &&
        clientA.applyRemoteEnemyEncounterState(encounter) &&
        clientA.applyRemotePlayerAuthorityState(authority) &&
        clientA.applyRemoteWorldLootState(loot) &&
        clientA.clientRemoteBaselineReady() &&
        clientA.clientRemotePlayer() == 1)
    state = host.gameplayStateMessage(0, enemyId, 2)
    feedback = host.multiplayerFeedbackStateMessage(0)
    encounter = host.enemyEncounterStateMessage(
        0, config.value("encounterId"))
    authority = host.playerAuthorityStateMessage(0, 2)
    loot = host.worldLootStateMessage(0, 2)
    assert(clientB.applyRemoteGameplayState(state) &&
        clientB.applyRemoteMultiplayerFeedback(feedback) &&
        clientB.applyRemoteEnemyEncounterState(encounter) &&
        clientB.applyRemotePlayerAuthorityState(authority) &&
        clientB.applyRemoteWorldLootState(loot) &&
        clientB.clientRemoteBaselineReady() &&
        clientB.clientRemotePlayer() == 2,
        "both production joins must establish all authoritative baselines")
    assert(host.applyRemoteGameplayCommand(newGameplayProgressionCommand(
        1, 1, 1, skillId, 1, 1)))
    authority = host.playerAuthorityStateMessage(1, 1)
    loot = host.worldLootStateMessage(1, 1)
    assert(clientA.applyRemotePlayerAuthorityState(authority) &&
        clientA.applyRemoteWorldLootState(loot) &&
        clientA.clientRemoteSkillRank(skillId) == 0)
    var healthBeforeShot = host.enemyCombatHealth(enemyId)
    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
        1, 2, 2, gameplayFireAction(), enemyId,
        config.value("playerAttackDistance"),
        config.value("playerAttackCritical"), 1)))
    var healthAfterFirstShot = host.enemyCombatHealth(enemyId)
    assert(healthAfterFirstShot < healthBeforeShot &&
        healthAfterFirstShot > 0)
    state = host.gameplayStateMessage(2, enemyId, 1)
    feedback = host.multiplayerFeedbackStateMessage(2)
    encounter = host.enemyEncounterStateMessage(
        2, config.value("encounterId"))
    authority = host.playerAuthorityStateMessage(2, 1)
    loot = host.worldLootStateMessage(2, 1)
    assert(clientA.applyRemoteGameplayState(state) &&
        clientA.applyRemoteMultiplayerFeedback(feedback) &&
        clientA.applyRemoteEnemyEncounterState(encounter) &&
        clientA.applyRemotePlayerAuthorityState(authority) &&
        clientA.applyRemoteWorldLootState(loot) &&
        clientA.clientRemoteCombatActor() == enemyId &&
        clientA.clientRemoteCombatHealth() == healthAfterFirstShot &&
        clientA.clientRemoteEnemyHealth(enemyId) == healthAfterFirstShot &&
        clientA.clientRemoteEncounterActiveCount() == 1 &&
        clientA.pendingImpactPresentations() == 1 &&
        clientA.dequeueImpactPresentation())
    var firstImpact = clientA.lastImpactPresentation()
    assert(firstImpact.applied() > 0 && !firstImpact.died())
    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
        1, 3, 3, gameplayFireAction(), enemyId,
        config.value("playerAttackDistance"),
        config.value("playerAttackCritical"), 1)))
    state = host.gameplayStateMessage(3, enemyId, 1)
    feedback = host.multiplayerFeedbackStateMessage(3)
    encounter = host.enemyEncounterStateMessage(
        3, config.value("encounterId"))
    authority = host.playerAuthorityStateMessage(3, 1)
    loot = host.worldLootStateMessage(3, 1)
    assert(clientA.applyRemoteGameplayState(state) &&
        clientA.applyRemoteMultiplayerFeedback(feedback) &&
        clientA.applyRemoteEnemyEncounterState(encounter) &&
        clientA.applyRemotePlayerAuthorityState(authority) &&
        clientA.applyRemoteWorldLootState(loot) &&
        clientA.clientRemoteCombatHealth() == 0 &&
        clientA.clientRemoteEnemyHealth(enemyId) == 0 &&
        clientA.clientRemoteEnemyState(enemyId) == 7 &&
        clientA.clientRemoteEncounterActiveCount() == 0 &&
        clientA.clientRemoteCurrency() == config.value("enemyCurrency") &&
        clientA.clientRemoteSkillRank(skillId) >= 1 &&
        clientA.clientRemoteWorldLootCount() == 1 &&
        clientA.clientRemoteWorldLootStableId(0) > 0 &&
        clientA.pendingImpactPresentations() == 1 &&
        clientA.dequeueImpactPresentation(),
        "server-owned combat loot and progression must replicate")
    var itemId = clientA.clientRemoteWorldLootStableId(0)
    var terminalImpact = clientA.lastImpactPresentation()
    assert(terminalImpact.applied() > 0 && terminalImpact.died())

    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
        2, 1, 1, gameplayDisconnectAction(), 2, 0, 0, 1)))
    var lifecycle = host.gameplayStateMessage(
        host.currentServerTick(), enemyId, 2)
    assert(clientB.applyRemoteGameplayState(lifecycle) &&
        !clientB.clientRemoteConnected() &&
        clientB.clientRemoteDisconnectReason() == 2)
    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
        2, 1, 2, gameplayReconnectAction(), 0, 0, 0, 1)))
    lifecycle = host.gameplayStateMessage(
        host.currentServerTick(), enemyId, 2)
    assert(clientB.applyRemoteGameplayState(lifecycle) &&
        clientB.clientRemoteConnected() &&
        clientB.clientRemoteConnectionGeneration() == 2,
        "client B lifecycle generation must replicate after reconnect")

    assert(clientA.predictRemoteGameplayInput(1, 4, 2, 1) &&
        clientA.clientRemotePredictedPosition() == 2)
    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
        1, 4, 4, gameplayMoveAction(), 2, 0, 0, 1)))
    state = host.gameplayStateMessage(4, enemyId, 1)
    assert(clientA.applyRemoteGameplayState(state) &&
        clientA.clientRemotePlayerPosition(1) == 2 &&
        clientA.clientRemotePredictedPosition() == 2 &&
        clientA.clientRemotePendingPredictionInputs() == 0)
    assert(host.applyRemoteGameplayCommand(newGameplayPickupCommand(
        1, 5, 5, itemId, 1)))
    authority = host.playerAuthorityStateMessage(5, 1)
    loot = host.worldLootStateMessage(5, 1)
    assert(clientA.applyRemotePlayerAuthorityState(authority) &&
        clientA.applyRemoteWorldLootState(loot) &&
        clientA.clientRemoteItemId(0) == itemId &&
        clientA.clientRemoteWorldLootCount() == 0)
    assert(host.applyRemoteGameplayCommand(newGameplayEquipCommand(
        1, 6, 6, 0, itemId, 1)))
    authority = host.playerAuthorityStateMessage(6, 1)
    loot = host.worldLootStateMessage(6, 1)
    assert(clientA.applyRemotePlayerAuthorityState(authority) &&
        clientA.applyRemoteWorldLootState(loot) &&
        clientA.clientRemoteEquipmentItem(0) == itemId)
    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
        1, 7, 7, gameplayInteractAction(), 1, 0, 0, 1)))
    state = host.gameplayStateMessage(7, enemyId, 1)
    assert(clientA.applyRemoteGameplayState(state) &&
        clientA.clientWorldInteractionActive(1))
    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
        2, 8, 1, gameplayInteractAction(), 2, 0, 0, 2)))
    lifecycle = host.gameplayStateMessage(8, enemyId, 2)
    assert(clientB.applyRemoteGameplayState(lifecycle) &&
        clientB.clientWorldInteractionActive(2),
        "key and door progression must replicate by authored interaction mask")
    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
        1, 9, 7, gameplayInteractAction(), 3, 0, 0, 1)) &&
        !host.lastRemoteGameplayAccepted() &&
        host.lastRemoteGameplayDiagnostic() == gameplayStaleDiagnostic())
    state = host.gameplayStateMessage(
        host.currentServerTick(), enemyId, 1)
    assert(clientA.applyRemoteGameplayState(state) &&
        clientA.clientRemoteDiagnostic() == gameplayStaleDiagnostic())
    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
        1, 9, 8, gameplayInteractAction(), 3, 0, 0, 1)))
    state = host.gameplayStateMessage(9, enemyId, 1)
    assert(clientA.applyRemoteGameplayState(state) &&
        clientA.clientWorldSecretCount() == 1)
    assert(host.applyRemoteGameplayCommand(newGameplayCommandMessage(
        2, 10, 2, gameplayInteractAction(), 4, 0, 0, 2)))
    lifecycle = host.gameplayStateMessage(10, 3, 2)
    assert(clientB.applyRemoteGameplayState(lifecycle) &&
        clientB.clientLevelCompleted() &&
        host.levelCompleted() && host.worldInteractionRevision() == 4,
        "authoritative key-door-secret-exit path must complete")
    assert(externalRoleSaveReload(host),
        "integrated external host must round-trip authoritative G3 state")


    println("external-player-authority-kind")
    println(playerAuthorityStateMessageKind())
    println("external-world-loot-kind")
    println(worldLootStateMessageKind())
    println("external-client-g3-item")
    println(clientA.clientRemoteItemId(0))
    println("external-client-g3-equipment")
    println(clientA.clientRemoteEquipmentItem(0))
    println("external-client-g3-skill-rank")
    println(clientA.clientRemoteSkillRank(skillId))
    println("external-client-g3-world-loot-count")
    println(clientA.clientRemoteWorldLootCount())
    println("external-gameplay")
    println("external-host-port-a")
    println(hostPortA)
    println("external-host-port-b")
    println(hostPortB)
    println("external-host-reconnect")
    println("external-reconnect-generation")
    println(host.playerConnectionGeneration(2))
    println("external-combat-damage")
    println(healthBeforeShot - host.enemyCombatHealth(enemyId))
    println("external-combat-death")
    println(1)
    println("external-combat-reward")
    println(host.playerCurrency(playerId))
    println("external-enemy-encounter")
    println(host.enemyEncounterActiveCount(config.value("encounterId")))
    println("external-enemy-state")
    println(host.enemyState(enemyId))
    println("external-enemy-health")
    println(host.enemyCombatHealth(enemyId))
    println("external-g3-config-checksum")
    println(config.checksum())
    println("external-impact-sequence")
    println(clientA.clientRemoteImpactSequence())
    println("external-player-position")
    println(host.serverPosition(1))
    println("external-arena-triangles")
    println(host.broadPhaseTriangleCount())
    println("external-interaction-revision")
    println(host.worldInteractionRevision())
    println("external-stale-diagnostic")
    println(gameplayStaleDiagnostic())
    var hostPayloadA = host.broadPhaseSnapshot(6, 1)
    var hostPayloadB = host.broadPhaseSnapshot(6, 1)
    assert(kookie_transport_select_slot(0) &&
        kookie_transport_set_peer_ipv4(127, 0, 0, 1, clientPortA) &&
        sendPayload(hostPayloadA) && kookie_transport_select_slot(2) &&
        receivePayload(clientA, hostPayloadA, false) &&
        kookie_transport_select_slot(1) &&
        kookie_transport_set_peer_ipv4(127, 0, 0, 1, reconnectClientPortB) &&
        sendPayload(hostPayloadB) && kookie_transport_select_slot(3) &&
        receivePayload(clientB, hostPayloadB, false) &&
        clientA.clientBroadPhaseTriangleCount() == arena.triangleCount() &&
        clientB.clientBroadPhaseTriangleCount() == arena.triangleCount(),
        "host must serve the complete authored arena to both clients")
    var clientUpperFloor = clientA.queryClientBroadPhasePath(
        clientA.clientBroadPhaseRevision(),
        SpatialPoint(24, 12, 20), SpatialPoint(24, 6, 20))
    assert(clientUpperFloor.accepted() && clientUpperFloor.collided(),
        "client arena snapshot must retain stacked-room collision")
    assert(kookie_transport_select_slot(2) &&
        kookie_transport_replay_last_datagram() &&
        kookie_transport_select_slot(0) &&
        kookie_transport_receive() == 0 &&
        kookie_transport_last_status() == 3,
        "host must reject a replayed client datagram")
    println("external-authentication-status")
    println(1)
    println("external-compatibility-handshake")
    println(compatibility.checksum())
    assert(kookie_transport_select_slot(0) &&
        kookie_transport_received_sequence_at_least(1),
        "host must inspect integrated client A sequence")
    assert(kookie_transport_select_slot(1) &&
        kookie_transport_received_sequence_at_least(2),
        "host must inspect integrated client B sequence")
    println("external-transport-sequence-a")
    println(1)
    println("external-transport-sequence-b")
    println(2)
    println("external-authenticated-two-clients")
    println("external-stale-rejection")
    clientA.closeRemoteSession()
    clientB.closeRemoteSession()
    kookie_transport_select_slot(0)
    kookie_transport_close()
    kookie_transport_select_slot(1)
    kookie_transport_close()
    kookie_transport_select_slot(2)
    kookie_transport_close()
    kookie_transport_select_slot(3)
    kookie_transport_close()
    println("KOOKIE external-style authenticated host/two-client transport verified")
    }
}
