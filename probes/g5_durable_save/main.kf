import core
import session

extern "./lib/libkookie_persistence_adapter.so" kookie_durable_publish_default(): Bool
extern "./lib/libkookie_persistence_adapter.so" kookie_durable_trace(): Int
extern "./lib/libkookie_persistence_adapter.so" kookie_durable_mode(): Int

BoundedSessionSaveCoordinator newCoordinator() {
    var session = LoopbackSession(8, 4)
    assert(session.start() && session.connectPlayer() == 1,
        "durable save probe session must start")
    return BoundedSessionSaveCoordinator(session, 12, 160)
}

Bool hasRevision(BoundedSessionSaveCoordinator coordinator, String path,
    Int revision) {
    var loaded = BoundedSaveSections(12, 160)
    return coordinator.load(path, loaded) &&
        loaded.revision() == revision &&
        loaded.find(11) >= 0 && loaded.sectionCount() > 1
}

Bool hasStagedRevision(BoundedSessionSaveCoordinator coordinator, String path,
    Int revision) {
    var loaded = BoundedSaveSections(12, 160)
    return coordinator.load(path + ".kookie-stage", loaded) &&
        loaded.revision() == revision &&
        loaded.find(11) >= 0 && loaded.sectionCount() > 1
}

main() {
    var path = "durable-save.dat"
    var coordinator = newCoordinator()
    var mode = kookie_durable_mode()
    if (mode == 0) {
        assert(coordinator.recoverInterruptedStage(path))
        assert(coordinator.stage(path, 1, 1, 1, 1) &&
            kookie_durable_publish_default() &&
            kookie_durable_trace() == 31 &&
            coordinator.confirmPublished() &&
            coordinator.restore(path, 1, 1, 1) &&
            hasRevision(coordinator, path, 1))
        println("durable-baseline-ok")
    } else if (mode == 5) {
        assert(coordinator.stage(path, 1, 1, 1, 2))
        assert(kookie_durable_publish_default())
        assert(false, "before-file-sync fault must terminate the process")
    } else if (mode == 8) {
        assert(File(path + ".kookie-stage").exists() &&
            hasStagedRevision(coordinator, path, 2) &&
            coordinator.recoverInterruptedStage(path) &&
            hasRevision(coordinator, path, 1))
        println("durable-before-file-sync-recovered")
    } else if (mode == 1) {
        assert(coordinator.stage(path, 1, 1, 1, 2))
        assert(kookie_durable_publish_default())
        assert(false, "after-file-sync fault must terminate the process")
    } else if (mode == 9) {
        assert(File(path + ".kookie-stage").exists() &&
            hasStagedRevision(coordinator, path, 2) &&
            coordinator.recoverInterruptedStage(path) &&
            hasRevision(coordinator, path, 1))
        println("durable-after-file-sync-recovered")
    } else if (mode == 2) {
        assert(coordinator.recoverInterruptedStage(path))
        assert(coordinator.stage(path, 1, 1, 1, 2))
        assert(kookie_durable_publish_default())
        assert(false, "after-rename fault must terminate the process")
    } else if (mode == 3) {
        assert(!File(path + ".kookie-stage").exists() &&
            hasRevision(coordinator, path, 2))
        assert(coordinator.stage(path, 1, 1, 1, 3) &&
            kookie_durable_publish_default() &&
            kookie_durable_trace() == 31 &&
            coordinator.confirmPublished() &&
            hasRevision(coordinator, path, 3))
        println("durable-after-rename-recovered")
    } else if (mode == 6) {
        assert(coordinator.recoverInterruptedStage(path) &&
            hasRevision(coordinator, path, 3))
        assert(coordinator.stage(path, 1, 1, 1, 4) &&
            kookie_durable_publish_default())
        assert(false, "after-directory-sync fault must terminate the process")
    } else if (mode == 7) {
        assert(!File(path + ".kookie-stage").exists() &&
            hasRevision(coordinator, path, 4))
        println("durable-after-directory-sync-recovered")
    } else if (mode == 4) {
        assert(File(path + ".kookie-stage").exists() &&
            !hasStagedRevision(coordinator, path, 4) &&
            coordinator.recoverInterruptedStage(path) &&
            !File(path + ".kookie-stage").exists() &&
            hasRevision(coordinator, path, 4))
        println("durable-torn-stage-discarded")
    } else {
        assert(false, "unknown durability probe mode")
    }
}
