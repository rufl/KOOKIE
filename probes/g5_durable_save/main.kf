import core

extern "./lib/libkookie_persistence_adapter.so" kookie_durable_publish(
    String stagingPath, String targetPath
): Bool
extern "./lib/libkookie_persistence_adapter.so" kookie_durable_trace(): Int
extern "./lib/libkookie_persistence_adapter.so" kookie_durable_mode(): Int

BoundedSaveSections saveRevision(Int revision, Int marker) {
    var sections = BoundedSaveSections(12, 160)
    var payload = new Int[3]
    payload[0] = marker
    payload[1] = revision * 7
    payload[2] = 9001
    assert(sections.setRevision(revision) && sections.put(1, 1, payload))
    return sections
}

Bool hasRevision(BoundedDurableSavePublication publication, String path,
    Int revision, Int marker) {
    var loaded = BoundedSaveSections(12, 160)
    return publication.read(path, loaded) &&
        loaded.revision() == revision && loaded.sectionCount() == 1 &&
        loaded.sectionId(0) == 1 && loaded.sectionVersion(0) == 1 &&
        loaded.sectionLength(0) == 3 && loaded.sectionValue(0, 0) == marker &&
        loaded.sectionValue(0, 1) == revision * 7 &&
        loaded.sectionValue(0, 2) == 9001
}

main() {
    var path = "durable-save.dat"
    var publication = BoundedDurableSavePublication(12, 160)
    var mode = kookie_durable_mode()
    if (mode == 0) {
        assert(publication.discardInterruptedStage(path))
        var initial = saveRevision(1, 101)
        assert(publication.stage(path, initial) &&
            kookie_durable_publish(
                publication.stagingPath(), publication.targetPath()) &&
            kookie_durable_trace() == 31 && publication.confirmPublished() &&
            hasRevision(publication, path, 1, 101))
        println("durable-baseline-ok")
    } else if (mode == 1) {
        var interrupted = saveRevision(2, 202)
        assert(publication.stage(path, interrupted) &&
            !kookie_durable_publish(
                publication.stagingPath(), publication.targetPath()) &&
            kookie_durable_trace() == 3 &&
            hasRevision(publication, path, 1, 101))
        println("durable-before-rename-recovered")
    } else if (mode == 2) {
        assert(publication.discardInterruptedStage(path))
        var renamed = saveRevision(2, 202)
        assert(publication.stage(path, renamed))
        assert(kookie_durable_publish(
            publication.stagingPath(), publication.targetPath()))
        assert(false, "after-rename fault must terminate the process")
    } else if (mode == 3) {
        assert(publication.discardInterruptedStage(path) &&
            hasRevision(publication, path, 2, 202))
        var finalSave = saveRevision(3, 303)
        assert(publication.stage(path, finalSave) &&
            kookie_durable_publish(
                publication.stagingPath(), publication.targetPath()) &&
            kookie_durable_trace() == 31 && publication.confirmPublished() &&
            hasRevision(publication, path, 3, 303))
        println("durable-after-rename-recovered")
    } else if (mode == 4) {
        assert(hasRevision(publication, path, 3, 303) &&
            publication.discardInterruptedStage(path) &&
            !File(path + ".kookie-stage").exists() &&
            hasRevision(publication, path, 3, 303))
        println("durable-torn-stage-discarded")
    } else {
        assert(false, "unknown durability probe mode")
    }
}
