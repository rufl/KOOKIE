import core
import ui

main() {
    assert(uiFontCount() == 2 &&
        uiFontDefaultBody() == uiFontJaredLite() &&
        uiFontDefaultDisplay() == uiFontPixand() &&
        uiFontName(uiFontDefaultBody()) == "Jared Lite" &&
        uiFontName(uiFontDefaultDisplay()) == "Pixand" &&
        uiGameDisplayName() == "GatoGanso" &&
        uiGameTitle() == "GATOGANSO",
        "GatoGanso must expose both default fonts")
    assert(uiFontGlyphWidth() == 4 &&
        uiFontGlyphHeight() == 7 &&
        uiFontGlyphAdvance() == 5,
        "native font metrics must preserve square glyph pixels in 16:9 UI")
    var shell = GameShell()
    assert(shell.textWidth("HP", 1) == 9 &&
        shell.textWidth("HP", 2) == 18 &&
        shell.textWidth("GATOGANSO", 1) == 44,
        "native text width must keep the corrected five-unit glyph advance")
    var frame = FrameStaging(shell.renderVertexCapacity())
    assert(shell.stage(frame, 1) && frame.stagedCount() > 0,
        "GatoGanso main shell must stage")
    var baselineChecksum = frame.checksum()
    var sawBodyFont = false
    var sawDisplayFont = false
    for (var vertex = 0; vertex < frame.stagedCount(); vertex = vertex + 1) {
        assert(frame.xAt(vertex) >= -100 &&
            frame.xAt(vertex) <= 100 &&
            frame.yAt(vertex) >= -100 &&
            frame.yAt(vertex) <= 100,
            "main shell vertices must stay inside native clip bounds")
        var resource = frame.resourceAt(vertex)
        if (resource >= uiFontResourceBase() &&
            resource < uiFontResourceBase() + uiFontResourceStride()) {
            sawBodyFont = true
        }
        if (resource >= uiFontResourceBase() + uiFontResourceStride() &&
            resource < uiFontResourceBase() + uiFontResourceStride() * 2) {
            sawDisplayFont = true
        }
    }
    assert(sawBodyFont && sawDisplayFont,
        "main shell must stage Jared Lite and Pixand resources")
    assert(frame.retire(1) &&
        shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionActivate()) &&
        shell.screen() == gameShellScreenOptions(),
        "font UI probe must enter the options screen")
    var optionsFrame = FrameStaging(shell.renderVertexCapacity())
    assert(shell.stage(optionsFrame, 2),
        "options screen must stage before text-size changes")
    var optionsBaselineChecksum = optionsFrame.checksum()
    assert(optionsFrame.retire(2))
    assert(shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionRight()) &&
        shell.textSize() == 3 &&
        shell.stage(optionsFrame, 3) &&
        optionsFrame.checksum() != optionsBaselineChecksum &&
        optionsFrame.retire(3),
        "text-size changes must alter live staged UI geometry")
    println("KOOKIE G9 GatoGanso font defaults verified")
}
