import ui

main() {
    assert(kookieUiFontName(kookieUiFontBody()) == "Jared Lite" &&
        kookieUiFontName(kookieUiFontDisplay()) == "Pixand" &&
        kookieUiFontSource(kookieUiFontBody()) == "fonts/jared-lite.ttf" &&
        kookieUiFontSource(kookieUiFontDisplay()) == "fonts/pixand.ttf",
        "Kookie UI must expose the packaged body and display fonts")

    var svg = kookieUiPublishedUiGatogansoMark()
    var png = kookieUiPublishedUiPlayerHearts()
    var invalid = KookieUiAsset(
        svg.id(),
        svg.source(),
        kookieUiAssetPng(),
        svg.alt(),
        svg.checksum())
    var missingAlt = KookieUiAsset(
        svg.id(),
        svg.source(),
        kookieUiAssetSvg(),
        "",
        svg.checksum())
    var invalidChecksum = KookieUiAsset(
        svg.id(),
        svg.source(),
        kookieUiAssetSvg(),
        svg.alt(),
        "not-a-sha256")
    var invalidPath = KookieUiAsset(
        svg.id(),
        "../assets/ui/gatoganso-mark.svg",
        kookieUiAssetSvg(),
        svg.alt(),
        svg.checksum())
    var invalidId = KookieUiAsset(
        "",
        svg.source(),
        kookieUiAssetSvg(),
        svg.alt(),
        svg.checksum())
    var invalidDotPath = KookieUiAsset(
        svg.id(),
        "assets/./ui/gatoganso-mark.svg",
        kookieUiAssetSvg(),
        svg.alt(),
        svg.checksum())
    assert(svg.accepted() && svg.isSvg() &&
        svg.id().length() > 0 && svg.source().length() > 0 &&
        svg.alt().length() > 0 && svg.checksum().length() == 64 &&
        png.accepted() && png.isPng() &&
        !invalid.accepted() && !missingAlt.accepted() &&
        !invalidChecksum.accepted() && !invalidPath.accepted() &&
        !invalidId.accepted() && !invalidDotPath.accepted(),
        "Kookie UI must validate IDs, checksums, kinds, extensions, and alt text")

    var icon = KookieUiIcon("heart", 64)
    assert(kookieUiIconSupported(icon.name()) && icon.size() == 48,
        "Kookie UI icons must use the bounded SVG icon set")
    icon.setAccent()

    var title = KookieUiText(
        "GATOGANSO", kookieUiTextRoleDisplay(), 32, true,
        kookieUiForeground())
    var body = KookieUiText(
        "SVG + PNG UI assets", kookieUiTextRoleBody(), 16, false,
        kookieUiMuted())
    assert(title.role() == kookieUiTextRoleDisplay() &&
        title.size() == 32 && body.role() == kookieUiTextRoleBody() &&
        body.text() == "SVG + PNG UI assets",
        "Kookie UI text must retain role, size, weight, and content")
    body.setText("SVG + PNG assets ready")
    assert(body.text() == "SVG + PNG assets ready",
        "Kookie UI text must update without replacing its handle")

    var document = KookieUiDocument("GatoGanso UI", 960, 540)
    var panel = View(kookieUiRootStyle())
    var column = Column(listOf(title.widget(), body.widget()))
    panel.bind(column)
    assert(document.bindView(panel) &&
        document.bindIcon(icon) &&
        document.bindIconDescription(icon) &&
        document.bindAsset(svg, 32) &&
        document.bindAssetDescription(svg) &&
        document.bindAsset(png, 48) &&
        document.bindAssetDescription(png) &&
        document.boundCount() == 7 &&
        document.show() && document.shown(),
        "Kookie UI document must compose text, SVG, PNG, and icon nodes")
    assert(document.close() && !document.shown(),
        "Kookie UI document must close deterministically")
    var screens = KookieUiDocument("GatoGanso screens", 960, 540)
    assert(screens.bindMenu(
            "GATOGANSO", "OLD SCHOOL COOP", "ARROWS ENTER ESC") &&
        screens.bindHud("HP 100", "AMMO 3", "BAG 0/8", "XP 0/1") &&
        screens.boundCount() == 2 && screens.show() && screens.shown(),
        "Kookie UI must compose reusable menu and HUD views")
    var layout = kookieUiColumnLayout(8, 12)
    assert(layout.direction() == kookieUiLayoutColumn() &&
        layout.gap() == 8 && layout.padding() == 12 &&
        layout.setFill(true, true) && layout.fillWidth() && layout.fillHeight(),
        "Kookie UI layout must retain bounded direction, spacing and fill semantics")

    var componentPanel = KookieUiPanel(kookieUiPanelRaised(), layout)
    var layoutView = KookieUiLayout(layout)
    var action = KookieUiButton("PLAY", kookieUiButtonPrimary())
    var field = KookieUiTextField("Player name", "Gato")
    var toggle = KookieUiToggle("Audio", true)
    var slider = KookieUiSlider(0, 100, 10, 40)
    var progress = KookieUiProgressBar(0, 100, 75)
    var badge = KookieUiBadge("READY", kookieUiComponentColorSuccess())
    var toolbar = KookieUiToolbar(2)
    var tabs = KookieUiTabs(3)
    var inspector = KookieUiInspector(4)
    assert(field.setValue("Ganso") && field.value() == "Ganso" &&
        toggle.checked() && toggle.setChecked(false) && !toggle.checked() &&
        slider.setValue(80) && slider.value() == 80 &&
        progress.setValue(90) && progress.value() == 90 &&
        badge.setText("LIVE") && badge.text() == "LIVE" &&
        toolbar.add(action) && toolbar.count() == 1 &&
        tabs.addTab("World") && tabs.addTab("Inspector") &&
        tabs.selected() == 0 && tabs.select(1) && tabs.selected() == 1 &&
        inspector.addEntry("Position", "0, 0, 0") && inspector.count() == 1,
        "Kookie UI widgets must expose bounded state transitions")
    var componentContent = Column(listOf(
        field.widget(), toggle.widget(), slider.widget(), progress.widget(),
        badge.widget(), toolbar.widget(), tabs.widget(), inspector.widget()))
    assert(componentPanel.bindColumn(componentContent) &&
        layoutView.bindView(componentPanel.widget()) &&
        !action.consumePressed(),
        "Kookie UI components must compose through the shared layout and panel")


    println("KOOKIE G10 reusable layout and widget system verified")
    println("KOOKIE G10 internal Kof/KofJS UI library verified")
}
