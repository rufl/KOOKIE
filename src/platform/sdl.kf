package platform

extern "/usr/lib/libSDL3.so" SDL_GetVersion(): Int
extern "/usr/lib/libSDL3.so" SDL_Init(Int flags): Bool
extern "/usr/lib/libSDL3.so" SDL_Quit(): void

class SdlLifecycle {
    Bool initialized

    public constructor() {
        this.initialized = false
    }

    Bool initialize(Int flags) {
        if (initialized) {
            return true
        }
        if (flags < 0) {
            return false
        }
        initialized = SDL_Init(flags)
        return initialized
    }

    Bool isInitialized() {
        return initialized
    }

    void shutdown() {
        if (initialized) {
            SDL_Quit()
            initialized = false
        }
    }
}
