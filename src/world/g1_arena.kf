package world

import core

Int g1ArenaMaxX() { return 320 }
Int g1ArenaMaxY() { return 24 }
Int g1ArenaMaxZ() { return 280 }
Int g1ArenaWallThickness() { return 4 }

class G1Arena {
    BoundedAuthoredCollision authoredValue
    BoundedTriangleCollection collisionValue
    BoundedTriangleContactController contactValue
    Bool readyValue

    public constructor() {
        authoredValue = BoundedAuthoredCollision(160, 192)
        collisionValue = BoundedTriangleCollection(192, 64)
        contactValue = BoundedTriangleContactController(
            collisionValue, 1, 64, 60, 2)
        readyValue = buildArena()
    }


    Bool appendQuad(
        Int ax, Int ay, Int az,
        Int bx, Int by, Int bz,
        Int cx, Int cy, Int cz,
        Int dx, Int dy, Int dz,
        Int surface
    ) {
        var base = authoredValue.vertexCount()
        return authoredValue.addVertex(ax, ay, az) &&
            authoredValue.addVertex(bx, by, bz) &&
            authoredValue.addVertex(cx, cy, cz) &&
            authoredValue.addVertex(dx, dy, dz) &&
            appendIndexedQuad(base, base + 1, base + 2, base + 3, surface)
    }

    Bool appendIndexedQuad(
        Int a, Int b, Int c, Int d, Int surface
    ) {
        return authoredValue.addTriangle(a, b, c, surface) &&
            authoredValue.addTriangle(a, c, d, surface)
    }

    Bool appendBox(
        Int left, Int bottom, Int front,
        Int right, Int top, Int back,
        Int surface
    ) {
        var base = authoredValue.vertexCount()
        if (!authoredValue.addVertex(left, bottom, front) ||
            !authoredValue.addVertex(right, bottom, front) ||
            !authoredValue.addVertex(right, top, front) ||
            !authoredValue.addVertex(left, top, front) ||
            !authoredValue.addVertex(left, bottom, back) ||
            !authoredValue.addVertex(right, bottom, back) ||
            !authoredValue.addVertex(right, top, back) ||
            !authoredValue.addVertex(left, top, back)) {
            return false
        }
        return appendIndexedQuad(
                base, base + 1, base + 2, base + 3, surface) &&
            appendIndexedQuad(
                base + 5, base + 4, base + 7, base + 6, surface) &&
            appendIndexedQuad(
                base + 4, base, base + 3, base + 7, surface) &&
            appendIndexedQuad(
                base + 1, base + 5, base + 6, base + 2, surface) &&
            appendIndexedQuad(
                base + 3, base + 2, base + 6, base + 7, surface) &&
            appendIndexedQuad(
                base + 4, base + 5, base + 1, base, surface)
    }


    Bool buildArena() {
        var maxX = g1ArenaMaxX()
        var maxY = g1ArenaMaxY()
        var maxZ = g1ArenaMaxZ()
        var thickness = g1ArenaWallThickness()
        if (!authoredValue.configure(
                101, 1001, 3, 1, 100,
                0, -4, 0, maxX, maxY, maxZ)) {
            return false
        }

        // One continuous floor keeps movement deterministic; the liquid
        // sectors overlay its central and eastern lanes.
        if (!appendQuad(
                0, 0, 0, maxX, 0, 0, maxX, 0, maxZ, 0, 0, maxZ, 1)) {
            return false
        }

        // A dark perimeter frames the arena while preserving an open roof.
        if (!appendBox(
                0, 0, 0, thickness, maxY, maxZ, 8) ||
            !appendBox(
                maxX - thickness, 0, 0, maxX, maxY, maxZ, 8) ||
            !appendBox(
                thickness, 0, 0, maxX - thickness, maxY, thickness, 8) ||
            !appendBox(
                thickness, 0, maxZ - thickness,
                maxX - thickness, maxY, maxZ, 8)) {
            return false
        }

        // Two raised crossings turn the central pool into a four-way combat
        // junction instead of a dead zone.
        if (!appendBox(92, 6, 146, 228, 9, 158, 5) ||
            !appendBox(154, 6, 92, 166, 9, 212, 5) ||
            // The east channel has a second route above the water.
            !appendBox(228, 6, 66, 308, 9, 78, 5)) {
            return false
        }

        // Upper side lanes create height changes without sealing the ground
        // loop. Their open undersides preserve alternate escape routes.
        if (!appendBox(36, 8, 64, 96, 11, 216, 6) ||
            !appendBox(224, 8, 64, 284, 11, 216, 6)) {
            return false
        }

        // Covered galleries contrast with the open central sky court.
        if (!appendBox(48, 16, 16, 272, 18, 48, 7) ||
            !appendBox(48, 16, 232, 272, 18, 264, 7)) {
            return false
        }

        // Tall colored towers provide vertical cover and readable landmarks.
        if (!appendBox(64, 0, 112, 88, 14, 136, 4) ||
            !appendBox(232, 0, 144, 256, 14, 168, 4)) {
            return false
        }

        // Low center cover breaks long sight lines while leaving four exits.
        if (!appendBox(112, 0, 72, 132, 5, 92, 3) ||
            !appendBox(188, 0, 184, 208, 5, 204, 3)) {
            return false
        }

        // Short ramps and ledges make the upper lanes reachable and keep
        // vertical combat readable from the open court.
        if (!appendQuad(
                20, 0, 56, 20, 0, 80, 40, 8, 80, 40, 8, 56, 6) ||
            !appendQuad(
                280, 8, 200, 280, 8, 224, 300, 0, 224, 300, 0, 200, 6) ||
            !appendQuad(
                116, 5, 76, 140, 5, 76, 140, 5, 96, 116, 5, 96, 4) ||
            !appendQuad(
                180, 5, 184, 204, 5, 184, 204, 5, 204, 180, 5, 204, 4)) {
            return false
        }

        return authoredValue.seal() && authoredValue.validate() &&
            collisionValue.replaceWithAuthored(authoredValue)
    }

    Bool ready() {
        return readyValue
    }

    BoundedAuthoredCollision authoredCollision() {
        return authoredValue
    }

    BoundedTriangleCollection collisionGeometry() {
        return collisionValue
    }

    Int authoredChecksum() {
        return authoredValue.checksum()
    }

    Int vertexCount() {
        return authoredValue.vertexCount()
    }

    Int triangleCount() {
        return authoredValue.triangleCount()
    }

    Int triangleCapacity() {
        return collisionValue.triangleCapacity()
    }

    Int renderVertexCount() {
        return authoredValue.triangleCount() * 3
    }

    SegmentCollisionResult query(
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ
    ) {
        return collisionValue.query(
            startX, startY, startZ, endX, endY, endZ)
    }
    SegmentCollisionResult queryPath(SpatialPoint start, SpatialPoint end) {
        return collisionValue.query(
            start.x(), start.y(), start.z(),
            end.x(), end.y(), end.z())
    }


    TriangleContactResult move(
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ
    ) {
        return contactValue.move(
            startX, startY, startZ, endX, endY, endZ)
    }
    TriangleContactResult movePath(SpatialPoint start, SpatialPoint end) {
        return contactValue.move(
            start.x(), start.y(), start.z(),
            end.x(), end.y(), end.z())
    }


    Int lastHitSurface() {
        var triangle = collisionValue.lastHitTriangle()
        if (triangle < 0) {
            return 0
        }
        return authoredValue.triangleSurface(triangle)
    }

    Int clampScreen(Int value) {
        if (value < -98) {
            return -98
        }
        if (value > 98) {
            return 98
        }
        return value
    }

    Int clampDepth(Int value) {
        if (value < 1) {
            return 1
        }
        if (value > 99) {
            return 99
        }
        return value
    }

    Int projectX(Int x, Int z, CameraState camera) {
        return clampScreen(camera.projectScreenX(x, 0, z))
    }

    Int projectY(Int x, Int y, Int z, CameraState camera) {
        return clampScreen(camera.projectScreenY(x, y, z))
    }

    Int projectDepthAt(
        Int x, Int y, Int z, CameraState camera
    ) {
        var depth = camera.projectScreenDepth(x, y, z)
        return clampDepth(depth)
    }
    Bool stageWorld(
        FrameStaging target, Int frame, Int resourceBase
    ) {
        if (!readyValue || resourceBase <= 0 ||
            target.vertexCapacity() < renderVertexCount() ||
            !target.begin(frame)) {
            return false
        }
        for (var triangle = 0;
            triangle < authoredValue.triangleCount();
            triangle = triangle + 1) {
            var surface = authoredValue.triangleSurface(triangle)
            for (var corner = 0; corner < 3; corner = corner + 1) {
                var vertex = authoredValue.triangleVertex(triangle, corner)
                var x = authoredValue.vertexCoordinate(vertex, 0)
                var y = authoredValue.vertexCoordinate(vertex, 1)
                var z = authoredValue.vertexCoordinate(vertex, 2)
                var u = if (corner == 1) 100 else 0
                var v = if (corner == 2) 100 else 0
                if (!target.pushWorldVertex(
                        resourceBase + surface - 1,
                        x, y, z, u, v)) {
                    target.discard()
                    return false
                }
            }
        }
        return target.publish()
    }

    Bool stage(
        FrameStaging target, Int frame, Int resourceBase, CameraState camera
    ) {
        if (!readyValue || resourceBase <= 0 ||
            target.vertexCapacity() < renderVertexCount() ||
            !target.begin(frame)) {
            return false
        }
        for (var triangle = 0;
            triangle < authoredValue.triangleCount();
            triangle = triangle + 1) {
            var surface = authoredValue.triangleSurface(triangle)
            for (var corner = 0; corner < 3; corner = corner + 1) {
                var vertex = authoredValue.triangleVertex(triangle, corner)
                var x = authoredValue.vertexCoordinate(vertex, 0)
                var y = authoredValue.vertexCoordinate(vertex, 1)
                var z = authoredValue.vertexCoordinate(vertex, 2)
                if (!target.pushVertexDepth(
                        resourceBase + surface - 1,
                        projectX(x, z, camera),
                        projectY(x, y, z, camera),
                        projectDepthAt(x, y, z, camera),
                        corner * 50, surface * 12)) {
                    target.discard()
                    return false
                }
            }
        }
        return target.publish()
    }
}
