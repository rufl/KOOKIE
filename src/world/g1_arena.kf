package world

import core

class G1Arena {
    BoundedAuthoredCollision authoredValue
    BoundedTriangleCollection collisionValue
    BoundedTriangleContactController contactValue
    Bool readyValue

    public constructor() {
        authoredValue = BoundedAuthoredCollision(96, 32)
        collisionValue = BoundedTriangleCollection(32, 256)
        contactValue = BoundedTriangleContactController(
            collisionValue, 1, 64, 60, 2)
        readyValue = buildArena()
    }

    Bool appendTriangle(
        Int ax, Int ay, Int az,
        Int bx, Int by, Int bz,
        Int cx, Int cy, Int cz,
        Int surface
    ) {
        var base = authoredValue.vertexCount()
        return authoredValue.addVertex(ax, ay, az) &&
            authoredValue.addVertex(bx, by, bz) &&
            authoredValue.addVertex(cx, cy, cz) &&
            authoredValue.addTriangle(base, base + 1, base + 2, surface)
    }

    Bool appendQuad(
        Int ax, Int ay, Int az,
        Int bx, Int by, Int bz,
        Int cx, Int cy, Int cz,
        Int dx, Int dy, Int dz,
        Int surface
    ) {
        return appendTriangle(
                ax, ay, az, bx, by, bz, cx, cy, cz, surface) &&
            appendTriangle(
                ax, ay, az, cx, cy, cz, dx, dy, dz, surface)
    }

    Bool buildArena() {
        if (!authoredValue.configure(
                101, 1001, 2, 1, 100,
                0, -4, 0, 160, 20, 140)) {
            return false
        }

        // Large open-sky arena floor: 160 by 140 world units.
        if (!appendQuad(
                0, 0, 0, 160, 0, 0, 160, 0, 140, 0, 0, 140, 6)) {
            return false
        }

        // Four perimeter walls leave the sky open while keeping combat inside.
        if (!appendQuad(
                0, 0, 0, 0, 20, 0, 0, 20, 140, 0, 0, 140, 8) ||
            !appendQuad(
                160, 0, 140, 160, 20, 140, 160, 20, 0, 160, 0, 0, 8) ||
            !appendQuad(
                0, 0, 0, 160, 0, 0, 160, 20, 0, 0, 20, 0, 8) ||
            !appendQuad(
                160, 0, 140, 0, 0, 140, 0, 20, 140, 160, 20, 140, 8)) {
            return false
        }

        // Central cross-corridor: four room mouths connect through a wide hub.
        if (!appendQuad(
                80, 0, 0, 80, 20, 0, 80, 20, 48, 80, 0, 48, 3) ||
            !appendQuad(
                80, 0, 92, 80, 20, 92, 80, 20, 140, 80, 0, 140, 3) ||
            !appendQuad(
                0, 0, 70, 0, 20, 70, 50, 20, 70, 50, 0, 70, 4) ||
            !appendQuad(
                110, 0, 70, 110, 20, 70, 160, 20, 70, 160, 0, 70, 4)) {
            return false
        }

        // Offset partitions make six distinct rooms without dead ends.
        if (!appendQuad(
                40, 0, 100, 40, 20, 100, 40, 20, 140, 40, 0, 140, 5) ||
            !appendQuad(
                120, 0, 0, 120, 20, 0, 120, 20, 40, 120, 0, 40, 5)) {
            return false
        }

        // Two L-shaped cover pillars sit in the central hub.
        if (!appendQuad(
                58, 0, 54, 58, 12, 54, 58, 12, 64, 58, 0, 64, 2) ||
            !appendQuad(
                58, 0, 54, 58, 12, 54, 68, 12, 54, 68, 0, 54, 7) ||
            !appendQuad(
                94, 0, 78, 94, 12, 78, 94, 12, 88, 94, 0, 88, 2) ||
            !appendQuad(
                94, 0, 88, 94, 12, 88, 104, 12, 88, 104, 0, 88, 7)) {
            return false
        }

        return authoredValue.seal() && authoredValue.validate() &&
            collisionValue.replaceWithAuthored(authoredValue)
    }

    Bool ready() {
        return readyValue
    }

    BoundedAuthoredCollision authoredCollision() {
        return authoredValue
    }

    Int authoredChecksum() {
        return authoredValue.checksum()
    }

    Int vertexCount() {
        return authoredValue.vertexCount()
    }

    Int triangleCount() {
        return authoredValue.triangleCount()
    }

    Int triangleCapacity() {
        return collisionValue.triangleCapacity()
    }

    Int renderVertexCount() {
        return authoredValue.triangleCount() * 3
    }

    SegmentCollisionResult query(
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ
    ) {
        return collisionValue.query(
            startX, startY, startZ, endX, endY, endZ)
    }
    SegmentCollisionResult queryPath(SpatialPoint start, SpatialPoint end) {
        return collisionValue.query(
            start.x(), start.y(), start.z(),
            end.x(), end.y(), end.z())
    }


    TriangleContactResult move(
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ
    ) {
        return contactValue.move(
            startX, startY, startZ, endX, endY, endZ)
    }
    TriangleContactResult movePath(SpatialPoint start, SpatialPoint end) {
        return contactValue.move(
            start.x(), start.y(), start.z(),
            end.x(), end.y(), end.z())
    }


    Int lastHitSurface() {
        var triangle = collisionValue.lastHitTriangle()
        if (triangle < 0) {
            return 0
        }
        return authoredValue.triangleSurface(triangle)
    }

    Int clampScreen(Int value) {
        if (value < -98) {
            return -98
        }
        if (value > 98) {
            return 98
        }
        return value
    }

    Int clampDepth(Int value) {
        if (value < 1) {
            return 1
        }
        if (value > 99) {
            return 99
        }
        return value
    }

    Int viewDepth(Int x, Int y, Int z) {
        var depth = 64 - (x + z) / 2 + y / 2
        if (depth < 32) {
            return 32
        }
        if (depth > 64) {
            return 64
        }
        return depth
    }

    Int projectX(Int x, Int z, CameraState camera) {
        var depth = viewDepth(x, 0, z)
        var centered = (x - z) * 3 - 6
        return clampScreen(centered * 51 / depth +
            camera.currentYaw() / 10)
    }

    Int projectY(Int x, Int y, Int z, CameraState camera) {
        var depth = viewDepth(x, y, z)
        var centered = (x + z) * 2 - y * 6 - 36
        return clampScreen(centered * 51 / depth -
            camera.currentPitch() / 10)
    }

    Int projectDepth(Int x, Int y, Int z) {
        return clampDepth(viewDepth(x, y, z) * 100 / 80)
    }
    Bool stageWorld(
        FrameStaging target, Int frame, Int resourceBase
    ) {
        if (!readyValue || resourceBase <= 0 ||
            target.vertexCapacity() < renderVertexCount() ||
            !target.begin(frame)) {
            return false
        }
        for (var triangle = 0;
            triangle < authoredValue.triangleCount();
            triangle = triangle + 1) {
            var surface = authoredValue.triangleSurface(triangle)
            for (var corner = 0; corner < 3; corner = corner + 1) {
                var vertex = authoredValue.triangleVertex(triangle, corner)
                var x = authoredValue.vertexCoordinate(vertex, 0)
                var y = authoredValue.vertexCoordinate(vertex, 1)
                var z = authoredValue.vertexCoordinate(vertex, 2)
                var u = if (corner == 1) 100 else 0
                var v = if (corner == 2) 100 else 0
                if (!target.pushWorldVertex(
                        resourceBase + surface - 1,
                        x, y, z, u, v)) {
                    target.discard()
                    return false
                }
            }
        }
        return target.publish()
    }

    Bool stage(
        FrameStaging target, Int frame, Int resourceBase, CameraState camera
    ) {
        if (!readyValue || resourceBase <= 0 ||
            target.vertexCapacity() < renderVertexCount() ||
            !target.begin(frame)) {
            return false
        }
        for (var triangle = 0;
            triangle < authoredValue.triangleCount();
            triangle = triangle + 1) {
            var surface = authoredValue.triangleSurface(triangle)
            for (var corner = 0; corner < 3; corner = corner + 1) {
                var vertex = authoredValue.triangleVertex(triangle, corner)
                var x = authoredValue.vertexCoordinate(vertex, 0)
                var y = authoredValue.vertexCoordinate(vertex, 1)
                var z = authoredValue.vertexCoordinate(vertex, 2)
                if (!target.pushVertexDepth(
                        resourceBase + surface - 1,
                        projectX(x, z, camera),
                        projectY(x, y, z, camera),
                        projectDepth(x, y, z),
                        corner * 50, surface * 12)) {
                    target.discard()
                    return false
                }
            }
        }
        return target.publish()
    }
}
