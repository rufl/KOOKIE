    assert(loopback.encodeReplayCheckpoint(checkpoint))
    var timeline = BoundedReplayTimeline(2, 2)
    assert(timeline.appendCheckpointSnapshot(0, 202, checkpoint) &&
        loopback.resolvePlayerHitscan(1, 2, 1, 1, 0).accepted() &&
        loopback.playerCombatHealth(2) == 80 &&
        loopback.applyReplayCheckpoint(timeline, 1) &&
        loopback.playerCombatHealth(2) == 90 &&
        loopback.playerCombatMagazine(1) == 2,
        "combat checkpoint restore must rewind health and ammunition")
}
test "loopback replay restores progression checkpoint state" {
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1 &&
        loopback.definePlayerSkill(30, 2, 100) &&
        loopback.setPlayerSkillActivation(30, 20, 5) &&
        loopback.learnPlayerSkill(1, 30) &&
        loopback.gainPlayerSkillExperience(1, 30, 125) &&
        loopback.setPlayerSkillResource(1, 100) &&
        loopback.activatePlayerSkill(1, 30, 0).accepted() &&
        loopback.playerSkillResource(1) == 80 &&
        loopback.definePlayerStatus(40, 10, 3) &&
        loopback.applyPlayerStatus(1, 40, 5, 2) &&
        loopback.playerStatusDuration(1, 40) == 5)
    var checkpoint = new Int[loopback.replayCheckpointLength()]
    assert(loopback.encodeReplayCheckpoint(checkpoint))
    var timeline = BoundedReplayTimeline(2, 2)
    assert(timeline.appendCheckpointSnapshot(0, 303, checkpoint) &&
        loopback.setPlayerSkillResource(1, 1) &&
        loopback.advance(16667) == 1 &&
        loopback.playerStatusDuration(1, 40) == 4)
    var progressionApplied = loopback.applyReplayCheckpoint(timeline, 1)
    assert(progressionApplied, "progression checkpoint must apply")
    assert(loopback.playerSkillResource(1) == 80,
        "progression resource must rewind")
    assert(loopback.playerSkillCooldown(1, 30, 0) == 5,
        "progression cooldown must rewind")
    assert(loopback.playerStatusDuration(1, 40) == 5,
        "progression duration must rewind")
    assert(loopback.playerStatusStacks(1, 40) == 2,
        "progression stacks must rewind")
}
test "bounded inventory equipment replay state" {
    var inventory = BoundedItemInventory(1, 4)
    var equipment = BoundedEquipmentLoadout(2)
    assert(inventory.addItem(500, 2) &&
        inventory.setCurrency(100) &&
        equipment.equip(inventory, 0, 500))
    var inventoryState = new Int[inventory.replayStateLength()]
    var world = BoundedTriangleCollection(4, 20)
    var worldState = new Int[world.replayStateLength()]
    var equipmentState = new Int[equipment.replayStateLength()]
    assert(world.configureBounds(0, 0, 0, 10, 10, 10) &&
        world.addTriangle(0, 0, 0, 1, 0, 0, 0, 0, 1) &&
        inventory.encodeReplayState(inventoryState) &&
        equipment.encodeReplayState(equipmentState) &&
        world.encodeReplayState(worldState) &&
        inventory.setCurrency(1) &&
        inventory.addItem(501, 1) &&
        equipment.unequip(0) &&
        world.clearTriangles() &&
        inventory.restoreReplayState(inventoryState) &&
        equipment.restoreReplayState(equipmentState, inventory) &&
        world.restoreReplayState(worldState) &&
        inventory.currency() == 100 &&
        inventory.itemQuantity(0) == 2 &&
        inventory.itemId(0) == 500 &&
        equipment.itemAt(0) == 500 &&
        world.triangleCount() == 1,
        "inventory, equipment and world replay state must restore deterministically")
}

test "loopback replay sidecar restores inventory and world state" {
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() &&
        loopback.connectPlayer() == 1 &&
        loopback.addPlayerItem(1, 500, 2) &&
        loopback.setPlayerCurrency(1, 100) &&
        loopback.equipPlayerItem(1, 0, 500) &&
        loopback.addBroadPhaseTriangle(
            0, 0, 0, 1, 0, 0, 0, 0, 1))
    assert(loopback.recordReplayPresentation(
            0, 1, 7, 1, 0, 500, 9, 2, 1, 0, 0, 1),
        "replay sidecar must accept presentation history")
    var timeline = BoundedReplayTimeline(4, 2)
    var checkpoint = new Int[loopback.replayCheckpointLength()]
    var sidecar = new Int[loopback.replaySidecarLength()]
    assert(loopback.encodeReplayCheckpoint(checkpoint),
        "atomic replay checkpoint encode must succeed")
    assert(loopback.encodeReplaySidecar(sidecar),
        "atomic replay sidecar encode must succeed")
    assert(timeline.appendCheckpointBundle(0, 17, checkpoint, sidecar),
        "atomic replay bundle must append")
    assert(loopback.setPlayerCurrency(1, 1) &&
        loopback.addPlayerItem(1, 501, 1) &&
        loopback.removeBroadPhaseTriangle(0),
        "atomic replay bundle mutation must apply")
    assert(loopback.applyReplayCheckpointBundle(timeline, 0),
        "atomic replay bundle must restore")
    assert(loopback.playerCurrency(1) == 100 &&
        loopback.playerItemQuantity(1, 500) == 2 &&
        loopback.playerItemQuantity(1, 501) == 0 &&
        loopback.playerEquipmentItem(1, 0) == 500 &&
        loopback.broadPhaseTriangleCount() == 1 &&
        loopback.replayPresentationCount() == 1 &&
        loopback.replayPresentationAt(0).valueOne() == 500,
        "atomic replay bundle must restore inventory world and presentation state")
}

test "loopback replay restores enemy combat checkpoint state" {
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() &&
        loopback.defineEnemyWeapon(31, 3, 0, 10, 0) &&
        loopback.setEnemyWeaponRange(31, 20) &&
        loopback.defineEnemyEncounter(4, 2, 100) &&
        loopback.configureEnemyRules(50, 10, 2) &&
        loopback.addEnemyCombatActor(1, 1000, 0) &&
        loopback.equipEnemyCombatWeapon(1, 31) &&
        loopback.admitEnemy(4, 100, 100, 0, 31) &&
        loopback.setEnemySpatialPosition(100, 20, 0, 0) &&
        loopback.configureEnemyPerception(100, 1, true, 20, 0) &&
        loopback.advanceEnemyTick(0) &&
        loopback.enemyState(100) == 3 &&
        loopback.enemySpatialPositionX(100) == 20 &&
        loopback.enemyEncounterActiveCount(4) == 1 &&
        loopback.enemyEncounterRemainingBudget(4) == 99)
    var first = loopback.resolveEnemyHitscan(1, 100, 0, 1, 0)
    assert(first.accepted() && first.remainingHealth() == 90)
    assert(loopback.setEnemySpatialPosition(1, 0, 0, 0) &&
        loopback.spawnEnemyProjectileSpatial(
            1, 100, 0, 20, 3, 0).accepted(),
        "enemy projectile must spawn before checkpoint")
    var checkpoint = new Int[loopback.replayCheckpointLength()]
    assert(loopback.encodeReplayCheckpoint(checkpoint))
    var timeline = BoundedReplayTimeline(2, 2)
    assert(timeline.appendCheckpointSnapshot(0, 404, checkpoint) &&
        loopback.setEnemySpatialPosition(100, 30, 0, 0) &&
        loopback.resolveEnemyHitscan(1, 100, 1, 1, 0).remainingHealth() == 80)
    var enemyApplied = loopback.applyReplayCheckpoint(timeline, 1)
    assert(enemyApplied, "enemy checkpoint must apply")
    assert(loopback.activeEnemyProjectiles() == 1,
        "enemy projectile must rewind")
    assert(loopback.pendingImpactPresentations() == 0 &&
        loopback.pendingImpactAudio() == 0,
        "enemy presentation queues must reset")
    assert(loopback.enemyState(100) == 3 &&
        loopback.enemySpatialPositionX(100) == 20 &&
        loopback.enemyEncounterActiveCount(4) == 1 &&
        loopback.enemyEncounterRemainingBudget(4) == 99,
        "enemy AI spatial and encounter state must rewind")
    var restored = loopback.resolveEnemyHitscan(1, 100, 2, 1, 0)
    assert(restored.accepted() && restored.remainingHealth() == 80,
        "enemy world checkpoint restore must rewind combat and projectile state")
}





test "bounded replay wire and file codecs" {
    var replay = InputReplayRecorder(2)
    assert(replay.append(InputCommand(4, 1, 3, 0, 2, -1, 1, 0)) &&
        replay.append(InputCommand(5, 2, 0, 1, -2, 3, 0, 1)))
    var codec = BoundedReplayWireCodec(2)
    assert(codec.encode(replay, 7, 11, -19) &&
        codec.encodedLength() == 22,
        "replay wire codec must frame metadata and commands")
    var wire = new Int[codec.encodedLength()]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var restored = InputReplayRecorder(2)
    assert(codec.decode(wire, restored) &&
        codec.engineVersion() == 7 &&
        codec.contentVersion() == 11 &&
        codec.seed() == -19 &&
        restored.playNext() &&
        restored.lastPlayed().moveX() == 3 &&
        restored.playNext() &&
        restored.lastPlayed().jump() == 1,
        "replay wire codec must restore metadata and FIFO commands")
    wire[0] = 0
    assert(!codec.decode(wire, restored),
        "replay wire codec must reject a corrupted header")
    var path = "/tmp/kookie-replay-test.bin"
    var files = BoundedReplayFileStore(2)
    assert(files.write(path, replay, 7, 11, -19))
    var loaded = InputReplayRecorder(2)
    assert(files.read(path, loaded) &&
        files.engineVersion() == 7 &&
        files.contentVersion() == 11 &&
        files.seed() == -19 &&
        loaded.playNext() &&
        loaded.lastPlayed().lookY() == -1 &&
        loaded.playNext() &&
        loaded.lastPlayed().sequence() == 2,
        "replay file codec must restore signed commands")
    var file = File(path)
    var corrupted = file.readBytes()
    corrupted[corrupted.length - 1] = corrupted[corrupted.length - 1] + 1
    assert(file.writeBytes(corrupted) &&
        !files.read(path, loaded),
        "replay file codec must reject corrupted digits")
}

test "bounded replay timeline checkpoints" {
    var timeline = BoundedReplayTimeline(2, 2)
    var snapshot = new Int[2]
    snapshot[0] = 12
    snapshot[1] = -4
    var checkpointSnapshot = new Int[2]
    checkpointSnapshot[0] = 30
    checkpointSnapshot[1] = -7
    var staged = InputReplayRecorder(2)
    assert(timeline.append(InputCommand(4, 1, 3, 0, 2, -1, 1, 0)) &&
        timeline.append(InputCommand(5, 2, 0, 1, -2, 3, 0, 1)) &&
        timeline.setInitialSnapshot(snapshot) &&
        timeline.appendCheckpointSnapshot(4, 101, checkpointSnapshot) &&
        timeline.appendCheckpoint(9, 202) &&
        timeline.checkpointSnapshotLength(0) == 2 &&
        timeline.checkpointSnapshotValue(0, 1) == -7 &&
        timeline.checkpointIndexAtOrBefore(8) == 0 &&
        timeline.seek(8) &&
        timeline.seekCheckpointIndex() == 0 &&
        timeline.seekSnapshotLength() == 2 &&
        timeline.seekSnapshotValue(0) == 30 &&
        timeline.seekSnapshotValue(1) == -7 &&
        timeline.seekRemainingCommands() == 1 &&
        timeline.seekNextCommand() &&
        timeline.lastSeekCommand().tick() == 5 &&
        !timeline.seekNextCommand() &&
        timeline.seek(8) &&
        timeline.stageSeekCommands(staged) &&
        staged.pending() == 1 &&
        staged.playNext() &&
        staged.lastPlayed().tick() == 5 &&
        !staged.playNext() &&
        timeline.checkpointHash(1) == 202,
        "timeline must restore checkpoint state and stage commands")
    var files = BoundedReplayFileStore(2)
    var path = "/tmp/kookie-replay-timeline-test.bin"
    assert(files.writeTimeline(path, timeline, 7, 11, 99))
    var restored = BoundedReplayTimeline(2, 2)
    assert(files.readTimeline(path, restored) &&
        files.engineVersion() == 7 &&
        files.contentVersion() == 11 &&
        files.seed() == 99 &&
        restored.pending() == 2 &&
        restored.initialSnapshotLength() == 2 &&
        restored.initialSnapshotValue(0) == 12 &&
        restored.initialSnapshotValue(1) == -4 &&
        restored.checkpointCountValue() == 2 &&
        restored.checkpointTick(0) == 4 &&
        restored.checkpointSnapshotLength(0) == 2 &&
        restored.checkpointSnapshotValue(0, 0) == 30 &&
        restored.checkpointSnapshotValue(0, 1) == -7 &&
        restored.checkpointHash(1) == 202 &&
        restored.commandAt(1).sequence() == 2 &&
        restored.seek(8) &&
        restored.seekCheckpointIndex() == 0 &&
        restored.seekSnapshotValue(1) == -7 &&
        restored.seekRemainingCommands() == 1,
        "timeline file codec must restore checkpoint state and commands")
    var file = File(path)
    var corrupted = file.readBytes()
    corrupted[corrupted.length - 1] = corrupted[corrupted.length - 1] + 1
    assert(file.writeBytes(corrupted) &&
        !files.readTimeline(path, restored),
        "timeline file codec must reject corrupted checkpoints")
}

test "bounded replay bundle file codec" {
    var timeline = BoundedReplayTimeline(2, 2)
    var primary = new Int[2]
    primary[0] = 30
    primary[1] = -7
    var sidecar = new Int[3]
    sidecar[0] = 100
    sidecar[1] = -200
    sidecar[2] = 300
    assert(timeline.appendCheckpointBundle(4, 101, primary, sidecar),
        "bundle timeline must accept primary and sidecar state")
    var files = BoundedReplayBundleFileStore(2)
    var path = "/tmp/kookie-replay-bundle-test.bin"
    var restored = BoundedReplayTimeline(2, 2)
    assert(files.writeTimeline(path, timeline, 7, 11, 99) &&
        files.readTimeline(path, restored, 7, 11, 99) &&
        files.engineVersion() == 7 &&
        files.contentVersion() == 11 &&
        files.seed() == 99 &&
        restored.checkpointCountValue() == 1 &&
        restored.checkpointSnapshotValue(0, 1) == -7 &&
        restored.checkpointSidecarLength(0) == 3 &&
        restored.checkpointSidecarValue(0, 1) == -200 &&
        restored.seek(4) &&
        restored.seekSidecarLength() == 3 &&
        restored.seekSidecarValue(2) == 300,
        "bundle file codec must round-trip primary and sidecar state")
}

test "replay presentation history round trips" {
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() &&
        loopback.recordReplayPresentation(
            4, 1, 7, 1, 2, 9, 10, 11, 12, 13, 14, 1) &&
        loopback.recordReplayPresentation(
            5, 2, 8, 1, 0, 20, 21, 22, 23, 24, 25, 0) &&
        loopback.replayPresentationCount() == 2)
    var state = new Int[loopback.replayPresentationReplayStateLength()]
    assert(loopback.encodeReplayPresentationState(state) &&
        loopback.restoreReplayPresentationState(new Int[2]) == false,
        "presentation history must reject truncated replay state")
    assert(loopback.restoreReplayPresentationState(state) &&
        loopback.replayPresentationCount() == 2 &&
        loopback.replayPresentationAt(0).tick() == 4 &&
        loopback.replayPresentationAt(0).valueThree() == 11 &&
        loopback.replayPresentationAt(1).flag() == false,
        "presentation history must restore ordered replay events")
}

test "resource token lifecycle" {
    var resources = ResourceRegistry(1)
    var token = resources.acquire(7)
    assert(resources.isValid(token))
    assert(!resources.isValid(ResourceToken(token.slot(), token.generation(), 8)))
    assert(resources.release(token))
    assert(!resources.isValid(token))
    assert(!resources.release(token))
    var replacement = resources.acquire(7)
    assert(replacement.generation() != token.generation())
}

test "platform state and audio queue lifecycle" {
    var window = WindowStateTracker(800, 600)
    assert(window.applyNativeEvent(3, 1, 0))
    assert(window.applyNativeEvent(2, 1024, 768))
    assert(!window.applyNativeEvent(2, -1, 768))
    assert(window.applyNativeEvent(4, 0, 0))
    assert(!window.applyNativeEvent(99, 0, 0))
    var state = window.snapshot()
    assert(state.width() == 1024 && state.height() == 768 && state.focused() && state.closeRequested())

    var audio = QueuedAudio(3)
    assert(audio.open())
    assert(audio.queue(3, 100) && audio.dequeue())
    assert(audio.consumedClip() == 3 &&
        audio.consumedGain() == 100 &&
        audio.consumedLeftGain() == 100 &&
        audio.consumedRightGain() == 100)
    assert(audio.queueSpatial(
            4, 100, 10, 0, 0, 0, 0, 0, 100, 0, 20) &&
        audio.dequeue() &&
        audio.consumedGain() == 50 &&
        audio.consumedLeftGain() == 25 &&
        audio.consumedRightGain() == 50,
        "right-side audio must attenuate and pan right")
    assert(audio.queueSpatial(
            5, 100, -10, 0, 0, 0, 0, 0, 100, 0, 20) &&
        audio.dequeue() &&
        audio.consumedGain() == 50 &&
        audio.consumedLeftGain() == 50 &&
        audio.consumedRightGain() == 25,
        "left-side audio must attenuate and pan left")
    assert(audio.queueSpatial(
            6, 100, 0, 20, 0, 0, 0, 0, 100, 0, 20) &&
        audio.dequeue() &&
        audio.consumedGain() == 0 &&
        audio.consumedLeftGain() == 0 &&
        audio.consumedRightGain() == 0,
        "maximum-distance audio must attenuate to silence")
    assert(!audio.queueSpatial(
        7, 100, 0, 0, 0, 0, 0, 0, 0, 0, 20))
    assert(audio.close())
}
test "remote endpoint and key lifecycle" {
    var endpoint = RemoteSessionEndpoint(
        127, 0, 0, 1, 4000, 1, 2, 3, 4)
    assert(endpoint.valid())
    assert(!endpoint.active())
    assert(!endpoint.setPeer(127, 0, 0, 1, 0))
    assert(!endpoint.setKey(0, 0, 0, 0))
    assert(endpoint.activate())
    assert(endpoint.active())
    assert(!endpoint.setPeer(127, 0, 0, 1, 4001))
    assert(!endpoint.setKey(9, 8, 7, 6))
    assert(endpoint.deactivate())
    assert(endpoint.setKey(9, 8, 7, 6))
    assert(endpoint.keyWord(0) == 9 && endpoint.keyWord(3) == 6)
}
test "remote session link sequences" {
    var endpoint = RemoteSessionEndpoint(
        127, 0, 0, 1, 4000, 1, 2, 3, 4)
    var link = RemoteSessionLink(endpoint)
    var session = LoopbackSession(2, 2)
    assert(session.start())
    assert(session.addBroadPhaseTriangle(0, 0, 5, 4, 0, 5, 0, 4, 5))
    var snapshot = session.broadPhaseSnapshot(1, 1)
    assert(!link.sendSnapshot(snapshot))
    assert(link.connect())
    assert(link.connected())
    assert(link.sendSnapshot(snapshot))
    assert(!link.sendSnapshot(snapshot))
    assert(link.receiveSnapshot(snapshot))
    assert(!link.receiveSnapshot(snapshot))
    assert(link.sentSequence() == 1 && link.receivedSequence() == 1)
    assert(link.disconnect())
    assert(!link.connected())
    assert(!link.disconnect())
    assert(link.reconnect())
    var nextSnapshot = session.broadPhaseSnapshot(2, 2)
    assert(link.sendSnapshot(nextSnapshot))
    assert(!link.sendSnapshot(snapshot))
    assert(link.receiveSnapshot(nextSnapshot))
    assert(!link.receiveSnapshot(snapshot))
    assert(link.sentSequence() == 2 && link.receivedSequence() == 2)
    assert(link.disconnect())
}
test "authoritative remote session handoff" {
    var session = LoopbackSession(2, 2)
    assert(session.start())
    assert(session.addBroadPhaseTriangle(0, 0, 5, 4, 0, 5, 0, 4, 5))
    assert(!session.openRemoteSession())
    assert(!session.configureRemoteEndpoint(
        127, 0, 0, 1, 0, 1, 2, 3, 4))
    assert(session.configureRemoteEndpoint(
        127, 0, 0, 1, 4000, 1, 2, 3, 4))
    assert(!session.queueRemoteBroadPhaseSnapshot(1, 1))
    assert(session.openRemoteSession())
    assert(session.remoteSessionConnected())
    assert(session.queueRemoteBroadPhaseSnapshot(1, 1))
    assert(!session.queueRemoteBroadPhaseSnapshot(1, 1))
    var snapshot = session.broadPhaseSnapshot(2, 2)
    assert(session.queueRemoteBroadPhaseSnapshot(2, 2))
    assert(session.pumpRemoteBroadPhaseSnapshot(3))
    assert(session.remoteSendSequence() == 3)
    assert(session.applyRemoteBroadPhaseSnapshot(snapshot))
    assert(session.closeRemoteSession())
    assert(!session.remoteSessionConnected())
    assert(session.openRemoteSession())
    assert(session.remoteSessionConnected() &&
        session.remoteSendSequence() == 3)
    assert(session.pumpRemoteBroadPhaseSnapshot(4))
    assert(session.remoteSendSequence() == 4)
    assert(session.closeRemoteSession())
}



test "frame staging ownership and scalar measurement" {
    var staging = FrameStaging(2)
    assert(staging.begin(7))
    assert(staging.pushVertex(2, 1, 2, 3, 4))
    assert(staging.pushVertex(2, 5, 6, 7, 8))
    assert(!staging.pushVertex(2, 9, 10, 11, 12))
    assert(staging.scalarWrites() == 10)
    assert(staging.publish())
    assert(staging.retire(7))
    assert(staging.publishedFrame() == 7 && staging.retiredFrame() == 7)
    assert(!staging.retire(7))
    assert(!staging.begin(7))
    assert(staging.begin(8))
    assert(staging.discard())
    assert(!staging.publish())
}

test "authoritative loopback foundation" {
    var clock = FixedStepClock(60, 4)
    assert(clock.advance(16667) == 1)
    assert(clock.tick() == 1)
    var component = IntComponentStore(1)
    assert(component.set(1, 10))
    assert(!component.set(2, 20))
    var movement = MovementComponent(1, 2)
    assert(movement.add(1, 0))
    assert(movement.applyInput(1, 9))
    assert(movement.position(1) == 2)
    var loopback = LoopbackSession(2, 1)
    assert(loopback.start())
    assert(loopback.connectPlayer() == 1)
    assert(loopback.receiveInput(1, 1, 2, 2, 0, 0, 0, 1, 0))
    assert(loopback.advance(16667) == 1)
    assert(loopback.serverPosition(1) == 2)
    assert(loopback.inSync())
    assert(loopback.lastInputEdges(1).firePressed() == 1)
    assert(loopback.snapshotCount(1) == 1 &&
        loopback.serverRewindLatestTick() == 1 &&
        loopback.serverRewindOldestTick() == 1 &&
        loopback.predictionCorrectionCount(1) == 1,
        "authoritative ticks must feed rewind and correction histories")
    var rendered = loopback.interpolatedPosition(1, 1)
    assert(rendered.ready() && rendered.position() == 2,
        "loopback must expose an interpolated snapshot")
    assert(loopback.predictClientInput(1, 4), "client prediction must accept input")
    assert(loopback.predictedPosition(1) == 6, "prediction must stay locally bounded")
    assert(loopback.pendingPredictionInputs(1) == 1,
        "prediction must retain unacknowledged input")
    assert(loopback.applySnapshot(2, 1, 1, 2), "server snapshot must reconcile prediction")
    assert(loopback.authoritativePosition(1) == 2,
        "reconciliation must retain server authority")
    assert(loopback.clientPosition(1) == 6,
        "reconciliation must replay pending client input")
    assert(loopback.applySnapshot(3, 2, 1, 6), "acknowledged snapshot must retire input")
    assert(loopback.pendingPredictionInputs(1) == 0 && loopback.clientPosition(1) == 6,
        "acknowledged prediction must stop replaying")

    assert(loopback.broadPhaseRevision() == 1 &&
        loopback.clientBroadPhaseRevision() == 1 &&
        loopback.broadPhaseTriangleCount() == 0,
        "loopback must expose initial broad-phase collection")
    assert(loopback.addBroadPhaseTriangle(0, 0, 5, 4, 0, 5, 0, 4, 5),
        "authoritative session must accept bounded broad-phase geometry")
    var broadPhaseRevision = loopback.broadPhaseRevision()
    assert(broadPhaseRevision == 2 && loopback.broadPhaseTriangleCount() == 1,
        "broad-phase collection edits must advance its revision")
    var broadPhasePayload = loopback.broadPhaseSnapshot(3, 4)
    assert(validBroadPhaseSnapshot(broadPhasePayload) &&
        broadPhaseSnapshotRevision(broadPhasePayload) == broadPhaseRevision &&
        broadPhaseSnapshotTriangleCount(broadPhasePayload) == 1 &&
        broadPhasePayload.length == 21 &&
        loopback.acceptsBroadPhaseSnapshot(broadPhasePayload),
        "broad-phase transport payload must preserve bounded geometry")
    assert(loopback.queueBroadPhaseSnapshot(3, 4) &&
        loopback.pendingBroadPhaseSnapshots() == 1 &&
        loopback.receiveBroadPhaseSnapshot() &&
        loopback.pendingBroadPhaseSnapshots() == 0 &&
        loopback.clientBroadPhaseTriangleCount() == 1,
        "transport queue must deliver a valid broad-phase payload")
    var boundedTransport = BroadPhaseTransportQueue(1, 1)
    assert(boundedTransport.send(broadPhasePayload) &&
        !boundedTransport.send(broadPhasePayload) &&
        boundedTransport.pending() == 1 &&
        boundedTransport.receive().length == broadPhasePayload.length &&
        boundedTransport.pending() == 0,
        "transport queue capacity must reject overflow without dropping data")
    var clientQuery = loopback.queryClientBroadPhase(
        broadPhaseRevision, 1, 1, 0, 1, 1, 10)
    assert(clientQuery.accepted() && clientQuery.collided(),
        "client broad-phase query must use applied geometry")
    assert(!loopback.applyBroadPhaseSnapshot(broadPhasePayload),
        "duplicate broad-phase payload sequence must reject")
    assert(loopback.applyQuerySnapshot(4, 3, broadPhaseRevision, 1, 6),
        "matching geometry revision must accept query snapshot")
    var staleQuery = loopback.queryBroadPhase(
        1, 1, 1, 0, 1, 1, 10)
    assert(!staleQuery.accepted(),
        "stale broad-phase collection query must reject")
    var currentQuery = loopback.queryBroadPhase(
        broadPhaseRevision, 1, 1, 0, 1, 1, 10)
    assert(currentQuery.accepted() && currentQuery.collided(),
        "matching broad-phase collection query must collide")
    assert(loopback.removeBroadPhaseTriangle(0) &&
        loopback.broadPhaseRevision() > broadPhaseRevision &&
        loopback.broadPhaseTriangleCount() == 0,
        "broad-phase removal must advance the handoff revision")
    var clearedBroadPhasePayload = loopback.broadPhaseSnapshot(4, 5)
    assert(loopback.applyBroadPhaseSnapshot(clearedBroadPhasePayload) &&
        loopback.clientBroadPhaseTriangleCount() == 0 &&
        loopback.clientBroadPhaseRevision() == loopback.broadPhaseRevision(),
        "client session must apply broad-phase removal payload")
    assert(!loopback.acceptsBroadPhaseSnapshot(broadPhasePayload),
        "stale broad-phase transport payload must reject")
    assert(!loopback.applyQuerySnapshot(5, 4, broadPhaseRevision, 1, 6),
        "stale geometry revision must reject query snapshot")
    assert(loopback.applyQuerySnapshot(
        6, 4, loopback.broadPhaseRevision(), 1, 6) &&
        loopback.clientBroadPhaseRevision() == loopback.broadPhaseRevision(),
        "matching new geometry revision must reconcile")

}

test "bounded snapshot interpolation and prediction" {
    var history = SnapshotHistory(2)
    assert(!history.push(0, 0, 0), "snapshot sequence zero must reject")
    assert(history.push(1, 10, 0), "first snapshot must store")
    assert(history.push(2, 20, 10), "second snapshot must store")
    assert(history.push(3, 30, 20), "history must evict oldest snapshot")
    assert(history.size() == 2, "snapshot history must stay bounded")
    var interpolated = history.interpolate(25)
    assert(interpolated.ready(), "interpolation must be ready")
    assert(interpolated.position() == 15, "interpolation must blend positions")
    assert(interpolated.fromSequence() == 2 && interpolated.toSequence() == 3,
        "interpolation must identify source snapshots")
    assert(!history.push(3, 31, 30), "duplicate snapshot sequence must reject")

    var prediction = ClientPredictionState(4)
    assert(prediction.predict(9), "prediction must accept and clamp input")
    assert(prediction.predicted() == 4 && prediction.pendingInputs() == 1,
        "prediction must retain bounded input history")
    assert(prediction.reconcile(2, 1), "authoritative snapshot must reconcile")
    assert(prediction.authoritative() == 2 && prediction.predicted() == 2,
        "acknowledged input must not replay")
    assert(prediction.predictAt(2, 9), "prediction must accept a later tick")
    assert(prediction.reconcile(3, 1), "reconciliation must replay pending input")
    assert(prediction.predicted() == 7 && prediction.correction() == 4,
        "reconciliation must replay and expose correction")
    assert(prediction.pendingInputs() == 1, "unacknowledged input must remain pending")
    assert(!prediction.reconcile(3, 0), "older authority must reject")
}

test "bounded G6 lag compensation and correction metrics" {
    assert(netcodeLagCompensationTick(60, 60, 54, 2) == 55 &&
        netcodeLagCompensationTick(4, 4, 0, 6) == 0 &&
        netcodeLagCompensationTick(-1, 4, 0, 2) == -1,
        "lag compensation must derive a bounded server rewind tick")
    assert(netcodeRemoteRenderTick(10) == 4 &&
        netcodeRemoteRenderTick(2) == 0,
        "remote rendering must stay behind the live tick by a bounded delay")

    var rewind = NetcodeRewindHistory(4, 4)
    assert(rewind.push(1, 1, 0, 0, 0) &&
        rewind.push(1, 2, 10, 0, 0) &&
        rewind.push(2, 1, 2, 0, 0) &&
        rewind.push(2, 2, 14, 0, 0) &&
        rewind.distance(1, 2, 1) == 10 &&
        rewind.distance(1, 2, 2) == 12,
        "rewind history must retain bounded actor positions per tick")
    assert(rewind.push(3, 1, 4, 0, 0) &&
        rewind.push(4, 1, 6, 0, 0) &&
        rewind.push(5, 1, 8, 0, 0) &&
        rewind.oldestTick() == 2 &&
        rewind.distance(1, 2, 1) == -1 &&
        rewind.diagnostic() == netcodeDiagnosticRewind(),
        "rewind history must reject samples older than its window")

    var corrections = NetcodeCorrectionMetrics()
    assert(corrections.measure(20, 17, 4) &&
        corrections.measure(17, 17, 5) &&
        corrections.count() == 2 &&
        corrections.totalAbsoluteCorrection() == 3 &&
        corrections.maximumAbsoluteCorrection() == 3 &&
        corrections.averageAbsoluteCorrection() == 1 &&
        corrections.worstTick() == 4,
        "prediction correction metrics must remain deterministic and bounded")
    var session = LoopbackSession(8, 4)
    assert(session.start() &&
        session.connectPlayer() == 1 &&
        session.connectPlayer() == 2 &&
        session.addPlayerCombatActor(1, 100, 0) &&
        session.addPlayerCombatActor(2, 100, 0) &&
        session.definePlayerWeapon(77, 2, 0, 10, 1) &&
        session.setPlayerWeaponRange(77, 20) &&
        session.equipPlayerCombatWeapon(1, 77) &&
        session.equipPlayerCombatWeapon(2, 77) &&
        session.setEnemySpatialPosition(1, 0, 0, 0) &&
        session.setEnemySpatialPosition(2, 10, 0, 0) &&
        session.advance(16667) == 1 &&
        session.setEnemySpatialPosition(2, 100, 0, 0),
        "authoritative rewind fixture must capture both player positions")
    var rewoundShot = session.resolvePlayerHitscanAt(
        1, 2, 1, 1, 100, 0)
    assert(rewoundShot.accepted(),
        "lag compensation must validate range against the historical position")
}

test "bounded collision query and movement rejection" {
    var world = BoundedCollisionWorld(0, 10, 4)
    var hit = world.query(8, 4)
    assert(hit.accepted() && hit.collided(), "boundary query must report contact")
    assert(hit.requestedPosition() == 12 && hit.resolvedPosition() == 10,
        "collision must resolve to the boundary")
    assert(hit.distance() == 2, "collision must report resolved distance")
    assert(!world.query(5, 5).accepted(), "over-budget query must reject")

    var movement = MovementComponent(1, 4)
    assert(movement.setBounds(0, 10), "movement bounds must configure")
    assert(movement.add(1, 8), "bounded entity must add")
    assert(movement.applyInput(1, 4), "bounded movement must resolve")
    assert(movement.position(1) == 10, "movement must stop at collision boundary")
    assert(movement.lastCollision().collided(), "movement must expose collision result")
    assert(!movement.setPosition(1, -1), "out-of-bounds placement must reject")
}

test "bounded 3D segment collision query" {
    var volume = BoundedSegmentWorld(0, 0, 0, 10, 10, 10, 20)
    var clear = volume.querySegment(1, 1, 1, 4, 4, 4)
    assert(clear.accepted() && !clear.collided(),
        "interior segment must be accepted without collision")
    assert(clear.resolvedX() == 4 && clear.resolvedY() == 4 && clear.resolvedZ() == 4,
        "clear segment must resolve to its endpoint")

    var hit = volume.querySegment(8, 8, 8, 12, 12, 12)
    assert(hit.accepted() && hit.collided(), "segment must stop at volume boundary")
    assert(hit.hitStep() > 0 && hit.resolvedX() <= 10 && hit.resolvedY() <= 10 &&
        hit.resolvedZ() <= 10, "collision must expose the last interior sample")
    assert(!volume.querySegment(1, 1, 1, 30, 1, 1).accepted(),
        "over-budget segment must reject")
    assert(!volume.querySegment(-1, 1, 1, 2, 1, 1).accepted(),
        "starting penetration must reject")
}

test "bounded triangle query" {
    var triangle = BoundedTriangleWorld(20)
    assert(triangle.configureBounds(0, 0, 0, 10, 10, 10),
        "triangle bounds must configure")
    assert(triangle.configureTriangle(0, 0, 5, 10, 0, 5, 0, 10, 5),
        "non-degenerate triangle must configure")
    var hit = triangle.queryTriangle(2, 2, 0, 2, 2, 10)
    assert(hit.accepted() && hit.collided(), "segment must hit configured triangle")
    assert(hit.hitStep() == 5 && hit.resolvedZ() == 4,
        "triangle hit must resolve to the previous sample")
    var miss = triangle.queryTriangle(9, 9, 0, 9, 9, 10)
    assert(miss.accepted() && !miss.collided(),
        "segment outside triangle must miss")
    assert(!triangle.configureTriangle(0, 0, 0, 1, 1, 1, 2, 2, 2),
        "degenerate triangle must reject")
}

test "bounded triangle collection and BVH diagnostics" {
    var collection = BoundedTriangleCollection(4, 20)
    assert(collection.configureBounds(0, 0, 0, 10, 10, 10),
        "triangle collection bounds must configure")
    assert(collection.addTriangle(0, 0, 5, 4, 0, 5, 0, 4, 5),
        "first bounded triangle must insert")
    assert(collection.addTriangle(6, 0, 5, 10, 0, 5, 6, 4, 5),
        "second bounded triangle must insert")
    assert(collection.addTriangle(0, 6, 8, 4, 6, 8, 0, 10, 8),
        "third bounded triangle must insert")
    assert(!collection.addTriangle(0, 0, 0, 1, 1, 1, 2, 2, 2),
        "degenerate collection triangle must reject")
    var hit = collection.query(8, 2, 0, 8, 2, 10)
    assert(hit.accepted() && hit.collided() && hit.hitStep() == 5,
        "BVH collection query must find the nearest triangle")
    assert(collection.lastHitTriangle() == 1,
        "BVH collection must report the hit triangle index")
    assert(collection.lastVisitedNodes() > 0 && collection.lastVisitedTriangles() == 1,
        "BVH diagnostics must report bounded traversal")
    var priorRevision = collection.triangleRevision(1)
    var priorGeometryRevision = collection.geometryRevision()
    assert(collection.removeTriangle(1) && collection.triangleCount() == 2,
        "triangle removal must rebuild bounded collection")
    assert(collection.geometryRevision() > priorGeometryRevision &&
        collection.triangleRevision(1) > priorRevision,
        "triangle revisions must advance on removal")
    var removedHit = collection.query(8, 2, 0, 8, 2, 10)
    assert(removedHit.accepted() && !removedHit.collided(),
        "removed triangle must leave the BVH")
    assert(collection.addTriangle(6, 0, 5, 10, 0, 5, 6, 4, 5),
        "triangle collection must reuse bounded free slots")
    assert(collection.triangleCount() == 3 &&
        collection.triangleRevision(1) > priorRevision,
        "reinserted triangle must retain a newer geometry revision")
    assert(!collection.query(0, 0, 0, 0, 0, 21).accepted(),
        "BVH collection must reject over-budget traversal")
    assert(!collection.lastQueryAccepted() && collection.lastHitTriangle() == -1,
        "rejected BVH query diagnostics must reset")
}

test "Kof-owned authored collision representation" {
    var authored = BoundedAuthoredCollision(6, 2)
    assert(authored.configure(10, 77, 4, 1, 100, 0, 0, 0, 10, 10, 10),
        "authored collision bounds and identity must configure")

    assert(authored.addVertex(0, 0, 5) &&
        authored.addVertex(4, 0, 5) &&
        authored.addVertex(0, 4, 5) &&
        authored.addVertex(6, 0, 5) &&
        authored.addVertex(10, 0, 5) &&
        authored.addVertex(6, 4, 5),
        "authored collision vertices must be bounded")
    assert(!authored.addTriangle(0, 1, 9, 1),
        "authored collision must reject out-of-range vertex indices")
    assert(authored.addTriangle(0, 1, 2, 1) &&
        authored.addTriangle(3, 4, 5, 2),
        "authored collision must accept indexed non-degenerate surfaces")
    assert(authored.seal() && authored.validate(),
        "authored collision must seal and validate")
    var authoredChecksum = authored.checksum()
    assert(authoredChecksum > 0 && authored.vertexCount() == 6 &&
        authored.triangleCount() == 2 && authored.triangleSurface(1) == 2,
        "authored collision identity and surface metadata must remain readable")
    assert(!authored.addVertex(1, 1, 1),
        "sealed authored collision must reject mutation")
    assert(authored.encode() && authored.encodedLength() == 42,
        "authored collision codec must emit canonical indexed wire data")
    var collisionWire = new Int[authored.encodedLength()]
    for (var index = 0; index < collisionWire.length; index = index + 1) {
        collisionWire[index] = authored.encodedWord(index)
    }
    var restoredCollision = BoundedAuthoredCollision(6, 2)
    assert(restoredCollision.decode(collisionWire) &&
        restoredCollision.validate() &&
        restoredCollision.sourceNamespaceId() == 10 &&
        restoredCollision.checksum() == authoredChecksum,
        "authored collision codec must round trip identity and geometry")
    collisionWire[15] = collisionWire[15] + 1
    var tamperedCollision = BoundedAuthoredCollision(6, 2)
    assert(!tamperedCollision.decode(collisionWire),
        "authored collision codec must reject checksum tampering")

    var contentPackage = BoundedContentPackage(2, 1, 2)
    assert(contentPackage.configureHeader(7, 3, 11, 1, 100) &&
        contentPackage.addAsset(10, 77, 3, 4, 111, 222, 7) &&
        contentPackage.addChunk(
            99, 6, 0, authored.encodedLength(),
            authoredChecksum, authored.triangleCount(), 4) &&
        contentPackage.seal(),
        "content package must publish the authored collision identity")
    var collisionAdmission = BoundedCollisionPackageAdmission()
    assert(collisionAdmission.admit(contentPackage, authored, 99, 6) &&
        collisionAdmission.accepted() &&
        collisionAdmission.collisionChecksum() == authoredChecksum &&
        collisionAdmission.geometryRevision() == 4,
        "collision admission must require matching package asset and chunk identity")
    assert(!collisionAdmission.admit(contentPackage, authored, 99, 7),
        "collision admission must reject mismatched chunk kinds")


    var collection = BoundedTriangleCollection(2, 20)
    assert(collection.replaceWithAuthored(authored),
        "triangle collection must admit a validated authored collision")
    assert(collection.triangleCount() == 2 &&
        collection.authoredChecksum() == authoredChecksum &&
        collection.authoredRevision() == 4,
        "admission must retain authored identity and revision")
    var hit = collection.query(8, 2, 0, 8, 2, 10)
    assert(hit.accepted() && hit.collided() && hit.hitStep() == 5 &&
        collection.lastHitTriangle() == 1,
        "admitted authored triangles must drive nearest collision queries")

    var replacement = BoundedAuthoredCollision(3, 1)
    assert(replacement.configure(10, 78, 5, 1, 100, 0, 0, 0, 10, 10, 10) &&
        replacement.addVertex(0, 0, 8) &&
        replacement.addVertex(4, 0, 8) &&
        replacement.addVertex(0, 4, 8) &&
        replacement.addTriangle(0, 1, 2, 1) &&
        replacement.seal(),
        "replacement authored collision must validate")
    assert(collection.replaceWithAuthored(replacement) &&
        collection.triangleCount() == 1 &&
        collection.authoredRevision() == 5 &&
        collection.authoredChecksum() != authoredChecksum,
        "replacement must atomically update collision identity")
    var oldHit = collection.query(8, 2, 0, 8, 2, 6)
    assert(oldHit.accepted() && !oldHit.collided(),
        "replacement must remove stale authored triangles")
}

test "canonical GLB intake and reopen validation" {
    var glb = BoundedCanonicalGlb(6, 2)
    assert(glb.configure(10, 77, 4, 1, 100, 0, 0, 0, 10, 10, 10) &&
        glb.addVertex(0, 0, 5) &&
        glb.addVertex(4, 0, 5) &&
        glb.addVertex(0, 4, 5) &&
        glb.addVertex(6, 0, 5) &&
        glb.addVertex(10, 0, 5) &&
        glb.addVertex(6, 4, 5) &&
        glb.addTriangle(0, 1, 2, 1) &&
        glb.addTriangle(3, 4, 5, 2) &&
        glb.seal() && glb.encode() && glb.encodedLength() == 42,
        "canonical GLB intake must admit bounded indexed geometry")
    var glbWire = new Int[glb.encodedLength()]
    for (var index = 0; index < glbWire.length; index = index + 1) {
        glbWire[index] = glb.encodedWord(index)
    }
    var reopenedGlb = BoundedCanonicalGlb(6, 2)
    assert(reopenedGlb.reopen(glbWire) &&
        reopenedGlb.validate() && reopenedGlb.checksum() == glb.checksum(),
        "canonical GLB output must reopen byte-for-byte through the runtime reader")
    glbWire[15] = glbWire[15] + 1
    assert(!BoundedCanonicalGlb(6, 2).reopen(glbWire),
        "GLB reopen validation must reject checksum corruption")
    var emittedCollision = BoundedAuthoredCollision(6, 2)
    assert(reopenedGlb.emitCollision(emittedCollision) &&
        emittedCollision.validate() && emittedCollision.sourceAssetId() == 77,
        "GLB intake must emit an identity-preserving collision product")
}

test "atomic geometry collision navigation replication publication" {

    var publication = BoundedProductPublication()
    assert(publication.stageGeometry(4, 101) &&
        publication.stageCollision(4, 202) &&
        publication.stageNavigation(4, 303) &&
        publication.stageReplication(4, 404) &&
        publication.publish() &&
        publication.generation() == 1 &&
        publication.revision() == 4 &&
        publication.publishedValid(),
        "complete product set must publish as one generation")
    assert(publication.stageGeometry(5, 501) &&
        !publication.publish() &&
        publication.generation() == 1 &&
        publication.revision() == 4,
        "partial replacement must retain the previous published generation")
    assert(publication.stageCollision(5, 502) &&
        publication.stageNavigation(5, 503) &&
        publication.stageReplication(5, 504) &&
        publication.publish() &&
        publication.generation() == 2 &&
        publication.revision() == 5 &&
        publication.collisionChecksum() == 502,
        "matching replacement products must advance atomically")
}
test "Kof graph products canonicalize topology and publish atomically", "graph" {
    var first = BoundedGraphProduct(4, 4)
    assert(first.configure(1, 7, 1, false) &&
        first.addNode(30, 3) &&
        first.addNode(10, 1) &&
        first.addNode(20, 2) &&
        first.addEdge(20, 30, 1) &&
        first.addEdge(10, 20, 1) &&
        first.seal() && first.validate() &&
        !first.hasCycle() && first.topologicalCount() == 3 &&
        first.topologicalNodeId(0) == 10 &&
        first.topologicalNodeId(1) == 20 &&
        first.topologicalNodeId(2) == 30,
        "acyclic Kof graph products must expose deterministic topological order")

    var reordered = BoundedGraphProduct(4, 4)
    assert(reordered.configure(1, 7, 1, false) &&
        reordered.addNode(20, 2) &&
        reordered.addNode(30, 3) &&
        reordered.addNode(10, 1) &&
        reordered.addEdge(10, 20, 1) &&
        reordered.addEdge(20, 30, 1) &&
        reordered.seal() &&
        reordered.checksum() == first.checksum(),
        "equivalent graph products must have authoring-order independent identity")

    var rejectedCycle = BoundedGraphProduct(2, 2)
    assert(rejectedCycle.configure(1, 8, 2, false) &&
        rejectedCycle.addNode(1, 1) &&
        rejectedCycle.addNode(2, 1) &&
        rejectedCycle.addEdge(1, 2, 1) &&
        rejectedCycle.addEdge(2, 1, 1) &&
        !rejectedCycle.seal(),
        "DAG products must reject cycles")

    var stateGraph = BoundedGraphProduct(2, 2)
    assert(stateGraph.configure(1, 8, 3, true) &&
        stateGraph.addNode(1, 1) &&
        stateGraph.addNode(2, 1) &&
        stateGraph.addEdge(1, 2, 1) &&
        stateGraph.addEdge(2, 1, 1) &&
        stateGraph.seal() && stateGraph.validate() &&
        stateGraph.hasCycle() && stateGraph.topologicalCount() == 0,
        "cycle-aware Kof graph products must preserve explicit state loops")

    var publication = BoundedGraphPublication()
    assert(publication.stage(first) && publication.publish() &&
        publication.publishedValid() && publication.generation() == 1 &&
        publication.revision() == 7 &&
        publication.graphChecksum() == first.checksum(),
        "a sealed graph must publish as one immutable generation")
    assert(!publication.stage(reordered) &&
        publication.generation() == 1 &&
        publication.graphChecksum() == first.checksum(),
        "same-revision staging must retain the active graph generation")
    assert(publication.stage(stateGraph) && publication.publish() &&
        publication.generation() == 2 && publication.revision() == 8 &&
        publication.graphKind() == 3,
        "a newer sealed graph must replace the active generation atomically")
}

test "Kof behavior program selects bounded enemy intents", "behavior" {
    var program = BoundedBehaviorProgram(16, 16, 4)
    assert(program.configureDefaultEnemyProgram(1) &&
        program.validate() && program.encode() &&
        program.ruleCount() == 3 && program.workBudget() == 8,
        "default Kof behavior program must compile into bounded rules")

    var attack = program.evaluate(7, true, 10, 100, 20)
    assert(attack.accepted() &&
        attack.intent() == behaviorIntentAttack() &&
        attack.targetId() == 7 && attack.work() == 3,
        "visible targets inside attack range must select attack")

    var chase = program.evaluate(7, true, 60, 100, 20)
    assert(chase.accepted() &&
        chase.intent() == behaviorIntentChase() &&
        chase.targetId() == 7 && chase.work() == 6,
        "visible targets inside perception range must select chase")

    var investigate = program.evaluate(7, false, 0, 100, 20)
    assert(investigate.accepted() &&
        investigate.intent() == behaviorIntentInvestigate() &&
        investigate.targetId() == 0 && investigate.work() == 7,
        "lost targets must select the explicit fallback intent")

    var copied = BoundedBehaviorProgram(16, 16, 4)
    assert(copied.copyFrom(program) &&
        copied.checksum() == program.checksum() &&
        copied.evaluate(7, true, 10, 100, 20).intent() ==
            behaviorIntentAttack(),
        "installed behavior programs must retain canonical identity")
    var behaviorWire = new Int[program.encodedLength()]
    for (var index = 0; index < behaviorWire.length; index = index + 1) {
        behaviorWire[index] = program.encodedWord(index)
    }
    assert(BoundedBehaviorProgram(16, 16, 4).reopen(behaviorWire),
        "offline behavior artifacts must reopen byte-for-byte")
    behaviorWire[behaviorWire.length - 1] =
        behaviorWire[behaviorWire.length - 1] + 1
    assert(!BoundedBehaviorProgram(16, 16, 4).reopen(behaviorWire),
        "behavior artifact reopen must reject compiled-rule corruption")

    var chaseOnly = BoundedBehaviorProgram(8, 8, 2)
    assert(chaseOnly.configure(1, 2, 4) &&
        chaseOnly.addNode(1, behaviorNodeSelector()) &&
        chaseOnly.addNode(10, behaviorNodeSequence()) &&
        chaseOnly.addNode(11, behaviorNodeConditionVisible()) &&
        chaseOnly.addNode(12, behaviorNodeConditionPerceptionRange()) &&
        chaseOnly.addNode(13, behaviorNodeActionChase()) &&
        chaseOnly.addNode(20, behaviorNodeActionIdle()) &&
        chaseOnly.addChild(1, 10, 1) &&
        chaseOnly.addChild(1, 20, 2) &&
        chaseOnly.addChild(10, 11, 1) &&
        chaseOnly.addChild(10, 12, 2) &&
        chaseOnly.addChild(10, 13, 3) &&
        chaseOnly.seal(),
        "Kof must compile an alternate authoritative behavior product")
    var behaviorEnemies = EnemyStateWorld(1)
    assert(behaviorEnemies.installBehaviorProgram(chaseOnly) &&
        behaviorEnemies.behaviorProgramRevision() == 2 &&
        behaviorEnemies.behaviorProgramChecksum() == chaseOnly.checksum() &&
        behaviorEnemies.configure(100, 20, 4) &&
        behaviorEnemies.addEnemy(9, 0),
        "enemy FSM must atomically install a newer Kof behavior product")
    var behaviorStep = behaviorEnemies.step(9, 1, 7, true, 10)
    assert(behaviorStep.accepted() &&
        behaviorStep.state() == behaviorEnemies.chaseState() &&
        !behaviorStep.attackReady() &&
        !behaviorEnemies.installBehaviorProgram(copied),
        "behavior intent must drive the existing bounded FSM and reject rollback")

    var unsafe = BoundedBehaviorProgram(2, 1, 1)
    assert(unsafe.configure(1, 2, 2) &&
        unsafe.addNode(1, behaviorNodeSelector()) &&
        unsafe.addNode(2, behaviorNodeActionAttack()) &&
        unsafe.addChild(1, 2, 1) &&
        !unsafe.seal(),
        "unguarded attack actions must not enter the authoritative runtime")
}

test "Kof scene products compose canonical transform hierarchies", "scene" {
    var scene = BoundedSceneProduct(4)
    assert(scene.configure(7, 77, 3, 1, 100, 1000) &&
        scene.addNodeMatrix(
            20, 10, sceneNodeMeshKind(), 900,
            1000, 0, 0, 10,
            0, 1000, 0, 50,
            0, 0, 1000, 0) &&
        scene.addNodeMatrix(
            10, 0, sceneNodeGroupKind(), 0,
            2000, 0, 0, 100,
            0, 1000, 0, 0,
            0, 0, 1000, 0) &&
        scene.seal() && scene.validate() && scene.encode() &&
        scene.nodeId(0) == 10 && scene.nodeId(1) == 20 &&
        scene.topologicalNodeId(0) == 10 &&
        scene.topologicalNodeId(1) == 20,
        "scene product must canonicalize author order and parent topology")

    var hierarchy = BoundedTransformHierarchy(4)
    assert(hierarchy.load(scene) && hierarchy.validate() &&
        hierarchy.nodeCount() == 2 &&
        hierarchy.worldMatrixElement(20, 0) == 2000 &&
        hierarchy.worldMatrixElement(20, 3) == 120 &&
        hierarchy.worldMatrixElement(20, 7) == 50,
        "Kof hierarchy must compose fixed-point parent scale and translation")

    var encoded = new Int[scene.encodedLength()]
    for (var index = 0; index < encoded.length; index = index + 1) {
        encoded[index] = scene.encodedWord(index)
    }
    var reopened = BoundedSceneProduct(4)
    assert(reopened.reopen(encoded) &&
        reopened.checksum() == scene.checksum() &&
        reopened.graphChecksum() == scene.graphChecksum(),
        "canonical scene product must reopen with identical identity")
    encoded[10] = encoded[10] + 1
    assert(!BoundedSceneProduct(4).reopen(encoded),
        "scene product reopen must reject checksum corruption")

    var cycle = BoundedSceneProduct(2)
    assert(cycle.configure(7, 78, 1, 1, 100, 1000) &&
        cycle.addNodeTranslation(1, 2, sceneNodeGroupKind(), 0, 0, 0, 0) &&
        cycle.addNodeTranslation(2, 1, sceneNodeGroupKind(), 0, 0, 0, 0) &&
        !cycle.seal(),
        "scene product must reject cyclic transform parents")
}

test "Kof skeleton palettes and cyclic animation graph runtime", "animation" {
    var scene = BoundedSceneProduct(4)
    assert(scene.configure(7, 78, 1, 1, 100, 1000) &&
        scene.addNodeTranslation(
            1, 0, sceneNodeGroupKind(), 0, 100, 200, 300) &&
        scene.addNodeTranslation(
            2, 1, sceneNodeGroupKind(), 0, 0, 100, 0) &&
        scene.seal(),
        "skeleton fixture scene must seal a canonical joint hierarchy")
    var hierarchy = BoundedTransformHierarchy(4)
    assert(hierarchy.load(scene) && hierarchy.validate(),
        "skeleton runtime requires a valid world transform hierarchy")

    var skeleton = BoundedSkeletonProduct(2, 4)
    assert(skeleton.configure(7, 78, 1, 1000) &&
        skeleton.addSkin(1, 1) &&
        skeleton.addJoint(
            1, 2, 2, 1,
            1000, 0, 0, 0,
            0, 1000, 0, 0,
            0, 0, 1000, 0) &&
        skeleton.addJoint(
            1, 1, 1, 0,
            1000, 0, 0, 0,
            0, 1000, 0, 0,
            0, 0, 1000, 0) &&
        skeleton.seal() && skeleton.validate() && skeleton.encode() &&
        skeleton.jointId(1, 0) == 1 &&
        skeleton.jointId(1, 1) == 2 &&
        skeleton.jointParentId(1, 1) == 1,
        "skeleton products must canonicalize joints and retain parent topology")
    var palette = BoundedSkeletonRuntime(4)
    assert(palette.load(skeleton, hierarchy, 1) &&
        palette.validate() && palette.jointCount() == 2 &&
        palette.paletteElement(0, 3) == 100 &&
        palette.paletteElement(0, 7) == 200 &&
        palette.paletteElement(1, 3) == 100 &&
        palette.paletteElement(1, 7) == 300 &&
        palette.paletteElement(1, 11) == 300,
        "skeleton runtime must compose world transforms with inverse bind matrices")
    var skeletonWire = new Int[skeleton.encodedLength()]
    for (var index = 0; index < skeletonWire.length; index = index + 1) {
        skeletonWire[index] = skeleton.encodedWord(index)
    }
    assert(BoundedSkeletonProduct(2, 4).reopen(skeletonWire),
        "canonical skeleton products must reopen byte-for-byte")
    skeletonWire[skeletonWire.length - 1] =
        skeletonWire[skeletonWire.length - 1] + 1
    assert(!BoundedSkeletonProduct(2, 4).reopen(skeletonWire),
        "skeleton reopen must reject inverse bind corruption")

    var graph = BoundedAnimationGraphProduct(4, 6)
    assert(graph.configure(7, 90, 3, 10) &&
        graph.addState(20, 200, 2, true) &&
        graph.addState(10, 100, 4, true) &&
        graph.addState(30, 300, 3, false) &&
        graph.addTransition(1, 10, 20, 1, 5, 3) &&
        graph.addTransition(3, 10, 30, 1, 10, 0) &&
        graph.addTransition(2, 20, 10, 2, 5, 1) &&
        graph.addTransition(4, 30, 10, 2, 5, 1) &&
        graph.seal() && graph.validate() && graph.hasCycle() &&
        graph.encode(),
        "animation graph must seal explicit cyclic state transitions")
    var graphWire = new Int[graph.encodedLength()]
    for (var index = 0; index < graphWire.length; index = index + 1) {
        graphWire[index] = graph.encodedWord(index)
    }
    assert(BoundedAnimationGraphProduct(4, 6).reopen(graphWire),
        "canonical animation graphs must reopen byte-for-byte")

    var runtime = BoundedAnimationGraphRuntime(4, 6)
    assert(runtime.start(graph, 0) && runtime.stateId() == 10 &&
        runtime.clipId() == 100 && runtime.clipTick() == 0 &&
        runtime.step(0) && runtime.clipTick() == 1 &&
        runtime.step(1) && runtime.stateId() == 30 &&
        runtime.transitionId() == 3 && runtime.clipId() == 300 &&
        runtime.clipTick() == 1 && runtime.blendTicksRemaining() == 0,
        "animation runtime must choose the highest-priority matching transition")
    assert(runtime.step(2) && runtime.stateId() == 10 &&
        runtime.previousStateId() == 30 && runtime.transitionId() == 4 &&
        runtime.clipTick() == 1 && runtime.blendTicksRemaining() == 1 &&
        runtime.validate(),
        "animation runtime must transition back with deterministic blend state")
}

test "KofScript offline artifacts reopen canonical products", "offline-builder" {
    var behavior = BoundedBehaviorProgram(16, 16, 4)
    assert(behavior.configureDefaultEnemyProgram(7) && behavior.encode(),
        "offline behavior source must seal before artifact emission")
    var behaviorWords = new Int[behavior.encodedLength()]
    for (var index = 0; index < behaviorWords.length; index = index + 1) {
        behaviorWords[index] = behavior.encodedWord(index)
    }
    var behaviorArtifact = BoundedOfflineProductArtifact(128)
    assert(behaviorArtifact.build(
            offlineArtifactBehaviorKind(), behavior.checksum(),
            behaviorWords) &&
        behaviorArtifact.validate(),
        "offline builder must envelope canonical behavior words")
    var behaviorText = behaviorArtifact.encodeText()
    var reopenedBehaviorArtifact = BoundedOfflineProductArtifact(128)
    assert(reopenedBehaviorArtifact.decodeText(behaviorText) &&
        reopenedBehaviorArtifact.checksum() == behaviorArtifact.checksum() &&
        BoundedBehaviorProgram(16, 16, 4).reopen(
            reopenedBehaviorArtifact.wordsCopy()),
        "behavior artifact text must decode and reopen the runtime product")

    var animation = BoundedAnimationGraphProduct(3, 4)
    assert(animation.configure(7, 91, 2, 10) &&
        animation.addState(10, 100, 60, true) &&
        animation.addState(20, 200, 30, true) &&
        animation.addTransition(1, 10, 20, 1, 10, 6) &&
        animation.addTransition(2, 20, 10, 2, 10, 6) &&
        animation.seal() && animation.encode(),
        "offline animation source must seal before artifact emission")
    var animationWords = new Int[animation.encodedLength()]
    for (var index = 0; index < animationWords.length; index = index + 1) {
        animationWords[index] = animation.encodedWord(index)
    }
    var animationArtifact = BoundedOfflineProductArtifact(128)
    assert(animationArtifact.build(
            offlineArtifactAnimationKind(), animation.checksum(),
            animationWords),
        "offline builder must envelope canonical animation words")
    var reopenedAnimationArtifact = BoundedOfflineProductArtifact(128)
    assert(reopenedAnimationArtifact.decodeText(
            animationArtifact.encodeText()) &&
        BoundedAnimationGraphProduct(3, 4).reopen(
            reopenedAnimationArtifact.wordsCopy()),
        "animation artifact text must decode and reopen the runtime product")
    assert(!BoundedOfflineProductArtifact(128).decodeText(
            behaviorText + "7"),
        "offline artifact parser must reject trailing ambiguous content")
}

test "bounded KofScript VM validates and executes capability programs", "kofscript-vm" {
    var program = BoundedKofScriptProgram(4, 32)
    assert(program.configure(
            8, 1, 3002, 1, trustedDomainEventEnemyDefeated(),
            19, 3, 1, 1,
            kofScriptCommandGrantCurrencyBit(),
            kofScriptEventEliteBountyBit()) &&
        program.addConstant(10) &&
        program.addConstant(2) &&
        program.addInstruction(kofScriptOpcodeLoadInput(), kofScriptInputValue()) &&
        program.addInstruction(kofScriptOpcodePushConstant(), 0) &&
        program.addInstruction(kofScriptOpcodeGreater(), 0) &&
        program.addInstruction(kofScriptOpcodeJumpIfZero(), 18) &&
        program.addInstruction(kofScriptOpcodeLoadInput(), kofScriptInputPlayerId()) &&
        program.addInstruction(kofScriptOpcodeLoadInput(), kofScriptInputSubjectKind()) &&
        program.addInstruction(kofScriptOpcodePushConstant(), 1) &&
        program.addInstruction(kofScriptOpcodeMultiply(), 0) &&
        program.addInstruction(kofScriptOpcodeLoadInput(), kofScriptInputValue()) &&
        program.addInstruction(kofScriptOpcodeAdd(), 0) &&
        program.addInstruction(
            kofScriptOpcodeEmitCommand(), trustedHookCommandGrantCurrency()) &&
        program.addInstruction(kofScriptOpcodeLoadInput(), kofScriptInputSubjectId()) &&
        program.addInstruction(kofScriptOpcodeLoadInput(), kofScriptInputSubjectKind()) &&
        program.addInstruction(kofScriptOpcodePushConstant(), 1) &&
        program.addInstruction(kofScriptOpcodeMultiply(), 0) &&
        program.addInstruction(kofScriptOpcodeLoadInput(), kofScriptInputValue()) &&
        program.addInstruction(kofScriptOpcodeAdd(), 0) &&
        program.addInstruction(
            kofScriptOpcodeEmitEvent(), trustedHookEventEliteBounty()) &&
        program.addInstruction(kofScriptOpcodeHalt(), 0) &&
        program.seal() && program.encode(),
        "sandbox program must seal only after bounded forward control flow")
    var words = new Int[program.encodedLength()]
    for (var index = 0; index < words.length; index = index + 1) {
        words[index] = program.encodedWord(index)
    }
    var reopened = BoundedKofScriptProgram(4, 32)
    assert(reopened.reopen(words) &&
        reopened.checksum() == program.checksum() &&
        reopened.identity().scriptId() == 3002,
        "canonical sandbox bytecode must reopen with stable identity")
    var artifact = BoundedOfflineProductArtifact(128)
    assert(artifact.build(
            offlineArtifactKofScriptKind(), reopened.checksum(), words),
        "offline artifacts must carry canonical KofScript bytecode")
    var reopenedArtifact = BoundedOfflineProductArtifact(128)
    assert(reopenedArtifact.decodeText(artifact.encodeText()) &&
        BoundedKofScriptProgram(4, 32).reopen(
            reopenedArtifact.wordsCopy()),
        "text artifacts must reopen sandbox programs")

    var vm = BoundedKofScriptVm(3, 1, 1)
    var accepted = TrustedDomainEvent(
        1, trustedDomainEventEnemyDefeated(),
        1, 42, enemyDefinitionEliteKind(), 20)
    assert(vm.execute(reopened, accepted, 7) && vm.accepted() &&
        vm.steps() == 19 && vm.commandCount() == 1 &&
        vm.commandKind(0) == trustedHookCommandGrantCurrency() &&
        vm.commandPlayer(0) == 1 && vm.commandValue(0) == 24 &&
        vm.eventCount() == 1 &&
        vm.eventKind(0) == trustedHookEventEliteBounty() &&
        vm.eventSubject(0) == 42 && vm.eventValue(0) == 24 &&
        vm.executionChecksum() > 0,
        "sandbox VM must expose only bounded public command and event outputs")
    var scriptSession = LoopbackSession(2, 2)
    assert(scriptSession.start() &&
        scriptSession.connectPlayer() == 1 &&
        scriptSession.connectPlayer() == 2 &&
        scriptSession.applyKofScriptCommands(vm) &&
        scriptSession.playerCurrency(1) == 24 &&
        !scriptSession.applyKofScriptCommands(vm),
        "sandbox commands must cross the existing authoritative application gate once")
    var quiet = TrustedDomainEvent(
        2, trustedDomainEventEnemyDefeated(),
        1, 43, enemyDefinitionEliteKind(), 5)
    assert(vm.execute(reopened, quiet, 8) && vm.steps() == 5 &&
        vm.commandCount() == 0 && vm.eventCount() == 0,
        "forward branch must terminate without hidden output")
    assert(!vm.execute(
            reopened,
            TrustedDomainEvent(
                3, trustedDomainEventLootPickedUp(),
                1, 43, enemyDefinitionEliteKind(), 5),
            9) &&
        vm.diagnostic() == kofScriptDiagnosticEvent() &&
        vm.commandCount() == 0 && vm.eventCount() == 0,
        "sandbox VM must reject events outside the declared subscription")

    var backward = BoundedKofScriptProgram(1, 2)
    assert(backward.configure(
            8, 1, 3003, 1, trustedDomainEventSessionStarted(),
            2, 1, 0, 0, 0, 0) &&
        backward.addInstruction(kofScriptOpcodeJump(), 0) &&
        backward.addInstruction(kofScriptOpcodeHalt(), 0) &&
        !backward.seal(),
        "sandbox verifier must reject backward and self jumps")
    var overflow = BoundedKofScriptProgram(1, 5)
    assert(overflow.configure(
            8, 1, 3004, 1, trustedDomainEventSessionStarted(),
            5, 2, 0, 0, 0, 0) &&
        overflow.addConstant(kofScriptMaximumValue()) &&
        overflow.addInstruction(kofScriptOpcodePushConstant(), 0) &&
        overflow.addInstruction(kofScriptOpcodePushConstant(), 0) &&
        overflow.addInstruction(kofScriptOpcodeMultiply(), 0) &&
        overflow.addInstruction(kofScriptOpcodeDrop(), 0) &&
        overflow.addInstruction(kofScriptOpcodeHalt(), 0) &&
        overflow.seal() &&
        !vm.execute(
            overflow,
            TrustedDomainEvent(
                1, trustedDomainEventSessionStarted(), 0, 0, 0, 0),
            1) &&
        vm.diagnostic() == kofScriptDiagnosticArithmetic() &&
        vm.commandCount() == 0 && vm.eventCount() == 0,
        "sandbox arithmetic failure must discard all staged output")
    words[16] = words[16] + 1
    assert(!BoundedKofScriptProgram(4, 32).reopen(words),
        "sandbox product must reject checksum tampering")
}

test "swept convex dynamic broadphase and navigation products" {
    var convex = BoundedConvexController(1, 20)
    assert(convex.addPlane(1, 0, 0, 8) &&
        convex.addPlane(-1, 0, 0, -1) &&
        convex.addPlane(0, 1, 0, 8) &&
        convex.addPlane(0, -1, 0, -1) &&
        convex.addPlane(0, 0, 1, 8) &&
        convex.addPlane(0, 0, -1, -1) &&
        convex.sealObstacle(),
        "convex controller must seal a bounded six-plane volume")
    var convexMove = convex.move(3, 5, 5, 9, 5, 5)
    assert(convexMove.accepted() && convexMove.collided() &&
        convexMove.resolvedX() == 7,
        "swept capsule must stop at the expanded convex plane")
    assert(!convex.sweep(0, 5, 5, 3, 5, 5).accepted(),
        "convex controller must reject starting penetration")

    var dynamic = BoundedDynamicBroadPhase(2, 20)
    assert(dynamic.add(7, 6, 0, 0, 7, 10, 10) &&
        dynamic.add(9, 12, 0, 0, 13, 10, 10) &&
        dynamic.count() == 2,
        "dynamic broadphase must admit bounded actor boxes")
    var actorHit = dynamic.query(0, 5, 5, 20, 5, 5, 0)
    assert(actorHit.accepted() && actorHit.collided() &&
        actorHit.actorId() == 7 && actorHit.resolvedX() == 5,
        "dynamic broadphase must resolve the nearest actor sweep")
    assert(dynamic.remove(9) &&
        !dynamic.query(0, 5, 5, 20, 5, 5, 7).collided() &&
        dynamic.update(7, 15, 0, 0, 16, 10, 10),
        "dynamic actor updates, ignore filtering and removal must be bounded")

    var navigationProduct = BoundedNavigationProduct(4)
    assert(navigationProduct.configure(1, 300, 4) &&
        navigationProduct.addNode(10, 0, 0, 0) &&
        navigationProduct.addNode(20, 1, 0, 0) &&
        navigationProduct.addNode(30, 2, 0, 0) &&
        navigationProduct.addEdge(10, 20) &&
        navigationProduct.addEdge(20, 30) &&
        navigationProduct.seal() &&
        navigationProduct.validate(),
        "navigation product must seal reciprocal bounded links")
    var route = navigationProduct.findRoute(10, 30)
    assert(route.accepted() && route.found() && route.routeLength() == 2 &&
        route.nextNodeId() == 20,
        "navigation product must provide deterministic bounded routes")
}


