import core
import session

main() {
    println("KOOKIE G0 session foundation")
    println(tickRate())
    println(roundTripEnvelope(protocolVersion(), 1, 0, 1))

    var resources = ResourceRegistry(2)
    var mesh = resources.acquire(1)
    assert(resources.isValid(mesh), "fresh token must be valid")
    assert(resources.activeCount() == 1, "acquire must consume one slot")
    assert(!resources.isValid(ResourceToken(mesh.slot(), mesh.generation(), 2)), "kind mismatch must reject")
    assert(resources.release(mesh), "live token must release")
    assert(!resources.isValid(mesh), "released token must be stale")
    assert(!resources.release(mesh), "double release must reject")

    var replacement = resources.acquire(1)
    assert(replacement.slot() == mesh.slot(), "allocator should reuse the first free slot")
    assert(replacement.generation() != mesh.generation(), "reuse must advance generation")
    assert(resources.isValid(replacement), "replacement token must be valid")
    println("KOOKIE G0 resource tokens verified")


    var window = WindowStateTracker(1280, 720)
    assert(window.applyFocus(1), "focus event must be accepted")
    assert(window.applyResize(1920, 1080), "positive resize must be accepted")
    assert(!window.applyResize(0, 1080), "zero resize must be rejected")
    assert(window.requestClose(), "close event must be accepted")
    var windowState = window.snapshot()
    assert(windowState.width() == 1920 && windowState.height() == 1080, "resize state must be copied")
    assert(windowState.focused() && windowState.closeRequested(), "focus and close state must be copied")

    var audio = QueuedAudio(2)
    assert(audio.open(), "audio queue must open once")
    assert(audio.queue(11, 80), "audio command must enqueue")
    assert(audio.queue(12, 60), "audio queue must accept capacity")
    assert(!audio.queue(13, 40), "audio queue must reject overflow")
    assert(audio.dequeue(), "audio command must dequeue")
    assert(audio.consumedClip() == 11 && audio.consumedGain() == 80, "audio order must be FIFO")
    assert(audio.close(), "audio queue must close")
    println("KOOKIE G0 scalar adapter contracts verified")

    var staging = FrameStaging(3)
    assert(staging.begin(1), "frame staging must open")
    assert(staging.pushVertex(1, -80, -80, 0, 100), "first vertex must stage")
    assert(staging.pushVertex(1, 80, -80, 100, 100), "second vertex must stage")
    assert(staging.pushVertex(1, 0, 80, 50, 0), "third vertex must stage")
    assert(staging.stagedCount() == 3, "triangle vertex count must stage")
    assert(staging.scalarWrites() == 15, "triangle scalar write count must be measured")
    assert(staging.checksum() == 273, "triangle staging checksum must be stable")
    assert(staging.scalarBudget() == 15, "frame staging budget must be bounded")
    assert(staging.fitsScalarBudget(15) && !staging.fitsScalarBudget(14),
        "frame staging must report budget acceptance")
    assert(staging.publish(), "frame staging must publish")
    assert(staging.retire(1), "published frame must retire")
    var retired = staging.publishedFrame() == 1 && staging.retiredFrame() == 1 && !staging.isOpen()
    assert(retired, "published frame ownership must close")
    var meshStaging = FrameStaging(6)
    assert(meshStaging.begin(2), "quad mesh staging must open")
    assert(meshStaging.pushVertex(1, -80, -80, 0, 100), "quad vertex one must stage")
    assert(meshStaging.pushVertex(1, 80, -80, 100, 100), "quad vertex two must stage")
    assert(meshStaging.pushVertex(1, 80, 80, 100, 0), "quad vertex three must stage")
    assert(meshStaging.pushVertex(1, -80, -80, 0, 100), "quad vertex four must stage")
    assert(meshStaging.pushVertex(1, 80, 80, 100, 0), "quad vertex five must stage")
    assert(meshStaging.pushVertex(1, -80, 80, 0, 0), "quad vertex six must stage")
    assert(meshStaging.stagedCount() == 6 && meshStaging.scalarWrites() == 30,
        "quad mesh must stage six vertices")
    assert(meshStaging.scalarBudget() == 30 && meshStaging.fitsScalarBudget(30),
        "quad mesh must fit its bounded frame budget")
    assert(meshStaging.publish() && meshStaging.retire(2),
        "quad mesh staging must retire")
    println("KOOKIE G0 frame staging verified")
    var clock = FixedStepClock(60, 4)
    assert(clock.advance(16667) == 1, "fixed-step clock must advance one tick")
    assert(clock.tick() == 1 && clock.pendingMicros() == 1, "fixed-step remainder must be retained")
    assert(clock.frameBudgetMicros() == 16667,
        "fixed-step frame budget must be declared")
    assert(clock.advance(-1) == -1, "negative elapsed time must reject")

    var component = IntComponentStore(2)
    assert(component.set(1, 40), "component value must insert")
    assert(component.set(2, 80), "component capacity must accept")
    assert(!component.set(3, 120), "component capacity must reject overflow")
    assert(component.get(1) == 40 && component.activeCount() == 2, "component values must be readable")
    assert(component.remove(1) && !component.has(1), "component value must remove")

    var loopback = LoopbackSession(4, 2)
    assert(loopback.start(), "loopback server must start")
    assert(loopback.connectPlayer() == 1, "first loopback client must connect")
    assert(loopback.connectPlayer() == 2, "second loopback client must connect")
    assert(loopback.playerCount() == 2, "loopback must track two clients")
    assert(loopback.receiveInput(1, 1, 1, 3, 0, 0, 0, 1, 0), "first input command must queue")
    assert(loopback.receiveInput(2, 1, 1, 2, 0, 0, 0, 0, 1), "second input command must queue")
    assert(!loopback.receiveInput(1, 1, 1, 4, 0, 0, 0, 1, 0), "stale input sequence must reject")
    assert(loopback.advance(16667) == 1, "authoritative tick must advance")
    assert(loopback.serverPosition(1) == 3 && loopback.serverPosition(2) == 2, "authoritative movement must apply")
    assert(loopback.inSync(), "snapshot must reach loopback clients")
    var loopbackEdges = loopback.lastInputEdges(1)
    var inputPublished = loopbackEdges.firePressed() == 1 && loopback.latestSnapshotSequence() == 1
    assert(inputPublished, "input edge and snapshot must publish")
    assert(!loopback.applySnapshot(1, 1, 1, 99), "stale snapshot must reject")
    assert(loopback.clientPosition(1) == 3, "stale snapshot must not overwrite client state")
    var mapper = InputMapper(10)
    var mapped = mapper.map(20, -20, 3, -4, 7, -2)
    assert(mapped.moveX() == 10 && mapped.moveY() == -10, "input movement must clamp")
    assert(mapped.fire() == 1 && mapped.jump() == 0, "input buttons must normalize")
    var camera = CameraState(-45, 45)
    assert(camera.applyLook(12, 100), "camera look must apply")
    assert(camera.currentYaw() == 12 && camera.currentPitch() == 45, "camera pitch must clamp")
    println("KOOKIE G1 loopback foundation verified")

}
test "player fire input publishes weapon presentation" {
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1)
    assert(loopback.definePlayerWeapon(9, 2, 1, 1, 4, 1, 20))
    assert(loopback.addPlayerCombatActor(1, 20, 0))
    assert(loopback.equipPlayerCombatWeapon(1, 9))
    assert(loopback.receiveInput(1, 1, 1, 0, 0, 0, 0, 1, 0))
    assert(loopback.advance(16667) == 1)
    assert(loopback.playerWeaponPresentationCount() == 1 &&
        loopback.playerCombatMagazine(1) == 1 &&
        loopback.playerCombatReserve(1) == 1,
        "confirmed fire input must consume authoritative ammo")
    assert(loopback.dequeuePlayerWeaponPresentation())
    var shotPresentation = loopback.lastPlayerWeaponPresentation()
    assert(shotPresentation.kind() == 1 &&
        shotPresentation.actorId() == 1 &&
        shotPresentation.shotId() == 1 &&
        shotPresentation.weaponId() == 9 &&
        shotPresentation.magazine() == 1,
        "accepted fire must publish bounded weapon presentation")
    assert(loopback.receiveInput(1, 2, 2, 0, 0, 0, 0, 1, 0))
    assert(loopback.advance(16667) == 1 &&
        loopback.playerWeaponPresentationCount() == 0,
        "held fire must not duplicate edge-triggered weapon presentation")
    assert(loopback.receiveInput(1, 3, 3, 0, 0, 0, 0, 0, 0))
    assert(loopback.advance(16667) == 1)
    assert(loopback.receiveInput(1, 4, 4, 0, 0, 0, 0, 1, 0))
    assert(loopback.advance(16667) == 1 &&
        loopback.playerWeaponPresentationCount() == 1,
        "a new fire edge must publish after release")
}

test "bounded save envelope validation" {
    var save = BoundedSaveState(3, 1000)
    var payload = new Int[3]
    payload[0] = 12
    payload[1] = 34
    payload[2] = 56
    assert(save.stage(1, 7, payload) &&
        save.isStaged() &&
        save.payloadLength() == 3 &&
        save.schemaVersion() == 1 &&
        save.revision() == 7 &&
        save.payloadValue(1) == 34,
        "bounded save state must stage versioned payload values")
    var envelope = save.envelope()
    assert(envelope.accepted() &&
        envelope.schemaVersion() == 1 &&
        envelope.revision() == 7 &&
        envelope.payloadLength() == 3 &&
        envelope.checksum() > 0,
        "save envelope must expose deterministic metadata")
    var restored = BoundedSaveState(3, 1000)
    assert(restored.load(envelope, payload) &&
        restored.payloadValue(0) == 12 &&
        restored.payloadValue(2) == 56,
        "matching envelope and payload must restore state")
    payload[1] = 35
    assert(!restored.load(envelope, payload),
        "mutated payload must fail checksum validation")
    assert(!save.stage(2, 7, payload) &&
        !save.stage(1, -1, payload) &&
        !save.stage(1, 1000001, payload) &&
        !save.stage(1, 7, new Int[4]),
        "unsupported versions, revisions and overflow must reject")
    var invalidValue = new Int[1]
    invalidValue[0] = 1001
    assert(!save.stage(1, 8, invalidValue),
        "values beyond the schema bound must reject")
    assert(save.clear() && !save.isStaged() &&
        save.payloadValue(0) == -1,
        "clearing save state must remove staged payload access")
}
test "bounded save publication history" {
    var first = BoundedSaveState(2, 100)
    var firstPayload = new Int[2]
    firstPayload[0] = 10
    firstPayload[1] = 20
    assert(first.stage(1, 1, firstPayload))
    var second = BoundedSaveState(2, 100)
    var secondPayload = new Int[2]
    secondPayload[0] = 30
    secondPayload[1] = 40
    assert(second.stage(1, 2, secondPayload))
    var history = BoundedSaveHistory(2, 2)
    assert(history.publish(first) && history.publish(second) &&
        history.count() == 2 && history.latestRevision() == 2,
        "save history must publish strictly increasing revisions")
    assert(!history.publish(second),
        "save history must reject duplicate revisions")
    var restored = BoundedSaveState(2, 100)
    assert(history.restore(1, restored) &&
        restored.payloadValue(0) == 10 &&
        restored.payloadValue(1) == 20,
        "save history must restore retained revisions")
    var third = BoundedSaveState(2, 100)
    var thirdPayload = new Int[2]
    thirdPayload[0] = 50
    thirdPayload[1] = 60
    assert(third.stage(1, 3, thirdPayload) &&
        history.publish(third) &&
        history.latestRevision() == 3 &&
        history.count() == 2 &&
        !history.restore(1, restored) &&
        history.restore(2, restored) &&
        restored.payloadValue(0) == 30,
        "full save history must evict its oldest revision deterministically")
    assert(history.clear() && history.count() == 0 &&
        history.latestRevision() == -1,
        "save history clear must remove published revisions")
}


test "focus loss clears held input and queued fire" {
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1)
    assert(loopback.definePlayerWeapon(9, 3, 0, 1, 4, 1, 20) &&
        loopback.addPlayerCombatActor(1, 20, 0) &&
        loopback.equipPlayerCombatWeapon(1, 9))
    assert(loopback.receiveInput(1, 1, 1, 0, 0, 0, 0, 1, 0) &&
        loopback.advance(16667) == 1 &&
        loopback.playerWeaponPresentationCount() == 1)
    assert(loopback.dequeuePlayerWeaponPresentation())
    assert(loopback.lastInputEdges(1).firePressed() == 1)
    assert(loopback.receiveInput(1, 2, 2, 0, 0, 0, 0, 1, 0))
    assert(loopback.applyPlayerFocus(1, 0) &&
        !loopback.playerFocused(1) &&
        loopback.lastInputEdges(1).fireReleased() == 1 &&
        loopback.lastInputEdges(1).firePressed() == 0,
        "focus loss must release held buttons")
    assert(loopback.advance(16667) == 1 &&
        loopback.playerWeaponPresentationCount() == 0 &&
        !loopback.receiveInput(1, 3, 3, 0, 0, 0, 0, 1, 0),
        "focus loss must discard queued and new firing input")
    assert(loopback.applyPlayerFocus(1, 1) &&
        loopback.playerFocused(1) &&
        loopback.receiveInput(1, 3, 4, 0, 0, 0, 0, 1, 0) &&
        loopback.advance(16667) == 1 &&
        loopback.playerWeaponPresentationCount() == 1,
        "focus regain must rearm input acceptance")
}

test "resource token lifecycle" {
    var resources = ResourceRegistry(1)
    var token = resources.acquire(7)
    assert(resources.isValid(token))
    assert(!resources.isValid(ResourceToken(token.slot(), token.generation(), 8)))
    assert(resources.release(token))
    assert(!resources.isValid(token))
    assert(!resources.release(token))
    var replacement = resources.acquire(7)
    assert(replacement.generation() != token.generation())
}

test "platform state and audio queue lifecycle" {
    var window = WindowStateTracker(800, 600)
    assert(window.applyNativeEvent(3, 1, 0))
    assert(window.applyNativeEvent(2, 1024, 768))
    assert(!window.applyNativeEvent(2, -1, 768))
    assert(window.applyNativeEvent(4, 0, 0))
    assert(!window.applyNativeEvent(99, 0, 0))
    var state = window.snapshot()
    assert(state.width() == 1024 && state.height() == 768 && state.focused() && state.closeRequested())

    var audio = QueuedAudio(1)
    assert(audio.open())
    assert(audio.queue(3, 100))
    assert(!audio.queue(4, 100))
    assert(audio.dequeue())
    assert(audio.consumedClip() == 3 && audio.consumedGain() == 100)
    assert(audio.close())
}
test "remote endpoint and key lifecycle" {
    var endpoint = RemoteSessionEndpoint(
        127, 0, 0, 1, 4000, 1, 2, 3, 4)
    assert(endpoint.valid())
    assert(!endpoint.active())
    assert(!endpoint.setPeer(127, 0, 0, 1, 0))
    assert(!endpoint.setKey(0, 0, 0, 0))
    assert(endpoint.activate())
    assert(endpoint.active())
    assert(!endpoint.setPeer(127, 0, 0, 1, 4001))
    assert(!endpoint.setKey(9, 8, 7, 6))
    assert(endpoint.deactivate())
    assert(endpoint.setKey(9, 8, 7, 6))
    assert(endpoint.keyWord(0) == 9 && endpoint.keyWord(3) == 6)
}
test "remote session link sequences" {
    var endpoint = RemoteSessionEndpoint(
        127, 0, 0, 1, 4000, 1, 2, 3, 4)
    var link = RemoteSessionLink(endpoint)
    var session = LoopbackSession(2, 2)
    assert(session.start())
    assert(session.addBroadPhaseTriangle(0, 0, 5, 4, 0, 5, 0, 4, 5))
    var snapshot = session.broadPhaseSnapshot(1, 1)
    assert(!link.sendSnapshot(snapshot))
    assert(link.connect())
    assert(link.connected())
    assert(link.sendSnapshot(snapshot))
    assert(!link.sendSnapshot(snapshot))
    assert(link.receiveSnapshot(snapshot))
    assert(!link.receiveSnapshot(snapshot))
    assert(link.sentSequence() == 1 && link.receivedSequence() == 1)
    assert(link.disconnect())
    assert(!link.connected())
    assert(!link.disconnect())
}
test "authoritative remote session handoff" {
    var session = LoopbackSession(2, 2)
    assert(session.start())
    assert(session.addBroadPhaseTriangle(0, 0, 5, 4, 0, 5, 0, 4, 5))
    assert(!session.openRemoteSession())
    assert(!session.configureRemoteEndpoint(
        127, 0, 0, 1, 0, 1, 2, 3, 4))
    assert(session.configureRemoteEndpoint(
        127, 0, 0, 1, 4000, 1, 2, 3, 4))
    assert(!session.queueRemoteBroadPhaseSnapshot(1, 1))
    assert(session.openRemoteSession())
    assert(session.remoteSessionConnected())
    assert(session.queueRemoteBroadPhaseSnapshot(1, 1))
    assert(!session.queueRemoteBroadPhaseSnapshot(1, 1))
    var snapshot = session.broadPhaseSnapshot(2, 2)
    assert(session.queueRemoteBroadPhaseSnapshot(2, 2))
    assert(session.pumpRemoteBroadPhaseSnapshot(3))
    assert(session.remoteSendSequence() == 3)
    assert(session.applyRemoteBroadPhaseSnapshot(snapshot))
    assert(!session.applyRemoteBroadPhaseSnapshot(snapshot))
    assert(session.closeRemoteSession())
    assert(!session.remoteSessionConnected())
}



test "frame staging ownership and scalar measurement" {
    var staging = FrameStaging(2)
    assert(staging.begin(7))
    assert(staging.pushVertex(2, 1, 2, 3, 4))
    assert(staging.pushVertex(2, 5, 6, 7, 8))
    assert(!staging.pushVertex(2, 9, 10, 11, 12))
    assert(staging.scalarWrites() == 10)
    assert(staging.publish())
    assert(staging.retire(7))
    assert(staging.publishedFrame() == 7 && staging.retiredFrame() == 7)
    assert(!staging.retire(7))
    assert(!staging.begin(7))
    assert(staging.begin(8))
    assert(staging.discard())
    assert(!staging.publish())
}

test "authoritative loopback foundation" {
    var clock = FixedStepClock(60, 4)
    assert(clock.advance(16667) == 1)
    assert(clock.tick() == 1)
    var component = IntComponentStore(1)
    assert(component.set(1, 10))
    assert(!component.set(2, 20))
    var movement = MovementComponent(1, 2)
    assert(movement.add(1, 0))
    assert(movement.applyInput(1, 9))
    assert(movement.position(1) == 2)
    var loopback = LoopbackSession(2, 1)
    assert(loopback.start())
    assert(loopback.connectPlayer() == 1)
    assert(loopback.receiveInput(1, 1, 2, 2, 0, 0, 0, 1, 0))
    assert(loopback.advance(16667) == 1)
    assert(loopback.serverPosition(1) == 2)
    assert(loopback.inSync())
    assert(loopback.lastInputEdges(1).firePressed() == 1)
    assert(loopback.snapshotCount(1) == 1, "loopback must retain bounded snapshots")
    var rendered = loopback.interpolatedPosition(1, 1)
    assert(rendered.ready() && rendered.position() == 2,
        "loopback must expose an interpolated snapshot")
    assert(loopback.predictClientInput(1, 4), "client prediction must accept input")
    assert(loopback.predictedPosition(1) == 6, "prediction must stay locally bounded")
    assert(loopback.pendingPredictionInputs(1) == 1,
        "prediction must retain unacknowledged input")
    assert(loopback.applySnapshot(2, 1, 1, 2), "server snapshot must reconcile prediction")
    assert(loopback.authoritativePosition(1) == 2,
        "reconciliation must retain server authority")
    assert(loopback.clientPosition(1) == 6,
        "reconciliation must replay pending client input")
    assert(loopback.applySnapshot(3, 2, 1, 6), "acknowledged snapshot must retire input")
    assert(loopback.pendingPredictionInputs(1) == 0 && loopback.clientPosition(1) == 6,
        "acknowledged prediction must stop replaying")

    assert(loopback.broadPhaseRevision() == 1 &&
        loopback.clientBroadPhaseRevision() == 1 &&
        loopback.broadPhaseTriangleCount() == 0,
        "loopback must expose initial broad-phase collection")
    assert(loopback.addBroadPhaseTriangle(0, 0, 5, 4, 0, 5, 0, 4, 5),
        "authoritative session must accept bounded broad-phase geometry")
    var broadPhaseRevision = loopback.broadPhaseRevision()
    assert(broadPhaseRevision == 2 && loopback.broadPhaseTriangleCount() == 1,
        "broad-phase collection edits must advance its revision")
    var broadPhasePayload = loopback.broadPhaseSnapshot(3, 4)
    assert(validBroadPhaseSnapshot(broadPhasePayload) &&
        broadPhaseSnapshotRevision(broadPhasePayload) == broadPhaseRevision &&
        broadPhaseSnapshotTriangleCount(broadPhasePayload) == 1 &&
        broadPhasePayload.length == 15 &&
        loopback.acceptsBroadPhaseSnapshot(broadPhasePayload),
        "broad-phase transport payload must preserve bounded geometry")
    assert(loopback.queueBroadPhaseSnapshot(3, 4) &&
        loopback.pendingBroadPhaseSnapshots() == 1 &&
        loopback.receiveBroadPhaseSnapshot() &&
        loopback.pendingBroadPhaseSnapshots() == 0 &&
        loopback.clientBroadPhaseTriangleCount() == 1,
        "transport queue must deliver a valid broad-phase payload")
    var boundedTransport = BroadPhaseTransportQueue(1, 1)
    assert(boundedTransport.send(broadPhasePayload) &&
        !boundedTransport.send(broadPhasePayload) &&
        boundedTransport.pending() == 1 &&
        boundedTransport.receive().length == broadPhasePayload.length &&
        boundedTransport.pending() == 0,
        "transport queue capacity must reject overflow without dropping data")
    var clientQuery = loopback.queryClientBroadPhase(
        broadPhaseRevision, 1, 1, 0, 1, 1, 10)
    assert(clientQuery.accepted() && clientQuery.collided(),
        "client broad-phase query must use applied geometry")
    assert(!loopback.applyBroadPhaseSnapshot(broadPhasePayload),
        "duplicate broad-phase payload sequence must reject")
    assert(loopback.applyQuerySnapshot(4, 3, broadPhaseRevision, 1, 6),
        "matching geometry revision must accept query snapshot")
    var staleQuery = loopback.queryBroadPhase(
        1, 1, 1, 0, 1, 1, 10)
    assert(!staleQuery.accepted(),
        "stale broad-phase collection query must reject")
    var currentQuery = loopback.queryBroadPhase(
        broadPhaseRevision, 1, 1, 0, 1, 1, 10)
    assert(currentQuery.accepted() && currentQuery.collided(),
        "matching broad-phase collection query must collide")
    assert(loopback.removeBroadPhaseTriangle(0) &&
        loopback.broadPhaseRevision() > broadPhaseRevision &&
        loopback.broadPhaseTriangleCount() == 0,
        "broad-phase removal must advance the handoff revision")
    var clearedBroadPhasePayload = loopback.broadPhaseSnapshot(4, 5)
    assert(loopback.applyBroadPhaseSnapshot(clearedBroadPhasePayload) &&
        loopback.clientBroadPhaseTriangleCount() == 0 &&
        loopback.clientBroadPhaseRevision() == loopback.broadPhaseRevision(),
        "client session must apply broad-phase removal payload")
    assert(!loopback.acceptsBroadPhaseSnapshot(broadPhasePayload),
        "stale broad-phase transport payload must reject")
    assert(!loopback.applyQuerySnapshot(5, 4, broadPhaseRevision, 1, 6),
        "stale geometry revision must reject query snapshot")
    assert(loopback.applyQuerySnapshot(
        6, 4, loopback.broadPhaseRevision(), 1, 6) &&
        loopback.clientBroadPhaseRevision() == loopback.broadPhaseRevision(),
        "matching new geometry revision must reconcile")

}

test "bounded snapshot interpolation and prediction" {
    var history = SnapshotHistory(2)
    assert(!history.push(0, 0, 0), "snapshot sequence zero must reject")
    assert(history.push(1, 10, 0), "first snapshot must store")
    assert(history.push(2, 20, 10), "second snapshot must store")
    assert(history.push(3, 30, 20), "history must evict oldest snapshot")
    assert(history.size() == 2, "snapshot history must stay bounded")
    var interpolated = history.interpolate(25)
    assert(interpolated.ready(), "interpolation must be ready")
    assert(interpolated.position() == 15, "interpolation must blend positions")
    assert(interpolated.fromSequence() == 2 && interpolated.toSequence() == 3,
        "interpolation must identify source snapshots")
    assert(!history.push(3, 31, 30), "duplicate snapshot sequence must reject")

    var prediction = ClientPredictionState(4)
    assert(prediction.predict(9), "prediction must accept and clamp input")
    assert(prediction.predicted() == 4 && prediction.pendingInputs() == 1,
        "prediction must retain bounded input history")
    assert(prediction.reconcile(2, 1), "authoritative snapshot must reconcile")
    assert(prediction.authoritative() == 2 && prediction.predicted() == 2,
        "acknowledged input must not replay")
    assert(prediction.predictAt(2, 9), "prediction must accept a later tick")
    assert(prediction.reconcile(3, 1), "reconciliation must replay pending input")
    assert(prediction.predicted() == 7 && prediction.correction() == 4,
        "reconciliation must replay and expose correction")
    assert(prediction.pendingInputs() == 1, "unacknowledged input must remain pending")
    assert(!prediction.reconcile(3, 0), "older authority must reject")
}

test "bounded collision query and movement rejection" {
    var world = BoundedCollisionWorld(0, 10, 4)
    var hit = world.query(8, 4)
    assert(hit.accepted() && hit.collided(), "boundary query must report contact")
    assert(hit.requestedPosition() == 12 && hit.resolvedPosition() == 10,
        "collision must resolve to the boundary")
    assert(hit.distance() == 2, "collision must report resolved distance")
    assert(!world.query(5, 5).accepted(), "over-budget query must reject")

    var movement = MovementComponent(1, 4)
    assert(movement.setBounds(0, 10), "movement bounds must configure")
    assert(movement.add(1, 8), "bounded entity must add")
    assert(movement.applyInput(1, 4), "bounded movement must resolve")
    assert(movement.position(1) == 10, "movement must stop at collision boundary")
    assert(movement.lastCollision().collided(), "movement must expose collision result")
    assert(!movement.setPosition(1, -1), "out-of-bounds placement must reject")
}

test "bounded 3D segment collision query" {
    var volume = BoundedSegmentWorld(0, 0, 0, 10, 10, 10, 20)
    var clear = volume.querySegment(1, 1, 1, 4, 4, 4)
    assert(clear.accepted() && !clear.collided(),
        "interior segment must be accepted without collision")
    assert(clear.resolvedX() == 4 && clear.resolvedY() == 4 && clear.resolvedZ() == 4,
        "clear segment must resolve to its endpoint")

    var hit = volume.querySegment(8, 8, 8, 12, 12, 12)
    assert(hit.accepted() && hit.collided(), "segment must stop at volume boundary")
    assert(hit.hitStep() > 0 && hit.resolvedX() <= 10 && hit.resolvedY() <= 10 &&
        hit.resolvedZ() <= 10, "collision must expose the last interior sample")
    assert(!volume.querySegment(1, 1, 1, 30, 1, 1).accepted(),
        "over-budget segment must reject")
    assert(!volume.querySegment(-1, 1, 1, 2, 1, 1).accepted(),
        "starting penetration must reject")
}

test "bounded triangle query" {
    var triangle = BoundedTriangleWorld(20)
    assert(triangle.configureBounds(0, 0, 0, 10, 10, 10),
        "triangle bounds must configure")
    assert(triangle.configureTriangle(0, 0, 5, 10, 0, 5, 0, 10, 5),
        "non-degenerate triangle must configure")
    var hit = triangle.queryTriangle(2, 2, 0, 2, 2, 10)
    assert(hit.accepted() && hit.collided(), "segment must hit configured triangle")
    assert(hit.hitStep() == 5 && hit.resolvedZ() == 4,
        "triangle hit must resolve to the previous sample")
    var miss = triangle.queryTriangle(9, 9, 0, 9, 9, 10)
    assert(miss.accepted() && !miss.collided(),
        "segment outside triangle must miss")
    assert(!triangle.configureTriangle(0, 0, 0, 1, 1, 1, 2, 2, 2),
        "degenerate triangle must reject")
}

test "bounded triangle collection and BVH diagnostics" {
    var collection = BoundedTriangleCollection(4, 20)
    assert(collection.configureBounds(0, 0, 0, 10, 10, 10),
        "triangle collection bounds must configure")
    assert(collection.addTriangle(0, 0, 5, 4, 0, 5, 0, 4, 5),
        "first bounded triangle must insert")
    assert(collection.addTriangle(6, 0, 5, 10, 0, 5, 6, 4, 5),
        "second bounded triangle must insert")
    assert(collection.addTriangle(0, 6, 8, 4, 6, 8, 0, 10, 8),
        "third bounded triangle must insert")
    assert(!collection.addTriangle(0, 0, 0, 1, 1, 1, 2, 2, 2),
        "degenerate collection triangle must reject")
    var hit = collection.query(8, 2, 0, 8, 2, 10)
    assert(hit.accepted() && hit.collided() && hit.hitStep() == 5,
        "BVH collection query must find the nearest triangle")
    assert(collection.lastHitTriangle() == 1,
        "BVH collection must report the hit triangle index")
    assert(collection.lastVisitedNodes() > 0 && collection.lastVisitedTriangles() == 1,
        "BVH diagnostics must report bounded traversal")
    var priorRevision = collection.triangleRevision(1)
    var priorGeometryRevision = collection.geometryRevision()
    assert(collection.removeTriangle(1) && collection.triangleCount() == 2,
        "triangle removal must rebuild bounded collection")
    assert(collection.geometryRevision() > priorGeometryRevision &&
        collection.triangleRevision(1) > priorRevision,
        "triangle revisions must advance on removal")
    var removedHit = collection.query(8, 2, 0, 8, 2, 10)
    assert(removedHit.accepted() && !removedHit.collided(),
        "removed triangle must leave the BVH")
    assert(collection.addTriangle(6, 0, 5, 10, 0, 5, 6, 4, 5),
        "triangle collection must reuse bounded free slots")
    assert(collection.triangleCount() == 3 &&
        collection.triangleRevision(1) > priorRevision,
        "reinserted triangle must retain a newer geometry revision")
    assert(!collection.query(0, 0, 0, 0, 0, 21).accepted(),
        "BVH collection must reject over-budget traversal")
    assert(!collection.lastQueryAccepted() && collection.lastHitTriangle() == -1,
        "rejected BVH query diagnostics must reset")
}

test "capsule slide and step result" {
    var capsule = BoundedCapsuleWorld(0, 0, 0, 10, 10, 10, 1, 20)
    var slide = capsule.moveCapsule(2, 2, 2, 12, 2, 2, 1)
    assert(slide.accepted() && slide.collided() && !slide.stepped(),
        "capsule boundary movement must produce a slide")
    assert(slide.resolvedX() == 9 && slide.slideX() == 7,
        "capsule slide must stop at the radius-expanded boundary")
    var clear = capsule.moveCapsule(2, 2, 2, 4, 2, 2, 1)
    assert(clear.accepted() && !clear.collided() && !clear.stepped() &&
        clear.resolvedX() == 4,
        "clear capsule movement must preserve its endpoint")
    assert(capsule.configureStepObstacle(4, 6, 0, 10, 2),
        "bounded step obstacle must configure")
    var stepped = capsule.moveCapsule(2, 2, 2, 8, 2, 2, 2)
    assert(stepped.accepted() && stepped.collided() && stepped.stepped() &&
        stepped.resolvedX() == 8 && stepped.stepHeight() == 2,
        "capsule must traverse a bounded obstacle with enough step height")
    var tooLow = capsule.moveCapsule(2, 2, 2, 8, 2, 2, 1)
    assert(tooLow.accepted() && tooLow.collided() && !tooLow.stepped() &&
        tooLow.resolvedX() == 2,
        "capsule must slide when step height is insufficient")
    assert(capsule.addStepObstacle(4, 6, 4, 6, 2) &&
        capsule.stepObstacleCount() == 2,
        "capsule must retain multiple bounded obstacles")
    assert(capsule.addStepObstacle(0, 1, 8, 9, 1) &&
        capsule.addStepObstacle(8, 9, 0, 1, 1) &&
        capsule.addStepObstacle(8, 9, 8, 9, 1) &&
        capsule.stepObstacleCount() == 5,
        "capsule obstacle capacity must exceed the legacy four-slot bound")
    var orderedHit = capsule.queryCapsule(2, 2, 2, 8, 2, 8)
    assert(orderedHit.accepted() && orderedHit.collided() && orderedHit.hitStep() == 1,
        "capsule obstacles must resolve in deterministic traversal order")
    assert(capsule.clearStepObstacles() && capsule.stepObstacleCount() == 0,
        "capsule obstacle collection must clear")
    var afterClear = capsule.moveCapsule(2, 2, 2, 8, 2, 8, 1)
    assert(afterClear.accepted() && !afterClear.collided(),
        "cleared capsule obstacles must no longer block movement")
    var gate = SpatialQueryGate(0, 0, 0, 10, 10, 10, 1, 20)
    var admitted = gate.admitPlayerMoveWithStep(2, 2, 2, 12, 2, 2, 1)
    assert(admitted.accepted() && admitted.collided() && admitted.slideX() == 7,
        "spatial gate must expose authoritative capsule slide")
    assert(gate.addBroadPhaseTriangle(0, 0, 5, 4, 0, 5, 0, 4, 5),
        "spatial gate must accept broad-phase movement geometry")
    var gateRevision = gate.broadPhaseRevision()
    var broadAdmitted = gate.admitPlayerMoveWithBroadPhase(
        gateRevision, 1, 1, 1, 1, 1, 8)
    assert(broadAdmitted.accepted() && broadAdmitted.collided() &&
        broadAdmitted.resolvedZ() <= 5,
        "spatial gate must combine broad-phase and capsule admission")
    var staleBroadAdmitted = gate.admitPlayerMoveWithBroadPhase(
        gateRevision - 1, 1, 1, 1, 1, 1, 8)
    assert(!staleBroadAdmitted.accepted(),
        "spatial gate must reject stale broad-phase movement geometry")
}

test "shared capsule and spatial admission" {
    var capsule = BoundedCapsuleWorld(0, 0, 0, 10, 10, 10, 1, 20)
    var capsuleHit = capsule.queryCapsule(2, 2, 2, 10, 2, 2)
    assert(capsuleHit.accepted() && capsuleHit.collided(),
        "capsule center must respect expanded bounds")
    assert(capsule.capsuleRadius() == 1, "capsule radius must remain bounded")
    assert(!capsule.configure(0, 0, 0, 1, 1, 1, 1, 20),
        "capsule larger than volume must reject")

    var gate = SpatialQueryGate(0, 0, 0, 10, 10, 10, 1, 20)
    var player = gate.admitPlayerMove(2, 2, 2, 9, 2, 2)
    var projectile = gate.admitProjectile(1, 1, 1, 12, 1, 1)
    var lineOfSight = gate.admitLineOfSight(1, 1, 1, 12, 1, 1)
    assert(player.accepted() && !player.collided(),
        "player admission must use capsule bounds")
    assert(projectile.collided() && lineOfSight.collided(),
        "projectile and line-of-sight must share segment admission")
}

test "authoritative weapon and damage transitions" {
    var combat = CombatWorld(2, 1)
    assert(!combat.defineWeapon(0, 2, 3, 2, 5, 1, 100),
        "weapon definitions must reject invalid identity")
    assert(combat.defineWeapon(7, 2, 3, 2, 5, 1, 100),
        "weapon definition must accept bounded firing data")
    assert(combat.addActor(1, 20, 2) && combat.addActor(2, 9, 1),
        "combat actors must admit bounded health and armor")
    assert(combat.equipWeapon(1, 7),
        "alive actors must equip a defined weapon")
    var firstShot = combat.fire(1, 4)
    assert(firstShot.accepted() && firstShot.shotId() == 1 &&
        firstShot.magazine() == 1 && firstShot.reserve() == 3 &&
        firstShot.nextReadyTick() == 6,
        "accepted shots must atomically consume ammo and set cooldown")
    assert(!combat.fire(1, 5).accepted(),
        "cooldown must reject a shot before its ready tick")
    var secondShot = combat.fire(1, 6)
    assert(secondShot.accepted() && secondShot.magazine() == 0,
        "ready weapons must fire with the remaining magazine")
    assert(!combat.fire(1, 7).accepted(),
        "empty magazines must reject shots without mutating state")
    assert(combat.reload(1) && combat.magazine(1) == 2 &&
        combat.reserve(1) == 1,
        "reload must transfer bounded reserve ammo atomically")

    var invalidSource = combat.applyDamage(DamageRequest(99, 2, 5, 1, 0))
    assert(!invalidSource.accepted() && combat.currentHealth(2) == 9,
        "damage must reject unknown sources without mutation")
    var hit = combat.applyDamage(DamageRequest(1, 2, 5, 1, 0))
    assert(hit.accepted() && hit.applied() == 4 &&
        hit.remainingHealth() == 5 && !hit.died(),
        "damage must apply armor before health reduction")
    var critical = combat.applyDamage(DamageRequest(1, 2, 3, 1, 1))
    assert(critical.accepted() && critical.applied() == 5 &&
        critical.remainingHealth() == 0 && critical.died() &&
        critical.deathSequence() == 1 && combat.deaths() == 1,
        "critical damage must own the single alive-to-dead transition")
    assert(!combat.applyDamage(DamageRequest(1, 2, 1, 1, 0)).accepted() &&
        combat.deaths() == 1,
        "dead targets must reject repeated damage and rewards")
}

test "shared hitscan projectile and bounded combat events" {
    var combat = CombatWorld(2, 1)
    assert(combat.defineWeapon(4, 3, 0, 0, 4, 2, 25))
    assert(combat.addActor(1, 20, 0) && combat.addActor(2, 12, 0))
    assert(combat.equipWeapon(1, 4))
    var hitscan = combat.resolveHitscan(1, 2, 0, 25, 0)
    assert(hitscan.accepted() && hitscan.actionId() == 1 &&
        hitscan.applied() == 4 && hitscan.remainingHealth() == 8 &&
        hitscan.eventSequence() == 1 && combat.magazine(1) == 2,
        "hitscan must share weapon range, ammo and damage authority")
    assert(combat.pendingCombatEvents() == 1 &&
        combat.dequeueCombatEvent(),
        "accepted hits must publish a bounded combat event")
    var hitscanEvent = combat.lastCombatEvent()
    assert(hitscanEvent.kind() == 1 && hitscanEvent.sourceId() == 1 &&
        hitscanEvent.targetId() == 2 && hitscanEvent.applied() == 4 &&
        !hitscanEvent.died(),
        "hitscan events must preserve authoritative damage details")
    assert(!combat.resolveHitscan(1, 2, 0, 26, 0).accepted() &&
        combat.magazine(1) == 2,
        "out-of-range hitscan must reject without consuming ammo")

    var projectile = combat.spawnProjectile(1, 1)
    assert(projectile.accepted() && projectile.projectileId() == 1 &&
        combat.projectileIsActive(1) && combat.magazine(1) == 1,
        "projectile spawn must consume one shot and reserve a bounded slot")
    var projectileHit = combat.resolveProjectile(1, 2, 25, 1)
    assert(projectileHit.accepted() && projectileHit.applied() == 8 &&
        projectileHit.remainingHealth() == 0 && projectileHit.died() &&
        !combat.projectileIsActive(1),
        "projectile resolution must reuse critical damage and consume itself")
    assert(combat.pendingCombatEvents() == 1 &&
        combat.dequeueCombatEvent(),
        "projectile resolution must enqueue one bounded event")
    var projectileEvent = combat.lastCombatEvent()
    assert(projectileEvent.kind() == 2 && projectileEvent.sequence() == 2 &&
        projectileEvent.died() && combat.deaths() == 1,
        "projectile event must preserve sequence and death transition")
}

test "deterministic enemy states and encounter admission" {
    var enemies = EnemyStateWorld(2)
    assert(enemies.configure(100, 20, 4),
        "enemy state world must configure perception and attack bounds")
    assert(!enemies.configure(20, 30, 4),
        "attack range cannot exceed perception range")
    assert(enemies.addEnemy(7, 0) && enemies.state(7) == enemies.idleState(),
        "enemy admission must start in idle")
    var chase = enemies.step(7, 1, 1, true, 60)
    assert(chase.accepted() && chase.state() == enemies.chaseState() &&
        chase.targetId() == 1 && !chase.attackReady(),
        "visible distant targets must drive deterministic chase")
    var attack = enemies.step(7, 2, 1, true, 20)
    assert(attack.accepted() && attack.state() == enemies.attackState() &&
        attack.attackReady() && enemies.attackReadyTick(7) == 6,
        "visible near targets must enter attack and schedule cooldown")
    var waiting = enemies.step(7, 5, 1, true, 20)
    assert(waiting.accepted() && !waiting.attackReady() &&
        !waiting.transitioned(),
        "attack cooldown must suppress repeated attack decisions")
    var repeated = enemies.step(7, 6, 1, true, 20)
    assert(repeated.attackReady() && enemies.attackReadyTick(7) == 10,
        "attack readiness must recur on an integer tick boundary")
    var lost = enemies.step(7, 7, 0, false, 0)
    assert(lost.accepted() && lost.state() == enemies.investigateState() &&
        lost.targetId() == 0,
        "lost perception must clear target and enter investigate")
    assert(!enemies.transition(7, enemies.patrolState(), 6),
        "state transitions must reject time going backwards")
    assert(enemies.kill(7, 8) && enemies.state(7) == enemies.deadState())
    var dead = enemies.step(7, 9, 1, true, 1)
    assert(dead.accepted() && dead.state() == enemies.deadState() &&
        !dead.attackReady(),
        "dead enemies must remain terminal")

    var encounters = EncounterDirector(1)
    assert(!encounters.define(0, 1, 2) && encounters.define(10, 1, 2),
        "encounter definitions must validate identity and budgets")
    var first = encounters.admit(10, 7)
    assert(first.accepted() && first.activeCount() == 1 &&
        first.remainingBudget() == 1,
        "encounter admission must consume one bounded spawn budget")
    assert(!encounters.admit(10, 8).accepted(),
        "encounter active limit must reject overflow")
    assert(encounters.release(10))
    var second = encounters.admit(10, 8)
    assert(second.accepted() && second.remainingBudget() == 0,
        "released encounter slots must admit remaining budget")
    assert(!encounters.admit(10, 9).accepted() &&
        encounters.release(10) && !encounters.release(10),
        "exhausted encounters must reject spawns and extra releases")
}

test "authoritative enemy combat event bridge" {
    var session = AuthoritativeEnemySession(3, 1)
    assert(session.configureEnemyRules(100, 20, 2))
    assert(session.defineWeapon(9, 2, 0, 0, 3, 1, 20))
    assert(session.defineEncounter(4, 1, 2))
    assert(session.addActor(1, 20, 0) && session.equipWeapon(1, 9))
    assert(session.admitEnemy(4, 2, 0, 5, 0, 9) &&
        session.encounterActiveCount(4) == 1,
        "authoritative admission must link combat, AI and encounter state")

    var enemyAttack = session.stepEnemy(2, 0, 1, true, 10, 0)
    assert(enemyAttack.accepted() && enemyAttack.fired() &&
        enemyAttack.targetId() == 1 && enemyAttack.applied() == 3 &&
        session.pendingCombatEvents() == 1,
        "enemy attack decisions must resolve through authoritative combat")
    assert(session.consumeCombatEvents(0) == 0 &&
        session.pendingCombatEvents() == 0,
        "non-death attack events must be consumed without changing admission")

    var enemyDeath = session.playerHitscan(1, 2, 1, 10, 1)
    assert(enemyDeath.accepted() && enemyDeath.died() &&
        session.enemyState(2) == 7 &&
        session.encounterActiveCount(4) == 0 &&
        session.pendingCombatEvents() == 0,
        "enemy death events must transition AI state and release encounter slots")
    assert(session.admitEnemy(4, 3, 2, 5, 0, 9),
        "released encounter slots must admit remaining deterministic budget")
}

test "loopback enemy tick and replicated snapshots" {
    var loopback = LoopbackSession(4, 4)
    assert(loopback.start())
    assert(loopback.configureEnemyRules(100, 20, 2))
    assert(loopback.defineEnemyWeapon(9, 2, 0, 0, 3, 1, 20))
    assert(loopback.defineEnemyEncounter(4, 1, 2))
    assert(loopback.addEnemyCombatActor(1, 20, 0) &&
        loopback.equipEnemyCombatWeapon(1, 9))
    assert(loopback.admitEnemy(4, 2, 0, 5, 0, 9))
    assert(loopback.configureEnemyPerception(2, 1, true, 10, 0))
    assert(loopback.advance(16667) == 1,
        "loopback must advance one authoritative enemy tick")
    var decision = loopback.lastEnemyAttack()
    assert(decision.accepted() && decision.fired() &&
        decision.targetId() == 1 && decision.applied() == 3,
        "loopback tick must publish the authoritative enemy attack decision")
    assert(loopback.enemySnapshotCount() == 1)
    var serverSnapshot = loopback.latestEnemySnapshot()
    assert(serverSnapshot.tick() == 1 && serverSnapshot.enemyId() == 2 &&
        serverSnapshot.state() == 4 && serverSnapshot.targetId() == 1,
        "loopback must publish enemy state and target in its snapshot")
    assert(loopback.applyEnemySnapshot(serverSnapshot) &&
        loopback.clientEnemySnapshotCount() == 1 &&
        loopback.latestClientEnemySnapshot().sequence() == serverSnapshot.sequence(),
        "client must accept the monotonic enemy snapshot")
}

test "enemy spatial visibility movement and projectile targeting" {
    var world = EnemySpatialWorld(2, 20)
    assert(world.configureBounds(0, 0, 0, 10, 10, 10),
        "enemy spatial bounds must configure")
    assert(world.setPosition(2, 2, 2, 0) &&
        world.setPosition(1, 2, 2, 10),
        "enemy spatial actors must register")
    var clear = world.visibility(2, 1, 20)
    assert(clear.accepted() && clear.visible() && clear.distance() == 10,
        "clear spatial path must be visible")
    assert(world.addObstacle(0, 0, 5, 10, 0, 5, 0, 10, 5),
        "enemy spatial obstacle must insert")
    var blocked = world.visibility(2, 1, 20)
    assert(blocked.accepted() && !blocked.visible() && blocked.hitStep() == 5,
        "obstacle must block enemy line of sight")
    var movement = world.moveToward(2, 1, 10)
    assert(movement.accepted() && movement.collided() &&
        movement.resolvedZ() == 4 && world.positionZ(2) == 4,
        "enemy movement must stop at the authoritative obstacle sample")

    var session = AuthoritativeEnemySession(3, 1)
    assert(session.configureEnemyRules(100, 20, 2) &&
        session.defineWeapon(9, 2, 0, 0, 3, 1, 20) &&
        session.defineEncounter(4, 1, 2),
        "spatial combat rules must configure")
    assert(session.addActor(1, 20, 0) &&
        session.equipWeapon(1, 9) &&
        session.admitEnemy(4, 2, 0, 5, 0, 9),
        "spatial combat actors must admit")
    assert(session.setSpatialPosition(1, 0, 0, 0) &&
        session.setSpatialPosition(2, 0, 0, 10),
        "spatial combat actors must position")
    var projectile = session.projectileAttackSpatial(1, 2, 0, 20, 0)
    assert(projectile.accepted() && projectile.applied() == 3,
        "clear spatial projectile must resolve through combat")

    var blockedSession = AuthoritativeEnemySession(3, 1)
    assert(blockedSession.configureEnemyRules(100, 20, 2) &&
        blockedSession.defineWeapon(9, 2, 0, 0, 3, 1, 20) &&
        blockedSession.defineEncounter(4, 1, 2) &&
        blockedSession.addActor(1, 20, 0) &&
        blockedSession.admitEnemy(4, 2, 0, 5, 0, 9),
        "blocked spatial combat actors must admit")
    assert(blockedSession.setSpatialPosition(1, 2, 2, 0) &&
        blockedSession.setSpatialPosition(2, 2, 2, 10) &&
        blockedSession.addSpatialObstacle(0, 0, 5, 10, 0, 5, 0, 10, 5),
        "blocked spatial combat geometry must configure")
    var blockedAttack = blockedSession.stepEnemySpatial(2, 0, 1, 0)
    assert(blockedAttack.accepted() && !blockedAttack.fired() &&
        blockedSession.enemyState(2) == 2,
        "blocked enemy perception must investigate without attacking")
    var blockedProjectile = blockedSession.projectileAttackSpatial(1, 2, 0, 20, 0)
    assert(!blockedProjectile.accepted(),
        "blocked spatial projectile must not resolve damage")
}

test "continuous projectiles and encounter zones" {
    var session = AuthoritativeEnemySession(4, 1)
    assert(session.configureEnemyRules(100, 20, 2) &&
        session.defineWeapon(9, 4, 0, 0, 3, 1, 20) &&
        session.defineEncounter(4, 2, 2),
        "continuous projectile rules must configure")
    assert(session.addActor(1, 20, 0) &&
        session.equipWeapon(1, 9) &&
        session.admitEnemyAt(4, 2, 0, 5, 0, 9, 0, 0, 10),
        "positioned encounter admission must register")
    assert(session.setSpatialPosition(1, 0, 0, 0),
        "projectile source position must register")
    var projectile = session.spawnSpatialProjectile(1, 2, 0, 20, 3, 0)
    assert(projectile.accepted() && session.activeSpatialProjectiles() == 1,
        "continuous projectile must remain active between ticks")
    assert(session.advanceSpatialProjectiles(0) == 1 &&
        session.activeSpatialProjectiles() == 1,
        "projectile must advance without resolving before target contact")
    assert(session.advanceSpatialProjectiles(1) == 1 &&
        session.advanceSpatialProjectiles(2) == 1 &&
        session.advanceSpatialProjectiles(3) == 1 &&
        session.activeSpatialProjectiles() == 0 &&
        session.spatialProjectileHits() == 1,
        "projectile must resolve exactly on its terminal sweep")

    var blocked = AuthoritativeEnemySession(4, 1)
    assert(blocked.configureEnemyRules(100, 20, 2) &&
        blocked.defineWeapon(9, 4, 0, 0, 3, 1, 20) &&
        blocked.defineEncounter(4, 2, 2) &&
        blocked.addActor(1, 20, 0) &&
        blocked.equipWeapon(1, 9) &&
        blocked.admitEnemyAt(4, 2, 0, 5, 0, 9, 0, 0, 10) &&
        blocked.setSpatialPosition(1, 0, 0, 0) &&
        blocked.addSpatialObstacle(0, 0, 5, 10, 0, 5, 0, 10, 5),
        "blocked projectile geometry must configure")
    var blockedProjectile = blocked.spawnSpatialProjectile(1, 2, 0, 20, 3, 0)
    assert(blockedProjectile.accepted() &&
        blocked.advanceSpatialProjectiles(0) == 1 &&
        blocked.advanceSpatialProjectiles(1) == 0 &&
        blocked.activeSpatialProjectiles() == 0 &&
        blocked.spatialProjectileBlocked() == 1 &&
        blocked.spatialProjectileHits() == 0,
        "obstacle must terminate a continuous projectile without damage")

    var zones = AuthoritativeEnemySession(4, 1)
    assert(zones.defineWeapon(9, 1, 0, 0, 1, 1, 5) &&
        zones.defineEncounter(7, 2, 2) &&
        zones.configureEncounterZone(7, 0, 0, 0, 5),
        "encounter zone must configure")
    assert(zones.admitEnemyAt(7, 3, 0, 5, 0, 9, 2, 0, 0),
        "enemy inside encounter zone must admit")
    assert(!zones.admitEnemyAt(7, 4, 0, 5, 0, 9, 8, 0, 0) &&
        zones.encounterActiveCount(7) == 1,
        "enemy outside encounter zone must reject without consuming slot")
    var loopback = LoopbackSession(4, 4)
    assert(loopback.start() &&
        loopback.configureEnemyRules(100, 20, 2) &&
        loopback.defineEnemyWeapon(9, 4, 0, 0, 3, 1, 20) &&
        loopback.defineEnemyEncounter(4, 1, 1) &&
        loopback.addEnemyCombatActor(1, 20, 0) &&
        loopback.equipEnemyCombatWeapon(1, 9) &&
        loopback.admitEnemyAt(4, 2, 0, 5, 0, 9, 0, 0, 10) &&
        loopback.setEnemySpatialPosition(1, 0, 0, 0),
        "loopback must admit spatial projectile actors")
    var loopbackProjectile = loopback.spawnEnemyProjectileSpatial(1, 2, 0, 20, 3, 0)
    assert(loopbackProjectile.accepted() &&
        loopback.advance(16667) == 1 &&
        loopback.advance(16667) == 1 &&
        loopback.advance(16667) == 1 &&
        loopback.advance(16667) == 1 &&
        loopback.activeEnemyProjectiles() == 0 &&
        loopback.enemyProjectileHits() == 1,
        "fixed-step loopback must advance and resolve continuous projectiles")
}
test "deterministic navigation and projectile impact events" {
    var navigation = EnemySpatialWorld(2, 20)
    assert(navigation.configureBounds(0, 0, 0, 10, 10, 10) &&
        navigation.setPosition(2, 1, 1, 1) &&
        navigation.setPosition(1, 1, 1, 8),
        "navigation actors must fit configured bounds")
    assert(navigation.addObstacle(
        0, 0, 4, 6, 0, 4, 0, 10, 4),
        "navigation obstacle must insert")
    var route = navigation.navigation(2, 1)
    assert(route.accepted() && route.found() && route.routeLength() > 0 &&
        route.waypointX() == 1 && route.waypointZ() == 2,
        "bounded A* must choose the deterministic first detour waypoint")
    var steering = navigation.steerToward(2, 1, 1)
    assert(steering.accepted() && steering.found() &&
        steering.resolvedX() == 1 && steering.resolvedZ() == 2 &&
        navigation.positionZ(2) == 2,
        "path steering must advance through the first route waypoint")

    var impacts = AuthoritativeEnemySession(3, 1)
    assert(impacts.configureEnemyRules(100, 20, 2) &&
        impacts.defineWeapon(9, 4, 0, 0, 3, 1, 20) &&
        impacts.defineEncounter(4, 1, 1) &&
        impacts.addActor(1, 20, 0) &&
        impacts.equipWeapon(1, 9) &&
        impacts.admitEnemyAt(4, 2, 0, 5, 0, 9, 0, 0, 6) &&
        impacts.setSpatialPosition(1, 0, 0, 0),
        "impact event actors must configure")
    var projectile = impacts.spawnSpatialProjectile(1, 2, 0, 20, 3, 0)
    assert(projectile.accepted() &&
        impacts.advanceSpatialProjectiles(0) == 1 &&
        impacts.advanceSpatialProjectiles(1) == 1 &&
        impacts.pendingSpatialImpacts() == 1,
        "terminal projectile hit must publish one impact event")
    assert(impacts.dequeueSpatialImpact())
    var impact = impacts.lastSpatialImpact()
    assert(impact.kind() == 1 && impact.sourceId() == 1 &&
        impact.targetId() == 2 && impact.applied() == 3 &&
        impacts.pendingSpatialImpacts() == 0,
        "hit impact must preserve authority and applied damage")
}
test "replicated projectile presentation queues" {
    var loopback = LoopbackSession(4, 4)
    assert(loopback.start() &&
        loopback.configureEnemyRules(100, 20, 2) &&
        loopback.defineEnemyWeapon(9, 4, 0, 0, 3, 1, 20) &&
        loopback.defineEnemyEncounter(4, 1, 1) &&
        loopback.addEnemyCombatActor(1, 20, 0) &&
        loopback.equipEnemyCombatWeapon(1, 9) &&
        loopback.admitEnemyAt(4, 2, 0, 5, 0, 9, 0, 0, 10) &&
        loopback.setEnemySpatialPosition(1, 0, 0, 0),
        "presentation loopback actors must configure")
    var projectile = loopback.spawnEnemyProjectileSpatial(1, 2, 0, 20, 3, 0)
    assert(projectile.accepted() &&
        loopback.advance(16667) == 1 &&
        loopback.advance(16667) == 1 &&
        loopback.advance(16667) == 1 &&
        loopback.advance(16667) == 1 &&
        loopback.enemyImpactSnapshotCount() == 1,
        "loopback must publish the terminal impact snapshot")
    var snapshot = loopback.latestEnemyImpactSnapshot()
    assert(snapshot.kind() == 1 && snapshot.sourceId() == 1 &&
        snapshot.targetId() == 2 && snapshot.applied() == 3 &&
        loopback.applyEnemyImpactSnapshot(snapshot) &&
        loopback.clientEnemyImpactSnapshotCount() == 1 &&
        loopback.pendingEnemyImpactPresentations() == 1 &&
        loopback.pendingEnemyImpactAudio() == 1,
        "client admission must stage impact presentation and audio")
    assert(loopback.dequeueEnemyImpactPresentation())
    var presentation = loopback.lastEnemyImpactPresentation()
    assert(presentation.sequence() == snapshot.sequence() &&
        presentation.clip() == 201 && presentation.gain() == 100 &&
        presentation.x() == snapshot.x(),
        "presentation event must preserve replicated impact identity")
    assert(loopback.dequeueEnemyImpactAudio() &&
        loopback.consumedEnemyImpactClip() == 201 &&
        loopback.consumedEnemyImpactGain() == 100 &&
        !loopback.applyEnemyImpactSnapshot(snapshot),
        "audio consumption and duplicate snapshot rejection must be bounded")
}
