import core
import session

main() {
    println("KOOKIE G0 session foundation")
    println(tickRate())
    println(roundTripEnvelope(protocolVersion(), 1, 0, 1))

    var resources = ResourceRegistry(2)
    var mesh = resources.acquire(1)
    assert(resources.isValid(mesh), "fresh token must be valid")
    assert(resources.activeCount() == 1, "acquire must consume one slot")
    assert(!resources.isValid(ResourceToken(mesh.slot(), mesh.generation(), 2)), "kind mismatch must reject")
    assert(resources.release(mesh), "live token must release")
    assert(!resources.isValid(mesh), "released token must be stale")
    assert(!resources.release(mesh), "double release must reject")

    var replacement = resources.acquire(1)
    assert(replacement.slot() == mesh.slot(), "allocator should reuse the first free slot")
    assert(replacement.generation() != mesh.generation(), "reuse must advance generation")
    assert(resources.isValid(replacement), "replacement token must be valid")
    println("KOOKIE G0 resource tokens verified")


    var window = WindowStateTracker(1280, 720)
    assert(window.applyFocus(1), "focus event must be accepted")
    assert(window.applyResize(1920, 1080), "positive resize must be accepted")
    assert(!window.applyResize(0, 1080), "zero resize must be rejected")
    assert(window.requestClose(), "close event must be accepted")
    var windowState = window.snapshot()
    assert(windowState.width() == 1920 && windowState.height() == 1080, "resize state must be copied")
    assert(windowState.focused() && windowState.closeRequested(), "focus and close state must be copied")

    var audio = QueuedAudio(2)
    assert(audio.open(), "audio queue must open once")
    assert(audio.queue(11, 80), "audio command must enqueue")
    assert(audio.queue(12, 60), "audio queue must accept capacity")
    assert(!audio.queue(13, 40), "audio queue must reject overflow")
    assert(audio.dequeue(), "audio command must dequeue")
    assert(audio.consumedClip() == 11 && audio.consumedGain() == 80, "audio order must be FIFO")
    assert(audio.close(), "audio queue must close")
    println("KOOKIE G0 scalar adapter contracts verified")

    var staging = FrameStaging(3)
    assert(staging.begin(1), "frame staging must open")
    assert(staging.pushVertex(1, -80, -80, 0, 100), "first vertex must stage")
    assert(staging.pushVertex(1, 80, -80, 100, 100), "second vertex must stage")
    assert(staging.pushVertex(1, 0, 80, 50, 0), "third vertex must stage")
    assert(staging.stagedCount() == 3, "triangle vertex count must stage")
    assert(staging.scalarWrites() == 15, "triangle scalar write count must be measured")
    assert(staging.checksum() == 273, "triangle staging checksum must be stable")
    assert(staging.scalarBudget() == 15, "frame staging budget must be bounded")
    assert(staging.fitsScalarBudget(15) && !staging.fitsScalarBudget(14),
        "frame staging must report budget acceptance")
    assert(staging.publish(), "frame staging must publish")
    assert(staging.retire(1), "published frame must retire")
    var retired = staging.publishedFrame() == 1 && staging.retiredFrame() == 1 && !staging.isOpen()
    assert(retired, "published frame ownership must close")
    var meshStaging = FrameStaging(6)
    assert(meshStaging.begin(2), "quad mesh staging must open")
    assert(meshStaging.pushVertex(1, -80, -80, 0, 100), "quad vertex one must stage")
    assert(meshStaging.pushVertex(1, 80, -80, 100, 100), "quad vertex two must stage")
    assert(meshStaging.pushVertex(1, 80, 80, 100, 0), "quad vertex three must stage")
    assert(meshStaging.pushVertex(1, -80, -80, 0, 100), "quad vertex four must stage")
    assert(meshStaging.pushVertex(1, 80, 80, 100, 0), "quad vertex five must stage")
    assert(meshStaging.pushVertex(1, -80, 80, 0, 0), "quad vertex six must stage")
    assert(meshStaging.stagedCount() == 6 && meshStaging.scalarWrites() == 30,
        "quad mesh must stage six vertices")
    assert(meshStaging.scalarBudget() == 30 && meshStaging.fitsScalarBudget(30),
        "quad mesh must fit its bounded frame budget")
    assert(meshStaging.publish() && meshStaging.retire(2),
        "quad mesh staging must retire")
    println("KOOKIE G0 frame staging verified")
    var clock = FixedStepClock(60, 4)
    assert(clock.advance(16667) == 1, "fixed-step clock must advance one tick")
    assert(clock.tick() == 1 && clock.pendingMicros() == 1, "fixed-step remainder must be retained")
    assert(clock.frameBudgetMicros() == 16667,
        "fixed-step frame budget must be declared")
    assert(clock.advance(-1) == -1, "negative elapsed time must reject")

    var component = IntComponentStore(2)
    assert(component.set(1, 40), "component value must insert")
    assert(component.set(2, 80), "component capacity must accept")
    assert(!component.set(3, 120), "component capacity must reject overflow")
    assert(component.get(1) == 40 && component.activeCount() == 2, "component values must be readable")
    assert(component.remove(1) && !component.has(1), "component value must remove")

    var loopback = LoopbackSession(4, 2)
    assert(loopback.start(), "loopback server must start")
    assert(loopback.connectPlayer() == 1, "first loopback client must connect")
    assert(loopback.connectPlayer() == 2, "second loopback client must connect")
    assert(loopback.playerCount() == 2, "loopback must track two clients")
    assert(loopback.receiveInput(1, 1, 1, 3, 0, 0, 0, 1, 0), "first input command must queue")
    assert(loopback.receiveInput(2, 1, 1, 2, 0, 0, 0, 0, 1), "second input command must queue")
    assert(!loopback.receiveInput(1, 1, 1, 4, 0, 0, 0, 1, 0), "stale input sequence must reject")
    assert(loopback.advance(16667) == 1, "authoritative tick must advance")
    assert(loopback.serverPosition(1) == 3 && loopback.serverPosition(2) == 2, "authoritative movement must apply")
    assert(loopback.inSync(), "snapshot must reach loopback clients")
    var loopbackEdges = loopback.lastInputEdges(1)
    var inputPublished = loopbackEdges.firePressed() == 1 && loopback.latestSnapshotSequence() == 1
    assert(inputPublished, "input edge and snapshot must publish")
    assert(!loopback.applySnapshot(1, 1, 1, 99), "stale snapshot must reject")
    assert(loopback.clientPosition(1) == 3, "stale snapshot must not overwrite client state")
    var mapper = InputMapper(10)
    var mapped = mapper.map(20, -20, 3, -4, 7, -2)
    assert(mapped.moveX() == 10 && mapped.moveY() == -10, "input movement must clamp")
    assert(mapped.fire() == 1 && mapped.jump() == 0, "input buttons must normalize")
    var camera = CameraState(-45, 45)
    assert(camera.applyLook(12, 100), "camera look must apply")
    assert(camera.currentYaw() == 12 && camera.currentPitch() == 45, "camera pitch must clamp")
    println("KOOKIE G1 loopback foundation verified")

}
test "player fire input publishes weapon presentation" {
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1)
    assert(loopback.definePlayerWeapon(9, 2, 1, 1, 4, 1, 20))
    assert(loopback.addPlayerCombatActor(1, 20, 0))
    assert(loopback.equipPlayerCombatWeapon(1, 9))
    assert(loopback.receiveInput(1, 1, 1, 0, 0, 0, 0, 1, 0))
    assert(loopback.advance(16667) == 1)
    assert(loopback.playerWeaponPresentationCount() == 1 &&
        loopback.playerCombatMagazine(1) == 1 &&
        loopback.playerCombatReserve(1) == 1,
        "confirmed fire input must consume authoritative ammo")
    assert(loopback.dequeuePlayerWeaponPresentation())
    var shotPresentation = loopback.lastPlayerWeaponPresentation()
    assert(shotPresentation.kind() == 1 &&
        shotPresentation.actorId() == 1 &&
        shotPresentation.shotId() == 1 &&
        shotPresentation.weaponId() == 9 &&
        shotPresentation.magazine() == 1,
        "accepted fire must publish bounded weapon presentation")
    assert(loopback.receiveInput(1, 2, 2, 0, 0, 0, 0, 1, 0))
    assert(loopback.advance(16667) == 1 &&
        loopback.playerWeaponPresentationCount() == 0,
        "held fire must not duplicate edge-triggered weapon presentation")
    assert(loopback.receiveInput(1, 3, 3, 0, 0, 0, 0, 0, 0))
    assert(loopback.advance(16667) == 1)
    assert(loopback.receiveInput(1, 4, 4, 0, 0, 0, 0, 1, 0))
    assert(loopback.advance(16667) == 1 &&
        loopback.playerWeaponPresentationCount() == 1,
        "a new fire edge must publish after release")
}

test "bounded save envelope validation" {
    var save = BoundedSaveState(3, 1000)
    var payload = new Int[3]
    payload[0] = 12
    payload[1] = 34
    payload[2] = 56
    assert(save.stage(1, 7, payload) &&
        save.isStaged() &&
        save.payloadLength() == 3 &&
        save.schemaVersion() == 1 &&
        save.revision() == 7 &&
        save.payloadValue(1) == 34,
        "bounded save state must stage versioned payload values")
    var envelope = save.envelope()
    assert(envelope.accepted() &&
        envelope.schemaVersion() == 1 &&
        envelope.revision() == 7 &&
        envelope.payloadLength() == 3 &&
        envelope.checksum() > 0,
        "save envelope must expose deterministic metadata")
    var restored = BoundedSaveState(3, 1000)
    assert(restored.load(envelope, payload) &&
        restored.payloadValue(0) == 12 &&
        restored.payloadValue(2) == 56,
        "matching envelope and payload must restore state")
    payload[1] = 35
    assert(!restored.load(envelope, payload),
        "mutated payload must fail checksum validation")
    assert(!save.stage(2, 7, payload) &&
        !save.stage(1, -1, payload) &&
        !save.stage(1, 1000001, payload) &&
        !save.stage(1, 7, new Int[4]),
        "unsupported versions, revisions and overflow must reject")
    var invalidValue = new Int[1]
    invalidValue[0] = 1001
    assert(!save.stage(1, 8, invalidValue),
        "values beyond the schema bound must reject")
    assert(save.clear() && !save.isStaged() &&
        save.payloadValue(0) == -1,
        "clearing save state must remove staged payload access")
}
test "bounded save publication history" {
    var first = BoundedSaveState(2, 100)
    var firstPayload = new Int[2]
    firstPayload[0] = 10
    firstPayload[1] = 20
    assert(first.stage(1, 1, firstPayload))
    var second = BoundedSaveState(2, 100)
    var secondPayload = new Int[2]
    secondPayload[0] = 30
    secondPayload[1] = 40
    assert(second.stage(1, 2, secondPayload))
    var history = BoundedSaveHistory(2, 2)
    assert(history.publish(first) && history.publish(second) &&
        history.count() == 2 && history.latestRevision() == 2,
        "save history must publish strictly increasing revisions")
    assert(!history.publish(second),
        "save history must reject duplicate revisions")
    var restored = BoundedSaveState(2, 100)
    assert(history.restore(1, restored) &&
        restored.payloadValue(0) == 10 &&
        restored.payloadValue(1) == 20,
        "save history must restore retained revisions")
    var third = BoundedSaveState(2, 100)
    var thirdPayload = new Int[2]
    thirdPayload[0] = 50
    thirdPayload[1] = 60
    assert(third.stage(1, 3, thirdPayload) &&
        history.publish(third) &&
        history.latestRevision() == 3 &&
        history.count() == 2 &&
        !history.restore(1, restored) &&
        history.restore(2, restored) &&
        restored.payloadValue(0) == 30,
        "full save history must evict its oldest revision deterministically")
    assert(history.clear() && history.count() == 0 &&
        history.latestRevision() == -1,
        "save history clear must remove published revisions")
}

test "bounded save wire codec" {
    var state = BoundedSaveState(2, 1000)
    var payload = new Int[2]
    payload[0] = 77
    payload[1] = 88
    assert(state.stage(1, 42, payload))
    var codec = BoundedSaveWireCodec(2)
    assert(codec.encode(state) &&
        codec.encodedLength() == 7 &&
        codec.encodedWord(0) == 13371337 &&
        codec.encodedWord(2) == 42 &&
        codec.encodedWord(6) == 88 &&
        codec.encodedWord(7) == -1,
        "save wire codec must emit bounded envelope words")
    var wire = new Int[7]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var restored = BoundedSaveState(2, 1000)
    assert(codec.decode(wire, restored) &&
        restored.revision() == 42 &&
        restored.payloadValue(0) == 77 &&
        restored.payloadValue(1) == 88,
        "save wire codec must restore validated payloads")
    wire[6] = 89
    assert(!codec.decode(wire, restored),
        "save wire codec must reject payload checksum corruption")
    wire[6] = 88
    wire[3] = 1
    assert(!codec.decode(wire, restored),
        "save wire codec must reject length framing corruption")
}


test "bounded save file store" {
    var state = BoundedSaveState(2, 1000)
    var payload = new Int[2]
    payload[0] = 101
    payload[1] = 202
    assert(state.stage(1, 9, payload))
    var store = BoundedSaveFileStore(2)
    var path = "/tmp/kookie-save-test.bin"
    assert(store.write(path, state),
        "save file store must write encoded bounded bytes")
    var restored = BoundedSaveState(2, 1000)
    assert(store.read(path, restored),
        "save file store must read encoded bytes")
    assert(restored.revision() == 9 &&
        restored.payloadValue(0) == 101 &&
        restored.payloadValue(1) == 202,
        "save file store must restore decoded values")
    var file = File(path)
    var corrupted = file.readBytes()
    corrupted[corrupted.length - 1] = corrupted[corrupted.length - 1] + 1
    assert(file.writeBytes(corrupted) &&
        !store.read(path, restored),
        "save file store must reject corrupted bytes")
}

test "redundant save file recovery" {
    var state = BoundedSaveState(2, 1000)
    var payload = new Int[2]
    payload[0] = 303
    payload[1] = 404
    assert(state.stage(1, 12, payload))
    var store = BoundedRedundantSaveFileStore(2)
    var path = "/tmp/kookie-save-redundant-test.bin"
    assert(store.write(path, state))
    var restored = BoundedSaveState(2, 1000)
    var file = File(path)
    var corrupted = file.readBytes()
    corrupted[18] = corrupted[18] + 1
    assert(file.writeBytes(corrupted) &&
        store.read(path, restored) &&
        restored.revision() == 12 &&
        restored.payloadValue(1) == 404,
        "redundant save must recover from one corrupted copy")
    assert(store.repair(path),
        "redundant save repair must rewrite both copies")
    var repaired = file.readBytes()
    repaired[66] = repaired[66] + 1
    assert(file.writeBytes(repaired) &&
        store.read(path, restored),
        "repaired save must survive corruption of the other copy")
    var fullyCorrupted = file.readBytes()
    fullyCorrupted[18] = fullyCorrupted[18] + 1
    assert(file.writeBytes(fullyCorrupted) &&
        !store.read(path, restored),
        "redundant save must reject two corrupted copies")
}

test "bounded save schema migration" {
    var source = BoundedSaveState(2, 1000)
    var payload = new Int[2]
    payload[0] = 303
    payload[1] = 404
    assert(source.stage(1, 12, payload))
    var sections = BoundedSaveSections(4, 2)
    var gate = BoundedSaveMigrationGate()
    assert(gate.importLegacy(source, sections) &&
        sections.revision() == 12 &&
        sections.sectionCount() == 1 &&
        sections.sectionId(0) == 1 &&
        sections.sectionVersion(0) == 1 &&
        sections.sectionValue(0, 1) == 404,
        "migration gate must wrap legacy state as a versioned section")
    var codec = BoundedSaveSchemaWireCodec(4, 2)
    assert(codec.encode(sections) && codec.encodedLength() == 9)
    var wire = new Int[codec.encodedLength()]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var decoded = BoundedSaveSections(4, 2)
    var restored = BoundedSaveState(2, 1000)
    assert(codec.decode(wire, decoded) &&
        gate.exportLegacy(decoded, restored) &&
        restored.revision() == 12 &&
        restored.payloadValue(0) == 303 &&
        restored.payloadValue(1) == 404,
        "migration gate must restore the legacy state without loss")
    wire[5] = 2
    assert(!codec.decode(wire, decoded),
        "schema codec must reject unsupported section versions")
    var unsupported = BoundedSaveSections(4, 2)
    assert(unsupported.setRevision(12) &&
        unsupported.put(2, 1, payload) &&
        !gate.exportLegacy(unsupported, restored),
        "migration gate must reject unknown sections")
}

test "schema save file persistence and recovery" {
    var source = BoundedSaveState(2, 1000)
    var payload = new Int[2]
    payload[0] = 303
    payload[1] = 404
    assert(source.stage(1, 12, payload))
    var store = BoundedSaveSchemaFileStore(4, 2)
    var path = "/tmp/kookie-save-schema-test.bin"
    assert(store.writeLegacy(path, source))
    var restored = BoundedSaveState(2, 1000)
    assert(store.readLegacy(path, restored) &&
        restored.revision() == 12 &&
        restored.payloadValue(0) == 303 &&
        restored.payloadValue(1) == 404,
        "schema file store must migrate legacy payloads on load")
    var file = File(path)
    var corrupted = file.readBytes()
    corrupted[18] = corrupted[18] + 1
    assert(file.writeBytes(corrupted) &&
        store.readLegacy(path, restored) &&
        restored.revision() == 12,
        "schema file store must recover from one corrupted copy")
    assert(store.repair(path),
        "schema save repair must rewrite both migrated copies")
    var repaired = file.readBytes()
    repaired[960] = repaired[960] + 1
    assert(file.writeBytes(repaired) &&
        store.readLegacy(path, restored),
        "repaired schema save must survive one copy corruption")
    var fullyCorrupted = file.readBytes()
    fullyCorrupted[18] = fullyCorrupted[18] + 1
    assert(file.writeBytes(fullyCorrupted) &&
        !store.readLegacy(path, restored),
        "schema save must reject two corrupted copies")
}

test "multi-section save migration" {
    var sections = BoundedSaveSections(6, 3)
    var progression = new Int[2]
    progression[0] = 303
    progression[1] = 404
    var world = new Int[3]
    world[0] = 7
    world[1] = 8
    world[2] = 0
    var rng = new Int[2]
    rng[0] = 99
    rng[1] = 0
    var items = new Int[2]
    items[0] = 17
    items[1] = 18
    var quests = new Int[1]
    quests[0] = 2
    var gate = BoundedSaveMigrationGate()
    assert(sections.setRevision(19) &&
        sections.put(1, 1, progression) &&
        sections.put(2, 2, world) &&
        sections.put(3, 2, rng) &&
        sections.put(4, 1, items) &&
        sections.put(5, 1, quests))
    var codec = BoundedSaveSchemaWireCodec(6, 3)
    assert(codec.encode(sections) && codec.encodedLength() == 29)
    var wire = new Int[codec.encodedLength()]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var decoded = BoundedSaveSections(6, 3)
    var migrated = BoundedSaveSections(6, 3)
    assert(codec.decode(wire, decoded) &&
        gate.migrate(decoded, migrated) &&
        migrated.sectionCount() == 5 &&
        migrated.revision() == 19 &&
        migrated.sectionVersion(1) == 2 &&
        migrated.sectionValue(1, 1) == 8 &&
        migrated.sectionId(3) == 4 &&
        migrated.sectionValue(3, 1) == 18 &&
        migrated.sectionId(4) == 5 &&
        migrated.sectionValue(4, 0) == 2,
        "migration must preserve progression, world, RNG, item and quest sections")
    var legacyWire = new Int[18]
    legacyWire[0] = codec.encodedWord(0)
    legacyWire[1] = 1
    legacyWire[2] = 19
    legacyWire[3] = 3
    legacyWire[4] = 1
    legacyWire[5] = 1
    legacyWire[6] = 2
    legacyWire[7] = 303
    legacyWire[8] = 404
    legacyWire[9] = 2
    legacyWire[10] = 1
    legacyWire[11] = 2
    legacyWire[12] = 7
    legacyWire[13] = 8
    legacyWire[14] = 3
    legacyWire[15] = 1
    legacyWire[16] = 1
    legacyWire[17] = 99
    assert(codec.decode(legacyWire, decoded) &&
        decoded.sectionVersion(1) == 2 &&
        decoded.sectionLength(1) == 3 &&
        decoded.sectionValue(1, 2) == 0 &&
        decoded.sectionVersion(2) == 2 &&
        decoded.sectionLength(2) == 2 &&
        decoded.sectionValue(2, 1) == 0,
        "migration must transform prior world and RNG versions")
    var store = BoundedSaveSchemaFileStore(6, 3)
    var path = "/tmp/kookie-save-multi-test.bin"
    var loaded = BoundedSaveSections(6, 3)
    assert(store.write(path, sections) &&
        store.read(path, loaded) &&
        loaded.sectionCount() == 5 &&
        loaded.sectionId(3) == 4 &&
        loaded.sectionId(4) == 5 &&
        loaded.sectionValue(4, 0) == 2,
        "schema file store must persist all known sections")
}

test "typed item and quest save sections" {
    var sections = BoundedSaveSections(6, 6)
    var items = BoundedItemSaveSection(2)
    var quests = BoundedQuestSaveSection(2)
    assert(items.add(100, 7, 4) &&
        items.add(101, 7, 1) &&
        !items.add(100, 8, 2) &&
        !items.add(102, 7, 0) &&
        quests.add(20, 2, 3) &&
        !quests.add(20, 1, 4) &&
        !quests.add(21, 4, 0) &&
        sections.setRevision(21) &&
        items.encodeInto(sections) &&
        quests.encodeInto(sections),
        "typed save sections must validate ownership, quantity and quest state")
    var codec = BoundedSaveSchemaWireCodec(6, 6)
    var wire = new Int[19]
    var restoredSections = BoundedSaveSections(6, 6)
    var restoredItems = BoundedItemSaveSection(2)
    var restoredQuests = BoundedQuestSaveSection(2)
    assert(codec.encode(sections) &&
        codec.encodedLength() == wire.length)
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    assert(codec.decode(wire, restoredSections) &&
        restoredItems.decodeFrom(restoredSections) &&
        restoredQuests.decodeFrom(restoredSections) &&
        restoredItems.count() == 2 &&
        restoredItems.ownerId(0) == 7 &&
        restoredItems.quantity(1) == 1 &&
        restoredQuests.state(0) == 2 &&
        restoredQuests.progress(0) == 3,
        "typed save sections must round-trip through the schema wire")
}

test "atomic item inventory transactions and persistence" {
    var seller = BoundedItemInventory(2, 2)
    var buyer = BoundedItemInventory(1, 2)
    assert(seller.addItem(500, 5) &&
        seller.setCurrency(0) &&
        buyer.setCurrency(100) &&
        buyer.purchaseFrom(seller, 500, 2, 10) &&
        seller.itemCount() == 1 &&
        seller.itemQuantity(0) == 3 &&
        buyer.itemCount() == 1 &&
        buyer.itemId(0) == 500 &&
        buyer.itemQuantity(0) == 2 &&
        seller.currency() == 20 &&
        buyer.currency() == 80,
        "inventory purchase must atomically transfer item and currency")
    assert(!buyer.purchaseFrom(seller, 500, 4, 10) &&
        seller.itemQuantity(0) == 3 &&
        buyer.itemQuantity(0) == 2 &&
        seller.currency() == 20 &&
        buyer.currency() == 80,
        "failed inventory purchase must leave both inventories unchanged")
    var sections = BoundedSaveSections(8, 16)
    var restored = BoundedItemInventory(1, 2)
    var codec = BoundedSaveSchemaWireCodec(8, 16)
    assert(sections.setRevision(22) &&
        buyer.encodeInto(sections) &&
        codec.encode(sections) &&
        codec.encodedLength() == 17)
    var wire = new Int[17]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var decoded = BoundedSaveSections(8, 16)
    assert(codec.decode(wire, decoded) &&
        restored.decodeFrom(decoded) &&
        restored.currency() == 80 &&
        restored.itemId(0) == 500 &&
        restored.itemQuantity(0) == 2,
        "inventory currency and ownership must survive schema persistence")
    var legacySections = BoundedSaveSections(8, 16)
    var legacyItems = new Int[3]
    legacyItems[0] = 500
    legacyItems[1] = 1
    legacyItems[2] = 2
    var legacyCurrency = new Int[1]
    legacyCurrency[0] = 80
    var legacyInventory = BoundedItemInventory(1, 2)
    assert(legacySections.setRevision(21) &&
        legacySections.put(4, 1, legacyItems) &&
        legacySections.put(6, 1, legacyCurrency) &&
        legacyInventory.decodeFrom(legacySections) &&
        !legacyInventory.itemRoll(0).accepted(),
        "legacy inventory loads without rolled-item section defaults")
}

test "deterministic item definitions and loot rolls" {
    var definitions = BoundedItemDefinitionStore(2)
    assert(definitions.define(10, 25, 1, 20, 4) &&
        definitions.define(11, 50, 5, 20, 2) &&
        !definitions.define(10, 30, 1, 20, 4) &&
        !definitions.define(12, 30, 0, 20, 4))
    var table = BoundedLootTable(2)
    assert(table.add(10, 3, definitions) &&
        table.add(11, 1, definitions) &&
        !table.add(10, 1, definitions))
    var first = BoundedItemRoll()
    var second = BoundedItemRoll()
    assert(table.roll(500, 12345, 10, definitions, first) &&
        table.roll(500, 12345, 10, definitions, second) &&
        first.accepted() &&
        first.definitionId() == second.definitionId() &&
        first.rarity() == second.rarity() &&
        first.affixOne() == second.affixOne() &&
        first.affixTwo() == second.affixTwo() &&
        first.condition() == second.condition() &&
        first.level() == 10,
        "loot rolls must be deterministic for the same seed and inputs")
    var pools = BoundedAffixPoolStore(1)
    var poolFirst = BoundedItemRoll()
    var poolSecond = BoundedItemRoll()
    assert(pools.define(4) &&
        pools.add(4, 7, 3) &&
        pools.add(4, 9, 1) &&
        table.rollWithAffixPools(
            501, 12345, 10, definitions, pools, poolFirst) &&
        table.rollWithAffixPools(
            501, 12345, 10, definitions, pools, poolSecond) &&
        poolFirst.affixOne() > 0 &&
        poolFirst.affixOne() != 1 &&
        poolFirst.affixOne() == poolSecond.affixOne() &&
        poolFirst.affixTwo() == poolSecond.affixTwo(),
        "content affix pools must select deterministic non-contiguous ids")
    var inventory = BoundedItemInventory(3, 2)
    assert(inventory.addLootedItem(first, 1) &&
        inventory.itemId(0) == 500 &&
        !inventory.addLootedItem(BoundedItemRoll(), 1),
        "accepted loot rolls must enter inventory with stable identity")
    var sections = BoundedSaveSections(8, 16)
    var codec = BoundedSaveSchemaWireCodec(8, 16)
    assert(sections.setRevision(23) &&
        inventory.encodeInto(sections) &&
        codec.encode(sections) &&
        codec.encodedLength() == 25)
    var wire = new Int[25]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var decoded = BoundedSaveSections(8, 16)
    var restored = BoundedItemInventory(3, 2)
    assert(codec.decode(wire, decoded) &&
        restored.decodeFrom(decoded) &&
        restored.itemRoll(0).definitionId() == first.definitionId() &&
        restored.itemRoll(0).seed() == first.seed() &&
        restored.itemRoll(0).affixOne() == first.affixOne() &&
        restored.itemRoll(0).condition() == first.condition(),
        "rolled item fields must survive schema persistence")
    wire[21] = 0
    assert(codec.decode(wire, decoded) && !restored.decodeFrom(decoded),
        "typed inventory load must reject malformed rolled item fields")
}

test "equipment loadout transactions and persistence" {
    var inventory = BoundedItemInventory(3, 3)
    var loadout = BoundedEquipmentLoadout(4)
    assert(inventory.addItem(500, 1) &&
        inventory.addItem(501, 1) &&
        loadout.equip(inventory, 0, 500) &&
        loadout.equip(inventory, 1, 501) &&
        !loadout.equip(inventory, 2, 500) &&
        !loadout.equip(inventory, 2, 999) &&
        loadout.itemAt(0) == 500 &&
        loadout.itemAt(1) == 501 &&
        loadout.unequip(1) &&
        loadout.equip(inventory, 2, 501),
        "equipment must validate ownership and unique slot assignment")
    var sections = BoundedSaveSections(8, 16)
    var codec = BoundedSaveSchemaWireCodec(8, 16)
    assert(sections.setRevision(24) &&
        inventory.encodeInto(sections) &&
        loadout.encodeInto(sections) &&
        codec.encode(sections) &&
        codec.encodedLength() == 27)
    var wire = new Int[27]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var decoded = BoundedSaveSections(8, 16)
    var restoredInventory = BoundedItemInventory(3, 3)
    var restoredLoadout = BoundedEquipmentLoadout(4)
    assert(codec.decode(wire, decoded) &&
        restoredInventory.decodeFrom(decoded) &&
        restoredLoadout.decodeFrom(decoded, restoredInventory) &&
        restoredLoadout.itemAt(0) == 500 &&
        restoredLoadout.itemAt(2) == 501 &&
        restoredLoadout.itemAt(1) == 0,
        "equipment ownership must survive schema persistence")
    var malformed = BoundedSaveSections(8, 16)
    var malformedLoadout = BoundedEquipmentLoadout(4)
    var malformedPayload = new Int[4]
    malformedPayload[0] = 0
    malformedPayload[1] = 500
    malformedPayload[2] = 1
    malformedPayload[3] = 500
    assert(malformed.setRevision(24) &&
        malformed.put(8, 1, malformedPayload) &&
        !malformedLoadout.decodeFrom(malformed, restoredInventory),
        "equipment load must reject duplicate item ownership")
    var legacy = BoundedSaveSections(8, 16)
    var legacyLoadout = BoundedEquipmentLoadout(4)
    assert(legacy.setRevision(24) &&
        legacyLoadout.equip(restoredInventory, 0, 500) &&
        legacyLoadout.decodeFrom(legacy, restoredInventory) &&
        legacyLoadout.itemAt(0) == 0,
        "older saves without equipment must load empty")

}

test "item stat composition and crafting persistence" {
    var definitions = BoundedItemDefinitionStore(2)
    var affixes = BoundedAffixStatStore(4)
    assert(definitions.define(100, 100, 1, 10, 2) &&
        affixes.define(1, 10, 20, 10) &&
        affixes.define(2, 5, 0, 20),
        "stat definitions must accept bounded affix profiles")
    var roll = BoundedItemRoll()
    assert(roll.stage(900, 100, 5, 1, 1, 1, 2, 80))
    var stats = BoundedItemStatResult()
    var composer = BoundedItemStatComposer()
    assert(composer.compose(roll, definitions, affixes, stats) &&
        stats.base() == 100 &&
        stats.flat() == 115 &&
        stats.additive() == 138 &&
        stats.finalAmount() == 179,
        "item stats must compose base, flat, additive and multiplicative values")
    var inventory = BoundedItemInventory(7, 4)
    var recipe = BoundedCraftRecipe(2)
    var crafting = BoundedCraftingSystem()
    assert(inventory.addItem(700, 2) &&
        inventory.addItem(701, 1) &&
        inventory.setCurrency(100) &&
        recipe.addIngredient(700, 2) &&
        recipe.addIngredient(701, 1) &&
        recipe.setCurrencyCost(25) &&
        recipe.setOutput(roll) &&
        crafting.validate(inventory, recipe) &&
        crafting.craft(inventory, recipe) &&
        inventory.itemCount() == 1 &&
        inventory.itemId(0) == 900 &&
        inventory.itemQuantity(0) == 1 &&
        inventory.currency() == 75,
        "crafting must atomically consume ingredients and currency")
    var sections = BoundedSaveSections(8, 16)
    var codec = BoundedSaveSchemaWireCodec(8, 16)
    assert(sections.setRevision(25) &&
        inventory.encodeInto(sections) &&
        codec.encode(sections) &&
        codec.encodedLength() == 25)
    var wire = new Int[25]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var decoded = BoundedSaveSections(8, 16)
    var restored = BoundedItemInventory(7, 4)
    assert(codec.decode(wire, decoded) &&
        restored.decodeFrom(decoded) &&
        restored.itemId(0) == 900 &&
        restored.itemRoll(0).affixOne() == 1 &&
        restored.currency() == 75,
        "crafted item ownership and roll fields must persist")
    var rejected = BoundedCraftRecipe(1)
    assert(rejected.addIngredient(900, 2) &&
        rejected.setCurrencyCost(1000) &&
        rejected.setOutput(roll) &&
        !crafting.craft(restored, rejected) &&
        restored.itemCount() == 1 &&
        restored.itemQuantity(0) == 1 &&
        restored.currency() == 75,
        "invalid crafting must leave inventory unchanged")
}

test "reservations skills and status persistence" {
    var inventory = BoundedItemInventory(8, 4)
    var reservation = BoundedItemReservation(2)
    assert(inventory.addItem(1000, 3) &&
        inventory.addItem(1001, 1) &&
        inventory.setCurrency(50) &&
        reservation.addItem(1000, 2) &&
        reservation.addItem(1001, 1) &&
        reservation.setCurrencyCost(20) &&
        reservation.reserve(inventory) &&
        inventory.depositCurrency(1) &&
        !reservation.commit(inventory) &&
        reservation.cancel(),
        "reservations must reject stale inventory revisions")
    var committed = BoundedItemReservation(2)
    assert(committed.addItem(1000, 2) &&
        committed.addItem(1001, 1) &&
        committed.setCurrencyCost(20) &&
        committed.reserve(inventory) &&
        committed.commit(inventory) &&
        inventory.itemQuantity(0) == 1 &&
        inventory.itemCount() == 1 &&
        inventory.currency() == 31,
        "reservations must commit multiple item and currency operations")
    var skillDefinitions = BoundedSkillDefinitionStore(2)
    var skills = BoundedSkillProgression(2)
    assert(skillDefinitions.define(10, 3, 100) &&
        skills.learn(10, skillDefinitions) &&
        skills.gainExperience(10, 250, skillDefinitions) &&
        skills.rank(10) == 2 &&
        skills.experience(10) == 50,
        "skills must advance bounded ranks and retain remainder experience")
    var statusDefinitions = BoundedStatusDefinitionStore(2)
    var statuses = BoundedStatusEffects(2)
    assert(statusDefinitions.define(20, 100, 3) &&
        statuses.apply(20, 50, 2, statusDefinitions) &&
        statuses.apply(20, 80, 2, statusDefinitions) &&
        statuses.duration(20) == 80 &&
        statuses.stacks(20) == 3 &&
        statuses.tick(30) &&
        statuses.duration(20) == 50,
        "statuses must refresh duration, add capped stacks and tick")
    var sections = BoundedSaveSections(12, 16)
    var codec = BoundedSaveSchemaWireCodec(12, 16)
    assert(sections.setRevision(31) &&
        skills.encodeInto(sections) &&
        statuses.encodeInto(sections) &&
        codec.encode(sections) &&
        codec.encodedLength() == 16)
    var wire = new Int[16]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var decoded = BoundedSaveSections(12, 16)
    var restoredSkills = BoundedSkillProgression(2)
    var restoredStatuses = BoundedStatusEffects(2)
    assert(codec.decode(wire, decoded) &&
        restoredSkills.decodeFrom(decoded, skillDefinitions) &&
        restoredStatuses.decodeFrom(decoded, statusDefinitions) &&
        restoredSkills.rank(10) == 2 &&
        restoredSkills.experience(10) == 50 &&
        restoredStatuses.duration(20) == 50 &&
        restoredStatuses.stacks(20) == 3,
        "skill and status state must survive versioned persistence")
}

test "loopback progression authority and persistence" {
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1 &&
        loopback.definePlayerSkill(30, 2, 100) &&
        loopback.learnPlayerSkill(1, 30) &&
        loopback.gainPlayerSkillExperience(1, 30, 125) &&
        loopback.playerSkillRank(1, 30) == 1 &&
        loopback.playerSkillExperience(1, 30) == 25 &&
        loopback.definePlayerStatus(40, 10, 3) &&
        loopback.applyPlayerStatus(1, 40, 5, 2) &&
        loopback.playerStatusDuration(1, 40) == 5 &&
        loopback.advance(16667) == 1 &&
        loopback.playerStatusDuration(1, 40) == 4,
        "loopback must authoritatively advance player progression state")
    var sections = BoundedSaveSections(12, 16)
    var codec = BoundedSaveSchemaWireCodec(12, 16)
    assert(sections.setRevision(40) &&
        loopback.encodePlayerProgression(1, sections) &&
        codec.encode(sections) &&
        codec.encodedLength() == 16)
    var wire = new Int[16]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var decoded = BoundedSaveSections(12, 16)
    var restored = LoopbackSession(4, 2)
    assert(restored.start() && restored.connectPlayer() == 1 &&
        restored.definePlayerSkill(30, 2, 100) &&
        restored.definePlayerStatus(40, 10, 3) &&
        codec.decode(wire, decoded) &&
        restored.decodePlayerProgression(1, decoded) &&
        restored.playerSkillRank(1, 30) == 1 &&
        restored.playerSkillExperience(1, 30) == 25 &&
        restored.playerStatusDuration(1, 40) == 4 &&
        restored.playerStatusStacks(1, 40) == 2,
        "loopback progression state must round-trip through save sections")
}

test "progression modifiers affect authoritative combat" {
    var loopback = LoopbackSession(4, 4)
    assert(loopback.start() && loopback.connectPlayer() == 1 &&
        loopback.connectPlayer() == 2 &&
        loopback.definePlayerSkill(50, 2, 100) &&
        loopback.definePlayerSkill(51, 1, 100) &&
        loopback.setPlayerSkillPrerequisite(51, 50) &&
        !loopback.learnPlayerSkill(1, 51) &&
        loopback.setPlayerSkillDamagePercent(50, 50) &&
        loopback.learnPlayerSkill(1, 50) &&
        loopback.gainPlayerSkillExperience(1, 50, 100) &&
        loopback.learnPlayerSkill(1, 51) &&
        loopback.setPlayerSkillActivation(50, 30, 3) &&
        loopback.setPlayerSkillResource(1, 50),
        "skill prerequisites and activation metadata must be enforced")
    var activation = loopback.activatePlayerSkill(1, 50, 0)
    assert(activation.accepted() && activation.resourceCost() == 30 &&
        activation.cooldownUntil() == 3 &&
        loopback.playerSkillResource(1) == 20 &&
        loopback.playerSkillCooldown(1, 50, 1) == 2,
        "skill activation must consume bounded resource and set cooldown")
    var blockedActivation = loopback.activatePlayerSkill(1, 50, 1)
    assert(!blockedActivation.accepted() &&
        loopback.playerSkillResource(1) == 20,
        "skill activation must reject cooldown reuse")
    assert(loopback.setPlayerSkillResource(1, 50))
    var readyActivation = loopback.activatePlayerSkill(1, 50, 3)
    assert(readyActivation.accepted() && loopback.playerSkillResource(1) == 20,
        "skill activation must become available at cooldown expiry")
    assert(loopback.definePlayerStatus(60, 5, 3) &&
        loopback.setPlayerStatusDamageModifier(60, 2, 25) &&
        loopback.applyPlayerStatus(1, 60, 5, 1) &&
        loopback.definePlayerWeapon(9, 3, 0, 0, 10, 1, 20) &&
        loopback.addPlayerCombatActor(1, 100, 0) &&
        loopback.addPlayerCombatActor(2, 100, 0) &&
        loopback.equipPlayerCombatWeapon(1, 9),
        "player progression modifiers must configure before combat")
    var enhanced = loopback.resolvePlayerHitscan(1, 2, 0, 1, 0)
    assert(enhanced.accepted() && enhanced.applied() == 21 &&
        loopback.playerCombatHealth(2) == 79,
        "skill and status modifiers must increase player damage")
    assert(loopback.definePlayerStatus(61, 2, 1) &&
        loopback.setPlayerStatusDefenseModifier(61, 3, 50) &&
        loopback.applyPlayerStatus(2, 61, 2, 1))
    var defended = loopback.resolvePlayerHitscan(1, 2, 1, 1, 0)
    assert(defended.accepted() && defended.applied() == 9 &&
        loopback.playerCombatHealth(2) == 70,
        "defensive status modifiers must reduce incoming damage")
    assert(loopback.advance(4 * 16667) == 4 &&
        loopback.playerStatusDuration(1, 60) == 1 &&
        loopback.advance(16667) == 1 &&
        loopback.playerStatusDuration(1, 60) == -1)
    var expired = loopback.resolvePlayerHitscan(1, 2, 5, 1, 0)
    assert(expired.accepted() && expired.applied() == 15 &&
        loopback.playerCombatHealth(2) == 55,
        "expired status modifiers must stop affecting player damage")
    assert(loopback.definePlayerWeapon(10, 3, 0, 0, 10, 1, 20),
        "loopback must define a second combat weapon")
    assert(loopback.equipPlayerCombatWeapon(1, 10),
        "loopback must equip the second combat weapon")
    assert(loopback.setPlayerCombatShield(2, 8, 8),
        "loopback must set player shield state")
    assert(loopback.setPlayerCombatResistance(2, 1, 50),
        "loopback must set player resistance state")
    var playerShielded = loopback.resolvePlayerHitscan(1, 2, 6, 1, 0)
    assert(playerShielded.accepted() && playerShielded.applied() == 8 &&
        loopback.playerCombatHealth(2) == 55 &&
        loopback.playerCombatShield(2) == 0,
        "loopback player combat must expose resistance and shield authority")
    assert(loopback.defineEnemyWeapon(19, 2, 0, 0, 10, 1, 20) &&
        loopback.addEnemyCombatActor(10, 100, 0) &&
        loopback.addEnemyCombatActor(11, 100, 0) &&
        loopback.equipEnemyCombatWeapon(10, 19) &&
        loopback.setEnemyCombatDamageModifier(10, 1, 100) &&
        loopback.setEnemyCombatShield(11, 3, 3) &&
        loopback.setEnemyCombatResistance(11, 1, 50))
    var enemyHit = loopback.resolveEnemyHitscan(10, 11, 0, 1, 0)
    assert(enemyHit.accepted() && enemyHit.applied() == 11 &&
        loopback.enemyCombatShield(11) == 0,
        "enemy combat must honor resistance and shield modifiers")
}
test "periodic statuses damage players on fixed ticks" {
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1 &&
        loopback.connectPlayer() == 2 &&
        loopback.definePlayerStatus(70, 3, 2) &&
        loopback.setPlayerStatusPeriodicDamage(70, 3, 1) &&
        loopback.applyPlayerStatus(2, 70, 3, 2) &&
        loopback.addPlayerCombatActor(1, 50, 0) &&
        loopback.addPlayerCombatActor(2, 20, 0),
        "periodic status damage must configure through authority")
    assert(loopback.advance(16667) == 1 &&
        loopback.playerCombatHealth(2) == 14 &&
        loopback.playerStatusDuration(2, 70) == 2,
        "periodic status damage must tick once per fixed step")
    assert(loopback.advance(2 * 16667) == 2 &&
        loopback.playerCombatHealth(2) == 2 &&
        loopback.playerStatusDuration(2, 70) == -1,
        "periodic status damage must stop when the status expires")
}

test "area damage resolves bounded target batches" {
    var combat = CombatWorld(4, 1)
    var targets = new Int[2]
    targets[0] = 2
    targets[1] = 3
    assert(combat.addActor(1, 50, 0) &&
        combat.addActor(2, 30, 0) &&
        combat.addActor(3, 30, 0) &&
        combat.setResistance(3, 1, 50))
    var area = combat.resolveAreaDamage(1, targets, 10, 1, 0)
    assert(area.accepted() && area.targetCount() == 2 &&
        area.applied() == 15 && area.deaths() == 0 &&
        combat.currentHealth(2) == 20 && combat.currentHealth(3) == 25 &&
        combat.pendingCombatEvents() == 2,
        "area damage must reuse bounded resistance and damage resolution")
    assert(combat.dequeueCombatEvent() &&
        combat.lastCombatEvent().kind() == 3 &&
        combat.dequeueCombatEvent() &&
        combat.lastCombatEvent().targetId() == 3,
        "area damage must publish ordered combat events")
    var duplicateTargets = new Int[2]
    duplicateTargets[0] = 2
    duplicateTargets[1] = 2
    var rejected = combat.resolveAreaDamage(1, duplicateTargets, 10, 1, 0)
    assert(!rejected.accepted() && combat.currentHealth(2) == 20,
        "area damage must reject duplicate targets without mutation")
}
test "bounded shotgun pellets share damage authority" {
    var combat = CombatWorld(2, 1)
    assert(combat.defineWeapon(12, 2, 0, 0, 100, 1, 30) &&
        combat.setWeaponSpread(12, 3, 20) &&
        combat.addActor(1, 1000, 0) &&
        combat.addActor(2, 1000, 0) &&
        combat.equipWeapon(1, 12) &&
        !combat.setWeaponSpread(12, 9, 10))
    var blast = combat.resolveShotgun(1, 2, 0, 30, 0)
    assert(blast.accepted() && blast.applied() == 281 &&
        blast.remainingHealth() == 719 &&
        combat.magazine(1) == 1 && combat.pendingCombatEvents() == 3,
        "shotgun must consume one shell and publish bounded pellet hits")
    assert(combat.dequeueCombatEvent() &&
        combat.lastCombatEvent().kind() == 4 &&
        combat.dequeueCombatEvent() &&
        combat.dequeueCombatEvent() &&
        combat.pendingCombatEvents() == 0,
        "shotgun pellet events must preserve deterministic order")
}
test "shotgun pellets target bounded spread list" {
    var combat = CombatWorld(3, 1)
    assert(combat.defineWeapon(13, 2, 0, 0, 100, 1, 30) &&
        combat.setWeaponSpread(13, 3, 0) &&
        combat.addActor(1, 1000, 0) &&
        combat.addActor(2, 1000, 0) &&
        combat.addActor(3, 1000, 0) &&
        combat.equipWeapon(1, 13))
    var targets = new Int[2]
    targets[0] = 2
    targets[1] = 3
    var result = combat.resolveShotgunTargets(1, targets, 0, 30, 0)
    assert(result.accepted() && result.targetCount() == 3 &&
        result.applied() == 300 && result.deaths() == 0 &&
        combat.currentHealth(2) == 800 &&
        combat.currentHealth(3) == 900 &&
        combat.magazine(1) == 1,
        "shotgun target lists must distribute pellets deterministically")
}




test "focus loss clears held input and queued fire" {
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1)
    assert(loopback.definePlayerWeapon(9, 3, 0, 1, 4, 1, 20) &&
        loopback.addPlayerCombatActor(1, 20, 0) &&
        loopback.equipPlayerCombatWeapon(1, 9))
    assert(loopback.receiveInput(1, 1, 1, 0, 0, 0, 0, 1, 0) &&
        loopback.advance(16667) == 1 &&
        loopback.playerWeaponPresentationCount() == 1)
    assert(loopback.dequeuePlayerWeaponPresentation())
    assert(loopback.lastInputEdges(1).firePressed() == 1)
    assert(loopback.receiveInput(1, 2, 2, 0, 0, 0, 0, 1, 0))
    assert(loopback.applyPlayerFocus(1, 0) &&
        !loopback.playerFocused(1) &&
        loopback.lastInputEdges(1).fireReleased() == 1 &&
        loopback.lastInputEdges(1).firePressed() == 0,
        "focus loss must release held buttons")
    assert(loopback.advance(16667) == 1 &&
        loopback.playerWeaponPresentationCount() == 0 &&
        !loopback.receiveInput(1, 3, 3, 0, 0, 0, 0, 1, 0),
        "focus loss must discard queued and new firing input")
    assert(loopback.applyPlayerFocus(1, 1) &&
        loopback.playerFocused(1) &&
        loopback.receiveInput(1, 3, 4, 0, 0, 0, 0, 1, 0) &&
        loopback.advance(16667) == 1 &&
        loopback.playerWeaponPresentationCount() == 1,
        "focus regain must rearm input acceptance")
}

test "pause reset discards debt and one-shot input" {
    var clock = FixedStepClock(60, 4)
    assert(clock.advance(1000) == 0 &&
        clock.pendingMicros() == 1000 &&
        clock.resetDebt() &&
        clock.pendingMicros() == 0)
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1)
    assert(loopback.definePlayerWeapon(9, 2, 0, 1, 4, 1, 20) &&
        loopback.addPlayerCombatActor(1, 20, 0) &&
        loopback.equipPlayerCombatWeapon(1, 9))
    assert(loopback.receiveInput(1, 1, 1, 0, 0, 0, 0, 1, 0) &&
        loopback.setPaused(1) &&
        loopback.isPaused() &&
        !loopback.setPaused(2) &&
        !loopback.receiveInput(1, 1, 2, 0, 0, 0, 0, 1, 0) &&
        loopback.advance(100000) == 0 &&
        loopback.playerWeaponPresentationCount() == 0,
        "pause must disarm pending input and discard wall-clock debt")
    assert(loopback.setPaused(0) &&
        !loopback.isPaused() &&
        loopback.receiveInput(1, 1, 3, 0, 0, 0, 0, 1, 0) &&
        loopback.advance(16667) == 1 &&
        loopback.playerWeaponPresentationCount() == 1,
        "unpause must resume clean fixed-step input")
}

test "bounded input replay records tick commands" {
    var replay = InputReplayRecorder(2)
    var first = InputCommand(4, 1, 3, 0, 2, -1, 1, 0)
    var second = InputCommand(5, 2, 0, 1, -2, 3, 0, 1)
    assert(replay.append(first) && replay.append(second) &&
        replay.pending() == 2 &&
        replay.lastRecordedTick() == 5 &&
        replay.lastRecordedSequence() == 2,
        "replay must retain ordered resulting tick commands")
    assert(!replay.append(InputCommand(3, 3, 0, 0, 0, 0, 0, 0)) &&
        !replay.append(InputCommand(6, 2, 0, 0, 0, 0, 0, 0)) &&
        !replay.append(InputCommand(6, 3, 0, 0, 0, 0, 2, 0)),
        "replay must reject stale, duplicate and invalid commands")
    assert(replay.playNext() &&
        replay.lastPlayed().tick() == 4 &&
        replay.lastPlayed().sequence() == 1 &&
        replay.lastPlayed().moveX() == 3 &&
        replay.pending() == 1 &&
        replay.playNext() &&
        replay.lastPlayed().tick() == 5 &&
        replay.lastPlayed().jump() == 1 &&
        replay.pending() == 0 &&
        !replay.playNext(),
        "replay playback must preserve FIFO command values")
    assert(replay.reset() && replay.pending() == 0 &&
        replay.lastRecordedSequence() == -1 &&
        replay.append(InputCommand(0, 0, 0, 0, 0, 0, 0, 0)),
        "replay reset must rearm deterministic recording")
}

test "loopback replay capture records consumed commands" {
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1 &&
        loopback.setInputReplayEnabled(true) &&
        loopback.inputReplayEnabledValue())
    assert(loopback.receiveInput(1, 1, 1, 3, 0, 2, -1, 0, 0) &&
        loopback.receiveInput(1, 2, 2, -2, 0, 0, 4, 0, 1) &&
        loopback.advance(16667) == 1 &&
        loopback.advance(16667) == 1 &&
        loopback.pendingPlayerReplay(1) == 2,
        "loopback must capture commands when replay is enabled")
    assert(loopback.playPlayerReplay(1) &&
        loopback.lastPlayerReplay(1).tick() == 1 &&
        loopback.lastPlayerReplay(1).moveX() == 3 &&
        loopback.playPlayerReplay(1) &&
        loopback.lastPlayerReplay(1).tick() == 2 &&
        loopback.lastPlayerReplay(1).jump() == 1 &&
        loopback.pendingPlayerReplay(1) == 0,
        "loopback replay must preserve consumed command order")
    assert(loopback.setInputReplayEnabled(false) &&
        !loopback.inputReplayEnabledValue() &&
        loopback.pendingPlayerReplay(1) == 0,
        "disabling replay must reset bounded capture state")
}

