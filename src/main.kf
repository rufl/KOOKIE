    glb[474] = 0
    glb[475] = 0
    var reader = BoundedExternalGlbSceneReader(4, 2)
    var admitted = reader.read(
        glb, ExternalGlbReadRequest(10, 77, 4, 9, 3, 100))
    assert(admitted && reader.valid() &&
        reader.vertexCount() == 3 && reader.triangleCount() == 1 &&
        reader.geometryChecksum() > 0,
        "external GLB JSON and BIN chunks must admit standard indexed geometry")
    var receipt = reader.provenance()
    assert(receipt.sourceNamespaceId() == 10 && receipt.sourceAssetId() == 77 &&
        receipt.sourceRevision() == 4 && receipt.toolVersion() == 9 &&
        receipt.optionsChecksum() == 3 && receipt.geometryChecksum() == reader.geometryChecksum(),
        "external GLB admission must emit deterministic provenance")
    assert(reader.reopenCanonical(),
        "external GLB canonical geometry must reopen through the runtime reader")
    var collision = BoundedAuthoredCollision(4, 2)
    assert(reader.emitCollision(collision) && collision.validate() &&
        collision.encode() && collision.sourceAssetId() == 77,
        "external GLB geometry must emit an identity-preserving collision product")
    var cookedPackage = BoundedContentPackage(1, 1, 1)
    assert(cookedPackage.configureHeader(7, 9, 11, 1, 100) &&
        cookedPackage.addAsset(10, 77, 3, 4, 111, 222, 15) &&
        cookedPackage.addChunk(
            99, 6, 0, collision.encodedLength(),
            collision.checksum(), collision.triangleCount(), 4) &&
        cookedPackage.seal(),
        "external GLB output must fit the bounded package contract")
    var kooker = BoundedGlbKooker(4, 2, 2)
    var cookCache = BoundedGenerationCache(2)
    var cookAccepted = kooker.cook(cookedPackage, reader, 99, 6, cookCache)
    var cookResult = kooker.result()
    assert(cookAccepted && kooker.accepted() &&
        cookResult.packageChecksum() == cookedPackage.checksum() &&
        cookResult.geometryChecksum() == reader.geometryChecksum() &&
        cookResult.sceneChecksum() == reader.sceneChecksum() &&
        cookResult.skeletonChecksum() == 0 &&
        cookResult.collisionChecksum() == collision.checksum() &&
        cookResult.navigationChecksum() > 0 &&
        cookResult.generation() == 1 &&
        cookResult.sceneNodeCount() == 1 &&
        cookResult.skinCount() == 0 &&
        cookResult.navigationNodeCount() == 1 &&
        cookCache.activeGeneration() == 1 &&
        kooker.sceneProduct().checksum() == reader.sceneChecksum() &&
        kooker.transformHierarchy().sourceSceneChecksum() ==
            reader.sceneChecksum() &&
        kooker.navigationProduct().findRoute(1, 1).found(),
        "GLB kooker must atomically publish scene geometry collision navigation and replication")

    var skinnedGlb = g4SkinnedSceneGlbFixture()
    var skinnedReader = BoundedExternalGlbSceneReader(4, 2)
    assert(skinnedReader.read(
            skinnedGlb, ExternalGlbReadRequest(10, 79, 5, 9, 3, 100)) &&
        skinnedReader.valid() && skinnedReader.validSkinAttributes() &&
        skinnedReader.sceneNodeCount() == 4 &&
        skinnedReader.skinCount() == 1 &&
        skinnedReader.skinJointCount(0) == 2 &&
        skinnedReader.skinJointNodeId(0, 0) == 3 &&
        skinnedReader.skinJointNodeId(0, 1) == 4 &&
        skinnedReader.skinSkeletonNodeId(0) == 3 &&
        skinnedReader.skinInverseBindAccessor(0) == 4 &&
        skinnedReader.skeletonChecksum() > 0 &&
        skinnedReader.reopenSceneCanonical() &&
        skinnedReader.reopenSkeletonCanonical(),
        "GLB intake must preserve active nodes hierarchy and skin metadata")
    var skinnedScene = skinnedReader.sceneProduct()
    assert(skinnedScene.validate() && skinnedScene.nodeId(1) == 2 &&
        skinnedScene.parentId(1) == 1 &&
        skinnedScene.resourceId(1) == 1 &&
        skinnedScene.skinId(1) == 1,
        "skinned mesh node must bind canonical mesh and skin identities")
    var skinnedSkeleton = skinnedReader.skeletonProduct()
    assert(skinnedSkeleton.validate() &&
        skinnedSkeleton.skinCount() == 1 &&
        skinnedSkeleton.jointCount() == 2 &&
        skinnedSkeleton.skeletonNodeId(1) == 3 &&
        skinnedSkeleton.jointNodeId(1, 0) == 3 &&
        skinnedSkeleton.jointNodeId(1, 1) == 4 &&
        skinnedSkeleton.jointParentId(1, 1) == 1,
        "GLB skins must cook into canonical Kof skeleton topology")
    var skinnedHierarchy = BoundedTransformHierarchy(4)
    assert(skinnedHierarchy.load(skinnedScene) &&
        skinnedHierarchy.worldMatrixElement(4, 3) == 100 &&
        skinnedHierarchy.worldMatrixElement(4, 7) == 300 &&
        skinnedHierarchy.worldMatrixElement(4, 11) == 300,
        "cooked GLB TRS must compose through the Kof transform hierarchy")
    var skinnedPalette = BoundedSkeletonRuntime(4)
    assert(skinnedPalette.load(skinnedSkeleton, skinnedHierarchy, 1) &&
        skinnedPalette.paletteElement(0, 3) == 100 &&
        skinnedPalette.paletteElement(0, 7) == 200 &&
        skinnedPalette.paletteElement(1, 3) == 100 &&
        skinnedPalette.paletteElement(1, 7) == 300 &&
        skinnedPalette.paletteElement(1, 11) == 300,
        "GLB inverse bind matrices must produce deterministic skin palettes")
    var skinnedCollision = BoundedAuthoredCollision(4, 2)
    assert(skinnedReader.emitCollision(skinnedCollision) &&
        skinnedCollision.validate() && skinnedCollision.encode())
    var skinnedPackage = BoundedContentPackage(1, 1, 1)
    assert(skinnedPackage.configureHeader(7, 9, 12, 1, 100) &&
        skinnedPackage.addAsset(10, 79, 3, 5, 333, 444, 15) &&
        skinnedPackage.addChunk(
            100, 6, 0, skinnedCollision.encodedLength(),
            skinnedCollision.checksum(), skinnedCollision.triangleCount(), 5) &&
        skinnedPackage.seal())
    var skinnedKooker = BoundedGlbKooker(4, 2, 2)
    var skinnedCache = BoundedGenerationCache(2)
    assert(skinnedKooker.cook(
            skinnedPackage, skinnedReader, 100, 6, skinnedCache) &&
        skinnedKooker.result().sceneChecksum() ==
            skinnedReader.sceneChecksum() &&
        skinnedKooker.result().skeletonChecksum() ==
            skinnedReader.skeletonChecksum() &&
        skinnedKooker.result().sceneNodeCount() == 4 &&
        skinnedKooker.result().skinCount() == 1 &&
        skinnedKooker.sceneProduct().skinId(1) == 1 &&
        skinnedKooker.skeletonProduct().checksum() ==
            skinnedReader.skeletonChecksum() &&
        skinnedKooker.skeletonRuntime().paletteElement(1, 7) == 300 &&
        skinnedKooker.transformHierarchy().worldMatrixElement(4, 7) == 300,
        "GLB kooker must retain canonical scene and skin products")

    var texturedGlb = g4TexturedGlbFixture()
    var ds3 = g4DustArchiveFixture()
    var dust = BoundedDust3dIntake(4, 2)
    assert(dust.read(ds3, texturedGlb, 10, 78, 4, 9, 3, 100) &&
        dust.accepted() && dust.vertexCount() == 3 &&
        dust.triangleCount() == 1 && dust.collisionChecksum() > 0,
        "Dust3D intake must preserve its source and validate the exported textured GLB")
    var invalidUv = g4TexturedGlbFixture()
    var changedUv = false
    for (var index = 0; index + 3 < invalidUv.length; index = index + 1) {
        if (!changedUv && invalidUv[index] == 86 &&
            invalidUv[index + 1] == 69 && invalidUv[index + 2] == 67 &&
            invalidUv[index + 3] == 50) {
            invalidUv[index + 3] = 51
            changedUv = true
        }
    }
    assert(changedUv &&
        !dust.read(ds3, invalidUv, 10, 78, 4, 9, 3, 100) &&
        dust.diagnostic() == dust3dDiagnosticUv(),
        "Dust3D intake must reject a TEXCOORD accessor without VEC2 UV data")

    glb[8] = glb[8] - 1
    assert(!reader.read(
            glb, ExternalGlbReadRequest(10, 77, 4, 9, 3, 100)),
        "external GLB intake must reject a malformed total-length header")
}

test "runtime generation contact projectile and session navigation" {
    var publication = BoundedProductPublication()
    var cache = BoundedGenerationCache(2)
    assert(publication.stageGeometry(4, 101) &&
        publication.stageCollision(4, 202) &&
        publication.stageNavigation(4, 303) &&
        publication.stageReplication(4, 404) &&
        publication.publishTo(cache) && cache.activeGeneration() == 1 &&
        cache.isResident(1),
        "runtime publication must admit one complete product generation")
    assert(cache.retainGeneration(1) &&
        publication.stageGeometry(5, 501) &&
        publication.stageCollision(5, 502) &&
        publication.stageNavigation(5, 503) &&
        publication.stageReplication(5, 504) &&
        publication.publishTo(cache) && cache.activeGeneration() == 2 &&
        cache.isResident(1) && cache.isResident(2),
        "runtime publication must retain referenced generations across replacement")
    assert(cache.releaseGeneration(1) && cache.retireInactive() == 1 &&
        !cache.isResident(1) && cache.count() == 1,
        "frame boundary retirement must remove unreferenced inactive generations")

    var wall = BoundedTriangleCollection(2, 20)
    assert(wall.configureBounds(-10, -10, -10, 20, 20, 20) &&
        wall.addTriangle(5, 0, 0, 5, 5, 0, 5, 0, 5),
        "triangle contact geometry must admit a convex wall face")
    var contact = BoundedTriangleContactController(wall, 1, 20, 60, 0)
    var wallHit = contact.move(0, 2, 2, 10, 2, 2)
    assert(wallHit.accepted() && wallHit.collided() &&
        !wallHit.slopeAccepted() && wallHit.resolvedX() == 3,
        "triangle contact must sweep capsule offsets and reject wall slopes")

    var floor = BoundedTriangleCollection(2, 20)
    assert(floor.configureBounds(-10, -10, -10, 20, 20, 20) &&
        floor.addTriangle(0, 0, 0, 10, 0, 0, 0, 0, 10),
        "ground contact geometry must admit a walkable floor")
    var grounded = BoundedTriangleContactController(floor, 1, 20, 60, 0)
    var groundHit = grounded.move(2, 2, 2, 4, 2, 2)
    assert(groundHit.accepted() && groundHit.grounded() &&
        groundHit.slopeAccepted(),
        "triangle contact must expose grounded walkable-slope state")

    var dynamic = BoundedDynamicBroadPhase(2, 20)
    assert(dynamic.add(7, 6, 0, 0, 7, 10, 10))
    var capsuleHit = dynamic.queryCapsule(0, 5, 5, 10, 5, 5, 1, 99)
    assert(capsuleHit.accepted() && capsuleHit.collided() &&
        capsuleHit.actorId() == 7,
        "dynamic narrow phase must expand actor boxes by capsule radius")

    var projectileGeometry = BoundedTriangleCollection(2, 20)
    assert(projectileGeometry.configureBounds(-10, -10, -10, 20, 20, 20))
    var projectileDynamics = BoundedDynamicBroadPhase(2, 20)
    assert(projectileDynamics.add(8, 6, 0, 0, 7, 10, 10))
    var projectiles = BoundedProjectileSweepWorld(
        2, projectileGeometry, projectileDynamics)
    assert(projectiles.launch(1, 2, 0, 5, 5, 20))
    var projectileHit = projectiles.advance(1, 10, 0, 0, 1, 2)
    assert(projectileHit.accepted() && projectileHit.hitDynamic() &&
        projectileHit.actorId() == 8 && !projectiles.activeProjectile(1),
        "projectile sweeps must use dynamic narrow-phase contacts")

    var nav = BoundedNavigationProduct(3)
    assert(nav.configure(1, 300, 4) &&
        nav.addNode(10, 0, 0, 0) && nav.addNode(20, 1, 0, 0) &&
        nav.addNode(30, 2, 0, 0) && nav.addEdge(10, 20) &&
        nav.addEdge(20, 30) && nav.seal() && nav.validate())
    var enemySession = AuthoritativeEnemySession(2, 1)
    var productRoute = enemySession.navigationProductRoute(10, 30)
    assert(enemySession.loadNavigationProduct(nav) &&
        enemySession.navigationProductRoute(10, 30).found() &&
        productRoute.accepted() == false,
        "session navigation must admit and route only through published products")
}

test "capsule slide and step result" {
    var capsule = BoundedCapsuleWorld(0, 0, 0, 10, 10, 10, 1, 20)
    var slide = capsule.moveCapsule(2, 2, 2, 12, 2, 2, 1)
    assert(slide.accepted() && slide.collided() && !slide.stepped(),
        "capsule boundary movement must produce a slide")
    assert(slide.resolvedX() == 9 && slide.slideX() == 7,
        "capsule slide must stop at the radius-expanded boundary")

    var clear = capsule.moveCapsule(2, 2, 2, 4, 2, 2, 1)
    assert(clear.accepted() && !clear.collided() && !clear.stepped() &&
        clear.resolvedX() == 4,
        "clear capsule movement must preserve its endpoint")
    assert(capsule.configureStepObstacle(4, 6, 0, 10, 2),
        "bounded step obstacle must configure")
    var stepped = capsule.moveCapsule(2, 2, 2, 8, 2, 2, 2)
    assert(stepped.accepted() && stepped.collided() && stepped.stepped() &&
        stepped.resolvedX() == 8 && stepped.stepHeight() == 2,
        "capsule must traverse a bounded obstacle with enough step height")
    var tooLow = capsule.moveCapsule(2, 2, 2, 8, 2, 2, 1)
    assert(tooLow.accepted() && tooLow.collided() && !tooLow.stepped() &&
        tooLow.resolvedX() == 2,
        "capsule must slide when step height is insufficient")
    assert(capsule.addStepObstacle(4, 6, 4, 6, 2) &&
        capsule.stepObstacleCount() == 2,
        "capsule must retain multiple bounded obstacles")
    assert(capsule.addStepObstacle(0, 1, 8, 9, 1) &&
        capsule.addStepObstacle(8, 9, 0, 1, 1) &&
        capsule.addStepObstacle(8, 9, 8, 9, 1) &&
        capsule.stepObstacleCount() == 5,
        "capsule obstacle capacity must exceed the legacy four-slot bound")
    var orderedHit = capsule.queryCapsule(2, 2, 2, 8, 2, 8)
    assert(orderedHit.accepted() && orderedHit.collided() && orderedHit.hitStep() == 1,
        "capsule obstacles must resolve in deterministic traversal order")
    assert(capsule.clearStepObstacles() && capsule.stepObstacleCount() == 0,
        "capsule obstacle collection must clear")
    var afterClear = capsule.moveCapsule(2, 2, 2, 8, 2, 8, 1)
    assert(afterClear.accepted() && !afterClear.collided(),
        "cleared capsule obstacles must no longer block movement")
    var gate = SpatialQueryGate(0, 0, 0, 10, 10, 10, 1, 20)
    var admitted = gate.admitPlayerMoveWithStep(2, 2, 2, 12, 2, 2, 1)
    assert(admitted.accepted() && admitted.collided() && admitted.slideX() == 7,
        "spatial gate must expose authoritative capsule slide")
    assert(gate.addBroadPhaseTriangle(0, 0, 5, 4, 0, 5, 0, 4, 5),
        "spatial gate must accept broad-phase movement geometry")
    var gateRevision = gate.broadPhaseRevision()
    var broadAdmitted = gate.admitPlayerMoveWithBroadPhase(
        gateRevision, 1, 1, 1, 1, 1, 8)
    assert(broadAdmitted.accepted() && broadAdmitted.collided() &&
        broadAdmitted.resolvedZ() <= 5,
        "spatial gate must combine broad-phase and capsule admission")
    var staleBroadAdmitted = gate.admitPlayerMoveWithBroadPhase(
        gateRevision - 1, 1, 1, 1, 1, 1, 8)
    assert(!staleBroadAdmitted.accepted(),
        "spatial gate must reject stale broad-phase movement geometry")
}

test "shared capsule and spatial admission" {
    var capsule = BoundedCapsuleWorld(0, 0, 0, 10, 10, 10, 1, 20)
    var capsuleHit = capsule.queryCapsule(2, 2, 2, 10, 2, 2)
    assert(capsuleHit.accepted() && capsuleHit.collided(),
        "capsule center must respect expanded bounds")
    assert(capsule.capsuleRadius() == 1, "capsule radius must remain bounded")
    assert(!capsule.configure(0, 0, 0, 1, 1, 1, 1, 20),
        "capsule larger than volume must reject")

    var gate = SpatialQueryGate(0, 0, 0, 10, 10, 10, 1, 20)
    var player = gate.admitPlayerMove(2, 2, 2, 9, 2, 2)
    var projectile = gate.admitProjectile(1, 1, 1, 12, 1, 1)
    var lineOfSight = gate.admitLineOfSight(1, 1, 1, 12, 1, 1)
    assert(player.accepted() && !player.collided(),
        "player admission must use capsule bounds")
    assert(projectile.collided() && lineOfSight.collided(),
        "projectile and line-of-sight must share segment admission")
}

test "authoritative weapon and damage transitions" {
    var combat = CombatWorld(2, 1)
    assert(!combat.defineWeapon(0, 2, 3, 5, 1),
        "weapon definitions must reject invalid identity")
    assert(combat.defineWeapon(7, 2, 3, 5, 1) &&
        combat.setWeaponRange(7, 100) &&
        combat.setWeaponCooldown(7, 2),
        "weapon definition must accept bounded firing data")
    assert(combat.addActor(1, 20, 2) && combat.addActor(2, 9, 1),
        "combat actors must admit bounded health and armor")
    assert(combat.equipWeapon(1, 7),
        "alive actors must equip a defined weapon")
    var firstShot = combat.fire(1, 4)
    assert(firstShot.accepted() && firstShot.shotId() == 1 &&
        firstShot.magazine() == 1 && firstShot.reserve() == 3 &&
        firstShot.nextReadyTick() == 6,
        "accepted shots must atomically consume ammo and set cooldown")
    assert(!combat.fire(1, 5).accepted(),
        "cooldown must reject a shot before its ready tick")
    var secondShot = combat.fire(1, 6)
    assert(secondShot.accepted() && secondShot.magazine() == 0,
        "ready weapons must fire with the remaining magazine")
    assert(!combat.fire(1, 7).accepted(),
        "empty magazines must reject shots without mutating state")
    assert(combat.reload(1) && combat.magazine(1) == 2 &&
        combat.reserve(1) == 1,
        "reload must transfer bounded reserve ammo atomically")

    var invalidSource = combat.applyDamage(DamageRequest(99, 2, 5, 1, 0))
    assert(!invalidSource.accepted() && combat.currentHealth(2) == 9,
        "damage must reject unknown sources without mutation")
    var hit = combat.applyDamage(DamageRequest(1, 2, 5, 1, 0))
    assert(hit.accepted() && hit.applied() == 4 &&
        hit.remainingHealth() == 5 && !hit.died(),
        "damage must apply armor before health reduction")
    var critical = combat.applyDamage(DamageRequest(1, 2, 3, 1, 1))
    assert(critical.accepted() && critical.applied() == 5 &&
        critical.remainingHealth() == 0 && critical.died() &&
        critical.deathSequence() == 1 && combat.deaths() == 1,
        "critical damage must own the single alive-to-dead transition")
    assert(!combat.applyDamage(DamageRequest(1, 2, 1, 1, 0)).accepted() &&
        combat.deaths() == 1,
        "dead targets must reject repeated damage and rewards")
}
test "combat resistance and shield mitigation" {
    var combat = CombatWorld(2, 1)
    assert(!combat.defineWeapon(8, 1, 0, 4, 4) &&
        combat.addActor(1, 30, 0) &&
        combat.addActor(2, 20, 0) &&
        combat.setResistance(2, 1, 50) &&
        combat.setShield(2, 6, 6),
        "combat must configure bounded resistance and shield state")
    var shielded = combat.applyDamage(DamageRequest(1, 2, 10, 1, 0))
    assert(shielded.accepted() && shielded.applied() == 5 &&
        shielded.remainingHealth() == 20 && combat.currentShield(2) == 1,
        "resistance must reduce damage before shield absorption")
    var breached = combat.applyDamage(DamageRequest(1, 2, 10, 1, 0))
    assert(breached.accepted() && breached.applied() == 5 &&
        breached.remainingHealth() == 16 && combat.currentShield(2) == 0,
        "shield depletion must transfer only remaining damage to health")
    assert(combat.setResistance(2, 1, 100))
    var resisted = combat.applyDamage(DamageRequest(1, 2, 10, 1, 0))
    assert(resisted.accepted() && resisted.applied() == 1 &&
        resisted.remainingHealth() == 15 &&
        !combat.setResistance(2, 4, 25),
        "full resistance still permits bounded minimum damage")
}

test "shared hitscan projectile and bounded combat events" {
    var combat = CombatWorld(2, 1)
    assert(combat.defineWeapon(4, 3, 0, 4, 2) &&
        combat.setWeaponRange(4, 25))
    assert(combat.addActor(1, 20, 0) && combat.addActor(2, 12, 0))
    assert(combat.equipWeapon(1, 4))
    var hitscan = combat.resolveHitscan(1, 2, 0, 25, 0)
    assert(hitscan.accepted() && hitscan.actionId() == 1 &&
        hitscan.applied() == 4 && hitscan.remainingHealth() == 8 &&
        hitscan.eventSequence() == 1 && combat.magazine(1) == 2,
        "hitscan must share weapon range, ammo and damage authority")
    assert(combat.pendingCombatEvents() == 1 &&
        combat.dequeueCombatEvent(),
        "accepted hits must publish a bounded combat event")
    var hitscanEvent = combat.lastCombatEvent()
    assert(hitscanEvent.kind() == 1 && hitscanEvent.sourceId() == 1 &&
        hitscanEvent.targetId() == 2 && hitscanEvent.applied() == 4 &&
        !hitscanEvent.died(),
        "hitscan events must preserve authoritative damage details")
    assert(!combat.resolveHitscan(1, 2, 0, 26, 0).accepted() &&
        combat.magazine(1) == 2,
        "out-of-range hitscan must reject without consuming ammo")

    var projectile = combat.spawnProjectile(1, 1)
    assert(projectile.accepted() && projectile.projectileId() == 1 &&
        combat.projectileIsActive(1) && combat.magazine(1) == 1,
        "projectile spawn must consume one shot and reserve a bounded slot")
    var projectileHit = combat.resolveProjectile(1, 2, 25, 1)
    assert(projectileHit.accepted() && projectileHit.applied() == 8 &&
        projectileHit.remainingHealth() == 0 && projectileHit.died() &&
        !combat.projectileIsActive(1),
        "projectile resolution must reuse critical damage and consume itself")
    assert(combat.pendingCombatEvents() == 1 &&
        combat.dequeueCombatEvent(),
        "projectile resolution must enqueue one bounded event")
    var projectileEvent = combat.lastCombatEvent()
    assert(projectileEvent.kind() == 2 && projectileEvent.sequence() == 2 &&
        projectileEvent.died() && combat.deaths() == 1,
        "projectile event must preserve sequence and death transition")
}

test "deterministic enemy states and encounter admission" {
    var enemies = EnemyStateWorld(2)
    assert(enemies.configure(100, 20, 4),
        "enemy state world must configure perception and attack bounds")
    assert(!enemies.configure(20, 30, 4),
        "attack range cannot exceed perception range")
    assert(enemies.addEnemy(7, 0) && enemies.state(7) == enemies.idleState(),
        "enemy admission must start in idle")
    var chase = enemies.step(7, 1, 1, true, 60)
    assert(chase.accepted() && chase.state() == enemies.chaseState() &&
        chase.targetId() == 1 && !chase.attackReady(),
        "visible distant targets must drive deterministic chase")
    var attack = enemies.step(7, 2, 1, true, 20)
    assert(attack.accepted() && attack.state() == enemies.attackState() &&
        attack.attackReady() && enemies.attackReadyTick(7) == 6,
        "visible near targets must enter attack and schedule cooldown")
    var waiting = enemies.step(7, 5, 1, true, 20)
    assert(waiting.accepted() && !waiting.attackReady() &&
        !waiting.transitioned(),
        "attack cooldown must suppress repeated attack decisions")
    var repeated = enemies.step(7, 6, 1, true, 20)
    assert(repeated.attackReady() && enemies.attackReadyTick(7) == 10,
        "attack readiness must recur on an integer tick boundary")
    var lost = enemies.step(7, 7, 0, false, 0)
    assert(lost.accepted() && lost.state() == enemies.investigateState() &&
        lost.targetId() == 0,
        "lost perception must clear target and enter investigate")
    assert(!enemies.transition(7, enemies.patrolState(), 6),
        "state transitions must reject time going backwards")
    assert(enemies.kill(7, 8) && enemies.state(7) == enemies.deadState())
    var dead = enemies.step(7, 9, 1, true, 1)
    assert(dead.accepted() && dead.state() == enemies.deadState() &&
        !dead.attackReady(),
        "dead enemies must remain terminal")

    var encounters = EncounterDirector(1)
    assert(!encounters.define(0, 1, 2) && encounters.define(10, 1, 2),
        "encounter definitions must validate identity and budgets")
    var first = encounters.admit(10, 7)
    assert(first.accepted() && first.activeCount() == 1 &&
        first.remainingBudget() == 1,
        "encounter admission must consume one bounded spawn budget")
    assert(!encounters.admit(10, 8).accepted(),
        "encounter active limit must reject overflow")
    assert(encounters.release(10))
    var second = encounters.admit(10, 8)
    assert(second.accepted() && second.remainingBudget() == 0,
        "released encounter slots must admit remaining budget")
    assert(!encounters.admit(10, 9).accepted() &&
        encounters.release(10) && !encounters.release(10),
        "exhausted encounters must reject spawns and extra releases")
}

test "authoritative enemy combat event bridge" {
    var session = AuthoritativeEnemySession(3, 1)
    assert(session.configureEnemyRules(100, 20, 2))
    assert(session.defineWeapon(9, 2, 0, 3, 1) &&
        session.setWeaponRange(9, 20))
    assert(session.defineEncounter(4, 1, 2))
    assert(session.addActor(1, 20, 0) && session.equipWeapon(1, 9))
    assert(session.admitEnemy(4, 2, 5, 0, 9) &&
        session.encounterActiveCount(4) == 1,
        "authoritative admission must link combat, AI and encounter state")

    var enemyAttack = session.stepEnemy(2, 0, 1, true, 10, 0)
    assert(enemyAttack.accepted() && enemyAttack.fired() &&
        enemyAttack.targetId() == 1 && enemyAttack.applied() == 3 &&
        session.pendingCombatEvents() == 1,
        "enemy attack decisions must resolve through authoritative combat")
    assert(session.consumeCombatEvents(0) == 0 &&
        session.pendingCombatEvents() == 0,
        "non-death attack events must be consumed without changing admission")

    var enemyDeath = session.playerHitscan(1, 2, 1, 10, 1)
    assert(enemyDeath.accepted() && enemyDeath.died() &&
        session.enemyState(2) == 7 &&
        session.encounterActiveCount(4) == 0 &&
        session.pendingCombatEvents() == 0,
        "enemy death events must transition AI state and release encounter slots")
    assert(session.admitEnemy(4, 3, 5, 0, 9),
        "released encounter slots must admit remaining deterministic budget")
}

test "loopback enemy tick and replicated snapshots" {
    var loopback = LoopbackSession(4, 4)
    assert(loopback.start())
    assert(loopback.configureEnemyRules(100, 20, 2))
    assert(loopback.defineEnemyWeapon(9, 2, 0, 3, 1) &&
        loopback.setEnemyWeaponRange(9, 20))
    assert(loopback.defineEnemyEncounter(4, 1, 2))
    assert(loopback.addEnemyCombatActor(1, 20, 0) &&
        loopback.equipEnemyCombatWeapon(1, 9))
    assert(loopback.admitEnemy(4, 2, 5, 0, 9))
    assert(loopback.configureEnemyPerception(2, 1, true, 10, 0))
    assert(loopback.advance(16667) == 1,
        "loopback must advance one authoritative enemy tick")
    var decision = loopback.lastEnemyAttack()
    assert(decision.accepted() && decision.fired() &&
        decision.targetId() == 1 && decision.applied() == 3,
        "loopback tick must publish the authoritative enemy attack decision")
    assert(loopback.enemySnapshotCount() == 1)
    var serverSnapshot = loopback.latestEnemySnapshot()
    assert(serverSnapshot.tick() == 1 && serverSnapshot.enemyId() == 2 &&
        serverSnapshot.state() == 4 && serverSnapshot.targetId() == 1,
        "loopback must publish enemy state and target in its snapshot")
    assert(loopback.applyEnemySnapshot(serverSnapshot) &&
        loopback.clientEnemySnapshotCount() == 1 &&
        loopback.latestClientEnemySnapshot().sequence() == serverSnapshot.sequence(),
        "client must accept the monotonic enemy snapshot")
}

test "enemy spatial visibility movement and projectile targeting" {
    var world = EnemySpatialWorld(2, 20)
    assert(world.configureBounds(0, 0, 0, 10, 10, 10),
        "enemy spatial bounds must configure")
    assert(world.setPosition(2, 2, 2, 0) &&
        world.setPosition(1, 2, 2, 10),
        "enemy spatial actors must register")
    var clear = world.visibility(2, 1, 20)
    assert(clear.accepted() && clear.visible() && clear.distance() == 10,
        "clear spatial path must be visible")
    assert(world.addObstacle(0, 0, 5, 10, 0, 5, 0, 10, 5),
        "enemy spatial obstacle must insert")
    var blocked = world.visibility(2, 1, 20)
    assert(blocked.accepted() && !blocked.visible() && blocked.hitStep() == 5,
        "obstacle must block enemy line of sight")
    var movement = world.moveToward(2, 1, 10)
    assert(movement.accepted() && movement.collided() &&
        movement.resolvedZ() == 4 && world.positionZ(2) == 4,
        "enemy movement must stop at the authoritative obstacle sample")

    var session = AuthoritativeEnemySession(3, 1)
    assert(session.configureEnemyRules(100, 20, 2) &&
        session.defineWeapon(9, 2, 0, 3, 1) &&
        session.setWeaponRange(9, 20) &&
        session.defineEncounter(4, 1, 2),
        "spatial combat rules must configure")
    assert(session.addActor(1, 20, 0) &&
        session.equipWeapon(1, 9) &&
        session.admitEnemy(4, 2, 5, 0, 9),
        "spatial combat actors must admit")
    assert(session.setSpatialPosition(1, 0, 0, 0) &&
        session.setSpatialPosition(2, 0, 0, 10),
        "spatial combat actors must position")
    var projectile = session.projectileAttackSpatial(1, 2, 0, 20, 0)
    assert(projectile.accepted() && projectile.applied() == 3,
        "clear spatial projectile must resolve through combat")

    var blockedSession = AuthoritativeEnemySession(3, 1)
    assert(blockedSession.configureEnemyRules(100, 20, 2) &&
        blockedSession.defineWeapon(9, 2, 0, 3, 1) &&
        blockedSession.setWeaponRange(9, 20) &&
        blockedSession.defineEncounter(4, 1, 2) &&
        blockedSession.addActor(1, 20, 0) &&
        blockedSession.admitEnemy(4, 2, 5, 0, 9),
        "blocked spatial combat actors must admit")
    assert(blockedSession.setSpatialPosition(1, 2, 2, 0) &&
        blockedSession.setSpatialPosition(2, 2, 2, 10) &&
        blockedSession.addSpatialObstacle(0, 0, 5, 10, 0, 5, 0, 10, 5),
        "blocked spatial combat geometry must configure")
    var blockedAttack = blockedSession.stepEnemySpatial(2, 0, 1, 0)
    assert(blockedAttack.accepted() && !blockedAttack.fired() &&
        blockedSession.enemyState(2) == 2,
        "blocked enemy perception must investigate without attacking")
    var blockedProjectile = blockedSession.projectileAttackSpatial(1, 2, 0, 20, 0)
    assert(!blockedProjectile.accepted(),
        "blocked spatial projectile must not resolve damage")
}
test "bounded spatial ray target selection" {
    var rays = BoundedRayTargetWorld(4, 20)
    assert(rays.setTarget(9, 5, 0, 0) &&
        rays.setTarget(3, 10, 5, 0) &&
        rays.activeCount() == 2,
        "ray targets must register in bounded storage")
    var center = rays.query(0, 0, 0, 10, 0, 0, 20, 0)
    assert(center.accepted() && center.hit() &&
        center.targetId() == 9 && center.distance() == 5,
        "ray query must select the nearest target on the center line")
    var aim = SpatialAimContract(9, 0, 0, 0, 10, 0, 0, 20, 5)
    var sourceExcluded = rays.queryAim(aim)
    assert(sourceExcluded.accepted() && sourceExcluded.hit() &&
        sourceExcluded.targetId() == 3,
        "shared aim contract must exclude its source actor")
    var pellet = rays.queryShotgunPellet(
        0, 0, 0, 10, 0, 0, 0, 5, 20, 0)
    assert(pellet.accepted() && pellet.hit() &&
        pellet.targetId() == 3 && pellet.distance() == 10,
        "pellet query must apply deterministic spread offsets")
    assert(rays.removeTarget(9) &&
        !rays.query(0, 0, 0, 4, 0, 0, 20, 0).hit(),
        "removed ray targets must no longer be selectable")
    assert(!rays.query(0, 0, 0, 10, 0, 0, -1, 0).accepted() &&
        !rays.query(0, 0, 0, 10, 0, 0, 20, -1).accepted(),
        "ray queries must reject invalid range and radius")
}
test "authoritative spatial shotgun uses shared aim contract" {
    var session = LoopbackSession(8, 8)
    assert(session.definePlayerWeapon(14, 2, 0, 100, 1) &&
        session.setPlayerWeaponRange(14, 30) &&
        session.setPlayerWeaponSpread(14, 3, 5) &&
        session.addPlayerCombatActor(10, 1000, 0) &&
        session.addPlayerCombatActor(11, 1000, 0) &&
        session.addPlayerCombatActor(12, 1000, 0) &&
        session.addPlayerCombatActor(13, 1000, 0) &&
        session.equipPlayerCombatWeapon(10, 14),
        "authoritative spatial shotgun rules must configure")
    assert(session.setPlayerSpatialTarget(10, 0, 0, 0) &&
        session.setPlayerSpatialTarget(11, 10, 5, 0) &&
        session.setPlayerSpatialTarget(12, 5, -5, 0) &&
        session.setPlayerSpatialTarget(13, 15, -5, 0),
        "shared aim targets must register")
    var result = session.resolvePlayerSpatialShotgun(
        10, 0, 0, 0, 10, 0, 0, 30, 0, 0, 0)
    assert(result.accepted() && result.targetCount() == 3 &&
        result.applied() == 296 &&
        session.playerCombatHealth(11) == 900 &&
        session.playerCombatHealth(12) == 901 &&
        session.playerCombatHealth(13) == 903,
        "authoritative spatial shotgun must resolve one target per pellet")
    assert(session.removePlayerSpatialTarget(12) &&
        session.playerCombatHealth(12) == 901,
        "spatial target removal must preserve prior authority state")
}



test "continuous projectiles and encounter zones" {
    var session = AuthoritativeEnemySession(4, 1)
    assert(session.configureEnemyRules(100, 20, 2) &&
        session.defineWeapon(9, 4, 0, 3, 1) &&
        session.setWeaponRange(9, 20) &&
        session.defineEncounter(4, 2, 2),
        "continuous projectile rules must configure")
    assert(session.addActor(1, 20, 0) &&
        session.equipWeapon(1, 9) &&
        session.admitEnemyAt(4, 2, 0, 5, 0, 9, 0, 0, 10),
        "positioned encounter admission must register")
    assert(session.setSpatialPosition(1, 0, 0, 0),
        "projectile source position must register")
    var projectile = session.spawnSpatialProjectile(1, 2, 0, 20, 3, 0)
    assert(projectile.accepted() && session.activeSpatialProjectiles() == 1,
        "continuous projectile must remain active between ticks")
    assert(session.advanceSpatialProjectiles(0) == 1 &&
        session.activeSpatialProjectiles() == 1,
        "projectile must advance without resolving before target contact")
    assert(session.advanceSpatialProjectiles(1) == 1 &&
        session.advanceSpatialProjectiles(2) == 1 &&
        session.advanceSpatialProjectiles(3) == 1 &&
        session.activeSpatialProjectiles() == 0 &&
        session.spatialProjectileHits() == 1,
        "projectile must resolve exactly on its terminal sweep")

    var blocked = AuthoritativeEnemySession(4, 1)
    assert(blocked.configureEnemyRules(100, 20, 2) &&
        blocked.defineWeapon(9, 4, 0, 3, 1) &&
        blocked.setWeaponRange(9, 20) &&
        blocked.defineEncounter(4, 2, 2) &&
        blocked.addActor(1, 20, 0) &&
        blocked.equipWeapon(1, 9) &&
        blocked.admitEnemyAt(4, 2, 0, 5, 0, 9, 0, 0, 10) &&
        blocked.setSpatialPosition(1, 0, 0, 0) &&
        blocked.addSpatialObstacle(0, 0, 5, 10, 0, 5, 0, 10, 5),
        "blocked projectile geometry must configure")
    var blockedProjectile = blocked.spawnSpatialProjectile(1, 2, 0, 20, 3, 0)
    assert(blockedProjectile.accepted() &&
        blocked.advanceSpatialProjectiles(0) == 1 &&
        blocked.advanceSpatialProjectiles(1) == 0 &&
        blocked.activeSpatialProjectiles() == 0 &&
        blocked.spatialProjectileBlocked() == 1 &&
        blocked.spatialProjectileHits() == 0,
        "obstacle must terminate a continuous projectile without damage")

    var zones = AuthoritativeEnemySession(4, 1)
    assert(zones.defineWeapon(9, 1, 0, 1, 1) &&
        zones.setWeaponRange(9, 5) &&
        zones.defineEncounter(7, 2, 2) &&
        zones.configureEncounterZone(7, 0, 0, 0, 5),
        "encounter zone must configure")
    assert(zones.admitEnemyAt(7, 3, 0, 5, 0, 9, 2, 0, 0),
        "enemy inside encounter zone must admit")
    assert(!zones.admitEnemyAt(7, 4, 0, 5, 0, 9, 8, 0, 0) &&
        zones.encounterActiveCount(7) == 1,
        "enemy outside encounter zone must reject without consuming slot")
    var loopback = LoopbackSession(4, 4)
    assert(loopback.start() &&
        loopback.configureEnemyRules(100, 20, 2) &&
        loopback.defineEnemyWeapon(9, 4, 0, 3, 1) &&
        loopback.setEnemyWeaponRange(9, 20) &&
        loopback.defineEnemyEncounter(4, 1, 1) &&
        loopback.addEnemyCombatActor(1, 20, 0) &&
        loopback.equipEnemyCombatWeapon(1, 9) &&
        loopback.admitEnemyAt(4, 2, 0, 5, 0, 9, 0, 0, 10) &&
        loopback.setEnemySpatialPosition(1, 0, 0, 0),
        "loopback must admit spatial projectile actors")
    var loopbackProjectile = loopback.spawnEnemyProjectileSpatial(1, 2, 0, 20, 3, 0)
    assert(loopbackProjectile.accepted() &&
        loopback.advance(16667) == 1 &&
        loopback.advance(16667) == 1 &&
        loopback.advance(16667) == 1 &&
        loopback.advance(16667) == 1 &&
        loopback.activeEnemyProjectiles() == 0 &&
        loopback.enemyProjectileHits() == 1,
        "fixed-step loopback must advance and resolve continuous projectiles")
}
test "deterministic navigation and projectile impact events" {
    var navigation = EnemySpatialWorld(2, 20)
    assert(navigation.configureBounds(0, 0, 0, 10, 10, 10) &&
        navigation.setPosition(2, 1, 1, 1) &&
        navigation.setPosition(1, 1, 1, 8),
        "navigation actors must fit configured bounds")
    assert(navigation.addObstacle(
        0, 0, 4, 6, 0, 4, 0, 10, 4),
        "navigation obstacle must insert")
    var route = navigation.navigation(2, 1)
    assert(route.accepted() && route.found() && route.routeLength() > 0 &&
        route.waypointX() == 1 && route.waypointZ() == 2,
        "bounded A* must choose the deterministic first detour waypoint")
    var steering = navigation.steerToward(2, 1, 1)
    assert(steering.accepted() && steering.found() &&
        steering.resolvedX() == 1 && steering.resolvedZ() == 2 &&
        navigation.positionZ(2) == 2,
        "path steering must advance through the first route waypoint")

    var impacts = AuthoritativeEnemySession(3, 1)
    assert(impacts.configureEnemyRules(100, 20, 2) &&
        impacts.defineWeapon(9, 4, 0, 3, 1) &&
        impacts.setWeaponRange(9, 20) &&
        impacts.defineEncounter(4, 1, 1) &&
        impacts.addActor(1, 20, 0) &&
        impacts.equipWeapon(1, 9) &&
        impacts.admitEnemyAt(4, 2, 0, 5, 0, 9, 0, 0, 6) &&
        impacts.setSpatialPosition(1, 0, 0, 0),
        "impact event actors must configure")
    var projectile = impacts.spawnSpatialProjectile(1, 2, 0, 20, 3, 0)
    assert(projectile.accepted() &&
        impacts.advanceSpatialProjectiles(0) == 1 &&
        impacts.advanceSpatialProjectiles(1) == 1 &&
        impacts.pendingSpatialImpacts() == 1,
        "terminal projectile hit must publish one impact event")
    assert(impacts.dequeueSpatialImpact())
    var impact = impacts.lastSpatialImpact()
    assert(impact.kind() == 1 && impact.sourceId() == 1 &&
        impact.targetId() == 2 && impact.applied() == 3 &&
        impacts.pendingSpatialImpacts() == 0,
        "hit impact must preserve authority and applied damage")
}
test "replicated projectile presentation queues" {
    var loopback = LoopbackSession(4, 4)
    assert(loopback.start() &&
        loopback.configureEnemyRules(100, 20, 2) &&
        loopback.defineEnemyWeapon(9, 4, 0, 3, 1) &&
        loopback.setEnemyWeaponRange(9, 20) &&
        loopback.defineEnemyEncounter(4, 1, 1) &&
        loopback.addEnemyCombatActor(1, 20, 0) &&
        loopback.equipEnemyCombatWeapon(1, 9) &&
        loopback.admitEnemyAt(4, 2, 0, 5, 0, 9, 0, 0, 10) &&
        loopback.setEnemySpatialPosition(1, 0, 0, 0),
        "presentation loopback actors must configure")
    var projectile = loopback.spawnEnemyProjectileSpatial(1, 2, 0, 20, 3, 0)
    assert(projectile.accepted() &&
        loopback.advance(16667) == 1 &&
        loopback.advance(16667) == 1 &&
        loopback.advance(16667) == 1 &&
        loopback.advance(16667) == 1 &&
        loopback.enemyImpactSnapshotCount() == 1,
        "loopback must publish the terminal impact snapshot")
    var snapshot = loopback.latestEnemyImpactSnapshot()
    assert(loopback.pendingImpactPresentations() == 1 &&
        loopback.pendingImpactAudio() == 1 &&
        loopback.dequeueImpactPresentation() &&
        loopback.dequeueImpactAudio(),
        "authoritative projectile impact must stage host feedback")
    assert(snapshot.kind() == 1 && snapshot.sourceId() == 1 &&
        snapshot.targetId() == 2 && snapshot.applied() == 3 &&
        loopback.applyEnemyImpactSnapshot(snapshot) &&
        loopback.clientEnemyImpactSnapshotCount() == 1 &&
        loopback.replayPresentationCount() == 1 &&
        loopback.replayPresentationAt(0).kind() == 3 &&
        loopback.replayPresentationAt(0).valueFive() == 201 &&
        loopback.pendingImpactPresentations() == 1 &&
        loopback.pendingImpactAudio() == 1,
        "client admission must stage impact and capture replay presentation")
    assert(loopback.dequeueImpactPresentation())
    var presentation = loopback.lastImpactPresentation()
    assert(presentation.clip() == 201 &&
        presentation.gain() == 100 &&
        presentation.x() == snapshot.x(),
        "presentation event must preserve replicated impact identity")
    assert(loopback.dequeueImpactAudio() &&
        loopback.consumedImpactClip() == 201 &&
        loopback.consumedImpactGain() == 90 &&
        loopback.consumedImpactLeftGain() == 90 &&
        loopback.consumedImpactRightGain() == 90 &&
        !loopback.applyEnemyImpactSnapshot(snapshot),
        "audio consumption must attenuate by distance and reject duplicates")
}

test "continuous multi-role enemies retarget and replicate" {
    var host = LoopbackSession(16, 12)
    var client = LoopbackSession(8, 12)
    assert(host.configureEnemyRules(100, 5, 1) &&
        host.configureEnemySpatialBounds(
            -200, -20, -20, 200, 20, 20) &&
        host.defineEnemyWeapon(41, 32, 0, 3, 1) &&
        host.setEnemyWeaponRange(41, 20) &&
        host.defineEnemyEncounter(9, 3, 3) &&
        host.start() && host.connectPlayer() == 1 &&
        host.connectPlayer() == 2 &&
        host.addPlayerCombatActor(1, 200, 0) &&
        host.addPlayerCombatActor(2, 200, 0) &&
        host.addEnemyCombatActor(1, 200, 0) &&
        host.addEnemyCombatActor(2, 200, 0) &&
        host.equipEnemyCombatWeapon(1, 41) &&
        host.equipEnemyCombatWeapon(2, 41) &&
        host.setEnemySpatialPosition(1, -10, 0, 0) &&
        host.setEnemySpatialPosition(2, 10, 0, 0) &&
        host.admitEnemyAt(9, 10, 0, 60, 0, 41, -8, 0, 0) &&
        host.admitEnemyAt(9, 11, 0, 60, 0, 41, 8, 0, 0) &&
        host.admitEnemyAt(9, 12, 0, 60, 0, 41, 0, 0, 0) &&
        host.configureEnemyRole(10, 1, 2, 2, 0) &&
        host.configureEnemyRole(11, 2, 2, 1, 0) &&
        host.configureEnemyRole(12, 3, 2, 2, 0),
        "three autonomous combat roles must configure")
    assert(host.advance(66668) == 4 &&
        host.enemyRole(10) == 1 &&
        host.enemyRole(11) == 2 &&
        host.enemyRole(12) == 3 &&
        host.enemyTarget(10) == 1 &&
        host.enemyTarget(11) == 2 &&
        host.enemySpatialPositionX(12) < 0 &&
        host.remoteImpactSequence() >= 3 &&
        host.enemyProjectileHits() > 0,
        "roles must continuously move, fire, and target nearest live players")
    assert(host.setEnemySpatialPosition(1, 100, 0, 0) &&
        host.advance(16667) == 1 &&
        host.enemyTarget(10) == 2,
        "autonomous enemies must retarget when nearest live player changes")
    var encounter = host.enemyEncounterStateMessage(
        host.currentServerTick(), 9)
    assert(client.start() &&
        client.applyRemoteEnemyEncounterState(encounter),
        "client must accept replicated encounter state")
    assert(client.clientRemoteEnemyRole(10) == 1 &&
        client.clientRemoteEnemyRole(11) == 2 &&
        client.clientRemoteEnemyRole(12) == 3,
        "encounter replication must preserve every enemy role")
    assert(client.clientRemoteEnemyPositionX(12) ==
            host.enemySpatialPositionX(12),
        "encounter replication must preserve continuous position")
}

test "G3 authoritative loot progression replication and save reload" {
    var host = LoopbackSession(16, 12)
    assert(host.registerExtensionManifest(7, 1, 1, 2, 4) &&
        host.configureExtensionLoadOrder(7, 1, 10) &&
        host.configureExtensionProvenance(7, 1, 701) &&
        host.configureExtensionSchemas(7, 1, 1, 2) &&
        host.grantExtensionCapability(
            7, 1, extensionContributionEnemyDefinitionKind()) &&
        host.registerExtensionContribution(
            7, 1, extensionContributionEnemyDefinitionKind(), 1001, 20) &&
        host.registerExtensionContribution(
            7, 1, extensionContributionEnemyDefinitionKind(), 1002, 10),
        "G3 extension manifest must grant bounded enemy-definition content")
    assert(host.defineEnemyDefinition(
            7, 1, 1001, 1, enemyDefinitionEliteKind()) &&
        host.setEnemyDefinitionCombat(7, 1001, 7, 0, 41) &&
        host.setEnemyDefinitionBehavior(7, 1001, 1, 1, 1) &&
        host.setEnemyDefinitionCritical(7, 1001, 0) &&
        host.setEnemyDefinitionLoot(7, 1001, 800, 77, 4) &&
        host.setEnemyDefinitionRankCurrency(
            7, 1001, enemyDefinitionEliteKind(), 0) &&
        host.defineEnemyDefinition(
            7, 1, 1002, 1, enemyDefinitionBossKind()) &&
        host.setEnemyDefinitionCombat(7, 1002, 22, 0, 41) &&
        host.setEnemyDefinitionBehavior(7, 1002, 3, 1, 1) &&
        host.setEnemyDefinitionCritical(7, 1002, 1) &&
        host.setEnemyDefinitionLoot(7, 1002, 800, 88, 5) &&
        host.setEnemyDefinitionRankCurrency(
            7, 1002, enemyDefinitionBossKind(), 50) &&
        host.setEnemyDefinitionProgression(7, 1002, 30, 100),
        "G3 elite and boss rules must be complete data definitions")
    assert(host.configureEnemyRules(100, 5, 1) &&
        host.defineEnemyWeapon(41, 8, 0, 5, 0) &&
        host.setEnemyWeaponRange(41, 20) &&
        host.defineEnemyEncounter(9, 2, 2) &&
        host.start() && host.connectPlayer() == 1 &&
        host.extensionRegistryChecksum() > 0 &&
        host.enemyDefinitionChecksum() > 0 &&
        host.extensionContributionCount() == 2 &&
        host.extensionContributionPublicId(0) == 1002,
        "G3 registries must seal with deterministic extension order")
    assert(host.addPlayerCombatActor(1, 200, 0) &&
        host.addEnemyCombatActor(1, 200, 0) &&
        host.equipEnemyCombatWeapon(1, 41),
        "G3 player combat authority must configure")
    assert(host.defineLootAffixPool(1) &&
        host.addLootAffix(1, 11, 1) &&
        host.defineLootAffixStat(11, 5, 0, 0) &&
        host.defineLootItem(501, 10, 1, 10, 1) &&
        host.addLootTableEntry(501, 1),
        "G3 deterministic loot content must configure")
    assert(host.definePlayerSkill(30, 2, 100) &&
        host.setPlayerSkillDamagePercent(30, 20) &&
        host.definePlayerStatus(40, 20, 3) &&
        host.setPlayerStatusDamageModifier(40, 2, 0) &&
        host.applyPlayerStatus(1, 40, 10, 2),
        "G3 skill and status authority must configure")
    assert(host.admitDefinedEnemy(9, 100, 7, 1001) &&
        host.enemyKind(100) == enemyDefinitionEliteKind() &&
        host.enemyDefinitionId(100) == 1001,
        "G3 elite actor must instantiate from its data definition")
    assert(host.admitDefinedEnemy(9, 101, 7, 1002) &&
        host.enemyKind(101) == enemyDefinitionBossKind() &&
        host.enemyDefinitionNamespace(101) == 7,
        "G3 boss actor and rewards must instantiate atomically")
    assert(host.enemyCombatHealth(101) == 22,
        "G3 boss must enter combat at authored health")

    var learn = newGameplayProgressionCommand(
        1, 1, 1, 30, 1, 1)
    assert(validGameplayCommandMessage(learn),
        "skill learn command must satisfy the gameplay wire schema")
    assert(host.applyRemoteGameplayCommand(learn),
        "host must consume the ordered skill learn command")
    assert(host.lastRemoteGameplayAccepted() &&
        host.playerSkillRank(1, 30) == 0,
        "server must authorize skill learning without client-authored rank")
    var eliteDeath = host.resolveEnemyHitscan(1, 100, 1, 1, 0)
    assert(eliteDeath.accepted() && eliteDeath.died() &&
        eliteDeath.applied() == 7 &&
        host.worldLootCount() == 1 &&
        host.worldLootStableId(0) == 900,
        "elite death must deterministically stage its complete rolled item")
    assert(host.enemyCombatHealth(101) == 22,
        "elite death must not mutate boss health")
    var eliteRoll = host.worldLootRoll(0)
    assert(eliteRoll.accepted() && eliteRoll.seed() == 2487 &&
        eliteRoll.definitionId() == 501 && eliteRoll.affixOne() == 11,
        "rolled item identity and affix must derive from server seed and content")

    var pickup = newGameplayPickupCommand(
        1, 2, 2, 900, 1)
    var equip = newGameplayEquipCommand(
        1, 3, 3, 0, 900, 1)
    assert(host.applyRemoteGameplayCommand(pickup) &&
        host.lastRemoteGameplayAccepted() &&
        host.worldLootCount() == 0 &&
        host.playerItemQuantity(1, 900) == 1 &&
        host.applyRemoteGameplayCommand(equip) &&
        host.lastRemoteGameplayAccepted() &&
        host.playerEquipmentItem(1, 0) == 900 &&
        host.playerEquipmentDamageBonus(1) == 15,
        "server pickup and equip must consume world loot and compose item stats")

    var currencyBeforeForgery = host.playerCurrency(1)
    var itemsBeforeForgery = host.playerInventory(1).itemCount()
    var forgedPickup = newGameplayPickupCommand(
        1, 4, 4, 999999, 1)
    var forgedEquip = newGameplayEquipCommand(
        1, 5, 5, 1, 999998, 1)
    var forgedProgression = newGameplayProgressionCommand(
        1, 6, 6, 30, 1, 1)
    assert(host.applyRemoteGameplayCommand(forgedPickup) &&
        !host.lastRemoteGameplayAccepted() &&
        host.applyRemoteGameplayCommand(forgedEquip) &&
        !host.lastRemoteGameplayAccepted() &&
        host.applyRemoteGameplayCommand(forgedProgression) &&
        !host.lastRemoteGameplayAccepted() &&
        host.playerCurrency(1) == currencyBeforeForgery &&
        host.playerInventory(1).itemCount() == itemsBeforeForgery &&
        host.playerSkillRank(1, 30) == 0,
        "client commands cannot mint items, currency, equipment, or ranks")

    assert(host.enemyCombatHealth(101) == 22,
        "rejected client commands must not mutate boss health")
    assert(host.canGrantCombatReward(
            1, host.combatRewardCurrency(101)),
        "boss currency reward must pass atomic preflight")
    assert(host.canGrantEnemyLootReward(1, 101),
        "boss loot and experience reward must pass atomic preflight")
    assert(host.enemyCombatAlive(1) &&
        host.enemyCombatAlive(101),
        "boss combat actors must remain alive before resolution")
    assert(host.enemyCombatMagazine(1) == 7 &&
        host.pendingEnemyCombatEvents() == 0,
        "boss shot must retain ammunition and event capacity")
    assert(host.enemyCombatReadyTick(1) <= 6 &&
        host.enemyCombatWeaponRange(1) >= 1,
        "boss shot must satisfy weapon cooldown and range")
    var bossDeath = host.resolveEnemyHitscan(1, 101, 6, 1, 0)
    assert(bossDeath.accepted() && bossDeath.died() &&
        bossDeath.applied() == 22,
        "equipped item and status must alter authoritative boss damage")
    assert(host.playerCurrency(1) == 50 &&
        host.playerSkillRank(1, 30) == 1,
        "boss death must commit currency and skill experience")
    assert(host.worldLootCount() == 1 &&
        host.worldLootStableId(0) == 901 &&
        host.worldLootRank(0) == 3,
        "boss death must stage its ranked rolled item")

    var client = LoopbackSession(8, 12)
    var gameplayState = host.gameplayStateMessage(
        host.currentServerTick(), 1, 1)
    var authorityState = host.playerAuthorityStateMessage(
        host.currentServerTick(), 1)
    var lootState = host.worldLootStateMessage(
        host.currentServerTick(), 1)
    assert(client.start() &&
        client.applyRemoteGameplayState(gameplayState) &&
        client.remotePlayerSnapshotCount(1) == 1 &&
        client.interpolatedRemotePlayerPosition(
            1, host.currentServerTick()) ==
            gameplayStatePlayerPosition(gameplayState, 1),
        "client must accept and interpolate the ordered gameplay baseline")
    assert(validPlayerAuthorityStateMessage(authorityState) &&
        client.applyRemotePlayerAuthorityState(authorityState),
        "client must accept the ordered player authority baseline")
    assert(validWorldLootStateMessage(lootState) &&
        client.applyRemoteWorldLootState(lootState),
        "client must accept the ordered world loot baseline")
    assert(client.clientRemoteCurrency() == 50 &&
        client.clientRemoteItemCount() == 1 &&
        client.clientRemoteItemId(0) == 900 &&
        client.clientRemoteItemSeed(0) == 2487 &&
        client.clientRemoteEquipmentItem(0) == 900 &&
        client.clientRemoteSkillRank(30) == 1 &&
        client.clientRemoteStatusStackCount(40) == 2 &&
        client.clientRemoteWorldLootCount() == 1 &&
        client.clientRemoteWorldLootStableId(0) == 901 &&
        client.clientRemoteWorldLootSeed(0) == 2829,
        "G3 replication must expose inventory, equipment, progression, and drops")
    var replicatedHud = ShooterHud(200, 8)
    assert(replicatedHud.update(200, 8, 0, 7, true) &&
        replicatedHud.updateEncounterReplication(0, 0, true, 1, 1) &&
        replicatedHud.updateInventoryStatus(
            client.clientRemoteItemCount(), 8,
            client.clientRemoteEquipmentItem(0) > 0) &&
        replicatedHud.updateSkillStatus(
            client.clientRemoteSkillRank(30),
            client.clientRemoteSkillExperience(30), 100) &&
        replicatedHud.updateWorldLootStatus(
            client.clientRemoteWorldLootCount(),
            client.clientRemoteWorldLootRank(0)) &&
        replicatedHud.updateThreatStatus(
            host.activeEnemyKindCount(enemyDefinitionEliteKind()),
            host.activeEnemyKindCount(enemyDefinitionBossKind()),
            host.enemyKind(101)),
        "replicated G3 authority must map into bounded HUD state")
    var replicatedHudFrame = FrameStaging(
        replicatedHud.renderVertexCount())
    assert(replicatedHud.stage(replicatedHudFrame, 1, 9) &&
        replicatedHudFrame.stagedCount() ==
            replicatedHud.renderVertexCount() &&
        replicatedHud.inventoryItems() == 1 &&
        replicatedHud.equipmentReady() &&
        replicatedHud.skillRank() == 1 &&
        replicatedHud.worldLootCount() == 1 &&
        replicatedHud.worldLootRank() == 3 &&
        replicatedHud.eliteThreats() == 0 &&
        replicatedHud.bossThreats() == 0 &&
        replicatedHud.defeatedThreatKind() == enemyDefinitionBossKind(),
        "replicated inventory skill equipment and ranked loot must render")
    assert(replicatedHudFrame.retire(1))

    var full = LoopbackSession(8, 4)
    assert(full.configureEnemyRules(100, 5, 1) &&
        full.defineEnemyWeapon(41, 2, 0, 5, 0) &&
        full.setEnemyWeaponRange(41, 20) &&
        full.defineEnemyEncounter(9, 1, 1) &&
        full.start() && full.connectPlayer() == 1 &&
        full.addEnemyCombatActor(1, 100, 0) &&
        full.equipEnemyCombatWeapon(1, 41) &&
        full.admitEnemy(9, 100, 5, 0, 41) &&
        full.defineLootAffixPool(1) &&
        full.addLootAffix(1, 11, 1) &&
        full.defineLootAffixStat(11, 5, 0, 0) &&
        full.defineLootItem(501, 10, 1, 10, 1) &&
        full.addLootTableEntry(501, 1) &&
        full.defineEnemyLootReward(100, 900, 77, 4, 2),
        "full-inventory deterministic loot scenario must configure")
    for (var fill = 0; fill < 8; fill = fill + 1) {
        assert(full.addPlayerItem(1, 1000 + fill, 1))
    }
    var fullDeath = full.resolveEnemyHitscan(1, 100, 0, 1, 0)
    var fullCurrency = full.playerCurrency(1)
    var fullRevision = full.worldLootRevision()
    assert(fullDeath.accepted() && fullDeath.died() &&
        !full.pickupPlayerLoot(1, 900) &&
        full.worldLootCount() == 1 &&
        full.worldLootRevision() == fullRevision &&
        full.worldLootRoll(0).seed() == 77 &&
        full.playerCurrency(1) == fullCurrency &&
        full.playerInventory(1).itemCount() == 8,
        "full inventory must preserve item identity, currency, and loot revision")

    var sections = BoundedSaveSections(12, 160)
    var store = BoundedSaveSchemaFileStore(12, 160)
    var savePath = "/tmp/kookie-g3-authority-test.bin"
    assert(sections.setRevision(host.currentServerTick()) &&
        host.encodeG3Authority(1, sections) &&
        store.write(savePath, sections),
        "G3 authoritative state must persist through the schema file store")
    var loaded = BoundedSaveSections(12, 160)
    assert(store.read(savePath, loaded),
        "G3 authoritative schema file must reload")

    var restored = LoopbackSession(16, 12)
    assert(restored.registerExtensionManifest(7, 1, 1, 2, 4) &&
        restored.configureExtensionLoadOrder(7, 1, 10) &&
        restored.configureExtensionProvenance(7, 1, 701) &&
        restored.configureExtensionSchemas(7, 1, 1, 2) &&
        restored.grantExtensionCapability(
            7, 1, extensionContributionEnemyDefinitionKind()) &&
        restored.registerExtensionContribution(
            7, 1, extensionContributionEnemyDefinitionKind(), 1001, 20) &&
        restored.registerExtensionContribution(
            7, 1, extensionContributionEnemyDefinitionKind(), 1002, 10),
        "restore must load the same bounded extension manifest")
    assert(restored.defineEnemyDefinition(
            7, 1, 1001, 1, enemyDefinitionEliteKind()) &&
        restored.setEnemyDefinitionCombat(7, 1001, 7, 0, 41) &&
        restored.setEnemyDefinitionBehavior(7, 1001, 1, 1, 1) &&
        restored.setEnemyDefinitionCritical(7, 1001, 0) &&
        restored.setEnemyDefinitionLoot(7, 1001, 800, 77, 4) &&
        restored.setEnemyDefinitionRankCurrency(
            7, 1001, enemyDefinitionEliteKind(), 0) &&
        restored.defineEnemyDefinition(
            7, 1, 1002, 1, enemyDefinitionBossKind()) &&
        restored.setEnemyDefinitionCombat(7, 1002, 22, 0, 41) &&
        restored.setEnemyDefinitionBehavior(7, 1002, 3, 1, 1) &&
        restored.setEnemyDefinitionCritical(7, 1002, 1) &&
        restored.setEnemyDefinitionLoot(7, 1002, 800, 88, 5) &&
        restored.setEnemyDefinitionRankCurrency(
            7, 1002, enemyDefinitionBossKind(), 50) &&
        restored.setEnemyDefinitionProgression(7, 1002, 30, 100),
        "restore must load the same elite and boss definitions")
    assert(restored.configureEnemyRules(100, 5, 1) &&
        restored.defineEnemyWeapon(41, 8, 0, 5, 0) &&
        restored.setEnemyWeaponRange(41, 20) &&
        restored.defineEnemyEncounter(9, 2, 2) &&
        restored.start() && restored.connectPlayer() == 1 &&
        restored.addPlayerCombatActor(1, 200, 0) &&
        restored.addEnemyCombatActor(1, 200, 0) &&
        restored.equipEnemyCombatWeapon(1, 41),
        "restore combat authority must configure")
    assert(restored.defineLootAffixPool(1) &&
        restored.addLootAffix(1, 11, 1) &&
        restored.defineLootAffixStat(11, 5, 0, 0) &&
        restored.defineLootItem(501, 10, 1, 10, 1) &&
        restored.addLootTableEntry(501, 1) &&
        restored.definePlayerSkill(30, 2, 100) &&
        restored.setPlayerSkillDamagePercent(30, 20) &&
        restored.definePlayerStatus(40, 20, 3) &&
        restored.setPlayerStatusDamageModifier(40, 2, 0),
        "restore content authority must configure")
    assert(restored.admitDefinedEnemy(9, 100, 7, 1001) &&
        restored.admitDefinedEnemy(9, 101, 7, 1002) &&
        restored.decodeG3Authority(1, loaded),
        "G3 state must atomically reload against data-defined authority")
    assert(restored.playerCurrency(1) == 50 &&
        restored.playerItemQuantity(1, 900) == 1 &&
        restored.playerEquipmentItem(1, 0) == 900 &&
        restored.playerEquipmentDamageBonus(1) == 15 &&
        restored.playerSkillRank(1, 30) == 1 &&
        restored.playerStatusStacks(1, 40) == 2 &&
        restored.worldLootCount() == 1 &&
        restored.worldLootStableId(0) == 901 &&
        restored.combatRewardClaimed(101),
        "save reload must preserve boss rewards and every player authority domain")
    var currencyBeforeReplay = restored.playerCurrency(1)
    var rankBeforeReplay = restored.playerSkillRank(1, 30)
    var replayedBoss = restored.resolveEnemyHitscan(1, 101, 7, 1, 0)
    assert(replayedBoss.accepted() && replayedBoss.died() &&
        restored.playerCurrency(1) == currencyBeforeReplay &&
        restored.playerSkillRank(1, 30) == rankBeforeReplay &&
        restored.worldLootCount() == 1,
        "reloaded reward claims must prevent boss reward duplication")
}

Bool g4PutLe16(Int[] target, Int offset, Int value) {
    target[offset] = value & 255
    target[offset + 1] = (value >>> 8) & 255
    return true
}

Bool g4PutLe32(Int[] target, Int offset, Int value) {
    target[offset] = value & 255
    target[offset + 1] = (value >>> 8) & 255
    target[offset + 2] = (value >>> 16) & 255
    target[offset + 3] = (value >>> 24) & 255
    return true
}

Bool g4Zero(Int[] target) {
    for (var index = 0; index < target.length; index = index + 1) {
        target[index] = 0
    }
    return true
}

Int[] g4DecimalBytes(String source, Int count) {
    var result = new Int[count]
    var output = 0
    var value = 0
    var digits = 0
    for (var index = 0; index <= source.length(); index = index + 1) {
        var character = 44
        if (index < source.length()) {
            character = source.charAt(index) as Int
        }
        if (character >= 48 && character <= 57) {
            value = value * 10 + character - 48
            digits = digits + 1
            if (value > 255) { return new Int[0] }
        } else if (character == 44 && digits > 0) {
            if (output >= result.length) { return new Int[0] }
            result[output] = value
            output = output + 1
            value = 0
            digits = 0
        } else {
            return new Int[0]
        }
    }
    if (output != result.length) { return new Int[0] }
    return result
}

Bool g4PutBe32(Int[] target, Int offset, Int value) {
    target[offset] = (value >>> 24) & 255
    target[offset + 1] = (value >>> 16) & 255
    target[offset + 2] = (value >>> 8) & 255
    target[offset + 3] = value & 255
    return true
}

Int g4PngCrc(Int[] source, Int start, Int limit) {
    var crc = -1
    for (var index = start; index < limit; index = index + 1) {
        crc = crc ^ source[index]
        for (var bit = 0; bit < 8; bit = bit + 1) {
            if ((crc & 1) != 0) {
                crc = (crc >>> 1) ^ -306674912
            } else {
                crc = crc >>> 1
            }
        }
    }
    return crc ^ -1
}

Bool g4RefreshPngChunkCrc(Int[] source, Int typeStart, Int length) {
    return g4PutBe32(
        source, typeStart + 4 + length,
        g4PngCrc(source, typeStart, typeStart + 4 + length))
}

