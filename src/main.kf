Int g4WritePngChunk(
    Int[] target, Int offset, Int kind, Int[] data
) {
    g4PutBe32(target, offset, data.length)
    target[offset + 4] = (kind >>> 24) & 255
    target[offset + 5] = (kind >>> 16) & 255
    target[offset + 6] = (kind >>> 8) & 255
    target[offset + 7] = kind & 255
    for (var index = 0; index < data.length; index = index + 1) {
        target[offset + 8 + index] = data[index]
    }
    g4PutBe32(
        target, offset + 8 + data.length,
        g4PngCrc(target, offset + 4, offset + 8 + data.length))
    return offset + 12 + data.length
}

Int[] g4MinimalPngFixture(
    Int colorType, Int[] samples, Int[] palette, Int[] transparency
) {
    var channelCount = 0
    if (colorType == 0 || colorType == 3) {
        channelCount = 1
    } else if (colorType == 2) {
        channelCount = 3
    } else if (colorType == 4) {
        channelCount = 2
    } else if (colorType == 6) {
        channelCount = 4
    }
    if (channelCount <= 0 || samples.length != channelCount * 2) {
        return new Int[0]
    }
    var rawLength = samples.length + 1
    var compressed = new Int[rawLength + 11]
    compressed[0] = 120
    compressed[1] = 1
    compressed[2] = 1
    compressed[3] = rawLength & 255
    compressed[4] = (rawLength >>> 8) & 255
    compressed[5] = (65535 - rawLength) & 255
    compressed[6] = ((65535 - rawLength) >>> 8) & 255
    compressed[7] = 0
    for (var index = 0; index < samples.length; index = index + 1) {
        compressed[8 + index] = samples[index]
    }
    var adlerA = 1
    var adlerB = 0
    for (var index = 7; index < 7 + rawLength; index = index + 1) {
        adlerA = (adlerA + compressed[index]) % 65521
        adlerB = (adlerB + adlerA) % 65521
    }
    var adler = (adlerB << 16) | adlerA
    g4PutBe32(compressed, compressed.length - 4, adler)

    var total = 8 + 25 + 12 + compressed.length + 12
    if (palette.length > 0) { total = total + 12 + palette.length }
    if (transparency.length > 0) {
        total = total + 12 + transparency.length
    }
    var source = new Int[total]
    source[0] = 137
    source[1] = 80
    source[2] = 78
    source[3] = 71
    source[4] = 13
    source[5] = 10
    source[6] = 26
    source[7] = 10
    var header = new Int[13]
    g4PutBe32(header, 0, 2)
    g4PutBe32(header, 4, 1)
    header[8] = 8
    header[9] = colorType
    header[10] = 0
    header[11] = 0
    header[12] = 0
    var cursor = g4WritePngChunk(source, 8, 1229472850, header)
    if (palette.length > 0) {
        cursor = g4WritePngChunk(source, cursor, 1347179589, palette)
    }
    if (transparency.length > 0) {
        cursor = g4WritePngChunk(source, cursor, 1951551059, transparency)
    }
    cursor = g4WritePngChunk(source, cursor, 1229209940, compressed)
    cursor = g4WritePngChunk(source, cursor, 1229278788, new Int[0])
    if (cursor != source.length) { return new Int[0] }
    return source
}

Int[] g4PcmWavFixture(
    Int bits, Int channels, Int sampleRate, Int[] data, Bool includeMetadata
) {
    var bytesPerSample = bits / 8
    if ((bits != 8 && bits != 16) ||
        (channels != 1 && channels != 2) || bytesPerSample <= 0) {
        return new Int[0]
    }
    var metadataLength = 0
    if (includeMetadata) { metadataLength = 24 }
    var paddedDataLength = data.length + (data.length % 2)
    var source = new Int[44 + metadataLength + paddedDataLength]
    g4Zero(source)
    g4PutBe32(source, 0, 1380533830)
    g4PutLe32(source, 4, source.length - 8)
    g4PutBe32(source, 8, 1463899717)
    var cursor = 12
    if (includeMetadata) {
        g4PutBe32(source, cursor, 1247104587)
        g4PutLe32(source, cursor + 4, 3)
        source[cursor + 8] = 1
        source[cursor + 9] = 2
        source[cursor + 10] = 3
        cursor = cursor + 12
    }
    g4PutBe32(source, cursor, 1718449184)
    g4PutLe32(source, cursor + 4, 16)
    g4PutLe16(source, cursor + 8, 1)
    g4PutLe16(source, cursor + 10, channels)
    g4PutLe32(source, cursor + 12, sampleRate)
    var blockAlign = channels * bytesPerSample
    g4PutLe32(source, cursor + 16, sampleRate * blockAlign)
    g4PutLe16(source, cursor + 20, blockAlign)
    g4PutLe16(source, cursor + 22, bits)
    cursor = cursor + 24
    if (includeMetadata) {
        g4PutBe32(source, cursor, 1279873876)
        g4PutLe32(source, cursor + 4, 4)
        g4PutBe32(source, cursor + 8, 1229866575)
        cursor = cursor + 12
    }
    g4PutBe32(source, cursor, 1684108385)
    g4PutLe32(source, cursor + 4, data.length)
    for (var index = 0; index < data.length; index = index + 1) {
        source[cursor + 8 + index] = data[index]
    }
    cursor = cursor + 8 + paddedDataLength
    if (cursor != source.length) { return new Int[0] }
    return source
}

