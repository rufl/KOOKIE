    g4PutLe16(source, 4, 20)
    g4PutLe32(source, 18, 2)
    g4PutLe32(source, 22, 2)
    g4PutLe16(source, 26, 10)
    var name = "model.json"
    for (var index = 0; index < name.length(); index = index + 1) {
        source[30 + index] = name.charAt(index) as Int
    }
    source[40] = 123
    source[41] = 125
    source[42] = 80; source[43] = 75; source[44] = 1; source[45] = 2
    g4PutLe16(source, 46, 20)
    g4PutLe16(source, 48, 20)
    g4PutLe32(source, 62, 2)
    g4PutLe32(source, 66, 2)
    g4PutLe16(source, 70, 10)
    for (var index = 0; index < name.length(); index = index + 1) {
        source[88 + index] = name.charAt(index) as Int
    }
    source[98] = 80; source[99] = 75; source[100] = 5; source[101] = 6
    g4PutLe16(source, 106, 1)
    g4PutLe16(source, 108, 1)
    g4PutLe32(source, 110, 56)
    g4PutLe32(source, 114, 42)
    return source
}

String g4BlockbenchFixture(
    String animatedBone, String interpolation, String xValue,
    String animationExtra
) {
    var root = "11111111-1111-4111-8111-111111111111"
    var arm = "22222222-2222-4222-8222-222222222222"
    var bodyCube = "33333333-3333-4333-8333-333333333333"
    var armCube = "44444444-4444-4444-8444-444444444444"
    return "{\"meta\":{\"format_version\":\"5.0\"," +
        "\"model_format\":\"free\"}," +
        "\"elements\":[" +
        "{\"type\":\"cube\",\"uuid\":\"" + bodyCube + "\"," +
        "\"name\":\"body\",\"from\":[-4,0,-2],\"to\":[4,12,2]," +
        "\"origin\":[0,0,0],\"rotation\":[0,0,0]}," +
        "{\"type\":\"cube\",\"uuid\":\"" + armCube + "\"," +
        "\"name\":\"arm\",\"from\":[4,7,-1],\"to\":[10,9,1]," +
        "\"origin\":[4,8,0],\"rotation\":[0,0,0],\"inflate\":0.25," +
        "\"stretch\":[1.25,1,1]}]," +
        "\"groups\":[" +
        "{\"uuid\":\"" + root + "\",\"name\":\"root\",\"origin\":[0,0,0]}," +
        "{\"uuid\":\"" + arm + "\",\"name\":\"arm\",\"origin\":[4,8,0]}]," +
        "\"outliner\":[{\"uuid\":\"" + root + "\",\"children\":[\"" +
        bodyCube + "\",{\"uuid\":\"" + arm + "\",\"children\":[\"" +
        armCube + "\"]}]}]," +
        "\"animations\":[{\"uuid\":\"55555555-5555-4555-8555-555555555555\"," +
        "\"name\":\"walk\",\"loop\":\"loop\",\"length\":1," +
        animationExtra + "\"animators\":{\"" + animatedBone +
        "\":{\"type\":\"bone\",\"keyframes\":[" +
        "{\"uuid\":\"66666666-6666-4666-8666-666666666666\"," +
        "\"channel\":\"position\",\"time\":0,\"interpolation\":\"linear\"," +
        "\"data_points\":[{\"x\":\"0\",\"y\":\"0\",\"z\":\"0\"}]}," +
        "{\"uuid\":\"77777777-7777-4777-8777-777777777777\"," +
        "\"channel\":\"position\",\"time\":1,\"interpolation\":\"" +
        interpolation + "\",\"data_points\":[{\"x\":" + xValue +
        ",\"y\":\"0\",\"z\":\"0\"}]}]}," +
        "\"" + arm + "\":{\"type\":\"bone\",\"keyframes\":[" +
        "{\"uuid\":\"88888888-8888-4888-8888-888888888888\"," +
        "\"channel\":\"rotation\",\"time\":0,\"data_points\":[{" +
        "\"x\":0,\"y\":0,\"z\":0}]}," +
        "{\"uuid\":\"99999999-9999-4999-8999-999999999999\"," +
        "\"channel\":\"rotation\",\"time\":1,\"interpolation\":\"step\"," +
        "\"data_points\":[{\"x\":0,\"y\":0,\"z\":30}]}]}}}]}"
}

String g4BlockbenchDepthUuid(Int index) {
    var suffix = "" + index
    if (index < 10) { suffix = "0" + suffix }
    return "00000000-0000-0000-0000-0000000000" + suffix
}

String g4BlockbenchDepthFixture(Int depth) {
    var cube = "ffffffff-ffff-4fff-8fff-ffffffffffff"
    var groups = ""
    var outliner = ""
    for (var index = 1; index <= depth; index = index + 1) {
        if (index > 1) { groups = groups + "," }
        var uuid = g4BlockbenchDepthUuid(index)
        groups = groups + "{\"uuid\":\"" + uuid +
            "\",\"name\":\"bone\",\"origin\":[0,0,0]}"
        outliner = outliner + "{\"uuid\":\"" + uuid + "\",\"children\":["
    }
    outliner = outliner + "\"" + cube + "\""
    for (var index = 0; index < depth; index = index + 1) {
        outliner = outliner + "]}"
    }
    return "{\"meta\":{\"format_version\":\"5.0\",\"model_format\":\"free\"}," +
        "\"elements\":[{\"type\":\"cube\",\"uuid\":\"" + cube +
        "\",\"name\":\"body\",\"from\":[0,0,0],\"to\":[1,1,1]," +
        "\"origin\":[0,0,0]}],\"groups\":[" + groups + "]," +
        "\"outliner\":[" + outliner + "]}"
}

test "G4 source kooker admits sprites voxels and convex brushes" {
    var kooker = BoundedSourceKooker()
    var dust = g4DustArchiveFixture()
    assert(!kooker.cookDust3d(dust, new Int[0], 10, 19, 1, 1, 1, 100) &&
        kooker.result().diagnostic() == dust3dDiagnosticUv(),
        "Dust3D intake must admit a bounded model archive before export checks")
    dust[30] = 46; dust[31] = 46; dust[32] = 47
    dust[88] = 46; dust[89] = 46; dust[90] = 47
    assert(!kooker.cookDust3d(dust, new Int[0], 10, 19, 1, 1, 1, 100) &&
        kooker.result().diagnostic() == dust3dDiagnosticSource(),
        "Dust3D intake must reject traversal entries before export")
    var sprite = g4CompressedSpriteFixture()
    assert(kooker.cookAseprite(sprite))
    var spriteResult = kooker.result()
    var png = kooker.sprite().pngBytes()
    assert(spriteResult.accepted() && spriteResult.primaryCount() == 1 &&
        kooker.sprite().frameDuration(0) == 100 &&
        kooker.sprite().sliceCount() == 1 && png.length > 60 &&
        png[0] == 137 && png[1] == 80 && png[2] == 78 && png[3] == 71,
        "Aseprite intake must inflate RGBA cels, parse slices, and emit PNG")
    sprite[206] = sprite[206] + 1
    assert(!kooker.cookAseprite(sprite),
        "Aseprite intake must reject a corrupted zlib checksum")

    var vox = g4SingleVoxelFixture()
    assert(kooker.cookVox(vox, 10, 20, 1, 100))
    var voxResult = kooker.result()
    assert(voxResult.accepted() && voxResult.primaryCount() == 1 &&
        kooker.vox().geometry().vertexCount() == 8 &&
        kooker.vox().geometry().triangleCount() == 12 &&
        voxResult.collisionChecksum() > 0,
        "MagicaVoxel intake must emit canonical geometry and collision")
    vox[63] = 0
    assert(!kooker.cookVox(vox, 10, 20, 1, 100),
        "MagicaVoxel palette index zero must reject")

    var mapText = "{\n\"classname\" \"worldspawn\"\n{\n" +
        "( 0 0 0 ) ( 0 0 1 ) ( 0 1 1 ) stone 0 0 0 1 1\n" +
        "( 64 0 0 ) ( 64 1 0 ) ( 64 1 1 ) stone 0 0 0 1 1\n" +
        "( 0 0 0 ) ( 1 0 0 ) ( 1 0 1 ) stone 0 0 0 1 1\n" +
        "( 0 64 0 ) ( 0 64 1 ) ( 1 64 1 ) stone 0 0 0 1 1\n" +
        "( 0 0 0 ) ( 0 1 0 ) ( 1 1 0 ) stone 0 0 0 1 1\n" +
        "( 0 0 64 ) ( 1 0 64 ) ( 1 1 64 ) stone 0 0 0 1 1\n" +
        "}\n}\n"
    assert(kooker.cookQuakeMap(g4AsciiSource(mapText), 10, 30, 1, 1))
    var mapResult = kooker.result()
    assert(mapResult.accepted() && kooker.quakeMap().entityCount() == 1 &&
        kooker.quakeMap().brushCount() == 1 &&
        kooker.quakeMap().vertexCount() == 8 &&
        kooker.quakeMap().triangleCount() == 12 &&
        mapResult.visibilityChecksum() > 0,
        "Quake map intake must clip and triangulate one convex brush")
    var unsupported = g4AsciiSource("{ { ( 0.5 0 0 ) } }")
    assert(!kooker.cookQuakeMap(unsupported, 10, 31, 1, 1),
        "Quake map subset must reject unsupported decimal planes")
}

test "G4 Blockbench intake preserves character bones and animation", "blockbench" {
    var root = "11111111-1111-4111-8111-111111111111"
    var kooker = BoundedSourceKooker()
    var source = g4AsciiSource(
        g4BlockbenchFixture(
            root, "linear", "\"1.2500000000000002\"", ""))
    assert(kooker.cookBlockbench(source),
        "bounded Blockbench 5.0 character must cook")
    var result = kooker.result()
    var character = kooker.blockbench()
    var bytes = character.canonicalBytes()
    var cubeBase = character.canonicalHeaderWords() +
        character.boneCount() * character.canonicalWord(9)
    var animationBase = cubeBase +
        character.cubeCount() * character.canonicalWord(10)
    var keyframeBase = animationBase +
        character.animationCount() * character.canonicalWord(11)
    assert(result.accepted() &&
        result.sourceKind() == sourceKindBlockbench() &&
        result.primaryCount() == 2 && result.secondaryCount() == 1 &&
        character.boneCount() == 2 && character.cubeCount() == 2 &&
        character.animationCount() == 1 && character.keyframeCount() == 4 &&
        character.rootBoneCount() == 1 && character.maxBoneDepth() == 2 &&
        result.geometryChecksum() > 0 && result.metadataChecksum() > 0 &&
        result.entityChecksum() > 0 && result.visibilityChecksum() > 0 &&
        character.modelFormatChecksum() > 0 &&
        bytes.length == character.canonicalByteLength() &&
        character.canonicalLength() * 4 == bytes.length &&
        character.canonicalHeaderWords() == 20 &&
        character.canonicalWord(0) == blockbenchCanonicalMagic() &&
        bytes[0] == 75 && bytes[1] == 67 && bytes[2] == 72 && bytes[3] == 82 &&
        character.canonicalWord(
            cubeBase + character.canonicalWord(10) + 20) == 1250 &&
        character.canonicalWord(
            keyframeBase + character.canonicalWord(12) + 12) == 1250 &&
        character.reopenCanonical(),
        "cooked KCHR must retain UUID-bound cuboids, hierarchy, and keyframes")

    var unknown = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
    assert(!kooker.cookBlockbench(g4AsciiSource(
            g4BlockbenchFixture(unknown, "linear", "\"1.25\"", ""))) &&
        kooker.result().diagnostic() == blockbenchDiagnosticAnimation(),
        "animation tracks must reference admitted bone UUIDs")
    assert(!kooker.cookBlockbench(g4AsciiSource(
            g4BlockbenchFixture(root, "bezier", "\"1.25\"", ""))) &&
        kooker.result().diagnostic() == blockbenchDiagnosticAnimation(),
        "unsupported interpolation must reject instead of changing semantics")
    assert(!kooker.cookBlockbench(g4AsciiSource(
            g4BlockbenchFixture(
                root, "linear", "\"query.life_time\"", ""))) &&
        kooker.result().diagnostic() == blockbenchDiagnosticAnimation(),
        "Molang expressions must reject from the numeric animation subset")
    assert(!kooker.cookBlockbench(g4AsciiSource(
            g4BlockbenchFixture(root, "linear", "\"1.25\"",
                "\"start_delay\":\"query.time\","))) &&
        kooker.result().diagnostic() == blockbenchDiagnosticAnimation(),
        "Molang clip timing must reject instead of being discarded")
    assert(kooker.cookBlockbench(g4AsciiSource(
            g4BlockbenchDepthFixture(16))) &&
        kooker.blockbench().boneCount() == 16 &&
        kooker.blockbench().maxBoneDepth() == 16,
        "the declared hierarchy-depth boundary must remain admissible")
    assert(!kooker.cookBlockbench(g4AsciiSource(
            g4BlockbenchDepthFixture(17))) &&
        kooker.result().diagnostic() == blockbenchDiagnosticHierarchy(),
        "a hierarchy beyond the bounded depth must reject")
}

test "G4 PNG intake normalizes filtered indexed images", "png" {
    var source = g4FilteredPngFixture()
    assert(source.length == 160,
        "independent PNG fixture must retain its complete chunk stream")
    var kooker = BoundedSourceKooker()
    assert(kooker.cookPng(source),
        "bounded PNG must decode indexed color, transparency, and all filters")
    var result = kooker.result()
    var image = kooker.png()
    var canonical = image.canonicalBytes()
    assert(result.accepted() && result.sourceKind() == sourceKindPng() &&
        result.primaryCount() == 3 && result.secondaryCount() == 5 &&
        result.materialChecksum() == image.pixelChecksum() &&
        result.metadataChecksum() == image.metadataChecksum() &&
        result.visibilityChecksum() == image.canonicalChecksum() &&
        image.sourceColorType() == 3 && image.paletteCount() == 3 &&
        image.chunkCount() == 7 && image.idatCount() == 2 &&
        image.hasSourceAlpha() && image.pixelChecksum() == 639837 &&
        image.rgbaByte(0) == 255 && image.rgbaByte(3) == 255 &&
        image.rgbaByte(4) == 0 && image.rgbaByte(5) == 255 &&
        image.rgbaByte(7) == 128 &&
        image.rgbaByte(8) == 0 && image.rgbaByte(10) == 255 &&
        image.rgbaByte(11) == 0 &&
        image.rgbaByte(24) == 0 && image.rgbaByte(25) == 255 &&
        image.rgbaByte(40) == 255 && image.rgbaByte(43) == 255 &&
        image.rgbaByte(52) == 0 && image.rgbaByte(54) == 255 &&
        image.rgbaByte(55) == 0 &&
        canonical.length == image.canonicalLength() &&
        canonical[0] == 137 && canonical[1] == 80 &&
        canonical[2] == 78 && canonical[3] == 71 &&
        canonical[24] == 8 && canonical[25] == 6 &&
        image.reopenCanonical(),
        "PNG cooking must preserve exact RGBA pixels and reopen canonical RGBA8")

    var pixelChecksum = image.pixelChecksum()
    var canonicalChecksum = image.canonicalChecksum()
    var canonicalLength = image.canonicalLength()
    assert(kooker.cookPng(canonical) &&
        kooker.png().sourceColorType() == 6 &&
        kooker.png().pixelChecksum() == pixelChecksum &&
        kooker.png().canonicalChecksum() == canonicalChecksum &&
        kooker.png().canonicalLength() == canonicalLength,
        "canonical PNG normalization must be idempotent")

    var graySamples = new Int[2]
    graySamples[0] = 17
    graySamples[1] = 34
    var grayTransparency = new Int[2]
    grayTransparency[0] = 0
    grayTransparency[1] = 34
    var graySource = g4MinimalPngFixture(
        0, graySamples, new Int[0], grayTransparency)
    var grayAccepted = kooker.cookPng(graySource)
    assert(grayAccepted,
        "grayscale tRNS fixture must pass bounded PNG intake")
    assert(kooker.png().sourceColorType() == 0,
        "grayscale source color type must survive intake metadata")
    assert(kooker.png().rgbaByte(0) == 17 &&
        kooker.png().rgbaByte(1) == 17 &&
        kooker.png().rgbaByte(2) == 17 &&
        kooker.png().rgbaByte(3) == 255,
        "opaque grayscale sample must expand to RGBA")
    assert(kooker.png().rgbaByte(4) == 34 &&
        kooker.png().rgbaByte(7) == 0,
        "matching grayscale tRNS sample must become transparent")

    var rgbSamples = new Int[6]
    rgbSamples[0] = 1
    rgbSamples[1] = 2
    rgbSamples[2] = 3
    rgbSamples[3] = 4
    rgbSamples[4] = 5
    rgbSamples[5] = 6
    var rgbTransparency = new Int[6]
    rgbTransparency[0] = 0
    rgbTransparency[1] = 4
    rgbTransparency[2] = 0
    rgbTransparency[3] = 5
    rgbTransparency[4] = 0
    rgbTransparency[5] = 6
    assert(kooker.cookPng(g4MinimalPngFixture(
            2, rgbSamples, new Int[0], rgbTransparency)) &&
        kooker.png().sourceColorType() == 2 &&
        kooker.png().rgbaByte(0) == 1 &&
        kooker.png().rgbaByte(1) == 2 &&
        kooker.png().rgbaByte(2) == 3 &&
        kooker.png().rgbaByte(3) == 255 &&
        kooker.png().rgbaByte(4) == 4 &&
        kooker.png().rgbaByte(5) == 5 &&
        kooker.png().rgbaByte(6) == 6 &&
        kooker.png().rgbaByte(7) == 0,
        "truecolor tRNS samples must normalize to exact RGBA alpha")

    var grayAlphaSamples = new Int[4]
    grayAlphaSamples[0] = 10
    grayAlphaSamples[1] = 20
    grayAlphaSamples[2] = 30
    grayAlphaSamples[3] = 40
    assert(kooker.cookPng(g4MinimalPngFixture(
            4, grayAlphaSamples, new Int[0], new Int[0])) &&
        kooker.png().sourceColorType() == 4 &&
        kooker.png().rgbaByte(0) == 10 &&
        kooker.png().rgbaByte(1) == 10 &&
        kooker.png().rgbaByte(2) == 10 &&
        kooker.png().rgbaByte(3) == 20 &&
        kooker.png().rgbaByte(4) == 30 &&
        kooker.png().rgbaByte(5) == 30 &&
        kooker.png().rgbaByte(6) == 30 &&
        kooker.png().rgbaByte(7) == 40,
        "grayscale-alpha samples must normalize without premultiplication")

    var corrupt = g4FilteredPngFixture()
    corrupt[50] = (corrupt[50] + 1) % 256
    assert(!kooker.cookPng(corrupt) &&
        kooker.result().diagnostic() == pngImageDiagnosticCrc(),
        "PNG intake must reject a corrupted chunk CRC")

    var interlaced = g4FilteredPngFixture()
    interlaced[28] = 1
    g4RefreshPngChunkCrc(interlaced, 12, 13)
    assert(!kooker.cookPng(interlaced) &&
        kooker.result().diagnostic() == pngImageDiagnosticHeader(),
        "unsupported Adam7 PNG data must reject at the header boundary")

    var animated = g4FilteredPngFixture()
    animated[73] = 97
    animated[74] = 99
    animated[75] = 84
    animated[76] = 76
    g4RefreshPngChunkCrc(animated, 73, 15)
    assert(!kooker.cookPng(animated) &&
        kooker.result().diagnostic() == pngImageDiagnosticChunk(),
        "APNG control chunks must not silently collapse to a static image")

    assert(kooker.cookAseprite(g4CompressedSpriteFixture()) &&
        kooker.cookPng(kooker.sprite().pngBytes()) &&
        kooker.png().width() == 1 && kooker.png().height() == 1,
        "Aseprite atlas output must use the shared canonical PNG encoder")
}

test "G4 WAV intake normalizes bounded PCM audio", "wav" {
    var monoData = new Int[3]
    monoData[0] = 0
    monoData[1] = 128
    monoData[2] = 255
    var source = g4PcmWavFixture(8, 1, 8000, monoData, true)
    assert(source.length == 72,
        "independent WAV fixture must retain metadata and odd padding")
    var kooker = BoundedSourceKooker()
    assert(kooker.cookWav(source),
        "bounded WAV must accept PCM8 mono with inert metadata chunks")
    var result = kooker.result()
    var audio = kooker.wav()
    var canonical = audio.canonicalBytes()
    assert(result.accepted() && result.sourceKind() == sourceKindWav() &&
        result.materialChecksum() == audio.sampleChecksum() &&
        result.metadataChecksum() == audio.metadataChecksum() &&
        result.visibilityChecksum() == audio.canonicalChecksum() &&
        result.primaryCount() == 3 && result.secondaryCount() == 1 &&
        audio.sampleRate() == 8000 && audio.channelCount() == 1 &&
        audio.sourceBits() == 8 && audio.canonicalBits() == 16 &&
        audio.frameCount() == 3 && audio.chunkCount() == 4 &&
        audio.metadataChunkCount() == 2 &&
        audio.sample(0) == -32768 && audio.sample(1) == 0 &&
        audio.sample(2) == 32512 && canonical.length == 50 &&
        canonical[0] == 82 && canonical[1] == 73 &&
        canonical[2] == 70 && canonical[3] == 70 &&
        canonical[20] == 1 && canonical[22] == 1 &&
        canonical[34] == 16 && canonical[40] == 6 &&
        audio.reopenCanonical(),
        "WAV cooking must strip metadata and emit reopenable PCM16")

    var sampleChecksum = audio.sampleChecksum()
    var canonicalChecksum = audio.canonicalChecksum()
    assert(kooker.cookWav(canonical) &&
        kooker.wav().sourceBits() == 16 &&
        kooker.wav().chunkCount() == 2 &&
        kooker.wav().metadataChunkCount() == 0 &&
        kooker.wav().sampleChecksum() == sampleChecksum &&
        kooker.wav().canonicalChecksum() == canonicalChecksum &&
        kooker.wav().canonicalLength() == 50,
        "canonical WAV normalization must be idempotent")

    var stereoData = new Int[8]
    stereoData[0] = 0
    stereoData[1] = 128
    stereoData[2] = 255
    stereoData[3] = 255
    stereoData[4] = 0
    stereoData[5] = 0
    stereoData[6] = 255
    stereoData[7] = 127
    assert(kooker.cookWav(
            g4PcmWavFixture(16, 2, 48000, stereoData, false)) &&
        kooker.wav().sampleRate() == 48000 &&
        kooker.wav().channelCount() == 2 &&
        kooker.wav().frameCount() == 2 &&
        kooker.wav().sample(0) == -32768 &&
        kooker.wav().sample(1) == -1 &&
        kooker.wav().sample(2) == 0 &&
        kooker.wav().sample(3) == 32767 &&
        kooker.wav().canonicalLength() == 52,
        "PCM16 stereo samples must survive canonical cooking exactly")

    var badHeader = g4PcmWavFixture(8, 1, 8000, monoData, false)
    badHeader[4] = badHeader[4] + 1
    assert(!kooker.cookWav(badHeader) &&
        kooker.result().diagnostic() == wavDiagnosticHeader(),
        "RIFF size mismatches must reject at the header boundary")

    var floatSource = g4PcmWavFixture(8, 1, 8000, monoData, false)
    floatSource[20] = 3
    assert(!kooker.cookWav(floatSource) &&
        kooker.result().diagnostic() == wavDiagnosticFormat(),
        "floating-point WAV must not enter the bounded PCM contract")

    var unknownChunk = g4PcmWavFixture(8, 1, 8000, monoData, false)
    unknownChunk[12] = 115
    assert(!kooker.cookWav(unknownChunk) &&
        kooker.result().diagnostic() == wavDiagnosticChunk(),
        "unknown semantic WAV chunks must reject rather than be ignored")

    var misaligned = g4PcmWavFixture(16, 2, 48000, stereoData, false)
    g4PutLe32(misaligned, 40, 7)
    misaligned[51] = 0
    assert(!kooker.cookWav(misaligned) &&
        kooker.result().diagnostic() == wavDiagnosticData(),
        "PCM data must contain complete interleaved frames")
}

test "trusted hooks subscribe to broader typed domain events" {
    var extensions = BoundedExtensionRegistry(1, 1, 2, 2)
    assert(extensions.registerManifest(7, 1, 2, 1, 1) &&
        extensions.setLoadOrder(7, 1, 1) &&
        extensions.setProvenance(7, 1, 701) &&
        extensions.setSchemas(7, 1, 1, 7) &&
        extensions.grantCapability(
            7, 1, extensionContributionTrustedHookKind()) &&
        extensions.registerContribution(
            7, 1, extensionContributionTrustedHookKind(), 1, 1) &&
        extensions.registerContribution(
            7, 1, extensionContributionTrustedHookKind(), 2, 2),
        "typed hook manifest must declare both static subscriptions")
    var hooks = BoundedTrustedModuleRegistry(2)
    assert(hooks.defineHook(
            extensions, 7, 1, 1, trustedHookPreSimulationPhase()) &&
        hooks.setBudget(7, 1, 1, 1, 1) &&
        hooks.subscribeEvent(
            7, 1, 1, trustedDomainEventPlayerConnected()) &&
        hooks.bindImplementation(
            7, 1, 1, trustedHookImplementationPlayerWelcome(), 1) &&
        hooks.defineHook(
            extensions, 7, 1, 2, trustedHookEditorPhase()) &&
        hooks.setBudget(7, 1, 2, 1, 1) &&
        hooks.subscribeEvent(
            7, 1, 2, trustedDomainEventEditorPublished()) &&
        !hooks.subscribeEvent(
            7, 1, 2, trustedDomainEventLootPickedUp()) &&
        hooks.bindImplementation(
            7, 1, 2, trustedHookImplementationPublicationAudit(), 1) &&
        extensions.seal() && hooks.seal(extensions),
        "hook phase must match each typed domain subscription")
    var runtime = BoundedTrustedHookRuntime(4, 4)
    assert(runtime.bindPublishedGeneration(
            extensions, hooks, 1, hooks.checksum()) &&
        runtime.beginTick(1) &&
        runtime.dispatchEvent(
            extensions, hooks,
            TrustedDomainEvent(
                1, trustedDomainEventPlayerConnected(), 1, 0, 0, 0)) &&
        runtime.dispatchEvent(
            extensions, hooks,
            TrustedDomainEvent(
                2, trustedDomainEventLootPickedUp(), 1, 900, 2, 1)) &&
        !runtime.dispatchEvent(
            extensions, hooks,
            TrustedDomainEvent(
                2, trustedDomainEventEditorPublished(), 0, 2, 1, 3)) &&
        runtime.dispatchEvent(
            extensions, hooks,
            TrustedDomainEvent(
                3, trustedDomainEventEditorPublished(), 0, 2, 1, 3)) &&
        runtime.commandCount() == 1 &&
        runtime.commandKind(0) == trustedHookCommandGrantCurrency() &&
        runtime.commandValue(0) == 1 &&
        runtime.eventCount() == 2 &&
        runtime.eventKind(0) == trustedHookEventPlayerWelcome() &&
        runtime.eventKind(1) == trustedHookEventPublicationAudit() &&
        runtime.markCommandsApplied() && runtime.finishTick(),
        "typed dispatch must execute matching hooks and ignore unsubscribed events")
    var cumulativeBudget = BoundedTrustedHookRuntime(4, 4)
    assert(cumulativeBudget.bindPublishedGeneration(
            extensions, hooks, 1, hooks.checksum()) &&
        cumulativeBudget.beginTick(1) &&
        cumulativeBudget.dispatchEvent(
            extensions, hooks,
            TrustedDomainEvent(
                1, trustedDomainEventPlayerConnected(), 1, 0, 0, 0)) &&
        !cumulativeBudget.dispatchEvent(
            extensions, hooks,
            TrustedDomainEvent(
                2, trustedDomainEventPlayerConnected(), 2, 0, 0, 0)) &&
        cumulativeBudget.diagnostic() == trustedHookRuntimeDiagnosticBudget() &&
        cumulativeBudget.commandCount() == 1 &&
        cumulativeBudget.eventCount() == 1 &&
        cumulativeBudget.markCommandsApplied() &&
        cumulativeBudget.finishTick(),
        "trusted hook budgets must apply cumulatively within one tick")
}

test "external kutter packages load through bounded file envelopes" {
    var descriptor = BoundedExternalKutterDescriptor()
    assert(descriptor.configureProducts(7, 2, 101, 202, 303) &&
        descriptor.addExtension(8, 1, 2, 3, 4, 10, 801, 2, 9) &&
        descriptor.addEnemy(
            8, 1, 2001, 20, 1, enemyDefinitionEliteKind(),
            12, 2, 51, 2, 2, 3, 0, 4000, 91, 6, 5, 0, 0) &&
        descriptor.addHook(
            8, 1, 3001, 10, trustedHookPostSimulationPhase(),
            8, 4, trustedDomainEventEnemyDefeated(),
            trustedHookImplementationEliteBounty(), 1) &&
        descriptor.seal(),
        "external descriptor must seal complete data and hook contracts")
    var payload = descriptor.encodedBytes()
    var files = BoundedContentPackageFileStore(2, 1, 2, 65536)
    var packageValue = BoundedContentPackage(2, 1, 2)
    assert(packageValue.configureHeader(7, 4, 1, 1, 100) &&
        packageValue.addAsset(8, 2001, 3, 1, 811, 812, 15) &&
        packageValue.addChunk(
            1, kutterDescriptorChunkKind(), 0, payload.length,
            files.chunkHashLow(payload, 0, payload.length),
            files.chunkHashHigh(payload, 0, payload.length), 1) &&
        packageValue.seal(),
        "external package must bind its descriptor payload")
    var paths = new String[1]
    paths[0] = "mods/sample.kutter"
    var path = "/tmp/kookie-external-kutter.kpkg"
    assert(files.write(path, packageValue, payload, paths),
        "package file must write bounded words paths and payload")
    var runtime = BoundedExternalPackageRuntime(65536)
    assert(runtime.load(path) && runtime.loaded() && runtime.generation() == 1 &&
        runtime.packageChecksum() == packageValue.checksum() &&
        runtime.extensions().validate() &&
        runtime.definitions().kind(8, 2001) == enemyDefinitionEliteKind() &&
        runtime.hooks().validate(runtime.extensions()),
        "runtime must reconstruct and publish external package registries")
    var hookRuntime = BoundedTrustedHookRuntime(2, 2)
    assert(hookRuntime.bindPublishedGeneration(
            runtime.extensions(), runtime.hooks(),
            runtime.generation(), runtime.hooks().checksum()) &&
        hookRuntime.beginTick(1) &&
        hookRuntime.dispatchEvent(
            runtime.extensions(), runtime.hooks(),
            TrustedDomainEvent(
                1, trustedDomainEventEnemyDefeated(), 1, 2001,
                enemyDefinitionEliteKind(), 1)) &&
        hookRuntime.commandCount() == 1 &&
        hookRuntime.commandValue(0) == 5,
        "externally loaded trusted hooks must execute against published generation")

    var badPaths = new String[1]
    badPaths[0] = "../escape.kutter"
    assert(!files.write(
            "/tmp/kookie-external-traversal.kpkg",
            packageValue, payload, badPaths) &&
        files.diagnostic() == packageFileDiagnosticPath(),
        "package file must reject traversal paths")
    var encodedFile = File(path).readBytes()
    encodedFile[encodedFile.length - 1] =
        encodedFile[encodedFile.length - 1] + 1
    var corruptPath = "/tmp/kookie-external-corrupt.kpkg"
    assert(File(corruptPath).writeBytes(encodedFile) &&
        !runtime.load(corruptPath) && runtime.loaded() &&
        runtime.generation() == 1 &&
        runtime.packageChecksum() == packageValue.checksum() &&
        runtime.definitions().kind(8, 2001) == enemyDefinitionEliteKind() &&
        runtime.hooks().validate(runtime.extensions()),
        "invalid external reload must preserve the active published package")

    var overlapPayload = new Int[payload.length + 4]
    g4Zero(overlapPayload)
    for (var index = 0; index < payload.length; index = index + 1) {
        overlapPayload[index] = payload[index]
    }
    var overlap = BoundedContentPackage(1, 1, 2)
    assert(overlap.configureHeader(7, 4, 1, 1, 100) &&
        overlap.addAsset(8, 2001, 3, 1, 811, 812, 15) &&
        overlap.addChunk(
            1, kutterDescriptorChunkKind(), 0, payload.length,
            files.chunkHashLow(overlapPayload, 0, payload.length),
            files.chunkHashHigh(overlapPayload, 0, payload.length), 1) &&
        overlap.addChunk(
            2, 4, payload.length - 1, 5,
            files.chunkHashLow(overlapPayload, payload.length - 1, 5),
            files.chunkHashHigh(overlapPayload, payload.length - 1, 5), 1) &&
        overlap.seal(),
        "overlap fixture must remain schema-valid before file admission")
    var overlapPaths = new String[2]
    overlapPaths[0] = "mods/sample.kutter"
    overlapPaths[1] = "data/overlap.bin"
    assert(!files.write(
            "/tmp/kookie-external-overlap.kpkg",
            overlap, overlapPayload, overlapPaths) &&
        files.diagnostic() == packageFileDiagnosticChunk(),
        "package file must reject overlapping chunk ranges")
}

test "kutter inspector editors publish atomic undoable products" {
    var workspace = BoundedKutterWorkspace()
    var initialWorld = workspace.worldChecksum()
    var initialCollision = workspace.collisionChecksum()
    var initialNavigation = workspace.navigationChecksum()
    var initialRender = workspace.renderChecksum()
    assert(!workspace.begin(2) &&
        workspace.diagnostic() == kutterWorkspaceDiagnosticRevision() &&
        workspace.revision() == 1 && workspace.generation() == 1,
        "stale editor revisions must leave the published generation unchanged")
    assert(workspace.begin(1) &&
        workspace.stageEntity(101, 20, 30, 40) &&
        workspace.stageAsset(201) &&
        workspace.stageEncounter(301, 12) &&
        workspace.stageItem(401, 55) &&
        workspace.stageSkill(501, 3) &&
        workspace.stageSpawn(601) &&
        workspace.stageWeapon(701) &&
        workspace.stageLoot(801) &&
        workspace.stageCollisionVisible(true) &&
        workspace.stageAiVisible(true) &&
        workspace.stagePlayActive(true) &&
        workspace.publish(),
        "all kutter editor and console mutations must publish in one transaction")
    assert(workspace.revision() == 2 && workspace.generation() == 2 &&
        workspace.entityId() == 101 && workspace.entityX() == 20 &&
        workspace.assetId() == 201 && workspace.encounterBudget() == 12,
        "kutter inspectors must publish their staged entity and asset state")
    assert(workspace.itemPower() == 55 && workspace.skillRank() == 3 &&
        workspace.spawnCount() == 1 && workspace.lastSpawnEnemy() == 601,
        "kutter data editors and spawn console must publish together")
    assert(workspace.weaponGrantCount() == 1 && workspace.lastWeapon() == 701 &&
        workspace.lootRollCount() == 1 && workspace.lastLootTable() == 801,
        "kutter weapon and loot console actions must publish together")
    assert(workspace.collisionVisible() && workspace.aiVisible() &&
        workspace.playActive() && workspace.worldChecksum() != initialWorld &&
        workspace.collisionChecksum() != initialCollision,
        "kutter toggles and world products must advance together")
    assert(workspace.navigationChecksum() != initialNavigation &&
        workspace.renderChecksum() != initialRender,
        "navigation and render products must advance with world products")
    var publishedWorld = workspace.worldChecksum()
    assert(workspace.undo() && workspace.entityId() == 0 &&
        !workspace.playActive() && workspace.generation() == 3 &&
        workspace.redo() && workspace.entityId() == 101 &&
        workspace.playActive() && workspace.worldChecksum() == publishedWorld &&
        workspace.generation() == 4,
        "undo and redo must republish complete kutter snapshots")
    assert(workspace.begin(workspace.revision()) &&
        !workspace.stageItem(0, 1) && workspace.discard() &&
        workspace.entityId() == 101 && workspace.worldChecksum() == publishedWorld,
        "invalid staged edits must preserve the current published snapshot")

    var shell = GameShell()
    assert(shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionActivate()) &&
        shell.screen() == gameShellScreenKutter() &&
        shell.handleAction(gameShellActionActivate()) &&
        shell.kutter().collisionVisible(),
        "main menu must expose the in-engine kutter inspector")
    var frame = FrameStaging(shell.renderVertexCapacity())
    assert(shell.stage(frame, 1) && frame.stagedCount() > 0 &&
        frame.stagedCount() <= shell.renderVertexCapacity() &&
        shell.handleAction(gameShellActionLeft()) &&
        !shell.kutter().collisionVisible() &&
        shell.handleAction(gameShellActionRight()) &&
        shell.kutter().collisionVisible(),
        "kutter surface must render and expose undo redo controls")
}

test "GPU reload waits for upload fences and retained generations" {
    var reload = BoundedGpuReloadCoordinator()
    assert(reload.bindInitial(1, 101, 102, 103, 600, 1) &&
        reload.acquireActive() == 1 && reload.acquireActive() == 1,
        "initial GPU generation must support bounded frame references")
    assert(!reload.stage(0, 2, 201, 202, 203, 700) &&
        reload.diagnostic() == gpuReloadDiagnosticGeneration() &&
        reload.activeGeneration() == 1,
        "reload must revision-check the active GPU generation")
    assert(reload.stage(1, 2, 201, 202, 203, 700) &&
        reload.pendingGeneration() == 2 &&
        reload.markUploaded(2, 5) &&
        !reload.activateAtFrame(2, 2, 4) &&
        reload.diagnostic() == gpuReloadDiagnosticFence() &&
        reload.activeGeneration() == 1,
        "new products must remain pending before their upload fence completes")
    assert(reload.activateAtFrame(2, 2, 5) &&
        reload.activeGeneration() == 2 &&
        reload.retiringGeneration() == 1 &&
        reload.activeGeometryChecksum() == 201 &&
        reload.activeMaterialChecksum() == 202 &&
        reload.activeRenderChecksum() == 203 &&
        reload.activeVertexCount() == 700 &&
        !reload.retire(5) &&
        reload.diagnostic() == gpuReloadDiagnosticReference(),
        "activation must preserve retained old resources until readers release")
    assert(reload.release(1) && reload.release(1) && reload.retire(5) &&
        reload.retiredGeneration() == 1 &&
        reload.retiringGeneration() == 0,
        "completed fences and zero references must permit old GPU retirement")
    assert(reload.stage(2, 3, 301, 302, 303, 800) &&
        reload.cancel(3) && reload.pendingGeneration() == 0 &&
        reload.activeGeneration() == 2,
        "fallible reload preparation must be cancellable before upload")
}

BoundedContentCompatibility g4TransportCompatibility(Int extensionChecksum) {
    var identity = BoundedContentCompatibility()
    assert(identity.configureVersions(7, 4, 901) &&
        identity.configureContent(
            902, extensionChecksum, 904, 905) &&
        identity.configurePublication(1, 1, 906) &&
        identity.seal() && identity.encode(),
        "transport compatibility fixture must seal")
    return identity
}

test "compatibility handshake gates remote gameplay transport" {
    var local = g4TransportCompatibility(903)
    var endpoint = RemoteSessionEndpoint(
        127, 0, 0, 1, 47101, 1, 2, 3, 4)
    var client = RemoteSessionLink(endpoint)
    var host = RemoteSessionLink(RemoteSessionEndpoint(
        127, 0, 0, 1, 47102, 5, 6, 7, 8))
    var session = LoopbackSession(1, 1)
    assert(session.start() &&
        session.addBroadPhaseTriangle(0, 0, 5, 4, 0, 5, 0, 4, 5))
    var snapshot = session.broadPhaseSnapshot(1, 1)
    assert(client.requireCompatibility(local) &&
        host.requireCompatibility(local) &&
        client.connect() && host.connect() &&
        !client.sendSnapshot(snapshot),
        "transport must not admit gameplay before compatibility response")
    var offer = client.compatibilityOffer(1)
    assert(offer.length == compatibilityHandshakeOfferLength() &&
        host.receiveCompatibilityOffer(offer, local),
        "host must decode the exact thirteen-word content identity")
    var response = host.compatibilityResponse()
    assert(response.length == compatibilityHandshakeResponseLength() &&
        client.acceptCompatibilityResponse(response, 1) &&
        client.ready() && client.compatible() &&
        client.compatibilityDiagnostic() == kutterDiagnosticNone() &&
        client.sendSnapshot(snapshot),
        "matching response must open gameplay transport")

    var incompatible = g4TransportCompatibility(999)
    var rejectedClient = RemoteSessionLink(RemoteSessionEndpoint(
        127, 0, 0, 1, 47103, 9, 10, 11, 12))
    var rejectingHost = RemoteSessionLink(RemoteSessionEndpoint(
        127, 0, 0, 1, 47104, 13, 14, 15, 16))
    assert(rejectedClient.requireCompatibility(local) &&
        rejectingHost.requireCompatibility(incompatible) &&
        rejectedClient.connect() && rejectingHost.connect())
    var rejectedOffer = rejectedClient.compatibilityOffer(4)
    assert(rejectingHost.receiveCompatibilityOffer(
            rejectedOffer, incompatible) &&
        rejectedClient.acceptCompatibilityResponse(
            rejectingHost.compatibilityResponse(), 4) &&
        !rejectedClient.ready() && !rejectedClient.compatible() &&
        rejectedClient.compatibilityDiagnostic() ==
            kutterDiagnosticManifest() &&
        !rejectedClient.sendSnapshot(snapshot),
        "mismatched external packages must remain outside gameplay")
    rejectedOffer[17] = rejectedOffer[17] + 1
    var corrupt = BoundedContentCompatibility()
    assert(!decodeCompatibilityHandshakeOffer(rejectedOffer, corrupt),
        "handshake corruption must reject before identity comparison")
}
