import core
import session
import content
import demo
import ui

main() {
    println("KOOKIE G0 session foundation")
    println(tickRate())
    println(roundTripEnvelope(protocolVersion(), 1, 0, 1))

    var resources = ResourceRegistry(2)
    var mesh = resources.acquire(1)
    assert(resources.isValid(mesh), "fresh token must be valid")
    assert(resources.activeCount() == 1, "acquire must consume one slot")
    assert(!resources.isValid(ResourceToken(mesh.slot(), mesh.generation(), 2)), "kind mismatch must reject")
    assert(resources.release(mesh), "live token must release")
    assert(!resources.isValid(mesh), "released token must be stale")
    assert(!resources.release(mesh), "double release must reject")

    var replacement = resources.acquire(1)
    assert(replacement.slot() == mesh.slot(), "allocator should reuse the first free slot")
    assert(replacement.generation() != mesh.generation(), "reuse must advance generation")
    assert(resources.isValid(replacement), "replacement token must be valid")
    println("KOOKIE G0 resource tokens verified")


    var window = WindowStateTracker(1280, 720)
    assert(window.applyFocus(1), "focus event must be accepted")
    assert(window.applyResize(1920, 1080), "positive resize must be accepted")
    assert(!window.applyResize(0, 1080), "zero resize must be rejected")
    assert(window.requestClose(), "close event must be accepted")
    var windowState = window.snapshot()
    assert(windowState.width() == 1920 && windowState.height() == 1080, "resize state must be copied")
    assert(windowState.focused() && windowState.closeRequested(), "focus and close state must be copied")

    var audio = QueuedAudio(2)
    assert(audio.open(), "audio queue must open once")
    assert(audio.queue(11, 80), "audio command must enqueue")
    assert(audio.queue(12, 60), "audio queue must accept capacity")
    assert(!audio.queue(13, 40), "audio queue must reject overflow")
    assert(audio.dequeue(), "audio command must dequeue")
    assert(audio.consumedClip() == 11 && audio.consumedGain() == 80, "audio order must be FIFO")
    assert(audio.close(), "audio queue must close")
    println("KOOKIE G0 scalar adapter contracts verified")

    var staging = FrameStaging(3)
    assert(staging.begin(1), "frame staging must open")
    assert(staging.pushVertex(1, -80, -80, 0, 100), "first vertex must stage")
    assert(staging.pushVertex(1, 80, -80, 100, 100), "second vertex must stage")
    assert(staging.pushVertex(1, 0, 80, 50, 0), "third vertex must stage")
    assert(staging.stagedCount() == 3, "triangle vertex count must stage")
    assert(staging.scalarWrites() == 15, "triangle scalar write count must be measured")
    assert(staging.checksum() == 273, "triangle staging checksum must be stable")
    assert(staging.scalarBudget() == 15, "frame staging budget must be bounded")
    assert(staging.fitsScalarBudget(15) && !staging.fitsScalarBudget(14),
        "frame staging must report budget acceptance")
    assert(staging.publish(), "frame staging must publish")
    assert(staging.retire(1), "published frame must retire")
    var retired = staging.publishedFrame() == 1 && staging.retiredFrame() == 1 && !staging.isOpen()
    assert(retired, "published frame ownership must close")
    var meshStaging = FrameStaging(6)
    assert(meshStaging.begin(2), "quad mesh staging must open")
    assert(meshStaging.pushVertex(1, -80, -80, 0, 100), "quad vertex one must stage")
    assert(meshStaging.pushVertex(1, 80, -80, 100, 100), "quad vertex two must stage")
    assert(meshStaging.pushVertex(1, 80, 80, 100, 0), "quad vertex three must stage")
    assert(meshStaging.pushVertex(1, -80, -80, 0, 100), "quad vertex four must stage")
    assert(meshStaging.pushVertex(1, 80, 80, 100, 0), "quad vertex five must stage")
    assert(meshStaging.pushVertex(1, -80, 80, 0, 0), "quad vertex six must stage")
    assert(meshStaging.stagedCount() == 6 && meshStaging.scalarWrites() == 30,
        "quad mesh must stage six vertices")
    assert(meshStaging.scalarBudget() == 30 && meshStaging.fitsScalarBudget(30),
        "quad mesh must fit its bounded frame budget")
    assert(meshStaging.publish() && meshStaging.retire(2),
        "quad mesh staging must retire")
    println("KOOKIE G0 frame staging verified")
    var clock = FixedStepClock(60, 4)
    assert(clock.advance(16667) == 1, "fixed-step clock must advance one tick")
    assert(clock.tick() == 1 && clock.pendingMicros() == 1, "fixed-step remainder must be retained")
    assert(clock.frameBudgetMicros() == 16667,
        "fixed-step frame budget must be declared")
    assert(clock.advance(-1) == -1, "negative elapsed time must reject")

    var component = IntComponentStore(2)
    assert(component.set(1, 40), "component value must insert")
    assert(component.set(2, 80), "component capacity must accept")
    assert(!component.set(3, 120), "component capacity must reject overflow")
    assert(component.get(1) == 40 && component.activeCount() == 2, "component values must be readable")
    assert(component.remove(1) && !component.has(1), "component value must remove")

    var g1 = G1Demo()
    var g1Passed = g1.run()
    if (!g1Passed) {
        println(g1.failureStep())
    }
    assert(g1Passed, "G1 authoritative shooter scenario must complete")
    println("KOOKIE G1 authoritative shooter verified")

}
test "game shell menus transact display audio and lobby state" {
    var shell = GameShell()
    assert(shell.screen() == gameShellScreenMain() &&
        shell.selection() == 0 && !shell.quitRequested(),
        "game shell must open on a stable main menu")
    assert(shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionActivate()) &&
        shell.screen() == gameShellScreenOptions() &&
        shell.selection() == 0,
        "main menu must enter options through keyboard navigation")
    assert(shell.handleAction(gameShellActionRight()) &&
        shell.resolutionWidth() == 1600 && shell.resolutionHeight() == 900 &&
        shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionRight()) &&
        shell.displayMode() == 1 &&
        shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionLeft()) &&
        shell.effectsVolume() == 70 &&
        shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionLeft()) &&
        shell.musicVolume() == 50 &&
        shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionRight()) &&
        shell.textSize() == 3,
        "options must adjust resolution display audio and readable text")
    assert(shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionActivate()) &&
        shell.displayApplyPending() &&
        shell.acknowledgeDisplayApply(true) &&
        !shell.displayApplyPending() && shell.displayApplyResult() == 1,
        "display changes must complete as an acknowledged transaction")
    var optionsFrame = FrameStaging(shell.renderVertexCapacity())
    assert(shell.stage(optionsFrame, 1) &&
        optionsFrame.stagedCount() > 0 &&
        optionsFrame.stagedCount() <= shell.renderVertexCapacity() &&
        optionsFrame.checksum() != 0 &&
        optionsFrame.retire(1),
        "options menu must publish bounded visible geometry")
    assert(shell.handleAction(gameShellActionBack()) &&
        shell.screen() == gameShellScreenMain() &&
        shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionActivate()) &&
        shell.screen() == gameShellScreenMultiplayer(),
        "back must return to main and multiplayer must remain reachable")
    assert(shell.handleAction(gameShellActionActivate()) &&
        shell.networkRequest() == gameShellNetworkHostRequest() &&
        shell.completeNetworkRequest(gameShellNetworkHostRequest(), true) &&
        shell.networkStatus() == gameShellNetworkHosting() &&
        shell.markNetworkConnected() &&
        shell.networkStatus() == gameShellNetworkConnected(),
        "host flow must expose hosting and connected transitions")
    assert(shell.markNetworkDisconnected() &&
        shell.networkStatus() == gameShellNetworkIdle() &&
        shell.handleAction(gameShellActionActivate()) &&
        shell.completeNetworkRequest(gameShellNetworkHostRequest(), true) &&
        shell.markNetworkConnected(),
        "remote leave must reset state and allow another lobby")
    assert(shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionActivate()) &&
        shell.networkRequest() == gameShellNetworkLeaveRequest() &&
        shell.completeNetworkRequest(gameShellNetworkLeaveRequest(), true) &&
        shell.networkStatus() == gameShellNetworkIdle(),
        "leave must return the lobby to offline state")
    assert(shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionActivate()) &&
        shell.networkEditing() &&
        shell.handleAction(gameShellActionUp()) &&
        shell.addressOne() == 128 &&
        shell.handleAction(gameShellActionRight()) &&
        shell.handleAction(gameShellActionDown()) &&
        shell.addressTwo() == 255 &&
        shell.handleAction(gameShellActionActivate()) &&
        !shell.networkEditing(),
        "address editor must expose bounded octet navigation")
    assert(shell.handleAction(gameShellActionDown()) &&
        shell.handleAction(gameShellActionActivate()) &&
        shell.networkEditing() &&
        shell.handleAction(gameShellActionRight()) &&
        shell.port() == 47201 &&
        shell.handleAction(gameShellActionActivate()) &&
        !shell.networkEditing(),
        "port editor must support coarse and bounded changes")
}

test "shooter HUD stages semantic combat feedback hierarchy" {
    var hud = ShooterHud(100, 30)
    assert(hud.renderVertexCount() == 372,
        "HUD geometry must retain a fixed bounded budget")
    var frame = FrameStaging(hud.renderVertexCount())
    assert(hud.update(100, 30, 0, 1, true) &&
        hud.updateEncounterReplication(0, 0, true, 1, 1) &&
        hud.stage(frame, 1, 9) &&
        frame.stagedCount() == hud.renderVertexCount(),
        "ready HUD must stage panels icons crosshair network and encounter status")
    var readyChecksum = frame.checksum()
    assert(frame.retire(1))

    var outgoing = ImpactPresentationEvent(
        1, 1, 1, 3, 0, 0, 0, 5, true, 201, 100)
    assert(hud.presentImpact(1, outgoing, 2) &&
        hud.update(100, 30, 0, 2, true) &&
        hud.updateThreatStatus(0, 0, enemyDefinitionBossKind()) &&
        hud.stage(frame, 2, 9) &&
        frame.checksum() != readyChecksum &&
        hud.hitFeedbackActive() && hud.killFeedbackActive() &&
        !hud.damageFeedbackActive() && hud.lastImpactSequence() == 1,
        "confirmed kill must stage structural hit and kill markers")
    assert(frame.retire(2))
    assert(!hud.presentImpact(1, outgoing, 3),
        "duplicate impact presentation must reject")

    assert(hud.update(100, 30, 0, 20, true) &&
        hud.updateThreatStatus(0, 0, 0) &&
        hud.stage(frame, 3, 9) &&
        frame.checksum() == readyChecksum &&
        !hud.hitFeedbackActive() && !hud.killFeedbackActive(),
        "combat markers must expire back to the stable ready HUD")
    assert(frame.retire(3))

    var incoming = ImpactPresentationEvent(
        2, 1, 3, 1, 0, 0, 0, 20, false, 201, 70)
    assert(hud.presentImpact(1, incoming, 21) &&
        hud.update(20, 3, 3, 21, false) &&
        hud.updateEncounterReplication(3, 2, false, 2, 2) &&
        hud.updateThreatStatus(2, 1, 0) &&
        hud.stage(frame, 4, 9) &&
        hud.damageFeedbackActive() && !hud.hitFeedbackActive() &&
        !hud.killFeedbackActive() &&
        hud.health() == 20 && hud.ammunition() == 3 &&
        hud.enemies() == 3 && hud.encounterRemaining() == 2 &&
        !hud.remoteConnected() && hud.remoteGeneration() == 2 &&
        hud.remoteStateSequence() == 2 &&
        frame.xAt(217) == 18 && frame.yAt(218) == 72 &&
        frame.xAt(224) == 13 && frame.yAt(224) == 78 &&
        frame.xAt(230) == 18 && frame.yAt(230) == 78 &&
        frame.xAt(235) == -18 && frame.xAt(240) == 20 &&
        hud.eliteThreats() == 2 && hud.bossThreats() == 1 &&
        hud.defeatedThreatKind() == 0 &&
        hud.tick() == 21 && !hud.focused(),
        "HUD must distinguish incoming damage disconnected state and encounter load")
    assert(frame.retire(4))
    assert(hud.update(20, 3, 3, 40, false) &&
        hud.stage(frame, 5, 9) &&
        !hud.damageFeedbackActive() &&
        hud.health() == 20 && hud.ammunition() == 3 &&
        hud.enemies() == 3 && !hud.focused(),
        "damage warning must expire without changing critical status")
    var disconnectedChecksum = frame.checksum()
    assert(frame.retire(5))
    assert(hud.updateEncounterReplication(3, 2, true, 3, 3) &&
        !hud.updateEncounterReplication(3, 2, false, 3, 3) &&
        hud.stage(frame, 6, 9) &&
        frame.checksum() != disconnectedChecksum &&
        hud.remoteConnected() && hud.remoteGeneration() == 3,
        "connection status must change shape and reject duplicate state")
    assert(frame.retire(6))
    assert(hud.updateKutterPublication(1, 0, 0, false) &&
        hud.stage(frame, 7, 9) &&
        frame.xAt(150) == -91 && frame.yAt(150) == 70 &&
        frame.yAt(162) == 73,
        "kutter source stage must expose source but not validation geometry")
    var kutterStagedChecksum = frame.checksum()
    assert(frame.retire(7))
    assert(hud.updateKutterPublication(2, 0, 0, false) &&
        hud.stage(frame, 8, 9) &&
        frame.checksum() != kutterStagedChecksum &&
        frame.yAt(162) == 77,
        "kutter validation stage must expand the validation diamond")
    assert(frame.retire(8))
    assert(hud.updateKutterPublication(3, 1, 0, true) &&
        hud.stage(frame, 9, 9) &&
        hud.kutterStatus() == 3 && hud.kutterGeneration() == 1 &&
        hud.kutterDiagnostic() == 0 && hud.kutterCompatible() &&
        frame.xAt(181) == -60 && frame.yAt(181) == 75 &&
        frame.xAt(186) == -48 && frame.yAt(186) == 72 &&
        frame.xAt(192) == -42 && frame.yAt(192) == 68 &&
        frame.xAt(194) == -40 && frame.yAt(194) == 78,
        "published kutter content must stage a structural compatibility plus")
    var kutterPublishedChecksum = frame.checksum()
    assert(frame.retire(9))
    assert(!hud.updateKutterPublication(3, 1, 1, true) &&
        hud.stage(frame, 10, 9) &&
        frame.checksum() == kutterPublishedChecksum,
        "invalid publication feedback must reject atomically")
    assert(frame.retire(10))
    assert(hud.updateKutterPublication(4, 1, 10, false) &&
        hud.stage(frame, 11, 9) &&
        frame.checksum() != kutterPublishedChecksum &&
        hud.kutterStatus() == 4 && hud.kutterDiagnostic() == 10 &&
        !hud.kutterCompatible() &&
        frame.xAt(186) == -42 && frame.yAt(186) == 70 &&
        frame.yAt(192) == 67,
        "rejected kutter content must stage a structural exclamation marker")
    assert(frame.retire(11))



    var undersized = FrameStaging(hud.renderVertexCount() - 1)
    assert(!hud.stage(undersized, 1, 9),
        "HUD staging must fail closed below its declared geometry budget")
    assert(hud.updateInventoryStatus(7, 8, true) &&
        hud.updateSkillStatus(2, 60, 100) &&
        hud.updateWorldLootStatus(2, 3) &&
        hud.stage(frame, 12, 9) &&
        frame.stagedCount() == hud.renderVertexCount() &&
        hud.inventoryItems() == 7 && hud.inventoryCapacity() == 8 &&
        hud.equipmentReady() && hud.skillRank() == 2 &&
        hud.skillExperience() == 60 && hud.skillGoal() == 100 &&
        hud.worldLootCount() == 2 && hud.worldLootRank() == 3,
        "G3 build status must stage inventory equipment skill and ranked loot")
    var buildChecksum = frame.checksum()
    assert(frame.retire(12))
    assert(!hud.updateInventoryStatus(9, 8, false) &&
        !hud.updateSkillStatus(-1, 0, 100) &&
        !hud.updateWorldLootStatus(0, 3) &&
        !hud.updateThreatStatus(-1, 0, 0) &&
        hud.stage(frame, 13, 9) &&
        frame.checksum() == buildChecksum,
        "invalid build status must reject without partially changing the HUD")
    assert(frame.retire(13))
}


test "G2 gameplay wire validates commands and authoritative state" {
    assert(maximumSessionTransportWords() ==
            12 + maximumSessionTransportTriangles() * 9 &&
        20 + maximumEnemyEncounterStateEnemies() *
            enemyEncounterStateEntryWidth() <=
            maximumSessionTransportWords(),
        "transport capacity must fit arena and encounter snapshots")
    var command = newGameplayCommandMessage(
        2, 3, 4, gameplayFireAction(), 5, 20, 0, 2)
    assert(validGameplayCommandMessage(command) &&
        gameplayCommandPlayer(command) == 2 &&
        gameplayCommandTick(command) == 3 &&
        gameplayCommandSequence(command) == 4 &&
        gameplayCommandAction(command) == gameplayFireAction() &&
        gameplayCommandValue(command, 0) == 5 &&
        gameplayCommandGeneration(command) == 2,
        "gameplay commands must round-trip bounded identity and action data")
    command[6] = 6
    assert(!validGameplayCommandMessage(command),
        "gameplay commands must reject checksum-breaking mutation")
    var inputHistory = NetcodeInputHistory(3)
    assert(inputHistory.push(10, 1, 1, 0) &&
        inputHistory.push(11, 2, 0, 1) &&
        inputHistory.push(12, 3, -1, 0) &&
        inputHistory.count() == 3 &&
        inputHistory.latestSequence() == 3,
        "input history must retain a bounded ordered command window")
    var inputWords = inputHistory.commandWords()
    var inputBundle = newGameplayInputBundleMessage(
        2, 1, 4, inputWords)
    assert(inputWords.length == 12,
        "input history must flatten three commands")
    assert(validGameplayInputBundleMessage(inputBundle),
        "input bundles must pass typed validation")
    assert(gameplayInputBundleCount(inputBundle) == 3 &&
        gameplayInputBundleValue(inputBundle, 1, 0) == 11 &&
        gameplayInputBundleValue(inputBundle, 1, 3) == 1 &&
        gameplayInputBundleSnapshotAck(inputBundle) == 4,
        "input bundles must carry redundant fixed-tick commands and snapshot ACKs")
    inputBundle[10] = inputBundle[10] + 1
    assert(!validGameplayInputBundleMessage(inputBundle),
        "input bundles must reject checksum corruption")
    assert(inputHistory.acknowledge(2) &&
        inputHistory.count() == 1 &&
        inputHistory.sequenceAt(0) == 3 &&
        !inputHistory.acknowledge(8),
        "input history must retire acknowledged commands and reject future ACKs")
    var inputAck = newGameplayInputAckMessage(12, 3, 7)
    assert(validGameplayInputAckMessage(inputAck) &&
        gameplayInputAckSequence(inputAck) == 3 &&
        gameplayInputAckSnapshotSequence(inputAck) == 7,
        "input ACKs must be typed and checksummed")
    var snapshots = NetcodeSnapshotWindow()
    assert(snapshots.accept(10, 1, 100) &&
        snapshots.accept(12, 2, 140) &&
        snapshots.sample(11) == 120 &&
        snapshots.accept(12, 3, 150) &&
        snapshots.count() == 2 &&
        snapshots.latestSequence() == 3 &&
        snapshots.sample(12) == 150 &&
        !snapshots.accept(12, 2, 140) &&
        !snapshots.accept(11, 4, 110),
        "snapshot window must interpolate ordered samples and replace same-tick revisions")


    var state = newGameplayStateMessage(3, 4, true, 2, 5, 0, 2)
    assert(setGameplayStateProgression(state, 1, true, 7) &&
        setGameplayStateReplication(state, 4, 8, 25) &&
        setGameplayStateConnection(
            state, true, 2, 0, gameplayFireDiagnostic()) &&
        sealGameplayStateMessage(state) &&
        validGameplayStateMessage(state) &&
        gameplayStateAccepted(state) &&
        gameplayStateInteractionRevision(state) == 2 &&
        gameplayStateCombatActor(state) == 5 &&
        gameplayStateCombatHealth(state) == 0 &&
        gameplayStateSecretCount(state) == 1 &&
        gameplayStateLevelCompleted(state) &&
        gameplayStatePlayerPosition(state, 1) == 4 &&
        gameplayStatePlayerPosition(state, 2) == 8 &&
        gameplayStateCurrency(state) == 25 &&
        gameplayStateConnected(state) &&
        gameplayStateConnectionGeneration(state) == 2 &&
        gameplayStateDisconnectReason(state) == 0 &&
        gameplayStateDiagnostic(state) == gameplayFireDiagnostic() &&
        gameplayStatePlayer(state) == 2 &&
        gameplayStateInteractionMask(state) == 7,
        "gameplay state must expose authoritative progression combat and lifecycle")
    state[19] = state[19] + 1
    assert(!validGameplayStateMessage(state),
        "gameplay state must reject checksum corruption")

    var encounter = newEnemyEncounterStateMessage(7, 9, 4, 1, 3, 2)
    assert(encounter.length <= maximumSessionTransportWords() &&
        setEnemyEncounterStateImpact(
            encounter, 12, 1, 1, 4,
            30, 2, -7, 6, true, 201, 100) &&
        setEnemyEncounterStateEntry(
            encounter, 0, 3, 1, 4, 1, 8, 10, 0, 4) &&
        setEnemyEncounterStateEntry(
            encounter, 1, 4, 2, 7, 1, 0, 30, 2, -7) &&
        sealEnemyEncounterStateMessage(encounter) &&
        validEnemyEncounterStateMessage(encounter) &&
        enemyEncounterStateSequence(encounter) == 9 &&
        enemyEncounterStateEncounterId(encounter) == 4 &&
        enemyEncounterStateActiveCount(encounter) == 1 &&
        enemyEncounterStateRemainingBudget(encounter) == 3 &&
        enemyEncounterStateEnemyCount(encounter) == 2 &&
        enemyEncounterStateEnemyId(encounter, 0) == 3 &&
        enemyEncounterStateEnemyHealth(encounter, 0) == 8 &&
        enemyEncounterStateEnemyState(encounter, 1) == 7 &&
        enemyEncounterStateEnemyPositionZ(encounter, 1) == -7,
        "encounter wire must preserve bounded authoritative enemy state")
    var replicatedImpact = enemyEncounterStateImpact(encounter)
    assert(replicatedImpact.sequence() == 12 &&
        replicatedImpact.sourceId() == 1 &&
        replicatedImpact.targetId() == 4 &&
        replicatedImpact.applied() == 6 &&
        replicatedImpact.died() &&
        replicatedImpact.clip() == 201 &&
        replicatedImpact.gain() == 100,
        "encounter wire must preserve latest confirmed impact feedback")
    encounter[encounter.length - 1] =
        encounter[encounter.length - 1] + 1
    assert(!validEnemyEncounterStateMessage(encounter),
        "encounter state must reject checksum corruption")
}

test "bounded content package schema and identity" {
    var contentPackage = BoundedContentPackage(2, 2, 3)
    assert(contentPackage.configureHeader(7, 3, 11, 1, 100),
        "content package header must validate")
    assert(contentPackage.addAsset(10, 100, 1, 4, 111, 222, 3),
        "content package must accept the first stable asset")
    assert(contentPackage.addAsset(10, 200, 2, 4, 333, 444, 5),
        "content package must accept sorted stable assets")
    assert(!contentPackage.addAsset(10, 150, 1, 4, 1, 1, 1),
        "content package must reject non-canonical asset order")
    assert(contentPackage.addDependency(10, 100, 4, 555, 666),
        "content package must accept dependencies")
    assert(contentPackage.addChunk(1, 1, 0, 4096, 777, 888, 4) &&
        contentPackage.addChunk(2, 2, 4096, 8192, 999, 1000, 4),
        "content package must accept bounded chunks")
    assert(contentPackage.seal() && contentPackage.validate() &&
        contentPackage.checksum() > 0,
        "content package must seal with a deterministic identity")
    var checksum = contentPackage.checksum()
    assert(contentPackage.encode() &&
        contentPackage.encodedLength() == 11 + 2 * 7 + 1 * 5 + 2 * 7,
        "content package wire length must be canonical")
    var wire = new Int[contentPackage.encodedLength()]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = contentPackage.encodedWord(index)
    }
    var restored = BoundedContentPackage(2, 2, 3)
    assert(restored.decode(wire) && restored.validate() &&
        restored.checksum() == checksum &&
        restored.identity().contentVersion() == 11 &&
        restored.assetCount() == 2 &&
        restored.dependencyCount() == 1 &&
        restored.chunkCount() == 2,
        "content package wire must round-trip identity and bounded records")
    wire[10] = wire[10] + 1
    assert(!restored.decode(wire),
        "content package must reject a tampered identity checksum")
    var invalid = BoundedContentPackage(1, 1, 1)
    assert(invalid.configureHeader(1, 1, 1, 1, 1) &&
        invalid.addAsset(1, 1, 1, 1, 0, 0, 1) &&
        !invalid.addChunk(1, 1, 1000000000, 1, 1, 1, 1),
        "content package must reject overflowing chunk ranges")
}

test "bounded extensions resolve capabilities and enemy definitions" {
    var extensions = BoundedExtensionRegistry(2, 2, 3, 3)
    assert(extensions.registerManifest(1, 1, 1, 1, 1) &&
        extensions.setLoadOrder(1, 1, 10) &&
        extensions.setProvenance(1, 1, 101) &&
        extensions.setSchemas(1, 1, 0, 0) &&
        extensions.registerManifest(7, 1, 1, 2, 4) &&
        extensions.setLoadOrder(7, 1, 20) &&
        extensions.setProvenance(7, 1, 701) &&
        extensions.setSchemas(7, 1, 1, 2) &&
        extensions.addDependency(7, 1, 1, 1),
        "extension manifests must declare identity policy and dependency order")
    assert(!extensions.registerContribution(
            7, 1, extensionContributionEnemyDefinitionKind(), 1001, 20) &&
        extensions.lastDiagnostic() == extensionDiagnosticCapability() &&
        extensions.contributionCount() == 0,
        "registry contributions must fail atomically without capability")
    assert(extensions.grantCapability(
            7, 1, extensionContributionEnemyDefinitionKind()) &&
        extensions.registerContribution(
            7, 1, extensionContributionEnemyDefinitionKind(), 1001, 20) &&
        extensions.registerContribution(
            7, 1, extensionContributionEnemyDefinitionKind(), 1002, 10) &&
        !extensions.registerContribution(
            7, 1, extensionContributionEnemyDefinitionKind(), 1002, 30) &&
        extensions.lastDiagnostic() == extensionDiagnosticConflict() &&
        extensions.contributionCount() == 2,
        "capability grants must bound contributions and reject conflicts")
    assert(extensions.seal() && extensions.validate() &&
        extensions.checksum() > 0 &&
        extensions.orderedContributionPublicId(0) == 1002 &&
        extensions.orderedContributionPublicId(1) == 1001 &&
        !extensions.grantCapability(7, 1, 2) &&
        extensions.lastDiagnostic() == extensionDiagnosticSealed(),
        "sealed extension resolution must be deterministic and immutable")

    var definitions = BoundedEnemyDefinitionRegistry(2)
    assert(definitions.define(
            7, 1001, 1, enemyDefinitionEliteKind()) &&
        definitions.setCombat(7, 1001, 7, 0, 41) &&
        definitions.setBehavior(7, 1001, 1, 1, 1) &&
        definitions.setCritical(7, 1001, 0) &&
        definitions.setLoot(7, 1001, 800, 77, 4) &&
        definitions.setRankCurrency(
            7, 1001, enemyDefinitionEliteKind(), 0),
        "elite definition must declare combat behavior and ranked loot")
    assert(definitions.define(
            7, 1002, 1, enemyDefinitionBossKind()) &&
        definitions.setCombat(7, 1002, 22, 0, 41) &&
        definitions.setBehavior(7, 1002, 3, 1, 1) &&
        definitions.setCritical(7, 1002, 1) &&
        definitions.setLoot(7, 1002, 800, 88, 5) &&
        !definitions.setRankCurrency(7, 1002, 2, 50) &&
        definitions.setRankCurrency(
            7, 1002, enemyDefinitionBossKind(), 50) &&
        definitions.setProgression(7, 1002, 30, 100),
        "boss definition must reject a mismatched reward rank atomically")
    assert(definitions.seal() && definitions.validate() &&
        definitions.checksum() > 0 &&
        definitions.stableId(7, 1001, 100) == 900 &&
        definitions.stableId(7, 1002, 101) == 901 &&
        definitions.kind(7, 1002) == enemyDefinitionBossKind() &&
        definitions.currency(7, 1002) == 50,
        "sealed enemy definitions must preserve deterministic spawn rules")
}

test "G4 kutter publication and trusted execution are bounded" {
    var extensions = BoundedExtensionRegistry(2, 2, 4, 4)
    assert(extensions.registerManifest(1, 1, 2, 1, 1) &&
        extensions.setLoadOrder(1, 1, 10) &&
        extensions.setProvenance(1, 1, 101) &&
        extensions.setSchemas(1, 1, 1, 7) &&
        extensions.grantCapability(
            1, 1, extensionContributionTrustedHookKind()) &&
        extensions.registerContribution(
            1, 1, extensionContributionTrustedHookKind(), 110, 20) &&
        extensions.registerManifest(8, 1, 2, 3, 4) &&
        extensions.setLoadOrder(8, 1, 20) &&
        extensions.setProvenance(8, 1, 801) &&
        extensions.setSchemas(8, 1, 2, 9) &&
        extensions.addDependency(8, 1, 1, 1) &&
        extensions.grantCapability(
            8, 1, extensionContributionEnemyDefinitionKind()) &&
        extensions.grantCapability(
            8, 1, extensionContributionTrustedHookKind()) &&
        extensions.registerContribution(
            8, 1, extensionContributionEnemyDefinitionKind(), 2001, 20) &&
        extensions.registerContribution(
            8, 1, extensionContributionTrustedHookKind(), 3001, 10),
        "G4 manifests must declare data and statically compiled hook capabilities")

    var hooks = BoundedTrustedModuleRegistry(2)
    assert(hooks.defineHook(
            extensions, 8, 1, 3001, trustedHookPostSimulationPhase()) &&
        hooks.setBudget(8, 1, 3001, 8, 4) &&
        hooks.subscribeEvent(
            8, 1, 3001, trustedDomainEventEnemyDefeated()) &&
        hooks.bindImplementation(
            8, 1, 3001, trustedHookImplementationEliteBounty(), 1) &&
        hooks.defineHook(
            extensions, 1, 1, 110, trustedHookPreSimulationPhase()) &&
        hooks.setBudget(1, 1, 110, 4, 2) &&
        hooks.subscribeEvent(
            1, 1, 110, trustedDomainEventSessionStarted()) &&
        hooks.bindImplementation(
            1, 1, 110, trustedHookImplementationSessionAudit(), 1) &&
        extensions.seal() && extensions.apiCompatible(2) &&
        extensions.networkSchemaChecksum() > 0 &&
        hooks.seal(extensions) && hooks.validate(extensions) &&
        hooks.orderedHookNamespace(extensions, 0) == 1 &&
        hooks.orderedHookOwner(extensions, 0) == 1 &&
        hooks.orderedHookId(extensions, 0) == 110 &&
        hooks.orderedHookNamespace(extensions, 1) == 8 &&
        hooks.orderedHookOwner(extensions, 1) == 1 &&
        hooks.orderedHookId(extensions, 1) == 3001 &&
        hooks.orderedHookCommandBudget(extensions, 1) == 8 &&
        hooks.orderedHookEventBudget(extensions, 1) == 4 &&
        hooks.orderedHookImplementation(extensions, 0) ==
            trustedHookImplementationSessionAudit() &&
        hooks.orderedHookImplementation(extensions, 1) ==
            trustedHookImplementationEliteBounty(),
        "trusted hooks must resolve namespaced dependency-first implementations")
    var hookModuleChecksum = hooks.checksum()

    var lowBudgetHooks = BoundedTrustedModuleRegistry(2)
    assert(lowBudgetHooks.defineHook(
            extensions, 8, 1, 3001, trustedHookPostSimulationPhase()) &&
        lowBudgetHooks.setBudget(8, 1, 3001, 1, 1) &&
        lowBudgetHooks.subscribeEvent(
            8, 1, 3001, trustedDomainEventEnemyDefeated()) &&
        lowBudgetHooks.bindImplementation(
            8, 1, 3001, trustedHookImplementationEliteBounty(), 1) &&
        lowBudgetHooks.defineHook(
            extensions, 1, 1, 110, trustedHookPreSimulationPhase()) &&
        lowBudgetHooks.setBudget(1, 1, 110, 1, 0) &&
        lowBudgetHooks.subscribeEvent(
            1, 1, 110, trustedDomainEventSessionStarted()) &&
        !lowBudgetHooks.bindImplementation(
            1, 1, 110, trustedHookImplementationEliteBounty(), 1) &&
        !lowBudgetHooks.bindImplementation(
            1, 1, 110, trustedHookImplementationSessionAudit(), 2) &&
        lowBudgetHooks.bindImplementation(
            1, 1, 110, trustedHookImplementationSessionAudit(), 1) &&
        lowBudgetHooks.seal(extensions),
        "trusted hook bindings must reject wrong phases and binary versions")
    var lowBudgetModuleChecksum = lowBudgetHooks.checksum()
    var budgetRuntime = BoundedTrustedHookRuntime(2, 2)
    assert(budgetRuntime.bindPublishedGeneration(
            extensions, lowBudgetHooks, 1, lowBudgetModuleChecksum) &&
        budgetRuntime.beginTick(1) &&
        !budgetRuntime.dispatchEvent(
            extensions, lowBudgetHooks,
            TrustedDomainEvent(
                1, trustedDomainEventSessionStarted(), 0, 0, 0, 0)) &&
        budgetRuntime.diagnostic() == trustedHookRuntimeDiagnosticBudget() &&
        budgetRuntime.commandCount() == 0 &&
        budgetRuntime.eventCount() == 0 &&
        budgetRuntime.finishTick(),
        "hook budget rejection must leave the tick output empty")

    var capacityRuntime = BoundedTrustedHookRuntime(1, 1)
    assert(capacityRuntime.bindPublishedGeneration(
            extensions, hooks, 1, hookModuleChecksum) &&
        capacityRuntime.beginTick(1) &&
        capacityRuntime.dispatchEvent(
            extensions, hooks,
            TrustedDomainEvent(
                1, trustedDomainEventSessionStarted(), 0, 0, 0, 0)) &&
        !capacityRuntime.dispatchEvent(
            extensions, hooks,
            TrustedDomainEvent(
                2, trustedDomainEventEnemyDefeated(), 1, 100,
                enemyDefinitionEliteKind(), 0)) &&
        capacityRuntime.diagnostic() ==
            trustedHookRuntimeDiagnosticCapacity() &&
        capacityRuntime.commandCount() == 0 &&
        capacityRuntime.eventCount() == 1 &&
        capacityRuntime.finishTick(),
        "hook capacity rejection must preserve prior phase output atomically")

    var executionRuntime = BoundedTrustedHookRuntime(2, 2)
    var executionSession = LoopbackSession(2, 2)
    assert(executionSession.start() &&
        executionSession.connectPlayer() == 1 &&
        executionSession.connectPlayer() == 2 &&
        executionSession.setPlayerCurrency(1, 999998) &&
        executionRuntime.bindPublishedGeneration(
            extensions, hooks, 1, hookModuleChecksum) &&
        executionRuntime.boundGeneration() == 1 &&
        executionRuntime.beginTick(1) &&
        !executionRuntime.dispatchEvent(
            extensions, lowBudgetHooks,
            TrustedDomainEvent(
                1, trustedDomainEventSessionStarted(), 0, 0, 0, 0)) &&
        executionRuntime.diagnostic() ==
            trustedHookRuntimeDiagnosticRegistry() &&
        executionRuntime.commandCount() == 0 &&
        executionRuntime.eventCount() == 0 &&
        executionRuntime.dispatchEvent(
            extensions, hooks,
            TrustedDomainEvent(
                1, trustedDomainEventSessionStarted(), 0, 0, 0, 0)) &&
        executionRuntime.dispatchEvent(
            extensions, hooks,
            TrustedDomainEvent(
                2, trustedDomainEventEnemyDefeated(), 1, 100,
                enemyDefinitionEliteKind(), 0)) &&
        executionRuntime.commandCount() == 1 &&
        executionRuntime.commandKind(0) ==
            trustedHookCommandGrantCurrency() &&
        executionRuntime.commandValue(0) == 4 &&
        executionRuntime.eventCount() == 2 &&
        executionRuntime.eventKind(1) == trustedHookEventEliteBounty() &&
        !executionSession.applyTrustedHookCommands(executionRuntime) &&
        executionSession.playerCurrency(1) == 999998 &&
        executionSession.setPlayerCurrency(1, 0) &&
        executionSession.applyTrustedHookCommands(executionRuntime) &&
        executionSession.playerCurrency(1) == 4 &&
        !executionSession.applyTrustedHookCommands(executionRuntime) &&
        executionRuntime.finishTick() &&
        executionRuntime.lastCompletedTick() == 1 &&
        executionRuntime.executionChecksum() > 0 &&
        !executionRuntime.bindPublishedGeneration(
            extensions, hooks, 1, hookModuleChecksum) &&
        !executionRuntime.beginTick(1) &&
        executionRuntime.diagnostic() ==
            trustedHookRuntimeDiagnosticState(),
        "trusted hook commands must apply once without partial overflow")

    var definitions = BoundedEnemyDefinitionRegistry(1)
    assert(definitions.define(
            8, 2001, 1, enemyDefinitionEliteKind()) &&
        definitions.setCombat(8, 2001, 12, 2, 51) &&
        definitions.setBehavior(8, 2001, 2, 2, 3) &&
        definitions.setCritical(8, 2001, 0) &&
        definitions.setLoot(8, 2001, 4000, 91, 6) &&
        definitions.setRankCurrency(
            8, 2001, enemyDefinitionEliteKind(), 5) &&
        definitions.seal(),
        "kutter data mod must seal a complete distinct enemy definition")

    var firstPackage = BoundedContentPackage(1, 1, 1)
    assert(firstPackage.configureHeader(7, 4, 1, 1, 100) &&
        firstPackage.addAsset(8, 2001, 3, 1, 811, 812, 15) &&
        firstPackage.addChunk(1, 9, 0, 64, 813, 814, 1) &&
        firstPackage.seal(),
        "kooker output must bind stable content and chunk identity")
    var incompleteHooks = BoundedTrustedModuleRegistry(2)
    var invalidModulePublication = BoundedKutterPublication()
    assert(invalidModulePublication.begin(0, 1) &&
        invalidModulePublication.stagePackage(firstPackage, 7) &&
        !invalidModulePublication.stageExtensions(
            extensions, incompleteHooks, 2) &&
        invalidModulePublication.diagnostic() == kutterDiagnosticModule(),
        "kutter publication must diagnose an incomplete trusted module registry")
    var incompatibleApiPublication = BoundedKutterPublication()
    assert(incompatibleApiPublication.begin(0, 1) &&
        incompatibleApiPublication.stagePackage(firstPackage, 7) &&
        !incompatibleApiPublication.stageExtensions(extensions, hooks, 3) &&
        incompatibleApiPublication.diagnostic() == kutterDiagnosticApi(),
        "kutter publication must diagnose an incompatible extension API")


    var cache = BoundedGenerationCache(2)
    var publication = BoundedKutterPublication()
    assert(publication.begin(0, 1) &&
        publication.stagePackage(firstPackage, 7) &&
        publication.stageExtensions(extensions, hooks, 2) &&
        publication.stageDefinitions(definitions) &&
        publication.stageProducts(
            101, 201, 301, firstPackage.checksum()) &&
        publication.status() == kutterPublicationStagedStatus() &&
        publication.validate(cache) &&
        publication.status() == kutterPublicationValidatedStatus() &&
        publication.publish(cache) &&
        publication.status() == kutterPublicationPublishedStatus() &&
        publication.activeGeneration() == 1 &&
        cache.activeGeneration() == 1 &&
        cache.generationRevision(1) == 1,
        "validated package manifests definitions and products must publish atomically")

    var active = publication.activeCompatibility()
    assert(active.encode() && active.encodedLength() == 13,
        "published multiplayer compatibility must encode a bounded exact identity")
    var compatibilityWire = new Int[active.encodedLength()]
    for (var index = 0; index < compatibilityWire.length; index = index + 1) {
        compatibilityWire[index] = active.encodedWord(index)
    }
    var clientCompatibility = BoundedContentCompatibility()
    assert(clientCompatibility.decode(compatibilityWire) &&
        publication.admit(clientCompatibility) &&
        publication.diagnostic() == kutterDiagnosticNone(),
        "matching server and client content identities must admit")
    compatibilityWire[6] = compatibilityWire[6] + 1
    var corruptCompatibility = BoundedContentCompatibility()
    assert(!corruptCompatibility.decode(compatibilityWire),
        "content compatibility wire must reject manifest checksum corruption")

    var alternateExtensionChecksum = active.extensionChecksum() + 1
    if (alternateExtensionChecksum > 1000002) {
        alternateExtensionChecksum = 1
    }
    var incompatibleClient = BoundedContentCompatibility()
    assert(incompatibleClient.configureVersions(
            active.engineVersion(), active.apiVersion(),
            active.networkSchemaChecksum()) &&
        incompatibleClient.configureContent(
            active.packageChecksum(), alternateExtensionChecksum,
            active.moduleChecksum(), active.definitionChecksum()) &&
        incompatibleClient.configurePublication(
            active.generation(), active.revision(), active.productChecksum()) &&
        incompatibleClient.seal() &&
        !publication.admit(incompatibleClient) &&
        publication.diagnostic() == kutterDiagnosticManifest() &&
        cache.activeGeneration() == 1,
        "server admission must reject an incompatible mod manifest without mutation")

    var secondPackage = BoundedContentPackage(1, 1, 1)
    assert(secondPackage.configureHeader(7, 4, 2, 1, 100) &&
        secondPackage.addAsset(8, 2001, 3, 2, 821, 822, 15) &&
        secondPackage.addChunk(1, 9, 0, 64, 823, 824, 2) &&
        secondPackage.seal(),
        "second kutter revision must seal independently")
    assert(publication.begin(0, 2) &&
        publication.stagePackage(secondPackage, 7) &&
        publication.stageExtensions(extensions, hooks, 2) &&
        publication.stageDefinitions(definitions) &&
        publication.stageProducts(
            102, 202, 302, secondPackage.checksum()) &&
        !publication.validate(cache) &&
        publication.status() == kutterPublicationRejectedStatus() &&
        publication.diagnostic() == kutterDiagnosticStale() &&
        publication.activeGeneration() == 1 &&
        cache.activeGeneration() == 1,
        "stale editor transaction must retain the prior running generation")
    assert(publication.begin(1, 2) &&
        publication.stagePackage(secondPackage, 7) &&
        publication.stageExtensions(extensions, hooks, 2) &&
        publication.stageDefinitions(definitions) &&
        publication.stageProducts(
            102, 202, 302, secondPackage.checksum() + 1) &&
        !publication.validate(cache) &&
        publication.diagnostic() == kutterDiagnosticProduct() &&
        cache.activeGeneration() == 1,
        "invalid product bundle must leave the prior world active")
    assert(publication.begin(1, 2) &&
        publication.stagePackage(secondPackage, 7) &&
        publication.stageExtensions(extensions, hooks, 2) &&
        publication.stageDefinitions(definitions) &&
        publication.stageProducts(
            102, 202, 302, secondPackage.checksum()) &&
        publication.validate(cache) && publication.publish(cache) &&
        publication.activeGeneration() == 2 &&
        publication.revision() == 2 &&
        cache.activeGeneration() == 2 && cache.isResident(1),
        "fresh complete editor transaction must replace all products together")
}

test "G4 kutter definitions drive a distinct multiplayer sample" {
    var kutterDemo = G4KutterDemo()
    var kutterRan = kutterDemo.run()
    assert(kutterRan && kutterDemo.completed() &&
        kutterDemo.failureStep() == 0 &&
        kutterDemo.publishedGeneration() == 1 &&
        kutterDemo.publicationStatus() ==
            kutterPublicationPublishedStatus() &&
        kutterDemo.publicationDiagnostic() == kutterDiagnosticNone() &&
        kutterDemo.playerCount() == 2 &&
        kutterDemo.worldLootCount() == 1 &&
        kutterDemo.worldLootStableId() == 4100 &&
        kutterDemo.playerCurrency() == 9 &&
        kutterDemo.hookEventCount() == 1 &&
        kutterDemo.hookEventKind() == trustedHookEventEliteBounty() &&
        kutterDemo.hookExecutionChecksum() > 0,
        "trusted hook execution and definitions must drive the second sample")
}
test "player fire input publishes weapon presentation" {
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1)
    assert(loopback.definePlayerWeapon(9, 2, 1, 4, 1) &&
        loopback.setPlayerWeaponRange(9, 20) &&
        loopback.setPlayerWeaponCooldown(9, 1))
    assert(loopback.addPlayerCombatActor(1, 20, 0))
    assert(loopback.equipPlayerCombatWeapon(1, 9))
    assert(loopback.receiveInput(1, 1, 1, 0, 0, 0, 0, 1, 0))
    assert(loopback.advance(16667) == 1)
    assert(loopback.playerWeaponPresentationCount() == 1 &&
        loopback.replayPresentationCount() == 1 &&
        loopback.replayPresentationAt(0).kind() == 1 &&
        loopback.replayPresentationAt(0).valueOne() == 1 &&
        loopback.playerCombatMagazine(1) == 1 &&
        loopback.playerCombatReserve(1) == 1,
        "confirmed fire must consume ammo and capture presentation")
    assert(loopback.dequeuePlayerWeaponPresentation())
    var shotPresentation = loopback.lastPlayerWeaponPresentation()
    assert(shotPresentation.kind() == 1 &&
        shotPresentation.actorId() == 1 &&
        shotPresentation.shotId() == 1 &&
        shotPresentation.weaponId() == 9 &&
        shotPresentation.magazine() == 1,
        "accepted fire must publish bounded weapon presentation")
    assert(loopback.receiveInput(1, 2, 2, 0, 0, 0, 0, 1, 0))
    assert(loopback.advance(16667) == 1 &&
        loopback.playerWeaponPresentationCount() == 0,
        "held fire must not duplicate edge-triggered weapon presentation")
    assert(loopback.receiveInput(1, 3, 3, 0, 0, 0, 0, 0, 0))
    assert(loopback.advance(16667) == 1)
    assert(loopback.receiveInput(1, 4, 4, 0, 0, 0, 0, 1, 0))
    assert(loopback.advance(16667) == 1 &&
        loopback.playerWeaponPresentationCount() == 1,
        "a new fire edge must publish after release")
}

test "bounded save envelope validation" {
    var save = BoundedSaveState(3, 1000)
    var payload = new Int[3]
    payload[0] = 12
    payload[1] = 34
    payload[2] = 56
    assert(save.stage(1, 7, payload) &&
        save.isStaged() &&
        save.payloadLength() == 3 &&
        save.schemaVersion() == 1 &&
        save.revision() == 7 &&
        save.payloadValue(1) == 34,
        "bounded save state must stage versioned payload values")
    var envelope = save.envelope()
    assert(envelope.accepted() &&
        envelope.schemaVersion() == 1 &&
        envelope.revision() == 7 &&
        envelope.payloadLength() == 3 &&
        envelope.checksum() > 0,
        "save envelope must expose deterministic metadata")
    var restored = BoundedSaveState(3, 1000)
    assert(restored.load(envelope, payload) &&
        restored.payloadValue(0) == 12 &&
        restored.payloadValue(2) == 56,
        "matching envelope and payload must restore state")
    payload[1] = 35
    assert(!restored.load(envelope, payload),
        "mutated payload must fail checksum validation")
    assert(!save.stage(2, 7, payload) &&
        !save.stage(1, -1, payload) &&
        !save.stage(1, 1000001, payload) &&
        !save.stage(1, 7, new Int[4]),
        "unsupported versions, revisions and overflow must reject")
    var invalidValue = new Int[1]
    invalidValue[0] = 1001
    assert(!save.stage(1, 8, invalidValue),
        "values beyond the schema bound must reject")
    assert(save.clear() && !save.isStaged() &&
        save.payloadValue(0) == -1,
        "clearing save state must remove staged payload access")
}
test "bounded save publication history" {
    var first = BoundedSaveState(2, 100)
    var firstPayload = new Int[2]
    firstPayload[0] = 10
    firstPayload[1] = 20
    assert(first.stage(1, 1, firstPayload))
    var second = BoundedSaveState(2, 100)
    var secondPayload = new Int[2]
    secondPayload[0] = 30
    secondPayload[1] = 40
    assert(second.stage(1, 2, secondPayload))
    var history = BoundedSaveHistory(2, 2)
    assert(history.publish(first) && history.publish(second) &&
        history.count() == 2 && history.latestRevision() == 2,
        "save history must publish strictly increasing revisions")
    assert(!history.publish(second),
        "save history must reject duplicate revisions")
    var restored = BoundedSaveState(2, 100)
    assert(history.restore(1, restored) &&
        restored.payloadValue(0) == 10 &&
        restored.payloadValue(1) == 20,
        "save history must restore retained revisions")
    var third = BoundedSaveState(2, 100)
    var thirdPayload = new Int[2]
    thirdPayload[0] = 50
    thirdPayload[1] = 60
    assert(third.stage(1, 3, thirdPayload) &&
        history.publish(third) &&
        history.latestRevision() == 3 &&
        history.count() == 2 &&
        !history.restore(1, restored) &&
        history.restore(2, restored) &&
        restored.payloadValue(0) == 30,
        "full save history must evict its oldest revision deterministically")
    assert(history.clear() && history.count() == 0 &&
        history.latestRevision() == -1,
        "save history clear must remove published revisions")
}

test "bounded save wire codec" {
    var state = BoundedSaveState(2, 1000)
    var payload = new Int[2]
    payload[0] = 77
    payload[1] = 88
    assert(state.stage(1, 42, payload))
    var codec = BoundedSaveWireCodec(2)
    assert(codec.encode(state) &&
        codec.encodedLength() == 7 &&
        codec.encodedWord(0) == 13371337 &&
        codec.encodedWord(2) == 42 &&
        codec.encodedWord(6) == 88 &&
        codec.encodedWord(7) == -1,
        "save wire codec must emit bounded envelope words")
    var wire = new Int[7]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var restored = BoundedSaveState(2, 1000)
    assert(codec.decode(wire, restored) &&
        restored.revision() == 42 &&
        restored.payloadValue(0) == 77 &&
        restored.payloadValue(1) == 88,
        "save wire codec must restore validated payloads")
    wire[6] = 89
    assert(!codec.decode(wire, restored),
        "save wire codec must reject payload checksum corruption")
    wire[6] = 88
    wire[3] = 1
    assert(!codec.decode(wire, restored),
        "save wire codec must reject length framing corruption")
}


test "bounded save file store" {
    var state = BoundedSaveState(2, 1000)
    var payload = new Int[2]
    payload[0] = 101
    payload[1] = 202
    assert(state.stage(1, 9, payload))
    var store = BoundedSaveFileStore(2)
    var path = "/tmp/kookie-save-test.bin"
    assert(store.write(path, state),
        "save file store must write encoded bounded bytes")
    var restored = BoundedSaveState(2, 1000)
    assert(store.read(path, restored),
        "save file store must read encoded bytes")
    assert(restored.revision() == 9 &&
        restored.payloadValue(0) == 101 &&
        restored.payloadValue(1) == 202,
        "save file store must restore decoded values")
    var file = File(path)
    var corrupted = file.readBytes()
    corrupted[corrupted.length - 1] = corrupted[corrupted.length - 1] + 1
    assert(file.writeBytes(corrupted) &&
        !store.read(path, restored),
        "save file store must reject corrupted bytes")
}

test "redundant save file recovery" {
    var state = BoundedSaveState(2, 1000)
    var payload = new Int[2]
    payload[0] = 303
    payload[1] = 404
    assert(state.stage(1, 12, payload))
    var store = BoundedRedundantSaveFileStore(2)
    var path = "/tmp/kookie-save-redundant-test.bin"
    assert(store.write(path, state))
    var restored = BoundedSaveState(2, 1000)
    var file = File(path)
    var corrupted = file.readBytes()
    corrupted[18] = corrupted[18] + 1
    assert(file.writeBytes(corrupted) &&
        store.read(path, restored) &&
        restored.revision() == 12 &&
        restored.payloadValue(1) == 404,
        "redundant save must recover from one corrupted copy")
    assert(store.repair(path),
        "redundant save repair must rewrite both copies")
    var repaired = file.readBytes()
    repaired[66] = repaired[66] + 1
    assert(file.writeBytes(repaired) &&
        store.read(path, restored),
        "repaired save must survive corruption of the other copy")
    var fullyCorrupted = file.readBytes()
    fullyCorrupted[18] = fullyCorrupted[18] + 1
    assert(file.writeBytes(fullyCorrupted) &&
        !store.read(path, restored),
        "redundant save must reject two corrupted copies")
}

test "bounded save schema migration" {
    var source = BoundedSaveState(2, 1000)
    var payload = new Int[2]
    payload[0] = 303
    payload[1] = 404
    assert(source.stage(1, 12, payload))
    var sections = BoundedSaveSections(4, 2)
    var gate = BoundedSaveMigrationGate()
    assert(gate.importLegacy(source, sections) &&
        sections.revision() == 12 &&
        sections.sectionCount() == 1 &&
        sections.sectionId(0) == 1 &&
        sections.sectionVersion(0) == 1 &&
        sections.sectionValue(0, 1) == 404,
        "migration gate must wrap legacy state as a versioned section")
    var codec = BoundedSaveSchemaWireCodec(4, 2)
    assert(codec.encode(sections) && codec.encodedLength() == 9)
    var wire = new Int[codec.encodedLength()]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var decoded = BoundedSaveSections(4, 2)
    var restored = BoundedSaveState(2, 1000)
    assert(codec.decode(wire, decoded) &&
        gate.exportLegacy(decoded, restored) &&
        restored.revision() == 12 &&
        restored.payloadValue(0) == 303 &&
        restored.payloadValue(1) == 404,
        "migration gate must restore the legacy state without loss")
    wire[5] = 2
    assert(!codec.decode(wire, decoded),
        "schema codec must reject unsupported section versions")
    var unsupported = BoundedSaveSections(4, 2)
    assert(unsupported.setRevision(12) &&
        unsupported.put(2, 1, payload) &&
        !gate.exportLegacy(unsupported, restored),
        "migration gate must reject unknown sections")
}

test "schema save file persistence and recovery" {
    var source = BoundedSaveState(2, 1000)
    var payload = new Int[2]
    payload[0] = 303
    payload[1] = 404
    assert(source.stage(1, 12, payload))
    var store = BoundedSaveSchemaFileStore(4, 2)
    var path = "/tmp/kookie-save-schema-test.bin"
    assert(store.writeLegacy(path, source))
    var restored = BoundedSaveState(2, 1000)
    assert(store.readLegacy(path, restored) &&
        restored.revision() == 12 &&
        restored.payloadValue(0) == 303 &&
        restored.payloadValue(1) == 404,
        "schema file store must migrate legacy payloads on load")
    var file = File(path)
    var corrupted = file.readBytes()
    corrupted[18] = corrupted[18] + 1
    assert(file.writeBytes(corrupted) &&
        store.readLegacy(path, restored) &&
        restored.revision() == 12,
        "schema file store must recover from one corrupted copy")
    assert(store.repair(path),
        "schema save repair must rewrite both migrated copies")
    var repaired = file.readBytes()
    var secondCopyStart = 18 + (repaired.length - 18) / 2
    repaired[secondCopyStart] = repaired[secondCopyStart] + 1
    assert(file.writeBytes(repaired) &&
        store.readLegacy(path, restored),
        "repaired schema save must survive one copy corruption")
    var fullyCorrupted = file.readBytes()
    fullyCorrupted[18] = fullyCorrupted[18] + 1
    assert(file.writeBytes(fullyCorrupted) &&
        !store.readLegacy(path, restored),
        "schema save must reject two corrupted copies")
}

test "multi-section save migration" {
    var sections = BoundedSaveSections(6, 3)
    var progression = new Int[2]
    progression[0] = 303
    progression[1] = 404
    var world = new Int[3]
    world[0] = 7
    world[1] = 8
    world[2] = 0
    var rng = new Int[2]
    rng[0] = 99
    rng[1] = 0
    var items = new Int[2]
    items[0] = 17
    items[1] = 18
    var quests = new Int[1]
    quests[0] = 2
    var gate = BoundedSaveMigrationGate()
    assert(sections.setRevision(19) &&
        sections.put(1, 1, progression) &&
        sections.put(2, 2, world) &&
        sections.put(3, 2, rng) &&
        sections.put(4, 1, items) &&
        sections.put(5, 1, quests))
    var codec = BoundedSaveSchemaWireCodec(6, 3)
    assert(codec.encode(sections) && codec.encodedLength() == 29)
    var wire = new Int[codec.encodedLength()]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var decoded = BoundedSaveSections(6, 3)
    var migrated = BoundedSaveSections(6, 3)
    assert(codec.decode(wire, decoded) &&
        gate.migrate(decoded, migrated) &&
        migrated.sectionCount() == 5 &&
        migrated.revision() == 19 &&
        migrated.sectionVersion(1) == 2 &&
        migrated.sectionValue(1, 1) == 8 &&
        migrated.sectionId(3) == 4 &&
        migrated.sectionValue(3, 1) == 18 &&
        migrated.sectionId(4) == 5 &&
        migrated.sectionValue(4, 0) == 2,
        "migration must preserve progression, world, RNG, item and quest sections")
    var legacyWire = new Int[18]
    legacyWire[0] = codec.encodedWord(0)
    legacyWire[1] = 1
    legacyWire[2] = 19
    legacyWire[3] = 3
    legacyWire[4] = 1
    legacyWire[5] = 1
    legacyWire[6] = 2
    legacyWire[7] = 303
    legacyWire[8] = 404
    legacyWire[9] = 2
    legacyWire[10] = 1
    legacyWire[11] = 2
    legacyWire[12] = 7
    legacyWire[13] = 8
    legacyWire[14] = 3
    legacyWire[15] = 1
    legacyWire[16] = 1
    legacyWire[17] = 99
    var legacyDecoded = BoundedSaveSections(6, 3)
    assert(codec.decode(legacyWire, legacyDecoded) &&
        legacyDecoded.sectionVersion(1) == 2 &&
        legacyDecoded.sectionLength(1) == 3 &&
        legacyDecoded.sectionValue(1, 2) == 0 &&
        legacyDecoded.sectionVersion(2) == 2 &&
        legacyDecoded.sectionLength(2) == 2 &&
        legacyDecoded.sectionValue(2, 1) == 0,
        "migration must transform prior world and RNG versions")
    var store = BoundedSaveSchemaFileStore(6, 3)
    var path = "/tmp/kookie-save-multi-test.bin"
    var loaded = BoundedSaveSections(6, 3)
    assert(store.write(path, sections) &&
        store.read(path, loaded) &&
        loaded.sectionCount() == 5 &&
        loaded.sectionId(3) == 4 &&
        loaded.sectionId(4) == 5 &&
        loaded.sectionValue(4, 0) == 2,
        "schema file store must persist all known sections")
    var versionZero = BoundedSaveSections(2, 4)
    var versionZeroWorld = new Int[1]
    versionZeroWorld[0] = 77
    var twoStep = BoundedSaveSections(2, 4)
    assert(versionZero.setRevision(20) &&
        versionZero.put(2, 0, versionZeroWorld) &&
        gate.migrate(versionZero, twoStep) &&
        twoStep.sectionVersion(0) == 2 &&
        twoStep.sectionLength(0) == 3 &&
        twoStep.sectionValue(0, 0) == 77 &&
        twoStep.sectionValue(0, 1) == 0 &&
        twoStep.sectionValue(0, 2) == 0,
        "version-zero sections must execute every explicit migration step")
    var rollbackTarget = BoundedSaveSections(2, 4)
    var currentWorld = new Int[3]
    currentWorld[0] = 88
    currentWorld[1] = 1
    currentWorld[2] = 2
    assert(rollbackTarget.setRevision(21) &&
        rollbackTarget.put(2, 2, currentWorld) &&
        !gate.migrate(versionZero, rollbackTarget) &&
        rollbackTarget.revision() == 21 &&
        rollbackTarget.sectionValue(0, 0) == 88,
        "migration admission must reject revision rollback without mutation")
    var older = BoundedSaveSections(6, 3)
    assert(older.setRevision(18) && older.put(1, 1, progression) &&
        store.write(path, older) && !store.read(path, loaded) &&
        loaded.revision() == 19 && loaded.sectionCount() == 5,
        "save admission must retain a newer loaded revision")
    var fork = BoundedSaveSections(6, 3)
    var forkPayload = new Int[1]
    forkPayload[0] = 999
    assert(fork.setRevision(19) && fork.put(1, 1, forkPayload) &&
        store.write(path, fork) && !store.read(path, loaded) &&
        loaded.revision() == 19 && loaded.sectionCount() == 5,
        "save admission must reject a divergent equal-revision fork")
}

test "typed item and quest save sections" {
    var sections = BoundedSaveSections(6, 6)
    var items = BoundedItemSaveSection(2)
    var quests = BoundedQuestSaveSection(2)
    assert(items.add(100, 7, 4) &&
        items.add(101, 7, 1) &&
        !items.add(100, 8, 2) &&
        !items.add(102, 7, 0) &&
        quests.add(20, 2, 3) &&
        !quests.add(20, 1, 4) &&
        !quests.add(21, 4, 0) &&
        sections.setRevision(21) &&
        items.encodeInto(sections) &&
        quests.encodeInto(sections),
        "typed save sections must validate ownership, quantity and quest state")
    var codec = BoundedSaveSchemaWireCodec(6, 6)
    var wire = new Int[19]
    var restoredSections = BoundedSaveSections(6, 6)
    var restoredItems = BoundedItemSaveSection(2)
    var restoredQuests = BoundedQuestSaveSection(2)
    assert(codec.encode(sections) &&
        codec.encodedLength() == wire.length)
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    assert(codec.decode(wire, restoredSections) &&
        restoredItems.decodeFrom(restoredSections) &&
        restoredQuests.decodeFrom(restoredSections) &&
        restoredItems.count() == 2 &&
        restoredItems.ownerId(0) == 7 &&
        restoredItems.quantity(1) == 1 &&
        restoredQuests.state(0) == 2 &&
        restoredQuests.progress(0) == 3,
        "typed save sections must round-trip through the schema wire")
}

test "atomic item inventory transactions and persistence" {
    var seller = BoundedItemInventory(2, 2)
    var buyer = BoundedItemInventory(1, 2)
    assert(seller.addItem(500, 5) &&
        seller.setCurrency(0) &&
        buyer.setCurrency(100) &&
        buyer.purchaseFrom(seller, 500, 2, 10) &&
        seller.itemCount() == 1 &&
        seller.itemQuantity(0) == 3 &&
        buyer.itemCount() == 1 &&
        buyer.itemId(0) == 500 &&
        buyer.itemQuantity(0) == 2 &&
        seller.currency() == 20 &&
        buyer.currency() == 80,
        "inventory purchase must atomically transfer item and currency")
    assert(!buyer.purchaseFrom(seller, 500, 4, 10) &&
        seller.itemQuantity(0) == 3 &&
        buyer.itemQuantity(0) == 2 &&
        seller.currency() == 20 &&
        buyer.currency() == 80,
        "failed inventory purchase must leave both inventories unchanged")
    var sections = BoundedSaveSections(8, 16)
    var restored = BoundedItemInventory(1, 2)
    var codec = BoundedSaveSchemaWireCodec(8, 16)
    assert(sections.setRevision(22) &&
        buyer.encodeInto(sections) &&
        codec.encode(sections) &&
        codec.encodedLength() == 17)
    var wire = new Int[17]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var decoded = BoundedSaveSections(8, 16)
    assert(codec.decode(wire, decoded) &&
        restored.decodeFrom(decoded) &&
        restored.currency() == 80 &&
        restored.itemId(0) == 500 &&
        restored.itemQuantity(0) == 2,
        "inventory currency and ownership must survive schema persistence")
    var legacySections = BoundedSaveSections(8, 16)
    var legacyItems = new Int[3]
    legacyItems[0] = 500
    legacyItems[1] = 1
    legacyItems[2] = 2
    var legacyCurrency = new Int[1]
    legacyCurrency[0] = 80
    var legacyInventory = BoundedItemInventory(1, 2)
    assert(legacySections.setRevision(21) &&
        legacySections.put(4, 1, legacyItems) &&
        legacySections.put(6, 1, legacyCurrency) &&
        legacyInventory.decodeFrom(legacySections) &&
        !legacyInventory.itemRoll(0).accepted(),
        "legacy inventory loads without rolled-item section defaults")
}

test "deterministic item definitions and loot rolls" {
    var definitions = BoundedItemDefinitionStore(2)
    assert(definitions.define(10, 25, 1, 20, 4) &&
        definitions.define(11, 50, 5, 20, 2) &&
        !definitions.define(10, 30, 1, 20, 4) &&
        !definitions.define(12, 30, 0, 20, 4))
    var table = BoundedLootTable(2)
    assert(table.add(10, 3, definitions) &&
        table.add(11, 1, definitions) &&
        !table.add(10, 1, definitions))
    var first = BoundedItemRoll()
    var second = BoundedItemRoll()
    assert(table.roll(500, 12345, 10, definitions, first) &&
        table.roll(500, 12345, 10, definitions, second) &&
        first.accepted() &&
        first.definitionId() == second.definitionId() &&
        first.rarity() == second.rarity() &&
        first.affixOne() == second.affixOne() &&
        first.affixTwo() == second.affixTwo() &&
        first.condition() == second.condition() &&
        first.level() == 10,
        "loot rolls must be deterministic for the same seed and inputs")
    var pools = BoundedAffixPoolStore(1)
    var poolFirst = BoundedItemRoll()
    var poolSecond = BoundedItemRoll()
    assert(pools.define(4) &&
        pools.add(4, 7, 3) &&
        pools.add(4, 9, 1) &&
        table.rollWithAffixPools(
            501, 12345, 10, definitions, pools, poolFirst) &&
        table.rollWithAffixPools(
            501, 12345, 10, definitions, pools, poolSecond) &&
        poolFirst.affixOne() > 0 &&
        poolFirst.affixOne() != 1 &&
        poolFirst.affixOne() == poolSecond.affixOne() &&
        poolFirst.affixTwo() == poolSecond.affixTwo(),
        "content affix pools must select deterministic non-contiguous ids")
    var inventory = BoundedItemInventory(3, 2)
    assert(inventory.addLootedItem(first, 1) &&
        inventory.itemId(0) == 500 &&
        !inventory.addLootedItem(BoundedItemRoll(), 1),
        "accepted loot rolls must enter inventory with stable identity")
    var sections = BoundedSaveSections(8, 16)
    var codec = BoundedSaveSchemaWireCodec(8, 16)
    assert(sections.setRevision(23) &&
        inventory.encodeInto(sections) &&
        codec.encode(sections) &&
        codec.encodedLength() == 25)
    var wire = new Int[25]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var decoded = BoundedSaveSections(8, 16)
    var restored = BoundedItemInventory(3, 2)
    assert(codec.decode(wire, decoded) &&
        restored.decodeFrom(decoded) &&
        restored.itemRoll(0).definitionId() == first.definitionId() &&
        restored.itemRoll(0).seed() == first.seed() &&
        restored.itemRoll(0).affixOne() == first.affixOne() &&
        restored.itemRoll(0).condition() == first.condition(),
        "rolled item fields must survive schema persistence")
    assert(decoded.clear())
    wire[21] = 0
    assert(codec.decode(wire, decoded) && !restored.decodeFrom(decoded),
        "typed inventory load must reject malformed rolled item fields")
}

test "equipment loadout transactions and persistence" {
    var inventory = BoundedItemInventory(3, 3)
    var loadout = BoundedEquipmentLoadout(4)
    assert(inventory.addItem(500, 1) &&
        inventory.addItem(501, 1) &&
        loadout.equip(inventory, 0, 500) &&
        loadout.equip(inventory, 1, 501) &&
        !loadout.equip(inventory, 2, 500) &&
        !loadout.equip(inventory, 2, 999) &&
        loadout.itemAt(0) == 500 &&
        loadout.itemAt(1) == 501 &&
        loadout.unequip(1) &&
        loadout.equip(inventory, 2, 501),
        "equipment must validate ownership and unique slot assignment")
    var sections = BoundedSaveSections(8, 16)
    var codec = BoundedSaveSchemaWireCodec(8, 16)
    assert(sections.setRevision(24) &&
        inventory.encodeInto(sections) &&
        loadout.encodeInto(sections) &&
        codec.encode(sections) &&
        codec.encodedLength() == 27)
    var wire = new Int[27]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var decoded = BoundedSaveSections(8, 16)
    var restoredInventory = BoundedItemInventory(3, 3)
    var restoredLoadout = BoundedEquipmentLoadout(4)
    assert(codec.decode(wire, decoded) &&
        restoredInventory.decodeFrom(decoded) &&
        restoredLoadout.decodeFrom(decoded, restoredInventory) &&
        restoredLoadout.itemAt(0) == 500 &&
        restoredLoadout.itemAt(2) == 501 &&
        restoredLoadout.itemAt(1) == 0,
        "equipment ownership must survive schema persistence")
    var malformed = BoundedSaveSections(8, 16)
    var malformedLoadout = BoundedEquipmentLoadout(4)
    var malformedPayload = new Int[4]
    malformedPayload[0] = 0
    malformedPayload[1] = 500
    malformedPayload[2] = 1
    malformedPayload[3] = 500
    assert(malformed.setRevision(24) &&
        malformed.put(8, 1, malformedPayload) &&
        !malformedLoadout.decodeFrom(malformed, restoredInventory),
        "equipment load must reject duplicate item ownership")
    var legacy = BoundedSaveSections(8, 16)
    var legacyLoadout = BoundedEquipmentLoadout(4)
    assert(legacy.setRevision(24) &&
        legacyLoadout.equip(restoredInventory, 0, 500) &&
        legacyLoadout.decodeFrom(legacy, restoredInventory) &&
        legacyLoadout.itemAt(0) == 0,
        "older saves without equipment must load empty")

}

test "item stat composition and crafting persistence" {
    var definitions = BoundedItemDefinitionStore(2)
    var affixes = BoundedAffixStatStore(4)
    assert(definitions.define(100, 100, 1, 10, 2) &&
        affixes.define(1, 10, 20, 10) &&
        affixes.define(2, 5, 0, 20),
        "stat definitions must accept bounded affix profiles")
    var roll = BoundedItemRoll()
    assert(roll.stage(900, 100, 5, 1, 1, 1, 2, 80))
    var stats = BoundedItemStatResult()
    var composer = BoundedItemStatComposer()
    assert(composer.compose(roll, definitions, affixes, stats) &&
        stats.base() == 100 &&
        stats.flat() == 115 &&
        stats.additive() == 138 &&
        stats.finalAmount() == 179,
        "item stats must compose base, flat, additive and multiplicative values")
    var inventory = BoundedItemInventory(7, 4)
    var recipe = BoundedCraftRecipe(2)
    var crafting = BoundedCraftingSystem()
    assert(inventory.addItem(700, 2) &&
        inventory.addItem(701, 1) &&
        inventory.setCurrency(100) &&
        recipe.addIngredient(700, 2) &&
        recipe.addIngredient(701, 1) &&
        recipe.setCurrencyCost(25) &&
        recipe.setOutput(roll) &&
        crafting.validate(inventory, recipe) &&
        crafting.craft(inventory, recipe) &&
        inventory.itemCount() == 1 &&
        inventory.itemId(0) == 900 &&
        inventory.itemQuantity(0) == 1 &&
        inventory.currency() == 75,
        "crafting must atomically consume ingredients and currency")
    var sections = BoundedSaveSections(8, 16)
    var codec = BoundedSaveSchemaWireCodec(8, 16)
    assert(sections.setRevision(25) &&
        inventory.encodeInto(sections) &&
        codec.encode(sections) &&
        codec.encodedLength() == 25)
    var wire = new Int[25]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var decoded = BoundedSaveSections(8, 16)
    var restored = BoundedItemInventory(7, 4)
    assert(codec.decode(wire, decoded) &&
        restored.decodeFrom(decoded) &&
        restored.itemId(0) == 900 &&
        restored.itemRoll(0).affixOne() == 1 &&
        restored.currency() == 75,
        "crafted item ownership and roll fields must persist")
    var rejected = BoundedCraftRecipe(1)
    assert(rejected.addIngredient(900, 2) &&
        rejected.setCurrencyCost(1000) &&
        rejected.setOutput(roll) &&
        !crafting.craft(restored, rejected) &&
        restored.itemCount() == 1 &&
        restored.itemQuantity(0) == 1 &&
        restored.currency() == 75,
        "invalid crafting must leave inventory unchanged")
}

test "reservations skills and status persistence" {
    var inventory = BoundedItemInventory(8, 4)
    var reservation = BoundedItemReservation(2)
    assert(inventory.addItem(1000, 3) &&
        inventory.addItem(1001, 1) &&
        inventory.setCurrency(50) &&
        reservation.addItem(1000, 2) &&
        reservation.addItem(1001, 1) &&
        reservation.setCurrencyCost(20) &&
        reservation.reserve(inventory) &&
        inventory.depositCurrency(1) &&
        !reservation.commit(inventory) &&
        reservation.cancel(),
        "reservations must reject stale inventory revisions")
    var committed = BoundedItemReservation(2)
    assert(committed.addItem(1000, 2) &&
        committed.addItem(1001, 1) &&
        committed.setCurrencyCost(20) &&
        committed.reserve(inventory) &&
        committed.commit(inventory) &&
        inventory.itemQuantity(0) == 1 &&
        inventory.itemCount() == 1 &&
        inventory.currency() == 31,
        "reservations must commit multiple item and currency operations")
    var skillDefinitions = BoundedSkillDefinitionStore(2)
    var skills = BoundedSkillProgression(2)
    assert(skillDefinitions.define(10, 3, 100) &&
        skills.learn(10, skillDefinitions) &&
        skills.gainExperience(10, 250, skillDefinitions) &&
        skills.rank(10) == 2 &&
        skills.experience(10) == 50,
        "skills must advance bounded ranks and retain remainder experience")
    var statusDefinitions = BoundedStatusDefinitionStore(2)
    var statuses = BoundedStatusEffects(2)
    assert(statusDefinitions.define(20, 100, 3) &&
        statuses.apply(20, 50, 2, statusDefinitions) &&
        statuses.apply(20, 80, 2, statusDefinitions) &&
        statuses.duration(20) == 80 &&
        statuses.stacks(20) == 3 &&
        statuses.tick(30) &&
        statuses.duration(20) == 50,
        "statuses must refresh duration, add capped stacks and tick")
    var sections = BoundedSaveSections(12, 16)
    var codec = BoundedSaveSchemaWireCodec(12, 16)
    assert(sections.setRevision(31) &&
        skills.encodeInto(sections) &&
        statuses.encodeInto(sections) &&
        codec.encode(sections) &&
        codec.encodedLength() == 16)
    var wire = new Int[16]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var decoded = BoundedSaveSections(12, 16)
    var restoredSkills = BoundedSkillProgression(2)
    var restoredStatuses = BoundedStatusEffects(2)
    assert(codec.decode(wire, decoded) &&
        restoredSkills.decodeFrom(decoded, skillDefinitions) &&
        restoredStatuses.decodeFrom(decoded, statusDefinitions) &&
        restoredSkills.rank(10) == 2 &&
        restoredSkills.experience(10) == 50 &&
        restoredStatuses.duration(20) == 50 &&
        restoredStatuses.stacks(20) == 3,
        "skill and status state must survive versioned persistence")
}

test "loopback progression authority and persistence" {
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1 &&
        loopback.definePlayerSkill(30, 2, 100) &&
        loopback.learnPlayerSkill(1, 30) &&
        loopback.gainPlayerSkillExperience(1, 30, 125) &&
        loopback.playerSkillRank(1, 30) == 1 &&
        loopback.playerSkillExperience(1, 30) == 25 &&
        loopback.definePlayerStatus(40, 10, 3) &&
        loopback.applyPlayerStatus(1, 40, 5, 2) &&
        loopback.playerStatusDuration(1, 40) == 5 &&
        loopback.advance(16667) == 1 &&
        loopback.playerStatusDuration(1, 40) == 4,
        "loopback must authoritatively advance player progression state")
    var sections = BoundedSaveSections(12, 16)
    var codec = BoundedSaveSchemaWireCodec(12, 16)
    assert(sections.setRevision(40) &&
        loopback.encodePlayerProgression(1, sections) &&
        codec.encode(sections) &&
        codec.encodedLength() == 16)
    var wire = new Int[16]
    for (var index = 0; index < wire.length; index = index + 1) {
        wire[index] = codec.encodedWord(index)
    }
    var decoded = BoundedSaveSections(12, 16)
    var restored = LoopbackSession(4, 2)
    assert(restored.start() && restored.connectPlayer() == 1 &&
        restored.definePlayerSkill(30, 2, 100) &&
        restored.definePlayerStatus(40, 10, 3) &&
        codec.decode(wire, decoded) &&
        restored.decodePlayerProgression(1, decoded) &&
        restored.playerSkillRank(1, 30) == 1 &&
        restored.playerSkillExperience(1, 30) == 25 &&
        restored.playerStatusDuration(1, 40) == 4 &&
        restored.playerStatusStacks(1, 40) == 2,
        "loopback progression state must round-trip through save sections")
}

test "progression modifiers affect authoritative combat" {
    var loopback = LoopbackSession(4, 4)
    assert(loopback.start() && loopback.connectPlayer() == 1 &&
        loopback.connectPlayer() == 2 &&
        loopback.definePlayerSkill(50, 2, 100) &&
        loopback.definePlayerSkill(51, 1, 100) &&
        loopback.setPlayerSkillPrerequisite(51, 50) &&
        !loopback.learnPlayerSkill(1, 51) &&
        loopback.setPlayerSkillDamagePercent(50, 50) &&
        loopback.learnPlayerSkill(1, 50) &&
        loopback.gainPlayerSkillExperience(1, 50, 100) &&
        loopback.learnPlayerSkill(1, 51) &&
        loopback.setPlayerSkillActivation(50, 30, 3) &&
        loopback.setPlayerSkillResource(1, 50),
        "skill prerequisites and activation metadata must be enforced")
    var activation = loopback.activatePlayerSkill(1, 50, 0)
    assert(activation.accepted() && activation.resourceCost() == 30 &&
        activation.cooldownUntil() == 3 &&
        loopback.playerSkillResource(1) == 20 &&
        loopback.playerSkillCooldown(1, 50, 1) == 2,
        "skill activation must consume bounded resource and set cooldown")
    var blockedActivation = loopback.activatePlayerSkill(1, 50, 1)
    assert(!blockedActivation.accepted() &&
        loopback.playerSkillResource(1) == 20,
        "skill activation must reject cooldown reuse")
    assert(loopback.setPlayerSkillResource(1, 50))
    var readyActivation = loopback.activatePlayerSkill(1, 50, 3)
    assert(readyActivation.accepted() && loopback.playerSkillResource(1) == 20,
        "skill activation must become available at cooldown expiry")
    assert(loopback.definePlayerStatus(60, 5, 3) &&
        loopback.setPlayerStatusDamageModifier(60, 2, 25) &&
        loopback.applyPlayerStatus(1, 60, 5, 1) &&
        loopback.definePlayerWeapon(9, 3, 0, 10, 1) &&
        loopback.setPlayerWeaponRange(9, 20) &&
        loopback.addPlayerCombatActor(1, 100, 0) &&
        loopback.addPlayerCombatActor(2, 100, 0) &&
        loopback.equipPlayerCombatWeapon(1, 9),
        "player progression modifiers must configure before combat")
    var enhanced = loopback.resolvePlayerHitscan(1, 2, 0, 1, 0)
    assert(enhanced.accepted() && enhanced.applied() == 21 &&
        loopback.playerCombatHealth(2) == 79,
        "skill and status modifiers must increase player damage")
    assert(loopback.definePlayerStatus(61, 2, 1) &&
        loopback.setPlayerStatusDefenseModifier(61, 3, 50) &&
        loopback.applyPlayerStatus(2, 61, 2, 1))
    var defended = loopback.resolvePlayerHitscan(1, 2, 1, 1, 0)
    assert(defended.accepted() && defended.applied() == 9 &&
        loopback.playerCombatHealth(2) == 70,
        "defensive status modifiers must reduce incoming damage")
    assert(loopback.advance(4 * 16667) == 4 &&
        loopback.playerStatusDuration(1, 60) == 1 &&
        loopback.advance(16667) == 1 &&
        loopback.playerStatusDuration(1, 60) == -1)
    var expired = loopback.resolvePlayerHitscan(1, 2, 5, 1, 0)
    assert(expired.accepted() && expired.applied() == 15 &&
        loopback.playerCombatHealth(2) == 55,
        "expired status modifiers must stop affecting player damage")
    assert(loopback.definePlayerWeapon(10, 3, 0, 10, 1) &&
        loopback.setPlayerWeaponRange(10, 20),
        "loopback must define a second combat weapon")
    assert(loopback.equipPlayerCombatWeapon(1, 10),
        "loopback must equip the second combat weapon")
    assert(loopback.setPlayerCombatShield(2, 8, 8),
        "loopback must set player shield state")
    assert(loopback.setPlayerCombatResistance(2, 1, 50),
        "loopback must set player resistance state")
    var playerShielded = loopback.resolvePlayerHitscan(1, 2, 6, 1, 0)
    assert(playerShielded.accepted() && playerShielded.applied() == 8 &&
        loopback.playerCombatHealth(2) == 55 &&
        loopback.playerCombatShield(2) == 0,
        "loopback player combat must expose resistance and shield authority")
    assert(loopback.defineEnemyWeapon(19, 2, 0, 10, 1) &&
        loopback.setEnemyWeaponRange(19, 20) &&
        loopback.addEnemyCombatActor(10, 100, 0) &&
        loopback.addEnemyCombatActor(11, 100, 0) &&
        loopback.equipEnemyCombatWeapon(10, 19) &&
        loopback.setEnemyCombatDamageModifier(10, 1, 100) &&
        loopback.setEnemyCombatShield(11, 3, 3) &&
        loopback.setEnemyCombatResistance(11, 1, 50))
    var enemyHit = loopback.resolveEnemyHitscan(10, 11, 0, 1, 0)
    assert(enemyHit.accepted() && enemyHit.applied() == 11 &&
        loopback.enemyCombatShield(11) == 0,
        "enemy combat must honor resistance and shield modifiers")
}
test "periodic statuses damage players on fixed ticks" {
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1 &&
        loopback.connectPlayer() == 2 &&
        loopback.definePlayerStatus(70, 3, 2) &&
        loopback.setPlayerStatusPeriodicDamage(70, 3, 1) &&
        loopback.applyPlayerStatus(2, 70, 3, 2) &&
        loopback.addPlayerCombatActor(1, 50, 0) &&
        loopback.addPlayerCombatActor(2, 20, 0),
        "periodic status damage must configure through authority")
    assert(loopback.advance(16667) == 1 &&
        loopback.playerCombatHealth(2) == 14 &&
        loopback.playerStatusDuration(2, 70) == 2,
        "periodic status damage must tick once per fixed step")
    assert(loopback.advance(2 * 16667) == 2 &&
        loopback.playerCombatHealth(2) == 2 &&
        loopback.playerStatusDuration(2, 70) == -1,
        "periodic status damage must stop when the status expires")
}

test "area damage resolves bounded target batches" {
    var combat = CombatWorld(4, 1)
    var targets = new Int[2]
    targets[0] = 2
    targets[1] = 3
    assert(combat.addActor(1, 50, 0) &&
        combat.addActor(2, 30, 0) &&
        combat.addActor(3, 30, 0) &&
        combat.setResistance(3, 1, 50))
    var area = combat.resolveAreaDamage(1, targets, 10, 1, 0)
    assert(area.accepted() && area.targetCount() == 2 &&
        area.applied() == 15 && area.deaths() == 0 &&
        combat.currentHealth(2) == 20 && combat.currentHealth(3) == 25 &&
        combat.pendingCombatEvents() == 2,
        "area damage must reuse bounded resistance and damage resolution")
    assert(combat.dequeueCombatEvent() &&
        combat.lastCombatEvent().kind() == 3 &&
        combat.dequeueCombatEvent() &&
        combat.lastCombatEvent().targetId() == 3,
        "area damage must publish ordered combat events")
    var duplicateTargets = new Int[2]
    duplicateTargets[0] = 2
    duplicateTargets[1] = 2
    var rejected = combat.resolveAreaDamage(1, duplicateTargets, 10, 1, 0)
    assert(!rejected.accepted() && combat.currentHealth(2) == 20,
        "area damage must reject duplicate targets without mutation")
}
test "bounded shotgun pellets share damage authority" {
    var combat = CombatWorld(2, 1)
    assert(combat.defineWeapon(12, 2, 0, 100, 1) &&
        combat.setWeaponRange(12, 30) &&
        combat.setWeaponSpread(12, 3, 20) &&
        combat.addActor(1, 1000, 0) &&
        combat.addActor(2, 1000, 0) &&
        combat.equipWeapon(1, 12) &&
        !combat.setWeaponSpread(12, 9, 10))
    var firstPellet = combat.shotgunPelletOffset(12, 0)
    var secondPellet = combat.shotgunPelletOffset(12, 1)
    var thirdPellet = combat.shotgunPelletOffset(12, 2)
    assert(firstPellet.valid() && firstPellet.x() == 0 &&
        firstPellet.y() == 20 &&
        secondPellet.valid() && secondPellet.x() == -20 &&
        secondPellet.y() == -20 &&
        thirdPellet.valid() && thirdPellet.x() == 20 &&
        thirdPellet.y() == -20,
        "shotgun spread must publish deterministic geometric offsets")
    assert(combat.shotgunTargetStartIndex(12, 0, 3) == 2 &&
        combat.shotgunTargetStartIndex(12, 1, 3) == 2 &&
        combat.shotgunTargetStartIndex(12, 2, 3) == 0,
        "shotgun geometry must produce deterministic target starts")
    var blast = combat.resolveShotgun(1, 2, 0, 30, 0)
    assert(blast.accepted() && blast.applied() == 281 &&
        blast.remainingHealth() == 719 &&
        combat.magazine(1) == 1 && combat.pendingCombatEvents() == 3,
        "shotgun must consume one shell and publish bounded pellet hits")
    assert(combat.dequeueCombatEvent() &&
        combat.lastCombatEvent().kind() == 4 &&
        combat.dequeueCombatEvent() &&
        combat.dequeueCombatEvent() &&
        combat.pendingCombatEvents() == 0,
        "shotgun pellet events must preserve deterministic order")
}
test "shotgun pellets target bounded spread list" {
    var combat = CombatWorld(3, 1)
    assert(combat.defineWeapon(13, 2, 0, 100, 1) &&
        combat.setWeaponRange(13, 30) &&
        combat.setWeaponSpread(13, 3, 0) &&
        combat.addActor(1, 1000, 0) &&
        combat.addActor(2, 1000, 0) &&
        combat.addActor(3, 1000, 0) &&
        combat.equipWeapon(1, 13))
    var targets = new Int[2]
    targets[0] = 2
    targets[1] = 3
    var result = combat.resolveShotgunTargets(1, targets, 0, 30, 0)
    assert(result.accepted() && result.targetCount() == 3 &&
        result.applied() == 300 && result.deaths() == 0 &&
        combat.currentHealth(2) == 800 &&
        combat.currentHealth(3) == 900 &&
        combat.magazine(1) == 1,
        "shotgun target lists must distribute pellets deterministically")
}
test "shotgun pellet targets preserve spatial selection" {
    var combat = CombatWorld(3, 1)
    assert(combat.defineWeapon(14, 2, 0, 100, 1) &&
        combat.setWeaponRange(14, 30) &&
        combat.setWeaponSpread(14, 3, 0) &&
        combat.addActor(1, 1000, 0) &&
        combat.addActor(2, 1000, 0) &&
        combat.addActor(3, 1000, 0) &&
        combat.equipWeapon(1, 14))
    var selected = new Int[3]
    selected[0] = 2
    selected[1] = 2
    selected[2] = 3
    var result = combat.resolveShotgunPelletTargets(
        1, selected, 0, 30, 0)
    assert(result.accepted() && result.targetCount() == 3 &&
        result.applied() == 300 &&
        combat.currentHealth(2) == 800 &&
        combat.currentHealth(3) == 900,
        "spatial pellet targets must preserve per-pellet selection")
    assert(combat.dequeueCombatEvent() &&
        combat.lastCombatEvent().targetId() == 2 &&
        combat.dequeueCombatEvent() &&
        combat.lastCombatEvent().targetId() == 2 &&
        combat.dequeueCombatEvent() &&
        combat.lastCombatEvent().targetId() == 3,
        "spatial pellet events must preserve selected target order")
    var wrongLength = new Int[2]
    wrongLength[0] = 2
    wrongLength[1] = 3
    assert(!combat.resolveShotgunPelletTargets(
        1, wrongLength, 1, 30, 0).accepted(),
        "spatial pellet targets must require one target per pellet")
}





test "focus loss clears held input and queued fire" {
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1)
    assert(loopback.definePlayerWeapon(9, 3, 0, 4, 1) &&
        loopback.setPlayerWeaponRange(9, 20) &&
        loopback.setPlayerWeaponCooldown(9, 1) &&
        loopback.addPlayerCombatActor(1, 20, 0) &&
        loopback.equipPlayerCombatWeapon(1, 9))
    assert(loopback.receiveInput(1, 1, 1, 0, 0, 0, 0, 1, 0) &&
        loopback.advance(16667) == 1 &&
        loopback.playerWeaponPresentationCount() == 1)
    assert(loopback.dequeuePlayerWeaponPresentation())
    assert(loopback.lastInputEdges(1).firePressed() == 1)
    assert(loopback.receiveInput(1, 2, 2, 0, 0, 0, 0, 1, 0))
    assert(loopback.applyPlayerFocus(1, 0) &&
        !loopback.playerFocused(1) &&
        loopback.lastInputEdges(1).fireReleased() == 1 &&
        loopback.lastInputEdges(1).firePressed() == 0,
        "focus loss must release held buttons")
    assert(loopback.advance(16667) == 1 &&
        loopback.playerWeaponPresentationCount() == 0 &&
        !loopback.receiveInput(1, 3, 3, 0, 0, 0, 0, 1, 0),
        "focus loss must discard queued and new firing input")
    assert(loopback.applyPlayerFocus(1, 1) &&
        loopback.playerFocused(1) &&
        loopback.receiveInput(1, 3, 4, 0, 0, 0, 0, 1, 0) &&
        loopback.advance(16667) == 1 &&
        loopback.playerWeaponPresentationCount() == 1,
        "focus regain must rearm input acceptance")
}

test "pause reset discards debt and one-shot input" {
    var clock = FixedStepClock(60, 4)
    assert(clock.advance(1000) == 0 &&
        clock.pendingMicros() == 1000 &&
        clock.resetDebt() &&
        clock.pendingMicros() == 0)
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1)
    assert(loopback.definePlayerWeapon(9, 2, 0, 4, 1) &&
        loopback.setPlayerWeaponRange(9, 20) &&
        loopback.setPlayerWeaponCooldown(9, 1) &&
        loopback.addPlayerCombatActor(1, 20, 0) &&
        loopback.equipPlayerCombatWeapon(1, 9))
    assert(loopback.receiveInput(1, 1, 1, 0, 0, 0, 0, 1, 0) &&
        loopback.setPaused(1) &&
        loopback.isPaused() &&
        !loopback.setPaused(2) &&
        !loopback.receiveInput(1, 1, 2, 0, 0, 0, 0, 1, 0) &&
        loopback.advance(100000) == 0 &&
        loopback.playerWeaponPresentationCount() == 0,
        "pause must disarm pending input and discard wall-clock debt")
    assert(loopback.setPaused(0) &&
        !loopback.isPaused() &&
        loopback.receiveInput(1, 1, 3, 0, 0, 0, 0, 1, 0) &&
        loopback.advance(16667) == 1 &&
        loopback.playerWeaponPresentationCount() == 1,
        "unpause must resume clean fixed-step input")
}

test "bounded input replay records tick commands" {
    var replay = InputReplayRecorder(2)
    var first = InputCommand(4, 1, 3, 0, 2, -1, 1, 0)
    var second = InputCommand(5, 2, 0, 1, -2, 3, 0, 1)
    assert(replay.append(first) && replay.append(second) &&
        replay.pending() == 2 &&
        replay.lastRecordedTick() == 5 &&
        replay.lastRecordedSequence() == 2,
        "replay must retain ordered resulting tick commands")
    assert(!replay.append(InputCommand(3, 3, 0, 0, 0, 0, 0, 0)) &&
        !replay.append(InputCommand(6, 2, 0, 0, 0, 0, 0, 0)) &&
        !replay.append(InputCommand(6, 3, 0, 0, 0, 0, 2, 0)),
        "replay must reject stale, duplicate and invalid commands")
    assert(replay.playNext() &&
        replay.lastPlayed().tick() == 4 &&
        replay.lastPlayed().sequence() == 1 &&
        replay.lastPlayed().moveX() == 3 &&
        replay.pending() == 1 &&
        replay.playNext() &&
        replay.lastPlayed().tick() == 5 &&
        replay.lastPlayed().jump() == 1 &&
        replay.pending() == 0 &&
        !replay.playNext(),
        "replay playback must preserve FIFO command values")
    assert(replay.reset() && replay.pending() == 0 &&
        replay.lastRecordedSequence() == -1 &&
        replay.append(InputCommand(0, 0, 0, 0, 0, 0, 0, 0)),
        "replay reset must rearm deterministic recording")
}

test "loopback replay capture records consumed commands" {
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1 &&
        loopback.setInputReplayEnabled(true) &&
        loopback.inputReplayEnabledValue())
    assert(loopback.receiveInput(1, 1, 1, 3, 0, 2, -1, 0, 0) &&
        loopback.receiveInput(1, 2, 2, -2, 0, 0, 4, 0, 1) &&
        loopback.advance(16667) == 1 &&
        loopback.advance(16667) == 1 &&
        loopback.pendingPlayerReplay(1) == 2,
        "loopback must capture commands when replay is enabled")
    assert(loopback.playPlayerReplay(1) &&
        loopback.lastPlayerReplay(1).tick() == 1 &&
        loopback.lastPlayerReplay(1).moveX() == 3 &&
        loopback.playPlayerReplay(1) &&
        loopback.lastPlayerReplay(1).tick() == 2 &&
        loopback.lastPlayerReplay(1).jump() == 1 &&
        loopback.pendingPlayerReplay(1) == 0,
        "loopback replay must preserve consumed command order")
    assert(loopback.setInputReplayEnabled(false) &&
        !loopback.inputReplayEnabledValue() &&
        loopback.pendingPlayerReplay(1) == 0,
        "disabling replay must reset bounded capture state")
}

test "loopback replay stages commands into simulation" {
    var timeline = BoundedReplayTimeline(2, 2)
    var initial = new Int[1]
    initial[0] = 0
    assert(timeline.setInitialSnapshot(initial) &&
        timeline.append(InputCommand(1, 1, 3, 0, 0, 0, 0, 0)) &&
        timeline.append(InputCommand(2, 2, -2, 0, 0, 0, 0, 0)))
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1 &&
        loopback.queueReplayCommands(1, timeline, 2) &&
        loopback.advance(33334) == 2 &&
        loopback.currentServerTick() == 2 &&
        loopback.serverPosition(1) == 1,
        "loopback replay must queue staged commands for authoritative execution")
}
test "loopback replay applies checkpoint state" {
    var timeline = BoundedReplayTimeline(2, 4)
    var snapshot = new Int[4]
    snapshot[0] = 3
    snapshot[1] = 42
    snapshot[2] = 0
    snapshot[3] = 9
    assert(timeline.appendCheckpointSnapshot(3, 101, snapshot) &&
        timeline.append(InputCommand(4, 1, 1, 0, 0, 0, 0, 0)))
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1 &&
        loopback.applyReplayCheckpoint(timeline, 4) &&
        loopback.currentServerTick() == 3 &&
        loopback.serverPosition(1) == 42 &&
        loopback.queueReplayCommands(1, timeline, 4) &&
        loopback.advance(16667) == 1 &&
        loopback.currentServerTick() == 4 &&
        loopback.serverPosition(1) == 43,
        "loopback replay must restore checkpoint position and tick")
}
test "loopback replay restores combat checkpoint state" {
    var loopback = LoopbackSession(4, 2)
    assert(loopback.start() && loopback.connectPlayer() == 1 &&
        loopback.connectPlayer() == 2 &&
        loopback.definePlayerWeapon(21, 3, 5, 10, 0) &&
        loopback.setPlayerWeaponRange(21, 20) &&
        loopback.addPlayerCombatActor(1, 100, 0) &&
        loopback.addPlayerCombatActor(2, 100, 0) &&
        loopback.equipPlayerCombatWeapon(1, 21) &&
        loopback.equipPlayerCombatWeapon(2, 21) &&
        loopback.resolvePlayerHitscan(1, 2, 0, 1, 0).accepted() &&
        loopback.playerCombatHealth(2) == 90 &&
        loopback.playerCombatMagazine(1) == 2,
        "combat checkpoint setup must apply initial damage")
