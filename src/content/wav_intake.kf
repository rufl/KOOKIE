package content

Int wavDiagnosticNone() { return 0 }
Int wavDiagnosticHeader() { return 1 }
Int wavDiagnosticChunk() { return 2 }
Int wavDiagnosticFormat() { return 3 }
Int wavDiagnosticData() { return 4 }
Int wavDiagnosticCapacity() { return 5 }
Int wavDiagnosticCanonical() { return 6 }
Int wavMaxSourceBytes() { return 2097152 }
Int wavMaxCanonicalPcmBytes() { return 1048576 }

class BoundedWavIntake {
    Int[] canonicalWire
    Int sourceChecksumValue
    Int sampleChecksumValue
    Int metadataChecksumValue
    Int canonicalChecksumValue
    Int sampleRateValue
    Int channelCountValue
    Int sourceBitsValue
    Int frameCountValue
    Int sampleCountValue
    Int chunkCountValue
    Int metadataChunkCountValue
    Int dataOffsetValue
    Int dataLengthValue
    Int canonicalLengthValue
    Int diagnosticValue
    Bool acceptedValue

    public constructor() {
        canonicalWire = new Int[wavMaxCanonicalPcmBytes() + 44]
        clear()
    }

    Bool clear() {
        sourceChecksumValue = 0
        sampleChecksumValue = 0
        metadataChecksumValue = 0
        canonicalChecksumValue = 0
        sampleRateValue = 0
        channelCountValue = 0
        sourceBitsValue = 0
        frameCountValue = 0
        sampleCountValue = 0
        chunkCountValue = 0
        metadataChunkCountValue = 0
        dataOffsetValue = 0
        dataLengthValue = 0
        canonicalLengthValue = 0
        diagnosticValue = wavDiagnosticNone()
        acceptedValue = false
        return true
    }

    Bool reject(Int diagnostic) {
        diagnosticValue = diagnostic
        canonicalLengthValue = 0
        acceptedValue = false
        return false
    }

    Int u16(Int[] source, Int offset) {
        if (offset < 0 || offset + 2 > source.length) { return -1 }
        return source[offset] + source[offset + 1] * 256
    }

    Int u32(Int[] source, Int offset) {
        if (offset < 0 || offset + 4 > source.length || source[offset + 3] >= 128) {
            return -1
        }
        return source[offset] + source[offset + 1] * 256 +
            source[offset + 2] * 65536 + source[offset + 3] * 16777216
    }

    Bool isFourCc(
        Int[] source, Int offset, Int a, Int b, Int c, Int d
    ) {
        return offset >= 0 && offset + 4 <= source.length &&
            source[offset] == a && source[offset + 1] == b &&
            source[offset + 2] == c && source[offset + 3] == d
    }

    Int mix(Int state, Int value) {
        var normalized = value % 1000003
        if (normalized < 0) { normalized = normalized + 1000003 }
        return (state * 31 + normalized) % 1000003
    }

    Int checksum(Int[] source, Int limit) {
        var result = 17
        for (var index = 0; index < limit; index = index + 1) {
            result = mix(result, source[index])
        }
        return result
    }

    Bool parseFormat(Int[] source, Int start, Int length) {
        if (length != 16) { return false }
        var format = u16(source, start)
        channelCountValue = u16(source, start + 2)
        sampleRateValue = u32(source, start + 4)
        var byteRate = u32(source, start + 8)
        var blockAlign = u16(source, start + 12)
        sourceBitsValue = u16(source, start + 14)
        var bytesPerSample = sourceBitsValue / 8
        return format == 1 &&
            (channelCountValue == 1 || channelCountValue == 2) &&
            sampleRateValue >= 8000 && sampleRateValue <= 96000 &&
            (sourceBitsValue == 8 || sourceBitsValue == 16) &&
            blockAlign == channelCountValue * bytesPerSample &&
            byteRate == sampleRateValue * blockAlign
    }

    Int sourceSample(Int[] source, Int index) {
        if (index < 0 || index >= sampleCountValue) { return 0 }
        if (sourceBitsValue == 8) {
            return (source[dataOffsetValue + index] - 128) * 256
        }
        var offset = dataOffsetValue + index * 2
        var value = source[offset] + source[offset + 1] * 256
        if (value >= 32768) { value = value - 65536 }
        return value
    }

    Bool putByte(Int offset, Int value) {
        if (offset < 0 || offset >= canonicalWire.length ||
            value < 0 || value > 255) { return false }
        canonicalWire[offset] = value
        return true
    }

    Bool putU16(Int offset, Int value) {
        return putByte(offset, value & 255) &&
            putByte(offset + 1, (value >>> 8) & 255)
    }

    Bool putU32(Int offset, Int value) {
        return putByte(offset, value & 255) &&
            putByte(offset + 1, (value >>> 8) & 255) &&
            putByte(offset + 2, (value >>> 16) & 255) &&
            putByte(offset + 3, (value >>> 24) & 255)
    }

    Bool putFourCc(Int offset, Int a, Int b, Int c, Int d) {
        return putByte(offset, a) && putByte(offset + 1, b) &&
            putByte(offset + 2, c) && putByte(offset + 3, d)
    }

    Bool buildCanonical(Int[] source) {
        var pcmLength = sampleCountValue * 2
        canonicalLengthValue = 44 + pcmLength
        if (pcmLength <= 0 || pcmLength > wavMaxCanonicalPcmBytes() ||
            canonicalLengthValue > canonicalWire.length) { return false }
        var blockAlign = channelCountValue * 2
        if (!putFourCc(0, 82, 73, 70, 70) ||
            !putU32(4, canonicalLengthValue - 8) ||
            !putFourCc(8, 87, 65, 86, 69) ||
            !putFourCc(12, 102, 109, 116, 32) ||
            !putU32(16, 16) || !putU16(20, 1) ||
            !putU16(22, channelCountValue) ||
            !putU32(24, sampleRateValue) ||
            !putU32(28, sampleRateValue * blockAlign) ||
            !putU16(32, blockAlign) || !putU16(34, 16) ||
            !putFourCc(36, 100, 97, 116, 97) ||
            !putU32(40, pcmLength)) { return false }
        sampleChecksumValue = 17
        for (var index = 0; index < sampleCountValue; index = index + 1) {
            var sample = sourceSample(source, index)
            if (!putU16(44 + index * 2, sample)) { return false }
            sampleChecksumValue = mix(sampleChecksumValue, sample)
        }
        canonicalChecksumValue = checksum(canonicalWire, canonicalLengthValue)
        return true
    }

    Int canonicalSample(Int index) {
        if (index < 0 || index >= sampleCountValue) { return 0 }
        var offset = 44 + index * 2
        var value = canonicalWire[offset] + canonicalWire[offset + 1] * 256
        if (value >= 32768) { value = value - 65536 }
        return value
    }

    Bool reopenCanonical() {
        if (!acceptedValue || canonicalLengthValue != 44 + sampleCountValue * 2 ||
            !isFourCc(canonicalWire, 0, 82, 73, 70, 70) ||
            u32(canonicalWire, 4) != canonicalLengthValue - 8 ||
            !isFourCc(canonicalWire, 8, 87, 65, 86, 69) ||
            !isFourCc(canonicalWire, 12, 102, 109, 116, 32) ||
            u32(canonicalWire, 16) != 16 || u16(canonicalWire, 20) != 1 ||
            u16(canonicalWire, 22) != channelCountValue ||
            u32(canonicalWire, 24) != sampleRateValue ||
            u32(canonicalWire, 28) != sampleRateValue * channelCountValue * 2 ||
            u16(canonicalWire, 32) != channelCountValue * 2 ||
            u16(canonicalWire, 34) != 16 ||
            !isFourCc(canonicalWire, 36, 100, 97, 116, 97) ||
            u32(canonicalWire, 40) != sampleCountValue * 2) {
            return false
        }
        var reopenedChecksum = 17
        for (var index = 0; index < sampleCountValue; index = index + 1) {
            reopenedChecksum = mix(reopenedChecksum, canonicalSample(index))
        }
        return reopenedChecksum == sampleChecksumValue &&
            checksum(canonicalWire, canonicalLengthValue) == canonicalChecksumValue
    }

    Bool read(Int[] source) {
        clear()
        if (source.length < 44 || source.length > wavMaxSourceBytes()) {
            return reject(wavDiagnosticHeader())
        }
        for (var index = 0; index < source.length; index = index + 1) {
            if (source[index] < 0 || source[index] > 255) {
                return reject(wavDiagnosticHeader())
            }
        }
        if (!isFourCc(source, 0, 82, 73, 70, 70) ||
            u32(source, 4) != source.length - 8 ||
            !isFourCc(source, 8, 87, 65, 86, 69)) {
            return reject(wavDiagnosticHeader())
        }
        var cursor = 12
        var seenFormat = false
        var seenData = false
        while (cursor < source.length) {
            if (cursor + 8 > source.length || chunkCountValue >= 32) {
                return reject(wavDiagnosticChunk())
            }
            var length = u32(source, cursor + 4)
            var start = cursor + 8
            if (length < 0 || length > source.length - start) {
                return reject(wavDiagnosticChunk())
            }
            var paddedLength = length + (length % 2)
            if (paddedLength > source.length - start ||
                (length % 2 == 1 && source[start + length] != 0)) {
                return reject(wavDiagnosticChunk())
            }
            chunkCountValue = chunkCountValue + 1
            if (isFourCc(source, cursor, 102, 109, 116, 32)) {
                if (seenFormat || seenData || !parseFormat(source, start, length)) {
                    return reject(wavDiagnosticFormat())
                }
                seenFormat = true
            } else if (isFourCc(source, cursor, 100, 97, 116, 97)) {
                if (!seenFormat || seenData || length <= 0) {
                    return reject(wavDiagnosticData())
                }
                dataOffsetValue = start
                dataLengthValue = length
                seenData = true
            } else if (isFourCc(source, cursor, 74, 85, 78, 75) ||
                isFourCc(source, cursor, 80, 65, 68, 32)) {
                metadataChunkCountValue = metadataChunkCountValue + 1
            } else if (isFourCc(source, cursor, 76, 73, 83, 84)) {
                if (length < 4 ||
                    !isFourCc(source, start, 73, 78, 70, 79)) {
                    return reject(wavDiagnosticChunk())
                }
                metadataChunkCountValue = metadataChunkCountValue + 1
            } else {
                return reject(wavDiagnosticChunk())
            }
            cursor = start + paddedLength
        }
        if (!seenFormat || !seenData || cursor != source.length) {
            return reject(wavDiagnosticChunk())
        }
        var bytesPerSample = sourceBitsValue / 8
        var blockAlign = channelCountValue * bytesPerSample
        if (dataLengthValue % blockAlign != 0) {
            return reject(wavDiagnosticData())
        }
        frameCountValue = dataLengthValue / blockAlign
        sampleCountValue = dataLengthValue / bytesPerSample
        if (frameCountValue <= 0 || frameCountValue > sampleRateValue * 30 ||
            sampleCountValue > wavMaxCanonicalPcmBytes() / 2) {
            return reject(wavDiagnosticCapacity())
        }
        sourceChecksumValue = checksum(source, source.length)
        metadataChecksumValue = 17
        metadataChecksumValue = mix(metadataChecksumValue, sampleRateValue)
        metadataChecksumValue = mix(metadataChecksumValue, channelCountValue)
        metadataChecksumValue = mix(metadataChecksumValue, sourceBitsValue)
        metadataChecksumValue = mix(metadataChecksumValue, frameCountValue)
        metadataChecksumValue = mix(metadataChecksumValue, chunkCountValue)
        metadataChecksumValue = mix(
            metadataChecksumValue, metadataChunkCountValue)
        if (!buildCanonical(source)) {
            return reject(wavDiagnosticCapacity())
        }
        acceptedValue = true
        if (!reopenCanonical()) {
            return reject(wavDiagnosticCanonical())
        }
        diagnosticValue = wavDiagnosticNone()
        return true
    }

    Bool accepted() { return acceptedValue }
    Int diagnostic() { return diagnosticValue }
    Int sourceChecksum() { return sourceChecksumValue }
    Int sampleChecksum() { return sampleChecksumValue }
    Int metadataChecksum() { return metadataChecksumValue }
    Int canonicalChecksum() { return canonicalChecksumValue }
    Int sampleRate() { return sampleRateValue }
    Int channelCount() { return channelCountValue }
    Int sourceBits() { return sourceBitsValue }
    Int canonicalBits() { return 16 }
    Int frameCount() { return frameCountValue }
    Int sampleCount() { return sampleCountValue }
    Int chunkCount() { return chunkCountValue }
    Int metadataChunkCount() { return metadataChunkCountValue }
    Int durationMillis() {
        if (!acceptedValue || sampleRateValue <= 0) { return 0 }
        return (frameCountValue / sampleRateValue) * 1000 +
            ((frameCountValue % sampleRateValue) * 1000) / sampleRateValue
    }
    Int sample(Int index) {
        if (!acceptedValue) { return 0 }
        return canonicalSample(index)
    }
    Int canonicalLength() {
        if (!acceptedValue) { return 0 }
        return canonicalLengthValue
    }
    Int[] canonicalBytes() {
        if (!acceptedValue) { return new Int[0] }
        var result = new Int[canonicalLengthValue]
        for (var index = 0; index < canonicalLengthValue; index = index + 1) {
            result[index] = canonicalWire[index]
        }
        return result
    }
}
