package content

Int blockbenchDiagnosticNone() { return 0 }
Int blockbenchDiagnosticJson() { return 1 }
Int blockbenchDiagnosticVersion() { return 2 }
Int blockbenchDiagnosticElement() { return 3 }
Int blockbenchDiagnosticBone() { return 4 }
Int blockbenchDiagnosticHierarchy() { return 5 }
Int blockbenchDiagnosticAnimation() { return 6 }
Int blockbenchDiagnosticCapacity() { return 7 }
Int blockbenchDiagnosticCanonical() { return 8 }
Int blockbenchCanonicalMagic() { return 1380467531 }
Int blockbenchCanonicalVersion() { return 1 }
Int blockbenchCanonicalHeaderWords() { return 20 }

class BoundedBlockbenchIntake {
    Int[] sourceValue
    Int sourceChecksumValue
    Int modelFormatChecksumValue
    Int diagnosticValue
    Bool acceptedValue

    Int[] tokenKinds
    Int[] tokenStarts
    Int[] tokenEnds
    Int[] tokenFirstChildren
    Int[] tokenLastChildren
    Int[] tokenNextSiblings
    Int[] tokenKeyStarts
    Int[] tokenKeyEnds
    Int tokenCountValue
    Bool parseCapacityExceededValue
    Int parseCursorValue
    Int stringStartValue
    Int stringEndValue

    Int[] boneUuidA
    Int[] boneUuidB
    Int[] boneUuidLength
    Int[] boneUuidStarts
    Int[] boneUuidEnds
    Int[] boneNameHashes
    Int[] boneParentA
    Int[] boneParentB
    Int[] boneParentLength
    Int[] boneOriginX
    Int[] boneOriginY
    Int[] boneOriginZ
    Int[] boneRotationX
    Int[] boneRotationY
    Int[] boneRotationZ
    Int[] boneFlags
    Int[] boneDepths
    Bool[] boneSeen
    Int boneCountValue
    Int rootBoneCountValue
    Int maxBoneDepthValue

    Int[] cubeUuidA
    Int[] cubeUuidB
    Int[] cubeUuidLength
    Int[] cubeUuidStarts
    Int[] cubeUuidEnds
    Int[] cubeNameHashes
    Int[] cubeBoneA
    Int[] cubeBoneB
    Int[] cubeBoneLength
    Int[] cubeFromX
    Int[] cubeFromY
    Int[] cubeFromZ
    Int[] cubeToX
    Int[] cubeToY
    Int[] cubeToZ
    Int[] cubeOriginX
    Int[] cubeOriginY
    Int[] cubeOriginZ
    Int[] cubeRotationX
    Int[] cubeRotationY
    Int[] cubeRotationZ
    Int[] cubeInflate
    Int[] cubeStretchX
    Int[] cubeStretchY
    Int[] cubeStretchZ
    Int[] cubeFlags
    Bool[] cubeSeen
    Int cubeCountValue

    Int[] animationUuidA
    Int[] animationUuidB
    Int[] animationUuidLength
    Int[] animationNameHashes
    Int[] animationLoops
    Int[] animationLengths
    Int animationCountValue

    Int[] keyframeUuidA
    Int[] keyframeUuidB
    Int[] keyframeUuidLength
    Int[] keyframeAnimationA
    Int[] keyframeAnimationB
    Int[] keyframeAnimationLength
    Int[] keyframeBoneA
    Int[] keyframeBoneB
    Int[] keyframeBoneLength
    Int[] keyframeChannels
    Int[] keyframeInterpolations
    Int[] keyframeTimes
    Int[] keyframeX
    Int[] keyframeY
    Int[] keyframeZ
    Int keyframeCountValue

    Int characterChecksumValue
    Int boneChecksumValue
    Int animationChecksumValue
    Int canonicalChecksumValue
    Int[] wireWords
    Int wireLengthValue

    public constructor() {
        sourceValue = new Int[0]
        tokenKinds = new Int[32768]
        tokenStarts = new Int[32768]
        tokenEnds = new Int[32768]
        tokenFirstChildren = new Int[32768]
        tokenLastChildren = new Int[32768]
        tokenNextSiblings = new Int[32768]
        tokenKeyStarts = new Int[32768]
        tokenKeyEnds = new Int[32768]

        boneUuidA = new Int[64]
        boneUuidB = new Int[64]
        boneUuidLength = new Int[64]
        boneUuidStarts = new Int[64]
        boneUuidEnds = new Int[64]
        boneNameHashes = new Int[64]
        boneParentA = new Int[64]
        boneParentB = new Int[64]
        boneParentLength = new Int[64]
        boneOriginX = new Int[64]
        boneOriginY = new Int[64]
        boneOriginZ = new Int[64]
        boneRotationX = new Int[64]
        boneRotationY = new Int[64]
        boneRotationZ = new Int[64]
        boneFlags = new Int[64]
        boneDepths = new Int[64]
        boneSeen = new Bool[64]

        cubeUuidA = new Int[128]
        cubeUuidB = new Int[128]
        cubeUuidLength = new Int[128]
        cubeUuidStarts = new Int[128]
        cubeUuidEnds = new Int[128]
        cubeNameHashes = new Int[128]
        cubeBoneA = new Int[128]
        cubeBoneB = new Int[128]
        cubeBoneLength = new Int[128]
        cubeFromX = new Int[128]
        cubeFromY = new Int[128]
        cubeFromZ = new Int[128]
        cubeToX = new Int[128]
        cubeToY = new Int[128]
        cubeToZ = new Int[128]
        cubeOriginX = new Int[128]
        cubeOriginY = new Int[128]
        cubeOriginZ = new Int[128]
        cubeRotationX = new Int[128]
        cubeRotationY = new Int[128]
        cubeRotationZ = new Int[128]
        cubeInflate = new Int[128]
        cubeStretchX = new Int[128]
        cubeStretchY = new Int[128]
        cubeStretchZ = new Int[128]
        cubeFlags = new Int[128]
        cubeSeen = new Bool[128]

        animationUuidA = new Int[32]
        animationUuidB = new Int[32]
        animationUuidLength = new Int[32]
        animationNameHashes = new Int[32]
        animationLoops = new Int[32]
        animationLengths = new Int[32]

        keyframeUuidA = new Int[512]
        keyframeUuidB = new Int[512]
        keyframeUuidLength = new Int[512]
        keyframeAnimationA = new Int[512]
        keyframeAnimationB = new Int[512]
        keyframeAnimationLength = new Int[512]
        keyframeBoneA = new Int[512]
        keyframeBoneB = new Int[512]
        keyframeBoneLength = new Int[512]
        keyframeChannels = new Int[512]
        keyframeInterpolations = new Int[512]
        keyframeTimes = new Int[512]
        keyframeX = new Int[512]
        keyframeY = new Int[512]
        keyframeZ = new Int[512]

        wireWords = new Int[12000]
        clear()
    }

    Bool clear() {
        sourceValue = new Int[0]
        sourceChecksumValue = 0
        modelFormatChecksumValue = 0
        diagnosticValue = blockbenchDiagnosticNone()
        acceptedValue = false
        tokenCountValue = 0
        parseCapacityExceededValue = false
        parseCursorValue = 0
        stringStartValue = 0
        stringEndValue = 0
        boneCountValue = 0
        rootBoneCountValue = 0
        maxBoneDepthValue = 0
        cubeCountValue = 0
        animationCountValue = 0
        keyframeCountValue = 0
        characterChecksumValue = 0
        boneChecksumValue = 0
        animationChecksumValue = 0
        canonicalChecksumValue = 0
        wireLengthValue = 0
        for (var index = 0; index < boneSeen.length; index = index + 1) {
            boneSeen[index] = false
        }
        for (var index = 0; index < cubeSeen.length; index = index + 1) {
            cubeSeen[index] = false
        }
        return true
    }

    Int positiveMod(Int value) {
        var result = value % 1000003
        if (result < 0) { result = result + 1000003 }
        return result
    }

    Int mix(Int state, Int value) {
        return (state * 31 + positiveMod(value)) % 1000003
    }

    Int checksum(Int[] source) {
        var result = 17
        for (var index = 0; index < source.length; index = index + 1) {
            result = mix(result, source[index])
        }
        return result
    }

    Bool isWhitespace(Int value) {
        return value == 32 || value == 9 || value == 10 || value == 13
    }

    void skipWhitespace() {
        while (parseCursorValue < sourceValue.length &&
            isWhitespace(sourceValue[parseCursorValue])) {
            parseCursorValue = parseCursorValue + 1
        }
    }

    Bool isHex(Int value) {
        return (value >= 48 && value <= 57) ||
            (value >= 65 && value <= 70) ||
            (value >= 97 && value <= 102)
    }

    Bool validUtf8(Int[] source) {
        var cursor = 0
        while (cursor < source.length) {
            var first = source[cursor]
            if (first < 128) {
                cursor = cursor + 1
            } else if (first >= 194 && first <= 223) {
                if (cursor + 1 >= source.length || source[cursor + 1] < 128 ||
                    source[cursor + 1] > 191) { return false }
                cursor = cursor + 2
            } else if (first >= 224 && first <= 239) {
                if (cursor + 2 >= source.length || source[cursor + 1] < 128 ||
                    source[cursor + 1] > 191 || source[cursor + 2] < 128 ||
                    source[cursor + 2] > 191) { return false }
                if (first == 224 && source[cursor + 1] < 160) { return false }
                if (first == 237 && source[cursor + 1] >= 160) { return false }
                cursor = cursor + 3
            } else if (first >= 240 && first <= 244) {
                if (cursor + 3 >= source.length || source[cursor + 1] < 128 ||
                    source[cursor + 1] > 191 || source[cursor + 2] < 128 ||
                    source[cursor + 2] > 191 || source[cursor + 3] < 128 ||
                    source[cursor + 3] > 191) { return false }
                if (first == 240 && source[cursor + 1] < 144) { return false }
                if (first == 244 && source[cursor + 1] > 143) { return false }
                cursor = cursor + 4
            } else {
                return false
            }
        }
        return true
    }

    Bool scanString() {
        if (parseCursorValue >= sourceValue.length ||
            sourceValue[parseCursorValue] != 34) { return false }
        parseCursorValue = parseCursorValue + 1
        stringStartValue = parseCursorValue
        while (parseCursorValue < sourceValue.length) {
            var value = sourceValue[parseCursorValue]
            if (value == 34) {
                stringEndValue = parseCursorValue
                parseCursorValue = parseCursorValue + 1
                return true
            }
            if (value < 32) { return false }
            if (value == 92) {
                parseCursorValue = parseCursorValue + 1
                if (parseCursorValue >= sourceValue.length) { return false }
                var escaped = sourceValue[parseCursorValue]
                if (escaped == 117) {
                    if (parseCursorValue + 4 >= sourceValue.length) { return false }
                    for (var digit = 1; digit <= 4; digit = digit + 1) {
                        if (!isHex(sourceValue[parseCursorValue + digit])) {
                            return false
                        }
                    }
                    parseCursorValue = parseCursorValue + 5
                } else {
                    if (escaped != 34 && escaped != 92 && escaped != 47 &&
                        escaped != 98 && escaped != 102 && escaped != 110 &&
                        escaped != 114 && escaped != 116) { return false }
                    parseCursorValue = parseCursorValue + 1
                }
            } else {
                parseCursorValue = parseCursorValue + 1
            }
        }
        return false
    }

    Bool rangeHasEscape(Int start, Int end) {
        for (var cursor = start; cursor < end; cursor = cursor + 1) {
            if (sourceValue[cursor] == 92) { return true }
        }
        return false
    }

    Bool sameRange(Int leftStart, Int leftEnd, Int rightStart, Int rightEnd) {
        if (leftEnd - leftStart != rightEnd - rightStart) { return false }
        for (var index = 0; index < leftEnd - leftStart; index = index + 1) {
            if (sourceValue[leftStart + index] != sourceValue[rightStart + index]) {
                return false
            }
        }
        return true
    }

    Int addToken(
        Int kind, Int parent, Int keyStart, Int keyEnd, Int start, Int end
    ) {
        if (tokenCountValue >= tokenKinds.length) {
            parseCapacityExceededValue = true
            return -1
        }
        var token = tokenCountValue
        tokenCountValue = tokenCountValue + 1
        tokenKinds[token] = kind
        tokenStarts[token] = start
        tokenEnds[token] = end
        tokenFirstChildren[token] = -1
        tokenLastChildren[token] = -1
        tokenNextSiblings[token] = -1
        tokenKeyStarts[token] = keyStart
        tokenKeyEnds[token] = keyEnd
        if (parent >= 0) {
            if (tokenFirstChildren[parent] < 0) {
                tokenFirstChildren[parent] = token
            } else {
                tokenNextSiblings[tokenLastChildren[parent]] = token
            }
            tokenLastChildren[parent] = token
        }
        return token
    }

    Bool duplicateObjectKey(Int object, Int start, Int end) {
        var child = tokenFirstChildren[object]
        while (child >= 0) {
            if (sameRange(start, end, tokenKeyStarts[child], tokenKeyEnds[child])) {
                return true
            }
            child = tokenNextSiblings[child]
        }
        return false
    }

    Bool scanNumber() {
        var cursor = parseCursorValue
        if (cursor < sourceValue.length && sourceValue[cursor] == 45) {
            cursor = cursor + 1
        }
        if (cursor >= sourceValue.length) { return false }
        if (sourceValue[cursor] == 48) {
            cursor = cursor + 1
            if (cursor < sourceValue.length && sourceValue[cursor] >= 48 &&
                sourceValue[cursor] <= 57) { return false }
        } else {
            if (sourceValue[cursor] < 49 || sourceValue[cursor] > 57) {
                return false
            }
            while (cursor < sourceValue.length && sourceValue[cursor] >= 48 &&
                sourceValue[cursor] <= 57) { cursor = cursor + 1 }
        }
        if (cursor < sourceValue.length && sourceValue[cursor] == 46) {
            cursor = cursor + 1
            if (cursor >= sourceValue.length || sourceValue[cursor] < 48 ||
                sourceValue[cursor] > 57) { return false }
            while (cursor < sourceValue.length && sourceValue[cursor] >= 48 &&
                sourceValue[cursor] <= 57) { cursor = cursor + 1 }
        }
        if (cursor < sourceValue.length &&
            (sourceValue[cursor] == 101 || sourceValue[cursor] == 69)) {
            cursor = cursor + 1
            if (cursor < sourceValue.length &&
                (sourceValue[cursor] == 43 || sourceValue[cursor] == 45)) {
                cursor = cursor + 1
            }
            if (cursor >= sourceValue.length || sourceValue[cursor] < 48 ||
                sourceValue[cursor] > 57) { return false }
            while (cursor < sourceValue.length && sourceValue[cursor] >= 48 &&
                sourceValue[cursor] <= 57) { cursor = cursor + 1 }
        }
        parseCursorValue = cursor
        return true
    }

    Bool literalAt(String literal) {
        if (parseCursorValue + literal.length() > sourceValue.length) {
            return false
        }
        for (var index = 0; index < literal.length(); index = index + 1) {
            if (sourceValue[parseCursorValue + index] !=
                (literal.charAt(index) as Int)) { return false }
        }
        parseCursorValue = parseCursorValue + literal.length()
        return true
    }

    Int parseValue(Int parent, Int keyStart, Int keyEnd, Int depth) {
        if (depth > 64) {
            parseCapacityExceededValue = true
            return -1
        }
        skipWhitespace()
        if (parseCursorValue >= sourceValue.length) { return -1 }
        var start = parseCursorValue
        var value = sourceValue[parseCursorValue]
        if (value == 123) {
            var object = addToken(1, parent, keyStart, keyEnd, start, 0)
            if (object < 0) { return -1 }
            parseCursorValue = parseCursorValue + 1
            skipWhitespace()
            if (parseCursorValue < sourceValue.length &&
                sourceValue[parseCursorValue] == 125) {
                parseCursorValue = parseCursorValue + 1
                tokenEnds[object] = parseCursorValue
                return object
            }
            var memberCount = 0
            while (parseCursorValue < sourceValue.length) {
                if (memberCount >= 256) {
                    parseCapacityExceededValue = true
                    return -1
                }
                if (!scanString()) { return -1 }
                var memberStart = stringStartValue
                var memberEnd = stringEndValue
                if (memberEnd - memberStart > 128) {
                    parseCapacityExceededValue = true
                    return -1
                }
                if (rangeHasEscape(memberStart, memberEnd) ||
                    duplicateObjectKey(object, memberStart, memberEnd)) { return -1 }
                skipWhitespace()
                if (parseCursorValue >= sourceValue.length ||
                    sourceValue[parseCursorValue] != 58) { return -1 }
                parseCursorValue = parseCursorValue + 1
                if (parseValue(object, memberStart, memberEnd, depth + 1) < 0) {
                    return -1
                }
                memberCount = memberCount + 1
                skipWhitespace()
                if (parseCursorValue >= sourceValue.length) { return -1 }
                if (sourceValue[parseCursorValue] == 125) {
                    parseCursorValue = parseCursorValue + 1
                    tokenEnds[object] = parseCursorValue
                    return object
                }
                if (sourceValue[parseCursorValue] != 44) { return -1 }
                parseCursorValue = parseCursorValue + 1
                skipWhitespace()
            }
            return -1
        }
        if (value == 91) {
            var array = addToken(2, parent, keyStart, keyEnd, start, 0)
            if (array < 0) { return -1 }
            parseCursorValue = parseCursorValue + 1
            skipWhitespace()
            if (parseCursorValue < sourceValue.length &&
                sourceValue[parseCursorValue] == 93) {
                parseCursorValue = parseCursorValue + 1
                tokenEnds[array] = parseCursorValue
                return array
            }
            while (parseCursorValue < sourceValue.length) {
                if (parseValue(array, -1, -1, depth + 1) < 0) { return -1 }
                skipWhitespace()
                if (parseCursorValue >= sourceValue.length) { return -1 }
                if (sourceValue[parseCursorValue] == 93) {
                    parseCursorValue = parseCursorValue + 1
                    tokenEnds[array] = parseCursorValue
                    return array
                }
                if (sourceValue[parseCursorValue] != 44) { return -1 }
                parseCursorValue = parseCursorValue + 1
                skipWhitespace()
            }
            return -1
        }
        if (value == 34) {
            if (!scanString()) { return -1 }
            return addToken(3, parent, keyStart, keyEnd,
                stringStartValue, stringEndValue)
        }
        if (value == 45 || (value >= 48 && value <= 57)) {
            if (!scanNumber()) { return -1 }
            return addToken(4, parent, keyStart, keyEnd, start, parseCursorValue)
        }
        if (literalAt("true")) {
            return addToken(5, parent, keyStart, keyEnd, start, parseCursorValue)
        }
        parseCursorValue = start
        if (literalAt("false")) {
            return addToken(6, parent, keyStart, keyEnd, start, parseCursorValue)
        }
        parseCursorValue = start
        if (literalAt("null")) {
            return addToken(7, parent, keyStart, keyEnd, start, parseCursorValue)
        }
        return -1
    }

    Bool rangeEqualsString(Int start, Int end, String value) {
        if (start < 0 || end - start != value.length()) { return false }
        for (var index = 0; index < value.length(); index = index + 1) {
            if (sourceValue[start + index] != (value.charAt(index) as Int)) {
                return false
            }
        }
        return true
    }

    Bool tokenEquals(Int token, String value) {
        return token >= 0 && token < tokenCountValue && tokenKinds[token] == 3 &&
            rangeEqualsString(tokenStarts[token], tokenEnds[token], value)
    }

    Int objectField(Int object, String name) {
        if (object < 0 || tokenKinds[object] != 1) { return -1 }
        var child = tokenFirstChildren[object]
        while (child >= 0) {
            if (rangeEqualsString(tokenKeyStarts[child], tokenKeyEnds[child], name)) {
                return child
            }
            child = tokenNextSiblings[child]
        }
        return -1
    }

    Int arrayCount(Int array) {
        if (array < 0 || tokenKinds[array] != 2) { return -1 }
        var count = 0
        var child = tokenFirstChildren[array]
        while (child >= 0) {
            count = count + 1
            child = tokenNextSiblings[child]
        }
        return count
    }

    Int decodedStringLength(Int token) {
        if (token < 0 || tokenKinds[token] != 3) { return -1 }
        var length = 0
        var cursor = tokenStarts[token]
        while (cursor < tokenEnds[token]) {
            if (sourceValue[cursor] == 92) {
                cursor = cursor + 2
                if (sourceValue[cursor - 1] == 117) { cursor = cursor + 4 }
            } else {
                cursor = cursor + 1
            }
            length = length + 1
        }
        return length
    }

    Int stringHash(Int token, Int multiplier, Int modulus) {
        if (token < 0 || tokenKinds[token] != 3) { return 0 }
        var result = 17
        var cursor = tokenStarts[token]
        while (cursor < tokenEnds[token]) {
            var value = sourceValue[cursor]
            cursor = cursor + 1
            if (value == 92) {
                value = sourceValue[cursor]
                cursor = cursor + 1
                if (value == 117) {
                    value = 0
                    for (var index = 0; index < 4; index = index + 1) {
                        var digit = sourceValue[cursor + index]
                        if (digit >= 48 && digit <= 57) { digit = digit - 48 }
                        else if (digit >= 65 && digit <= 70) { digit = digit - 55 }
                        else { digit = digit - 87 }
                        value = value * 16 + digit
                    }
                    cursor = cursor + 4
                } else if (value == 98) { value = 8 }
                else if (value == 102) { value = 12 }
                else if (value == 110) { value = 10 }
                else if (value == 114) { value = 13 }
                else if (value == 116) { value = 9 }
            }
            result = (result * multiplier + value) % modulus
        }
        return result
    }

    Bool validUuidRange(Int start, Int end) {
        if (end - start != 36 || rangeHasEscape(start, end)) { return false }
        for (var index = 0; index < 36; index = index + 1) {
            var hyphen = index == 8 || index == 13 || index == 18 || index == 23
            if (hyphen) {
                if (sourceValue[start + index] != 45) { return false }
            } else if (!isHex(sourceValue[start + index])) { return false }
        }
        return true
    }

    Bool validUuid(Int token) {
        return token >= 0 && tokenKinds[token] == 3 &&
            validUuidRange(tokenStarts[token], tokenEnds[token])
    }

    Int identityA(Int token) { return stringHash(token, 31, 1000003) }
    Int identityB(Int token) { return stringHash(token, 131, 1000033) }

    Bool sameIdentity(Int a1, Int b1, Int length1, Int a2, Int b2, Int length2) {
        return a1 == a2 && b1 == b2 && length1 == length2
    }

    Int parseFixedRange(Int start, Int end, Bool allowPlus) {
        if (start < 0 || start >= end) { return 2000000001 }
        var cursor = start
        var sign = 1
        if (sourceValue[cursor] == 45) {
            sign = -1
            cursor = cursor + 1
        } else if (sourceValue[cursor] == 43 && allowPlus) {
            cursor = cursor + 1
        }
        if (cursor >= end) { return 2000000001 }
        var numberStart = cursor
        var integerDigits = 0
        if (sourceValue[cursor] == 48) {
            integerDigits = 1
            cursor = cursor + 1
            if (cursor < end && sourceValue[cursor] >= 48 &&
                sourceValue[cursor] <= 57) { return 2000000001 }
        } else {
            if (sourceValue[cursor] < 49 || sourceValue[cursor] > 57) {
                return 2000000001
            }
            while (cursor < end && sourceValue[cursor] >= 48 &&
                sourceValue[cursor] <= 57) {
                integerDigits = integerDigits + 1
                cursor = cursor + 1
            }
        }
        var fractionalDigits = 0
        if (cursor < end && sourceValue[cursor] == 46) {
            cursor = cursor + 1
            while (cursor < end && sourceValue[cursor] >= 48 &&
                sourceValue[cursor] <= 57) {
                fractionalDigits = fractionalDigits + 1
                cursor = cursor + 1
            }
            if (fractionalDigits <= 0) { return 2000000001 }
        }
        var mantissaEnd = cursor
        var exponent = 0
        if (cursor < end &&
            (sourceValue[cursor] == 101 || sourceValue[cursor] == 69)) {
            cursor = cursor + 1
            var exponentSign = 1
            if (cursor < end && sourceValue[cursor] == 45) {
                exponentSign = -1
                cursor = cursor + 1
            } else if (cursor < end && sourceValue[cursor] == 43) {
                cursor = cursor + 1
            }
            var exponentDigits = 0
            while (cursor < end && sourceValue[cursor] >= 48 &&
                sourceValue[cursor] <= 57) {
                exponent = exponent * 10 + sourceValue[cursor] - 48
                exponentDigits = exponentDigits + 1
                if (exponent > 12) { return 2000000001 }
                cursor = cursor + 1
            }
            if (exponentDigits <= 0) { return 2000000001 }
            exponent = exponent * exponentSign
        }
        if (cursor != end) { return 2000000001 }
        var decimalPosition = integerDigits + exponent
        var digitIndex = 0
        var scaled: Long = 0L
        cursor = numberStart
        while (cursor < mantissaEnd) {
            if (sourceValue[cursor] == 46) {
                cursor = cursor + 1
            } else {
                var digit = sourceValue[cursor] - 48
                var power = decimalPosition - digitIndex + 2
                if (power > 9 && digit != 0) { return 2000000001 }
                if (power >= 0 && power <= 9) {
                    var factor: Long = 1L
                    for (var index = 0; index < power; index = index + 1) {
                        factor = factor * 10L
                    }
                    var contribution: Long = digit
                    scaled = scaled + contribution * factor
                    if (scaled > 100000000L) { return 2000000001 }
                }
                digitIndex = digitIndex + 1
                cursor = cursor + 1
            }
        }
        scaled = scaled * sign
        return scaled.toInt()
    }

    Int fixedValue(Int token) {
        if (token < 0 || token >= tokenCountValue) { return 2000000001 }
        if (tokenKinds[token] == 4) {
            return parseFixedRange(tokenStarts[token], tokenEnds[token], false)
        }
        if (tokenKinds[token] == 3 &&
            !rangeHasEscape(tokenStarts[token], tokenEnds[token])) {
            return parseFixedRange(tokenStarts[token], tokenEnds[token], true)
        }
        return 2000000001
    }

    Int optionalFlag(Int object, String name, Int defaultValue) {
        var token = objectField(object, name)
        if (token < 0) { return defaultValue }
        if (tokenKinds[token] == 5) { return 1 }
        if (tokenKinds[token] == 6) { return 0 }
        return -1
    }

    Bool emptyStringField(Int object, String name) {
        var token = objectField(object, name)
        return token < 0 || (tokenKinds[token] == 3 &&
