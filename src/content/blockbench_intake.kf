    Int byteWord(Int[] source, Int word) {
        var offset = word * 4
        if (offset < 0 || offset + 4 > source.length) { return 0 }
        return source[offset] | (source[offset + 1] << 8) |
            (source[offset + 2] << 16) | (source[offset + 3] << 24)
    }

    Int wireIdentityOffset(
        Int[] bytes, Int base, Int count, Int width, Int a, Int b, Int length
    ) {
        for (var index = 0; index < count; index = index + 1) {
            var offset = base + index * width
            if (byteWord(bytes, offset) == a &&
                byteWord(bytes, offset + 1) == b &&
                byteWord(bytes, offset + 2) == length) { return offset }
        }
        return -1
    }

    Bool wireIdentityExists(
        Int[] bytes, Int base, Int count, Int width, Int a, Int b, Int length
    ) {
        return wireIdentityOffset(
            bytes, base, count, width, a, b, length) >= 0
    }

    Bool reopenCanonical() {
        var bytes = encodedCanonicalBytes()
        if (bytes.length != wireLengthValue * 4 ||
            wireLengthValue < blockbenchCanonicalHeaderWords() ||
            byteWord(bytes, 0) != blockbenchCanonicalMagic() ||
            byteWord(bytes, 1) != blockbenchCanonicalVersion() ||
            byteWord(bytes, 2) != sourceChecksumValue ||
            byteWord(bytes, 3) != boneCountValue ||
            byteWord(bytes, 4) != cubeCountValue ||
            byteWord(bytes, 5) != animationCountValue ||
            byteWord(bytes, 6) != keyframeCountValue ||
            byteWord(bytes, 7) != rootBoneCountValue ||
            byteWord(bytes, 8) != maxBoneDepthValue ||
            byteWord(bytes, 9) != 15 || byteWord(bytes, 10) != 24 ||
            byteWord(bytes, 11) != 7 || byteWord(bytes, 12) != 15 ||
            byteWord(bytes, 13) != wireLengthValue ||
            byteWord(bytes, 14) != 1000 ||
            byteWord(bytes, 15) != canonicalChecksumValue ||
            byteWord(bytes, 16) != modelFormatChecksumValue ||
            byteWord(bytes, 17) != characterChecksumValue ||
            byteWord(bytes, 18) != boneChecksumValue ||
            byteWord(bytes, 19) != animationChecksumValue) { return false }
        var boneBase = blockbenchCanonicalHeaderWords()
        var cubeBase = boneBase + boneCountValue * 15
        var animationBase = cubeBase + cubeCountValue * 24
        var keyframeBase = animationBase + animationCountValue * 7
        if (keyframeBase + keyframeCountValue * 15 != wireLengthValue) {
            return false
        }
        var reopenedRoots = 0
        var reopenedDepth = 0
        for (var index = 0; index < boneCountValue; index = index + 1) {
            var offset = boneBase + index * 15
            var parentLength = byteWord(bytes, offset + 6)
            var depth = byteWord(bytes, offset + 14)
            if (byteWord(bytes, offset + 2) != 36 || depth <= 0 ||
                depth > 16 || (parentLength != 0 && parentLength != 36)) {
                return false
            }
            if (parentLength == 0) {
                if (depth != 1) { return false }
                reopenedRoots = reopenedRoots + 1
            } else if (depth <= 1 ||
                !wireIdentityExists(bytes, boneBase, boneCountValue, 15,
                    byteWord(bytes, offset + 4),
                    byteWord(bytes, offset + 5), parentLength)) {
                return false
            }
            if (depth > reopenedDepth) { reopenedDepth = depth }
        }
        if (reopenedRoots != rootBoneCountValue ||
            reopenedDepth != maxBoneDepthValue) { return false }
        for (var index = 0; index < cubeCountValue; index = index + 1) {
            var offset = cubeBase + index * 24
            if (byteWord(bytes, offset + 2) != 36 ||
                byteWord(bytes, offset + 6) != 36 ||
                !wireIdentityExists(bytes, boneBase, boneCountValue, 15,
                    byteWord(bytes, offset + 4), byteWord(bytes, offset + 5),
                    byteWord(bytes, offset + 6))) { return false }
        }
        var reopenedKeyframes = 0
        for (var index = 0; index < animationCountValue; index = index + 1) {
            var offset = animationBase + index * 7
            var loop = byteWord(bytes, offset + 4)
            var count = byteWord(bytes, offset + 6)
            if (byteWord(bytes, offset + 2) != 36 ||
                loop < 1 || loop > 3 || byteWord(bytes, offset + 5) <= 0 ||
                count < 0 || count > keyframeCountValue - reopenedKeyframes) {
                return false
            }
            reopenedKeyframes = reopenedKeyframes + count
        }
        if (reopenedKeyframes != keyframeCountValue) { return false }
        for (var index = 0; index < keyframeCountValue; index = index + 1) {
            var offset = keyframeBase + index * 15
            var animationOffset = wireIdentityOffset(
                bytes, animationBase, animationCountValue, 7,
                byteWord(bytes, offset + 3), byteWord(bytes, offset + 4),
                byteWord(bytes, offset + 5))
            if (byteWord(bytes, offset + 2) != 36 ||
                byteWord(bytes, offset + 5) != 36 ||
                byteWord(bytes, offset + 8) != 36 ||
                animationOffset < 0 ||
                !wireIdentityExists(bytes, boneBase, boneCountValue, 15,
                    byteWord(bytes, offset + 6), byteWord(bytes, offset + 7),
                    byteWord(bytes, offset + 8)) ||
                byteWord(bytes, offset + 9) < 1 ||
                byteWord(bytes, offset + 9) > 3 ||
                byteWord(bytes, offset + 10) < 1 ||
                byteWord(bytes, offset + 10) > 2 ||
                byteWord(bytes, offset + 11) < 0 ||
                byteWord(bytes, offset + 11) >
                    byteWord(bytes, animationOffset + 5)) { return false }
        }
        var check = 17
        for (var index = 0; index < wireLengthValue; index = index + 1) {
            if (index != 15) { check = mix(check, byteWord(bytes, index)) }
        }
        return check == canonicalChecksumValue
    }

    Bool read(Int[] source) {
        clear()
        if (source.length <= 0 || source.length > 1048576) {
            diagnosticValue = blockbenchDiagnosticCapacity()
            return false
        }
        for (var index = 0; index < source.length; index = index + 1) {
            if (source[index] < 0 || source[index] > 255) {
                diagnosticValue = blockbenchDiagnosticJson()
                return false
            }
        }
        if (!validUtf8(source)) {
            diagnosticValue = blockbenchDiagnosticJson()
            return false
        }
        sourceValue = source
        sourceChecksumValue = checksum(source)
        parseCursorValue = 0
        var root = parseValue(-1, -1, -1, 0)
        skipWhitespace()
        if (root < 0 || tokenKinds[root] != 1 ||
            parseCursorValue != source.length || !parseMeta(root)) {
            if (diagnosticValue == blockbenchDiagnosticNone()) {
                if (parseCapacityExceededValue) {
                    diagnosticValue = blockbenchDiagnosticCapacity()
                } else {
                    diagnosticValue = blockbenchDiagnosticJson()
                }
            }
            sourceValue = new Int[0]
            return false
        }
        if (!parseBones(root) || !parseCubes(root) || !parseHierarchy(root) ||
            !parseAnimations(root)) {
            sourceValue = new Int[0]
            return false
        }
        if (!buildCanonical() || !reopenCanonical()) {
            diagnosticValue = blockbenchDiagnosticCanonical()
            sourceValue = new Int[0]
            return false
        }
        sourceValue = new Int[0]
        acceptedValue = true
        diagnosticValue = blockbenchDiagnosticNone()
        return true
    }

    Int[] encodedCanonicalBytes() {
        if (wireLengthValue <= 0) { return new Int[0] }
        var result = new Int[wireLengthValue * 4]
        for (var index = 0; index < wireLengthValue; index = index + 1) {
            var value = wireWords[index]
            result[index * 4] = value & 255
            result[index * 4 + 1] = (value >>> 8) & 255
            result[index * 4 + 2] = (value >>> 16) & 255
            result[index * 4 + 3] = (value >>> 24) & 255
        }
        return result
    }

    Int[] canonicalBytes() {
        if (!acceptedValue) { return new Int[0] }
        return encodedCanonicalBytes()
    }

    Int canonicalLength() {
        if (!acceptedValue) { return 0 }
        return wireLengthValue
    }

    Int canonicalWord(Int index) {
        if (!acceptedValue || index < 0 || index >= wireLengthValue) { return -1 }
        return wireWords[index]
    }

    Int canonicalByteLength() {
        if (!acceptedValue) { return 0 }
        return wireLengthValue * 4
    }

    Bool accepted() { return acceptedValue }
    Int diagnostic() { return diagnosticValue }
    Int sourceChecksum() { return sourceChecksumValue }
    Int modelFormatChecksum() { return modelFormatChecksumValue }
    Int characterChecksum() { return characterChecksumValue }
    Int boneChecksum() { return boneChecksumValue }
    Int animationChecksum() { return animationChecksumValue }
    Int canonicalChecksum() { return canonicalChecksumValue }
    Int canonicalHeaderWords() { return blockbenchCanonicalHeaderWords() }
    Int boneCount() { return boneCountValue }
    Int cubeCount() { return cubeCountValue }
    Int animationCount() { return animationCountValue }
    Int keyframeCount() { return keyframeCountValue }
    Int rootBoneCount() { return rootBoneCountValue }
    Int maxBoneDepth() { return maxBoneDepthValue }
}