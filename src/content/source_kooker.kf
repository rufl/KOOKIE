package content

Int sourceKindGlb() { return 1 }
Int sourceKindDust3d() { return 2 }
Int sourceKindAseprite() { return 3 }
Int sourceKindVox() { return 4 }
Int sourceKindQuakeMap() { return 5 }
Int sourceKindBlockbench() { return 6 }
Int sourceKindPng() { return 7 }
Int sourceKindWav() { return 8 }
Int sourceKindOgg() { return 9 }
Int sourceKindSvg() { return 10 }
Int sourceKindSvgz() { return 11 }

record SourceCookResult(
    Bool accepted,
    Int sourceKind,
    Int diagnostic,
    Int sourceChecksum,
    Int geometryChecksum,
    Int collisionChecksum,
    Int materialChecksum,
    Int metadataChecksum,
    Int entityChecksum,
    Int visibilityChecksum,
    Int primaryCount,
    Int secondaryCount
)

class BoundedSourceKooker {
    BoundedExternalGlbSceneReader glbValue
    BoundedAuthoredCollision glbCollisionValue
    BoundedDust3dIntake dust3dValue
    BoundedAsepriteIntake spriteValue
    BoundedVoxIntake voxValue
    BoundedQuakeMapIntake mapValue
    BoundedBlockbenchIntake blockbenchValue
    BoundedPngIntake pngValue
    BoundedWavIntake wavValue
    BoundedOggIntake oggValue
    BoundedSvgIntake svgValue
    SourceCookResult resultValue

    public constructor() {
        glbValue = BoundedExternalGlbSceneReader(256, 256)
        glbCollisionValue = BoundedAuthoredCollision(256, 256)
        dust3dValue = BoundedDust3dIntake(256, 256)
        spriteValue = BoundedAsepriteIntake(262144)
        voxValue = BoundedVoxIntake(20)
        mapValue = BoundedQuakeMapIntake(8192)
        blockbenchValue = BoundedBlockbenchIntake()
        pngValue = BoundedPngIntake(65536)
        wavValue = BoundedWavIntake()
        oggValue = BoundedOggIntake()
        svgValue = BoundedSvgIntake()
        resultValue = rejected(sourceKindGlb(), 0)
    }

    SourceCookResult rejected(Int kind, Int diagnostic) {
        return SourceCookResult(
            false, kind, diagnostic, 0, 0, 0, 0, 0, 0, 0, 0, 0)
    }

    Int checksum(Int[] source) {
        var result = 17
        for (var index = 0; index < source.length; index = index + 1) {
            result = (result * 31 + source[index]) % 1000003
        }
        return result
    }

    Bool cookGlb(
        Int[] source, Int namespaceId, Int assetId, Int revision,
        Int toolVersion, Int optionsChecksum, Int coordinateScale
    ) {
        resultValue = rejected(sourceKindGlb(), 1)
        glbCollisionValue.clear()
        if (!glbValue.read(
                source, ExternalGlbReadRequest(
                    namespaceId, assetId, revision, toolVersion,
                    optionsChecksum, coordinateScale)) ||
            !glbValue.reopenCanonical() ||
            !glbValue.emitCollision(glbCollisionValue) ||
            !glbCollisionValue.validate() || !glbCollisionValue.encode()) {
            return false
        }
        resultValue = SourceCookResult(
            true, sourceKindGlb(), 0, checksum(source),
            glbValue.geometryChecksum(), glbCollisionValue.checksum(),
            optionsChecksum, 0, 0, 0,
            glbValue.vertexCount(), glbValue.triangleCount())
        return true
    }

    Bool cookDust3d(
        Int[] source, Int[] exportedGlb,
        Int namespaceId, Int assetId, Int revision,
        Int toolVersion, Int optionsChecksum, Int coordinateScale
    ) {
        resultValue = rejected(sourceKindDust3d(), dust3dDiagnosticSource())
        if (!dust3dValue.read(
                source, exportedGlb, namespaceId, assetId, revision,
                toolVersion, optionsChecksum, coordinateScale)) {
            resultValue = rejected(sourceKindDust3d(), dust3dValue.diagnostic())
            return false
        }
        resultValue = SourceCookResult(
            true, sourceKindDust3d(), 0, dust3dValue.sourceChecksum(),
            dust3dValue.geometryChecksum(), dust3dValue.collisionChecksum(),
            dust3dValue.materialChecksum(), 0, 0, 0,
            dust3dValue.vertexCount(), dust3dValue.triangleCount())
        return true
    }

    Bool cookAseprite(Int[] source) {
        resultValue = rejected(sourceKindAseprite(), spriteDiagnosticHeader())
        if (!spriteValue.read(source)) {
            resultValue = rejected(sourceKindAseprite(), spriteValue.diagnostic())
            return false
        }
        resultValue = SourceCookResult(
            true, sourceKindAseprite(), 0, spriteValue.sourceChecksum(),
            0, 0, 0, spriteValue.metadataChecksum(), 0, 0,
            spriteValue.frameCount(), spriteValue.pngLength())
        return true
    }

    Bool cookVox(
        Int[] source, Int namespaceId, Int assetId,
        Int revision, Int coordinateScale
    ) {
        resultValue = rejected(sourceKindVox(), voxDiagnosticHeader())
        if (!voxValue.read(
                source, namespaceId, assetId, revision, coordinateScale)) {
            resultValue = rejected(sourceKindVox(), voxValue.diagnostic())
            return false
        }
        resultValue = SourceCookResult(
            true, sourceKindVox(), 0, voxValue.sourceChecksum(),
            voxValue.geometryChecksum(), voxValue.collisionChecksum(),
            voxValue.materialChecksum(), voxValue.sceneNodeCount(), 0, 0,
            voxValue.voxelCount(), voxValue.modelCount())
        return true
    }

    Bool cookQuakeMap(
        Int[] source, Int namespaceId, Int assetId,
        Int revision, Int coordinateScale
    ) {
        resultValue = rejected(sourceKindQuakeMap(), mapDiagnosticSyntax())
        if (!mapValue.read(
                source, namespaceId, assetId, revision, coordinateScale)) {
            resultValue = rejected(sourceKindQuakeMap(), mapValue.diagnostic())
            return false
        }
        resultValue = SourceCookResult(
            true, sourceKindQuakeMap(), 0, mapValue.sourceChecksum(),
            mapValue.geometryChecksum(), mapValue.collisionChecksum(),
            mapValue.materialChecksum(), 0, mapValue.entityChecksum(),
            mapValue.visibilityChecksum(),
            mapValue.brushCount(), mapValue.triangleCount())
        return true
    }

    Bool cookBlockbench(Int[] source) {
        resultValue = rejected(
            sourceKindBlockbench(), blockbenchDiagnosticJson())
        if (!blockbenchValue.read(source)) {
            resultValue = rejected(
                sourceKindBlockbench(), blockbenchValue.diagnostic())
            return false
        }
        resultValue = SourceCookResult(
            true, sourceKindBlockbench(), 0,
            blockbenchValue.sourceChecksum(),
            blockbenchValue.characterChecksum(), 0, 0,
            blockbenchValue.boneChecksum(),
            blockbenchValue.animationChecksum(),
            blockbenchValue.canonicalChecksum(),
            blockbenchValue.boneCount(),
            blockbenchValue.animationCount())
        return true
    }

    Bool cookPng(Int[] source) {
        resultValue = rejected(sourceKindPng(), pngImageDiagnosticHeader())
        if (!pngValue.read(source)) {
            resultValue = rejected(sourceKindPng(), pngValue.diagnostic())
            return false
        }
        resultValue = SourceCookResult(
            true, sourceKindPng(), 0, pngValue.sourceChecksum(),
            0, 0, pngValue.pixelChecksum(), pngValue.metadataChecksum(),
            0, pngValue.canonicalChecksum(),
            pngValue.width(), pngValue.height())
        return true
    }

    Bool cookWav(Int[] source) {
        resultValue = rejected(sourceKindWav(), wavDiagnosticHeader())
        if (!wavValue.read(source)) {
            resultValue = rejected(sourceKindWav(), wavValue.diagnostic())
            return false
        }
        resultValue = SourceCookResult(
            true, sourceKindWav(), 0, wavValue.sourceChecksum(),
            0, 0, wavValue.sampleChecksum(), wavValue.metadataChecksum(),
            0, wavValue.canonicalChecksum(),
            wavValue.frameCount(), wavValue.channelCount())
        return true
    }

    Bool cookOgg(Int[] source) {
        resultValue = rejected(sourceKindOgg(), oggDiagnosticHeader())
        if (!oggValue.read(source)) {
            resultValue = rejected(sourceKindOgg(), oggValue.diagnostic())
            return false
        }
        resultValue = SourceCookResult(
            true, sourceKindOgg(), 0, oggValue.sourceChecksum(),
            0, 0, oggValue.payloadChecksum(),
            oggValue.metadataChecksum(), 0, oggValue.canonicalChecksum(),
            oggValue.frameCount(), oggValue.channelCount())
        return true
    }
    Bool cookSvg(Int[] source, Bool gzip) {
        var kind = if (gzip) sourceKindSvgz() else sourceKindSvg()
        resultValue = rejected(kind, svgDiagnosticHeader())
        if (!svgValue.read(source, gzip)) {
            resultValue = rejected(kind, svgValue.diagnostic())
            return false
        }
        resultValue = SourceCookResult(
            true, kind, 0, svgValue.sourceChecksum(),
            svgValue.geometryChecksum(), 0, svgValue.materialChecksum(),
            svgValue.metadataChecksum(), 0, svgValue.canonicalChecksum(),
            svgValue.shapeCount(), svgValue.parameterCount())
        return true
    }


    SourceCookResult result() { return resultValue }
    BoundedExternalGlbSceneReader glb() { return glbValue }
    BoundedAuthoredCollision glbCollision() { return glbCollisionValue }
    BoundedDust3dIntake dust3d() { return dust3dValue }
    BoundedAsepriteIntake sprite() { return spriteValue }
    BoundedVoxIntake vox() { return voxValue }
    BoundedQuakeMapIntake quakeMap() { return mapValue }
    BoundedBlockbenchIntake blockbench() { return blockbenchValue }
    BoundedPngIntake png() { return pngValue }
    BoundedWavIntake wav() { return wavValue }
    BoundedOggIntake ogg() { return oggValue }
    BoundedSvgIntake svg() { return svgValue }
}
