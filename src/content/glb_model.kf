package content


Int glbModelTargetHeightFixed() { return 2000 }

class BoundedExternalGlbModelReader {
    Int[] sourceValue
    Int[] json
    Int jsonLengthValue
    Int binOffsetValue
    Int binLengthValue
    Int[] viewOffsets
    Int[] viewLengths
    Int[] viewStrides
    Int viewCountValue
    Int[] accessorViews
    Int[] accessorOffsets
    Int[] accessorComponents
    Int[] accessorCounts
    Int[] accessorKinds
    Int accessorCountValue
    Int[] primitivePosition
    Int[] primitiveIndex
    Int[] primitiveTexcoord
    Int[] primitiveMesh
    Int[] primitiveMode
    Int[] primitiveMaterial
    Int[] primitiveJoints
    Int[] primitiveWeights
    Int primitiveCountValue
    Int meshCountValue
    Int[] nodeMesh
    Int[] nodeParent
    Int[] nodeSkin
    Int[] nodeMatrices
    Int[] nodeWorldMatrices
    Bool[] nodeWorldReady
    Bool[] nodeWorldVisiting
    Int[] nodeTranslation
    Int[] nodeRotation
    Int[] nodeScale
    Bool[] nodeHasTrs
    Int nodeCountValue
    Int[] skinJointOffsets
    Int[] skinJointCounts
    Int[] skinJoints
    Int[] skinInverseBindAccessors
    Int skinCountValue
    Int skinJointCountValue
    Int[] skinInverseBindMatrices
    Int[] animationChannelNodes
    Int[] animationChannelPaths
    Int[] animationChannelInputs
    Int[] animationChannelOutputs
    Int[] animationChannelInterpolations
    Int[] animationStateStarts
    Int[] animationStateCounts
    Int[] animationStateDurations
    Int animationChannelCount
    Int[] animationSampleValue
    Int[] animationLeftValue
    Int[] animationRightValue
    Int[] poseScratchMatrix
    Int[] poseScratchMatrixTwo
    Int[] poseTranslation
    Int[] poseRotation
    Int[] poseScale
    Int[] poseLocalMatrices
    Int[] poseWorldMatrices
    Int[] poseMeshInverseMatrices
    Bool[] poseWorldReady
    Bool[] poseWorldVisiting
    Bool[] poseMeshInverseReady
    Int[] poseVertexX
    Int[] poseVertexY
    Int[] poseVertexZ
    Bool poseValidValue
    Int animationPoseDiagnosticValue
    Int[] vertexSourceXValue
    Int[] vertexSourceYValue
    Int[] vertexSourceZValue
    Int[] vertexNodeValue
    Int[] vertexSkinValue
    Int modelCenterXValue
    Int modelMinYValue
    Int modelCenterZValue
    Int modelHeightValue
    Int[] scratch
    Int modelValue
    Int coordinateScaleValue
    Int transformScaleValue
    Int[] vertexXValue
    Int[] vertexYValue
    Int[] vertexZValue
    Int[] vertexUValue
    Int[] vertexVValue
    Int[] vertexJointValue
    Int[] vertexWeightValue
    Int[] vertexMaterialValue
    Int vertexCountValue
    Int triangleCountValue
    Int textureOffsetValue
    Int textureLengthValue
    Int textureWidthValue
    Int textureHeightValue
    Bool textureValidValue
    Bool readValue

    public constructor() {
        sourceValue = new Int[0]
        json = new Int[65536]
        viewOffsets = new Int[256]
        viewLengths = new Int[256]
        viewStrides = new Int[256]
        accessorViews = new Int[256]
        accessorOffsets = new Int[256]
        accessorComponents = new Int[256]
        accessorCounts = new Int[256]
        accessorKinds = new Int[256]
        primitivePosition = new Int[128]
        primitiveIndex = new Int[128]
        primitiveTexcoord = new Int[128]
        primitiveJoints = new Int[128]
        primitiveWeights = new Int[128]
        primitiveMesh = new Int[128]
        primitiveMode = new Int[128]
        primitiveMaterial = new Int[128]
        nodeMesh = new Int[256]
        nodeParent = new Int[256]
        nodeSkin = new Int[256]
        nodeMatrices = new Int[256 * 12]
        nodeWorldMatrices = new Int[256 * 12]
        nodeWorldReady = new Bool[256]
        nodeWorldVisiting = new Bool[256]
        nodeTranslation = new Int[256 * 3]
        nodeRotation = new Int[256 * 4]
        nodeScale = new Int[256 * 3]
        nodeHasTrs = new Bool[256]
        skinJointOffsets = new Int[64]
        skinJointCounts = new Int[64]
        skinJoints = new Int[2048]
        skinInverseBindAccessors = new Int[64]
        skinInverseBindMatrices = new Int[2048 * 12]
        animationChannelNodes = new Int[256]
        animationChannelPaths = new Int[256]
        animationChannelInputs = new Int[256]
        animationChannelOutputs = new Int[256]
        animationChannelInterpolations = new Int[256]
        animationStateStarts = new Int[8]
        animationStateCounts = new Int[8]
        animationStateDurations = new Int[8]
        animationSampleValue = new Int[4]
        animationLeftValue = new Int[4]
        animationRightValue = new Int[4]
        poseScratchMatrix = new Int[12]
        poseScratchMatrixTwo = new Int[12]
        poseTranslation = new Int[256 * 3]
        poseRotation = new Int[256 * 4]
        poseScale = new Int[256 * 3]
        poseLocalMatrices = new Int[256 * 12]
        poseWorldMatrices = new Int[256 * 12]
        poseMeshInverseMatrices = new Int[256 * 12]
        poseWorldReady = new Bool[256]
        poseWorldVisiting = new Bool[256]
        poseMeshInverseReady = new Bool[256]
        poseVertexX = new Int[0]
        poseVertexY = new Int[0]
        poseVertexZ = new Int[0]
        vertexSourceXValue = new Int[0]
        vertexSourceYValue = new Int[0]
        vertexSourceZValue = new Int[0]
        vertexNodeValue = new Int[0]
        vertexSkinValue = new Int[0]
        scratch = new Int[16]
        vertexXValue = new Int[0]
        vertexYValue = new Int[0]
        vertexZValue = new Int[0]
        vertexUValue = new Int[0]
        vertexVValue = new Int[0]
        vertexMaterialValue = new Int[0]
        vertexJointValue = new Int[0]
        vertexWeightValue = new Int[0]
        clear()
    }

    Bool clear() {
        sourceValue = new Int[0]
        jsonLengthValue = 0
        binOffsetValue = 0
        binLengthValue = 0
        viewCountValue = 0
        accessorCountValue = 0
        primitiveCountValue = 0
        meshCountValue = 0
        nodeCountValue = 0
        skinCountValue = 0
        skinJointCountValue = 0
        animationChannelCount = 0
        modelValue = 0
        coordinateScaleValue = 100000
        transformScaleValue = 1000000
        modelCenterXValue = 0
        modelMinYValue = 0
        modelCenterZValue = 0
        modelHeightValue = 0
        vertexCountValue = 0
        triangleCountValue = 0
        textureOffsetValue = -1
        textureLengthValue = 0
        textureValidValue = false
        poseValidValue = false
        animationPoseDiagnosticValue = 0
        readValue = false
        for (var index = 0; index < nodeWorldReady.length; index = index + 1) {
            nodeWorldReady[index] = false
            nodeWorldVisiting[index] = false
            poseWorldReady[index] = false
            poseWorldVisiting[index] = false
            poseMeshInverseReady[index] = false
            nodeMesh[index] = -1
            nodeParent[index] = -1
            nodeSkin[index] = -1
            nodeHasTrs[index] = false
        }
        for (var index = 0; index < skinJointOffsets.length; index = index + 1) {
            skinJointOffsets[index] = 0
            skinJointCounts[index] = 0
            skinInverseBindAccessors[index] = -1
        }
        for (var index = 0; index < animationStateStarts.length; index = index + 1) {
            animationStateStarts[index] = -1
            animationStateCounts[index] = 0
            animationStateDurations[index] = 0
        }
        return true
    }

    Int skipWhitespace(Int position, Int limit) {
        var cursor = position
        while (cursor < limit &&
            (json[cursor] == 32 || json[cursor] == 9 ||
                json[cursor] == 10 || json[cursor] == 13)) {
            cursor = cursor + 1
        }
        return cursor
    }

    Int stringEnd(Int start, Int limit) {
        var escaped = false
        for (var cursor = start + 1; cursor < limit; cursor = cursor + 1) {
            if (escaped) {
                escaped = false
            } else if (json[cursor] == 92) {
                escaped = true
            } else if (json[cursor] == 34) {
                return cursor
            }
        }
        return -1
    }

    Int objectEnd(Int start, Int limit) {
        if (start < 0 || start >= limit || json[start] != 123) { return -1 }
        var objects = 0
        var arrays = 0
        var cursor = start
        while (cursor < limit) {
            if (json[cursor] == 34) {
                cursor = stringEnd(cursor, limit)
                if (cursor < 0) { return -1 }
            } else if (json[cursor] == 123) {
                objects = objects + 1
            } else if (json[cursor] == 125) {
                objects = objects - 1
                if (objects == 0 && arrays == 0) { return cursor }
            } else if (json[cursor] == 91) {
                arrays = arrays + 1
            } else if (json[cursor] == 93) {
                arrays = arrays - 1
            }
            if (objects < 0 || arrays < 0) { return -1 }
            cursor = cursor + 1
        }
        return -1
    }

    Int arrayEnd(Int start, Int limit) {
        if (start < 0 || start >= limit || json[start] != 91) { return -1 }
        var objects = 0
        var arrays = 0
        var cursor = start
        while (cursor < limit) {
            if (json[cursor] == 34) {
                cursor = stringEnd(cursor, limit)
                if (cursor < 0) { return -1 }
            } else if (json[cursor] == 123) {
                objects = objects + 1
            } else if (json[cursor] == 125) {
                objects = objects - 1
            } else if (json[cursor] == 91) {
                arrays = arrays + 1
            } else if (json[cursor] == 93) {
                arrays = arrays - 1
                if (objects == 0 && arrays == 0) { return cursor }
            }
            if (objects < 0 || arrays < 0) { return -1 }
            cursor = cursor + 1
        }
        return -1
    }

    Bool keyEquals(Int start, Int end, String name) {
        if (end - start - 1 != name.length()) { return false }
        for (var index = 0; index < name.length(); index = index + 1) {
            if (json[start + 1 + index] != (name.charAt(index) as Int)) {
                return false
            }
        }
        return true
    }

    Int fieldValueStart(Int objectStart, Int objectLimit, String name) {
        if (objectStart < 0 || objectLimit <= objectStart ||
            json[objectStart] != 123) {
            return -1
        }
        var objectDepth = 1
        var arrayDepth = 0
        var cursor = objectStart + 1
        while (cursor < objectLimit) {
            if (json[cursor] == 34) {
                var end = stringEnd(cursor, objectLimit)
                if (end < 0) { return -1 }
                if (objectDepth == 1 && arrayDepth == 0 &&
                    keyEquals(cursor, end, name)) {
                    var colon = skipWhitespace(end + 1, objectLimit)
                    if (colon < objectLimit && json[colon] == 58) {
                        return skipWhitespace(colon + 1, objectLimit)
                    }
                }
                cursor = end
            } else if (json[cursor] == 123) {
                objectDepth = objectDepth + 1
            } else if (json[cursor] == 125) {
                objectDepth = objectDepth - 1
            } else if (json[cursor] == 91) {
                arrayDepth = arrayDepth + 1
            } else if (json[cursor] == 93) {
                arrayDepth = arrayDepth - 1
            }
            cursor = cursor + 1
        }
        return -1
    }

    Int numberEnd(Int start, Int limit) {
        if (start < 0 || start >= limit) { return -1 }
        var cursor = start
        if (json[cursor] == 45) { cursor = cursor + 1 }
        var digits = 0
        while (cursor < limit && json[cursor] >= 48 && json[cursor] <= 57) {
            digits = digits + 1
            cursor = cursor + 1
        }
        if (digits == 0) { return -1 }
        if (cursor < limit && json[cursor] == 46) {
            cursor = cursor + 1
            var fractions = 0
            while (cursor < limit && json[cursor] >= 48 && json[cursor] <= 57) {
                fractions = fractions + 1
                cursor = cursor + 1
            }
            if (fractions == 0) { return -1 }
        }
        if (cursor < limit && (json[cursor] == 101 || json[cursor] == 69)) {
            cursor = cursor + 1
            if (cursor < limit && (json[cursor] == 43 || json[cursor] == 45)) {
                cursor = cursor + 1
            }
            var exponents = 0
            while (cursor < limit && json[cursor] >= 48 && json[cursor] <= 57) {
                exponents = exponents + 1
                cursor = cursor + 1
            }
            if (exponents == 0) { return -1 }
        }
        return cursor
    }

    Int fixedNumber(Int start, Int end, Int scale) {
        if (start < 0 || end <= start || scale <= 0 || scale > 1000000) {
            return 2000000000
        }
        var cursor = start
        var negative = false
        if (json[cursor] == 45) {
            negative = true
            cursor = cursor + 1
        }
        var whole: Long = 0L
        while (cursor < end && json[cursor] >= 48 && json[cursor] <= 57) {
            var digit = json[cursor] - 48
            if (whole > (1000000000L - digit) / 10L) {
                return 2000000000
            }
            whole = whole * 10L + digit
            cursor = cursor + 1
        }
        var fraction: Long = 0L
        var divisor: Long = 1L
        if (cursor < end && json[cursor] == 46) {
            cursor = cursor + 1
            while (cursor < end && json[cursor] >= 48 && json[cursor] <= 57) {
                if (divisor < 1000000000L) {
                    fraction = fraction * 10L + (json[cursor] - 48)
                    divisor = divisor * 10L
                }
                cursor = cursor + 1
            }
        }
        if (whole > 1000000000L / scale) { return 2000000000 }
        var scaled = whole * scale
        var fractional = fraction * scale / divisor
        if (scaled > 1000000000L - fractional) { return 2000000000 }
        scaled = scaled + fractional
        if (cursor < end && (json[cursor] == 101 || json[cursor] == 69)) {
            cursor = cursor + 1
            var exponentNegative = false
            if (cursor < end && json[cursor] == 45) {
                exponentNegative = true
                cursor = cursor + 1
            } else if (cursor < end && json[cursor] == 43) {
                cursor = cursor + 1
            }
            var exponent = 0
            while (cursor < end && json[cursor] >= 48 && json[cursor] <= 57) {
                exponent = exponent * 10 + json[cursor] - 48
                if (exponent > 18) {
                    if (!exponentNegative) { return 2000000000 }
                    exponent = 18
                }
                cursor = cursor + 1
            }
            for (var power = 0; power < exponent; power = power + 1) {
                if (exponentNegative) {
                    scaled = scaled / 10L
                } else {
                    if (scaled > 100000000L) { return 2000000000 }
                    scaled = scaled * 10L
                }
            }
        }
        if (negative) { scaled = -scaled }
        if (scaled < -1000000000L || scaled > 1000000000L) {
            return 2000000000
        }
        return scaled.toInt()
    }

    Int integerAt(Int start, Int limit) {
        var end = numberEnd(start, limit)
        if (end < 0) { return -1 }
        var negative = json[start] == 45
        var value = fixedNumber(start, end, 1)
        if (value == 2000000000 || (!negative && value < 0)) { return -1 }
        return value
    }

    Int integerField(Int objectStart, Int objectLimit, String name) {
        var start = fieldValueStart(objectStart, objectLimit, name)
        if (start < 0) { return -1 }
        return integerAt(start, objectLimit)
    }

    Bool parseFixedArray(
        Int start, Int limit, Int count, Int scale, Int scratchOffset
    ) {
        if (start < 0 || start >= limit || json[start] != 91 || count <= 0 ||
            scratchOffset < 0 || scratchOffset + count > scratch.length) {
            return false
        }
        var end = arrayEnd(start, limit)
        if (end < 0) { return false }
        var cursor = start + 1
        for (var index = 0; index < count; index = index + 1) {
            cursor = skipWhitespace(cursor, end)
            var valueEnd = numberEnd(cursor, end)
            if (valueEnd < 0) {
                return false
            }
            var value = fixedNumber(cursor, valueEnd, scale)
            if (value == 2000000000) {
                return false
            }
            scratch[scratchOffset + index] = value
            cursor = skipWhitespace(valueEnd, end)
            if (index + 1 < count) {
                if (cursor >= end || json[cursor] != 44) { return false }
                cursor = cursor + 1
            }
        }
        if (skipWhitespace(cursor, end) != end) {
            return false
        }
        return true
    }

    Int scaled(Int first, Int second, Int divisor) {
        var result: Long = first
        result = result * second / divisor
        if (result < -1000000000L || result > 1000000000L) {
            return 2000000000
        }
        return result.toInt()
    }

    Bool buildTrsMatrix(Int objectStart, Int objectLimit, Int nodeIndex) {
        var tx = 0
        var ty = 0
        var tz = 0
        var sx = transformScaleValue
        var sy = transformScaleValue
        var sz = transformScaleValue
        var qx = 0
        var qy = 0
        var qz = 0
        var qw = transformScaleValue
        var translation = fieldValueStart(objectStart, objectLimit, "translation")
        var rotation = fieldValueStart(objectStart, objectLimit, "rotation")
        var scale = fieldValueStart(objectStart, objectLimit, "scale")
        if (translation >= 0 && !parseFixedArray(
                translation, objectLimit, 3, coordinateScaleValue, 0)) {
            return false
        }
        if (translation >= 0) {
            tx = scratch[0]
            ty = scratch[1]
            tz = scratch[2]
        }
        if (rotation >= 0 && !parseFixedArray(
                rotation, objectLimit, 4, transformScaleValue, 0)) {
            return false
        }
        if (rotation >= 0) {
            qx = scratch[0]
            qy = scratch[1]
            qz = scratch[2]
            qw = scratch[3]
        }
        if (scale >= 0 && !parseFixedArray(
                scale, objectLimit, 3, transformScaleValue, 0)) {
            return false
        }
        if (scale >= 0) {
            sx = scratch[0]
            sy = scratch[1]
            sz = scratch[2]
        }
        nodeHasTrs[nodeIndex] = true
        var transformOffset = nodeIndex * 3
        nodeTranslation[transformOffset] = tx
        nodeTranslation[transformOffset + 1] = ty
        nodeTranslation[transformOffset + 2] = tz
        nodeScale[transformOffset] = sx
        nodeScale[transformOffset + 1] = sy
        nodeScale[transformOffset + 2] = sz
        var rotationOffset = nodeIndex * 4
        nodeRotation[rotationOffset] = qx
        nodeRotation[rotationOffset + 1] = qy
        nodeRotation[rotationOffset + 2] = qz
        nodeRotation[rotationOffset + 3] = qw
        var norm: Long = qx
        norm = norm * qx
        var term: Long = qy
        term = term * qy
        norm = norm + term
        term = qz
        term = term * qz
        norm = norm + term
        term = qw
        term = term * qw
        norm = norm + term
        var expected: Long = transformScaleValue
        expected = expected * transformScaleValue
        var difference = norm - expected
        if (difference < 0L) { difference = -difference }
        if (difference > expected / 50L + transformScaleValue) {
            return false
        }
        var xx = scaled(qx, qx, transformScaleValue)
        var yy = scaled(qy, qy, transformScaleValue)
        var zz = scaled(qz, qz, transformScaleValue)
        var xy = scaled(qx, qy, transformScaleValue)
        var xz = scaled(qx, qz, transformScaleValue)
        var yz = scaled(qy, qz, transformScaleValue)
        var xw = scaled(qx, qw, transformScaleValue)
        var yw = scaled(qy, qw, transformScaleValue)
        var zw = scaled(qz, qw, transformScaleValue)
        if (xx == 2000000000 || yy == 2000000000 || zz == 2000000000 ||
            xy == 2000000000 || xz == 2000000000 || yz == 2000000000 ||
            xw == 2000000000 || yw == 2000000000 || zw == 2000000000) {
            return false
        }
        var r00 = transformScaleValue - 2 * (yy + zz)
        var r01 = 2 * (xy - zw)
        var r02 = 2 * (xz + yw)
        var r10 = 2 * (xy + zw)
        var r11 = transformScaleValue - 2 * (xx + zz)
        var r12 = 2 * (yz - xw)
        var r20 = 2 * (xz - yw)
        var r21 = 2 * (yz + xw)
        var r22 = transformScaleValue - 2 * (xx + yy)
        var offset = nodeIndex * 12
        nodeMatrices[offset] = scaled(r00, sx, transformScaleValue)
        nodeMatrices[offset + 1] = scaled(r01, sy, transformScaleValue)
        nodeMatrices[offset + 2] = scaled(r02, sz, transformScaleValue)
        nodeMatrices[offset + 3] = tx
        nodeMatrices[offset + 4] = scaled(r10, sx, transformScaleValue)
        nodeMatrices[offset + 5] = scaled(r11, sy, transformScaleValue)
        nodeMatrices[offset + 6] = scaled(r12, sz, transformScaleValue)
        nodeMatrices[offset + 7] = ty
        nodeMatrices[offset + 8] = scaled(r20, sx, transformScaleValue)
        nodeMatrices[offset + 9] = scaled(r21, sy, transformScaleValue)
        nodeMatrices[offset + 10] = scaled(r22, sz, transformScaleValue)
        nodeMatrices[offset + 11] = tz
        for (var element = 0; element < 12; element = element + 1) {
            if (nodeMatrices[offset + element] == 2000000000) { return false }
        }
        return true
    }

    Bool parseMatrixValues(Int start, Int limit, Int nodeIndex) {
        var end = arrayEnd(start, limit)
        if (end < 0 || !parseFixedArray(
                start, limit, 16, transformScaleValue, 0)) {
            return false
        }
        scratch[12] = scaled(
            scratch[12], coordinateScaleValue, transformScaleValue)
        scratch[13] = scaled(
            scratch[13], coordinateScaleValue, transformScaleValue)
        scratch[14] = scaled(
            scratch[14], coordinateScaleValue, transformScaleValue)
        var offset = nodeIndex * 12
        nodeMatrices[offset] = scratch[0]
        nodeMatrices[offset + 1] = scratch[4]
        nodeMatrices[offset + 2] = scratch[8]
        nodeMatrices[offset + 3] = scratch[12]
        nodeMatrices[offset + 4] = scratch[1]
        nodeMatrices[offset + 5] = scratch[5]
        nodeMatrices[offset + 6] = scratch[9]
        nodeMatrices[offset + 7] = scratch[13]
        nodeMatrices[offset + 8] = scratch[2]
        nodeMatrices[offset + 9] = scratch[6]
        nodeMatrices[offset + 10] = scratch[10]
        nodeMatrices[offset + 11] = scratch[14]
        return scratch[3] == 0 && scratch[7] == 0 && scratch[11] == 0 &&
            scratch[15] == transformScaleValue
    }

    Bool parseNodeMatrix(Int objectStart, Int objectLimit, Int nodeIndex) {
        var matrix = fieldValueStart(objectStart, objectLimit, "matrix")
        if (matrix >= 0) {
            nodeHasTrs[nodeIndex] = false
            return parseMatrixValues(matrix, objectLimit, nodeIndex)
        }
        return buildTrsMatrix(objectStart, objectLimit, nodeIndex)
    }

    Bool loadJson(Int[] source) {
        if (source.length < 20 || source.length > 1048576 ||
            source[0] != 103 || source[1] != 108 || source[2] != 84 ||
            source[3] != 70 || source[4] != 2 || source[5] != 0 ||
            source[6] != 0 || source[7] != 0 ||
            source[8] + source[9] * 256 + source[10] * 65536 +
                source[11] * 16777216 != source.length) {
            return false
        }
        var offset = 12
        var jsonFound = false
        var binFound = false
        while (offset + 8 <= source.length) {
            var length = source[offset] + source[offset + 1] * 256 +
                source[offset + 2] * 65536 + source[offset + 3] * 16777216
            var kind = source[offset + 4] + source[offset + 5] * 256 +
                source[offset + 6] * 65536 + source[offset + 7] * 16777216
            offset = offset + 8
            if (length < 0 || length % 4 != 0 || length > source.length - offset) {
                return false
            }
            if (kind == 1313821514) {
                if (jsonFound || length <= 0 || length > json.length) { return false }
                for (var index = 0; index < length; index = index + 1) {
                    json[index] = source[offset + index]
                }
                jsonLengthValue = length
                jsonFound = true
            } else if (kind == 5130562) {
                if (binFound || length <= 0) { return false }
                binOffsetValue = offset
                binLengthValue = length
                binFound = true
            } else {
                return false
            }
            offset = offset + length
        }
        return offset == source.length && jsonFound && binFound
    }

    Bool parseViews() {
        var start = fieldValueStart(0, jsonLengthValue, "bufferViews")
        var end = arrayEnd(start, jsonLengthValue)
        if (start < 0 || end < 0) { return false }
        var cursor = skipWhitespace(start + 1, end)
        while (cursor < end) {
            if (json[cursor] != 123 || viewCountValue >= viewOffsets.length) { return false }
            var objectLimit = objectEnd(cursor, end)
            if (objectLimit < 0) { return false }
            var buffer = integerField(cursor, objectLimit, "buffer")
            var offset = integerField(cursor, objectLimit, "byteOffset")
            var length = integerField(cursor, objectLimit, "byteLength")
            var stride = integerField(cursor, objectLimit, "byteStride")
            if (offset < 0) { offset = 0 }
            if (stride < 0) { stride = 0 }
            if (buffer != 0 || length <= 0 || offset > binLengthValue - length) {
                return false
            }
            viewOffsets[viewCountValue] = offset
            viewLengths[viewCountValue] = length
            viewStrides[viewCountValue] = stride
            viewCountValue = viewCountValue + 1
            cursor = skipWhitespace(objectLimit + 1, end)
            if (cursor < end && json[cursor] == 44) {
                cursor = skipWhitespace(cursor + 1, end)
            } else if (cursor != end) {
                return false
            }
        }
        return viewCountValue > 0
    }

    Int kindForType(Int objectStart, Int objectLimit) {
        var start = fieldValueStart(objectStart, objectLimit, "type")
        if (start < 0 || json[start] != 34) { return 0 }
        var end = stringEnd(start, objectLimit)
        if (end < 0) { return 0 }
        if (keyEquals(start, end, "SCALAR")) { return 1 }
        if (keyEquals(start, end, "VEC2")) { return 2 }
        if (keyEquals(start, end, "VEC3")) { return 3 }
        if (keyEquals(start, end, "VEC4")) { return 4 }
        if (keyEquals(start, end, "MAT4")) { return 44 }
        return 0
    }

    Bool parseAccessors() {
        var start = fieldValueStart(0, jsonLengthValue, "accessors")
        var end = arrayEnd(start, jsonLengthValue)
        if (start < 0 || end < 0) { return false }
        var cursor = skipWhitespace(start + 1, end)
        while (cursor < end) {
            if (json[cursor] != 123 || accessorCountValue >= accessorViews.length) {
                return false
            }
            var objectLimit = objectEnd(cursor, end)
            if (objectLimit < 0) { return false }
            accessorViews[accessorCountValue] =
                integerField(cursor, objectLimit, "bufferView")
            accessorOffsets[accessorCountValue] =
                integerField(cursor, objectLimit, "byteOffset")
            accessorComponents[accessorCountValue] =
                integerField(cursor, objectLimit, "componentType")
            accessorCounts[accessorCountValue] =
                integerField(cursor, objectLimit, "count")
            accessorKinds[accessorCountValue] = kindForType(cursor, objectLimit)
            if (accessorOffsets[accessorCountValue] < 0) {
                accessorOffsets[accessorCountValue] = 0
            }
            if (accessorViews[accessorCountValue] < 0 ||
                accessorCounts[accessorCountValue] <= 0 ||
                accessorKinds[accessorCountValue] == 0) {
                return false
            }
            accessorCountValue = accessorCountValue + 1
            cursor = skipWhitespace(objectLimit + 1, end)
            if (cursor < end && json[cursor] == 44) {
                cursor = skipWhitespace(cursor + 1, end)
            } else if (cursor != end) {
                return false
            }
        }
        return accessorCountValue > 0
    }

    Bool parseMeshes() {
        var start = fieldValueStart(0, jsonLengthValue, "meshes")
        var end = arrayEnd(start, jsonLengthValue)
        if (start < 0 || end < 0) { return false }
        var cursor = skipWhitespace(start + 1, end)
        while (cursor < end) {
            if (json[cursor] != 123 || meshCountValue >= 128) { return false }
            var meshLimit = objectEnd(cursor, end)
            if (meshLimit < 0) { return false }
            var primitives = fieldValueStart(cursor, meshLimit, "primitives")
            var primitiveEnd = arrayEnd(primitives, meshLimit)
            if (primitives < 0 || primitiveEnd < 0) { return false }
            var primitiveCursor = skipWhitespace(primitives + 1, primitiveEnd)
            while (primitiveCursor < primitiveEnd) {
                if (json[primitiveCursor] != 123 ||
                    primitiveCountValue >= primitivePosition.length) {
                    return false
                }
                var primitiveLimit = objectEnd(primitiveCursor, primitiveEnd)
                if (primitiveLimit < 0) { return false }
                var attributes = fieldValueStart(
                    primitiveCursor, primitiveLimit, "attributes")
                var attributesEnd = objectEnd(attributes, primitiveLimit)
                if (attributes < 0 || attributesEnd < 0) { return false }
                var position = integerField(attributes, attributesEnd, "POSITION")
                var indices = integerField(primitiveCursor, primitiveLimit, "indices")
                var texcoord = integerField(attributes, attributesEnd, "TEXCOORD_0")
                var joints = integerField(attributes, attributesEnd, "JOINTS_0")
                var weights = integerField(attributes, attributesEnd, "WEIGHTS_0")
                var mode = integerField(primitiveCursor, primitiveLimit, "mode")
                var material = integerField(primitiveCursor, primitiveLimit, "material")
                if (mode < 0) { mode = 4 }
                if (material < 0) { material = 0 }
                var skinPresent = joints >= 0 || weights >= 0
                if (position < 0 || indices < 0 || mode != 4 ||
                    position >= accessorCountValue || indices >= accessorCountValue ||
                    skinPresent && (joints < 0 || weights < 0 ||
                        joints >= accessorCountValue || weights >= accessorCountValue)) {
                    return false
                }
                if (skinPresent &&
                    (accessorKinds[joints] != 4 || accessorKinds[weights] != 4 ||
                        (accessorComponents[joints] != 5121 &&
                            accessorComponents[joints] != 5123) ||
                        accessorComponents[weights] != 5126 ||
                        accessorCounts[joints] != accessorCounts[position] ||
                        accessorCounts[weights] != accessorCounts[position])) {
                    return false
                }
                primitivePosition[primitiveCountValue] = position
                primitiveIndex[primitiveCountValue] = indices
                primitiveTexcoord[primitiveCountValue] = texcoord
                primitiveJoints[primitiveCountValue] = joints
                primitiveWeights[primitiveCountValue] = weights
                primitiveMesh[primitiveCountValue] = meshCountValue
                primitiveMode[primitiveCountValue] = mode
                primitiveMaterial[primitiveCountValue] = material
                primitiveCountValue = primitiveCountValue + 1
                primitiveCursor = skipWhitespace(primitiveLimit + 1, primitiveEnd)
                if (primitiveCursor < primitiveEnd && json[primitiveCursor] == 44) {
                    primitiveCursor = skipWhitespace(primitiveCursor + 1, primitiveEnd)
                } else if (primitiveCursor != primitiveEnd) {
                    return false
                }
            }
            meshCountValue = meshCountValue + 1
            cursor = skipWhitespace(meshLimit + 1, end)
            if (cursor < end && json[cursor] == 44) {
                cursor = skipWhitespace(cursor + 1, end)
            } else if (cursor != end) {
                return false
            }
        }
        return meshCountValue > 0 && primitiveCountValue > 0
    }

    Bool parseNodes() {
        var start = fieldValueStart(0, jsonLengthValue, "nodes")
        if (start < 0) { return false }
        var end = arrayEnd(start, jsonLengthValue)
        if (end < 0) { return false }
        var cursor = skipWhitespace(start + 1, end)
        while (cursor < end) {
            if (json[cursor] != 123 || nodeCountValue >= nodeMesh.length) {
                return false
            }
            var objectLimit = objectEnd(cursor, end)
            if (objectLimit < 0) { return false }
            nodeMesh[nodeCountValue] = integerField(cursor, objectLimit, "mesh")
            if (nodeMesh[nodeCountValue] < 0) { nodeMesh[nodeCountValue] = -1 }
            nodeSkin[nodeCountValue] = integerField(cursor, objectLimit, "skin")
            if (nodeSkin[nodeCountValue] < 0) { nodeSkin[nodeCountValue] = -1 }
            nodeParent[nodeCountValue] = -1
            if (!parseNodeMatrix(cursor, objectLimit, nodeCountValue)) {
                return false
            }
            nodeCountValue = nodeCountValue + 1
            cursor = skipWhitespace(objectLimit + 1, end)
            if (cursor < end && json[cursor] == 44) {
                cursor = skipWhitespace(cursor + 1, end)
            } else if (cursor != end) {
                return false
            }
        }
        cursor = skipWhitespace(start + 1, end)
        for (var node = 0; node < nodeCountValue; node = node + 1) {
            var objectLimit = objectEnd(cursor, end)
            if (objectLimit < 0) { return false }
            var children = fieldValueStart(cursor, objectLimit, "children")
            if (children >= 0) {
                var childrenEnd = arrayEnd(children, objectLimit)
                if (childrenEnd < 0) { return false }
                var childCursor = skipWhitespace(children + 1, childrenEnd)
                while (childCursor < childrenEnd) {
                    var child = integerAt(childCursor, childrenEnd)
                    if (child < 0 || child >= nodeCountValue) { return false }
                    nodeParent[child] = node
                    var childEnd = numberEnd(childCursor, childrenEnd)
                    childCursor = skipWhitespace(childEnd, childrenEnd)
                    if (childCursor < childrenEnd && json[childCursor] == 44) {
                        childCursor = skipWhitespace(childCursor + 1, childrenEnd)
                    } else if (childCursor != childrenEnd) {
                        return false
                    }
                }
            }
            cursor = skipWhitespace(objectLimit + 1, end)
            if (cursor < end && json[cursor] == 44) {
                cursor = skipWhitespace(cursor + 1, end)
            }
        }
        return nodeCountValue > 0
    }
    Bool stringEndsWith(Int start, Int end, String suffix) {
        if (start < 0 || end <= start + 1 || json[start] != 34 ||
            end <= start || suffix.length() > end - start - 1) {
            return false
        }
        var contentEnd = end
        for (var index = 0; index < suffix.length(); index = index + 1) {
            if (json[contentEnd - suffix.length() + index] !=
                    suffix.charAt(index) as Int) {
                return false
            }
        }
        return true
    }

    Int animationStateForName(Int objectStart, Int objectLimit) {
        var name = fieldValueStart(objectStart, objectLimit, "name")
        if (name < 0) { return 0 }
        var end = stringEnd(name, objectLimit)
        if (end < 0) { return 0 }
        if (stringEndsWith(name, end, "idle")) { return 1 }
        if (stringEndsWith(name, end, "run")) { return 2 }
        if (stringEndsWith(name, end, "attack")) { return 3 }
        if (stringEndsWith(name, end, "death")) { return 4 }
        if (stringEndsWith(name, end, "walk")) { return 5 }
        if (stringEndsWith(name, end, "damage_taken")) { return 6 }
        if (stringEndsWith(name, end, "eat")) { return 7 }
        return 0
    }

    Int animationPathKind(Int start, Int end) {
        if (start < 0 || end < 0 || json[start] != 34) { return 0 }
        if (keyEquals(start, end, "translation")) { return 1 }
        if (keyEquals(start, end, "rotation")) { return 2 }
        if (keyEquals(start, end, "scale")) { return 3 }
        return 0
    }

    Int animationInterpolationKind(
        Int objectStart, Int objectLimit
    ) {
        var interpolation = fieldValueStart(
            objectStart, objectLimit, "interpolation")
        if (interpolation < 0) { return 0 }
        var end = stringEnd(interpolation, objectLimit)
        if (end < 0) { return -1 }
        if (keyEquals(interpolation, end, "LINEAR")) { return 0 }
        if (keyEquals(interpolation, end, "STEP")) { return 1 }
        return -1
    }

    Bool parseSkins() {
        var start = fieldValueStart(0, jsonLengthValue, "skins")
        if (start < 0) { return true }
        var end = arrayEnd(start, jsonLengthValue)
        if (end < 0) { return false }
        var cursor = skipWhitespace(start + 1, end)
        while (cursor < end) {
            if (json[cursor] != 123 || skinCountValue >= skinJointOffsets.length) {
                return false
            }
            var objectLimit = objectEnd(cursor, end)
            if (objectLimit < 0) { return false }
            var joints = fieldValueStart(cursor, objectLimit, "joints")
            var jointsEnd = arrayEnd(joints, objectLimit)
            if (joints < 0 || jointsEnd < 0) { return false }
            var jointCursor = skipWhitespace(joints + 1, jointsEnd)
            var firstJoint = skinJointCountValue
            var jointCount = 0
            while (jointCursor < jointsEnd) {
                if (skinJointCountValue >= skinJoints.length) { return false }
                var joint = integerAt(jointCursor, jointsEnd)
                if (joint < 0 || joint >= nodeCountValue) { return false }
                skinJoints[skinJointCountValue] = joint
                skinJointCountValue = skinJointCountValue + 1
                jointCount = jointCount + 1
                var jointEnd = numberEnd(jointCursor, jointsEnd)
                jointCursor = skipWhitespace(jointEnd, jointsEnd)
                if (jointCursor < jointsEnd && json[jointCursor] == 44) {
                    jointCursor = skipWhitespace(jointCursor + 1, jointsEnd)
                } else if (jointCursor != jointsEnd) {
                    return false
                }
            }
            if (jointCount <= 0 || jointCount > 32) { return false }
            skinJointOffsets[skinCountValue] = firstJoint
            skinJointCounts[skinCountValue] = jointCount
            skinInverseBindAccessors[skinCountValue] =
                integerField(cursor, objectLimit, "inverseBindMatrices")
            if (skinInverseBindAccessors[skinCountValue] < 0) {
                skinInverseBindAccessors[skinCountValue] = -1
            } else if (
                skinInverseBindAccessors[skinCountValue] >= accessorCountValue ||
                accessorKinds[skinInverseBindAccessors[skinCountValue]] != 44 ||
                accessorComponents[skinInverseBindAccessors[skinCountValue]] != 5126 ||
                accessorCounts[skinInverseBindAccessors[skinCountValue]] != jointCount) {
                return false
            }
            skinCountValue = skinCountValue + 1
            cursor = skipWhitespace(objectLimit + 1, end)
            if (cursor < end && json[cursor] == 44) {
                cursor = skipWhitespace(cursor + 1, end)
            } else if (cursor != end) {
                return false
            }
        }
        for (var skin = 0; skin < skinCountValue; skin = skin + 1) {
            var inverseAccessor = skinInverseBindAccessors[skin]
            for (var joint = 0; joint < skinJointCounts[skin]; joint = joint + 1) {
                var matrixOffset = (skinJointOffsets[skin] + joint) * 12
                if (inverseAccessor < 0) {
                    for (var element = 0; element < 12; element = element + 1) {
                        skinInverseBindMatrices[matrixOffset + element] =
                            if (element == 0 || element == 5 || element == 10)
                                transformScaleValue else 0
                    }
                } else if (!readMatrix(
                        inverseAccessor, joint,
                        skinInverseBindMatrices, matrixOffset)) {
                    return false
                }
            }
        }
        return true
    }

    Bool parseAnimations() {
        var start = fieldValueStart(0, jsonLengthValue, "animations")
        if (start < 0) { return true }
        var end = arrayEnd(start, jsonLengthValue)
        if (end < 0) { return false }
        var cursor = skipWhitespace(start + 1, end)
        while (cursor < end) {
            if (json[cursor] != 123) { return false }
            var animationLimit = objectEnd(cursor, end)
            if (animationLimit < 0) { return false }
            var state = animationStateForName(cursor, animationLimit)
            var samplers = fieldValueStart(cursor, animationLimit, "samplers")
            var samplerEnd = arrayEnd(samplers, animationLimit)
            var channels = fieldValueStart(cursor, animationLimit, "channels")
            var channelEnd = arrayEnd(channels, animationLimit)
            if (samplers < 0 || samplerEnd < 0 ||
                channels < 0 || channelEnd < 0) {
                return false
            }
            var samplerCount = 0
            var samplerCursor = skipWhitespace(samplers + 1, samplerEnd)
            while (samplerCursor < samplerEnd) {
                if (json[samplerCursor] != 123 || samplerCount >= 256) {
                    return false
                }
                samplerCount = samplerCount + 1
                var samplerLimit = objectEnd(samplerCursor, samplerEnd)
                if (samplerLimit < 0) { return false }
                samplerCursor = skipWhitespace(samplerLimit + 1, samplerEnd)
                if (samplerCursor < samplerEnd && json[samplerCursor] == 44) {
                    samplerCursor = skipWhitespace(samplerCursor + 1, samplerEnd)
                } else if (samplerCursor != samplerEnd) {
                    return false
                }
            }
            var channelCursor = skipWhitespace(channels + 1, channelEnd)
            var firstChannel = animationChannelCount
            var addedChannels = 0
            var duration = if (state > 0) animationStateDurations[state] else 0
            while (channelCursor < channelEnd) {
                if (json[channelCursor] != 123 ||
                    animationChannelCount >= animationChannelNodes.length) {
                    return false
                }
                var channelLimit = objectEnd(channelCursor, channelEnd)
                if (channelLimit < 0) { return false }
                var sampler = integerField(channelCursor, channelLimit, "sampler")
                var target = fieldValueStart(channelCursor, channelLimit, "target")
                var targetLimit = objectEnd(target, channelLimit)
                if (sampler < 0 || sampler >= samplerCount ||
                    target < 0 || targetLimit < 0) {
                    return false
                }
                var targetNode = integerField(target, targetLimit, "node")
                var path = fieldValueStart(target, targetLimit, "path")
                var pathEnd = stringEnd(path, targetLimit)
                var pathKind = animationPathKind(path, pathEnd)
                if (targetNode < 0 || targetNode >= nodeCountValue ||
                    pathKind == 0) {
                    return false
                }
                var samplerCursorForIndex = skipWhitespace(samplers + 1, samplerEnd)
                var samplerIndex = 0
                var input = -1
                var output = -1
                var interpolation = 0
                while (samplerIndex < sampler) {
                    var samplerLimit = objectEnd(
                        samplerCursorForIndex, samplerEnd)
                    if (samplerLimit < 0) { return false }
                    samplerCursorForIndex = skipWhitespace(
                        samplerLimit + 1, samplerEnd)
                    if (samplerCursorForIndex < samplerEnd &&
                        json[samplerCursorForIndex] == 44) {
                        samplerCursorForIndex = skipWhitespace(
                            samplerCursorForIndex + 1, samplerEnd)
                    }
                    samplerIndex = samplerIndex + 1
                }
                var selectedSamplerLimit = objectEnd(
                    samplerCursorForIndex, samplerEnd)
                if (selectedSamplerLimit < 0) { return false }
                input = integerField(
                    samplerCursorForIndex, selectedSamplerLimit, "input")
                output = integerField(
                    samplerCursorForIndex, selectedSamplerLimit, "output")
                interpolation = animationInterpolationKind(
                    samplerCursorForIndex, selectedSamplerLimit)
                if (input < 0 || input >= accessorCountValue ||
                    output < 0 || output >= accessorCountValue ||
                    interpolation < 0 ||
                    accessorKinds[input] != 1 ||
                    accessorComponents[input] != 5126 ||
                    accessorComponents[output] != 5126 ||
                    accessorKinds[output] != if (pathKind == 2) 4 else 3) {
                    return false
                }
                if (state > 0) {
                    animationChannelNodes[animationChannelCount] = targetNode
                    animationChannelPaths[animationChannelCount] = pathKind
                    animationChannelInputs[animationChannelCount] = input
                    animationChannelOutputs[animationChannelCount] = output
                    animationChannelInterpolations[animationChannelCount] =
                        interpolation
                    animationChannelCount = animationChannelCount + 1
                    addedChannels = addedChannels + 1
                    var inputCount = accessorCounts[input]
                    for (var key = 0; key < inputCount; key = key + 1) {
                        var keyTime = readAnimationValue(input, key, 0, 1000)
                        if (keyTime < 0 || keyTime > 1000000) { return false }
                        if (keyTime > duration) { duration = keyTime }
                    }
                }
                channelCursor = skipWhitespace(channelLimit + 1, channelEnd)
                if (channelCursor < channelEnd && json[channelCursor] == 44) {
                    channelCursor = skipWhitespace(channelCursor + 1, channelEnd)
                } else if (channelCursor != channelEnd) {
                    return false
                }
            }
            if (state > 0) {
                animationStateStarts[state] = firstChannel
                animationStateCounts[state] = addedChannels
                animationStateDurations[state] = duration
            }
            cursor = skipWhitespace(animationLimit + 1, end)
            if (cursor < end && json[cursor] == 44) {
                cursor = skipWhitespace(cursor + 1, end)
            } else if (cursor != end) {
                return false
            }
        }
        return true
    }


    Bool parseTextureRange(Int[] source) {
        var start = fieldValueStart(0, jsonLengthValue, "images")
        if (start < 0) { return true }
        var end = arrayEnd(start, jsonLengthValue)
        if (end < 0) { return false }
        var cursor = skipWhitespace(start + 1, end)
        if (cursor >= end || json[cursor] != 123) { return true }
        var objectLimit = objectEnd(cursor, end)
        if (objectLimit < 0) { return false }
        var view = integerField(cursor, objectLimit, "bufferView")
        if (view < 0 || view >= viewCountValue) { return true }
        var offset = binOffsetValue + viewOffsets[view]
        var length = viewLengths[view]
        if (offset < 0 || length < 24 || offset > source.length - length) {
            return false
        }
        if (source[offset] != 137 || source[offset + 1] != 80 ||
            source[offset + 2] != 78 || source[offset + 3] != 71 ||
            source[offset + 12] != 73 || source[offset + 13] != 72 ||
            source[offset + 14] != 68 || source[offset + 15] != 82 ||
            source[offset + 16] >= 128 || source[offset + 20] >= 128) {
            return false
        }
        var width = source[offset + 16] * 16777216 +
            source[offset + 17] * 65536 +
            source[offset + 18] * 256 + source[offset + 19]
        var height = source[offset + 20] * 16777216 +
            source[offset + 21] * 65536 +
            source[offset + 22] * 256 + source[offset + 23]
        if (width <= 0 || height <= 0) { return false }
        textureOffsetValue = offset
        textureLengthValue = length
        textureWidthValue = width
        textureHeightValue = height
        textureValidValue = true
        return true
    }

    Bool accessorSpan(
        Int accessor, Int components, Int componentBytes,
        Int element, Int elementBytes, Int[] result
    ) {
        if (result.length < 1 || accessor < 0 || accessor >= accessorCountValue ||
            accessorKinds[accessor] != components ||
            accessorComponents[accessor] != componentBytes ||
            element < 0 || element >= accessorCounts[accessor]) {
            return false
        }
        var view = accessorViews[accessor]
        if (view < 0 || view >= viewCountValue) { return false }
        var stride = viewStrides[view]
        if (stride <= 0) { stride = elementBytes }
        var accessorOffset = accessorOffsets[accessor]
        if (stride < elementBytes || accessorOffset < 0 ||
            accessorOffset > viewLengths[view] - elementBytes ||
            element > (viewLengths[view] - accessorOffset - elementBytes) / stride) {
            return false
        }
        var offset = binOffsetValue + viewOffsets[view] + accessorOffset +
            element * stride
        if (offset < binOffsetValue || offset + elementBytes >
            binOffsetValue + binLengthValue || offset + elementBytes > sourceValue.length) {
            return false
        }
        result[0] = offset
        return true
    }
    Int readAnimationValue(
        Int accessor, Int element, Int component, Int scale
    ) {
        if (accessor < 0 || accessor >= accessorCountValue ||
            component < 0 || component >= accessorKinds[accessor] ||
            (accessorKinds[accessor] != 1 &&
                accessorKinds[accessor] != 3 &&
                accessorKinds[accessor] != 4) ||
            !accessorSpan(
                accessor, accessorKinds[accessor], 5126, element,
                accessorKinds[accessor] * 4, scratch)) {
            return 2000000000
        }
        return readFloatFixed(
            scratch[0] + component * 4, scale)
    }

    Bool readMatrix(
        Int accessor, Int element, Int[] result, Int resultOffset
    ) {
        if (resultOffset < 0 || resultOffset + 12 > result.length ||
            !accessorSpan(accessor, 44, 5126, element, 64, scratch)) {
            return false
        }
        var matrixOffset = scratch[0]
        for (var index = 0; index < 16; index = index + 1) {
            var scale = if (index == 12 || index == 13 || index == 14)
                coordinateScaleValue else transformScaleValue
            scratch[index] = readFloatFixedLimited(
                matrixOffset + index * 4, scale, 1000000000)
            if (scratch[index] == 2000000000) { return false }
        }
        result[resultOffset] = scratch[0]
        result[resultOffset + 1] = scratch[4]
        result[resultOffset + 2] = scratch[8]
        result[resultOffset + 3] = scratch[12]
        result[resultOffset + 4] = scratch[1]
        result[resultOffset + 5] = scratch[5]
        result[resultOffset + 6] = scratch[9]
        result[resultOffset + 7] = scratch[13]
        result[resultOffset + 8] = scratch[2]
        result[resultOffset + 9] = scratch[6]
        result[resultOffset + 10] = scratch[10]
        result[resultOffset + 11] = scratch[14]
        return scratch[3] == 0 && scratch[7] == 0 &&
            scratch[11] == 0 && scratch[15] == transformScaleValue
    }


    Int readFloatFixed(Int offset, Int scale) {
        return readFloatFixedLimited(offset, scale, 1000000)
    }
    Int readFloatFixedLimited(Int offset, Int scale, Int maximum) {
        if (offset < 0 || offset + 4 > sourceValue.length ||
            scale <= 0 || maximum <= 0) {
            return 2000000000
        }
        var b0 = sourceValue[offset]
        var b1 = sourceValue[offset + 1]
        var b2 = sourceValue[offset + 2]
        var b3 = sourceValue[offset + 3]
        var exponent = (b3 % 128) * 2 + b2 / 128
        var fraction = b0 + b1 * 256 + (b2 % 128) * 65536
        if (exponent == 255) { return 2000000000 }
        if (exponent == 0) { return 0 }
        var mantissa = 8388608 + fraction
        var result: Long = mantissa
        result = result * scale
        var shift = exponent - 150
        if (shift >= 0) {
            for (var index = 0; index < shift; index = index + 1) {
                if (result > maximum.toLong()) { return 2000000000 }
                result = result * 2L
            }
        } else {
            for (var index = 0; index < -shift; index = index + 1) {
                result = result / 2L
            }
        }
        if (b3 >= 128) { result = -result }
        var maximumLong: Long = maximum
        if (result < -maximumLong || result > maximumLong) {
            return 2000000000
        }
        return result.toInt()
    }

    Bool readPosition(Int accessor, Int element, Int[] result) {
        if (result.length < 3 || !accessorSpan(accessor, 3, 5126, element, 12, scratch)) {
            return false
        }
        var offset = scratch[0]
        result[0] = readFloatFixed(offset, coordinateScaleValue)
        result[1] = readFloatFixed(offset + 4, coordinateScaleValue)
        result[2] = readFloatFixed(offset + 8, coordinateScaleValue)
        if (result[0] == 2000000000) {
            return false
        }
        if (result[1] == 2000000000) {
            return false
        }
        if (result[2] == 2000000000) {
            return false
        }
        return true
    }

    Int readIndex(Int accessor, Int element) {
        var component = accessorComponents[accessor]
        var bytes = 0
        if (component == 5121) { bytes = 1 }
        if (component == 5123) { bytes = 2 }
        if (component == 5125) { bytes = 4 }
        if (bytes == 0 || !accessorSpan(accessor, 1, component, element, bytes, scratch)) {
            return -1
        }
        var offset = scratch[0]
        if (component == 5121) { return sourceValue[offset] }
        if (component == 5123) {
            return sourceValue[offset] + sourceValue[offset + 1] * 256
        }
        var value = sourceValue[offset] + sourceValue[offset + 1] * 256 +
            sourceValue[offset + 2] * 65536 + sourceValue[offset + 3] * 16777216
        if (value < 0) { return -1 }
        return value
    }

    Int readUv(Int accessor, Int element, Int component) {
        if (accessor < 0) { return 0 }
        if (component < 0 || component > 1 ||
            !accessorSpan(accessor, 2, 5126, element, 8, scratch)) {
            return -1
        }
        var value = readFloatFixed(
            scratch[0] + component * 4, 100)
        if (value == 2000000000) { return -1 }
        if (value < 0) { return 0 }
        if (value > 100) { return 100 }
        return value
    }

    Int readJoint(Int accessor, Int element, Int component) {
        if (accessor < 0 || component < 0 || component > 3) { return -1 }
        var componentType = accessorComponents[accessor]
        var bytes = 0
        if (componentType == 5121) { bytes = 1 }
        if (componentType == 5123) { bytes = 2 }
        if (bytes == 0 ||
            !accessorSpan(accessor, 4, componentType, element, bytes * 4, scratch)) {
            return -1
        }
        var offset = scratch[0] + component * bytes
        if (componentType == 5121) { return sourceValue[offset] }
        return sourceValue[offset] + sourceValue[offset + 1] * 256
    }

    Int readWeight(Int accessor, Int element, Int component) {
        if (accessor < 0 || component < 0 || component > 3 ||
            !accessorSpan(accessor, 4, 5126, element, 16, scratch)) {
            return -1
        }
        var value = readFloatFixed(scratch[0] + component * 4, 1000)
        if (value == 2000000000 || value < 0 || value > 1000) { return -1 }
        return value
    }

    Int animationWave(Int phase, Int period) {
        if (period <= 0) { return 0 }
        var value = phase % period
        if (value < 0) { value = value + period }
        return if (value < period / 2) -1 else 1
    }

    Int jointPoseLift(Int joint, Int animationState, Int animationTick,
        Int moving, Int attacking) {
        var lift = 0
        var wave = animationWave(animationTick, 8)
        if (moving != 0 || animationState == 2) {
            if (modelValue == 1) {
                if (joint == 5 || joint == 6) { lift = wave }
                if (joint == 7 || joint == 8) { lift = -wave }
            } else if (modelValue == 2) {
                if (joint >= 12 && joint <= 14) { lift = wave }
                if (joint >= 15) { lift = -wave }
            }
        }
        if (attacking != 0 || animationState == 3) {
            if ((modelValue == 1 && joint <= 4) ||
                (modelValue == 2 && joint <= 10)) {
                lift = lift + 2
            }
        }
        if (animationState == 4) { lift = lift - 1 }
        return lift
    }

    Int vertexAnimationLift(Int index, Int animationState, Int animationTick,
        Int moving, Int attacking) {
        if (!readValue || index < 0 || index >= vertexCountValue ||
            vertexJointValue.length < vertexCountValue * 4 ||
            vertexWeightValue.length < vertexCountValue * 4) {
            return 0
        }
        var offset = index * 4
        var total = 0
        var weighted: Long = 0L
        for (var slot = 0; slot < 4; slot = slot + 1) {
            var weight = vertexWeightValue[offset + slot]
            if (weight < 0) { return 0 }
            total = total + weight
            weighted = weighted +
                weight * jointPoseLift(
                    vertexJointValue[offset + slot], animationState,
                    animationTick, moving, attacking)
        }
        if (total <= 0) { return 0 }
        return (weighted / total).toInt()
    }


    Int bounded(Int value) {
        if (value < -1000000000) { return -1000000000 }
        if (value > 1000000000) { return 1000000000 }
        return value
    }
    Bool buildPoseTrsMatrix(Int node) {
        if (node < 0 || node >= nodeCountValue || !nodeHasTrs[node]) {
            return false
        }
        var transformOffset = node * 3
        var tx = poseTranslation[transformOffset]
        var ty = poseTranslation[transformOffset + 1]
        var tz = poseTranslation[transformOffset + 2]
        var sx = poseScale[transformOffset]
        var sy = poseScale[transformOffset + 1]
        var sz = poseScale[transformOffset + 2]
        var rotationOffset = node * 4
        var qx = poseRotation[rotationOffset]
        var qy = poseRotation[rotationOffset + 1]
        var qz = poseRotation[rotationOffset + 2]
        var qw = poseRotation[rotationOffset + 3]
        var norm: Long = qx
        norm = norm * qx
        var term: Long = qy
        term = term * qy
        norm = norm + term
        term = qz
        term = term * qz
        norm = norm + term
        term = qw
        term = term * qw
        norm = norm + term
        var expected: Long = transformScaleValue
        expected = expected * transformScaleValue
        var difference = norm - expected
        if (difference < 0L) { difference = -difference }
        if (difference > expected / 25L + transformScaleValue) {
            return false
        }
        var xx = scaled(qx, qx, transformScaleValue)
        var yy = scaled(qy, qy, transformScaleValue)
        var zz = scaled(qz, qz, transformScaleValue)
        var xy = scaled(qx, qy, transformScaleValue)
        var xz = scaled(qx, qz, transformScaleValue)
        var yz = scaled(qy, qz, transformScaleValue)
        var xw = scaled(qx, qw, transformScaleValue)
        var yw = scaled(qy, qw, transformScaleValue)
        var zw = scaled(qz, qw, transformScaleValue)
        if (xx == 2000000000 || yy == 2000000000 ||
            zz == 2000000000 || xy == 2000000000 ||
            xz == 2000000000 || yz == 2000000000 ||
            xw == 2000000000 || yw == 2000000000 ||
            zw == 2000000000) {
            return false
        }
        var r00 = transformScaleValue - 2 * (yy + zz)
        var r01 = 2 * (xy - zw)
        var r02 = 2 * (xz + yw)
        var r10 = 2 * (xy + zw)
        var r11 = transformScaleValue - 2 * (xx + zz)
        var r12 = 2 * (yz - xw)
        var r20 = 2 * (xz - yw)
        var r21 = 2 * (yz + xw)
        var r22 = transformScaleValue - 2 * (xx + yy)
        var offset = node * 12
        poseLocalMatrices[offset] = scaled(r00, sx, transformScaleValue)
        poseLocalMatrices[offset + 1] = scaled(r01, sy, transformScaleValue)
        poseLocalMatrices[offset + 2] = scaled(r02, sz, transformScaleValue)
        poseLocalMatrices[offset + 3] = tx
        poseLocalMatrices[offset + 4] = scaled(r10, sx, transformScaleValue)
        poseLocalMatrices[offset + 5] = scaled(r11, sy, transformScaleValue)
        poseLocalMatrices[offset + 6] = scaled(r12, sz, transformScaleValue)
        poseLocalMatrices[offset + 7] = ty
        poseLocalMatrices[offset + 8] = scaled(r20, sx, transformScaleValue)
        poseLocalMatrices[offset + 9] = scaled(r21, sy, transformScaleValue)
        poseLocalMatrices[offset + 10] = scaled(r22, sz, transformScaleValue)
        poseLocalMatrices[offset + 11] = tz
        for (var element = 0; element < 12; element = element + 1) {
            if (poseLocalMatrices[offset + element] == 2000000000) {
                return false
            }
        }
        return true
    }

    Bool multiplyAffine(
        Int[] left, Int leftOffset, Int[] right, Int rightOffset,
        Int[] result, Int resultOffset
    ) {
        if (leftOffset < 0 || leftOffset + 12 > left.length ||
            rightOffset < 0 || rightOffset + 12 > right.length ||
            resultOffset < 0 || resultOffset + 12 > result.length) {
            return false
        }
        for (var row = 0; row < 3; row = row + 1) {
            for (var column = 0; column < 3; column = column + 1) {
                var value: Long = left[leftOffset + row * 4]
                value = value * right[rightOffset + column]
                var term: Long = left[leftOffset + row * 4 + 1]
                term = term * right[rightOffset + 4 + column]
                value = value + term
                term = left[leftOffset + row * 4 + 2]
                term = term * right[rightOffset + 8 + column]
                value = value + term
                result[resultOffset + row * 4 + column] =
                    bounded((value / transformScaleValue).toInt())
            }
            var translation: Long = left[leftOffset + row * 4]
            translation = translation * right[rightOffset + 3]
            var term: Long = left[leftOffset + row * 4 + 1]
            term = term * right[rightOffset + 7]
            translation = translation + term
            term = left[leftOffset + row * 4 + 2]
            term = term * right[rightOffset + 11]
            translation = translation + term
            translation = translation / transformScaleValue +
                left[leftOffset + row * 4 + 3]
            result[resultOffset + row * 4 + 3] =
                bounded(translation.toInt())
        }
        return true
    }

    Bool invertAffine(
        Int[] source, Int sourceOffset, Int[] result, Int resultOffset
    ) {
        if (sourceOffset < 0 || sourceOffset + 12 > source.length ||
            resultOffset < 0 || resultOffset + 12 > result.length) {
            return false
        }
        var a = source[sourceOffset]
        var b = source[sourceOffset + 1]
        var c = source[sourceOffset + 2]
        var d = source[sourceOffset + 4]
        var e = source[sourceOffset + 5]
        var f = source[sourceOffset + 6]
        var g = source[sourceOffset + 8]
        var h = source[sourceOffset + 9]
        var i = source[sourceOffset + 10]
        var cofactorA: Long = e * i - f * h
        var cofactorB: Long = c * h - b * i
        var cofactorC: Long = b * f - c * e
        var determinant: Long = a * cofactorA +
            b * (f * g - d * i) + c * (d * h - e * g)
        var normalizedDeterminant: Long =
            determinant / transformScaleValue
        if (normalizedDeterminant > -1L &&
            normalizedDeterminant < 1L) { return false }
        result[resultOffset] =
            bounded((cofactorA * transformScaleValue /
                normalizedDeterminant).toInt())
        result[resultOffset + 1] =
            bounded((cofactorB * transformScaleValue /
                normalizedDeterminant).toInt())
        result[resultOffset + 2] =
            bounded((cofactorC * transformScaleValue /
                normalizedDeterminant).toInt())
        var cofactorD: Long = f * g - d * i
        var cofactorE: Long = a * i - c * g
        var cofactorF: Long = c * d - a * f
        result[resultOffset + 4] =
            bounded((cofactorD * transformScaleValue /
                normalizedDeterminant).toInt())
        result[resultOffset + 5] =
            bounded((cofactorE * transformScaleValue /
                normalizedDeterminant).toInt())
        result[resultOffset + 6] =
            bounded((cofactorF * transformScaleValue /
                normalizedDeterminant).toInt())
        var cofactorG: Long = d * h - e * g
        var cofactorH: Long = b * g - a * h
        var cofactorI: Long = a * e - b * d
        result[resultOffset + 8] =
            bounded((cofactorG * transformScaleValue /
                normalizedDeterminant).toInt())
        result[resultOffset + 9] =
            bounded((cofactorH * transformScaleValue /
                normalizedDeterminant).toInt())
        result[resultOffset + 10] =
            bounded((cofactorI * transformScaleValue /
                normalizedDeterminant).toInt())
        var tx = source[sourceOffset + 3]
        var ty = source[sourceOffset + 7]
        var tz = source[sourceOffset + 11]
        var translation: Long = result[resultOffset]
        translation = translation * tx
        var term: Long = result[resultOffset + 1]
        translation = translation + term * ty
        term = result[resultOffset + 2]
        translation = translation + term * tz
        result[resultOffset + 3] = bounded((-translation / transformScaleValue).toInt())
        translation = result[resultOffset + 4]
        translation = translation * tx
        term = result[resultOffset + 5]
        translation = translation + term * ty
        term = result[resultOffset + 6]
        translation = translation + term * tz
        result[resultOffset + 7] = bounded((-translation / transformScaleValue).toInt())
        translation = result[resultOffset + 8]
        translation = translation * tx
        term = result[resultOffset + 9]
        translation = translation + term * ty
        term = result[resultOffset + 10]
        translation = translation + term * tz
        result[resultOffset + 11] = bounded((-translation / transformScaleValue).toInt())
        return true
    }
    Bool sampleAnimationChannel(
        Int channel, Int sampleTime
    ) {
        if (channel < 0 || channel >= animationChannelCount) { return false }
        var input = animationChannelInputs[channel]
        var output = animationChannelOutputs[channel]
        var path = animationChannelPaths[channel]
        var keyCount = accessorCounts[input]
        if (keyCount <= 0) { return false }
        var left = 0
        var right = keyCount - 1
        for (var key = 0; key + 1 < keyCount; key = key + 1) {
            var nextTime = readAnimationValue(input, key + 1, 0, 1000)
            if (nextTime == 2000000000) { return false }
            if (sampleTime <= nextTime) {
                left = key
                right = key + 1
                break
            }
        }
        var leftTime = readAnimationValue(input, left, 0, 1000)
        var rightTime = readAnimationValue(input, right, 0, 1000)
        if (leftTime == 2000000000 || rightTime == 2000000000) {
            return false
        }
        var components = if (path == 2) 4 else 3
        var alpha = 0
        if (right != left && rightTime > leftTime &&
            animationChannelInterpolations[channel] == 0) {
            var numerator: Long = sampleTime - leftTime
            numerator = numerator * transformScaleValue
            alpha = (numerator / (rightTime - leftTime)).toInt()
            if (alpha < 0) { alpha = 0 }
            if (alpha > transformScaleValue) { alpha = transformScaleValue }
        }
        var leftValues = animationLeftValue
        var rightValues = animationRightValue
        var outputScale = if (path == 1)
            coordinateScaleValue else transformScaleValue
        for (var component = 0; component < components; component = component + 1) {
            leftValues[component] =
                readAnimationValue(output, left, component, outputScale)
            rightValues[component] =
                readAnimationValue(output, right, component, outputScale)
            if (leftValues[component] == 2000000000 ||
                rightValues[component] == 2000000000) {
                return false
            }
        }
        if (path == 2) {
            var dot: Long = leftValues[0]
            dot = dot * rightValues[0]
            dot = dot + leftValues[1].toLong() * rightValues[1]
            dot = dot + leftValues[2].toLong() * rightValues[2]
            dot = dot + leftValues[3].toLong() * rightValues[3]
            if (dot < 0L) {
                for (var component = 0; component < 4; component = component + 1) {
                    rightValues[component] = -rightValues[component]
                }
            }
        }
        for (var component = 0; component < components; component = component + 1) {
            var value: Long = leftValues[component]
            if (alpha > 0) {
                value = value + (rightValues[component] -
                    leftValues[component]).toLong() * alpha /
                    transformScaleValue
            }
            animationSampleValue[component] = bounded(value.toInt())
        }
        return true
    }

    Bool poseMultiplyWorld(Int node) {
        if (node < 0 || node >= nodeCountValue) { return false }
        if (poseWorldReady[node] || poseWorldVisiting[node]) {
            return poseWorldReady[node]
        }
        poseWorldVisiting[node] = true
        var parent = nodeParent[node]
        if (parent >= 0 && !poseMultiplyWorld(parent)) {
            poseWorldVisiting[node] = false
            return false
        }
        var localOffset = node * 12
        var worldOffset = node * 12
        if (parent < 0) {
            for (var index = 0; index < 12; index = index + 1) {
                poseWorldMatrices[worldOffset + index] =
                    poseLocalMatrices[localOffset + index]
            }
        } else if (!multiplyAffine(
                poseWorldMatrices, parent * 12,
                poseLocalMatrices, localOffset,
                poseWorldMatrices, worldOffset)) {
            poseWorldVisiting[node] = false
            return false
        }
        poseWorldReady[node] = true
        poseWorldVisiting[node] = false
        return true
    }

    Bool ensurePoseMeshInverse(Int node) {
        if (node < 0 || node >= nodeCountValue) { return false }
        if (poseMeshInverseReady[node]) { return true }
        if (!poseMultiplyWorld(node) ||
            !invertAffine(
                poseWorldMatrices, node * 12,
                poseMeshInverseMatrices, node * 12)) {
            return false
        }
        poseMeshInverseReady[node] = true
        return true
    }

    Int poseTransform(
        Int matrixOffset, Int x, Int y, Int z, Int component
    ) {
        if (matrixOffset < 0 || matrixOffset + 12 > poseWorldMatrices.length ||
            component < 0 || component > 2) {
            return 2000000000
        }
        var rowOffset = matrixOffset + component * 4
        var value: Long = poseWorldMatrices[rowOffset]
        value = value * x
        var term: Long = poseWorldMatrices[rowOffset + 1]
        value = value + term * y
        term = poseWorldMatrices[rowOffset + 2]
        value = value + term * z
        value = value / transformScaleValue +
            poseWorldMatrices[rowOffset + 3]
        return bounded(value.toInt())
    }
    Int animationClipState(Int animationState) {
        if (animationState == 1 && animationStateCounts[1] > 0) { return 1 }
        if (animationState == 2 && animationStateCounts[2] > 0) { return 2 }
        if (animationState == 3 && animationStateCounts[3] > 0) { return 3 }
        if (animationState == 4 && animationStateCounts[4] > 0) { return 4 }
        if (animationStateCounts[5] > 0) { return 5 }
        if (animationStateCounts[1] > 0) { return 1 }
        if (animationStateCounts[2] > 0) { return 2 }
        if (animationStateCounts[3] > 0) { return 3 }
        if (animationStateCounts[4] > 0) { return 4 }
        return 0
    }

    Bool prepareAnimationPose(Int animationState, Int animationTick) {
        poseValidValue = false
        animationPoseDiagnosticValue = 0
        if (!readValue || animationChannelCount <= 0 ||
            animationTick < 0) {
            animationPoseDiagnosticValue = 1
            return false
        }
        var clipState = animationClipState(animationState)
        if (clipState <= 0 || animationStateCounts[clipState] <= 0) {
            animationPoseDiagnosticValue = 2
            return false
        }
        for (var node = 0; node < nodeCountValue; node = node + 1) {
            var transformOffset = node * 3
            var rotationOffset = node * 4
            for (var component = 0; component < 3; component = component + 1) {
                poseTranslation[transformOffset + component] =
                    nodeTranslation[transformOffset + component]
                poseScale[transformOffset + component] =
                    nodeScale[transformOffset + component]
            }
            for (var component = 0; component < 4; component = component + 1) {
                poseRotation[rotationOffset + component] =
                    nodeRotation[rotationOffset + component]
            }
            for (var element = 0; element < 12; element = element + 1) {
                poseLocalMatrices[node * 12 + element] =
                    nodeMatrices[node * 12 + element]
            }
        }
        var duration = animationStateDurations[clipState]
        var sampleTime: Long = animationTick
        sampleTime = sampleTime * 1000L / 60L
        if (duration > 0) {
            sampleTime = sampleTime % duration
        } else {
            sampleTime = 0
        }
        var first = animationStateStarts[clipState]
        var last = first + animationStateCounts[clipState]
        for (var channel = first; channel < last; channel = channel + 1) {
            var node = animationChannelNodes[channel]
            if (node < 0 || node >= nodeCountValue) {
                animationPoseDiagnosticValue = 3
                return false
            }
            if (!nodeHasTrs[node]) {
                animationPoseDiagnosticValue = 4
                return false
            }
            if (!sampleAnimationChannel(channel, sampleTime.toInt())) {
                animationPoseDiagnosticValue = 5
                return false
            }
            var transformOffset = node * 3
            var rotationOffset = node * 4
            var path = animationChannelPaths[channel]
            if (path == 1) {
                poseTranslation[transformOffset] = animationSampleValue[0]
                poseTranslation[transformOffset + 1] = animationSampleValue[1]
                poseTranslation[transformOffset + 2] = animationSampleValue[2]
            } else if (path == 2) {
                poseRotation[rotationOffset] = animationSampleValue[0]
                poseRotation[rotationOffset + 1] = animationSampleValue[1]
                poseRotation[rotationOffset + 2] = animationSampleValue[2]
                poseRotation[rotationOffset + 3] = animationSampleValue[3]
            } else {
                poseScale[transformOffset] = animationSampleValue[0]
                poseScale[transformOffset + 1] = animationSampleValue[1]
                poseScale[transformOffset + 2] = animationSampleValue[2]
            }
        }
        for (var node = 0; node < nodeCountValue; node = node + 1) {
            if (nodeHasTrs[node] && !buildPoseTrsMatrix(node)) {
                animationPoseDiagnosticValue = 6
                return false
            }
            poseWorldReady[node] = false
            poseWorldVisiting[node] = false
            poseMeshInverseReady[node] = false
        }
        for (var index = 0; index < vertexCountValue; index = index + 1) {
            var node = vertexNodeValue[index]
            if (node < 0 || node >= nodeCountValue) {
                animationPoseDiagnosticValue = 7
                return false
            }
            if (!poseMultiplyWorld(node)) {
                animationPoseDiagnosticValue = 8
                return false
            }
            var sourceX = vertexSourceXValue[index]
            var sourceY = vertexSourceYValue[index]
            var sourceZ = vertexSourceZValue[index]
            var worldX = poseTransform(
                node * 12, sourceX, sourceY, sourceZ, 0)
            var worldY = poseTransform(
                node * 12, sourceX, sourceY, sourceZ, 1)
            var worldZ = poseTransform(
                node * 12, sourceX, sourceY, sourceZ, 2)
            var skin = vertexSkinValue[index]
            if (skin >= 0) {
                if (skin >= skinCountValue) {
                    animationPoseDiagnosticValue = 9
                    return false
                }
                if (!ensurePoseMeshInverse(node)) {
                    animationPoseDiagnosticValue = 10
                    return false
                }
                var weightTotal = 0
                var weightedX: Long = 0L
                var weightedY: Long = 0L
                var weightedZ: Long = 0L
                for (var slot = 0; slot < 4; slot = slot + 1) {
                    var weight = vertexWeightValue[index * 4 + slot]
                    if (weight <= 0) { continue }
                    var joint = vertexJointValue[index * 4 + slot]
                    if (joint < 0 || joint >= skinJointCounts[skin]) {
                        animationPoseDiagnosticValue = 11
                        return false
                    }
                    var jointNode = skinJoints[
                        skinJointOffsets[skin] + joint]
                    if (!poseMultiplyWorld(jointNode)) {
                        animationPoseDiagnosticValue = 12
                        return false
                    }
                    if (!multiplyAffine(
                            poseMeshInverseMatrices, node * 12,
                            poseWorldMatrices, jointNode * 12,
                            poseScratchMatrix, 0) ||
                        !multiplyAffine(
                            poseScratchMatrix, 0,
                            skinInverseBindMatrices,
                            (skinJointOffsets[skin] + joint) * 12,
                            poseScratchMatrixTwo, 0)) {
                        animationPoseDiagnosticValue = 13
                        return false
                    }
                    var matrixX: Long = poseScratchMatrixTwo[0]
                    matrixX = matrixX * sourceX
                    var term: Long = poseScratchMatrixTwo[1]
                    matrixX = matrixX + term * sourceY
                    term = poseScratchMatrixTwo[2]
                    matrixX = matrixX + term * sourceZ
                    matrixX = matrixX / transformScaleValue +
                        poseScratchMatrixTwo[3]
                    var matrixY: Long = poseScratchMatrixTwo[4]
                    matrixY = matrixY * sourceX
                    term = poseScratchMatrixTwo[5]
                    matrixY = matrixY + term * sourceY
                    term = poseScratchMatrixTwo[6]
                    matrixY = matrixY + term * sourceZ
                    matrixY = matrixY / transformScaleValue +
                        poseScratchMatrixTwo[7]
                    var matrixZ: Long = poseScratchMatrixTwo[8]
                    matrixZ = matrixZ * sourceX
                    term = poseScratchMatrixTwo[9]
                    matrixZ = matrixZ + term * sourceY
                    term = poseScratchMatrixTwo[10]
                    matrixZ = matrixZ + term * sourceZ
                    matrixZ = matrixZ / transformScaleValue +
                        poseScratchMatrixTwo[11]
                    weightedX = weightedX + matrixX * weight
                    weightedY = weightedY + matrixY * weight
                    weightedZ = weightedZ + matrixZ * weight
                    weightTotal = weightTotal + weight
                }
                if (weightTotal <= 0) {
                    animationPoseDiagnosticValue = 14
                    return false
                }
                worldX = (weightedX / weightTotal).toInt()
                worldY = (weightedY / weightTotal).toInt()
                worldZ = (weightedZ / weightTotal).toInt()
            }
            if (worldX == 2000000000 || worldY == 2000000000 ||
                worldZ == 2000000000) {
                animationPoseDiagnosticValue = 15
                return false
            }
            poseVertexX[index] = roundFixed(
                normalized(worldX, modelCenterXValue, modelHeightValue))
            poseVertexY[index] = roundFixed(
                normalized(worldY, modelMinYValue, modelHeightValue))
            poseVertexZ[index] = roundFixed(
                normalized(worldZ, modelCenterZValue, modelHeightValue))
        }
        poseValidValue = true
        return true
    }

    Int animationPoseDiagnostic() {
        return animationPoseDiagnosticValue
    }
    Bool authoredAnimationAvailable() {
        return animationChannelCount > 0
    }
    Int authoredAnimationChannelCount() {
        return animationChannelCount
    }
    Int authoredAnimationStateChannelCount(Int state) {
        if (state < 0 || state >= animationStateCounts.length) { return 0 }
        return animationStateCounts[state]
    }


    Bool multiplyWorld(Int node) {
        if (node < 0 || node >= nodeCountValue) { return false }
        if (nodeWorldReady[node] || nodeWorldVisiting[node]) {
            return nodeWorldReady[node]
        }
        nodeWorldVisiting[node] = true
        var parent = nodeParent[node]
        if (parent >= 0 && !multiplyWorld(parent)) {
            nodeWorldVisiting[node] = false
            return false
        }
        var localOffset = node * 12
        var worldOffset = node * 12
        if (parent < 0) {
            for (var index = 0; index < 12; index = index + 1) {
                nodeWorldMatrices[worldOffset + index] = nodeMatrices[localOffset + index]
            }
        } else {
            var parentOffset = parent * 12
            for (var row = 0; row < 3; row = row + 1) {
                for (var column = 0; column < 3; column = column + 1) {
                    var value: Long = nodeWorldMatrices[parentOffset + row * 4]
                    value = value * nodeMatrices[localOffset + column]
                    var term: Long = nodeWorldMatrices[parentOffset + row * 4 + 1]
                    term = term * nodeMatrices[localOffset + 4 + column]
                    value = value + term
                    term = nodeWorldMatrices[parentOffset + row * 4 + 2]
                    term = term * nodeMatrices[localOffset + 8 + column]
                    value = value + term
                    nodeWorldMatrices[worldOffset + row * 4 + column] =
                        bounded((value / transformScaleValue).toInt())
                }
                var translation: Long = nodeWorldMatrices[parentOffset + row * 4]
                translation = translation * nodeMatrices[localOffset + 3]
                var term: Long = nodeWorldMatrices[parentOffset + row * 4 + 1]
                term = term * nodeMatrices[localOffset + 7]
                translation = translation + term
                term = nodeWorldMatrices[parentOffset + row * 4 + 2]
                term = term * nodeMatrices[localOffset + 11]
                translation = translation + term
                translation = translation / transformScaleValue +
                    nodeWorldMatrices[parentOffset + row * 4 + 3]
                nodeWorldMatrices[worldOffset + row * 4 + 3] =
                    bounded(translation.toInt())
            }
        }
        nodeWorldReady[node] = true
        nodeWorldVisiting[node] = false
        return true
    }

    Int worldCoordinate(Int node, Int x, Int y, Int z, Int component) {
        if (component < 0 || component > 2 || !multiplyWorld(node)) {
            return 2000000000
        }
        var offset = node * 12
        var rowOffset = offset + component * 4
        var value: Long = nodeWorldMatrices[rowOffset]
        value = value * x
        var term: Long = nodeWorldMatrices[rowOffset + 1]
        value = value + term * y
        term = nodeWorldMatrices[rowOffset + 2]
        value = value + term * z
        value = value / transformScaleValue +
            nodeWorldMatrices[rowOffset + 3]
        return bounded(value.toInt())
    }

    Bool calculateBounds(Int[] minValues, Int[] maxValues) {
        if (minValues.length < 3 || maxValues.length < 3) { return false }
        minValues[0] = 1000000000
        minValues[1] = 1000000000
        minValues[2] = 1000000000
        maxValues[0] = -1000000000
        maxValues[1] = -1000000000
        maxValues[2] = -1000000000
        var position = new Int[3]
        for (var node = 0; node < nodeCountValue; node = node + 1) {
            var mesh = nodeMesh[node]
            if (mesh < 0 || mesh >= meshCountValue || !multiplyWorld(node)) { continue }
            for (var primitive = 0; primitive < primitiveCountValue; primitive = primitive + 1) {
                if (primitiveMesh[primitive] != mesh) { continue }
                var accessor = primitivePosition[primitive]
                for (var index = 0; index < accessorCounts[accessor]; index = index + 1) {
                    if (!readPosition(accessor, index, position)) {
                        return false
                    }
                    for (var component = 0; component < 3; component = component + 1) {
                        var value = worldCoordinate(
                            node, position[0], position[1], position[2], component)
                        if (value == 2000000000) {
                            return false
                        }
                        if (value < minValues[component]) { minValues[component] = value }
                        if (value > maxValues[component]) { maxValues[component] = value }
                    }
                }
            }
        }
        if (minValues[1] >= maxValues[1]) {
            return false
        }
        return true
    }

    Int normalized(Int value, Int center, Int height) {
        var difference: Long = value
        difference = difference - center
        var result = difference * glbModelTargetHeightFixed() / height
        return result.toInt()
    }

    Int roundFixed(Int value) {
        if (value >= 0) { return ((value + 500) / 1000) }
        return -((-value + 500) / 1000)
    }

    Int materialSlot(Int model, Int mesh) {
        if (model == 2) { return 3 }
        if (mesh == 1) { return 1 }
        if (mesh == 4) { return 2 }
        return 0
    }

    Int expandedTriangleCount() {
        var total: Long = 0
        for (var node = 0; node < nodeCountValue; node = node + 1) {
            var mesh = nodeMesh[node]
            if (mesh < 0 || mesh >= meshCountValue) { continue }
            for (var primitive = 0; primitive < primitiveCountValue; primitive = primitive + 1) {
                if (primitiveMesh[primitive] != mesh || primitiveMode[primitive] != 4) {
                    continue
                }
                var indices = primitiveIndex[primitive]
                if (indices < 0 || indices >= accessorCountValue) { return -1 }
                var indexCount = accessorCounts[indices]
                if (indexCount < 3 || indexCount % 3 != 0) { return -1 }
                total = total + indexCount / 3
                if (total > 715827882L) { return -1 }
            }
        }
        return total.toInt()
    }

    Bool allocateGeometry() {
        var triangles = expandedTriangleCount()
        if (triangles <= 0) { return false }
        var vertices = triangles * 3
        vertexXValue = new Int[vertices]
        vertexYValue = new Int[vertices]
        vertexZValue = new Int[vertices]
        vertexUValue = new Int[vertices]
        vertexVValue = new Int[vertices]
        vertexMaterialValue = new Int[vertices]
        vertexJointValue = new Int[vertices * 4]
        vertexWeightValue = new Int[vertices * 4]
        vertexSourceXValue = new Int[vertices]
        vertexSourceYValue = new Int[vertices]
        vertexSourceZValue = new Int[vertices]
        vertexNodeValue = new Int[vertices]
        vertexSkinValue = new Int[vertices]
        poseVertexX = new Int[vertices]
        poseVertexY = new Int[vertices]
        poseVertexZ = new Int[vertices]
        return true
    }

    Bool emitGeometry(Int[] minValues, Int[] maxValues) {
        var height = maxValues[1] - minValues[1]
        if (height <= 0) { return false }
        var centerX: Long = minValues[0]
        centerX = (centerX + maxValues[0]) / 2L
        var centerZ: Long = minValues[2]
        centerZ = (centerZ + maxValues[2]) / 2L
        modelCenterXValue = centerX.toInt()
        modelMinYValue = minValues[1]
        modelCenterZValue = centerZ.toInt()
        modelHeightValue = height
        var position = new Int[3]
        var output = 0
        for (var node = 0; node < nodeCountValue; node = node + 1) {
            var mesh = nodeMesh[node]
            if (mesh < 0 || mesh >= meshCountValue || !multiplyWorld(node)) { continue }
            for (var primitive = 0; primitive < primitiveCountValue; primitive = primitive + 1) {
                if (primitiveMesh[primitive] != mesh || primitiveMode[primitive] != 4) {
                    continue
                }
                var positions = primitivePosition[primitive]
                var indices = primitiveIndex[primitive]
                var indexCount = accessorCounts[indices]
                if (indexCount < 3 || indexCount % 3 != 0) { return false }
                for (var triangle = 0; triangle < indexCount / 3; triangle = triangle + 1) {
                    for (var corner = 0; corner < 3; corner = corner + 1) {
                        var sourceIndex = readIndex(indices, triangle * 3 + corner)
                        if (sourceIndex < 0 || sourceIndex >= accessorCounts[positions] ||
                            output >= vertexXValue.length ||
                            !readPosition(positions, sourceIndex, position)) {
                            return false
                        }
                        var skinJoints = primitiveJoints[primitive]
                        var skinWeights = primitiveWeights[primitive]
                        var skinWeightTotal = 0
                        for (var slot = 0; slot < 4; slot = slot + 1) {
                            var jointValue = 0
                            var weightValue = 0
                            if (skinJoints >= 0) {
                                jointValue = readJoint(skinJoints, sourceIndex, slot)
                                weightValue = readWeight(skinWeights, sourceIndex, slot)
                                if (jointValue < 0 || jointValue > 31 ||
                                    weightValue < 0) {
                                    return false
                                }
                            }
                            var skinOffset = output * 4 + slot
                            vertexJointValue[skinOffset] = jointValue
                            vertexWeightValue[skinOffset] = weightValue
                            skinWeightTotal = skinWeightTotal + weightValue
                        }
                        if (skinJoints >= 0 && skinWeightTotal <= 0) {
                            return false
                        }
                        vertexSourceXValue[output] = position[0]
                        vertexSourceYValue[output] = position[1]
                        vertexSourceZValue[output] = position[2]
                        vertexNodeValue[output] = node
                        vertexSkinValue[output] = nodeSkin[node]
                        var worldX = worldCoordinate(
                            node, position[0], position[1], position[2], 0)
                        var worldY = worldCoordinate(
                            node, position[0], position[1], position[2], 1)
                        var worldZ = worldCoordinate(
                            node, position[0], position[1], position[2], 2)
                        if (worldX == 2000000000 || worldY == 2000000000 || worldZ == 2000000000) {
                            return false
                        }
                        vertexXValue[output] = roundFixed(normalized(worldX, centerX.toInt(), height))
                        vertexYValue[output] = roundFixed(normalized(worldY, minValues[1], height))
                        vertexZValue[output] = roundFixed(normalized(worldZ, centerZ.toInt(), height))
                        var u = readUv(primitiveTexcoord[primitive], sourceIndex, 0)
                        var v = readUv(primitiveTexcoord[primitive], sourceIndex, 1)
                        if (u < 0 || v < 0) { return false }
                        vertexUValue[output] = u
                        vertexVValue[output] = v
                        vertexMaterialValue[output] =
                            materialSlot(modelValue, mesh)
                        output = output + 1
                    }
                }
            }
        }
        vertexCountValue = output
        triangleCountValue = output / 3
        return output > 0 && output % 3 == 0
    }

    Bool read(Int[] source, Int model) {
        clear()
        if ((model != 1 && model != 2) || source.length < 20) {
            return false
        }
        sourceValue = source
        modelValue = model
        if (!loadJson(source)) { return false }
        var rootStart = skipWhitespace(0, jsonLengthValue)
        var rootEnd = objectEnd(rootStart, jsonLengthValue)
        if (rootStart < 0 || rootEnd < 0 || rootStart >= jsonLengthValue ||
            json[rootStart] != 123 || !parseViews() || !parseAccessors() ||
            !parseMeshes() || !parseNodes() || !parseSkins() ||
            !parseAnimations() || !parseTextureRange(source)) {
            return false
        }
        if (!allocateGeometry()) {
            return false
        }
        var minValues = new Int[3]
        var maxValues = new Int[3]
        if (!calculateBounds(minValues, maxValues) ||
            !emitGeometry(minValues, maxValues)) {
            return false
        }
        readValue = true
        return true
    }
    Bool valid() {
        return readValue && vertexCountValue > 0 && triangleCountValue > 0 &&
            vertexCountValue == triangleCountValue * 3
    }

    Int vertexCount() { if (!readValue) { return 0 } return vertexCountValue }
    Int triangleCount() { if (!readValue) { return 0 } return triangleCountValue }

    Int vertexX(Int index) {
        if (!readValue || index < 0 || index >= vertexCountValue) { return 0 }
        return if (poseValidValue) poseVertexX[index] else vertexXValue[index]
    }
    Int vertexY(Int index) {
        if (!readValue || index < 0 || index >= vertexCountValue) { return 0 }
        return if (poseValidValue) poseVertexY[index] else vertexYValue[index]
    }
    Int verticalExtent() {
        if (!valid()) { return 0 }
        var minimum = vertexYValue[0]
        var maximum = vertexYValue[0]
        for (var index = 1; index < vertexCountValue; index = index + 1) {
            if (vertexYValue[index] < minimum) {
                minimum = vertexYValue[index]
            }
            if (vertexYValue[index] > maximum) {
                maximum = vertexYValue[index]
            }
        }
        return maximum - minimum
    }
    Int vertexZ(Int index) {
        if (!readValue || index < 0 || index >= vertexCountValue) { return 0 }
        return if (poseValidValue) poseVertexZ[index] else vertexZValue[index]
    }
    Int vertexU(Int index) {
        if (!readValue || index < 0 || index >= vertexCountValue) { return 0 }
        return vertexUValue[index]
    }
    Int vertexV(Int index) {
        if (!readValue || index < 0 || index >= vertexCountValue) { return 0 }
        return vertexVValue[index]
    }
    Int vertexMaterial(Int index) {
        if (!readValue || index < 0 || index >= vertexCountValue) { return 0 }
        return vertexMaterialValue[index]
    }
    Int textureOffset() {
        if (!readValue || !textureValidValue) { return -1 }
        return textureOffsetValue
    }
    Int textureLength() {
        if (!readValue || !textureValidValue) { return 0 }
        return textureLengthValue
    }

    Int textureByte(Int index) {
        if (!readValue || !textureValidValue || index < 0 ||
            index >= textureLengthValue) {
            return -1
        }
        return sourceValue[textureOffsetValue + index]
    }

    Int textureWidth() {
        if (!readValue || !textureValidValue) { return 0 }
        return textureWidthValue
    }

    Int textureHeight() {
        if (!readValue || !textureValidValue) { return 0 }
        return textureHeightValue
    }
}
