package content
class BoundedExternalGlbAssetStore {
    Int maximumBytesValue
    Int[] gooseSourceValue
    Int[] catSourceValue
    Int[] coffeeMugSourceValue
    Int[] wizardHatSourceValue
    Int[] bombSourceValue
    Bool gooseAttemptedValue
    Bool catAttemptedValue
    Bool coffeeMugAttemptedValue
    Bool wizardHatAttemptedValue
    Bool bombAttemptedValue

    public constructor() {
        maximumBytesValue = 1048576
        gooseSourceValue = new Int[0]
        catSourceValue = new Int[0]
        coffeeMugSourceValue = new Int[0]
        bombSourceValue = new Int[0]
        wizardHatSourceValue = new Int[0]
        gooseAttemptedValue = false
        catAttemptedValue = false
        coffeeMugAttemptedValue = false
        bombAttemptedValue = false
        wizardHatAttemptedValue = false
    }

    String relativePath(Int model) {
        if (model == 1) { return "models/goose/goose.glb" }
        if (model == 2) { return "models/cat/cat.glb" }
        if (model == 3) { return "models/coffee_mug/coffee_mug.glb" }
        if (model == 4) { return "models/wizard_hat/wizard_hat.glb" }
        if (model == 5) { return "models/bomb/bomb.glb" }
        return ""
    }
    String catalogRelativePath(Int token) {
        if (token == 51001) { return "models/modular/arrow.glb" }
        if (token == 51002) { return "models/modular/box.glb" }
        if (token == 51003) { return "models/modular/coin.glb" }
        if (token == 51004) { return "models/modular/cone.glb" }
        if (token == 51005) { return "models/modular/cone1.glb" }
        if (token == 51006) { return "models/modular/cone2.glb" }
        if (token == 51007) { return "models/modular/cone3.glb" }
        if (token == 51008) { return "models/modular/cone4.glb" }
        if (token == 51009) { return "models/modular/cube.glb" }
        if (token == 51010) { return "models/modular/cube4.glb" }
        if (token == 51011) { return "models/modular/cube5.glb" }
        if (token == 51012) { return "models/modular/cube6.glb" }
        if (token == 51013) { return "models/modular/cube7.glb" }
        if (token == 51014) { return "models/modular/cube8.glb" }
        if (token == 51015) { return "models/modular/cube9.glb" }
        if (token == 51016) { return "models/modular/cylinder.glb" }
        if (token == 51017) { return "models/modular/cylinder1.glb" }
        if (token == 51018) { return "models/modular/cylinder2.glb" }
        if (token == 51019) { return "models/modular/cylinder3.glb" }
        if (token == 51020) { return "models/modular/cylinder4.glb" }
        if (token == 51021) { return "models/modular/cylinder5.glb" }
        if (token == 51022) { return "models/modular/door.glb" }
        if (token == 51023) { return "models/modular/door1.glb" }
        if (token == 51024) { return "models/modular/door2.glb" }
        if (token == 51025) { return "models/modular/door3.glb" }
        if (token == 51026) { return "models/modular/fence_edge.glb" }
        if (token == 51027) { return "models/modular/fence_wood.glb" }
        if (token == 51028) { return "models/modular/fence.glb" }
        if (token == 51029) { return "models/modular/fence2.glb" }
        if (token == 51030) { return "models/modular/fence3.glb" }
        if (token == 51031) { return "models/modular/ground_corner.glb" }
        if (token == 51032) { return "models/modular/ground.glb" }
        if (token == 51033) { return "models/modular/ground1.glb" }
        if (token == 51034) { return "models/modular/key.glb" }
        if (token == 51035) { return "models/modular/ladder.glb" }
        if (token == 51036) { return "models/modular/ladder1.glb" }
        if (token == 51037) { return "models/modular/pillar.glb" }
        if (token == 51038) { return "models/modular/pillar1.glb" }
        if (token == 51039) { return "models/modular/pillar2.glb" }
        if (token == 51040) { return "models/modular/pillar3.glb" }
        if (token == 51041) { return "models/modular/pillar4.glb" }
        if (token == 51042) { return "models/modular/railing_edge.glb" }
        if (token == 51043) { return "models/modular/railing.glb" }
        if (token == 51044) { return "models/modular/ramp.glb" }
        if (token == 51045) { return "models/modular/ramp1.glb" }
