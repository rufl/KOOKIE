        if (token == 51047) { return "models/modular/sphere1.glb" }
        if (token == 51048) { return "models/modular/sphere2.glb" }
        if (token == 51049) { return "models/modular/spike.glb" }
        if (token == 51050) { return "models/modular/spikes_big.glb" }
        if (token == 51051) { return "models/modular/spikes_small.glb" }
        if (token == 51052) { return "models/modular/stairs_corner.glb" }
        if (token == 51053) { return "models/modular/stairs_corner1.glb" }
        if (token == 51054) { return "models/modular/stairs.glb" }
        if (token == 51055) { return "models/modular/stairs1.glb" }
        if (token == 51056) { return "models/modular/stairs2.glb" }
        if (token == 51057) { return "models/modular/toggle_switch.glb" }
