        if (token == 51066) { return "models/modular/wall_corner4.glb" }
        if (token == 51067) { return "models/modular/wall_door.glb" }
        if (token == 51068) { return "models/modular/wall_door1.glb" }
        if (token == 51069) { return "models/modular/wall_door2.glb" }
        if (token == 51070) { return "models/modular/wall_window.glb" }
        if (token == 51071) { return "models/modular/wall_window1.glb" }
        if (token == 51072) { return "models/modular/wall.glb" }
        if (token == 51073) { return "models/modular/wall1.glb" }
        if (token == 51074) { return "models/modular/window.glb" }
        if (token == 51075) { return "models/modular/window1.glb" }
        return ""
    }

    Int[] readCatalogCandidate(Int token, String root) {
        var relative = catalogRelativePath(token)
        if (relative.length() == 0 || root.length() == 0) {
            return new Int[0]
        }
        var file = File(root + "/" + relative)
        if (!file.exists()) { return new Int[0] }
        var bytes = file.readRange(0, maximumBytesValue + 1)
        if (bytes == null || bytes.length < 20 ||
            bytes.length > maximumBytesValue) {
            return new Int[0]
        }
        return bytes
    }

    Int[] catalogBytes(Int token) {
        if (catalogRelativePath(token).length() == 0) { return new Int[0] }
        var bytes = readCatalogCandidate(token, "content/prototype")
        if (bytes.length == 0) {
            bytes = readCatalogCandidate(token, "assets/prototype")
        }
        return bytes
    }

    Int[] readCandidate(Int model, String root) {
        var relative = relativePath(model)
        if (relative.length() == 0 || root.length() == 0) {
            return new Int[0]
        }
        var path = root + "/" + relative
        var file = File(path)
        if (!file.exists()) {
            return new Int[0]
        }
        var bytes = file.readRange(0, maximumBytesValue + 1)
        if (bytes == null || bytes.length < 20 ||
            bytes.length > maximumBytesValue) {
            return new Int[0]
        }
        return bytes
    }

    Bool load(Int model) {
        if (model < 1 || model > 5) { return false }
        if (model == 1 && gooseAttemptedValue) {
            return gooseSourceValue.length > 0
        }
        if (model == 2 && catAttemptedValue) {
            return catSourceValue.length > 0
        }
        if (model == 3 && coffeeMugAttemptedValue) {
            return coffeeMugSourceValue.length > 0
        }
        if (model == 4 && wizardHatAttemptedValue) {
            return wizardHatSourceValue.length > 0
        }
        if (model == 5 && bombAttemptedValue) {
            return bombSourceValue.length > 0
        }
        if (model == 1) { gooseAttemptedValue = true }
        if (model == 2) { catAttemptedValue = true }
        if (model == 3) { coffeeMugAttemptedValue = true }
        if (model == 4) { wizardHatAttemptedValue = true }
        if (model == 5) { bombAttemptedValue = true }
        var roots = 0
        while (roots < 2) {
            var root = "content/prototype"
            if (roots == 1) { root = "assets/prototype" }
            var candidate = readCandidate(model, root)
            if (candidate.length > 0) {
                if (model == 1) { gooseSourceValue = candidate }
                if (model == 2) { catSourceValue = candidate }
                if (model == 3) { coffeeMugSourceValue = candidate }
                if (model == 4) { wizardHatSourceValue = candidate }
                if (model == 5) { bombSourceValue = candidate }
                return true
            }
            roots = roots + 1
        }
        return false
    }

    Bool required() {
        return File("content/prototype/manifest.json").exists() ||
            File("assets/prototype/manifest.json").exists()
    }

    Bool available(Int model) {
        return load(model)
    }

    Int[] bytes(Int model) {
        if (!load(model)) { return new Int[0] }
        if (model == 1) { return gooseSourceValue }
        if (model == 2) { return catSourceValue }
        if (model == 3) { return coffeeMugSourceValue }
        if (model == 4) { return wizardHatSourceValue }
        if (model == 5) { return bombSourceValue }
        return new Int[0]
    }
}
