package core

class BoundedSaveFileStore {
    BoundedSaveWireCodec codec
    Int[] bytes
    Int digitsPerWord

    public constructor(Int payloadCapacity) {
        var actualCapacity = payloadCapacity
        if (actualCapacity <= 0) {
            actualCapacity = 1
        }
        if (actualCapacity > 64) {
            actualCapacity = 64
        }
        codec = BoundedSaveWireCodec(actualCapacity)
        digitsPerWord = 6
        bytes = new Int[(actualCapacity + 5) * digitsPerWord]
    }

    Bool write(String path, BoundedSaveState state) {
        if (!codec.encode(state)) {
            return false
        }
        var byteCount = codec.encodedLength() * digitsPerWord
        for (var index = 0; index < byteCount; index = index + 1) {
            bytes[index] = 0
        }
        for (var wordIndex = 0; wordIndex < codec.encodedLength(); wordIndex = wordIndex + 1) {
            var value = codec.encodedWord(wordIndex)
            for (var digit = 0; digit < digitsPerWord; digit = digit + 1) {
                bytes[wordIndex * digitsPerWord + digit] = value % 64
                value = value / 64
            }
        }
        var output = new Int[byteCount]
        for (var index = 0; index < byteCount; index = index + 1) {
            output[index] = bytes[index]
        }
        var file = File(path)
        return file.writeBytes(output)
    }

    Bool read(String path, BoundedSaveState target) {
        var file = File(path)
        var input = file.readRange(0, bytes.length)
        if (input.length < 5 * digitsPerWord ||
            input.length > bytes.length ||
            input.length % digitsPerWord != 0) {
            return false
        }
        var words = new Int[input.length / digitsPerWord]
        for (var wordIndex = 0; wordIndex < words.length; wordIndex = wordIndex + 1) {
            var offset = wordIndex * digitsPerWord
            var value = 0
            var multiplier = 1
            for (var digit = 0; digit < digitsPerWord; digit = digit + 1) {
                if (input[offset + digit] < 0 || input[offset + digit] >= 64 ||
                    (digit == digitsPerWord - 1 && input[offset + digit] != 0)) {
                    return false
                }
                value = value + input[offset + digit] * multiplier
                if (digit < digitsPerWord - 1) {
                    multiplier = multiplier * 64
                }
            }
            words[wordIndex] = value
        }
        return codec.decode(words, target)
    }
}
