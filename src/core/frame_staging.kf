package core

class FrameStaging {
    Int[] resources
    Int[] xs
    Int[] ys
    Int[] zs
    Int[] depths
    Int[] us
    Int[] vs
    Int frame
    Int published
    Int retired
    Int count
    Int writes
    Bool open

    public constructor(Int capacity) {
        this.resources = new Int[capacity]
        this.xs = new Int[capacity]
        this.ys = new Int[capacity]
        this.zs = new Int[capacity]
        this.depths = new Int[capacity]
        this.us = new Int[capacity]
        this.vs = new Int[capacity]
        this.frame = 0
        this.published = 0
        this.retired = 0
        this.count = 0
        this.writes = 0
        this.open = false
    }
    Bool begin(Int nextFrame) {
        if (open || nextFrame <= 0 || nextFrame <= published) {
            return false
        }
        frame = nextFrame
        count = 0
        writes = 0
        open = true
        return true
    }

    Bool pushVertex(Int resource, Int x, Int y, Int u, Int v) {
        return pushVertexDepth(resource, x, y, 0, u, v)
    }

    Bool pushVertexDepth(
        Int resource, Int x, Int y, Int depth, Int u, Int v
    ) {
        if (!open || resource <= 0 || depth < 0 || depth > 100 ||
            count >= resources.length) {
            return false
        }
        resources[count] = resource
        xs[count] = x
        ys[count] = y
        zs[count] = 0
        depths[count] = depth
        us[count] = u
        vs[count] = v
        count = count + 1
        writes = writes + 5
        return true
    }
    Bool pushWorldVertex(
        Int resource, Int x, Int y, Int z, Int u, Int v
    ) {
        if (!open || resource <= 0 || count >= resources.length) {
            return false
        }
        resources[count] = resource
        xs[count] = x
        ys[count] = y
        zs[count] = z
        depths[count] = 0
        us[count] = u
        vs[count] = v
        count = count + 1
        writes = writes + 5
        return true
    }

    Bool publish() {
        if (!open || count == 0) {
            return false
        }
        published = frame
        open = false
        return true
    }

    Bool retire(Int frameId) {
        if (open || frameId != published || frameId <= retired) {
            return false
        }
        retired = frameId
        return true
    }

    Bool discard() {
        if (!open) {
            return false
        }
        count = 0
        writes = 0
        open = false
        return true
    }

    Bool isOpen() {
        return open
    }

    Int stagedCount() {
        return count
    }

    Int scalarWrites() {
        return writes
    }
    Int scalarBudget() {
        return resources.length * 5
    }

    Bool fitsScalarBudget(Int budget) {
        return budget > 0 && writes <= budget
    }

    Int publishedFrame() {
        return published
    }
    Int retiredFrame() {
        return retired
    }
    Int vertexCapacity() {
        return resources.length
    }

    Int resourceAt(Int index) {
        if (index < 0 || index >= count) {
            return 0
        }
        return resources[index]
    }

    Int xAt(Int index) {
        if (index < 0 || index >= count) {
            return 0
        }
        return xs[index]
    }

    Int yAt(Int index) {
        if (index < 0 || index >= count) {
            return 0
        }
        return ys[index]
    }
    Int zAt(Int index) {
        if (index < 0 || index >= count) {
            return 0
        }
        return zs[index]
    }

    Int depthAt(Int index) {
        if (index < 0 || index >= count) {
            return 0
        }
        return depths[index]
    }
    Bool setDepthAt(Int index, Int depth) {
        if (!open || index < 0 || index >= count ||
            depth < 0 || depth > 100) {
            return false
        }
        depths[index] = depth
        return true
    }

    Int uAt(Int index) {
        if (index < 0 || index >= count) {
            return 0
        }
        return us[index]
    }

    Int vAt(Int index) {
        if (index < 0 || index >= count) {
            return 0
        }
        return vs[index]
    }


    Int checksum() {
        var total = 0
        for (var index = 0; index < count; index = index + 1) {
            total = total + resources[index] + xs[index] + ys[index] +
                zs[index] + depths[index] + us[index] + vs[index]
        }
        return total
    }
}
