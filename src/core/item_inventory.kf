package core

class BoundedCurrencySaveSection {
    Int amountValue

    public constructor() {
        amountValue = 0
    }

    Bool setAmount(Int amount) {
        if (amount < 0 || amount > 1000000) {
            return false
        }
        amountValue = amount
        return true
    }

    Int amount() {
        return amountValue
    }

    Bool encodeInto(BoundedSaveSections target) {
        var payload = new Int[1]
        payload[0] = amountValue
        return target.put(6, 1, payload)
    }

    Bool decodeFrom(BoundedSaveSections source) {
        var section = -1
        for (var index = 0; index < source.sectionCount(); index = index + 1) {
            if (source.sectionId(index) == 6) {
                section = index
                break
            }
        }
        if (section < 0 || source.sectionVersion(section) != 1 ||
            source.sectionLength(section) != 1 ||
            source.sectionValue(section, 0) < 0 ||
            source.sectionValue(section, 0) > 1000000) {
            return false
        }
        amountValue = source.sectionValue(section, 0)
        return true
    }
}

class BoundedItemInventory {
    Int ownerValue
    BoundedItemSaveSection items
    BoundedItemRollSaveSection rolls
    Int currencyValue
    Int revisionValue

    public constructor(Int ownerId, Int capacity) {
        ownerValue = ownerId
        items = BoundedItemSaveSection(capacity)
        rolls = BoundedItemRollSaveSection(capacity)
        currencyValue = 0
        revisionValue = 0
    }


    Int ownerId() {
        return ownerValue
    }


    Int revision() {
        return revisionValue
    }
    Int currency() {
        return currencyValue
    }

    Int itemCount() {
        return items.count()
    }

    Int itemCapacity() {
        return items.capacity()
    }

    Int rolledItemCount() {
        return rolls.count()
    }

    Int rolledItemCapacity() {
        return rolls.capacity()
    }

    Int itemId(Int index) {
        return items.itemId(index)
    }


    BoundedItemRoll itemRoll(Int index) {
        if (index < 0 || index >= items.count()) {
            return BoundedItemRoll()
        }
        return rolls.at(rolls.find(items.itemId(index)))
    }
    Int itemQuantity(Int index) {
        return items.quantity(index)
    }

    Bool setCurrency(Int amount) {
        if (amount < 0 || amount > 1000000) {
            return false
        }
        currencyValue = amount
        revisionValue = revisionValue + 1
        return true
    }

    Bool depositCurrency(Int amount) {
        if (amount <= 0 || currencyValue > 1000000 - amount) {
            return false
        }
        currencyValue = currencyValue + amount
        revisionValue = revisionValue + 1
        return true
    }

    Bool withdrawCurrency(Int amount) {
        if (amount <= 0 || amount > currencyValue) {
            return false
        }
        currencyValue = currencyValue - amount
        revisionValue = revisionValue + 1
        return true
    }

    Bool addItem(Int itemId, Int quantity) {
        if (!items.add(itemId, ownerValue, quantity)) {
            return false
        }
        revisionValue = revisionValue + 1
        return true
    }
    Bool addLootedItem(BoundedItemRoll roll, Int quantity) {
        if (!roll.accepted() || rolls.count() >= rolls.capacity()) {
            return false
        }
        if (!items.add(roll.stableId(), ownerValue, quantity)) {
            return false
        }
        if (!rolls.add(roll)) {
            items.remove(roll.stableId(), quantity)
            return false
        }
        revisionValue = revisionValue + 1
        return true
    }

    Bool removeItem(Int itemId, Int quantity) {
        var index = items.find(itemId)
        if (index < 0 || quantity <= 0 ||
            quantity > items.quantity(index)) {
            return false
        }
        var removesItem = quantity == items.quantity(index)
        if (!items.remove(itemId, quantity)) {
            return false
        }
        if (removesItem && rolls.find(itemId) >= 0) {
            rolls.remove(itemId)
        }
        revisionValue = revisionValue + 1
        return true
    }

    Bool purchaseFrom(
        BoundedItemInventory seller, Int itemId, Int quantity, Int unitPrice
    ) {
        if (seller.ownerId() == ownerValue || quantity <= 0 || unitPrice <= 0 ||
            quantity > 1000000 || unitPrice > 1000000 / quantity) {
            return false
        }
        var sellerIndex = seller.items.find(itemId)
        var sellerRollIndex = seller.rolls.find(itemId)
        if (sellerIndex < 0 || seller.items.ownerId(sellerIndex) != seller.ownerValue ||
            seller.items.quantity(sellerIndex) < quantity || items.find(itemId) >= 0 ||
            items.count() >= items.capacity() ||
            (sellerRollIndex >= 0 &&
                (seller.items.quantity(sellerIndex) != quantity ||
                    rolls.count() >= rolls.capacity()))) {
            return false
        }
        var total = quantity * unitPrice
        if (currencyValue < total || seller.currencyValue > 1000000 - total) {
            return false
        }
        var transferred = BoundedItemRoll()
        if (sellerRollIndex >= 0) {
            transferred = seller.rolls.at(sellerRollIndex)
            if (!rolls.add(transferred)) {
                return false
            }
        }
        if (!seller.items.remove(itemId, quantity) ||
            !items.add(itemId, ownerValue, quantity)) {
            if (sellerRollIndex >= 0) {
                rolls.remove(itemId)
            }
            return false
        }
        if (sellerRollIndex >= 0) {
            seller.rolls.remove(itemId)
        }
        currencyValue = currencyValue - total
        seller.currencyValue = seller.currencyValue + total
        revisionValue = revisionValue + 1
        seller.revisionValue = seller.revisionValue + 1
        return true
    }

    Bool encodeInto(BoundedSaveSections target) {
        var currency = BoundedCurrencySaveSection()
        if (!items.encodeInto(target) || !currency.setAmount(currencyValue) ||
            !currency.encodeInto(target) || !rolls.encodeInto(target)) {
            return false
        }
        return true
    }

    Bool decodeFrom(BoundedSaveSections source) {
        var decodedItems = BoundedItemSaveSection(items.capacity())
        var currency = BoundedCurrencySaveSection()
        var decodedRolls = BoundedItemRollSaveSection(items.capacity())
        if (!decodedItems.decodeFrom(source) || !currency.decodeFrom(source) ||
            !decodedRolls.decodeFrom(source)) {
            return false
        }
        for (var index = 0; index < decodedItems.count(); index = index + 1) {
            if (decodedItems.ownerId(index) != ownerValue) {
                return false
            }
        }
        for (var rollIndex = 0; rollIndex < decodedRolls.count(); rollIndex = rollIndex + 1) {
            if (decodedItems.find(decodedRolls.at(rollIndex).stableId()) < 0) {
                return false
            }
        }
        items = decodedItems
        rolls = decodedRolls
        currencyValue = currency.amount()
        revisionValue = revisionValue + 1
        return true
    }
}
