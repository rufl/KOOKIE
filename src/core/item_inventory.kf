package core

class BoundedCurrencySaveSection {
    Int amountValue

    public constructor() {
        amountValue = 0
    }

    Bool setAmount(Int amount) {
        if (amount < 0 || amount > 1000000) {
            return false
        }
        amountValue = amount
        return true
    }

    Int amount() {
        return amountValue
    }

    Bool encodeInto(BoundedSaveSections target) {
        var payload = new Int[1]
        payload[0] = amountValue
        return target.put(6, 1, payload)
    }

    Bool decodeFrom(BoundedSaveSections source) {
        var section = -1
        for (var index = 0; index < source.sectionCount(); index = index + 1) {
            if (source.sectionId(index) == 6) {
                section = index
                break
            }
        }
        if (section < 0 || source.sectionVersion(section) != 1 ||
            source.sectionLength(section) != 1 ||
            source.sectionValue(section, 0) < 0 ||
            source.sectionValue(section, 0) > 1000000) {
            return false
        }
        amountValue = source.sectionValue(section, 0)
        return true
    }
}

class BoundedItemInventory {
    Int ownerValue
    BoundedItemSaveSection items
    Int currencyValue

    public constructor(Int ownerId, Int capacity) {
        ownerValue = ownerId
        items = BoundedItemSaveSection(capacity)
        currencyValue = 0
    }

    Int ownerId() {
        return ownerValue
    }

    Int currency() {
        return currencyValue
    }

    Int itemCount() {
        return items.count()
    }

    Int itemId(Int index) {
        return items.itemId(index)
    }

    Int itemQuantity(Int index) {
        return items.quantity(index)
    }

    Bool setCurrency(Int amount) {
        if (amount < 0 || amount > 1000000) {
            return false
        }
        currencyValue = amount
        return true
    }

    Bool depositCurrency(Int amount) {
        if (amount <= 0 || currencyValue > 1000000 - amount) {
            return false
        }
        currencyValue = currencyValue + amount
        return true
    }

    Bool withdrawCurrency(Int amount) {
        if (amount <= 0 || amount > currencyValue) {
            return false
        }
        currencyValue = currencyValue - amount
        return true
    }

    Bool addItem(Int itemId, Int quantity) {
        return items.add(itemId, ownerValue, quantity)
    }

    Bool addLootedItem(BoundedItemRoll roll, Int quantity) {
        if (!roll.accepted()) {
            return false
        }
        return items.add(roll.stableId(), ownerValue, quantity)
    }

    Bool removeItem(Int itemId, Int quantity) {
        return items.remove(itemId, quantity)
    }

    Bool purchaseFrom(
        BoundedItemInventory seller, Int itemId, Int quantity, Int unitPrice
    ) {
        if (seller.ownerId() == ownerValue || quantity <= 0 || unitPrice <= 0 ||
            quantity > 1000000 || unitPrice > 1000000 / quantity) {
            return false
        }
        var sellerIndex = seller.items.find(itemId)
        if (sellerIndex < 0 || seller.items.ownerId(sellerIndex) != seller.ownerValue ||
            seller.items.quantity(sellerIndex) < quantity || items.find(itemId) >= 0 ||
            items.count() >= items.capacity()) {
            return false
        }
        var total = quantity * unitPrice
        if (currencyValue < total || seller.currencyValue > 1000000 - total) {
            return false
        }
        if (!seller.items.remove(itemId, quantity) ||
            !items.add(itemId, ownerValue, quantity)) {
            return false
        }
        currencyValue = currencyValue - total
        seller.currencyValue = seller.currencyValue + total
        return true
    }

    Bool encodeInto(BoundedSaveSections target) {
        var currency = BoundedCurrencySaveSection()
        if (!items.encodeInto(target) || !currency.setAmount(currencyValue) ||
            !currency.encodeInto(target)) {
            return false
        }
        return true
    }

    Bool decodeFrom(BoundedSaveSections source) {
        var decodedItems = BoundedItemSaveSection(items.capacity())
        var currency = BoundedCurrencySaveSection()
        if (!decodedItems.decodeFrom(source) || !currency.decodeFrom(source)) {
            return false
        }
        for (var index = 0; index < decodedItems.count(); index = index + 1) {
            if (decodedItems.ownerId(index) != ownerValue) {
                return false
            }
        }
        items = decodedItems
        currencyValue = currency.amount()
        return true
    }
}
