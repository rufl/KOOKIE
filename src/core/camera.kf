package core

record MappedInput(Int moveX, Int moveY, Int lookX, Int lookY, Int fire, Int jump)

class InputMapper {
    Int maxAxis

    public constructor(Int nextMaxAxis) {
        maxAxis = nextMaxAxis
        if (maxAxis <= 0) {
            maxAxis = 1
        }
    }

    Int clamp(Int value) {
        if (value > maxAxis) {
            return maxAxis
        }
        if (value < -maxAxis) {
            return -maxAxis
        }
        return value
    }

    MappedInput map(Int moveX, Int moveY, Int lookX, Int lookY, Int fire, Int jump) {
        var safeFire = fire
        var safeJump = jump
        if (safeFire < 0) {
            safeFire = 0
        }
        if (safeFire > 1) {
            safeFire = 1
        }
        if (safeJump < 0) {
            safeJump = 0
        }
        if (safeJump > 1) {
            safeJump = 1
        }
        return MappedInput(
            clamp(moveX), clamp(moveY), clamp(lookX), clamp(lookY), safeFire, safeJump)
    }

}

Int clampMovementAxis(Int value) {
    if (value < -4) { return -4 }
    if (value > 4) { return 4 }
    return value
}

Int movementForwardAxis(Int forwardPressed, Int backwardPressed) {
    var value = 0
    if (forwardPressed != 0) { value = value + 1 }
    if (backwardPressed != 0) { value = value - 1 }
    return clampMovementAxis(value)
}

Int movementStrafeAxis(Int leftPressed, Int rightPressed) {
    var value = 0
    if (leftPressed != 0) { value = value + 1 }
    if (rightPressed != 0) { value = value - 1 }
    return clampMovementAxis(value)
}

class CameraState {
    Int yaw
    Int pitch
    Int minPitch
    Int maxPitch
    Int followTargetXValue
    Int followTargetYValue
    Int followTargetZValue
    Int followXValue
    Int followYValue
    Int followZValue
    Int followDistanceValue
    Int desiredFollowDistanceValue
    Int[] sineValues
    Bool followReadyValue

    public constructor(Int nextMinPitch, Int nextMaxPitch) {
        yaw = 0
        pitch = 0
        minPitch = nextMinPitch
        maxPitch = nextMaxPitch
        if (minPitch > maxPitch) {
            minPitch = -890
            maxPitch = 890
        }
        followTargetXValue = 0
        followTargetYValue = 0
        followTargetZValue = 0
        followXValue = 0
        followYValue = 4
        followZValue = -8
        followDistanceValue = 10
        desiredFollowDistanceValue = 10
        followReadyValue = false
        sineValues = new Int[10]
        sineValues[0] = 0
        sineValues[1] = 174
        sineValues[2] = 342
        sineValues[3] = 500
        sineValues[4] = 643
        sineValues[5] = 766
        sineValues[6] = 866
        sineValues[7] = 940
        sineValues[8] = 985
        sineValues[9] = 1000
    }

    Bool applyLook(Int deltaYaw, Int deltaPitch) {
        yaw = yaw + deltaYaw
        pitch = pitch + deltaPitch
        if (pitch < minPitch) {
            pitch = minPitch
        }
        if (pitch > maxPitch) {
            pitch = maxPitch
        }
        return true
    }

    Bool applyZoom(Int wheel) {
        if (wheel < -8) { wheel = -8 }
        if (wheel > 8) { wheel = 8 }
        desiredFollowDistanceValue =
            desiredFollowDistanceValue - wheel * 2
        if (desiredFollowDistanceValue < 0) {
            desiredFollowDistanceValue = 0
        }
        if (desiredFollowDistanceValue > 12) {
            desiredFollowDistanceValue = 12
        }
        return true
    }

    Int approach(Int current, Int target, Int divisor) {
        var delta = target - current
        if (delta == 0) { return current }
        var step = delta / divisor
        if (step == 0) {
            step = if (delta > 0) 1 else -1
        }
        return current + step
    }

    Int normalizedYaw() {
        var value = yaw % 360
        if (value < 0) { value = value + 360 }
        return value
    }

    Int yawSector() {
        var sector = (normalizedYaw() + 22) / 45
        if (sector >= 8) { sector = sector - 8 }
        return sector
    }

    Int movementForwardX() {
        var sector = yawSector()
        if (sector == 1 || sector == 2 || sector == 3) { return 1 }
        if (sector == 5 || sector == 6 || sector == 7) { return -1 }
        return 0
    }

    Int movementForwardZ() {
        var sector = yawSector()
        if (sector == 0 || sector == 1 || sector == 7) { return 1 }
        if (sector == 3 || sector == 4 || sector == 5) { return -1 }
        return 0
    }

    Int movementLeftX() {
        return -movementForwardZ()
    }

    Int movementLeftZ() {
        return movementForwardX()
    }

    Int movementWorldX(Int forward, Int strafe) {
        return clampMovementAxis(
            forward * movementForwardX() + strafe * movementLeftX())
    }

    Int movementWorldZ(Int forward, Int strafe) {
        return clampMovementAxis(
            forward * movementForwardZ() + strafe * movementLeftZ())
    }

    Int followDirectionX() {
        var sector = yawSector()
        if (sector == 2 || sector == 6) {
            return if (sector == 2) 100 else -100
        }
        if (sector == 1 || sector == 3) { return 71 }
        if (sector == 5 || sector == 7) { return -71 }
        return 0
    }

    Int followDirectionZ() {
        var sector = yawSector()
        if (sector == 0) { return 100 }
        if (sector == 4) { return -100 }
        if (sector == 1 || sector == 7) { return 71 }
        if (sector == 3 || sector == 5) { return -71 }
        return 0
    }

    Int desiredFollowX() {
        return followTargetXValue -
            followDirectionX() * followDistanceValue / 100
    }

    Int desiredFollowY() {
        return followTargetYValue + 4 + followDistanceValue / 4
    }

    Int desiredFollowZ() {
        return followTargetZValue -
            followDirectionZ() * followDistanceValue / 100
    }

    Bool setFollowTarget(Int x, Int y, Int z) {
        if (x < -900 || x > 900 ||
            y < -900 || y > 900 ||
            z < -900 || z > 900) {
            return false
        }
        followTargetXValue = x
        followTargetYValue = y
        followTargetZValue = z
        followReadyValue = true
        return true
    }

    Bool hasFollowTarget() {
        return followReadyValue
    }

    Bool snapFollowTarget() {
        if (!followReadyValue) { return false }
        followXValue = desiredFollowX()
        followYValue = desiredFollowY()
        followZValue = desiredFollowZ()
        followDistanceValue = desiredFollowDistanceValue
        return true
    }

    Bool clearFollowTarget() {
        followReadyValue = false
        return true
    }

    Bool stepFollow() {
        if (!followReadyValue) { return false }
        followDistanceValue = approach(
            followDistanceValue, desiredFollowDistanceValue, 3)
        followXValue = approach(followXValue, desiredFollowX(), 4)
        followYValue = approach(followYValue, desiredFollowY(), 4)
        followZValue = approach(followZValue, desiredFollowZ(), 4)
        return true
    }

    Bool resolveFollowCollision(BoundedTriangleCollection geometry) {
        if (!followReadyValue) { return false }
        var result = geometry.query(
            followTargetXValue, followTargetYValue, followTargetZValue,
            followXValue, followYValue, followZValue)
        if (!result.accepted()) {
            return false
        }
        if (result.collided()) {
            followXValue = result.resolvedX()
            followYValue = result.resolvedY()
            followZValue = result.resolvedZ()
        }
        return true
    }
    Int sineFixed(Int angle) {
        var normalized = angle % 360
        if (normalized < 0) { normalized = normalized + 360 }
        var sign = 1
        if (normalized >= 180) {
            normalized = normalized - 180
            sign = -1
        }
        if (normalized > 90) {
            normalized = 180 - normalized
        }
        var index = normalized / 10
        var value = sineValues[9]
        if (index < 9) {
            var remainder = normalized % 10
            value = sineValues[index] +
                (sineValues[index + 1] - sineValues[index]) *
                remainder / 10
        }
        return sign * value
    }

    Int cosineFixed(Int angle) {
        return sineFixed(angle + 90)
    }

    Int aimDirectionX() {
        return sineFixed(yaw) * cosineFixed(pitch) / 1000
    }

    Int aimDirectionY() {
        return sineFixed(pitch)
    }

    Int aimDirectionZ() {
        return cosineFixed(yaw) * cosineFixed(pitch) / 1000
    }

    Int aimEndX(Int distance) {
        return followXValue + aimDirectionX() * distance / 1000
    }

    Int aimEndY(Int distance) {
        return followYValue + aimDirectionY() * distance / 1000
    }

    Int aimEndZ(Int distance) {
        return followZValue + aimDirectionZ() * distance / 1000
    }

    Int viewRightDot(Int x, Int y, Int z) {
        return cosineFixed(yaw) * (x - followXValue) -
            sineFixed(yaw) * (z - followZValue)
    }

    Int viewUpDot(Int x, Int y, Int z) {
        var sinPitch = sineFixed(pitch)
        var sinYaw = sineFixed(yaw)
        var cosYaw = cosineFixed(yaw)
        var upX = -sinPitch * sinYaw / 1000
        var upY = cosineFixed(pitch)
        var upZ = -sinPitch * cosYaw / 1000
        return upX * (x - followXValue) +
            upY * (y - followYValue) +
            upZ * (z - followZValue)
    }

    Int viewForwardDot(Int x, Int y, Int z) {
        return aimDirectionX() * (x - followXValue) +
            aimDirectionY() * (y - followYValue) +
            aimDirectionZ() * (z - followZValue)
    }

    Int projectScreenX(Int x, Int y, Int z) {
        var depth = viewForwardDot(x, y, z)
        var right = viewRightDot(x, y, z)
        if (depth <= 0) {
            return if (right >= 0) 100 else -100
        }
        return right * 73 / depth
    }

    Int projectScreenY(Int x, Int y, Int z) {
        var depth = viewForwardDot(x, y, z)
        var up = viewUpDot(x, y, z)
        if (depth <= 0) {
            return if (up >= 0) 100 else -100
        }
        return up * 130 / depth
    }

    Int projectScreenDepth(Int x, Int y, Int z) {
        var depth = viewForwardDot(x, y, z) / 1000
        depth = depth * 2
        if (depth < 1) { return 1 }
        if (depth > 99) { return 99 }
        return depth
    }

    Int currentX() { return followXValue }
    Int currentY() { return followYValue }
    Int currentZ() { return followZValue }
    Int currentFollowDistance() { return followDistanceValue }
    Int desiredFollowDistance() { return desiredFollowDistanceValue }

    Int currentYaw() {
        return yaw
    }

    Int currentPitch() {
        return pitch
    }
}
