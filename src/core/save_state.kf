package core

record SaveEnvelope(
    Bool accepted, Int schemaVersion, Int revision,
    Int payloadLength, Int checksum
)

class BoundedSaveState {
    Int[] values
    Int length
    Int version
    Int revisionValue
    Int checksumValue
    Int maxValue
    Bool staged

    public constructor(Int capacity, Int valueLimit) {
        var actualCapacity = capacity
        if (actualCapacity <= 0) {
            actualCapacity = 1
        }
        values = new Int[actualCapacity]
        length = 0
        version = 0
        revisionValue = 0
        checksumValue = 0
        maxValue = valueLimit
        if (maxValue <= 0) {
            maxValue = 1000000
        }
        staged = false
    }

    Int checksumFor(Int schemaVersion, Int revision, Int[] payload) {
        var checksum = 1
        var boundedRevision = revision % 1000003
        checksum = (checksum + schemaVersion * 31 + boundedRevision * 17) % 1000003
        for (var index = 0; index < payload.length; index = index + 1) {
            checksum = (
                checksum + payload[index] + (index + 1) * 17
            ) % 1000003
        }
        return checksum
    }

    Bool validPayload(Int schemaVersion, Int revision, Int[] payload) {
        if (schemaVersion != 1 || revision < 0 || revision > 1000000 ||
            payload.length > values.length) {
            return false
        }
        for (var index = 0; index < payload.length; index = index + 1) {
            if (payload[index] < 0 || payload[index] > maxValue) {
                return false
            }
        }
        return true
    }

    Bool stage(Int schemaVersion, Int revision, Int[] payload) {
        if (!validPayload(schemaVersion, revision, payload)) {
            return false
        }
        for (var index = 0; index < payload.length; index = index + 1) {
            values[index] = payload[index]
        }
        length = payload.length
        version = schemaVersion
        revisionValue = revision
        checksumValue = checksumFor(schemaVersion, revision, payload)
        staged = true
        return true
    }

    Bool load(SaveEnvelope envelope, Int[] payload) {
        if (!envelope.accepted() ||
            !validPayload(envelope.schemaVersion(), envelope.revision(), payload) ||
            envelope.payloadLength() != payload.length ||
            envelope.checksum() != checksumFor(
                envelope.schemaVersion(), envelope.revision(), payload)) {
            return false
        }
        return stage(envelope.schemaVersion(), envelope.revision(), payload)
    }

    SaveEnvelope envelope() {
        if (!staged) {
            return SaveEnvelope(false, 0, 0, 0, 0)
        }
        return SaveEnvelope(
            true, version, revisionValue, length, checksumValue)
    }

    Bool isStaged() {
        return staged
    }

    Int payloadLength() {
        return length
    }

    Int schemaVersion() {
        return version
    }

    Int revision() {
        return revisionValue
    }

    Int payloadValue(Int index) {
        if (!staged || index < 0 || index >= length) {
            return -1
        }
        return values[index]
    }

    Bool clear() {
        if (!staged) {
            return false
        }
        length = 0
        version = 0
        revisionValue = 0
        checksumValue = 0
        staged = false
        return true
    }
}

class BoundedSaveHistory {
    Int[] revisions
    Int[] lengths
    Int[] checksums
    Int[] payloads
    Bool[] occupied
    Int payloadCapacity
    Int nextSlot
    Int countValue

    public constructor(Int historyCapacity, Int nextPayloadCapacity) {
        var actualHistory = historyCapacity
        var actualPayloadCapacity = nextPayloadCapacity
        if (actualHistory <= 0) {
            actualHistory = 1
        }
        if (actualHistory > 64) {
            actualHistory = 64
        }
        if (actualPayloadCapacity <= 0) {
            actualPayloadCapacity = 1
        }
        if (actualPayloadCapacity > 64) {
            actualPayloadCapacity = 64
        }
        revisions = new Int[actualHistory]
        lengths = new Int[actualHistory]
        checksums = new Int[actualHistory]
        payloads = new Int[actualHistory * actualPayloadCapacity]
        occupied = new Bool[actualHistory]
        payloadCapacity = actualPayloadCapacity
        nextSlot = 0
        countValue = 0
        for (var index = 0; index < actualHistory; index = index + 1) {
            revisions[index] = 0
            lengths[index] = 0
            checksums[index] = 0
            occupied[index] = false
        }
    }

    Int findRevision(Int revision) {
        for (var index = 0; index < revisions.length; index = index + 1) {
            if (occupied[index] && revisions[index] == revision) {
                return index
            }
        }
        return -1
    }

    Int latestSlot() {
        var slot = -1
        for (var index = 0; index < revisions.length; index = index + 1) {
            if (occupied[index] &&
                (slot < 0 || revisions[index] > revisions[slot])) {
                slot = index
            }
        }
        return slot
    }

    Bool publish(BoundedSaveState state) {
        var envelope = state.envelope()
        if (!envelope.accepted() || envelope.schemaVersion() != 1 ||
            envelope.payloadLength() > payloadCapacity ||
            findRevision(envelope.revision()) >= 0) {
            return false
        }
        var latest = latestSlot()
        if (latest >= 0 && envelope.revision() <= revisions[latest]) {
            return false
        }
        var slot = nextSlot
        for (var index = 0; index < envelope.payloadLength(); index = index + 1) {
            payloads[slot * payloadCapacity + index] = state.payloadValue(index)
        }
        revisions[slot] = envelope.revision()
        lengths[slot] = envelope.payloadLength()
        checksums[slot] = envelope.checksum()
        occupied[slot] = true
        nextSlot = nextSlot + 1
        if (nextSlot >= revisions.length) {
            nextSlot = 0
        }
        if (countValue < revisions.length) {
            countValue = countValue + 1
        }
        return true
    }

    Bool restore(Int revision, BoundedSaveState target) {
        var slot = findRevision(revision)
        if (slot < 0) {
            return false
        }
        var payload = new Int[lengths[slot]]
        for (var index = 0; index < payload.length; index = index + 1) {
            payload[index] = payloads[slot * payloadCapacity + index]
        }
        return target.load(SaveEnvelope(
            true, 1, revisions[slot], lengths[slot], checksums[slot]), payload)
    }

    Int count() {
        return countValue
    }

    Int latestRevision() {
        var slot = latestSlot()
        if (slot < 0) {
            return -1
        }
        return revisions[slot]
    }

    Bool clear() {
        if (countValue == 0) {
            return false
        }
        for (var index = 0; index < occupied.length; index = index + 1) {
            occupied[index] = false
            lengths[index] = 0
            checksums[index] = 0
        }
        nextSlot = 0
        countValue = 0
        return true
    }
}
