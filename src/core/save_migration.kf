package core

class BoundedSaveMigrationGate {
    Int currentSectionVersion

    public constructor() {
        currentSectionVersion = 1
    }

    Bool importLegacy(BoundedSaveState source, BoundedSaveSections target) {
        return target.captureLegacy(source)
    }

    Bool exportLegacy(BoundedSaveSections source, BoundedSaveState target) {
        if (!accepts(source) || source.revision() < 0 ||
            source.sectionCount() != 1 || source.sectionId(0) != 1 ||
            source.sectionVersion(0) != currentSectionVersion) {
            return false
        }
        var payload = new Int[source.sectionLength(0)]
        for (var index = 0; index < payload.length; index = index + 1) {
            payload[index] = source.sectionValue(0, index)
        }
        return target.stage(1, source.revision(), payload)
    }

    Bool migrate(BoundedSaveSections source, BoundedSaveSections target) {
        if (!accepts(source) || source.revision() < 0) {
            return false
        }
        target.clear()
        if (!target.setRevision(source.revision())) {
            return false
        }
        for (var index = 0; index < source.sectionCount(); index = index + 1) {
            var sectionId = source.sectionId(index)
            var sourceVersion = source.sectionVersion(index)
            var sourceLength = source.sectionLength(index)
            var targetVersion = sourceVersion
            var targetLength = sourceLength
            if (sourceVersion == 0 && (sectionId == 2 || sectionId == 3)) {
                targetVersion = currentSectionVersion
                targetLength = sourceLength + 1
            }
            var payload = new Int[targetLength]
            for (var valueIndex = 0; valueIndex < sourceLength; valueIndex = valueIndex + 1) {
                payload[valueIndex] = source.sectionValue(index, valueIndex)
            }
            if (targetLength > sourceLength) {
                payload[targetLength - 1] = 0
            }
            if (!target.put(sectionId, targetVersion, payload)) {
                target.clear()
                return false
            }
        }
        return true
    }

    Bool accepts(BoundedSaveSections source) {
        if (source.revision() < 0) {
            return false
        }
        for (var index = 0; index < source.sectionCount(); index = index + 1) {
            if (!acceptsSourceSection(source.sectionId(index), source.sectionVersion(index))) {
                return false
            }
        }
        return true
    }

    Bool acceptsSection(Int sectionId, Int schemaVersion) {
        return (sectionId == 1 || sectionId == 2 || sectionId == 3) &&
            schemaVersion == currentSectionVersion
    }

    Bool acceptsSourceSection(Int sectionId, Int schemaVersion) {
        return acceptsSection(sectionId, schemaVersion) ||
            ((sectionId == 2 || sectionId == 3) && schemaVersion == 0)
    }
}
