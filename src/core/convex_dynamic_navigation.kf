package core

record ConvexSweepResult(
    Bool accepted,
    Bool collided,
    Int hitStep,
    Int startX,
    Int startY,
    Int startZ,
    Int endX,
    Int endY,
    Int endZ,
    Int resolvedX,
    Int resolvedY,
    Int resolvedZ
)

class BoundedConvexVolume {
    Int[] normalX
    Int[] normalY
    Int[] normalZ
    Int[] distances
    Int planeCountValue
    Bool sealedValue

    public constructor() {
        normalX = new Int[8]
        normalY = new Int[8]
        normalZ = new Int[8]
        distances = new Int[8]
        clear()
    }

    Bool clear() {
        planeCountValue = 0
        sealedValue = false
        return true
    }

    Bool addPlane(Int nextNormalX, Int nextNormalY, Int nextNormalZ, Int distance) {
        if (sealedValue || planeCountValue >= normalX.length ||
            nextNormalX < -1000 || nextNormalX > 1000 ||
            nextNormalY < -1000 || nextNormalY > 1000 ||
            nextNormalZ < -1000 || nextNormalZ > 1000 ||
            distance < -1000000000 || distance > 1000000000 ||
            (nextNormalX == 0 && nextNormalY == 0 && nextNormalZ == 0)) {
            return false
        }
        normalX[planeCountValue] = nextNormalX
        normalY[planeCountValue] = nextNormalY
        normalZ[planeCountValue] = nextNormalZ
        distances[planeCountValue] = distance
        planeCountValue = planeCountValue + 1
        return true
    }

    Bool seal() {
        if (sealedValue || planeCountValue <= 0) {
            return false
        }
        sealedValue = true
        return true
    }

    Int absolute(Int value) {
        if (value < 0) {
            return -value
        }
        return value
    }

    Bool containsCapsule(Int x, Int y, Int z, Int radius) {
        if (!sealedValue || radius < 0) {
            return false
        }
        for (var index = 0; index < planeCountValue; index = index + 1) {
            var margin = radius * (absolute(normalX[index]) +
                absolute(normalY[index]) + absolute(normalZ[index]))
            var value = normalX[index] * x + normalY[index] * y + normalZ[index] * z
            if (value > distances[index] - margin) {
                return false
            }
        }
        return true
    }

    Int planeCount() {
        return planeCountValue
    }
}

class BoundedConvexController {
    BoundedConvexVolume obstacle
    Int radiusValue
    Int maxDistanceValue

    public constructor(Int radius, Int maxDistance) {
        obstacle = BoundedConvexVolume()
        radiusValue = radius
        if (radiusValue < 0) {
            radiusValue = 0
        }
        maxDistanceValue = maxDistance
        if (maxDistanceValue <= 0) {
            maxDistanceValue = 1
        }
    }

    Bool clearObstacle() {
        return obstacle.clear()
    }

    Bool addPlane(Int normalX, Int normalY, Int normalZ, Int distance) {
        return obstacle.addPlane(normalX, normalY, normalZ, distance)
    }

    Bool sealObstacle() {
        return obstacle.seal()
    }

    Bool configure(Int radius, Int maxDistance) {
        if (radius < 0 || maxDistance <= 0) {
            return false
        }
        radiusValue = radius
        maxDistanceValue = maxDistance
        return clearObstacle()
    }

    Int absolute(Int value) {
        if (value < 0) {
            return -value
        }
        return value
    }

    ConvexSweepResult rejected(
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ
    ) {
        return ConvexSweepResult(
            false, false, -1,
            startX, startY, startZ, endX, endY, endZ,
            startX, startY, startZ)
    }

    ConvexSweepResult sweep(
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ
    ) {
        if (!obstacle.containsCapsule(startX, startY, startZ, radiusValue)) {
            return rejected(startX, startY, startZ, endX, endY, endZ)
        }
        var deltaX = endX - startX
        var deltaY = endY - startY
        var deltaZ = endZ - startZ
        var steps = absolute(deltaX)
        if (absolute(deltaY) > steps) {
            steps = absolute(deltaY)
        }
        if (absolute(deltaZ) > steps) {
            steps = absolute(deltaZ)
        }
        if (steps > maxDistanceValue) {
            return rejected(startX, startY, startZ, endX, endY, endZ)
        }
        if (steps == 0) {
            return ConvexSweepResult(
                true, false, -1,
                startX, startY, startZ, endX, endY, endZ,
                startX, startY, startZ)
        }
        for (var step = 1; step <= steps; step = step + 1) {
            var sampleX = startX + (deltaX * step) / steps
            var sampleY = startY + (deltaY * step) / steps
            var sampleZ = startZ + (deltaZ * step) / steps
            if (!obstacle.containsCapsule(sampleX, sampleY, sampleZ, radiusValue)) {
                var previousX = startX + (deltaX * (step - 1)) / steps
                var previousY = startY + (deltaY * (step - 1)) / steps
                var previousZ = startZ + (deltaZ * (step - 1)) / steps
                return ConvexSweepResult(
                    true, true, step,
                    startX, startY, startZ, endX, endY, endZ,
                    previousX, previousY, previousZ)
            }
        }
        return ConvexSweepResult(
            true, false, -1,
            startX, startY, startZ, endX, endY, endZ,
            endX, endY, endZ)
    }

    ConvexSweepResult move(
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ
    ) {
        var direct = sweep(startX, startY, startZ, endX, endY, endZ)
        if (!direct.accepted() || !direct.collided()) {
            return direct
        }
        var resolvedX = startX
        var resolvedY = startY
        var resolvedZ = startZ
        var xMove = sweep(startX, startY, startZ, endX, startY, startZ)
        if (xMove.accepted()) {
            resolvedX = xMove.resolvedX()
        }
        var yMove = sweep(resolvedX, startY, startZ, resolvedX, endY, startZ)
        if (yMove.accepted()) {
            resolvedY = yMove.resolvedY()
        }
        var zMove = sweep(resolvedX, resolvedY, startZ, resolvedX, resolvedY, endZ)
        if (zMove.accepted()) {
            resolvedZ = zMove.resolvedZ()
        }
        return ConvexSweepResult(
            true, true, direct.hitStep(),
            startX, startY, startZ, endX, endY, endZ,
            resolvedX, resolvedY, resolvedZ)
    }

    Int radius() {
        return radiusValue
    }
}

record DynamicActorSweepResult(
    Bool accepted,
    Bool collided,
    Int hitStep,
    Int actorId,
    Int startX,
    Int startY,
    Int startZ,
    Int endX,
    Int endY,
    Int endZ,
    Int resolvedX,
    Int resolvedY,
    Int resolvedZ
)

class BoundedDynamicBroadPhase {
    Int[] ids
    Int[] minXs
    Int[] minYs
    Int[] minZs
    Int[] maxXs
    Int[] maxYs
    Int[] maxZs
    Bool[] active
    Int countValue
    Int revisionValue
    Int maxDistanceValue

    public constructor(Int capacity, Int maxDistance) {
        var actualCapacity = capacity
        if (actualCapacity <= 0) {
            actualCapacity = 1
        }
        ids = new Int[actualCapacity]
        minXs = new Int[actualCapacity]
        minYs = new Int[actualCapacity]
        minZs = new Int[actualCapacity]
        maxXs = new Int[actualCapacity]
        maxYs = new Int[actualCapacity]
        maxZs = new Int[actualCapacity]
        active = new Bool[actualCapacity]
        countValue = 0
        revisionValue = 0
        maxDistanceValue = maxDistance
        if (maxDistanceValue <= 0) {
            maxDistanceValue = 1
        }
        for (var index = 0; index < actualCapacity; index = index + 1) {
            active[index] = false
            ids[index] = 0
        }
    }

    Bool validBox(
        Int id, Int minX, Int minY, Int minZ,
        Int maxX, Int maxY, Int maxZ
    ) {
        return id > 0 && id <= 1000000 &&
            minX <= maxX && minY <= maxY && minZ <= maxZ &&
            minX >= -1000000 && minY >= -1000000 && minZ >= -1000000 &&
            maxX <= 1000000 && maxY <= 1000000 && maxZ <= 1000000
    }

    Int find(Int id) {
        for (var index = 0; index < ids.length; index = index + 1) {
            if (active[index] && ids[index] == id) {
                return index
            }
        }
        return -1
    }

    Bool add(
        Int id, Int minX, Int minY, Int minZ,
        Int maxX, Int maxY, Int maxZ
    ) {
        if (!validBox(id, minX, minY, minZ, maxX, maxY, maxZ) ||
            find(id) >= 0) {
            return false
        }
        var slot = -1
        for (var index = 0; index < ids.length; index = index + 1) {
            if (!active[index]) {
                slot = index
                break
            }
        }
        if (slot < 0) {
            return false
        }
        ids[slot] = id
        minXs[slot] = minX
        minYs[slot] = minY
        minZs[slot] = minZ
        maxXs[slot] = maxX
        maxYs[slot] = maxY
        maxZs[slot] = maxZ
        active[slot] = true
        countValue = countValue + 1
        revisionValue = revisionValue + 1
        return true
    }

    Bool update(
        Int id, Int minX, Int minY, Int minZ,
        Int maxX, Int maxY, Int maxZ
    ) {
        var slot = find(id)
        if (slot < 0 || !validBox(id, minX, minY, minZ, maxX, maxY, maxZ)) {
            return false
        }
        minXs[slot] = minX
        minYs[slot] = minY
        minZs[slot] = minZ
        maxXs[slot] = maxX
        maxYs[slot] = maxY
        maxZs[slot] = maxZ
        revisionValue = revisionValue + 1
        return true
    }

    Bool remove(Int id) {
        var slot = find(id)
        if (slot < 0) {
            return false
        }
        active[slot] = false
        countValue = countValue - 1
        revisionValue = revisionValue + 1
        return true
    }

    Bool containsPoint(Int x, Int y, Int z, Int slot) {
        return x >= minXs[slot] && x <= maxXs[slot] &&
            y >= minYs[slot] && y <= maxYs[slot] &&
            z >= minZs[slot] && z <= maxZs[slot]
    }

    Int absolute(Int value) {
        if (value < 0) {
            return -value
        }
        return value
    }

    DynamicActorSweepResult rejected(
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ
    ) {
        return DynamicActorSweepResult(
            false, false, -1, -1,
            startX, startY, startZ, endX, endY, endZ,
            startX, startY, startZ)
    }

    DynamicActorSweepResult query(
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ,
        Int ignoredActorId
    ) {
        for (var index = 0; index < ids.length; index = index + 1) {
            if (active[index] && containsPoint(startX, startY, startZ, index)) {
                return rejected(startX, startY, startZ, endX, endY, endZ)
            }
        }
        var deltaX = endX - startX
        var deltaY = endY - startY
        var deltaZ = endZ - startZ
        var steps = absolute(deltaX)
        if (absolute(deltaY) > steps) {
            steps = absolute(deltaY)
        }
        if (absolute(deltaZ) > steps) {
            steps = absolute(deltaZ)
        }
        if (steps > maxDistanceValue) {
            return rejected(startX, startY, startZ, endX, endY, endZ)
        }
        for (var step = 1; step <= steps; step = step + 1) {
            var sampleX = startX + (deltaX * step) / steps
            var sampleY = startY + (deltaY * step) / steps
            var sampleZ = startZ + (deltaZ * step) / steps
            for (var index = 0; index < ids.length; index = index + 1) {
                if (active[index] && ids[index] != ignoredActorId &&
                    containsPoint(sampleX, sampleY, sampleZ, index)) {
                    var previousX = startX + (deltaX * (step - 1)) / steps
                    var previousY = startY + (deltaY * (step - 1)) / steps
                    var previousZ = startZ + (deltaZ * (step - 1)) / steps
                    return DynamicActorSweepResult(
                        true, true, step, ids[index],
                        startX, startY, startZ, endX, endY, endZ,
                        previousX, previousY, previousZ)
                }
            }
        }
        return DynamicActorSweepResult(
            true, false, -1, -1,
            startX, startY, startZ, endX, endY, endZ,
            endX, endY, endZ)
    }

    Bool containsExpanded(Int x, Int y, Int z, Int radius, Int slot) {
        return x >= minXs[slot] - radius && x <= maxXs[slot] + radius &&
            y >= minYs[slot] - radius && y <= maxYs[slot] + radius &&
            z >= minZs[slot] - radius && z <= maxZs[slot] + radius
    }

    DynamicActorSweepResult queryCapsule(
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ,
        Int radius, Int ignoredActorId
    ) {
        if (radius < 0) {
            return rejected(startX, startY, startZ, endX, endY, endZ)
        }
        for (var index = 0; index < ids.length; index = index + 1) {
            if (active[index] && ids[index] != ignoredActorId &&
                containsExpanded(startX, startY, startZ, radius, index)) {
                return rejected(startX, startY, startZ, endX, endY, endZ)
            }
        }
        var deltaX = endX - startX
        var deltaY = endY - startY
        var deltaZ = endZ - startZ
        var steps = absolute(deltaX)
        if (absolute(deltaY) > steps) {
            steps = absolute(deltaY)
        }
        if (absolute(deltaZ) > steps) {
            steps = absolute(deltaZ)
        }
        if (steps > maxDistanceValue) {
            return rejected(startX, startY, startZ, endX, endY, endZ)
        }
        if (steps == 0) {
            return DynamicActorSweepResult(
                true, false, -1, -1,
                startX, startY, startZ, endX, endY, endZ,
                endX, endY, endZ)
        }
        for (var step = 1; step <= steps; step = step + 1) {
            var sampleX = startX + (deltaX * step) / steps
            var sampleY = startY + (deltaY * step) / steps
            var sampleZ = startZ + (deltaZ * step) / steps
            for (var index = 0; index < ids.length; index = index + 1) {
                if (active[index] && ids[index] != ignoredActorId &&
                    containsExpanded(sampleX, sampleY, sampleZ, radius, index)) {
                    var previousX = startX + (deltaX * (step - 1)) / steps
                    var previousY = startY + (deltaY * (step - 1)) / steps
                    var previousZ = startZ + (deltaZ * (step - 1)) / steps
                    return DynamicActorSweepResult(
                        true, true, step, ids[index],
                        startX, startY, startZ, endX, endY, endZ,
                        previousX, previousY, previousZ)
                }
            }
        }
        return DynamicActorSweepResult(
            true, false, -1, -1,
            startX, startY, startZ, endX, endY, endZ,
            endX, endY, endZ)
    }

    Int count() {
        return countValue
    }

    Int revision() {
        return revisionValue
    }
}

record NavigationProductResult(
    Bool accepted,
    Bool found,
    Int routeLength,
    Int expanded,
    Int nextNodeId
)

class BoundedNavigationProduct {
    Int[] nodeIds
    Int[] nodeX
    Int[] nodeY
    Int[] nodeZ
    Int[] neighbors
    Int[] parents
    Bool[] open
    Bool[] closed
    Int nodeCountValue
    Int sourceNamespaceIdValue
    Int assetIdValue
    Int revisionValue
    Int checksumValue
    Bool configuredValue
    Bool sealedValue

    public constructor(Int capacity) {
        var actualCapacity = capacity
        if (actualCapacity <= 0) {
            actualCapacity = 1
        }
        if (actualCapacity > 128) {
            actualCapacity = 128
        }
        nodeIds = new Int[actualCapacity]
        nodeX = new Int[actualCapacity]
        nodeY = new Int[actualCapacity]
        nodeZ = new Int[actualCapacity]
        neighbors = new Int[actualCapacity * 4]
        parents = new Int[actualCapacity]
        open = new Bool[actualCapacity]
        closed = new Bool[actualCapacity]
        clear()
    }

    Bool clear() {
        nodeCountValue = 0
        sourceNamespaceIdValue = 0
        assetIdValue = 0
        revisionValue = 0
        checksumValue = 0
        configuredValue = false
        sealedValue = false
        for (var index = 0; index < open.length; index = index + 1) {
            open[index] = false
            closed[index] = false
            parents[index] = -1
        }
        return true
    }

    Bool configure(Int sourceNamespaceId, Int assetId, Int revision) {
        if (sourceNamespaceId <= 0 || sourceNamespaceId > 1000000 ||
            assetId <= 0 || assetId > 1000000 ||
            revision <= 0 || revision > 1000000) {
            return false
        }
        clear()
        sourceNamespaceIdValue = sourceNamespaceId
        assetIdValue = assetId
        revisionValue = revision
        configuredValue = true
        return true
    }

    Int findNode(Int id) {
        for (var index = 0; index < nodeCountValue; index = index + 1) {
            if (nodeIds[index] == id) {
                return index
            }
        }
        return -1
    }

    Bool addNode(Int id, Int x, Int y, Int z) {
        if (!configuredValue || sealedValue || id <= 0 || id > 1000000 ||
            findNode(id) >= 0 || nodeCountValue >= nodeIds.length) {
            return false
        }
        var index = nodeCountValue
        nodeIds[index] = id
        nodeX[index] = x
        nodeY[index] = y
        nodeZ[index] = z
        for (var edge = 0; edge < 4; edge = edge + 1) {
            neighbors[index * 4 + edge] = -1
        }
        nodeCountValue = nodeCountValue + 1
        return true
    }

    Bool addEdge(Int firstId, Int secondId) {
        if (!configuredValue || sealedValue || firstId == secondId) {
            return false
        }
        var first = findNode(firstId)
        var second = findNode(secondId)
        if (first < 0 || second < 0) {
            return false
        }
        var firstSlot = -1
        var secondSlot = -1
        for (var edge = 0; edge < 4; edge = edge + 1) {
            if (neighbors[first * 4 + edge] == second) {
                firstSlot = edge
            }
            if (neighbors[second * 4 + edge] == first) {
                secondSlot = edge
            }
        }
        if (firstSlot >= 0 && secondSlot >= 0) {
            return true
        }
        for (var edge = 0; edge < 4; edge = edge + 1) {
            if (firstSlot < 0 && neighbors[first * 4 + edge] < 0) {
                firstSlot = edge
            }
            if (secondSlot < 0 && neighbors[second * 4 + edge] < 0) {
                secondSlot = edge
            }
        }
        if (firstSlot < 0 || secondSlot < 0) {
            return false
        }
        neighbors[first * 4 + firstSlot] = second
        neighbors[second * 4 + secondSlot] = first
        return true
    }

    Int mix(Int state, Int value) {
        var normalized = value % 1000003
        if (normalized < 0) {
            normalized = normalized + 1000003
        }
        return (state * 31 + normalized) % 1000003
    }

    Int calculateChecksum() {
        var result = 17
        result = mix(result, sourceNamespaceIdValue)
        result = mix(result, assetIdValue)
        result = mix(result, revisionValue)
        result = mix(result, nodeCountValue)
        for (var index = 0; index < nodeCountValue; index = index + 1) {
            result = mix(result, nodeIds[index])
            result = mix(result, nodeX[index])
            result = mix(result, nodeY[index])
            result = mix(result, nodeZ[index])
            for (var edge = 0; edge < 4; edge = edge + 1) {
                result = mix(result, neighbors[index * 4 + edge])
            }
        }
        return result
    }

    Bool structuralValid() {
        if (!configuredValue || nodeCountValue <= 0) {
            return false
        }
        for (var index = 0; index < nodeCountValue; index = index + 1) {
            for (var edge = 0; edge < 4; edge = edge + 1) {
                var neighbor = neighbors[index * 4 + edge]
                if (neighbor >= nodeCountValue || neighbor < -1) {
                    return false
                }
                if (neighbor >= 0) {
                    var reciprocal = false
                    for (var reverse = 0; reverse < 4; reverse = reverse + 1) {
                        if (neighbors[neighbor * 4 + reverse] == index) {
                            reciprocal = true
                        }
                    }
                    if (!reciprocal) {
                        return false
                    }
                }
            }
        }
        return true
    }

    Bool seal() {
        if (sealedValue || !structuralValid()) {
            return false
        }
        checksumValue = calculateChecksum()
        sealedValue = true
        return true
    }

    Bool validate() {
        return sealedValue && structuralValid() &&
            checksumValue == calculateChecksum()
    }

    Int checksum() {
        if (!validate()) {
            return -1
        }
        return checksumValue
    }

    NavigationProductResult routeFailure(Int expanded) {
        return NavigationProductResult(true, false, 0, expanded, -1)
    }

    NavigationProductResult routeInvalid() {
        return NavigationProductResult(false, false, 0, 0, -1)
    }

    NavigationProductResult findRoute(Int startId, Int targetId) {
        if (!validate()) {
            return routeInvalid()
        }
        var start = findNode(startId)
        var target = findNode(targetId)
        if (start < 0 || target < 0) {
            return routeInvalid()
        }
        for (var index = 0; index < nodeCountValue; index = index + 1) {
            open[index] = false
            closed[index] = false
            parents[index] = -1
        }
        open[start] = true
        var expanded = 0
        var found = false
        while (expanded < nodeCountValue) {
            var current = -1
            for (var index = 0; index < nodeCountValue; index = index + 1) {
                if (open[index] && !closed[index] &&
                    (current < 0 || nodeIds[index] < nodeIds[current])) {
                    current = index
                }
            }
            if (current < 0) {
                return routeFailure(expanded)
            }
            if (current == target) {
                found = true
                break
            }
            closed[current] = true
            expanded = expanded + 1
            for (var edge = 0; edge < 4; edge = edge + 1) {
                var neighbor = neighbors[current * 4 + edge]
                if (neighbor >= 0 && !closed[neighbor]) {
                    if (!open[neighbor]) {
                        open[neighbor] = true
                        parents[neighbor] = current
                    }
                }
            }
        }
        if (!found) {
            return routeFailure(expanded)
        }
        var routeLength = 0
        var cursor = target
        while (cursor != start && cursor >= 0 && routeLength <= nodeCountValue) {
            routeLength = routeLength + 1
            cursor = parents[cursor]
        }
        if (cursor != start) {
            return routeFailure(expanded)
        }
        var next = target
        cursor = target
        while (parents[cursor] >= 0 && parents[cursor] != start) {
            cursor = parents[cursor]
        }
        if (parents[cursor] == start) {
            next = cursor
        }
        return NavigationProductResult(true, true, routeLength, expanded, nodeIds[next])
    }

    Int sourceNamespaceId() {
        return sourceNamespaceIdValue
    }

    Int assetId() {
        return assetIdValue
    }

    Int revision() {
        return revisionValue
    }

    Int nodeCount() {
        return nodeCountValue
    }
}
