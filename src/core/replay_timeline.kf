package core

class BoundedReplayTimeline {
    InputReplayRecorder commands
    InteractionReplayRecorder interactions
    Int commandCapacityValue
    Int seekInteractionOffsetValue
    InteractionCommand seekInteractionConsumed
    Int[] checkpointTicks
    Int[] checkpointHashes
    Int[] checkpointSnapshotLengths
    Int[] checkpointSnapshotValues
    Int[] checkpointSidecarLengths
    Int[] checkpointSidecarValues
    Int checkpointCount
    Int[] initialSnapshot
    Int snapshotLength
    Int seekTargetTickValue
    Int seekCheckpointValue
    Int seekCommandOffsetValue
    Int seekSnapshotLengthValue
    Int seekSnapshotOffsetValue
    Int seekSidecarLengthValue
    Int seekSidecarOffsetValue
    InputCommand seekConsumed

    public constructor(Int commandCapacity, Int checkpointCapacity) {
        var actualCommands = commandCapacity
        if (actualCommands <= 0) {
            actualCommands = 1
        }
        if (actualCommands > 64) {
            actualCommands = 64
        }
        var actualCheckpoints = checkpointCapacity
        if (actualCheckpoints <= 0) {
            actualCheckpoints = 1
        }
        if (actualCheckpoints > 64) {
            actualCheckpoints = 64
        }
        commands = InputReplayRecorder(actualCommands)
        interactions = InteractionReplayRecorder(actualCommands)
        commandCapacityValue = actualCommands
        seekInteractionOffsetValue = 0
        seekInteractionConsumed = InteractionCommand(-1, 0, 0, 0)
        checkpointTicks = new Int[actualCheckpoints]
        checkpointHashes = new Int[actualCheckpoints]
        checkpointSnapshotLengths = new Int[actualCheckpoints]
        checkpointSnapshotValues = new Int[actualCheckpoints * 512]
        checkpointSidecarLengths = new Int[actualCheckpoints]
        checkpointSidecarValues = new Int[actualCheckpoints * 320]
        checkpointCount = 0
        initialSnapshot = new Int[512]
        snapshotLength = 0
        seekTargetTickValue = -1
        seekCheckpointValue = -1
        seekCommandOffsetValue = 0
        seekSnapshotLengthValue = 0
        seekSidecarLengthValue = 0
        seekSidecarOffsetValue = 0
        seekSnapshotOffsetValue = 0
        seekConsumed = InputCommand(0, 0, 0, 0, 0, 0, 0, 0)
    }

    Bool append(InputCommand command) {
        return commands.append(command)
    }

    Bool appendInteraction(Int tick, Int player, Int sequence, Int targetId) {
        return interactions.append(tick, player, sequence, targetId)
    }

    Bool appendInteractions(InteractionReplayRecorder source) {
        if (source.count() > interactions.capacity() - interactions.count()) {
            return false
        }
        var previousTick = 0
        var previousPlayer = 0
        var playerOneSequence = 0
        var playerTwoSequence = 0
        for (var index = 0; index < interactions.count(); index = index + 1) {
            var command = interactions.at(index)
            previousTick = command.tick()
            previousPlayer = command.player()
            if (command.player() == 1) {
                playerOneSequence = command.sequence()
            } else {
                playerTwoSequence = command.sequence()
            }
        }
        for (var index = 0; index < source.count(); index = index + 1) {
            var command = source.at(index)
            if (command.tick() < 1 || command.tick() > 1000000 ||
                (command.player() != 1 && command.player() != 2) ||
                command.sequence() < 1 || command.sequence() > 1000000 ||
                command.targetId() < 1 || command.targetId() > 1000000 ||
                command.tick() < previousTick ||
                (command.tick() == previousTick && command.player() <= previousPlayer) ||
                (command.player() == 1 && command.sequence() <= playerOneSequence) ||
                (command.player() == 2 && command.sequence() <= playerTwoSequence)) {
                return false
            }
            previousTick = command.tick()
            previousPlayer = command.player()
            if (command.player() == 1) {
                playerOneSequence = command.sequence()
            } else {
                playerTwoSequence = command.sequence()
            }
        }
        for (var index = 0; index < source.count(); index = index + 1) {
            var command = source.at(index)
            interactions.append(command.tick(), command.player(), command.sequence(), command.targetId())
        }
        return true
    }

    Int interactionCount() {
        return interactions.count()
    }

    Int interactionCapacity() {
        return interactions.capacity()
    }

    InteractionCommand interactionAt(Int index) {
        return interactions.at(index)
    }

    Int commandCapacity() {
        return commandCapacityValue
    }

    Int checkpointCapacity() {
        return checkpointTicks.length
    }

    Bool appendCheckpoint(Int tick, Int hash) {
        if (tick < 0 || hash < -1000000 || hash > 1000000 ||
            checkpointCount >= checkpointTicks.length ||
            (checkpointCount > 0 &&
                tick <= checkpointTicks[checkpointCount - 1])) {
            return false
        }
        checkpointTicks[checkpointCount] = tick
        checkpointHashes[checkpointCount] = hash
        checkpointSnapshotLengths[checkpointCount] = 0
        checkpointSidecarLengths[checkpointCount] = 0
        checkpointCount = checkpointCount + 1
        return true
    }

    Bool appendCheckpointSnapshot(Int tick, Int hash, Int[] values) {
        if (tick < 0 || hash < -1000000 || hash > 1000000 ||
            values.length > 512 ||
            checkpointCount >= checkpointTicks.length ||
            (checkpointCount > 0 &&
                tick <= checkpointTicks[checkpointCount - 1])) {
            return false
        }
        for (var index = 0; index < values.length; index = index + 1) {
            if (values[index] < -1000000 || values[index] > 1000000) {
                return false
            }
        }
        checkpointTicks[checkpointCount] = tick
        checkpointHashes[checkpointCount] = hash
        checkpointSnapshotLengths[checkpointCount] = values.length
        checkpointSidecarLengths[checkpointCount] = 0
        var offset = checkpointCount * 512
        for (var copy = 0; copy < values.length; copy = copy + 1) {
            checkpointSnapshotValues[offset + copy] = values[copy]
        }
        checkpointCount = checkpointCount + 1
        return true
    }
    Bool appendCheckpointBundle(Int tick, Int hash, Int[] values, Int[] sidecar) {
        if (tick < 0 || hash < -1000000 || hash > 1000000 ||
            values.length > 512 || sidecar.length > 320 ||
            checkpointCount >= checkpointTicks.length ||
            (checkpointCount > 0 &&
                tick <= checkpointTicks[checkpointCount - 1])) {
            return false
        }
        for (var index = 0; index < values.length; index = index + 1) {
            if (values[index] < -1000000 || values[index] > 1000000) {
                return false
            }
        }
        for (var index = 0; index < sidecar.length; index = index + 1) {
            if (sidecar[index] < -1000000 || sidecar[index] > 1000000) {
                return false
            }
        }
        checkpointTicks[checkpointCount] = tick
        checkpointHashes[checkpointCount] = hash
        checkpointSnapshotLengths[checkpointCount] = values.length
        checkpointSidecarLengths[checkpointCount] = sidecar.length
        var offset = checkpointCount * 512
        var sidecarOffset = checkpointCount * 320
        for (var copy = 0; copy < values.length; copy = copy + 1) {
            checkpointSnapshotValues[offset + copy] = values[copy]
        }
        for (var sidecarCopy = 0; sidecarCopy < sidecar.length; sidecarCopy = sidecarCopy + 1) {
            checkpointSidecarValues[sidecarOffset + sidecarCopy] = sidecar[sidecarCopy]
        }
        checkpointCount = checkpointCount + 1
        return true
    }

    Bool setInitialSnapshot(Int[] values) {
        if (values.length > initialSnapshot.length) {
            return false
        }
        for (var index = 0; index < values.length; index = index + 1) {
            if (values[index] < -1000000 || values[index] > 1000000) {
                return false
            }
        }
        for (var index = 0; index < values.length; index = index + 1) {
            initialSnapshot[index] = values[index]
        }
        snapshotLength = values.length
        return true
    }

    Int pending() {
        return commands.pending()
    }

    InputCommand commandAt(Int index) {
        return commands.at(index)
    }

    Int checkpointCountValue() {
        return checkpointCount
    }

    Int checkpointTick(Int index) {
        if (index < 0 || index >= checkpointCount) {
            return -1
        }
        return checkpointTicks[index]
    }

    Int checkpointHash(Int index) {
        if (index < 0 || index >= checkpointCount) {
            return 0
        }
        return checkpointHashes[index]
    }

    Int checkpointSnapshotLength(Int index) {
        if (index < 0 || index >= checkpointCount) {
            return 0
        }
        return checkpointSnapshotLengths[index]
    }

    Int checkpointSnapshotValue(Int index, Int valueIndex) {
        if (index < 0 || index >= checkpointCount ||
            valueIndex < 0 || valueIndex >= checkpointSnapshotLengths[index]) {
            return 0
        }
        return checkpointSnapshotValues[index * 512 + valueIndex]
    }

    Int checkpointIndexAtOrBefore(Int tick) {
        if (tick < 0) {
            return -1
        }
        var selected = -1
        for (var index = 0; index < checkpointCount; index = index + 1) {
            if (checkpointTicks[index] > tick) {
                return selected
            }
            selected = index
        }
        return selected
    }

    Int initialSnapshotLength() {
        return snapshotLength
    }

    Int initialSnapshotValue(Int index) {
        if (index < 0 || index >= snapshotLength) {
            return 0
        }
        return initialSnapshot[index]
    }

    Bool seek(Int targetTick) {
        if (targetTick < 0) {
            return false
        }
        var checkpoint = checkpointIndexAtOrBefore(targetTick)
        if (checkpoint < 0 && snapshotLength == 0) {
            return false
        }
        var baseTick = -1
        if (checkpoint >= 0) {
            baseTick = checkpointTicks[checkpoint]
            seekSnapshotLengthValue = checkpointSnapshotLengths[checkpoint]
            seekSnapshotOffsetValue = checkpoint * 512
            seekSidecarLengthValue = checkpointSidecarLengths[checkpoint]
            seekSidecarOffsetValue = checkpoint * 320
        } else {
            seekSnapshotLengthValue = snapshotLength
            seekSnapshotOffsetValue = -1
            seekSidecarLengthValue = 0
            seekSidecarOffsetValue = -1
        }
        var commandOffset = 0
        while (commandOffset < commands.pending() &&
            commands.at(commandOffset).tick() <= baseTick) {
            commandOffset = commandOffset + 1
        }
        var interactionOffset = 0
        while (interactionOffset < interactions.count() &&
            interactions.at(interactionOffset).tick() <= baseTick) {
            interactionOffset = interactionOffset + 1
        }
        seekInteractionOffsetValue = interactionOffset
        seekInteractionConsumed = InteractionCommand(-1, 0, 0, 0)
        seekTargetTickValue = targetTick
        seekCheckpointValue = checkpoint
        seekCommandOffsetValue = commandOffset
        return true
    }

    Bool seekNextCommand() {
        if (seekTargetTickValue < 0 ||
            seekCommandOffsetValue >= commands.pending() ||
            commands.at(seekCommandOffsetValue).tick() > seekTargetTickValue) {
            return false
        }
        seekConsumed = commands.at(seekCommandOffsetValue)
        seekCommandOffsetValue = seekCommandOffsetValue + 1
        return true
    }

    Bool seekNextInteraction() {
        if (seekTargetTickValue < 0 ||
            seekInteractionOffsetValue >= interactions.count() ||
            interactions.at(seekInteractionOffsetValue).tick() > seekTargetTickValue) {
            return false
        }
        seekInteractionConsumed = interactions.at(seekInteractionOffsetValue)
        seekInteractionOffsetValue = seekInteractionOffsetValue + 1
        return true
    }

    InteractionCommand lastSeekInteraction() {
        return seekInteractionConsumed
    }

    Bool stageSeekCommands(InputReplayRecorder target) {
        if (seekTargetTickValue < 0) {
            return false
        }
        if (!target.reset()) {
            return false
        }
        while (seekNextCommand()) {
            if (!target.append(seekConsumed)) {
                return false
            }
        }
        return true
    }

    Int seekTargetTick() {
        return seekTargetTickValue
    }

    Int seekCheckpointIndex() {
        return seekCheckpointValue
    }

    Int seekSnapshotLength() {
        return seekSnapshotLengthValue
    }

    Int seekSnapshotValue(Int index) {
        if (index < 0 || index >= seekSnapshotLengthValue) {
            return 0
        }
        if (seekSnapshotOffsetValue < 0) {
            return initialSnapshot[index]
        }
        return checkpointSnapshotValues[seekSnapshotOffsetValue + index]
    }

    Int seekSidecarLength() {
        return seekSidecarLengthValue
    }

    Int seekSidecarValue(Int index) {
        if (index < 0 || index >= seekSidecarLengthValue || seekSidecarOffsetValue < 0) {
            return 0
        }
        return checkpointSidecarValues[seekSidecarOffsetValue + index]
    }

    Int seekRemainingCommands() {
        if (seekTargetTickValue < 0) {
            return 0
        }
        var remaining = 0
        for (var index = seekCommandOffsetValue; index < commands.pending(); index = index + 1) {
            if (commands.at(index).tick() > seekTargetTickValue) {
                break
            }
            remaining = remaining + 1
        }
        return remaining
    }

    InputCommand lastSeekCommand() {
        return seekConsumed
    }

    Int checkpointSidecarLength(Int index) {
        if (index < 0 || index >= checkpointCount) {
            return 0
        }
        return checkpointSidecarLengths[index]
    }

    Int checkpointSidecarValue(Int index, Int valueIndex) {
        if (index < 0 || index >= checkpointCount ||
            valueIndex < 0 || valueIndex >= checkpointSidecarLengths[index]) {
            return 0
        }
        return checkpointSidecarValues[index * 320 + valueIndex]
    }

    Bool replaceFrom(BoundedReplayTimeline source) {
        if (source.pending() > commandCapacityValue ||
            source.interactionCount() > interactions.capacity() ||
            source.checkpointCountValue() > checkpointTicks.length) {
            return false
        }
        var nextCommands = InputReplayRecorder(commandCapacityValue)
        var nextInteractions = InteractionReplayRecorder(interactions.capacity())
        for (var index = 0; index < source.pending(); index = index + 1) {
            if (!nextCommands.append(source.commandAt(index))) {
                return false
            }
        }
        for (var index = 0; index < source.interactionCount(); index = index + 1) {
            var command = source.interactionAt(index)
            if (!nextInteractions.append(
                    command.tick(), command.player(), command.sequence(), command.targetId())) {
                return false
            }
        }
        for (var index = 0; index < source.checkpointCount; index = index + 1) {
            checkpointTicks[index] = source.checkpointTicks[index]
            checkpointHashes[index] = source.checkpointHashes[index]
            checkpointSnapshotLengths[index] = source.checkpointSnapshotLengths[index]
            checkpointSidecarLengths[index] = source.checkpointSidecarLengths[index]
            for (var value = 0; value < source.checkpointSnapshotLengths[index]; value = value + 1) {
                checkpointSnapshotValues[index * 512 + value] =
                    source.checkpointSnapshotValues[index * 512 + value]
            }
            for (var value = 0; value < source.checkpointSidecarLengths[index]; value = value + 1) {
                checkpointSidecarValues[index * 320 + value] =
                    source.checkpointSidecarValues[index * 320 + value]
            }
        }
        for (var index = 0; index < source.snapshotLength; index = index + 1) {
            initialSnapshot[index] = source.initialSnapshot[index]
        }
        commands = nextCommands
        interactions = nextInteractions
        checkpointCount = source.checkpointCount
        snapshotLength = source.snapshotLength
        seekTargetTickValue = -1
        seekCheckpointValue = -1
        seekCommandOffsetValue = 0
        seekInteractionOffsetValue = 0
        seekSnapshotLengthValue = 0
        seekSnapshotOffsetValue = 0
        seekSidecarLengthValue = 0
        seekSidecarOffsetValue = 0
        seekConsumed = InputCommand(0, 0, 0, 0, 0, 0, 0, 0)
        seekInteractionConsumed = InteractionCommand(-1, 0, 0, 0)
        return true
    }

    Bool reset() {
        commands.reset()
        interactions.reset()
        seekInteractionOffsetValue = 0
        seekInteractionConsumed = InteractionCommand(-1, 0, 0, 0)
        checkpointCount = 0
        snapshotLength = 0
        seekTargetTickValue = -1
        seekCheckpointValue = -1
        seekCommandOffsetValue = 0
        seekSnapshotLengthValue = 0
        seekSnapshotOffsetValue = 0
        seekSidecarLengthValue = 0
        seekSidecarOffsetValue = 0
        seekConsumed = InputCommand(0, 0, 0, 0, 0, 0, 0, 0)
        return true
    }
}
