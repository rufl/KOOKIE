package core

class BoundedItemDefinitionStore {
    Int[] ids
    Int[] baseValues
    Int[] minimumLevels
    Int[] maximumLevels
    Int[] affixPools
    Int countValue

    public constructor(Int capacity) {
        var actualCapacity = capacity
        if (actualCapacity <= 0) {
            actualCapacity = 1
        }
        if (actualCapacity > 32) {
            actualCapacity = 32
        }
        ids = new Int[actualCapacity]
        baseValues = new Int[actualCapacity]
        minimumLevels = new Int[actualCapacity]
        maximumLevels = new Int[actualCapacity]
        affixPools = new Int[actualCapacity]
        countValue = 0
    }

    Bool define(
        Int id, Int baseValue, Int minimumLevel,
        Int maximumLevel, Int affixPool
    ) {
        if (id <= 0 || baseValue < 0 || baseValue > 1000000 ||
            minimumLevel <= 0 || maximumLevel < minimumLevel ||
            maximumLevel > 1000000 || affixPool < 0 || affixPool > 64 ||
            countValue >= ids.length || find(id) >= 0) {
            return false
        }
        ids[countValue] = id
        baseValues[countValue] = baseValue
        minimumLevels[countValue] = minimumLevel
        maximumLevels[countValue] = maximumLevel
        affixPools[countValue] = affixPool
        countValue = countValue + 1
        return true
    }

    Int find(Int id) {
        for (var index = 0; index < countValue; index = index + 1) {
            if (ids[index] == id) {
                return index
            }
        }
        return -1
    }

    Bool contains(Int id) {
        return find(id) >= 0
    }

    Int baseValue(Int id) {
        var index = find(id)
        if (index < 0) {
            return -1
        }
        return baseValues[index]
    }

    Int minimumLevel(Int id) {
        var index = find(id)
        if (index < 0) {
            return -1
        }
        return minimumLevels[index]
    }

    Int maximumLevel(Int id) {
        var index = find(id)
        if (index < 0) {
            return -1
        }
        return maximumLevels[index]
    }

    Int affixPool(Int id) {
        var index = find(id)
        if (index < 0) {
            return -1
        }
        return affixPools[index]
    }
}

class BoundedItemRoll {
    Bool acceptedValue
    Int stableIdValue
    Int definitionIdValue
    Int seedValue
    Int levelValue
    Int rarityValue
    Int affixOneValue
    Int affixTwoValue
    Int conditionValue

    public constructor() {
        clear()
    }

    Bool stage(
        Int stableId, Int definitionId, Int seed, Int level,
        Int rarity, Int affixOne, Int affixTwo, Int condition
    ) {
        if (stableId <= 0 || definitionId <= 0 || seed < 0 ||
            level <= 0 || level > 1000000 || rarity < 1 || rarity > 3 ||
            affixOne < 0 || affixOne > 64 || affixTwo < 0 || affixTwo > 64 ||
            condition < 0 || condition > 100) {
            return false
        }
        acceptedValue = true
        stableIdValue = stableId
        definitionIdValue = definitionId
        seedValue = seed
        levelValue = level
        rarityValue = rarity
        affixOneValue = affixOne
        affixTwoValue = affixTwo
        conditionValue = condition
        return true
    }

    Bool accepted() {
        return acceptedValue
    }

    Int stableId() {
        return stableIdValue
    }

    Int definitionId() {
        return definitionIdValue
    }

    Int seed() {
        return seedValue
    }

    Int level() {
        return levelValue
    }

    Int rarity() {
        return rarityValue
    }

    Int affixOne() {
        return affixOneValue
    }

    Int affixTwo() {
        return affixTwoValue
    }

    Int condition() {
        return conditionValue
    }

    Bool clear() {
        acceptedValue = false
        stableIdValue = 0
        definitionIdValue = 0
        seedValue = 0
        levelValue = 0
        rarityValue = 0
        affixOneValue = 0
        affixTwoValue = 0
        conditionValue = 0
        return true
    }
}

class BoundedItemRollSaveSection {
    Int[] stableIds
    Int[] definitionIds
    Int[] seeds
    Int[] levels
    Int[] rarities
    Int[] affixOnes
    Int[] affixTwos
    Int[] conditions
    Int countValue

    public constructor(Int capacity) {
        var actualCapacity = capacity
        if (actualCapacity <= 0) {
            actualCapacity = 1
        }
        if (actualCapacity > 2) {
            actualCapacity = 2
        }
        stableIds = new Int[actualCapacity]
        definitionIds = new Int[actualCapacity]
        seeds = new Int[actualCapacity]
        levels = new Int[actualCapacity]
        rarities = new Int[actualCapacity]
        affixOnes = new Int[actualCapacity]
        affixTwos = new Int[actualCapacity]
        conditions = new Int[actualCapacity]
        countValue = 0
    }

    Int capacity() {
        return stableIds.length
    }

    Int count() {
        return countValue
    }

    Int find(Int stableId) {
        for (var index = 0; index < countValue; index = index + 1) {
            if (stableIds[index] == stableId) {
                return index
            }
        }
        return -1
    }

    Bool add(BoundedItemRoll roll) {
        if (!roll.accepted() || countValue >= stableIds.length ||
            find(roll.stableId()) >= 0) {
            return false
        }
        stableIds[countValue] = roll.stableId()
        definitionIds[countValue] = roll.definitionId()
        seeds[countValue] = roll.seed()
        levels[countValue] = roll.level()
        rarities[countValue] = roll.rarity()
        affixOnes[countValue] = roll.affixOne()
        affixTwos[countValue] = roll.affixTwo()
        conditions[countValue] = roll.condition()
        countValue = countValue + 1
        return true
    }

    BoundedItemRoll at(Int index) {
        var roll = BoundedItemRoll()
        if (index < 0 || index >= countValue) {
            return roll
        }
        roll.stage(
            stableIds[index], definitionIds[index], seeds[index], levels[index],
            rarities[index], affixOnes[index], affixTwos[index], conditions[index])
        return roll
    }

    Bool remove(Int stableId) {
        var index = find(stableId)
        if (index < 0) {
            return false
        }
        for (var shift = index; shift < countValue - 1; shift = shift + 1) {
            stableIds[shift] = stableIds[shift + 1]
            definitionIds[shift] = definitionIds[shift + 1]
            seeds[shift] = seeds[shift + 1]
            levels[shift] = levels[shift + 1]
            rarities[shift] = rarities[shift + 1]
            affixOnes[shift] = affixOnes[shift + 1]
            affixTwos[shift] = affixTwos[shift + 1]
            conditions[shift] = conditions[shift + 1]
        }
        countValue = countValue - 1
        return true
    }

    Bool encodeInto(BoundedSaveSections target) {
        var payload = new Int[countValue * 8]
        for (var index = 0; index < countValue; index = index + 1) {
            payload[index * 8] = stableIds[index]
            payload[index * 8 + 1] = definitionIds[index]
            payload[index * 8 + 2] = seeds[index]
            payload[index * 8 + 3] = levels[index]
            payload[index * 8 + 4] = rarities[index]
            payload[index * 8 + 5] = affixOnes[index]
            payload[index * 8 + 6] = affixTwos[index]
            payload[index * 8 + 7] = conditions[index]
        }
        return target.put(7, 1, payload)
    }

    Bool decodeFrom(BoundedSaveSections source) {
        var section = -1
        for (var index = 0; index < source.sectionCount(); index = index + 1) {
            if (source.sectionId(index) == 7) {
                section = index
                break
            }
        }
        if (section < 0) {
            countValue = 0
            return true
        }
        if (source.sectionVersion(section) != 1 ||
            source.sectionLength(section) % 8 != 0 ||
            source.sectionLength(section) / 8 > stableIds.length) {
            return false
        }
        var nextCount = source.sectionLength(section) / 8
        for (var index = 0; index < nextCount; index = index + 1) {
            var offset = index * 8
            var roll = BoundedItemRoll()
            if (!roll.stage(
                source.sectionValue(section, offset),
                source.sectionValue(section, offset + 1),
                source.sectionValue(section, offset + 2),
                source.sectionValue(section, offset + 3),
                source.sectionValue(section, offset + 4),
                source.sectionValue(section, offset + 5),
                source.sectionValue(section, offset + 6),
                source.sectionValue(section, offset + 7)) ||
                find(source.sectionValue(section, offset)) >= 0) {
                return false
            }
        }
        countValue = nextCount
        for (var copy = 0; copy < nextCount; copy = copy + 1) {
            var offset = copy * 8
            stableIds[copy] = source.sectionValue(section, offset)
            definitionIds[copy] = source.sectionValue(section, offset + 1)
            seeds[copy] = source.sectionValue(section, offset + 2)
            levels[copy] = source.sectionValue(section, offset + 3)
            rarities[copy] = source.sectionValue(section, offset + 4)
            affixOnes[copy] = source.sectionValue(section, offset + 5)
            affixTwos[copy] = source.sectionValue(section, offset + 6)
            conditions[copy] = source.sectionValue(section, offset + 7)
        }
        return true
    }
}

class BoundedLootTable {
    Int[] definitionIds
    Int[] weights
    Int countValue
    Int totalWeightValue

    public constructor(Int capacity) {
        var actualCapacity = capacity
        if (actualCapacity <= 0) {
            actualCapacity = 1
        }
        if (actualCapacity > 32) {
            actualCapacity = 32
        }
        definitionIds = new Int[actualCapacity]
        weights = new Int[actualCapacity]
        countValue = 0
        totalWeightValue = 0
    }

    Bool add(Int definitionId, Int weight, BoundedItemDefinitionStore definitions) {
        if (definitionId <= 0 || weight <= 0 || weight > 1000000 ||
            totalWeightValue > 1000000 - weight ||
            countValue >= definitionIds.length ||
            definitions.find(definitionId) < 0 || find(definitionId) >= 0) {
            return false
        }
        definitionIds[countValue] = definitionId
        weights[countValue] = weight
        countValue = countValue + 1
        totalWeightValue = totalWeightValue + weight
        return true
    }

    Int find(Int definitionId) {
        for (var index = 0; index < countValue; index = index + 1) {
            if (definitionIds[index] == definitionId) {
                return index
            }
        }
        return -1
    }

    Int nextValue(Int seed, Int salt, Int bound) {
        if (bound <= 0) {
            return 0
        }
        var value = (seed * 48271 + salt * 7919 + 17) % 1000003
        if (value < 0) {
            value = value + 1000003
        }
        return value % bound
    }

    Bool roll(
        Int stableId, Int seed, Int level,
        BoundedItemDefinitionStore definitions, BoundedItemRoll target
    ) {
        if (stableId <= 0 || seed < 0 || seed > 1000000 || level <= 0 ||
            level > 1000000 || countValue == 0 || totalWeightValue <= 0) {
            return false
        }
        var pick = nextValue(seed, 1, totalWeightValue)
        var selected = -1
        var cursor = 0
        for (var index = 0; index < countValue; index = index + 1) {
            cursor = cursor + weights[index]
            if (pick < cursor) {
                selected = index
                break
            }
        }
        if (selected < 0) {
            return false
        }
        var definitionId = definitionIds[selected]
        if (level < definitions.minimumLevel(definitionId) ||
            level > definitions.maximumLevel(definitionId)) {
            return false
        }
        var affixPool = definitions.affixPool(definitionId)
        var affixOne = 0
        var affixTwo = 0
        if (affixPool > 0) {
            affixOne = 1 + nextValue(seed, 3, affixPool)
            if (affixPool > 1) {
                affixTwo = 1 + nextValue(seed, 4, affixPool)
                if (affixTwo == affixOne) {
                    affixTwo = (affixTwo % affixPool) + 1
                }
            }
        }
        return target.stage(
            stableId, definitionId, seed, level,
            1 + nextValue(seed, 2, 3), affixOne, affixTwo,
            50 + nextValue(seed, 5, 51))
    }
}

class BoundedAffixStatStore {
    Int[] ids
    Int[] flatValues
    Int[] additivePercents
    Int[] multiplicativePercents
    Int countValue

    public constructor(Int capacity) {
        var actualCapacity = capacity
        if (actualCapacity <= 0) {
            actualCapacity = 1
        }
        if (actualCapacity > 32) {
            actualCapacity = 32
        }
        ids = new Int[actualCapacity]
        flatValues = new Int[actualCapacity]
        additivePercents = new Int[actualCapacity]
        multiplicativePercents = new Int[actualCapacity]
        countValue = 0
    }

    Bool define(
        Int id, Int flatValue, Int additivePercent, Int multiplicativePercent
    ) {
        if (id <= 0 || flatValue < 0 || flatValue > 1000000 ||
            additivePercent < 0 || additivePercent > 1000000 ||
            multiplicativePercent < 0 || multiplicativePercent > 1000000 ||
            countValue >= ids.length || find(id) >= 0) {
            return false
        }
        ids[countValue] = id
        flatValues[countValue] = flatValue
        additivePercents[countValue] = additivePercent
        multiplicativePercents[countValue] = multiplicativePercent
        countValue = countValue + 1
        return true
    }

    Int find(Int id) {
        for (var index = 0; index < countValue; index = index + 1) {
            if (ids[index] == id) {
                return index
            }
        }
        return -1
    }

    Bool contains(Int id) {
        return find(id) >= 0
    }

    Int flatValue(Int id) {
        var index = find(id)
        if (index < 0) {
            return -1
        }
        return flatValues[index]
    }

    Int additivePercent(Int id) {
        var index = find(id)
        if (index < 0) {
            return -1
        }
        return additivePercents[index]
    }

    Int multiplicativePercent(Int id) {
        var index = find(id)
        if (index < 0) {
            return -1
        }
        return multiplicativePercents[index]
    }
}

class BoundedItemStatResult {
    Bool acceptedValue
    Int baseValue
    Int flatValue
    Int additiveValue
    Int finalValue

    public constructor() {
        clear()
    }

    Bool clear() {
        acceptedValue = false
        baseValue = 0
        flatValue = 0
        additiveValue = 0
        finalValue = 0
        return true
    }

    Bool accepted() {
        return acceptedValue
    }

    Int base() {
        return baseValue
    }

    Int flat() {
        return flatValue
    }

    Int additive() {
        return additiveValue
    }

    Int finalAmount() {
        return finalValue
    }
}

class BoundedItemStatComposer {
    Int maxValue

    public constructor() {
        maxValue = 1000000
    }

    Bool compose(
        BoundedItemRoll roll,
        BoundedItemDefinitionStore definitions,
        BoundedAffixStatStore affixes,
        BoundedItemStatResult target
    ) {
        target.clear()
        if (!roll.accepted() ||
            !definitions.contains(roll.definitionId()) ||
            roll.level() <= 0) {
            return false
        }
        var base = definitions.baseValue(roll.definitionId())
        var flat = base
        var additive = 0
        var multiplicative = 0
        var firstAffix = roll.affixOne()
        var secondAffix = roll.affixTwo()
        if (firstAffix != 0 && !affixes.contains(firstAffix)) {
            return false
        }
        if (secondAffix != 0 && !affixes.contains(secondAffix)) {
            return false
        }
        if (firstAffix != 0) {
            flat = flat + affixes.flatValue(firstAffix)
            additive = additive + affixes.additivePercent(firstAffix)
            multiplicative = multiplicative +
                affixes.multiplicativePercent(firstAffix)
        }
        if (secondAffix != 0) {
            flat = flat + affixes.flatValue(secondAffix)
            additive = additive + affixes.additivePercent(secondAffix)
            multiplicative = multiplicative +
                affixes.multiplicativePercent(secondAffix)
        }
        if (flat < 0 || flat > maxValue || additive < 0 ||
            additive > 1000000 || multiplicative < 0 ||
            multiplicative > 1000000) {
            return false
        }
        var additiveBonus = flat * additive / 100
        if (additiveBonus < 0 || additiveBonus > maxValue - flat) {
            return false
        }
        var additiveValue = flat + additiveBonus
        var multiplicativeBonus = additiveValue * multiplicative / 100
        if (multiplicativeBonus < 0 ||
            multiplicativeBonus > maxValue - additiveValue) {
            return false
        }
        var finalValue = additiveValue + multiplicativeBonus
        target.baseValue = base
        target.flatValue = flat
        target.additiveValue = additiveValue
        target.finalValue = finalValue
        target.acceptedValue = true
        return true
    }
}
