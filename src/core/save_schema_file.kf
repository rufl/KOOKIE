package core

class BoundedSaveSchemaFileStore {
    BoundedSaveSchemaWireCodec codec
    BoundedSaveMigrationGate gate
    BoundedSaveState checksums
    Int sectionCapacityValue
    Int payloadCapacityValue
    Int maxWireWords
    Int maxBytes
    Int digitsPerWord
    Int magic

    public constructor(Int sectionCapacity, Int payloadCapacity) {
        sectionCapacityValue = sectionCapacity
        if (sectionCapacityValue < 1) {
            sectionCapacityValue = 1
        }
        if (sectionCapacityValue > 12) {
            sectionCapacityValue = 12
        }
        payloadCapacityValue = payloadCapacity
        if (payloadCapacityValue < 1) {
            payloadCapacityValue = 1
        }
        if (payloadCapacityValue > 160) {
            payloadCapacityValue = 160
        }
        codec = BoundedSaveSchemaWireCodec(sectionCapacityValue, payloadCapacityValue)
        gate = BoundedSaveMigrationGate()
        checksums = BoundedSaveState(1, 1000000)
        digitsPerWord = 6
        maxWireWords = 4 + sectionCapacityValue * (3 + payloadCapacityValue)
        var maxWords = 3 + 2 * (maxWireWords + 2)
        if (maxWords < 316) {
            maxWords = 316
        }
        maxBytes = maxWords * digitsPerWord
        magic = 11773399
    }

    Bool write(String path, BoundedSaveSections sections) {
        if (!codec.encode(sections)) {
            return false
        }
        var wireLength = codec.encodedLength()
        var wire = new Int[wireLength]
        for (var index = 0; index < wireLength; index = index + 1) {
            wire[index] = codec.encodedWord(index)
        }
        var checksum = checksums.checksumFor(wire[1], wire[2], wire)
        var slotWords = wireLength + 2
        var words = new Int[3 + slotWords * 2]
        words[0] = magic
        words[1] = 2
        words[2] = slotWords
        for (var copy = 0; copy < 2; copy = copy + 1) {
            var start = 3 + copy * slotWords
            words[start] = wireLength
            words[start + 1] = checksum
            for (var index = 0; index < wireLength; index = index + 1) {
                words[start + 2 + index] = wire[index]
            }
        }
        return writeWords(path, words)
    }

    Bool writeLegacy(String path, BoundedSaveState state) {
        var sections = BoundedSaveSections(sectionCapacityValue, payloadCapacityValue)
        if (!gate.importLegacy(state, sections)) {
            return false
        }
        return write(path, sections)
    }

    Bool read(String path, BoundedSaveSections target) {
        var words = readWords(path)
        if (words.length < 3 || words[0] != magic) {
            return false
        }
        var first = BoundedSaveSections(sectionCapacityValue, payloadCapacityValue)
        var second = BoundedSaveSections(sectionCapacityValue, payloadCapacityValue)
        var firstStatus = 0
        var secondStatus = 0
        if (words[1] == 1) {
            // Version 1 has fixed framing, regardless of this store's capacities.
            if (words.length != 316) {
                return false
            }
            firstStatus = decodeSlot(words, 2, 3, 156, false, first)
            secondStatus = decodeSlot(words, 159, 160, 156, false, second)
        } else if (words[1] == 2) {
            var slotWords = words[2]
            if (slotWords < 6 || slotWords > maxWireWords + 2) {
                return false
            }
            if (words.length != 3 + slotWords * 2) {
                return false
            }
            firstStatus = decodeSlot(words, 3, 5, slotWords - 2, true, first)
            secondStatus = decodeSlot(words, 3 + slotWords, 5 + slotWords,
                slotWords - 2, true, second)
        } else {
            return false
        }
        // A valid newer schema is not corruption: never silently roll it back.
        if (firstStatus < 0 || secondStatus < 0 ||
            (firstStatus == 0 && secondStatus == 0)) {
            return false
        }
        if (firstStatus == 1 && (secondStatus == 0 || second.revision() <= first.revision())) {
            return target.replaceFrom(first)
        }
        return target.replaceFrom(second)
    }

    Bool readLegacy(String path, BoundedSaveState target) {
        var sections = BoundedSaveSections(sectionCapacityValue, payloadCapacityValue)
        return read(path, sections) && gate.exportLegacy(sections, target)
    }

    Bool repair(String path) {
        var restored = BoundedSaveSections(sectionCapacityValue, payloadCapacityValue)
        if (!read(path, restored)) {
            return false
        }
        return write(path, restored)
    }

    // 1 is decoded, 0 is corrupt, -1 is an unsupported schema.
    Int decodeSlot(Int[] words, Int lengthIndex, Int start, Int limit,
        Bool checked, BoundedSaveSections target) {
        if (lengthIndex < 0 || lengthIndex >= words.length || start < 0 ||
            limit < 4 || start > words.length - limit) {
            return 0
        }
        var length = words[lengthIndex]
        if (length < 4 || length > limit || length > maxWireWords ||
            (checked && length != limit)) {
            return 0
        }
        var wire = new Int[length]
        for (var index = 0; index < length; index = index + 1) {
            if (words[start + index] < 0) {
                return 0
            }
            wire[index] = words[start + index]
        }
        if (wire[0] != 99112233 || wire[1] < 1 || wire[1] > 1000000 ||
            wire[2] > 1000000 || wire[3] > sectionCapacityValue ||
            (!checked && wire[3] > 8)) {
            return 0
        }
        if (checked) {
            if (start < 1 || words[start - 1] < 0 ||
                words[start - 1] != checksums.checksumFor(wire[1], wire[2], wire)) {
                return 0
            }
        }
        if (wire[1] > 1) {
            return -1
        }
        var offset = 4
        var unsupported = false
        for (var index = 0; index < wire[3]; index = index + 1) {
            if (offset + 3 > length) {
                return 0
            }
            var payloadLength = wire[offset + 2]
            if (wire[offset] <= 0 || payloadLength > payloadCapacityValue ||
                (!checked && payloadLength > 16) || offset + 3 + payloadLength > length) {
                return 0
            }
            var currentVersion = gate.currentVersionFor(wire[offset])
            if (currentVersion < 0 || wire[offset + 1] > currentVersion) {
                unsupported = true
            }
            for (var valueIndex = 0; valueIndex < payloadLength; valueIndex = valueIndex + 1) {
                if (wire[offset + 3 + valueIndex] > 1000000) {
                    return 0
                }
            }
            offset = offset + 3 + payloadLength
        }
        if (offset != length) {
            return 0
        }
        if (unsupported) {
            return -1
        }
        if (!codec.decode(wire, target)) {
            return 0
        }
        return 1
    }

    Bool writeWords(String path, Int[] words) {
        var output = new Int[words.length * digitsPerWord]
        for (var wordIndex = 0; wordIndex < words.length; wordIndex = wordIndex + 1) {
            var value = words[wordIndex]
            for (var digit = 0; digit < digitsPerWord; digit = digit + 1) {
                output[wordIndex * digitsPerWord + digit] = value % 64
                value = value / 64
            }
        }
        var file = File(path)
        return file.writeBytes(output)
    }

    Int[] readWords(String path) {
        var file = File(path)
        // The extra byte detects overlong files, including a valid maximum-size prefix.
        var input = file.readRange(0, maxBytes + 1)
        if (input.length < 3 * digitsPerWord || input.length > maxBytes ||
            input.length % digitsPerWord != 0) {
            return new Int[0]
        }
        var words = new Int[input.length / digitsPerWord]
        for (var wordIndex = 0; wordIndex < words.length; wordIndex = wordIndex + 1) {
            var offset = wordIndex * digitsPerWord
            var value = 0
            var multiplier = 1
            var valid = true
            for (var digit = 0; digit < digitsPerWord; digit = digit + 1) {
                if (input[offset + digit] < 0 || input[offset + digit] >= 64 ||
                    (digit == digitsPerWord - 1 && input[offset + digit] != 0)) {
                    valid = false
                } else {
                    value = value + input[offset + digit] * multiplier
                }
                if (digit < digitsPerWord - 1) {
                    multiplier = multiplier * 64
                }
            }
            words[wordIndex] = -1
            if (valid) {
                words[wordIndex] = value
            }
        }
        return words
    }
}
