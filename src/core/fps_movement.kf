package core

Int fpsMovementCoordinateScale() { return 8 }
Int fpsMovementTickMicros() { return 16667 }

Int fpsMovementTicksForMicros(Int durationMicros) {
    if (durationMicros <= 0) {
        return 0
    }
    return (durationMicros + fpsMovementTickMicros() - 1) /
        fpsMovementTickMicros()
}

Int fpsMovementCoyoteWindowMicros() { return 100000 }
Int fpsMovementJumpBufferWindowMicros() { return 100000 }
Int fpsMovementJumpAirTimeMicros() { return 300000 }
Int fpsMovementCoyoteTicks() {
    return fpsMovementTicksForMicros(fpsMovementCoyoteWindowMicros())
}
Int fpsMovementJumpBufferTicks() {
    return fpsMovementTicksForMicros(fpsMovementJumpBufferWindowMicros())
}
Int fpsMovementAirTimeTicks() {
    return fpsMovementTicksForMicros(fpsMovementJumpAirTimeMicros())
}

Int fpsMovementWalkSpeed() { return 8 }
Int fpsMovementGroundAcceleration() { return 3 }
Int fpsMovementAirAcceleration() { return 1 }
Int fpsMovementGroundBraking() { return 2 }
Int fpsMovementAirBraking() { return 1 }
Int fpsMovementGravity() { return 1 }
Int fpsMovementJumpVelocity() {
    return fpsMovementGravity() * (fpsMovementAirTimeTicks() / 2)
}
Int fpsMovementMaximumAirJumps() { return 1 }
Int fpsMovementFlapImpulse() { return fpsMovementGravity() * 2 }
Int fpsMovementFlapIntervalTicks() { return 3 }
Int fpsMovementMaximumFallTicks() { return 16 }
Int fpsMovementMaxFallSpeed() {
    return fpsMovementGravity() * fpsMovementMaximumFallTicks()
}
Int fpsMovementJumpCutNumerator() { return 3 }
Int fpsMovementJumpCutDenominator() { return 5 }

Int fpsMovementMaximumActors() { return 8 }
Int fpsMovementInputAxisLimit() { return 4 }
Int fpsMovementCollisionTriangleCapacity() { return 192 }
Int fpsMovementCollisionMaxDistance() { return 256 }
Int fpsMovementCollisionMinimumX() { return 0 }
Int fpsMovementCollisionMinimumY() { return -32 }
Int fpsMovementCollisionMinimumZ() { return 0 }
Int fpsMovementCollisionMaximumX() { return 256 }
Int fpsMovementCollisionMaximumY() { return 128 }
Int fpsMovementCollisionMaximumZ() { return 224 }
Int fpsMovementCapsuleRadius() { return 2 }
Int fpsMovementCapsuleMaxDistance() { return 256 }
Int fpsMovementSlopeLimit() { return 60 }
Int fpsMovementStepHeight() { return 4 }
Int fpsMovementCrouchSpeed() { return 5 }
Int fpsMovementGlideFallSpeed() { return 2 }

class FpsMovementController {
    BoundedTriangleCollection collisionValue
    BoundedTriangleContactController capsuleValue
    Bool configuredValue
    Int scaleValue
    Int[] positionXValues
    Int[] positionYValues
    Int[] positionZValues
    Int[] velocityXValues
    Int[] velocityYValues
    Int[] velocityZValues
    Int[] coyoteTicksValues
    Int[] jumpBufferTicksValues
    Int[] airJumpValues
    Int[] flapCooldownValues
    Bool[] activeValues
    Bool[] groundedValues
    Bool[] crouchedValues
    Bool[] glidingValues
    Bool[] jumpCutArmedValues
    Bool[] liquidActiveValues
    Int[] liquidHorizontalSpeeds
    Int[] liquidHorizontalAccelerations
    Int[] liquidHorizontalBrakings
    Int[] liquidVerticalDrags
    Int[] liquidGravities
    Int[] liquidBuoyancies
    Int[] liquidSwimImpulses
    Int[] liquidMaxFallSpeeds
    Int[] powerUpSpeedBonuses
    Int[] powerUpJumpBonuses
    Int[] liquidMaxRiseSpeeds
    Int[] animalKinds
    Int lastActorValue
    Bool lastAcceptedValue
    Bool lastCollidedValue
    Bool lastGroundedValue
    Bool lastJumpedValue
    Bool lastDoubleJumpValue
    Bool lastFlappedValue
    Bool lastCoyoteJumpValue
    Bool lastBunnyHopValue
    Bool lastLandedValue
    Int actualCapacityValue

    public constructor(Int capacity) {
        actualCapacityValue = capacity
        if (actualCapacityValue <= 0) {
            actualCapacityValue = 1
        }
        if (actualCapacityValue > fpsMovementMaximumActors()) {
            actualCapacityValue = fpsMovementMaximumActors()
        }
        scaleValue = fpsMovementCoordinateScale()
        collisionValue = BoundedTriangleCollection(
            fpsMovementCollisionTriangleCapacity(),
            fpsMovementCollisionMaxDistance())
        collisionValue.configureBounds(
            fpsMovementCollisionMinimumX(),
            fpsMovementCollisionMinimumY(),
            fpsMovementCollisionMinimumZ(),
            fpsMovementCollisionMaximumX(),
            fpsMovementCollisionMaximumY(),
            fpsMovementCollisionMaximumZ())
        capsuleValue = BoundedTriangleContactController(
            collisionValue,
            fpsMovementCapsuleRadius(),
            fpsMovementCapsuleMaxDistance(),
            fpsMovementSlopeLimit(),
            fpsMovementStepHeight())
        capsuleValue.setGroundProbeDistance(
            fpsMovementCoordinateScale())
        positionXValues = new Int[actualCapacityValue]
        positionYValues = new Int[actualCapacityValue]
        positionZValues = new Int[actualCapacityValue]
        velocityXValues = new Int[actualCapacityValue]
        velocityYValues = new Int[actualCapacityValue]
        velocityZValues = new Int[actualCapacityValue]
        coyoteTicksValues = new Int[actualCapacityValue]
        jumpBufferTicksValues = new Int[actualCapacityValue]
        airJumpValues = new Int[actualCapacityValue]
        flapCooldownValues = new Int[actualCapacityValue]
        activeValues = new Bool[actualCapacityValue]
        groundedValues = new Bool[actualCapacityValue]
        crouchedValues = new Bool[actualCapacityValue]
        glidingValues = new Bool[actualCapacityValue]
        jumpCutArmedValues = new Bool[actualCapacityValue]
        liquidActiveValues = new Bool[actualCapacityValue]
        liquidHorizontalSpeeds = new Int[actualCapacityValue]
        liquidHorizontalAccelerations = new Int[actualCapacityValue]
        liquidHorizontalBrakings = new Int[actualCapacityValue]
        liquidVerticalDrags = new Int[actualCapacityValue]
        liquidGravities = new Int[actualCapacityValue]
        liquidBuoyancies = new Int[actualCapacityValue]
        liquidSwimImpulses = new Int[actualCapacityValue]
        liquidMaxFallSpeeds = new Int[actualCapacityValue]
        liquidMaxRiseSpeeds = new Int[actualCapacityValue]
        powerUpSpeedBonuses = new Int[actualCapacityValue]
        powerUpJumpBonuses = new Int[actualCapacityValue]
        animalKinds = new Int[actualCapacityValue]
        clearActors()
        configuredValue = false
        lastActorValue = 0
        lastAcceptedValue = false
        lastCollidedValue = false
        lastGroundedValue = false
        lastJumpedValue = false
        lastDoubleJumpValue = false
        lastFlappedValue = false
        lastCoyoteJumpValue = false
        lastBunnyHopValue = false
        lastLandedValue = false
    }

    void clearActors() {
        for (var index = 0; index < actualCapacityValue; index = index + 1) {
            positionXValues[index] = 0
            positionYValues[index] = 0
            positionZValues[index] = 0
            velocityXValues[index] = 0
            velocityYValues[index] = 0
            velocityZValues[index] = 0
            coyoteTicksValues[index] = 0
            jumpBufferTicksValues[index] = 0
            airJumpValues[index] = 0
            flapCooldownValues[index] = 0
            activeValues[index] = false
            groundedValues[index] = false
            crouchedValues[index] = false
            glidingValues[index] = false
            liquidActiveValues[index] = false
            liquidHorizontalSpeeds[index] = 0
            liquidHorizontalAccelerations[index] = 0
            liquidHorizontalBrakings[index] = 0
            liquidVerticalDrags[index] = 0
            liquidGravities[index] = 0
            liquidBuoyancies[index] = 0
            liquidSwimImpulses[index] = 0
            liquidMaxFallSpeeds[index] = 0
            liquidMaxRiseSpeeds[index] = 0
            powerUpSpeedBonuses[index] = 0
            powerUpJumpBonuses[index] = 0
            animalKinds[index] = animalKindGoose()
        }
    }

    Int slotFor(Int actorId) {
        if (actorId <= 0 || actorId > actualCapacityValue) {
            return -1
        }
        return actorId - 1
    }

    Int scaled(Int value) {
        return value * scaleValue
    }

    Int worldCoordinate(Int value) {
        if (value >= 0) {
            return (value + scaleValue / 2) / scaleValue
        }
        return (value - scaleValue / 2) / scaleValue
    }

    Int clampAxis(Int value) {
        var limit = fpsMovementInputAxisLimit()
        if (value < -limit) {
            return -limit
        }
        if (value > limit) {
            return limit
        }
        return value
    }

    Int sign(Int value) {
        if (value < 0) {
            return -1
        }
        if (value > 0) {
            return 1
        }
        return 0
    }

    Int approach(Int value, Int target, Int delta) {
        if (value < target) {
            value = value + delta
            if (value > target) {
                value = target
            }
            return value
        }
        if (value > target) {
            value = value - delta
            if (value < target) {
                value = target
            }
        }
        return value
    }
    Int absolute(Int value) {
        return if (value < 0) -value else value
    }

    Int horizontalMagnitude(Int x, Int z) {
        var major = absolute(x)
        var minor = absolute(z)
        if (minor > major) {
            var swap = major
            major = minor
            minor = swap
        }
        return major + minor * 3 / 8
    }

    Int horizontalMagnitudeFixed(Int x, Int z) {
        var major = absolute(x)
        var minor = absolute(z)
        if (minor > major) {
            var swap = major
            major = minor
            minor = swap
        }
        return major * 1024 + minor * 384
    }

    Int wishComponent(Int value, Int magnitudeFixed) {
        if (magnitudeFixed <= 0) { return 0 }
        return value * 1024 * 1024 / magnitudeFixed
    }

    void applyHorizontalFriction(Int slot, Int braking) {
        var speed = horizontalMagnitude(
            velocityXValues[slot], velocityZValues[slot])
        if (speed <= 0) { return }
        var nextSpeed = speed - braking
        if (nextSpeed <= 0) {
            velocityXValues[slot] = 0
            velocityZValues[slot] = 0
            return
        }
        velocityXValues[slot] = velocityXValues[slot] * nextSpeed / speed
        velocityZValues[slot] = velocityZValues[slot] * nextSpeed / speed
    }

    void accelerateHorizontal(
        Int slot, Int moveX, Int moveZ, Int targetSpeed, Int acceleration
    ) {
        var inputMagnitude = horizontalMagnitude(moveX, moveZ)
        var inputMagnitudeFixed = horizontalMagnitudeFixed(moveX, moveZ)
        if (inputMagnitude <= 0 || targetSpeed <= 0 || acceleration <= 0) {
            return
        }
        var wishX = wishComponent(moveX, inputMagnitudeFixed)
        var wishZ = wishComponent(moveZ, inputMagnitudeFixed)
        var currentSpeed = (
            velocityXValues[slot] * wishX +
            velocityZValues[slot] * wishZ
        ) / 1024
        var addSpeed = targetSpeed - currentSpeed
        if (addSpeed <= 0) { return }
        var accelerationSpeed = acceleration
        if (accelerationSpeed > addSpeed) {
            accelerationSpeed = addSpeed
        }
        velocityXValues[slot] = velocityXValues[slot] +
            wishX * accelerationSpeed / 1024
        velocityZValues[slot] = velocityZValues[slot] +
            wishZ * accelerationSpeed / 1024
    }


    Bool configure(BoundedAuthoredCollision authored) {
        configuredValue = false
        clearActors()
        if (!authored.validate() ||
            authored.triangleCount() > fpsMovementCollisionTriangleCapacity()) {
            return false
        }
        if (!collisionValue.configureBounds(
                authored.minX() * scaleValue,
                authored.minY() * scaleValue,
                authored.minZ() * scaleValue,
                authored.maxX() * scaleValue,
                authored.maxY() * scaleValue,
                authored.maxZ() * scaleValue) ||
            !collisionValue.clearTriangles()) {
            return false
        }
        for (var index = 0; index < authored.triangleCount(); index = index + 1) {
            var first = authored.triangleVertex(index, 0)
            var second = authored.triangleVertex(index, 1)
            var third = authored.triangleVertex(index, 2)
            if (first < 0 || second < 0 || third < 0 ||
                !collisionValue.addTriangle(
                    authored.vertexCoordinate(first, 0) * scaleValue,
                    authored.vertexCoordinate(first, 1) * scaleValue,
                    authored.vertexCoordinate(first, 2) * scaleValue,
                    authored.vertexCoordinate(second, 0) * scaleValue,
                    authored.vertexCoordinate(second, 1) * scaleValue,
                    authored.vertexCoordinate(second, 2) * scaleValue,
                    authored.vertexCoordinate(third, 0) * scaleValue,
                    authored.vertexCoordinate(third, 1) * scaleValue,
                    authored.vertexCoordinate(third, 2) * scaleValue)) {
                return false
            }
        }
        configuredValue = collisionValue.triangleCount() == authored.triangleCount()
        return configuredValue
    }

    Bool configured() {
        return configuredValue
    }

    Bool addActor(Int actorId, Int x, Int y, Int z) {
        var slot = slotFor(actorId)
        if (!configuredValue || slot < 0 ||
            x < collisionValue.minimumX() / scaleValue ||
            x > collisionValue.maximumX() / scaleValue ||
            y < collisionValue.minimumY() / scaleValue ||
            y > collisionValue.maximumY() / scaleValue ||
            z < collisionValue.minimumZ() / scaleValue ||
            z > collisionValue.maximumZ() / scaleValue) {
            return false
        }
        positionXValues[slot] = scaled(x)
        positionYValues[slot] = scaled(y)
        positionZValues[slot] = scaled(z)
        velocityXValues[slot] = 0
        velocityYValues[slot] = 0
        velocityZValues[slot] = 0
        coyoteTicksValues[slot] = fpsMovementCoyoteTicks()
        jumpBufferTicksValues[slot] = 0
        airJumpValues[slot] = 0
        flapCooldownValues[slot] = 0
        activeValues[slot] = true
        groundedValues[slot] = true
        crouchedValues[slot] = false
        glidingValues[slot] = false
        jumpCutArmedValues[slot] = false
        return true
    }

    Bool setPosition(Int actorId, Int x, Int y, Int z) {
        var slot = slotFor(actorId)
        if (!configuredValue || slot < 0 || !activeValues[slot]) {
            return false
        }
        if (x < collisionValue.minimumX() / scaleValue ||
            x > collisionValue.maximumX() / scaleValue ||
            y < collisionValue.minimumY() / scaleValue ||
            y > collisionValue.maximumY() / scaleValue ||
            z < collisionValue.minimumZ() / scaleValue ||
            z > collisionValue.maximumZ() / scaleValue) {
            return false
        }
        positionXValues[slot] = scaled(x)
        positionYValues[slot] = scaled(y)
        positionZValues[slot] = scaled(z)
        velocityXValues[slot] = 0
        velocityYValues[slot] = 0
        velocityZValues[slot] = 0
        coyoteTicksValues[slot] = fpsMovementCoyoteTicks()
        jumpBufferTicksValues[slot] = 0
        airJumpValues[slot] = 0
        flapCooldownValues[slot] = 0
        crouchedValues[slot] = false
        glidingValues[slot] = false
        groundedValues[slot] = true
        jumpCutArmedValues[slot] = false
        return true
    }

    Bool setHorizontalPosition(Int actorId, Int x) {
        var slot = slotFor(actorId)
        if (slot < 0 || !activeValues[slot]) {
            return false
        }
        return setPosition(
            actorId, x, worldCoordinate(positionYValues[slot]),
            worldCoordinate(positionZValues[slot]))
    }
    Bool configureLiquidActor(
        Int actorId, Bool active, LiquidMovementProfile profile
    ) {
        var slot = slotFor(actorId)
        if (slot < 0 || !activeValues[slot] ||
            profile.horizontalSpeed() <= 0 ||
            profile.horizontalAcceleration() <= 0 ||
            profile.horizontalBraking() <= 0 ||
            profile.verticalDrag() < 0 ||
            profile.verticalDrag() > liquidParameterScale() ||
            profile.gravity() < 0 || profile.buoyancy() < 0 ||
            profile.swimImpulse() < 0 ||
            profile.maxFallSpeed() <= 0 || profile.maxRiseSpeed() <= 0) {
            return false
        }
        liquidActiveValues[slot] = active
        liquidHorizontalSpeeds[slot] = profile.horizontalSpeed()
        liquidHorizontalAccelerations[slot] = profile.horizontalAcceleration()
        liquidHorizontalBrakings[slot] = profile.horizontalBraking()
        liquidVerticalDrags[slot] = profile.verticalDrag()
        liquidGravities[slot] = profile.gravity()
        liquidBuoyancies[slot] = profile.buoyancy()
        liquidSwimImpulses[slot] = profile.swimImpulse()
        liquidMaxFallSpeeds[slot] = profile.maxFallSpeed()
        liquidMaxRiseSpeeds[slot] = profile.maxRiseSpeed()
        return true
    }
    Bool configurePowerUpActor(
        Int actorId, Int speedBonus, Int jumpBonus
    ) {
        var slot = slotFor(actorId)
        if (slot < 0 || !activeValues[slot] ||
            speedBonus < 0 || speedBonus > powerUpMaximumEffect() ||
            jumpBonus < 0 || jumpBonus > powerUpMaximumEffect()) {
            return false
        }
        powerUpSpeedBonuses[slot] = speedBonus
        powerUpJumpBonuses[slot] = jumpBonus
        return true
    }
    Bool configureAnimalActor(Int actorId, Int animalKind) {
        var slot = slotFor(actorId)
        if (slot < 0 || !activeValues[slot] ||
            !validAnimalKind(animalKind)) {
            return false
        }
        animalKinds[slot] = animalKind
        return true
    }
    Bool setCrouched(Int actorId, Bool crouched) {
        var slot = slotFor(actorId)
        if (slot < 0 || !activeValues[slot]) { return false }
        crouchedValues[slot] = crouched
        return true
    }

    Bool setGliding(Int actorId, Bool gliding) {
        var slot = slotFor(actorId)
        if (slot < 0 || !activeValues[slot]) { return false }
        glidingValues[slot] = gliding
        return true
    }

    Int animalKind(Int actorId) {
        var slot = slotFor(actorId)
        if (slot < 0 || !activeValues[slot]) { return 0 }
        return animalKinds[slot]
    }

    Bool burst(Int actorId, Int directionX, Int directionZ, Int distance) {
        var slot = slotFor(actorId)
        if (!configuredValue || slot < 0 || !activeValues[slot] ||
            distance <= 0 || distance > fpsMovementCollisionMaxDistance()) {
            return false
        }
        directionX = sign(clampAxis(directionX))
        directionZ = sign(clampAxis(directionZ))
        if (directionX == 0 && directionZ == 0) {
            directionZ = 1
        }
        var movement = capsuleValue.move(
            positionXValues[slot], positionYValues[slot],
            positionZValues[slot],
            positionXValues[slot] + scaled(directionX * distance),
            positionYValues[slot],
            positionZValues[slot] + scaled(directionZ * distance))
        if (!movement.accepted()) { return false }
        positionXValues[slot] = movement.resolvedX()
        positionYValues[slot] = movement.resolvedY()
        positionZValues[slot] = movement.resolvedZ()
        velocityXValues[slot] = 0
        velocityYValues[slot] = 0
        velocityZValues[slot] = 0
        groundedValues[slot] = movement.grounded()
        return true
    }


    Bool flappingAllowed(Int actorId) {
        return animalKind(actorId) == animalKindGoose()
    }



    Bool liquidActive(Int actorId) {
        var slot = slotFor(actorId)
        return slot >= 0 && activeValues[slot] && liquidActiveValues[slot]
    }

    Bool step(
        Int actorId, Int moveX, Int moveZ,
        Bool jumpPressed, Bool jumpHeld
    ) {
        var slot = slotFor(actorId)
        if (!configuredValue || slot < 0 || !activeValues[slot]) {
            return false
        }
        moveX = clampAxis(moveX)
        moveZ = clampAxis(moveZ)
        var liquid = liquidActiveValues[slot]
        var crouched = crouchedValues[slot]
        var wasGrounded = groundedValues[slot]
        if (!liquid) {
            if (wasGrounded) {
                coyoteTicksValues[slot] = fpsMovementCoyoteTicks()
            } else if (coyoteTicksValues[slot] > 0) {
                coyoteTicksValues[slot] = coyoteTicksValues[slot] - 1
            }
            if (jumpBufferTicksValues[slot] > 0) {
                jumpBufferTicksValues[slot] = jumpBufferTicksValues[slot] - 1
            }
            if (jumpPressed) {
                jumpBufferTicksValues[slot] = fpsMovementJumpBufferTicks()
            }
            if (flapCooldownValues[slot] > 0) {
                flapCooldownValues[slot] = flapCooldownValues[slot] - 1
            }
        } else {
            coyoteTicksValues[slot] = 0
            jumpBufferTicksValues[slot] = 0
            flapCooldownValues[slot] = 0
        }
        lastDoubleJumpValue = false
        lastFlappedValue = false

        var baseSpeed = if (liquid)
            liquidHorizontalSpeeds[slot] else fpsMovementWalkSpeed()
        if (!liquid && crouched) {
            baseSpeed = fpsMovementCrouchSpeed()
        }
        var targetSpeed = baseSpeed + powerUpSpeedBonuses[slot]
        var acceleration = if (liquid)
            liquidHorizontalAccelerations[slot] else fpsMovementAirAcceleration()
        var braking = if (liquid)
            liquidHorizontalBrakings[slot] else fpsMovementAirBraking()
        if (!liquid && wasGrounded) {
            acceleration = fpsMovementGroundAcceleration()
            braking = fpsMovementGroundBraking()
        }
        if (moveX != 0 || moveZ != 0) {
            accelerateHorizontal(
                slot, moveX, moveZ, baseSpeed + powerUpSpeedBonuses[slot],
                acceleration)
        } else if (!liquid && wasGrounded) {
            applyHorizontalFriction(slot, braking)
        } else {
            velocityXValues[slot] = approach(
                velocityXValues[slot], 0, braking)
            velocityZValues[slot] = approach(
                velocityZValues[slot], 0, braking)
        }

        var jumped = false
        var coyoteJump = false
        if (liquid) {
            if (jumpPressed) {
                var swimImpulse = liquidSwimImpulses[slot] +
                    powerUpJumpBonuses[slot]
                velocityYValues[slot] = velocityYValues[slot] +
                    swimImpulse
                jumped = swimImpulse > 0
            }
        } else {
            if (jumpBufferTicksValues[slot] > 0 &&
                coyoteTicksValues[slot] > 0) {
                jumped = true
                coyoteJump = !wasGrounded
                jumpBufferTicksValues[slot] = 0
                coyoteTicksValues[slot] = 0
                groundedValues[slot] = false
                velocityYValues[slot] = fpsMovementJumpVelocity() +
                    powerUpJumpBonuses[slot]
                jumpCutArmedValues[slot] = true
                flapCooldownValues[slot] = fpsMovementFlapIntervalTicks()
            } else if (jumpBufferTicksValues[slot] > 0 &&
                !wasGrounded && coyoteTicksValues[slot] <= 0 &&
                airJumpValues[slot] < fpsMovementMaximumAirJumps()) {
                jumped = true
                airJumpValues[slot] = airJumpValues[slot] + 1
                jumpBufferTicksValues[slot] = 0
                groundedValues[slot] = false
                velocityYValues[slot] = fpsMovementJumpVelocity() +
                    powerUpJumpBonuses[slot]
                jumpCutArmedValues[slot] = true
                flapCooldownValues[slot] = fpsMovementFlapIntervalTicks()
                lastDoubleJumpValue = true
            }
            if (!wasGrounded && jumpHeld &&
                animalKinds[slot] == animalKindGoose() &&
                flapCooldownValues[slot] == 0) {
                velocityYValues[slot] = velocityYValues[slot] +
                    fpsMovementFlapImpulse()
                if (velocityYValues[slot] > fpsMovementJumpVelocity()) {
                    velocityYValues[slot] = fpsMovementJumpVelocity()
                }
                flapCooldownValues[slot] = fpsMovementFlapIntervalTicks()
                lastFlappedValue = true
            }
            if (jumpCutArmedValues[slot] && !jumpHeld &&
                velocityYValues[slot] > 0) {
                velocityYValues[slot] = velocityYValues[slot] *
                    fpsMovementJumpCutNumerator() /
                    fpsMovementJumpCutDenominator()
                jumpCutArmedValues[slot] = false
            }
        }
        if (liquid) {
            velocityYValues[slot] = velocityYValues[slot] +
                liquidBuoyancies[slot] - liquidGravities[slot]
            velocityYValues[slot] = velocityYValues[slot] *
                (liquidParameterScale() -
                    liquidVerticalDrags[slot]) / liquidParameterScale()
            if (velocityYValues[slot] < -liquidMaxFallSpeeds[slot]) {
                velocityYValues[slot] = -liquidMaxFallSpeeds[slot]
            }
            if (velocityYValues[slot] > liquidMaxRiseSpeeds[slot]) {
                velocityYValues[slot] = liquidMaxRiseSpeeds[slot]
            }
        } else if (!wasGrounded || jumped) {
            velocityYValues[slot] = velocityYValues[slot] - fpsMovementGravity()
            if (velocityYValues[slot] < -fpsMovementMaxFallSpeed()) {
                velocityYValues[slot] = -fpsMovementMaxFallSpeed()
            }
            if (glidingValues[slot] && !wasGrounded && jumpHeld &&
                velocityYValues[slot] < -fpsMovementGlideFallSpeed()) {
                velocityYValues[slot] = -fpsMovementGlideFallSpeed()
            }
        } else {
            velocityYValues[slot] = 0
        }

        var movement = capsuleValue.move(
            positionXValues[slot], positionYValues[slot], positionZValues[slot],
            positionXValues[slot] + velocityXValues[slot],
            positionYValues[slot] + velocityYValues[slot],
            positionZValues[slot] + velocityZValues[slot])
        if (!movement.accepted()) {
            lastActorValue = actorId
            lastAcceptedValue = false
            lastCollidedValue = false
            lastGroundedValue = groundedValues[slot]
            lastJumpedValue = jumped
            lastCoyoteJumpValue = coyoteJump
            lastBunnyHopValue = false
            lastLandedValue = false
            return false
        }
        positionXValues[slot] = movement.resolvedX()
        positionYValues[slot] = movement.resolvedY()
        positionZValues[slot] = movement.resolvedZ()
        var groundedNow = movement.grounded()
        if (liquid) { groundedNow = false }
        var landed = !wasGrounded && groundedNow
        var bunnyHop = false
        if (groundedNow) {
            coyoteTicksValues[slot] = fpsMovementCoyoteTicks()
            if (velocityYValues[slot] < 0) {
                velocityYValues[slot] = 0
            }
            if (landed &&
                (jumpHeld || jumpBufferTicksValues[slot] > 0)) {
                groundedNow = false
                bunnyHop = jumpHeld
                jumped = true
                airJumpValues[slot] = 0
                jumpBufferTicksValues[slot] = 0
                velocityYValues[slot] = fpsMovementJumpVelocity()
                jumpCutArmedValues[slot] = true
                flapCooldownValues[slot] = fpsMovementFlapIntervalTicks()
                coyoteTicksValues[slot] = 0
            } else {
                groundedValues[slot] = true
                airJumpValues[slot] = 0
                flapCooldownValues[slot] = 0
                jumpCutArmedValues[slot] = false
            }
        } else {
            groundedValues[slot] = false
        }
        lastActorValue = actorId
        lastAcceptedValue = true
        lastCollidedValue = movement.collided()
        lastGroundedValue = groundedValues[slot]
        lastJumpedValue = jumped
        lastCoyoteJumpValue = coyoteJump
        lastBunnyHopValue = bunnyHop
        lastLandedValue = landed
        return true
    }

    Int positionX(Int actorId) {
        var slot = slotFor(actorId)
        if (slot < 0 || !activeValues[slot]) { return 0 }
        return worldCoordinate(positionXValues[slot])
    }

    Int positionY(Int actorId) {
        var slot = slotFor(actorId)
        if (slot < 0 || !activeValues[slot]) { return 0 }
        return worldCoordinate(positionYValues[slot])
    }

    Int positionZ(Int actorId) {
        var slot = slotFor(actorId)
        if (slot < 0 || !activeValues[slot]) { return 0 }
        return worldCoordinate(positionZValues[slot])
    }

    Int velocityX(Int actorId) {
        var slot = slotFor(actorId)
        if (slot < 0 || !activeValues[slot]) { return 0 }
        return velocityXValues[slot]
    }

    Int velocityY(Int actorId) {
        var slot = slotFor(actorId)
        if (slot < 0 || !activeValues[slot]) { return 0 }
        return velocityYValues[slot]
    }

    Int velocityZ(Int actorId) {
        var slot = slotFor(actorId)
        if (slot < 0 || !activeValues[slot]) { return 0 }
        return velocityZValues[slot]
    }

    Bool grounded(Int actorId) {
        var slot = slotFor(actorId)
        return slot >= 0 && activeValues[slot] && groundedValues[slot]
    }
    Bool crouched(Int actorId) {
        var slot = slotFor(actorId)
        return slot >= 0 && activeValues[slot] && crouchedValues[slot]
    }

    Bool gliding(Int actorId) {
        var slot = slotFor(actorId)
        return slot >= 0 && activeValues[slot] && glidingValues[slot]
    }

    Int coyoteTicks(Int actorId) {
        var slot = slotFor(actorId)
        if (slot < 0 || !activeValues[slot]) { return 0 }
        return coyoteTicksValues[slot]
    }

    Int jumpBufferTicks(Int actorId) {
        var slot = slotFor(actorId)
        if (slot < 0 || !activeValues[slot]) { return 0 }
        return jumpBufferTicksValues[slot]
    }
    Int airJumpsUsed(Int actorId) {
        var slot = slotFor(actorId)
        if (slot < 0 || !activeValues[slot]) { return 0 }
        return airJumpValues[slot]
    }

    Bool lastAccepted() { return lastAcceptedValue }
    Bool lastCollided() { return lastCollidedValue }
    Bool lastGrounded() { return lastGroundedValue }
    Bool lastJumped() { return lastJumpedValue }
    Bool lastJumpedFor(Int actorId) {
        return lastActorValue == actorId && lastJumpedValue
    }
    Bool lastDoubleJump() { return lastDoubleJumpValue }
    Bool lastFlapped() { return lastFlappedValue }
    Bool lastCoyoteJump() { return lastCoyoteJumpValue }
    Bool lastBunnyHop() { return lastBunnyHopValue }
    Bool lastLanded() { return lastLandedValue }
    Int lastActor() { return lastActorValue }
    Int actorCount() {
        var count = 0
        for (var index = 0; index < actualCapacityValue; index = index + 1) {
            if (activeValues[index]) {
                count = count + 1
            }
        }
        return count
    }
}
