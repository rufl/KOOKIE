package session

import core

record EnemyAttackDecision(
    Bool accepted, Int enemyId, Int targetId, Int tick,
    Bool fired, Int shotId, Int applied, Bool died
)
record EnemyAuthoritySnapshot(
    Int sequence, Int tick, Int enemyId,
    Int state, Int targetId
)

class EnemySnapshotHistory {
    Int[] sequences
    Int[] ticks
    Int[] enemyIds
    Int[] states
    Int[] targets
    Int count
    EnemyAuthoritySnapshot latestValue

    public constructor(Int capacity) {
        var actualCapacity = capacity
        if (actualCapacity <= 0) {
            actualCapacity = 1
        }
        sequences = new Int[actualCapacity]
        ticks = new Int[actualCapacity]
        enemyIds = new Int[actualCapacity]
        states = new Int[actualCapacity]
        targets = new Int[actualCapacity]
        count = 0
        latestValue = EnemyAuthoritySnapshot(0, 0, 0, 0, 0)
        for (var index = 0; index < actualCapacity; index = index + 1) {
            sequences[index] = 0
            ticks[index] = 0
            enemyIds[index] = 0
            states[index] = 0
            targets[index] = 0
        }
    }

    Bool push(EnemyAuthoritySnapshot snapshot) {
        if (snapshot.sequence() <= 0 || snapshot.tick() < 0 ||
            snapshot.enemyId() <= 0 || snapshot.state() < 0 ||
            snapshot.targetId() < 0 ||
            (count > 0 && snapshot.sequence() <= sequences[count - 1])) {
            return false
        }
        if (count == sequences.length) {
            for (var index = 1; index < count; index = index + 1) {
                sequences[index - 1] = sequences[index]
                ticks[index - 1] = ticks[index]
                enemyIds[index - 1] = enemyIds[index]
                states[index - 1] = states[index]
                targets[index - 1] = targets[index]
            }
            count = count - 1
        }
        sequences[count] = snapshot.sequence()
        ticks[count] = snapshot.tick()
        enemyIds[count] = snapshot.enemyId()
        states[count] = snapshot.state()
        targets[count] = snapshot.targetId()
        count = count + 1
        latestValue = snapshot
        return true
    }

    Int size() {
        return count
    }

    Int latestSequence() {
        return latestValue.sequence()
    }

    EnemyAuthoritySnapshot latest() {
        return latestValue
    }
}

class AuthoritativeEnemySession {
    CombatWorld combat
    EnemyStateWorld enemies
    EnemySpatialWorld spatial
    EncounterDirector encounters
    Int[] linkedEnemyIds
    Int[] linkedEncounterIds
    Bool[] linkedActive

    public constructor(Int actorCapacity, Int encounterCapacity) {
        combat = CombatWorld(actorCapacity, actorCapacity)
        enemies = EnemyStateWorld(actorCapacity)
        spatial = EnemySpatialWorld(actorCapacity, 1000000)
        encounters = EncounterDirector(encounterCapacity)
        linkedEnemyIds = new Int[actorCapacity]
        linkedEncounterIds = new Int[actorCapacity]
        linkedActive = new Bool[actorCapacity]
        for (var index = 0; index < actorCapacity; index = index + 1) {
            linkedEnemyIds[index] = 0
            linkedEncounterIds[index] = 0
            linkedActive[index] = false
        }
    }

    Int findEnemyLink(Int enemyId) {
        for (var index = 0; index < linkedEnemyIds.length; index = index + 1) {
            if (linkedActive[index] && linkedEnemyIds[index] == enemyId) {
                return index
            }
        }
        return -1
    }

    Int freeEnemyLink() {
        for (var index = 0; index < linkedActive.length; index = index + 1) {
            if (!linkedActive[index]) {
                return index
            }
        }
        return -1
    }

    Bool configureEnemyRules(Int perceptionRange, Int attackRange, Int cooldown) {
        return enemies.configure(perceptionRange, attackRange, cooldown)
    }
    Bool configureSpatialBounds(
        Int minX, Int minY, Int minZ,
        Int maxX, Int maxY, Int maxZ
    ) {
        return spatial.configureBounds(minX, minY, minZ, maxX, maxY, maxZ)
    }

    Bool addSpatialObstacle(
        Int ax, Int ay, Int az,
        Int bx, Int by, Int bz,
        Int cx, Int cy, Int cz
    ) {
        return spatial.addObstacle(
            ax, ay, az, bx, by, bz, cx, cy, cz)
    }

    Bool setSpatialPosition(Int id, Int x, Int y, Int z) {
        return spatial.setPosition(id, x, y, z)
    }

    SpatialVisibilityResult spatialVisibility(
        Int sourceId, Int targetId, Int range
    ) {
        return spatial.visibility(sourceId, targetId, range)
    }

    EnemyMoveResult moveEnemyToward(Int enemyId, Int targetId, Int step) {
        return spatial.moveToward(enemyId, targetId, step)
    }


    Bool defineWeapon(
        Int id, Int magazineSize, Int reserveCapacity,
        Int cooldownTicks, Int damage, Int channel, Int range
    ) {
        return combat.defineWeapon(
            id, magazineSize, reserveCapacity,
            cooldownTicks, damage, channel, range)
    }

    Bool defineEncounter(Int id, Int maxActive, Int budget) {
        return encounters.define(id, maxActive, budget)
    }

    Bool addActor(Int id, Int health, Int armor) {
        return combat.addActor(id, health, armor)
    }

    Bool equipWeapon(Int actorId, Int weaponId) {
        return combat.equipWeapon(actorId, weaponId)
    }

    Bool admitEnemy(
        Int encounterId, Int enemyId, Int tick,
        Int health, Int armor, Int weaponId
    ) {
        var linkIndex = freeEnemyLink()
        if (linkIndex < 0) {
            return false
        }
        var admission = encounters.admit(encounterId, enemyId)
        if (!admission.accepted()) {
            return false
        }
        if (!combat.addActor(enemyId, health, armor)) {
            encounters.release(encounterId)
            return false
        }
        if (!enemies.addEnemy(enemyId, tick) ||
            !combat.equipWeapon(enemyId, weaponId)) {
            enemies.removeEnemy(enemyId)
            combat.removeActor(enemyId)
            encounters.release(encounterId)
            return false
        }
        linkedEnemyIds[linkIndex] = enemyId
        linkedEncounterIds[linkIndex] = encounterId
        linkedActive[linkIndex] = true
        return true
    }

    EnemyAttackDecision stepEnemy(
        Int enemyId, Int tick, Int targetId,
        Bool targetVisible, Int distance, Int critical
    ) {
        var step = enemies.step(
            enemyId, tick, targetId, targetVisible, distance)
        if (!step.accepted()) {
            return EnemyAttackDecision(false, enemyId, targetId, tick, false, 0, 0, false)
        }
        if (!step.attackReady()) {
            return EnemyAttackDecision(true, enemyId, step.targetId(), tick, false, 0, 0, false)
        }
        var resolution = combat.resolveHitscan(
            enemyId, step.targetId(), tick, distance, critical)
        return EnemyAttackDecision(
            true, enemyId, step.targetId(), tick, resolution.accepted(),
            resolution.actionId(), resolution.applied(), resolution.died())
    }
    EnemyAttackDecision stepEnemySpatial(
        Int enemyId, Int tick, Int targetId, Int critical
    ) {
        var visibility = spatial.visibility(
            enemyId, targetId, enemies.perceptionRangeValue())
        if (!visibility.accepted()) {
            return EnemyAttackDecision(false, enemyId, targetId, tick, false, 0, 0, false)
        }
        if (!visibility.visible()) {
            spatial.moveToward(enemyId, targetId, 1)
        }
        return stepEnemy(
            enemyId, tick, targetId,
            visibility.visible(), visibility.distance(), critical)
    }


    Int consumeCombatEvents(Int tick) {
        var consumed = 0
        while (combat.pendingCombatEvents() > 0) {
            if (!combat.dequeueCombatEvent()) {
                break
            }
            var event = combat.lastCombatEvent()
            var linkIndex = findEnemyLink(event.targetId())
            if (event.died() && linkIndex >= 0) {
                var enemyId = linkedEnemyIds[linkIndex]
                if (enemies.kill(enemyId, tick)) {
                    encounters.release(linkedEncounterIds[linkIndex])
                    linkedActive[linkIndex] = false
                    consumed = consumed + 1
                }
            }
        }
        return consumed
    }

    ResolutionResult playerHitscan(
        Int sourceId, Int targetId, Int tick, Int distance, Int critical
    ) {
        var result = combat.resolveHitscan(
            sourceId, targetId, tick, distance, critical)
        if (result.accepted()) {
            consumeCombatEvents(tick)
        }
        return result
    }

    Int enemyTarget(Int enemyId) {
        return enemies.target(enemyId)
    }
    ResolutionResult projectileAttackSpatial(
        Int sourceId, Int targetId, Int tick, Int range, Int critical
    ) {
        var visibility = spatial.visibility(sourceId, targetId, range)
        if (!visibility.accepted() || !visibility.visible()) {
            return ResolutionResult(false, 0, sourceId, targetId, 0, 0, false, 0)
        }
        var projectile = combat.spawnProjectile(sourceId, tick)
        if (!projectile.accepted()) {
            return ResolutionResult(false, 0, sourceId, targetId, 0, 0, false, 0)
        }
        var result = combat.resolveProjectile(
            projectile.projectileId(), targetId, visibility.distance(), critical)
        if (result.accepted()) {
            consumeCombatEvents(tick)
        }
        return result
    }


    EnemyAuthoritySnapshot snapshotEnemy(
        Int enemyId, Int tick, Int sequence
    ) {
        return EnemyAuthoritySnapshot(
            sequence, tick, enemyId,
            enemies.state(enemyId), enemies.target(enemyId))
    }

    Int enemyState(Int enemyId) {
        return enemies.state(enemyId)
    }

    Int encounterActiveCount(Int encounterId) {
        return encounters.activeCount(encounterId)
    }

    Int pendingCombatEvents() {
        return combat.pendingCombatEvents()
    }
}
