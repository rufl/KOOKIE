package session
import core


Int[] newEnvelope(Int protocol, Int kind, Int tick, Int sequence) {
    var words = new Int[5]
    words[0] = protocol
    words[1] = kind
    words[2] = tick
    words[3] = sequence
    words[4] = 0
    return words
}

Bool validEnvelope(Int[] words) {
    return words.length == 5 && words[0] == 1 && words[1] >= 0 && words[2] >= 0 && words[3] >= 0
}

Int broadPhaseSnapshotKind() {
    return 2
}

Int maximumSessionTransportWords() {
    return 1740
}

Int maximumSessionTransportTriangles() {
    return 192
}

Int[] newBroadPhaseSnapshot(
    Int protocol, Int tick, Int sequence, Int geometryRevision,
    BoundedTriangleCollection collection
) {
    var triangleCount = collection.triangleCount()
    var words = new Int[12 + triangleCount * 9]
    words[0] = protocol
    words[1] = broadPhaseSnapshotKind()
    words[2] = tick
    words[3] = sequence
    words[4] = geometryRevision
    words[5] = triangleCount
    words[6] = collection.minimumX()
    words[7] = collection.minimumY()
    words[8] = collection.minimumZ()
    words[9] = collection.maximumX()
    words[10] = collection.maximumY()
    words[11] = collection.maximumZ()
    for (var ordinal = 0; ordinal < triangleCount; ordinal = ordinal + 1) {
        var index = collection.triangleIndexAt(ordinal)
        var offset = 12 + ordinal * 9
        for (var component = 0; component < 9; component = component + 1) {
            words[offset + component] = collection.triangleCoordinate(index, component)
        }
    }
    return words
}

Bool validBroadPhaseSnapshot(Int[] words) {
    return words.length >= 12 &&
        words.length <= maximumSessionTransportWords() &&
        words[0] == protocolVersion() &&
        words[1] == broadPhaseSnapshotKind() &&
        words[2] >= 0 && words[3] >= 0 && words[4] > 0 &&
        words[5] >= 0 && words[5] <= maximumSessionTransportTriangles() &&
        words[6] <= words[9] &&
        words[7] <= words[10] && words[8] <= words[11] &&
        words.length == 12 + words[5] * 9
}

Int broadPhaseSnapshotRevision(Int[] words) {
    if (!validBroadPhaseSnapshot(words)) {
        return -1
    }
    return words[4]
}

Int broadPhaseSnapshotTriangleCount(Int[] words) {
    if (!validBroadPhaseSnapshot(words)) {
        return -1
    }
    return words[5]
}

Bool broadPhaseSnapshotMatches(Int[] words, Int geometryRevision) {
    return validBroadPhaseSnapshot(words) &&
        words[4] == geometryRevision
}

Int gameplayCommandMessageKind() {
    return 3
}

Int gameplayStateMessageKind() {
    return 4
}
Int gameplayInputBundleMessageKind() {
    return netcodeInputBundleKind()
}

Int gameplayInputAckMessageKind() {
    return netcodeInputAckKind()
}

Int[] newGameplayInputBundleMessage(
    Int player, Int generation, Int snapshotAck, Int[] commandWords
) {
    if (player < 1 || player > 2 || generation <= 0 ||
        generation > 1000000 || snapshotAck < 0 || snapshotAck > 1000000 ||
        commandWords.length <= 0 ||
        commandWords.length > netcodeMaximumInputHistory() * 6 ||
        commandWords.length % 6 != 0) {
        return new Int[0]
    }
    var commandCount = commandWords.length / 6
    var words = new Int[9 + commandWords.length]
    words[0] = protocolVersion()
    words[1] = gameplayInputBundleMessageKind()
    words[2] = player
    words[3] = generation
    words[4] = snapshotAck
    words[5] = commandCount
    words[6] = commandWords[0]
    words[7] = commandWords[1]
    for (var index = 0; index < commandWords.length; index = index + 1) {
        words[8 + index] = commandWords[index]
    }
    words[words.length - 1] =
        gameplayMessageChecksum(words, words.length - 1)
    return words
}

Bool validGameplayInputBundleMessage(Int[] words) {
    if (words.length < 15 ||
        words.length > maximumSessionTransportWords() ||
        words[0] != protocolVersion() ||
        words[1] != gameplayInputBundleMessageKind() ||
        words[2] < 1 || words[2] > 2 ||
        words[3] <= 0 || words[3] > 1000000 ||
        words[4] < 0 || words[4] > 1000000 ||
        words[5] < 1 || words[5] > netcodeMaximumInputHistory() ||
        words.length != 9 + words[5] * 6 ||
        words[6] != words[8] || words[7] != words[9] ||
        words[words.length - 1] !=
            gameplayMessageChecksum(words, words.length - 1)) {
        return false
    }
    var previousTick = 0
    var previousSequence = 0
    for (var index = 0; index < words[5]; index = index + 1) {
        var offset = 8 + index * 6
        var tick = words[offset]
        var sequence = words[offset + 1]
        var moveX = words[offset + 2]
        var moveZ = words[offset + 3]
        var fire = words[offset + 4]
        var jump = words[offset + 5]
        if (tick <= 0 || tick > 1000000 ||
            sequence <= 0 || sequence > 1000000 ||
            (index > 0 &&
                (tick <= previousTick || sequence <= previousSequence)) ||
            moveX < -4 || moveX > 4 ||
            moveZ < -4 || moveZ > 4 ||
            (fire != 0 && fire != 1) ||
            (jump != 0 && jump != 1)) {
            return false
        }
        previousTick = tick
        previousSequence = sequence
    }
    return true
}

Int gameplayInputBundlePlayer(Int[] words) {
    if (!validGameplayInputBundleMessage(words)) { return 0 }
    return words[2]
}

Int gameplayInputBundleGeneration(Int[] words) {
    if (!validGameplayInputBundleMessage(words)) { return 0 }
    return words[3]
}

Int gameplayInputBundleSnapshotAck(Int[] words) {
    if (!validGameplayInputBundleMessage(words)) { return -1 }
    return words[4]
}

Int gameplayInputBundleCount(Int[] words) {
    if (!validGameplayInputBundleMessage(words)) { return 0 }
    return words[5]
}

Int gameplayInputBundleValue(Int[] words, Int index, Int field) {
    if (!validGameplayInputBundleMessage(words) ||
        index < 0 || index >= words[5] || field < 0 || field > 5) {
        return 0
    }
    return words[8 + index * 6 + field]
}


Int[] newGameplayInputAckMessage(
    Int tick, Int inputSequence, Int snapshotSequence
) {
    if (tick < 0 || tick > 1000000 ||
        inputSequence < 0 || inputSequence > 1000000 ||
        snapshotSequence < 0 || snapshotSequence > 1000000) {
        return new Int[0]
    }
    var words = new Int[6]
    words[0] = protocolVersion()
    words[1] = gameplayInputAckMessageKind()
    words[2] = tick
    words[3] = inputSequence
    words[4] = snapshotSequence
    words[5] = gameplayMessageChecksum(words, 5)
    return words
}

Bool validGameplayInputAckMessage(Int[] words) {
    return words.length == 6 &&
        words[0] == protocolVersion() &&
        words[1] == gameplayInputAckMessageKind() &&
        words[2] >= 0 && words[2] <= 1000000 &&
        words[3] >= 0 && words[3] <= 1000000 &&
        words[4] >= 0 && words[4] <= 1000000 &&
        words[5] == gameplayMessageChecksum(words, 5)
}

Int gameplayInputAckSequence(Int[] words) {
    if (!validGameplayInputAckMessage(words)) { return -1 }
    return words[3]
}

Int gameplayInputAckSnapshotSequence(Int[] words) {
    if (!validGameplayInputAckMessage(words)) { return -1 }
    return words[4]
}


