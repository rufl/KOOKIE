package session
import core


Int[] newEnvelope(Int protocol, Int kind, Int tick, Int sequence) {
    var words = new Int[5]
    words[0] = protocol
    words[1] = kind
    words[2] = tick
    words[3] = sequence
    words[4] = 0
    return words
}

Bool validEnvelope(Int[] words) {
    return words.length == 5 && words[0] == 1 && words[1] >= 0 && words[2] >= 0 && words[3] >= 0
}

Int broadPhaseSnapshotKind() {
    return 2
}

Int maximumSessionTransportWords() {
    return 300
}

Int maximumSessionTransportTriangles() {
    return 32
}

Int[] newBroadPhaseSnapshot(
    Int protocol, Int tick, Int sequence, Int geometryRevision,
    BoundedTriangleCollection collection
) {
    var triangleCount = collection.triangleCount()
    var words = new Int[12 + triangleCount * 9]
    words[0] = protocol
    words[1] = broadPhaseSnapshotKind()
    words[2] = tick
    words[3] = sequence
    words[4] = geometryRevision
    words[5] = triangleCount
    words[6] = collection.minimumX()
    words[7] = collection.minimumY()
    words[8] = collection.minimumZ()
    words[9] = collection.maximumX()
    words[10] = collection.maximumY()
    words[11] = collection.maximumZ()
    for (var ordinal = 0; ordinal < triangleCount; ordinal = ordinal + 1) {
        var index = collection.triangleIndexAt(ordinal)
        var offset = 12 + ordinal * 9
        for (var component = 0; component < 9; component = component + 1) {
            words[offset + component] = collection.triangleCoordinate(index, component)
        }
    }
    return words
}

Bool validBroadPhaseSnapshot(Int[] words) {
    return words.length >= 12 &&
        words.length <= maximumSessionTransportWords() &&
        words[0] == protocolVersion() &&
        words[1] == broadPhaseSnapshotKind() &&
        words[2] >= 0 && words[3] >= 0 && words[4] > 0 &&
        words[5] >= 0 && words[5] <= maximumSessionTransportTriangles() &&
        words[6] <= words[9] &&
        words[7] <= words[10] && words[8] <= words[11] &&
        words.length == 12 + words[5] * 9
}

Int broadPhaseSnapshotRevision(Int[] words) {
    if (!validBroadPhaseSnapshot(words)) {
        return -1
    }
    return words[4]
}

Int broadPhaseSnapshotTriangleCount(Int[] words) {
    if (!validBroadPhaseSnapshot(words)) {
        return -1
    }
    return words[5]
}

Bool broadPhaseSnapshotMatches(Int[] words, Int geometryRevision) {
    return validBroadPhaseSnapshot(words) &&
        words[4] == geometryRevision
}

Int gameplayCommandMessageKind() {
    return 3
}

Int gameplayStateMessageKind() {
    return 4
}

Int gameplayMoveAction() {
    return 1
}

Int gameplayFireAction() {
    return 2
}

Int gameplayInteractAction() {
    return 3
}

Int gameplayDisconnectAction() {
    return 4
}

Int gameplayReconnectAction() {
    return 5
}

Int gameplayMoveDiagnostic() {
    return 1
}

Int gameplayFireDiagnostic() {
    return 2
}

Int gameplayInteractionDiagnostic() {
    return 3
}

Int gameplayDisconnectDiagnostic() {
    return 4
}

Int gameplayReconnectDiagnostic() {
    return 5
}

Int gameplayStaleDiagnostic() {
    return 6
}

Int gameplayRejectedDiagnostic() {
    return 7
}

Int gameplayMessageChecksum(Int[] words, Int length) {
    if (length < 1 || length > words.length) {
        return -1
    }
    var checksum = 0
    for (var index = 0; index < length; index = index + 1) {
        checksum = checksum + words[index] * (index + 1)
    }
    return checksum
}

Int[] newGameplayCommandMessage(
    Int player, Int tick, Int sequence, Int action,
    Int valueOne, Int valueTwo, Int valueThree, Int valueFour
) {
    var words = new Int[11]
    words[0] = protocolVersion()
    words[1] = gameplayCommandMessageKind()
    words[2] = tick
    words[3] = sequence
    words[4] = player
    words[5] = action
    words[6] = valueOne
    words[7] = valueTwo
    words[8] = valueThree
    words[9] = valueFour
    words[10] = gameplayMessageChecksum(words, 10)
    return words
}

Bool validGameplayCommandMessage(Int[] words) {
    if (words.length != 11 ||
        words[0] != protocolVersion() ||
        words[1] != gameplayCommandMessageKind() ||
        words[2] <= 0 || words[2] > 1000000 ||
        words[3] <= 0 || words[3] > 1000000 ||
        words[4] < 1 || words[4] > 2 ||
        words[5] < gameplayMoveAction() ||
        words[5] > gameplayReconnectAction() ||
        words[10] != gameplayMessageChecksum(words, 10)) {
        return false
    }
    var action = words[5]
    if (action == gameplayMoveAction()) {
        return words[6] >= -4 && words[6] <= 4 &&
            words[7] == 0 && words[8] == 0 && words[9] == 0
    }
    if (action == gameplayFireAction()) {
        return words[6] > 0 && words[6] <= 1000000 &&
            words[7] >= 0 && words[7] <= 1000000 &&
            words[8] >= 0 && words[8] <= 1 && words[9] == 0
    }
    if (action == gameplayInteractAction()) {
        return words[6] > 0 && words[6] <= 1000000 &&
            words[7] == 0 && words[8] == 0 && words[9] == 0
    }
    if (action == gameplayDisconnectAction()) {
        return words[6] >= 1 && words[6] <= 4 &&
            words[7] == 0 && words[8] == 0 && words[9] == 0
    }
    return words[6] == 0 && words[7] == 0 &&
        words[8] == 0 && words[9] == 0
}

Int gameplayCommandTick(Int[] words) {
    if (!validGameplayCommandMessage(words)) {
        return 0
    }
    return words[2]
}

Int gameplayCommandSequence(Int[] words) {
    if (!validGameplayCommandMessage(words)) {
        return 0
    }
    return words[3]
}

Int gameplayCommandPlayer(Int[] words) {
    if (!validGameplayCommandMessage(words)) {
        return 0
    }
    return words[4]
}

Int gameplayCommandAction(Int[] words) {
    if (!validGameplayCommandMessage(words)) {
        return 0
    }
    return words[5]
}

Int gameplayCommandValue(Int[] words, Int index) {
    if (!validGameplayCommandMessage(words) || index < 0 || index > 3) {
        return 0
    }
    return words[6 + index]
}

Int[] newGameplayStateMessage(
    Int tick, Int sequence, Bool accepted,
    Int interactionRevision, Int combatActorId, Int combatHealth
) {
    var words = new Int[19]
    words[0] = protocolVersion()
    words[1] = gameplayStateMessageKind()
    words[2] = tick
    words[3] = sequence
    words[4] = 0
    if (accepted) {
        words[4] = 1
    }
    words[5] = interactionRevision
    words[6] = combatActorId
    words[7] = combatHealth
    return words
}

Bool setGameplayStateProgression(
    Int[] words, Int secretCount, Bool levelCompleted, Int interactionMask
) {
    if (words.length != 19 || secretCount < 0 || secretCount > 64 ||
        interactionMask < 0 || interactionMask > 65535) {
        return false
    }
    words[8] = secretCount
    words[9] = 0
    if (levelCompleted) {
        words[9] = 1
    }
    words[17] = interactionMask
    return true
}

Bool setGameplayStateReplication(
    Int[] words, Int playerOnePosition, Int playerTwoPosition, Int currency
) {
    if (words.length != 19 ||
        playerOnePosition < -1000000 || playerOnePosition > 1000000 ||
        playerTwoPosition < -1000000 || playerTwoPosition > 1000000 ||
        currency < 0 || currency > 1000000) {
        return false
    }
    words[10] = playerOnePosition
    words[11] = playerTwoPosition
    words[12] = currency
    return true
}

Bool setGameplayStateConnection(
    Int[] words, Bool connected, Int generation,
    Int disconnectReason, Int diagnostic
) {
    if (words.length != 19 || generation <= 0 || generation > 1000000 ||
        disconnectReason < 0 || disconnectReason > 4 ||
        diagnostic < gameplayMoveDiagnostic() ||
        diagnostic > gameplayRejectedDiagnostic() ||
        (connected && disconnectReason != 0) ||
        (!connected && disconnectReason == 0)) {
        return false
    }
    words[13] = 0
    if (connected) {
        words[13] = 1
    }
    words[14] = generation
    words[15] = disconnectReason
    words[16] = diagnostic
    return true
}

Bool validGameplayStateFields(Int[] words) {
    return words.length == 19 &&
        words[0] == protocolVersion() &&
        words[1] == gameplayStateMessageKind() &&
        words[2] > 0 && words[2] <= 1000000 &&
        words[3] > 0 && words[3] <= 1000000 &&
        words[4] >= 0 && words[4] <= 1 &&
        words[5] >= 0 && words[5] <= 1000000 &&
        words[6] > 0 && words[6] <= 1000000 &&
        words[7] >= 0 && words[7] <= 1000000 &&
        words[8] >= 0 && words[8] <= 64 &&
        words[9] >= 0 && words[9] <= 1 &&
        words[10] >= -1000000 && words[10] <= 1000000 &&
        words[11] >= -1000000 && words[11] <= 1000000 &&
        words[12] >= 0 && words[12] <= 1000000 &&
        words[13] >= 0 && words[13] <= 1 &&
        words[14] > 0 && words[14] <= 1000000 &&
        words[15] >= 0 && words[15] <= 4 &&
        words[16] >= gameplayMoveDiagnostic() &&
        words[16] <= gameplayRejectedDiagnostic() &&
        words[17] >= 0 && words[17] <= 65535 &&
        ((words[13] == 1 && words[15] == 0) ||
            (words[13] == 0 && words[15] > 0))
}

Bool sealGameplayStateMessage(Int[] words) {
    if (!validGameplayStateFields(words)) {
        return false
    }
    words[18] = gameplayMessageChecksum(words, 18)
    return true
}

Bool validGameplayStateMessage(Int[] words) {
    return validGameplayStateFields(words) &&
        words[18] == gameplayMessageChecksum(words, 18)
}

Bool gameplayStateAccepted(Int[] words) {
    return validGameplayStateMessage(words) && words[4] == 1
}

Int gameplayStateInteractionRevision(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[5]
}

Int gameplayStateCombatActor(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[6]
}

Int gameplayStateCombatHealth(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[7]
}

Int gameplayStateSecretCount(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[8]
}

Bool gameplayStateLevelCompleted(Int[] words) {
    return validGameplayStateMessage(words) && words[9] == 1
}

Int gameplayStatePlayerPosition(Int[] words, Int player) {
    if (!validGameplayStateMessage(words) || player < 1 || player > 2) {
        return -1000001
    }
    return words[9 + player]
}

Int gameplayStateCurrency(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[12]
}

Bool gameplayStateConnected(Int[] words) {
    return validGameplayStateMessage(words) && words[13] == 1
}

Int gameplayStateConnectionGeneration(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[14]
}

Int gameplayStateDisconnectReason(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[15]
}

Int gameplayStateDiagnostic(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[16]
}

Int gameplayStateInteractionMask(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[17]
}

Int enemyEncounterStateMessageKind() {
    return 5
}

Int maximumEnemyEncounterStateEnemies() {
    return 32
}

Int enemyEncounterStateEntryWidth() {
    return 7
}

Int enemyEncounterStateEntriesOffset() {
    return 19
}

Bool validEnemyEncounterStateShape(Int[] words) {
    if (words.length < 20 ||
        words[0] != protocolVersion() ||
        words[1] != enemyEncounterStateMessageKind() ||
        words[2] <= 0 || words[2] > 1000000 ||
        words[3] <= 0 || words[3] > 1000000 ||
        words[4] <= 0 || words[4] > 1000000 ||
        words[5] < 0 ||
        words[7] < 0 ||
        words[7] > maximumEnemyEncounterStateEnemies() ||
        words[5] > words[7] ||
        words[6] < 0 || words[6] > 1000000) {
        return false
    }
    return words.length == 20 +
        words[7] * enemyEncounterStateEntryWidth()
}

Int[] newEnemyEncounterStateMessage(
    Int tick, Int sequence, Int encounterId,
    Int activeCount, Int remainingBudget, Int enemyCount
) {
    if (tick <= 0 || tick > 1000000 ||
        sequence <= 0 || sequence > 1000000 ||
        encounterId <= 0 || encounterId > 1000000 ||
        enemyCount < 0 ||
        enemyCount > maximumEnemyEncounterStateEnemies() ||
        activeCount < 0 || activeCount > enemyCount ||
        remainingBudget < 0 || remainingBudget > 1000000) {
        return new Int[0]
    }
    var words = new Int[
        20 + enemyCount * enemyEncounterStateEntryWidth()]
    words[0] = protocolVersion()
    words[1] = enemyEncounterStateMessageKind()
    words[2] = tick
    words[3] = sequence
    words[4] = encounterId
    words[5] = activeCount
    words[6] = remainingBudget
    words[7] = enemyCount
    return words
}

Bool setEnemyEncounterStateImpact(
    Int[] words, Int sequence, Int kind,
    Int sourceId, Int targetId,
    Int x, Int y, Int z, Int applied, Bool died,
    Int clip, Int gain
) {
    if (!validEnemyEncounterStateShape(words) ||
        sequence <= 0 || sequence > 1000000 ||
        kind <= 0 || kind > 3 ||
        sourceId <= 0 || sourceId > 1000000 ||
        targetId < 0 || targetId > 1000000 ||
        x < -1000000 || x > 1000000 ||
        y < -1000000 || y > 1000000 ||
        z < -1000000 || z > 1000000 ||
        applied < 0 || applied > 1000000 ||
        clip <= 0 || clip > 1000000 ||
        gain < 0 || gain > 100) {
        return false
    }
    words[8] = sequence
    words[9] = kind
    words[10] = sourceId
    words[11] = targetId
    words[12] = x
    words[13] = y
    words[14] = z
    words[15] = applied
    words[16] = 0
    if (died) {
        words[16] = 1
    }
    words[17] = clip
    words[18] = gain
    return true
}

Bool setEnemyEncounterStateEntry(
    Int[] words, Int index,
    Int enemyId, Int state, Int targetId, Int health,
    Int x, Int y, Int z
) {
    if (!validEnemyEncounterStateShape(words) ||
        index < 0 || index >= words[7] ||
        enemyId <= 0 || enemyId > 1000000 ||
        state < 0 || state > 7 ||
        targetId < 0 || targetId > 1000000 ||
        health < 0 || health > 1000000 ||
        ((state == 7 && health != 0) ||
            (state != 7 && health == 0)) ||
        x < -1000000 || x > 1000000 ||
        y < -1000000 || y > 1000000 ||
        z < -1000000 || z > 1000000) {
        return false
    }
    var offset = enemyEncounterStateEntriesOffset() +
        index * enemyEncounterStateEntryWidth()
    for (var other = 0; other < words[7]; other = other + 1) {
        var otherOffset = enemyEncounterStateEntriesOffset() +
            other * enemyEncounterStateEntryWidth()
        if (other != index && words[otherOffset] == enemyId) {
            return false
        }
    }
    words[offset] = enemyId
    words[offset + 1] = state
    words[offset + 2] = targetId
    words[offset + 3] = health
    words[offset + 4] = x
    words[offset + 5] = y
    words[offset + 6] = z
    return true
}

Bool validEnemyEncounterStateFields(Int[] words) {
    if (!validEnemyEncounterStateShape(words)) {
        return false
    }
    if (words[8] == 0) {
        for (var index = 9; index <= 18; index = index + 1) {
            if (words[index] != 0) {
                return false
            }
        }
    } else if (words[8] < 0 || words[8] > 1000000 ||
        words[9] <= 0 || words[9] > 3 ||
        words[10] <= 0 || words[10] > 1000000 ||
        words[11] < 0 || words[11] > 1000000 ||
        words[12] < -1000000 || words[12] > 1000000 ||
        words[13] < -1000000 || words[13] > 1000000 ||
        words[14] < -1000000 || words[14] > 1000000 ||
        words[15] < 0 || words[15] > 1000000 ||
        words[16] < 0 || words[16] > 1 ||
        words[17] <= 0 || words[17] > 1000000 ||
        words[18] < 0 || words[18] > 100) {
        return false
    }
    var activeEntries = 0
    for (var index = 0; index < words[7]; index = index + 1) {
        var offset = enemyEncounterStateEntriesOffset() +
            index * enemyEncounterStateEntryWidth()
        var enemyId = words[offset]
        var state = words[offset + 1]
        var health = words[offset + 3]
        if (enemyId <= 0 || enemyId > 1000000 ||
            state < 0 || state > 7 ||
            words[offset + 2] < 0 ||
            words[offset + 2] > 1000000 ||
            health < 0 || health > 1000000 ||
            ((state == 7 && health != 0) ||
                (state != 7 && health == 0)) ||
            words[offset + 4] < -1000000 ||
            words[offset + 4] > 1000000 ||
            words[offset + 5] < -1000000 ||
            words[offset + 5] > 1000000 ||
            words[offset + 6] < -1000000 ||
            words[offset + 6] > 1000000) {
            return false
        }
        if (state != 7) {
            activeEntries = activeEntries + 1
        }
        for (var other = index + 1;
            other < words[7];
            other = other + 1) {
            var otherOffset = enemyEncounterStateEntriesOffset() +
                other * enemyEncounterStateEntryWidth()
            if (words[otherOffset] == enemyId) {
                return false
            }
        }
    }
    return activeEntries == words[5]
}

Bool sealEnemyEncounterStateMessage(Int[] words) {
    if (!validEnemyEncounterStateFields(words)) {
        return false
    }
    words[words.length - 1] =
        gameplayMessageChecksum(words, words.length - 1)
    return true
}

Bool validEnemyEncounterStateMessage(Int[] words) {
    return validEnemyEncounterStateFields(words) &&
        words[words.length - 1] ==
            gameplayMessageChecksum(words, words.length - 1)
}

Int enemyEncounterStateSequence(Int[] words) {
    if (!validEnemyEncounterStateMessage(words)) {
        return 0
    }
    return words[3]
}

Int enemyEncounterStateEncounterId(Int[] words) {
    if (!validEnemyEncounterStateMessage(words)) {
        return 0
    }
    return words[4]
}

Int enemyEncounterStateActiveCount(Int[] words) {
    if (!validEnemyEncounterStateMessage(words)) {
        return -1
    }
    return words[5]
}

Int enemyEncounterStateRemainingBudget(Int[] words) {
    if (!validEnemyEncounterStateMessage(words)) {
        return -1
    }
    return words[6]
}

Int enemyEncounterStateEnemyCount(Int[] words) {
    if (!validEnemyEncounterStateMessage(words)) {
        return -1
    }
    return words[7]
}

ImpactPresentationEvent enemyEncounterStateImpact(Int[] words) {
    if (!validEnemyEncounterStateMessage(words) || words[8] == 0) {
        return ImpactPresentationEvent(
            0, 0, 0, 0, 0, 0, 0, 0, false, 0, 0)
    }
    return ImpactPresentationEvent(
        words[8], words[9], words[10], words[11],
        words[12], words[13], words[14], words[15],
        words[16] == 1, words[17], words[18])
}

Int enemyEncounterStateEnemyValue(
    Int[] words, Int index, Int component
) {
    if (!validEnemyEncounterStateMessage(words) ||
        index < 0 || index >= words[7] ||
        component < 0 || component >= enemyEncounterStateEntryWidth()) {
        return 0
    }
    return words[
        enemyEncounterStateEntriesOffset() +
        index * enemyEncounterStateEntryWidth() + component]
}

Int enemyEncounterStateEnemyId(Int[] words, Int index) {
    return enemyEncounterStateEnemyValue(words, index, 0)
}

Int enemyEncounterStateEnemyState(Int[] words, Int index) {
    return enemyEncounterStateEnemyValue(words, index, 1)
}

Int enemyEncounterStateEnemyTarget(Int[] words, Int index) {
    return enemyEncounterStateEnemyValue(words, index, 2)
}

Int enemyEncounterStateEnemyHealth(Int[] words, Int index) {
    return enemyEncounterStateEnemyValue(words, index, 3)
}

Int enemyEncounterStateEnemyPositionX(Int[] words, Int index) {
    return enemyEncounterStateEnemyValue(words, index, 4)
}

Int enemyEncounterStateEnemyPositionY(Int[] words, Int index) {
    return enemyEncounterStateEnemyValue(words, index, 5)
}

Int enemyEncounterStateEnemyPositionZ(Int[] words, Int index) {
    return enemyEncounterStateEnemyValue(words, index, 6)
}

Int envelopeSequence(Int[] words) {
    return words[3]
}

Bool roundTripEnvelope(Int protocol, Int kind, Int tick, Int sequence) {
    var encoded = newEnvelope(protocol, kind, tick, sequence)
    return validEnvelope(encoded) && envelopeSequence(encoded) == sequence
}

class BroadPhaseTransportQueue {
    Int packetCapacityValue
    Int maxPacketWordsValue
    Int[] packetLengths
    Int[] packetWords
    Int head
    Int tail
    Int queued

    public constructor(Int nextPacketCapacity, Int nextTriangleCapacity) {
        packetCapacityValue = nextPacketCapacity
        if (packetCapacityValue <= 0) {
            packetCapacityValue = 1
        }
        var triangleCapacity = nextTriangleCapacity
        if (triangleCapacity <= 0) {
            triangleCapacity = 1
        }
        if (triangleCapacity > maximumSessionTransportTriangles()) {
            triangleCapacity = maximumSessionTransportTriangles()
        }
        maxPacketWordsValue = 12 + triangleCapacity * 9
        packetLengths = new Int[packetCapacityValue]
        packetWords = new Int[packetCapacityValue * maxPacketWordsValue]
        head = 0
        tail = 0
        queued = 0
    }

    Bool send(Int[] words) {
        if (!validBroadPhaseSnapshot(words) ||
            words.length > maxPacketWordsValue ||
            queued == packetCapacityValue) {
            return false
        }
        var offset = tail * maxPacketWordsValue
        for (var index = 0; index < words.length; index = index + 1) {
            packetWords[offset + index] = words[index]
        }
        packetLengths[tail] = words.length
        tail = tail + 1
        if (tail == packetCapacityValue) {
            tail = 0
        }
        queued = queued + 1
        return true
    }

    Int pending() {
        return queued
    }

    Int capacity() {
        return packetCapacityValue
    }

    Int[] receive() {
        if (queued == 0) {
            return new Int[0]
        }
        var length = packetLengths[head]
        var offset = head * maxPacketWordsValue
        var words = new Int[length]
        for (var index = 0; index < length; index = index + 1) {
            words[index] = packetWords[offset + index]
        }
        head = head + 1
        if (head == packetCapacityValue) {
            head = 0
        }
        queued = queued - 1
        return words
    }
}
