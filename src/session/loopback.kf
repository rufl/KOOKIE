    return words
}


Bool validGameplayCommandMessage(Int[] words) {
    if (words.length != 11 ||
        words[0] != protocolVersion() ||
        words[1] != gameplayCommandMessageKind() ||
        words[2] <= 0 || words[2] > 1000000 ||
        words[3] <= 0 || words[3] > 1000000 ||
        words[4] < 1 || words[4] > 2 ||
        words[5] < gameplayMoveAction() ||
        words[5] > gameplayProgressionAction() ||
        words[9] <= 0 || words[9] > 1000000 ||
        words[10] != gameplayMessageChecksum(words, 10)) {
        return false
    }
    var action = words[5]
    if (action == gameplayMoveAction()) {
        return words[6] >= -4 && words[6] <= 4 &&
            words[7] == 0 && words[8] == 0
    }
    if (action == gameplayFireAction()) {
        return words[6] > 0 && words[6] <= 1000000 &&
            words[7] >= 0 && words[7] <= 1000000 &&
            words[8] >= 0 && words[8] <= 1
    }
    if (action == gameplayInteractAction()) {
        return words[6] > 0 && words[6] <= 1000000 &&
            words[7] == 0 && words[8] == 0
    }
    if (action == gameplayDisconnectAction()) {
        return words[6] >= 1 && words[6] <= 4 &&
            words[7] == 0 && words[8] == 0
    }
    if (action == gameplayReconnectAction()) {
        return words[6] == 0 && words[7] == 0 && words[8] == 0
    }
    if (action == gameplayPickupAction()) {
        return words[6] > 0 && words[6] <= 1000000 &&
            words[7] == 0 && words[8] == 0
    }
    if (action == gameplayEquipAction()) {
        return words[6] >= 0 && words[6] < 8 &&
            words[7] > 0 && words[7] <= 1000000 &&
            words[8] == 0
    }
    return words[6] > 0 && words[6] <= 1000000 &&
        words[7] >= 1 && words[7] <= 2 && words[8] == 0
}

Int gameplayCommandTick(Int[] words) {
    if (!validGameplayCommandMessage(words)) {
        return 0
    }
    return words[2]
}

Int gameplayCommandSequence(Int[] words) {
    if (!validGameplayCommandMessage(words)) {
        return 0
    }
    return words[3]
}

Int gameplayCommandPlayer(Int[] words) {
    if (!validGameplayCommandMessage(words)) {
        return 0
    }
    return words[4]
}

Int gameplayCommandAction(Int[] words) {
    if (!validGameplayCommandMessage(words)) {
        return 0
    }
    return words[5]
}

Int gameplayCommandValue(Int[] words, Int index) {
    if (!validGameplayCommandMessage(words) || index < 0 || index > 3) {
        return 0
    }
    return words[6 + index]
}

Int gameplayCommandGeneration(Int[] words) {
    if (!validGameplayCommandMessage(words)) {
        return 0
    }
    return words[9]
}

Int[] newGameplayStateMessage(
    Int tick, Int sequence, Bool accepted,
    Int interactionRevision, Int combatActorId, Int combatHealth,
    Int player
) {
    if (player < 1 || player > 2) {
        return new Int[0]
    }
    var words = new Int[24]
    words[0] = protocolVersion()
    words[1] = gameplayStateMessageKind()
    words[2] = tick
    words[3] = sequence
    words[4] = 0
    if (accepted) {
        words[4] = 1
    }
    words[5] = interactionRevision
    words[6] = combatActorId
    words[7] = combatHealth
    words[18] = player
    return words
}

Bool setGameplayStateProgression(
    Int[] words, Int secretCount, Bool levelCompleted, Int interactionMask
) {
    if (words.length != 24 || secretCount < 0 || secretCount > 64 ||
        interactionMask < 0 || interactionMask > 65535) {
        return false
    }
    words[8] = secretCount
    words[9] = 0
    if (levelCompleted) {
        words[9] = 1
    }
    words[17] = interactionMask
    return true
}

Bool setGameplayStateReplication(
    Int[] words, Int playerOnePosition, Int playerTwoPosition, Int currency
) {
    if (words.length != 24 ||
        playerOnePosition < -1000000 || playerOnePosition > 1000000 ||
        playerTwoPosition < -1000000 || playerTwoPosition > 1000000 ||
        currency < 0 || currency > 1000000) {
        return false
    }
    words[10] = playerOnePosition
    words[11] = playerTwoPosition
    words[12] = currency
    return true
}

Bool setGameplayStateMovement(
    Int[] words,
    Int playerOneY, Int playerOneZ,
    Int playerTwoY, Int playerTwoZ
) {
    if (words.length != 24 ||
        playerOneY < -1000000 || playerOneY > 1000000 ||
        playerOneZ < -1000000 || playerOneZ > 1000000 ||
        playerTwoY < -1000000 || playerTwoY > 1000000 ||
        playerTwoZ < -1000000 || playerTwoZ > 1000000) {
        return false
    }
    words[19] = playerOneY
    words[20] = playerOneZ
    words[21] = playerTwoY
    words[22] = playerTwoZ
    return true
}

Bool setGameplayStateConnection(
    Int[] words, Bool connected, Int generation,
    Int disconnectReason, Int diagnostic
) {
    if (words.length != 24 || generation <= 0 || generation > 1000000 ||
        disconnectReason < 0 || disconnectReason > 4 ||
        diagnostic < gameplayMoveDiagnostic() ||
        diagnostic > gameplayProgressionDiagnostic() ||
        (connected && disconnectReason != 0) ||
        (!connected && disconnectReason == 0)) {
        return false
    }
    words[13] = 0
    if (connected) {
        words[13] = 1
    }
    words[14] = generation
    words[15] = disconnectReason
    words[16] = diagnostic
    return true
}

Bool validGameplayStateFields(Int[] words) {
    return words.length == 24 &&
        words[0] == protocolVersion() &&
        words[1] == gameplayStateMessageKind() &&
        words[2] >= 0 && words[2] <= 1000000 &&
        words[3] > 0 && words[3] <= 1000000 &&
        words[4] >= 0 && words[4] <= 1 &&
        words[5] >= 0 && words[5] <= 1000000 &&
        words[6] > 0 && words[6] <= 1000000 &&
        words[7] >= 0 && words[7] <= 1000000 &&
        words[8] >= 0 && words[8] <= 64 &&
        words[9] >= 0 && words[9] <= 1 &&
        words[10] >= -1000000 && words[10] <= 1000000 &&
        words[11] >= -1000000 && words[11] <= 1000000 &&
        words[12] >= 0 && words[12] <= 1000000 &&
        words[13] >= 0 && words[13] <= 1 &&
        words[14] > 0 && words[14] <= 1000000 &&
        words[15] >= 0 && words[15] <= 4 &&
        words[16] >= gameplayMoveDiagnostic() &&
        words[16] <= gameplayProgressionDiagnostic() &&
        words[17] >= 0 && words[17] <= 65535 &&
        words[18] >= 1 && words[18] <= 2 &&
        words[19] >= -1000000 && words[19] <= 1000000 &&
        words[20] >= -1000000 && words[20] <= 1000000 &&
        words[21] >= -1000000 && words[21] <= 1000000 &&
        words[22] >= -1000000 && words[22] <= 1000000 &&
        ((words[13] == 1 && words[15] == 0) ||
            (words[13] == 0 && words[15] > 0))
}

Bool sealGameplayStateMessage(Int[] words) {
    if (!validGameplayStateFields(words)) {
        return false
    }
    words[23] = gameplayMessageChecksum(words, 23)
    return true
}

Bool validGameplayStateMessage(Int[] words) {
    return validGameplayStateFields(words) &&
        words[23] == gameplayMessageChecksum(words, 23)
}

Bool gameplayStateAccepted(Int[] words) {
    return validGameplayStateMessage(words) && words[4] == 1
}

Int gameplayStateInteractionRevision(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[5]
}

Int gameplayStateCombatActor(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[6]
}

Int gameplayStateCombatHealth(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[7]
}

Int gameplayStateSecretCount(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[8]
}

Bool gameplayStateLevelCompleted(Int[] words) {
    return validGameplayStateMessage(words) && words[9] == 1
}

Int gameplayStatePlayerPosition(Int[] words, Int player) {
    if (!validGameplayStateMessage(words) || player < 1 || player > 2) {
        return -1000001
    }
    return words[9 + player]
}

Int gameplayStatePlayerY(Int[] words, Int player) {
    if (!validGameplayStateMessage(words) || player < 1 || player > 2) {
        return -1000001
    }
    if (player == 1) {
        return words[19]
    }
    return words[21]
}

Int gameplayStatePlayerZ(Int[] words, Int player) {
    if (!validGameplayStateMessage(words) || player < 1 || player > 2) {
        return -1000001
    }
    if (player == 1) {
        return words[20]
    }
    return words[22]
}

Int gameplayStateCurrency(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[12]
}

Bool gameplayStateConnected(Int[] words) {
    return validGameplayStateMessage(words) && words[13] == 1
}

Int gameplayStateConnectionGeneration(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[14]
}

Int gameplayStateDisconnectReason(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[15]
}

Int gameplayStateDiagnostic(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[16]
}

Int gameplayStateInteractionMask(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[17]
}

Int gameplayStatePlayer(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return 0
    }
    return words[18]
}

Int enemyEncounterStateMessageKind() {
    return 5
}

Int maximumEnemyEncounterStateEnemies() {
    return 32
}

Int enemyEncounterStateEntryWidth() {
    return 8
}

Int enemyEncounterStateEntriesOffset() {
    return 19
}

Bool validEnemyEncounterStateShape(Int[] words) {
    if (words.length < 20 ||
        words[0] != protocolVersion() ||
        words[1] != enemyEncounterStateMessageKind() ||
        words[2] < 0 || words[2] > 1000000 ||
        words[3] <= 0 || words[3] > 1000000 ||
        words[4] <= 0 || words[4] > 1000000 ||
        words[5] < 0 ||
        words[7] < 0 ||
        words[7] > maximumEnemyEncounterStateEnemies() ||
        words[5] > words[7] ||
        words[6] < 0 || words[6] > 1000000) {
        return false
    }
    return words.length == 20 +
        words[7] * enemyEncounterStateEntryWidth()
}

Int[] newEnemyEncounterStateMessage(
    Int tick, Int sequence, Int encounterId,
    Int activeCount, Int remainingBudget, Int enemyCount
) {
    if (tick < 0 || tick > 1000000 ||
        sequence <= 0 || sequence > 1000000 ||
        encounterId <= 0 || encounterId > 1000000 ||
        enemyCount < 0 ||
        enemyCount > maximumEnemyEncounterStateEnemies() ||
        activeCount < 0 || activeCount > enemyCount ||
        remainingBudget < 0 || remainingBudget > 1000000) {
        return new Int[0]
    }
    var words = new Int[
        20 + enemyCount * enemyEncounterStateEntryWidth()]
    words[0] = protocolVersion()
    words[1] = enemyEncounterStateMessageKind()
    words[2] = tick
    words[3] = sequence
    words[4] = encounterId
    words[5] = activeCount
    words[6] = remainingBudget
    words[7] = enemyCount
    for (var index = 8; index < words.length; index = index + 1) {
        words[index] = 0
    }
    return words
}

Bool setEnemyEncounterStateImpact(
    Int[] words, Int sequence, Int kind,
    Int sourceId, Int targetId,
    Int x, Int y, Int z, Int applied, Bool died,
    Int clip, Int gain
) {
    if (!validEnemyEncounterStateShape(words) ||
        sequence <= 0 || sequence > 1000000 ||
        kind <= 0 || kind > 3 ||
        sourceId <= 0 || sourceId > 1000000 ||
        targetId < 0 || targetId > 1000000 ||
        x < -1000000 || x > 1000000 ||
        y < -1000000 || y > 1000000 ||
        z < -1000000 || z > 1000000 ||
        applied < 0 || applied > 1000000 ||
        clip <= 0 || clip > 1000000 ||
        gain < 0 || gain > 100) {
        return false
    }
    words[8] = sequence
    words[9] = kind
    words[10] = sourceId
    words[11] = targetId
    words[12] = x
    words[13] = y
    words[14] = z
    words[15] = applied
    words[16] = 0
    if (died) {
        words[16] = 1
    }
    words[17] = clip
    words[18] = gain
    return true
}

Bool setEnemyEncounterStateEntry(
    Int[] words, Int index,
    Int enemyId, Int role, Int state, Int targetId, Int health,
    Int x, Int y, Int z
) {
    if (!validEnemyEncounterStateShape(words) ||
        index < 0 || index >= words[7] ||
        enemyId <= 0 || enemyId > 1000000 ||
        role < 1 || role > 3 ||
        state < 0 || state > 7 ||
        targetId < 0 || targetId > 1000000 ||
        health < 0 || health > 1000000 ||
        ((state == 7 && health != 0) ||
            (state != 7 && health == 0)) ||
        x < -1000000 || x > 1000000 ||
        y < -1000000 || y > 1000000 ||
        z < -1000000 || z > 1000000) {
        return false
    }
    var offset = enemyEncounterStateEntriesOffset() +
        index * enemyEncounterStateEntryWidth()
    for (var other = 0; other < words[7]; other = other + 1) {
        var otherOffset = enemyEncounterStateEntriesOffset() +
            other * enemyEncounterStateEntryWidth()
        if (other != index && words[otherOffset] == enemyId) {
            return false
        }
    }
    words[offset] = enemyId
    words[offset + 1] = role
    words[offset + 2] = state
    words[offset + 3] = targetId
    words[offset + 4] = health
    words[offset + 5] = x
    words[offset + 6] = y
    words[offset + 7] = z
    return true
}

Bool validEnemyEncounterStateFields(Int[] words) {
    if (!validEnemyEncounterStateShape(words)) {
        return false
    }
    if (words[8] == 0) {
        for (var index = 9; index <= 18; index = index + 1) {
            if (words[index] != 0) {
                return false
            }
        }
    } else if (words[8] < 0 || words[8] > 1000000 ||
        words[9] <= 0 || words[9] > 3 ||
        words[10] <= 0 || words[10] > 1000000 ||
        words[11] < 0 || words[11] > 1000000 ||
        words[12] < -1000000 || words[12] > 1000000 ||
        words[13] < -1000000 || words[13] > 1000000 ||
        words[14] < -1000000 || words[14] > 1000000 ||
        words[15] < 0 || words[15] > 1000000 ||
        words[16] < 0 || words[16] > 1 ||
        words[17] <= 0 || words[17] > 1000000 ||
        words[18] < 0 || words[18] > 100) {
        return false
    }
    var activeEntries = 0
    for (var index = 0; index < words[7]; index = index + 1) {
        var offset = enemyEncounterStateEntriesOffset() +
            index * enemyEncounterStateEntryWidth()
        var enemyId = words[offset]
        var role = words[offset + 1]
        var state = words[offset + 2]
        var health = words[offset + 4]
        if (enemyId <= 0 || enemyId > 1000000 ||
            role < 1 || role > 3 ||
            state < 0 || state > 7 ||
            words[offset + 3] < 0 ||
            words[offset + 3] > 1000000 ||
            health < 0 || health > 1000000 ||
            ((state == 7 && health != 0) ||
                (state != 7 && health == 0)) ||
            words[offset + 5] < -1000000 ||
            words[offset + 5] > 1000000 ||
            words[offset + 6] < -1000000 ||
            words[offset + 6] > 1000000 ||
            words[offset + 7] < -1000000 ||
            words[offset + 7] > 1000000) {
            return false
        }
        if (state != 7) {
            activeEntries = activeEntries + 1
        }
        for (var other = index + 1;
            other < words[7];
            other = other + 1) {
            var otherOffset = enemyEncounterStateEntriesOffset() +
                other * enemyEncounterStateEntryWidth()
            if (words[otherOffset] == enemyId) {
                return false
            }
        }
    }
    return activeEntries == words[5]
}

Bool sealEnemyEncounterStateMessage(Int[] words) {
    if (!validEnemyEncounterStateFields(words)) {
        return false
    }
    words[words.length - 1] =
        gameplayMessageChecksum(words, words.length - 1)
    return true
}

Bool validEnemyEncounterStateMessage(Int[] words) {
    return validEnemyEncounterStateFields(words) &&
        words[words.length - 1] ==
            gameplayMessageChecksum(words, words.length - 1)
}

Int enemyEncounterStateSequence(Int[] words) {
    if (!validEnemyEncounterStateMessage(words)) {
        return 0
    }
    return words[3]
}

Int enemyEncounterStateEncounterId(Int[] words) {
    if (!validEnemyEncounterStateMessage(words)) {
        return 0
    }
    return words[4]
}

Int enemyEncounterStateActiveCount(Int[] words) {
    if (!validEnemyEncounterStateMessage(words)) {
        return -1
    }
    return words[5]
}

Int enemyEncounterStateRemainingBudget(Int[] words) {
    if (!validEnemyEncounterStateMessage(words)) {
        return -1
    }
    return words[6]
}

Int enemyEncounterStateEnemyCount(Int[] words) {
    if (!validEnemyEncounterStateMessage(words)) {
        return -1
    }
    return words[7]
}

ImpactPresentationEvent enemyEncounterStateImpact(Int[] words) {
    if (!validEnemyEncounterStateMessage(words) || words[8] == 0) {
        return ImpactPresentationEvent(
            0, 0, 0, 0, 0, 0, 0, 0, false, 0, 0)
    }
    return ImpactPresentationEvent(
        words[8], words[9], words[10], words[11],
        words[12], words[13], words[14], words[15],
        words[16] == 1, words[17], words[18])
}

Int enemyEncounterStateEnemyValue(
    Int[] words, Int index, Int component
) {
    if (!validEnemyEncounterStateMessage(words) ||
        index < 0 || index >= words[7] ||
        component < 0 || component >= enemyEncounterStateEntryWidth()) {
        return 0
    }
    return words[
        enemyEncounterStateEntriesOffset() +
        index * enemyEncounterStateEntryWidth() + component]
}

Int enemyEncounterStateEnemyId(Int[] words, Int index) {
    return enemyEncounterStateEnemyValue(words, index, 0)
}

Int enemyEncounterStateEnemyRole(Int[] words, Int index) {
    return enemyEncounterStateEnemyValue(words, index, 1)
}

Int enemyEncounterStateEnemyState(Int[] words, Int index) {
    return enemyEncounterStateEnemyValue(words, index, 2)
}

Int enemyEncounterStateEnemyTarget(Int[] words, Int index) {
    return enemyEncounterStateEnemyValue(words, index, 3)
}

Int enemyEncounterStateEnemyHealth(Int[] words, Int index) {
    return enemyEncounterStateEnemyValue(words, index, 4)
}

Int enemyEncounterStateEnemyPositionX(Int[] words, Int index) {
    return enemyEncounterStateEnemyValue(words, index, 5)
}

Int enemyEncounterStateEnemyPositionY(Int[] words, Int index) {
    return enemyEncounterStateEnemyValue(words, index, 6)
}

Int enemyEncounterStateEnemyPositionZ(Int[] words, Int index) {
    return enemyEncounterStateEnemyValue(words, index, 7)
}

Int multiplayerFeedbackMessageKind() {
    return 6
}

Int maximumMultiplayerFeedbackEvents() {
    return 16
}

Int multiplayerFeedbackEntryWidth() {
    return 11
}

Int multiplayerFeedbackEntriesOffset() {
    return 5
}

Bool validMultiplayerFeedbackShape(Int[] words) {
    return words.length >= 6 &&
        words[0] == protocolVersion() &&
        words[1] == multiplayerFeedbackMessageKind() &&
        words[2] >= 0 && words[2] <= 1000000 &&
        words[3] > 0 && words[3] <= 1000000 &&
        words[4] >= 0 &&
        words[4] <= maximumMultiplayerFeedbackEvents() &&
        words.length == 6 +
            words[4] * multiplayerFeedbackEntryWidth()
}

Int[] newMultiplayerFeedbackMessage(
    Int tick, Int sequence, Int eventCount
) {
    if (tick < 0 || tick > 1000000 ||
        sequence <= 0 || sequence > 1000000 ||
        eventCount < 0 ||
        eventCount > maximumMultiplayerFeedbackEvents()) {
        return new Int[0]
    }
    var words = new Int[
        6 + eventCount * multiplayerFeedbackEntryWidth()]
    words[0] = protocolVersion()
    words[1] = multiplayerFeedbackMessageKind()
    words[2] = tick
    words[3] = sequence
    words[4] = eventCount
    return words
}

Bool setMultiplayerFeedbackEvent(
    Int[] words, Int index, ImpactPresentationEvent event
) {
    if (!validMultiplayerFeedbackShape(words) ||
        index < 0 || index >= words[4] ||
        event.sequence() <= 0 || event.sequence() > 1000000 ||
        event.kind() <= 0 || event.kind() > 3 ||
        event.sourceId() <= 0 || event.sourceId() > 1000000 ||
        event.targetId() < 0 || event.targetId() > 1000000 ||
        event.x() < -1000000 || event.x() > 1000000 ||
        event.y() < -1000000 || event.y() > 1000000 ||
        event.z() < -1000000 || event.z() > 1000000 ||
        event.applied() < 0 || event.applied() > 1000000 ||
        event.clip() <= 0 || event.clip() > 1000000 ||
        event.gain() < 0 || event.gain() > 100) {
        return false
    }
    var offset = multiplayerFeedbackEntriesOffset() +
        index * multiplayerFeedbackEntryWidth()
    words[offset] = event.sequence()
    words[offset + 1] = event.kind()
    words[offset + 2] = event.sourceId()
    words[offset + 3] = event.targetId()
    words[offset + 4] = event.x()
    words[offset + 5] = event.y()
    words[offset + 6] = event.z()
    words[offset + 7] = event.applied()
    words[offset + 8] = 0
    if (event.died()) {
        words[offset + 8] = 1
    }
    words[offset + 9] = event.clip()
    words[offset + 10] = event.gain()
    return true
}

Bool validMultiplayerFeedbackFields(Int[] words) {
    if (!validMultiplayerFeedbackShape(words)) {
        return false
    }
    var previousSequence = 0
    for (var index = 0; index < words[4]; index = index + 1) {
        var offset = multiplayerFeedbackEntriesOffset() +
            index * multiplayerFeedbackEntryWidth()
        if (words[offset] <= previousSequence ||
            words[offset] > 1000000 ||
            words[offset + 1] <= 0 || words[offset + 1] > 3 ||
            words[offset + 2] <= 0 ||
            words[offset + 2] > 1000000 ||
            words[offset + 3] < 0 ||
            words[offset + 3] > 1000000 ||
            words[offset + 4] < -1000000 ||
            words[offset + 4] > 1000000 ||
            words[offset + 5] < -1000000 ||
            words[offset + 5] > 1000000 ||
            words[offset + 6] < -1000000 ||
            words[offset + 6] > 1000000 ||
            words[offset + 7] < 0 ||
            words[offset + 7] > 1000000 ||
            words[offset + 8] < 0 || words[offset + 8] > 1 ||
            words[offset + 9] <= 0 ||
            words[offset + 9] > 1000000 ||
            words[offset + 10] < 0 ||
            words[offset + 10] > 100) {
            return false
        }
        previousSequence = words[offset]
    }
    return true
}

Bool sealMultiplayerFeedbackMessage(Int[] words) {
    if (!validMultiplayerFeedbackFields(words)) {
        return false
    }
    words[words.length - 1] =
        gameplayMessageChecksum(words, words.length - 1)
    return true
}

Bool validMultiplayerFeedbackMessage(Int[] words) {
    return validMultiplayerFeedbackFields(words) &&
        words[words.length - 1] ==
            gameplayMessageChecksum(words, words.length - 1)
}

Int multiplayerFeedbackStateSequence(Int[] words) {
    if (!validMultiplayerFeedbackMessage(words)) {
        return 0
    }
    return words[3]
}

Int multiplayerFeedbackEventCount(Int[] words) {
    if (!validMultiplayerFeedbackMessage(words)) {
        return -1
    }
    return words[4]
}

ImpactPresentationEvent multiplayerFeedbackEventAt(
    Int[] words, Int index
) {
    if (!validMultiplayerFeedbackMessage(words) ||
        index < 0 || index >= words[4]) {
        return ImpactPresentationEvent(
            0, 0, 0, 0, 0, 0, 0, 0, false, 0, 0)
    }
    var offset = multiplayerFeedbackEntriesOffset() +
        index * multiplayerFeedbackEntryWidth()
    return ImpactPresentationEvent(
        words[offset], words[offset + 1],
        words[offset + 2], words[offset + 3],
        words[offset + 4], words[offset + 5], words[offset + 6],
        words[offset + 7], words[offset + 8] == 1,
        words[offset + 9], words[offset + 10])
}

Int playerAuthorityStateMessageKind() {
    return 7
}

Int maximumPlayerAuthorityItems() {
    return 8
}

Int maximumPlayerAuthorityEquipment() {
    return 4
}

Int maximumPlayerAuthoritySkills() {
    return 4
}

Int maximumPlayerAuthorityStatuses() {
    return 4
}

Int playerAuthorityItemEntryWidth() {
    return 10
}

Int playerAuthorityEquipmentEntryWidth() {
    return 2
}

Int playerAuthoritySkillEntryWidth() {
    return 4
}

Int playerAuthorityStatusEntryWidth() {
    return 3
}

Int playerAuthorityItemEntriesOffset() {
    return 12
}

Int playerAuthorityEquipmentEntriesOffset(Int[] words) {
    return playerAuthorityItemEntriesOffset() +
        words[8] * playerAuthorityItemEntryWidth()
}

Int playerAuthoritySkillEntriesOffset(Int[] words) {
    return playerAuthorityEquipmentEntriesOffset(words) +
        words[9] * playerAuthorityEquipmentEntryWidth()
}

Int playerAuthorityStatusEntriesOffset(Int[] words) {
    return playerAuthoritySkillEntriesOffset(words) +
        words[10] * playerAuthoritySkillEntryWidth()
}

Int playerAuthorityStateLength(
    Int itemCount, Int equipmentCount, Int skillCount, Int statusCount
) {
    return 13 +
        itemCount * playerAuthorityItemEntryWidth() +
        equipmentCount * playerAuthorityEquipmentEntryWidth() +
        skillCount * playerAuthoritySkillEntryWidth() +
        statusCount * playerAuthorityStatusEntryWidth()
}

Bool validPlayerAuthorityStateStorage(Int[] words) {
    if (words.length < 13 ||
        words[0] != protocolVersion() ||
        words[1] != playerAuthorityStateMessageKind() ||
        words[8] < 0 || words[8] > maximumPlayerAuthorityItems() ||
        words[9] < 0 || words[9] > maximumPlayerAuthorityEquipment() ||
        words[10] < 0 || words[10] > maximumPlayerAuthoritySkills() ||
        words[11] < 0 || words[11] > maximumPlayerAuthorityStatuses()) {
        return false
    }
    return words.length == playerAuthorityStateLength(
        words[8], words[9], words[10], words[11])
}

Bool validPlayerAuthorityStateShape(Int[] words) {
    return validPlayerAuthorityStateStorage(words) &&
        words[2] >= 0 && words[2] <= 1000000 &&
        words[3] > 0 && words[3] <= 1000000 &&
        words[4] >= 1 && words[4] <= 2 &&
        words[5] > 0 && words[5] <= 1000000 &&
        words[6] >= 0 && words[6] <= 1000000 &&
        words[7] >= 0 && words[7] <= 1000000
}

Int[] newPlayerAuthorityStateMessage(
    Int itemCount, Int equipmentCount, Int skillCount, Int statusCount
) {
    if (itemCount < 0 || itemCount > maximumPlayerAuthorityItems() ||
        equipmentCount < 0 ||
        equipmentCount > maximumPlayerAuthorityEquipment() ||
        skillCount < 0 || skillCount > maximumPlayerAuthoritySkills() ||
        statusCount < 0 || statusCount > maximumPlayerAuthorityStatuses()) {
        return new Int[0]
    }
    var words = new Int[playerAuthorityStateLength(
        itemCount, equipmentCount, skillCount, statusCount)]
    for (var index = 0; index < words.length; index = index + 1) {
        words[index] = 0
    }
    words[0] = protocolVersion()
    words[1] = playerAuthorityStateMessageKind()
    words[8] = itemCount
    words[9] = equipmentCount
    words[10] = skillCount
    words[11] = statusCount
    return words
}

Bool setPlayerAuthorityConnection(
    Int[] words, Int tick, Int sequence, Int player, Int generation
) {
    if (!validPlayerAuthorityStateStorage(words) ||
        tick < 0 || tick > 1000000 ||
        sequence <= 0 || sequence > 1000000 ||
        player < 1 || player > 2 ||
        generation <= 0 || generation > 1000000) {
        return false
    }
    words[2] = tick
    words[3] = sequence
    words[4] = player
    words[5] = generation
    return true
}

Bool setPlayerAuthorityInventory(
    Int[] words, Int inventoryRevision, Int currency
) {
    if (!validPlayerAuthorityStateStorage(words) ||
        inventoryRevision < 0 || inventoryRevision > 1000000 ||
        currency < 0 || currency > 1000000) {
        return false
    }
    words[6] = inventoryRevision
    words[7] = currency
    return true
}

Bool setPlayerAuthorityItem(
    Int[] words, Int index, Int itemId, Int quantity, Int rolled
) {
    if (!validPlayerAuthorityStateShape(words) ||
        index < 0 || index >= words[8] ||
        itemId <= 0 || itemId > 1000000 ||
        quantity <= 0 || quantity > 1000000 ||
        rolled < 0 || rolled > 1) {
        return false
    }
    for (var prior = 0; prior < words[8]; prior = prior + 1) {
        var priorOffset = playerAuthorityItemEntriesOffset() +
            prior * playerAuthorityItemEntryWidth()
        if (prior != index && words[priorOffset] == itemId) {
            return false
        }
    }
    var offset = playerAuthorityItemEntriesOffset() +
        index * playerAuthorityItemEntryWidth()
    words[offset] = itemId
    words[offset + 1] = quantity
    words[offset + 2] = rolled
    return true
}

Bool setPlayerAuthorityItemRoll(
    Int[] words, Int index, Int definitionId, Int seed, Int level
) {
    if (!validPlayerAuthorityStateShape(words) ||
        index < 0 || index >= words[8] ||
        definitionId <= 0 || definitionId > 1000000 ||
        seed < 0 || seed > 1000000 ||
        level <= 0 || level > 1000000) {
        return false
    }
    var offset = playerAuthorityItemEntriesOffset() +
        index * playerAuthorityItemEntryWidth()
    if (words[offset] <= 0 || words[offset + 2] != 1) {
        return false
    }
    words[offset + 3] = definitionId
    words[offset + 4] = seed
    words[offset + 5] = level
    return true
}

Bool setPlayerAuthorityItemAffixes(
    Int[] words, Int index, Int rarity,
    Int affixOne, Int affixTwo, Int condition
) {
    if (!validPlayerAuthorityStateShape(words) ||
        index < 0 || index >= words[8] ||
        rarity < 1 || rarity > 3 ||
        affixOne < 0 || affixOne > 64 ||
        affixTwo < 0 || affixTwo > 64 ||
        condition < 0 || condition > 100) {
        return false
    }
    var offset = playerAuthorityItemEntriesOffset() +
        index * playerAuthorityItemEntryWidth()
    if (words[offset] <= 0 || words[offset + 2] != 1) {
        return false
    }
    words[offset + 6] = rarity
    words[offset + 7] = affixOne
    words[offset + 8] = affixTwo
    words[offset + 9] = condition
    return true
}

Bool playerAuthorityContainsItem(Int[] words, Int itemId) {
    for (var index = 0; index < words[8]; index = index + 1) {
        var offset = playerAuthorityItemEntriesOffset() +
            index * playerAuthorityItemEntryWidth()
        if (words[offset] == itemId) {
            return true
        }
    }
    return false
}

Bool setPlayerAuthorityEquipment(
    Int[] words, Int index, Int slot, Int itemId
) {
    if (!validPlayerAuthorityStateShape(words) ||
        index < 0 || index >= words[9] ||
        slot < 0 || slot >= maximumPlayerAuthorityEquipment() ||
        itemId <= 0 || itemId > 1000000 ||
        !playerAuthorityContainsItem(words, itemId)) {
        return false
    }
    var entries = playerAuthorityEquipmentEntriesOffset(words)
    for (var prior = 0; prior < words[9]; prior = prior + 1) {
        var priorOffset = entries +
            prior * playerAuthorityEquipmentEntryWidth()
        if (prior != index &&
            (words[priorOffset] == slot ||
                words[priorOffset + 1] == itemId)) {
            return false
        }
    }
    var offset = entries + index * playerAuthorityEquipmentEntryWidth()
    words[offset] = slot
    words[offset + 1] = itemId
    return true
}

Bool setPlayerAuthoritySkill(
    Int[] words, Int index, Int skillId, Int rank,
    Int experience, Int cooldownUntil
) {
    if (!validPlayerAuthorityStateShape(words) ||
        index < 0 || index >= words[10] ||
        skillId <= 0 || skillId > 1000000 ||
        rank < 0 || rank > 1000000 ||
        experience < 0 || experience > 1000000 ||
        cooldownUntil < 0 || cooldownUntil > 1000000) {
        return false
    }
    var entries = playerAuthoritySkillEntriesOffset(words)
    for (var prior = 0; prior < words[10]; prior = prior + 1) {
        var priorOffset = entries + prior * playerAuthoritySkillEntryWidth()
        if (prior != index && words[priorOffset] == skillId) {
            return false
        }
    }
    var offset = entries + index * playerAuthoritySkillEntryWidth()
    words[offset] = skillId
    words[offset + 1] = rank
    words[offset + 2] = experience
    words[offset + 3] = cooldownUntil
    return true
}

Bool setPlayerAuthorityStatus(
    Int[] words, Int index, Int statusId, Int duration, Int stacks
) {
    if (!validPlayerAuthorityStateShape(words) ||
        index < 0 || index >= words[11] ||
        statusId <= 0 || statusId > 1000000 ||
        duration <= 0 || duration > 1000000 ||
        stacks <= 0 || stacks > 1000000) {
        return false
    }
    var entries = playerAuthorityStatusEntriesOffset(words)
    for (var prior = 0; prior < words[11]; prior = prior + 1) {
        var priorOffset = entries + prior * playerAuthorityStatusEntryWidth()
        if (prior != index && words[priorOffset] == statusId) {
            return false
        }
    }
    var offset = entries + index * playerAuthorityStatusEntryWidth()
    words[offset] = statusId
    words[offset + 1] = duration
    words[offset + 2] = stacks
    return true
}

Bool validPlayerAuthorityStateFields(Int[] words) {
    if (!validPlayerAuthorityStateShape(words)) {
        return false
    }
    for (var item = 0; item < words[8]; item = item + 1) {
        var itemOffset = playerAuthorityItemEntriesOffset() +
            item * playerAuthorityItemEntryWidth()
        var rolled = words[itemOffset + 2]
        if (words[itemOffset] <= 0 || words[itemOffset] > 1000000 ||
            words[itemOffset + 1] <= 0 ||
            words[itemOffset + 1] > 1000000 ||
            rolled < 0 || rolled > 1 ||
            (rolled == 0 && (words[itemOffset + 3] != 0 ||
                words[itemOffset + 4] != 0 ||
                words[itemOffset + 5] != 0 ||
                words[itemOffset + 6] != 0 ||
                words[itemOffset + 7] != 0 ||
                words[itemOffset + 8] != 0 ||
                words[itemOffset + 9] != 0)) ||
            (rolled == 1 && (words[itemOffset + 3] <= 0 ||
                words[itemOffset + 3] > 1000000 ||
                words[itemOffset + 4] < 0 ||
                words[itemOffset + 4] > 1000000 ||
                words[itemOffset + 5] <= 0 ||
                words[itemOffset + 5] > 1000000 ||
                words[itemOffset + 6] < 1 ||
                words[itemOffset + 6] > 3 ||
                words[itemOffset + 7] < 0 ||
                words[itemOffset + 7] > 64 ||
                words[itemOffset + 8] < 0 ||
                words[itemOffset + 8] > 64 ||
                words[itemOffset + 9] < 0 ||
                words[itemOffset + 9] > 100))) {
            return false
        }
        for (var priorItem = 0; priorItem < item; priorItem = priorItem + 1) {
            var priorItemOffset = playerAuthorityItemEntriesOffset() +
                priorItem * playerAuthorityItemEntryWidth()
            if (words[priorItemOffset] == words[itemOffset]) {
                return false
            }
        }
    }
    var equipmentEntries = playerAuthorityEquipmentEntriesOffset(words)
    for (var equipment = 0; equipment < words[9]; equipment = equipment + 1) {
        var equipmentOffset = equipmentEntries +
            equipment * playerAuthorityEquipmentEntryWidth()
        if (words[equipmentOffset] < 0 ||
            words[equipmentOffset] >= maximumPlayerAuthorityEquipment() ||
            !playerAuthorityContainsItem(words, words[equipmentOffset + 1])) {
            return false
        }
        for (var priorEquipment = 0;
            priorEquipment < equipment;
            priorEquipment = priorEquipment + 1) {
            var priorEquipmentOffset = equipmentEntries +
                priorEquipment * playerAuthorityEquipmentEntryWidth()
            if (words[priorEquipmentOffset] == words[equipmentOffset] ||
                words[priorEquipmentOffset + 1] ==
                    words[equipmentOffset + 1]) {
                return false
            }
        }
    }
    var skillEntries = playerAuthoritySkillEntriesOffset(words)
    for (var skill = 0; skill < words[10]; skill = skill + 1) {
        var skillOffset = skillEntries +
            skill * playerAuthoritySkillEntryWidth()
        if (words[skillOffset] <= 0 || words[skillOffset] > 1000000 ||
            words[skillOffset + 1] < 0 ||
            words[skillOffset + 1] > 1000000 ||
            words[skillOffset + 2] < 0 ||
            words[skillOffset + 2] > 1000000 ||
            words[skillOffset + 3] < 0 ||
            words[skillOffset + 3] > 1000000) {
            return false
        }
        for (var priorSkill = 0; priorSkill < skill; priorSkill = priorSkill + 1) {
            var priorSkillOffset = skillEntries +
                priorSkill * playerAuthoritySkillEntryWidth()
            if (words[priorSkillOffset] == words[skillOffset]) {
                return false
            }
        }
    }
    var statusEntries = playerAuthorityStatusEntriesOffset(words)
    for (var status = 0; status < words[11]; status = status + 1) {
        var statusOffset = statusEntries +
            status * playerAuthorityStatusEntryWidth()
        if (words[statusOffset] <= 0 || words[statusOffset] > 1000000 ||
            words[statusOffset + 1] <= 0 ||
            words[statusOffset + 1] > 1000000 ||
            words[statusOffset + 2] <= 0 ||
            words[statusOffset + 2] > 1000000) {
            return false
        }
        for (var priorStatus = 0;
            priorStatus < status;
            priorStatus = priorStatus + 1) {
            var priorStatusOffset = statusEntries +
                priorStatus * playerAuthorityStatusEntryWidth()
            if (words[priorStatusOffset] == words[statusOffset]) {
                return false
            }
        }
    }
    return true
}

Bool sealPlayerAuthorityStateMessage(Int[] words) {
    if (!validPlayerAuthorityStateFields(words)) {
        return false
    }
    words[words.length - 1] =
        gameplayMessageChecksum(words, words.length - 1)
    return true
}

Bool validPlayerAuthorityStateMessage(Int[] words) {
    return validPlayerAuthorityStateFields(words) &&
        words[words.length - 1] ==
            gameplayMessageChecksum(words, words.length - 1)
}

