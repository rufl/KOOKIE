    words[2] = tick
    words[3] = sequence
    words[4] = player
    words[5] = action
    words[6] = valueOne
    words[7] = valueTwo
    words[8] = valueThree
    words[9] = valueFour
    words[10] = gameplayMessageChecksum(words, 10)
    return words
}
