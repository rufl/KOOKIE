package session
import core


Int[] newEnvelope(Int protocol, Int kind, Int tick, Int sequence) {
    var words = new Int[5]
    words[0] = protocol
    words[1] = kind
    words[2] = tick
    words[3] = sequence
    words[4] = 0
    return words
}

Bool validEnvelope(Int[] words) {
    return words.length == 5 && words[0] == 1 && words[1] >= 0 && words[2] >= 0 && words[3] >= 0
}

Int broadPhaseSnapshotKind() {
    return 2
}

Int maximumSessionTransportWords() {
    return 300
}

Int maximumSessionTransportTriangles() {
    return 32
}

Int[] newBroadPhaseSnapshot(
    Int protocol, Int tick, Int sequence, Int geometryRevision,
    BoundedTriangleCollection collection
) {
    var triangleCount = collection.triangleCount()
    var words = new Int[12 + triangleCount * 9]
    words[0] = protocol
    words[1] = broadPhaseSnapshotKind()
    words[2] = tick
    words[3] = sequence
    words[4] = geometryRevision
    words[5] = triangleCount
    words[6] = collection.minimumX()
    words[7] = collection.minimumY()
    words[8] = collection.minimumZ()
    words[9] = collection.maximumX()
    words[10] = collection.maximumY()
    words[11] = collection.maximumZ()
    for (var ordinal = 0; ordinal < triangleCount; ordinal = ordinal + 1) {
        var index = collection.triangleIndexAt(ordinal)
        var offset = 12 + ordinal * 9
        for (var component = 0; component < 9; component = component + 1) {
            words[offset + component] = collection.triangleCoordinate(index, component)
        }
    }
    return words
}

Bool validBroadPhaseSnapshot(Int[] words) {
    return words.length >= 12 &&
        words.length <= maximumSessionTransportWords() &&
        words[0] == protocolVersion() &&
        words[1] == broadPhaseSnapshotKind() &&
        words[2] >= 0 && words[3] >= 0 && words[4] > 0 &&
        words[5] >= 0 && words[5] <= maximumSessionTransportTriangles() &&
        words[6] <= words[9] &&
        words[7] <= words[10] && words[8] <= words[11] &&
        words.length == 12 + words[5] * 9
}

Int broadPhaseSnapshotRevision(Int[] words) {
    if (!validBroadPhaseSnapshot(words)) {
        return -1
    }
    return words[4]
}

Int broadPhaseSnapshotTriangleCount(Int[] words) {
    if (!validBroadPhaseSnapshot(words)) {
        return -1
    }
    return words[5]
}

Bool broadPhaseSnapshotMatches(Int[] words, Int geometryRevision) {
    return validBroadPhaseSnapshot(words) &&
        words[4] == geometryRevision
}

Int gameplayCommandMessageKind() {
    return 3
}

Int gameplayStateMessageKind() {
    return 4
}

Int gameplayMoveAction() {
    return 1
}

Int gameplayFireAction() {
    return 2
}

Int gameplayInteractAction() {
    return 3
}

Int gameplayDisconnectAction() {
    return 4
}

Int gameplayReconnectAction() {
    return 5
}

Int gameplayMoveDiagnostic() {
    return 1
}

Int gameplayFireDiagnostic() {
    return 2
}

Int gameplayInteractionDiagnostic() {
    return 3
}

Int gameplayDisconnectDiagnostic() {
    return 4
}

Int gameplayReconnectDiagnostic() {
    return 5
}

Int gameplayStaleDiagnostic() {
    return 6
}

Int gameplayRejectedDiagnostic() {
    return 7
}

Int gameplayMessageChecksum(Int[] words, Int length) {
    if (length < 1 || length > words.length) {
        return -1
    }
    var checksum = 0
    for (var index = 0; index < length; index = index + 1) {
        checksum = checksum + words[index] * (index + 1)
    }
    return checksum
}

Int[] newGameplayCommandMessage(
    Int player, Int tick, Int sequence, Int action,
    Int valueOne, Int valueTwo, Int valueThree, Int valueFour
) {
    var words = new Int[11]
    words[0] = protocolVersion()
    words[1] = gameplayCommandMessageKind()
    words[2] = tick
    words[3] = sequence
    words[4] = player
    words[5] = action
    words[6] = valueOne
    words[7] = valueTwo
    words[8] = valueThree
    words[9] = valueFour
    words[10] = gameplayMessageChecksum(words, 10)
    return words
}

Bool validGameplayCommandMessage(Int[] words) {
    if (words.length != 11 ||
        words[0] != protocolVersion() ||
        words[1] != gameplayCommandMessageKind() ||
        words[2] <= 0 || words[2] > 1000000 ||
        words[3] <= 0 || words[3] > 1000000 ||
        words[4] < 1 || words[4] > 2 ||
        words[5] < gameplayMoveAction() ||
        words[5] > gameplayReconnectAction() ||
        words[10] != gameplayMessageChecksum(words, 10)) {
        return false
    }
    var action = words[5]
    if (action == gameplayMoveAction()) {
        return words[6] >= -4 && words[6] <= 4 &&
            words[7] == 0 && words[8] == 0 && words[9] == 0
    }
    if (action == gameplayFireAction()) {
        return words[6] > 0 && words[6] <= 1000000 &&
            words[7] >= 0 && words[7] <= 1000000 &&
            words[8] >= 0 && words[8] <= 1 && words[9] == 0
    }
    if (action == gameplayInteractAction()) {
        return words[6] > 0 && words[6] <= 1000000 &&
            words[7] == 0 && words[8] == 0 && words[9] == 0
    }
    if (action == gameplayDisconnectAction()) {
        return words[6] >= 1 && words[6] <= 4 &&
            words[7] == 0 && words[8] == 0 && words[9] == 0
    }
    return words[6] == 0 && words[7] == 0 &&
        words[8] == 0 && words[9] == 0
}

Int gameplayCommandTick(Int[] words) {
    if (!validGameplayCommandMessage(words)) {
        return 0
    }
    return words[2]
}

Int gameplayCommandSequence(Int[] words) {
    if (!validGameplayCommandMessage(words)) {
        return 0
    }
    return words[3]
}

Int gameplayCommandPlayer(Int[] words) {
    if (!validGameplayCommandMessage(words)) {
        return 0
    }
    return words[4]
}

Int gameplayCommandAction(Int[] words) {
    if (!validGameplayCommandMessage(words)) {
        return 0
    }
    return words[5]
}

Int gameplayCommandValue(Int[] words, Int index) {
    if (!validGameplayCommandMessage(words) || index < 0 || index > 3) {
        return 0
    }
    return words[6 + index]
}

Int[] newGameplayStateMessage(
    Int tick, Int sequence, Bool accepted,
    Int interactionRevision, Int combatActorId, Int combatHealth
) {
    var words = new Int[19]
    words[0] = protocolVersion()
    words[1] = gameplayStateMessageKind()
    words[2] = tick
    words[3] = sequence
    words[4] = 0
    if (accepted) {
        words[4] = 1
    }
    words[5] = interactionRevision
    words[6] = combatActorId
    words[7] = combatHealth
    return words
}

Bool setGameplayStateProgression(
    Int[] words, Int secretCount, Bool levelCompleted, Int interactionMask
) {
    if (words.length != 19 || secretCount < 0 || secretCount > 64 ||
        interactionMask < 0 || interactionMask > 65535) {
        return false
    }
    words[8] = secretCount
    words[9] = 0
    if (levelCompleted) {
        words[9] = 1
    }
    words[17] = interactionMask
    return true
}

Bool setGameplayStateReplication(
    Int[] words, Int playerOnePosition, Int playerTwoPosition, Int currency
) {
    if (words.length != 19 ||
        playerOnePosition < -1000000 || playerOnePosition > 1000000 ||
        playerTwoPosition < -1000000 || playerTwoPosition > 1000000 ||
        currency < 0 || currency > 1000000) {
        return false
    }
    words[10] = playerOnePosition
    words[11] = playerTwoPosition
    words[12] = currency
    return true
}

Bool setGameplayStateConnection(
    Int[] words, Bool connected, Int generation,
    Int disconnectReason, Int diagnostic
) {
    if (words.length != 19 || generation <= 0 || generation > 1000000 ||
        disconnectReason < 0 || disconnectReason > 4 ||
        diagnostic < gameplayMoveDiagnostic() ||
        diagnostic > gameplayRejectedDiagnostic() ||
        (connected && disconnectReason != 0) ||
        (!connected && disconnectReason == 0)) {
        return false
    }
    words[13] = 0
    if (connected) {
        words[13] = 1
    }
    words[14] = generation
    words[15] = disconnectReason
    words[16] = diagnostic
    return true
}

Bool validGameplayStateFields(Int[] words) {
    return words.length == 19 &&
        words[0] == protocolVersion() &&
        words[1] == gameplayStateMessageKind() &&
        words[2] > 0 && words[2] <= 1000000 &&
        words[3] > 0 && words[3] <= 1000000 &&
        words[4] >= 0 && words[4] <= 1 &&
        words[5] >= 0 && words[5] <= 1000000 &&
        words[6] > 0 && words[6] <= 1000000 &&
        words[7] >= 0 && words[7] <= 1000000 &&
        words[8] >= 0 && words[8] <= 64 &&
        words[9] >= 0 && words[9] <= 1 &&
        words[10] >= -1000000 && words[10] <= 1000000 &&
        words[11] >= -1000000 && words[11] <= 1000000 &&
        words[12] >= 0 && words[12] <= 1000000 &&
        words[13] >= 0 && words[13] <= 1 &&
        words[14] > 0 && words[14] <= 1000000 &&
        words[15] >= 0 && words[15] <= 4 &&
        words[16] >= gameplayMoveDiagnostic() &&
        words[16] <= gameplayRejectedDiagnostic() &&
        words[17] >= 0 && words[17] <= 65535 &&
        ((words[13] == 1 && words[15] == 0) ||
            (words[13] == 0 && words[15] > 0))
}

Bool sealGameplayStateMessage(Int[] words) {
    if (!validGameplayStateFields(words)) {
        return false
    }
    words[18] = gameplayMessageChecksum(words, 18)
    return true
}

Bool validGameplayStateMessage(Int[] words) {
    return validGameplayStateFields(words) &&
        words[18] == gameplayMessageChecksum(words, 18)
}

Bool gameplayStateAccepted(Int[] words) {
    return validGameplayStateMessage(words) && words[4] == 1
}

Int gameplayStateInteractionRevision(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[5]
}

Int gameplayStateCombatActor(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[6]
}

Int gameplayStateCombatHealth(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[7]
}

Int gameplayStateSecretCount(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[8]
}

Bool gameplayStateLevelCompleted(Int[] words) {
    return validGameplayStateMessage(words) && words[9] == 1
}

Int gameplayStatePlayerPosition(Int[] words, Int player) {
    if (!validGameplayStateMessage(words) || player < 1 || player > 2) {
        return -1000001
    }
    return words[9 + player]
}

Int gameplayStateCurrency(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[12]
}

Bool gameplayStateConnected(Int[] words) {
    return validGameplayStateMessage(words) && words[13] == 1
}

Int gameplayStateConnectionGeneration(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[14]
}

Int gameplayStateDisconnectReason(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[15]
}

Int gameplayStateDiagnostic(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[16]
}

Int gameplayStateInteractionMask(Int[] words) {
    if (!validGameplayStateMessage(words)) {
        return -1
    }
    return words[17]
}

Int envelopeSequence(Int[] words) {
    return words[3]
}

Bool roundTripEnvelope(Int protocol, Int kind, Int tick, Int sequence) {
    var encoded = newEnvelope(protocol, kind, tick, sequence)
    return validEnvelope(encoded) && envelopeSequence(encoded) == sequence
}

class BroadPhaseTransportQueue {
    Int packetCapacityValue
    Int maxPacketWordsValue
    Int[] packetLengths
    Int[] packetWords
    Int head
    Int tail
    Int queued

    public constructor(Int nextPacketCapacity, Int nextTriangleCapacity) {
        packetCapacityValue = nextPacketCapacity
        if (packetCapacityValue <= 0) {
            packetCapacityValue = 1
        }
        var triangleCapacity = nextTriangleCapacity
        if (triangleCapacity <= 0) {
            triangleCapacity = 1
        }
        if (triangleCapacity > maximumSessionTransportTriangles()) {
            triangleCapacity = maximumSessionTransportTriangles()
        }
        maxPacketWordsValue = 12 + triangleCapacity * 9
        packetLengths = new Int[packetCapacityValue]
        packetWords = new Int[packetCapacityValue * maxPacketWordsValue]
        head = 0
        tail = 0
        queued = 0
    }

    Bool send(Int[] words) {
        if (!validBroadPhaseSnapshot(words) ||
            words.length > maxPacketWordsValue ||
            queued == packetCapacityValue) {
            return false
        }
        var offset = tail * maxPacketWordsValue
        for (var index = 0; index < words.length; index = index + 1) {
            packetWords[offset + index] = words[index]
        }
        packetLengths[tail] = words.length
        tail = tail + 1
        if (tail == packetCapacityValue) {
            tail = 0
        }
        queued = queued + 1
        return true
    }

    Int pending() {
        return queued
    }

    Int capacity() {
        return packetCapacityValue
    }

    Int[] receive() {
        if (queued == 0) {
            return new Int[0]
        }
        var length = packetLengths[head]
        var offset = head * maxPacketWordsValue
        var words = new Int[length]
        for (var index = 0; index < length; index = index + 1) {
            words[index] = packetWords[offset + index]
        }
        head = head + 1
        if (head == packetCapacityValue) {
            head = 0
        }
        queued = queued - 1
        return words
    }
}
