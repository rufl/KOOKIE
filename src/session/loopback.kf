}

Int playerAuthorityStateStatusCount(Int[] words) {
    if (!validPlayerAuthorityStateMessage(words)) {
        return -1
    }
    return words[11]
}

Int playerAuthorityStateItemValue(
    Int[] words, Int index, Int component
) {
    if (!validPlayerAuthorityStateMessage(words) ||
        index < 0 || index >= words[8] ||
        component < 0 || component >= playerAuthorityItemEntryWidth()) {
        return -1
    }
    return words[playerAuthorityItemEntriesOffset() +
        index * playerAuthorityItemEntryWidth() + component]
}

Int playerAuthorityStateEquipmentValue(
    Int[] words, Int index, Int component
) {
    if (!validPlayerAuthorityStateMessage(words) ||
        index < 0 || index >= words[9] ||
        component < 0 ||
        component >= playerAuthorityEquipmentEntryWidth()) {
        return -1
    }
    return words[playerAuthorityEquipmentEntriesOffset(words) +
        index * playerAuthorityEquipmentEntryWidth() + component]
}

Int playerAuthorityStateSkillValue(
    Int[] words, Int index, Int component
) {
    if (!validPlayerAuthorityStateMessage(words) ||
        index < 0 || index >= words[10] ||
        component < 0 || component >= playerAuthoritySkillEntryWidth()) {
        return -1
    }
    return words[playerAuthoritySkillEntriesOffset(words) +
        index * playerAuthoritySkillEntryWidth() + component]
}

Int playerAuthorityStateStatusValue(
    Int[] words, Int index, Int component
) {
    if (!validPlayerAuthorityStateMessage(words) ||
        index < 0 || index >= words[11] ||
        component < 0 || component >= playerAuthorityStatusEntryWidth()) {
        return -1
    }
    return words[playerAuthorityStatusEntriesOffset(words) +
        index * playerAuthorityStatusEntryWidth() + component]
}

Int worldLootStateMessageKind() {
    return 8
}

Int maximumWorldLootStateDrops() {
    return 8
}

Int worldLootStateEntryWidth() {
    return 13
}

Int worldLootStateEntriesOffset() {
    return 8
}

Bool validWorldLootStateShape(Int[] words) {
    return words.length >= 9 &&
        words[0] == protocolVersion() &&
        words[1] == worldLootStateMessageKind() &&
        words[2] >= 0 && words[2] <= 1000000 &&
        words[3] > 0 && words[3] <= 1000000 &&
        words[4] >= 1 && words[4] <= 2 &&
        words[5] > 0 && words[5] <= 1000000 &&
        words[6] >= 0 && words[6] <= 1000000 &&
        words[7] >= 0 && words[7] <= maximumWorldLootStateDrops() &&
        words.length == 9 + words[7] * worldLootStateEntryWidth()
}

Int[] newWorldLootStateMessage(
    Int tick, Int sequence, Int player, Int generation,
    Int revision, Int dropCount
) {
    if (tick < 0 || tick > 1000000 ||
        sequence <= 0 || sequence > 1000000 ||
        player < 1 || player > 2 ||
        generation <= 0 || generation > 1000000 ||
        revision < 0 || revision > 1000000 ||
        dropCount < 0 || dropCount > maximumWorldLootStateDrops()) {
        return new Int[0]
    }
    var words = new Int[9 + dropCount * worldLootStateEntryWidth()]
    for (var index = 0; index < words.length; index = index + 1) {
        words[index] = 0
    }
    words[0] = protocolVersion()
    words[1] = worldLootStateMessageKind()
    words[2] = tick
    words[3] = sequence
    words[4] = player
    words[5] = generation
    words[6] = revision
    words[7] = dropCount
    return words
}

Bool setWorldLootStateEntry(
    Int[] words, Int index, BoundedWorldLoot loot, Int sourceIndex
) {
    if (!validWorldLootStateShape(words) ||
        index < 0 || index >= words[7] ||
        sourceIndex < 0 || sourceIndex >= loot.count()) {
        return false
    }
    var stableId = loot.stableId(sourceIndex)
    for (var prior = 0; prior < words[7]; prior = prior + 1) {
        var priorOffset = worldLootStateEntriesOffset() +
            prior * worldLootStateEntryWidth()
        if (prior != index && words[priorOffset] == stableId) {
            return false
        }
    }
    var offset = worldLootStateEntriesOffset() +
        index * worldLootStateEntryWidth()
    words[offset] = stableId
    words[offset + 1] = loot.sourceId(sourceIndex)
    words[offset + 2] = loot.rank(sourceIndex)
    words[offset + 3] = loot.positionX(sourceIndex)
    words[offset + 4] = loot.positionY(sourceIndex)
    words[offset + 5] = loot.positionZ(sourceIndex)
    words[offset + 6] = loot.definitionId(sourceIndex)
    words[offset + 7] = loot.seed(sourceIndex)
    words[offset + 8] = loot.level(sourceIndex)
    words[offset + 9] = loot.rarity(sourceIndex)
    words[offset + 10] = loot.affixOne(sourceIndex)
    words[offset + 11] = loot.affixTwo(sourceIndex)
    words[offset + 12] = loot.condition(sourceIndex)
    return true
}

Bool validWorldLootStateFields(Int[] words) {
    if (!validWorldLootStateShape(words)) {
        return false
    }
    for (var index = 0; index < words[7]; index = index + 1) {
        var offset = worldLootStateEntriesOffset() +
            index * worldLootStateEntryWidth()
        if (words[offset] <= 0 || words[offset] > 1000000 ||
            words[offset + 1] <= 0 || words[offset + 1] > 1000000 ||
            words[offset + 2] < 1 || words[offset + 2] > 3 ||
            words[offset + 3] < -1000000 ||
            words[offset + 3] > 1000000 ||
            words[offset + 4] < -1000000 ||
            words[offset + 4] > 1000000 ||
            words[offset + 5] < -1000000 ||
            words[offset + 5] > 1000000 ||
            words[offset + 6] <= 0 ||
            words[offset + 6] > 1000000 ||
            words[offset + 7] < 0 ||
            words[offset + 7] > 1000000 ||
            words[offset + 8] <= 0 ||
            words[offset + 8] > 1000000 ||
            words[offset + 9] < 1 || words[offset + 9] > 3 ||
            words[offset + 10] < 0 || words[offset + 10] > 64 ||
            words[offset + 11] < 0 || words[offset + 11] > 64 ||
            words[offset + 12] < 0 || words[offset + 12] > 100) {
            return false
        }
        for (var prior = 0; prior < index; prior = prior + 1) {
            var priorOffset = worldLootStateEntriesOffset() +
                prior * worldLootStateEntryWidth()
            if (words[priorOffset] == words[offset]) {
                return false
            }
        }
    }
    return true
}

Bool sealWorldLootStateMessage(Int[] words) {
    if (!validWorldLootStateFields(words)) {
        return false
    }
    words[words.length - 1] =
        gameplayMessageChecksum(words, words.length - 1)
    return true
}

Bool validWorldLootStateMessage(Int[] words) {
    return validWorldLootStateFields(words) &&
        words[words.length - 1] ==
            gameplayMessageChecksum(words, words.length - 1)
}

Int worldLootStateSequence(Int[] words) {
    if (!validWorldLootStateMessage(words)) {
        return 0
    }
    return words[3]
}

Int worldLootStatePlayer(Int[] words) {
    if (!validWorldLootStateMessage(words)) {
        return 0
    }
    return words[4]
}

Int worldLootStateGeneration(Int[] words) {
    if (!validWorldLootStateMessage(words)) {
        return 0
    }
    return words[5]
}

Int worldLootStateRevision(Int[] words) {
    if (!validWorldLootStateMessage(words)) {
        return -1
    }
    return words[6]
}

Int worldLootStateDropCount(Int[] words) {
    if (!validWorldLootStateMessage(words)) {
        return -1
    }
    return words[7]
}

Int worldLootStateValue(Int[] words, Int index, Int component) {
    if (!validWorldLootStateMessage(words) ||
        index < 0 || index >= words[7] ||
        component < 0 || component >= worldLootStateEntryWidth()) {
        return -1
    }
    return words[worldLootStateEntriesOffset() +
        index * worldLootStateEntryWidth() + component]
}

Int envelopeSequence(Int[] words) {
    return words[3]
}

Bool roundTripEnvelope(Int protocol, Int kind, Int tick, Int sequence) {
    var encoded = newEnvelope(protocol, kind, tick, sequence)
    return validEnvelope(encoded) && envelopeSequence(encoded) == sequence
}

class BroadPhaseTransportQueue {
    Int packetCapacityValue
    Int maxPacketWordsValue
    Int[] packetLengths
    Int[] packetWords
    Int head
    Int tail
    Int queued

    public constructor(Int nextPacketCapacity, Int nextTriangleCapacity) {
        packetCapacityValue = nextPacketCapacity
        if (packetCapacityValue <= 0) {
            packetCapacityValue = 1
        }
        var triangleCapacity = nextTriangleCapacity
        if (triangleCapacity <= 0) {
            triangleCapacity = 1
        }
        if (triangleCapacity > maximumSessionTransportTriangles()) {
            triangleCapacity = maximumSessionTransportTriangles()
        }
        maxPacketWordsValue = 12 + triangleCapacity * 9
        packetLengths = new Int[packetCapacityValue]
        packetWords = new Int[packetCapacityValue * maxPacketWordsValue]
        head = 0
        tail = 0
        queued = 0
    }

    Bool send(Int[] words) {
        if (!validBroadPhaseSnapshot(words) ||
            words.length > maxPacketWordsValue ||
            queued == packetCapacityValue) {
            return false
        }
        var offset = tail * maxPacketWordsValue
        for (var index = 0; index < words.length; index = index + 1) {
            packetWords[offset + index] = words[index]
        }
        packetLengths[tail] = words.length
        tail = tail + 1
        if (tail == packetCapacityValue) {
            tail = 0
        }
        queued = queued + 1
        return true
    }

    Int pending() {
        return queued
    }

    Int capacity() {
        return packetCapacityValue
    }

    Int[] receive() {
        if (queued == 0) {
            return new Int[0]
        }
        var length = packetLengths[head]
        var offset = head * maxPacketWordsValue
        var words = new Int[length]
        for (var index = 0; index < length; index = index + 1) {
            words[index] = packetWords[offset + index]
        }
        head = head + 1
        if (head == packetCapacityValue) {
            head = 0
        }
        queued = queued - 1
        return words
    }
}
