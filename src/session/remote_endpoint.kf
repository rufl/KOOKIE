package session

import content

class RemoteSessionEndpoint {
    Int firstOctetValue
    Int secondOctetValue
    Int thirdOctetValue
    Int fourthOctetValue
    Int portValue
    Int key0LowValue
    Int key0HighValue
    Int key1LowValue
    Int key1HighValue
    Bool activeValue

    public constructor(
        Int firstOctet, Int secondOctet, Int thirdOctet, Int fourthOctet,
        Int port, Int key0Low, Int key0High, Int key1Low, Int key1High
    ) {
        firstOctetValue = firstOctet
        secondOctetValue = secondOctet
        thirdOctetValue = thirdOctet
        fourthOctetValue = fourthOctet
        portValue = port
        key0LowValue = key0Low
        key0HighValue = key0High
        key1LowValue = key1Low
        key1HighValue = key1High
        activeValue = false
    }

    Bool validAddress() {
        return firstOctetValue >= 0 && firstOctetValue <= 255 &&
            secondOctetValue >= 0 && secondOctetValue <= 255 &&
            thirdOctetValue >= 0 && thirdOctetValue <= 255 &&
            fourthOctetValue >= 0 && fourthOctetValue <= 255 &&
            portValue > 0 && portValue <= 65535
    }

    Bool validKey() {
        return key0LowValue != 0 || key0HighValue != 0 ||
            key1LowValue != 0 || key1HighValue != 0
    }

    Bool valid() {
        return validAddress() && validKey()
    }

    Bool setPeer(
        Int firstOctet, Int secondOctet, Int thirdOctet, Int fourthOctet,
        Int port
    ) {
        if (activeValue || firstOctet < 0 || firstOctet > 255 ||
            secondOctet < 0 || secondOctet > 255 ||
            thirdOctet < 0 || thirdOctet > 255 ||
            fourthOctet < 0 || fourthOctet > 255 ||
            port <= 0 || port > 65535) {
            return false
        }
        firstOctetValue = firstOctet
        secondOctetValue = secondOctet
        thirdOctetValue = thirdOctet
        fourthOctetValue = fourthOctet
        portValue = port
        return true
    }

    Bool setKey(Int key0Low, Int key0High, Int key1Low, Int key1High) {
        if (activeValue ||
            (key0Low == 0 && key0High == 0 && key1Low == 0 && key1High == 0)) {
            return false
        }
        key0LowValue = key0Low
        key0HighValue = key0High
        key1LowValue = key1Low
        key1HighValue = key1High
        return true
    }

    Bool activate() {
        if (activeValue || !valid()) {
            return false
        }
        activeValue = true
        return true
    }

    Bool deactivate() {
        if (!activeValue) {
            return false
        }
        activeValue = false
        return true
    }

    Bool active() {
        return activeValue
    }

    Int firstOctet() {
        return firstOctetValue
    }

    Int secondOctet() {
        return secondOctetValue
    }

    Int thirdOctet() {
        return thirdOctetValue
    }

    Int fourthOctet() {
        return fourthOctetValue
    }

    Int port() {
        return portValue
    }

    Int keyWord(Int index) {
        if (index == 0) {
            return key0LowValue
        }
        if (index == 1) {
            return key0HighValue
        }
        if (index == 2) {
            return key1LowValue
        }
        if (index == 3) {
            return key1HighValue
        }
        return 0
    }
}

class RemoteSessionLink {
    RemoteSessionEndpoint endpointValue
    Bool connectedValue
    Int sentSequenceValue
    Int receivedSequenceValue
    BoundedContentCompatibility localCompatibilityValue
    BoundedContentCompatibility remoteCompatibilityValue
    Int[] compatibilityResponseValue
    Bool compatibilityRequiredValue
    Bool compatibilityAcceptedValue
    Int compatibilitySequenceValue
    Int compatibilityDiagnosticValue

    public constructor(RemoteSessionEndpoint endpoint) {
        endpointValue = endpoint
        connectedValue = false
        sentSequenceValue = 0
        receivedSequenceValue = 0
        localCompatibilityValue = BoundedContentCompatibility()
        remoteCompatibilityValue = BoundedContentCompatibility()
        compatibilityResponseValue =
            new Int[compatibilityHandshakeResponseLength()]
        for (var index = 0;
            index < compatibilityResponseValue.length; index = index + 1) {
            compatibilityResponseValue[index] = 0
        }
        compatibilityRequiredValue = false
        compatibilityAcceptedValue = false
        compatibilitySequenceValue = 0
        compatibilityDiagnosticValue = creatorDiagnosticNone()
    }

    Bool connect() {
        if (connectedValue || !endpointValue.activate()) {
            return false
        }
        connectedValue = true
        return true
    }

    Bool disconnect() {
        if (!connectedValue || !endpointValue.deactivate()) {
            return false
        }
        connectedValue = false
        compatibilityAcceptedValue = false
        compatibilitySequenceValue = 0
        compatibilityDiagnosticValue = creatorDiagnosticNone()
        remoteCompatibilityValue.clear()
        for (var index = 0;
            index < compatibilityResponseValue.length; index = index + 1) {
            compatibilityResponseValue[index] = 0
        }
        return true
    }
    Bool reconnect() {
        if (connectedValue && !disconnect()) {
            return false
        }
        return connect()
    }


    Bool connected() {
        return connectedValue
    }

    Bool requireCompatibility(BoundedContentCompatibility local) {
        if (connectedValue || compatibilityRequiredValue ||
            !localCompatibilityValue.copyFrom(local)) {
            return false
        }
        compatibilityRequiredValue = true
        compatibilityAcceptedValue = false
        compatibilityDiagnosticValue = creatorDiagnosticNone()
        return true
    }

    Int[] compatibilityOffer(Int sequence) {
        if (!connectedValue || !compatibilityRequiredValue ||
            compatibilityAcceptedValue ||
            sequence <= compatibilitySequenceValue) {
            return new Int[0]
        }
        var offer = newCompatibilityHandshakeOffer(
            localCompatibilityValue, sequence)
        if (offer.length == compatibilityHandshakeOfferLength()) {
            compatibilitySequenceValue = sequence
        }
        return offer
    }

    Bool receiveCompatibilityOffer(
        Int[] offer, BoundedContentCompatibility local
    ) {
        if (!connectedValue || !compatibilityRequiredValue ||
            offer.length != compatibilityHandshakeOfferLength() ||
            offer[3] <= compatibilitySequenceValue ||
            !localCompatibilityValue.matches(local)) {
            return false
        }
        var offered = BoundedContentCompatibility()
        if (!decodeCompatibilityHandshakeOffer(offer, offered)) {
            return false
        }
        var response = newCompatibilityHandshakeResponse(
            localCompatibilityValue, offered, offer[3])
        if (response.length != compatibilityResponseValue.length ||
            !remoteCompatibilityValue.copyFrom(offered)) {
            return false
        }
        for (var index = 0; index < response.length; index = index + 1) {
            compatibilityResponseValue[index] = response[index]
        }
        compatibilitySequenceValue = offer[3]
        compatibilityDiagnosticValue =
            compatibilityHandshakeDiagnostic(response)
        compatibilityAcceptedValue =
            compatibilityHandshakeAccepted(response)
        return true
    }

    Int[] compatibilityResponse() {
        var response = new Int[compatibilityResponseValue.length]
        for (var index = 0; index < response.length; index = index + 1) {
            response[index] = compatibilityResponseValue[index]
        }
        return response
    }

    Bool acceptCompatibilityResponse(Int[] response, Int expectedSequence) {
        if (!connectedValue || !compatibilityRequiredValue ||
            expectedSequence != compatibilitySequenceValue ||
            !validCompatibilityHandshakeResponse(
                response, expectedSequence,
                localCompatibilityValue.checksum())) {
            return false
        }
        compatibilityDiagnosticValue =
            compatibilityHandshakeDiagnostic(response)
        compatibilityAcceptedValue =
            compatibilityHandshakeAccepted(response)
        return true
    }

    Bool ready() {
        return connectedValue &&
            (!compatibilityRequiredValue || compatibilityAcceptedValue)
    }

    Bool compatibilityRequired() { return compatibilityRequiredValue }
    Bool compatible() { return compatibilityAcceptedValue }
    Int compatibilityDiagnostic() { return compatibilityDiagnosticValue }
    Int compatibilitySequence() { return compatibilitySequenceValue }

    Bool sendSnapshot(Int[] words) {
        if (!ready() || !validBroadPhaseSnapshot(words) ||
            words[3] <= sentSequenceValue) {
            return false
        }
        sentSequenceValue = words[3]
        return true
    }

    Bool canReceiveSnapshot(Int[] words) {
        return ready() && validBroadPhaseSnapshot(words) &&
            words[3] > receivedSequenceValue
    }

    Bool receiveSnapshot(Int[] words) {
        if (!canReceiveSnapshot(words)) {
            return false
        }
        receivedSequenceValue = words[3]
        return true
    }

    Int sentSequence() {
        return sentSequenceValue
    }

    Int receivedSequence() {
        return receivedSequenceValue
    }
}
