Bool validSessionWebKutterRequest(Int[] words) {
    if (words.length < 6 ||
        words[0] != sessionWebGameProtocolVersion() ||
        words[1] != sessionWebGameKind() || words[2] <= 0 ||
        words[2] > 1000000 || words[3] != sessionWebKutterRequestMarker() ||
        words[4] < sessionWebKutterGet() ||
        words[4] > sessionWebKutterPreview() ||
        words[words.length - 1] !=
            sessionWebMessageChecksum(words, words.length - 1)) {
        return false
    }
    return true
}
