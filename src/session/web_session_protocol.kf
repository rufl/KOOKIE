package session
Int sessionWebGameProtocolVersion() { return 2 }

Int sessionWebFrameMagic() { return 0x4B575331 }
Int sessionWebFrameVersion() { return 1 }
Int sessionWebMaximumWords() { return 272 }
Int sessionWebMaximumFrameBytes() {
    return 16 + sessionWebMaximumWords() * 4
}

Int sessionWebGameSceneObjectEntryWidth() { return 9 }
Int sessionWebSceneLabelEntryWidth() { return 6 }
Int sessionWebGameSceneObjectsOffset() { return 69 }
Int sessionWebGameMaximumSceneObjects() { return 17 }
Int sessionWebGameMaximumSceneLabels() { return 8 }
Int sessionWebGameSceneLabelLocal() { return 1 }
Int sessionWebGameSceneLabelWaddle() { return 2 }
Int sessionWebGameSceneLabelHonk() { return 3 }
Int sessionWebGameSceneLabelPond() { return 4 }
Int sessionWebGameSceneObjectDoor() { return 1 }
Int sessionWebGameSceneObjectFloatable() { return 2 }
Int sessionWebGameSceneObjectPowerUp() { return 3 }
Int sessionWebGameSceneObjectLootBeam() { return 4 }

Int sessionWebHelloKind() { return 1 }
Int sessionWebAckKind() { return 2 }
Int sessionWebPingKind() { return 3 }
Int sessionWebPongKind() { return 4 }
Int sessionWebErrorKind() { return 5 }
Int sessionWebGameKind() { return 6 }
Int sessionWebBrowserCapability() { return 1 }
Int sessionWebServerCapability() { return 1 }

Int sessionWebSubprotocolVersion() { return 1 }
Int sessionWebAuthTokenMinimumLength() { return 8 }
Int sessionWebAuthTokenMaximumLength() { return 128 }

Bool validSessionWebAuthTokenLength(Int length) {
    return length >= sessionWebAuthTokenMinimumLength() &&
        length <= sessionWebAuthTokenMaximumLength()
}

Int sessionWebGameProbePayload() { return 7127 }
Int sessionWebGameCommandMarker() { return 1 }
Int sessionWebGameSnapshotMarker() { return 2 }
Int sessionWebGameSceneSnapshotMarker() { return 3 }
Int sessionWebGameFullSceneSnapshotMarker() { return 4 }
Int sessionWebGameMoveLeftCommand() { return 1 }
Int sessionWebGameMoveRightCommand() { return 2 }
Int sessionWebGameMeleeCommand() { return 3 }
Int sessionWebGameSpecialCommand() { return 4 }
Int sessionWebGameResetCommand() { return 5 }
Int sessionWebGameSceneProbeCommand() { return 6 }
Int sessionWebGameFullSceneProbeCommand() { return 7 }
Int sessionWebGameMoveForwardCommand() { return 8 }
Int sessionWebGameMoveBackCommand() { return 9 }
Int sessionWebGameStrafeLeftCommand() { return 10 }
Int sessionWebGameStrafeRightCommand() { return 11 }
Int sessionWebGameLookLeftCommand() { return 12 }
Int sessionWebGameLookRightCommand() { return 13 }
Int sessionWebGameFireCommand() { return 14 }
Int sessionWebGameJumpCommand() { return 15 }
Int sessionWebGameMinimumPosition() { return -100 }
Int sessionWebGameMaximumPosition() { return 100 }
Int sessionWebGameMinimumDepth() { return -60 }
Int sessionWebGameMaximumDepth() { return 60 }
Int sessionWebGameWorldMinimumX() { return 4 }
Int sessionWebGameWorldMaximumX() { return 316 }
Int sessionWebGameWorldMinimumY() { return 1 }
Int sessionWebGameWorldMaximumY() { return 20 }
Int sessionWebGameWorldMinimumZ() { return 4 }
Int sessionWebGameWorldMaximumZ() { return 276 }
Int sessionWebGameMaximumTick() { return 10000000 }
Int sessionWebGameMaximumHealth() { return 100 }
Int sessionWebGameMaximumStamina() { return 100 }
Int sessionWebGameMaximumAmmo() { return 99 }
Int sessionWebGameMaximumCombo() { return 1000000 }
Int sessionWebGameMaximumVfx() { return 15 }
Int sessionWebGameMaximumPickupKind() { return 6 }


Int sessionWebChecksumMix(Int state, Int value) {
    var normalized = value % 1000003
    if (normalized < 0) { normalized = normalized + 1000003 }
    return (state * 31 + normalized) % 1000003
}

Int sessionWebMessageChecksum(Int[] words, Int length) {
    if (length <= 0 || length > words.length) { return -1 }
    var result = 53
    for (var index = 0; index < length; index = index + 1) {
        result = sessionWebChecksumMix(result, words[index])
    }
    return result
}

Int[] newSessionWebHello(Int sequence) {
    if (sequence <= 0 || sequence > 1000000) {
        return new Int[0]
    }
    var words = new Int[8]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebHelloKind()
    words[2] = sequence
    words[3] = sessionClientTargetBrowser()
    words[4] = sessionAuthorityRemote()
    words[5] = sessionGameWebSocket()
    words[6] = sessionWebBrowserCapability()
    words[7] = sessionWebMessageChecksum(words, 7)
    return words
}

Bool validSessionWebHello(Int[] words) {
    return words.length == 8 &&
        words[0] == sessionWebGameProtocolVersion() &&
        words[1] == sessionWebHelloKind() &&
        words[2] > 0 && words[2] <= 1000000 &&
        words[3] == sessionClientTargetBrowser() &&
        words[4] == sessionAuthorityRemote() &&
        words[5] == sessionGameWebSocket() &&
        words[6] == sessionWebBrowserCapability() &&
        words[7] == sessionWebMessageChecksum(words, 7)
}

Int[] newSessionWebAck(Int sequence, Bool accepted) {
    if (sequence <= 0 || sequence > 1000000) {
        return new Int[0]
    }
    var acceptedValue = 0
    if (accepted) { acceptedValue = 1 }
    var words = new Int[7]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebAckKind()
    words[2] = sequence
    words[3] = acceptedValue
    words[4] = sessionGameWebSocket()
    words[5] = sessionWebServerCapability()
    words[6] = sessionWebMessageChecksum(words, 6)
    return words
}

Bool validSessionWebAck(Int[] words) {
    return words.length == 7 &&
        words[0] == sessionWebGameProtocolVersion() &&
        words[1] == sessionWebAckKind() &&
        words[2] > 0 && words[2] <= 1000000 &&
        (words[3] == 0 || words[3] == 1) &&
        words[4] == sessionGameWebSocket() &&
        words[5] == sessionWebServerCapability() &&
        words[6] == sessionWebMessageChecksum(words, 6)
}

Int[] newSessionWebPing(Int kind, Int sequence) {
    if ((kind != sessionWebPingKind() && kind != sessionWebPongKind()) ||
        sequence <= 0 || sequence > 1000000) {
        return new Int[0]
    }
    var words = new Int[4]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = kind
    words[2] = sequence
    words[3] = sessionWebMessageChecksum(words, 3)
    return words
}

Bool validSessionWebPing(Int[] words, Int kind) {
    return words.length == 4 &&
        (kind == sessionWebPingKind() || kind == sessionWebPongKind()) &&
        words[0] == sessionWebGameProtocolVersion() &&
        words[1] == kind && words[2] > 0 && words[2] <= 1000000 &&
        words[3] == sessionWebMessageChecksum(words, 3)
}

Int[] newSessionWebGameCommand(Int sequence, Int command) {
    if (sequence <= 0 || sequence > 1000000 ||
        (command < sessionWebGameMoveLeftCommand() ||
            command > sessionWebGameJumpCommand())) {
        return new Int[0]
    }
    var words = new Int[7]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebGameKind()
    words[2] = sequence
    words[3] = sessionWebGameCommandMarker()
    words[4] = command
    words[5] = 0
    if (command == sessionWebGameMoveLeftCommand() ||
        command == sessionWebGameStrafeLeftCommand() ||
        command == sessionWebGameMoveBackCommand()) {
        words[5] = -8
    } else if (command == sessionWebGameMoveRightCommand() ||
        command == sessionWebGameMoveForwardCommand() ||
        command == sessionWebGameStrafeRightCommand()) {
        words[5] = 8
    } else if (command == sessionWebGameLookLeftCommand()) {
        words[5] = -15
    } else if (command == sessionWebGameLookRightCommand()) {
        words[5] = 15
    }
    words[6] = sessionWebMessageChecksum(words, 6)
    return words
}

Int[] newSessionWebGameSceneProbe(Int sequence) {
    return newSessionWebGameCommand(sequence, sessionWebGameSceneProbeCommand())
}

Int[] newSessionWebGameFullSceneProbe(Int sequence) {
    return newSessionWebGameCommand(
        sequence, sessionWebGameFullSceneProbeCommand()
    )
}

Bool validSessionWebGameCommand(Int[] words) {
    return words.length == 7 &&
        words[0] == sessionWebGameProtocolVersion() &&
        words[1] == sessionWebGameKind() &&
        words[2] > 0 && words[2] <= 1000000 &&
        words[3] == sessionWebGameCommandMarker() &&
        ((words[4] == sessionWebGameMoveLeftCommand() && words[5] == -8) ||
            (words[4] == sessionWebGameMoveRightCommand() && words[5] == 8) ||
            (words[4] == sessionWebGameMoveBackCommand() &&
                words[5] == -8) ||
            (words[4] == sessionWebGameMoveForwardCommand() &&
                words[5] == 8) ||
            (words[4] == sessionWebGameStrafeLeftCommand() &&
                words[5] == -8) ||
            (words[4] == sessionWebGameStrafeRightCommand() &&
                words[5] == 8) ||
            (words[4] == sessionWebGameLookLeftCommand() &&
                words[5] == -15) ||
            (words[4] == sessionWebGameLookRightCommand() &&
                words[5] == 15) ||
            (words[4] >= sessionWebGameMeleeCommand() &&
                words[4] <= sessionWebGameJumpCommand() &&
                words[5] == 0)) &&
        words[6] == sessionWebMessageChecksum(words, 6)
}

Bool validSessionWebGameProbe(Int[] words) {
    return words.length == 5 &&
        words[0] == sessionWebGameProtocolVersion() &&
        words[1] == sessionWebGameKind() &&
        words[2] > 0 && words[2] <= 1000000 &&
        words[3] == sessionWebGameProbePayload() &&
        words[4] == sessionWebMessageChecksum(words, 4)
}

Int[] newSessionWebGameSceneSnapshot(
    Int sequence, Int tick, Int position, Int health,
    Int stamina, Int combo, Int vfx,
    Int actor0Health, Int actor1Health, Int actor2Health,
    Int projectileX, Int projectileZ, Int projectileTtl
) {
    if (sequence <= 0 || sequence > 1000000 ||
        tick < 0 || tick > sessionWebGameMaximumTick() ||
        position < sessionWebGameMinimumPosition() ||
        position > sessionWebGameMaximumPosition() ||
        health < 0 || health > sessionWebGameMaximumHealth() ||
        stamina < 0 || stamina > sessionWebGameMaximumStamina() ||
        combo < 0 || combo > sessionWebGameMaximumCombo() ||
        vfx < 0 || vfx > sessionWebGameMaximumVfx() ||
        actor0Health < 0 || actor0Health > sessionWebGameMaximumHealth() ||
        actor1Health < 0 || actor1Health > sessionWebGameMaximumHealth() ||
        actor2Health < 0 || actor2Health > sessionWebGameMaximumHealth() ||
        projectileX < sessionWebGameMinimumPosition() ||
        projectileX > sessionWebGameMaximumPosition() ||
        projectileZ < sessionWebGameMinimumDepth() ||
        projectileZ > sessionWebGameMaximumDepth() ||
        projectileTtl < 0 || projectileTtl > 6) {
        return new Int[0]
    }
    var words = new Int[30]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebGameKind()
    words[2] = sequence
    words[3] = sessionWebGameSceneSnapshotMarker()
    words[4] = tick
    words[5] = position
    words[6] = 0
    words[7] = 0
    words[8] = health
    words[9] = stamina
    words[10] = combo
    words[11] = vfx
    words[12] = 3
    words[13] = 1
    words[14] = -70
    words[15] = 24
    words[16] = actor0Health
    words[17] = 2
    words[18] = 8
    words[19] = -26
    words[20] = actor1Health
    words[21] = 3
    words[22] = 72
    words[23] = 18
    words[24] = actor2Health
    if (projectileTtl > 0) {
        words[25] = 1
        words[26] = projectileX
        words[27] = projectileZ
    } else {
        words[25] = 0
        words[26] = 0
        words[27] = 0
    }
    words[28] = projectileTtl
    words[29] = sessionWebMessageChecksum(words, 29)
    return words
}

Bool validSessionWebGameSceneSnapshot(Int[] words) {
    return words.length == 30 &&
        words[0] == sessionWebGameProtocolVersion() &&
        words[1] == sessionWebGameKind() &&
        words[2] > 0 && words[2] <= 1000000 &&
        words[3] == sessionWebGameSceneSnapshotMarker() &&
        words[4] >= 0 && words[4] <= sessionWebGameMaximumTick() &&
        words[5] >= sessionWebGameMinimumPosition() &&
        words[5] <= sessionWebGameMaximumPosition() &&
        words[6] >= sessionWebGameMinimumDepth() &&
        words[6] <= sessionWebGameMaximumDepth() &&
        words[8] >= 0 && words[8] <= sessionWebGameMaximumHealth() &&
        words[9] >= 0 && words[9] <= sessionWebGameMaximumStamina() &&
        words[10] >= 0 && words[10] <= sessionWebGameMaximumCombo() &&
        words[11] >= 0 && words[11] <= sessionWebGameMaximumVfx() &&
        words[12] == 3 &&
        words[16] >= 0 && words[16] <= sessionWebGameMaximumHealth() &&
        words[20] >= 0 && words[20] <= sessionWebGameMaximumHealth() &&
        words[24] >= 0 && words[24] <= sessionWebGameMaximumHealth() &&
        words[25] >= 0 && words[25] <= 1 &&
        words[26] >= sessionWebGameMinimumPosition() &&
        words[26] <= sessionWebGameMaximumPosition() &&
        words[27] >= sessionWebGameMinimumDepth() &&
        words[27] <= sessionWebGameMaximumDepth() &&
        words[28] >= 0 && words[28] <= 6 &&
        words[29] == sessionWebMessageChecksum(words, 29)
}
Bool setSessionWebGameSceneObject(
    Int[] words, Int index, Int kind, Int objectId, Int state,
    Int x, Int y, Int z, Int sizeX, Int sizeY, Int sizeZ
) {
    var offset = sessionWebGameSceneObjectsOffset() +
        index * sessionWebGameSceneObjectEntryWidth()
    words[offset] = kind
    words[offset + 1] = objectId
    words[offset + 2] = state
    words[offset + 3] = x
    words[offset + 4] = y
    words[offset + 5] = z
    words[offset + 6] = sizeX
    words[offset + 7] = sizeY
    words[offset + 8] = sizeZ
    return true
}

Int[] newSessionWebGameFullSceneSnapshot(
    Int sequence, Int tick,
    Int playerX, Int playerY, Int playerZ, Int playerYaw, Int playerPitch,
    Int health, Int stamina, Int ammo, Int combo, Int vfx,
    Int cameraX, Int cameraY, Int cameraZ, Int cameraYaw, Int cameraPitch,
    Int playerState, Int[] actors, Int[] projectile, Int[] pickup,
    Int vfxX, Int vfxY, Int vfxZ
) {
    if (sequence <= 0 || sequence > 1000000 ||
        actors.length != 32 || projectile.length != 6 ||
        pickup.length != 5) {
        return new Int[0]
    }
    var objectCount = 9
    if (pickup[0] == 1) { objectCount = 10 }
    var labelCount = 4
    var labelsOffset = sessionWebGameSceneObjectsOffset() +
        objectCount * sessionWebGameSceneObjectEntryWidth()
    var words = new Int[
        labelsOffset + 1 +
        labelCount * sessionWebSceneLabelEntryWidth() + 1]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebGameKind()
    words[2] = sequence
    words[3] = sessionWebGameFullSceneSnapshotMarker()
    words[4] = tick
    words[5] = playerX
    words[6] = playerY
    words[7] = playerZ
    words[8] = playerYaw
    words[9] = playerPitch
    words[10] = health
    words[11] = stamina
    words[12] = ammo
    words[13] = combo
    words[14] = vfx
    words[15] = cameraX
    words[16] = cameraY
    words[17] = cameraZ
    words[18] = cameraYaw
    words[19] = cameraPitch
    words[20] = 4
    for (var actorIndex = 0; actorIndex < actors.length;
         actorIndex = actorIndex + 1) {
        words[21 + actorIndex] = actors[actorIndex]
    }
    for (var projectileIndex = 0; projectileIndex < projectile.length;
         projectileIndex = projectileIndex + 1) {
        words[53 + projectileIndex] = projectile[projectileIndex]
    }
    for (var pickupIndex = 0; pickupIndex < pickup.length;
         pickupIndex = pickupIndex + 1) {
        words[59 + pickupIndex] = pickup[pickupIndex]
    }
    words[64] = vfxX
    words[65] = vfxY
    words[66] = vfxZ
    words[67] = playerState
    words[68] = objectCount
    if (!setSessionWebGameSceneObject(
            words, 0, sessionWebGameSceneObjectDoor(), 2, 0,
            5, 5, 5, 3, 5, 1) ||
        !setSessionWebGameSceneObject(
            words, 1, sessionWebGameSceneObjectFloatable(), 1, 1,
            150, 9, 140, 2, 2, 2) ||
        !setSessionWebGameSceneObject(
            words, 2, sessionWebGameSceneObjectFloatable(), 2, 0,
            180, 9, 150, 2, 2, 2) ||
        !setSessionWebGameSceneObject(
            words, 3, sessionWebGameSceneObjectPowerUp(), 1, 1,
            32, 1, 52, 2, 2, 2) ||
        !setSessionWebGameSceneObject(
            words, 4, sessionWebGameSceneObjectPowerUp(), 2, 1,
            72, 1, 64, 3, 3, 3) ||
        !setSessionWebGameSceneObject(
            words, 5, sessionWebGameSceneObjectPowerUp(), 3, 1,
            120, 1, 96, 2, 2, 2) ||
        !setSessionWebGameSceneObject(
            words, 6, sessionWebGameSceneObjectPowerUp(), 4, 1,
            150, 5, 140, 3, 3, 3) ||
        !setSessionWebGameSceneObject(
            words, 7, sessionWebGameSceneObjectPowerUp(), 5, 1,
            260, 1, 60, 2, 2, 2) ||
        !setSessionWebGameSceneObject(
            words, 8, sessionWebGameSceneObjectPowerUp(), 6, 1,
            200, 1, 120, 2, 2, 2)) {
        return new Int[0]
    }
    if (pickup[0] == 1 &&
        !setSessionWebGameSceneObject(
            words, 9, sessionWebGameSceneObjectLootBeam(), 100,
            pickup[1], pickup[2], pickup[3], pickup[4], 2, 4, 2)) {
        return new Int[0]
    }
    words[labelsOffset] = labelCount
    for (var actorIndex = 0; actorIndex < labelCount;
         actorIndex = actorIndex + 1) {
        var actorOffset = actorIndex * 8
        var labelOffset = labelsOffset + 1 +
            actorIndex * sessionWebSceneLabelEntryWidth()
        words[labelOffset] = actors[actorOffset]
        words[labelOffset + 1] = actorIndex + 1
        words[labelOffset + 2] = actors[actorOffset + 1]
        words[labelOffset + 3] = actors[actorOffset + 2]
        words[labelOffset + 4] = actors[actorOffset + 3]
        words[labelOffset + 5] =
            if (actors[actorOffset + 4] > 0) 1 else 0
    }
    words[words.length - 1] =
        sessionWebMessageChecksum(words, words.length - 1)
    if (!validSessionWebGameFullSceneSnapshot(words)) {
        return new Int[0]
    }
    return words
}

Bool validSessionWebGameFullSceneSnapshot(Int[] words) {
    if (words.length < 70 ||
        words.length > sessionWebMaximumWords() ||
        words[0] != sessionWebGameProtocolVersion() ||
        words[1] != sessionWebGameKind() ||
        words[2] <= 0 || words[2] > 1000000 ||
        words[3] != sessionWebGameFullSceneSnapshotMarker() ||
        words[4] < 0 || words[4] > sessionWebGameMaximumTick() ||
        words[5] < sessionWebGameWorldMinimumX() ||
        words[5] > sessionWebGameWorldMaximumX() ||
        words[6] < sessionWebGameWorldMinimumY() ||
        words[6] > sessionWebGameWorldMaximumY() ||
        words[7] < sessionWebGameWorldMinimumZ() ||
        words[7] > sessionWebGameWorldMaximumZ() ||
        words[8] < 0 || words[8] > 359 ||
        words[9] < -90 || words[9] > 90 ||
        words[10] < 0 || words[10] > sessionWebGameMaximumHealth() ||
        words[11] < 0 || words[11] > sessionWebGameMaximumStamina() ||
        words[12] < 0 || words[12] > sessionWebGameMaximumAmmo() ||
        words[13] < 0 || words[13] > sessionWebGameMaximumCombo() ||
        words[14] < 0 || words[14] > sessionWebGameMaximumVfx() ||
        words[15] < sessionWebGameWorldMinimumX() ||
        words[15] > sessionWebGameWorldMaximumX() ||
        words[16] < sessionWebGameWorldMinimumY() ||
        words[16] > sessionWebGameWorldMaximumY() + 16 ||
        words[17] < sessionWebGameWorldMinimumZ() - 16 ||
        words[17] > sessionWebGameWorldMaximumZ() ||
        words[18] < 0 || words[18] > 359 ||
        words[19] < -90 || words[19] > 90 ||
        words[20] != 4 ||
        words[53] < 0 || words[53] > 1 ||
        words[59] < 0 || words[59] > 1 ||
        words[60] < 0 ||
        words[60] > sessionWebGameMaximumPickupKind() ||
        words[67] < 1 || words[67] > 4) {
        return false
    }
    for (var actor = 0; actor < 4; actor = actor + 1) {
        var offset = 21 + actor * 8
        if (words[offset] <= 0 ||
            words[offset + 1] < sessionWebGameWorldMinimumX() ||
            words[offset + 1] > sessionWebGameWorldMaximumX() ||
            words[offset + 2] < sessionWebGameWorldMinimumY() ||
            words[offset + 2] > sessionWebGameWorldMaximumY() ||
            words[offset + 3] < sessionWebGameWorldMinimumZ() ||
            words[offset + 3] > sessionWebGameWorldMaximumZ() ||
            words[offset + 4] < 0 ||
            words[offset + 4] > sessionWebGameMaximumHealth() ||
            words[offset + 5] < 1 || words[offset + 5] > 4 ||
            words[offset + 6] < 1 || words[offset + 6] > 2 ||
            words[offset + 7] < 0 || words[offset + 7] > 359) {
            return false
        }
    }
    if (words[53] == 0 &&
        (words[54] != 0 || words[55] != 0 ||
            words[56] != 0 || words[57] != 0 || words[58] != 0)) {
        return false
    }
    if (words[53] == 1 &&
        (words[54] != 1 ||
            words[55] < sessionWebGameWorldMinimumX() ||
            words[55] > sessionWebGameWorldMaximumX() ||
            words[56] < sessionWebGameWorldMinimumY() ||
            words[56] > sessionWebGameWorldMaximumY() ||
            words[57] < sessionWebGameWorldMinimumZ() ||
            words[57] > sessionWebGameWorldMaximumZ() ||
            words[58] < 1 || words[58] > 10)) {
        return false
    }
    if (words[59] == 0 &&
        (words[60] != 0 || words[61] != 0 ||
            words[62] != 0 || words[63] != 0)) {
        return false
    }
    if (words[59] == 1 &&
        (words[61] < sessionWebGameWorldMinimumX() ||
            words[61] > sessionWebGameWorldMaximumX() ||
            words[62] < sessionWebGameWorldMinimumY() ||
            words[62] > sessionWebGameWorldMaximumY() ||
            words[63] < sessionWebGameWorldMinimumZ() ||
            words[63] > sessionWebGameWorldMaximumZ())) {
        return false
    }
    if (words[64] < sessionWebGameWorldMinimumX() ||
        words[64] > sessionWebGameWorldMaximumX() ||
        words[65] < sessionWebGameWorldMinimumY() ||
        words[65] > sessionWebGameWorldMaximumY() ||
        words[66] < sessionWebGameWorldMinimumZ() ||
        words[66] > sessionWebGameWorldMaximumZ()) {
        return false
    }
    var objectCount = words[68]
    if (objectCount < 0 ||
        objectCount > sessionWebGameMaximumSceneObjects()) {
        return false
    }
    var labelsOffset = sessionWebGameSceneObjectsOffset() +
        objectCount * sessionWebGameSceneObjectEntryWidth()
    if (labelsOffset >= words.length) { return false }
    var labelCount = words[labelsOffset]
    if (labelCount < 0 ||
        labelCount > sessionWebGameMaximumSceneLabels() ||
        words.length != labelsOffset + 1 +
            labelCount * sessionWebSceneLabelEntryWidth() + 1) {
        return false
    }
    for (var objectIndex = 0; objectIndex < objectCount;
         objectIndex = objectIndex + 1) {
        var offset = sessionWebGameSceneObjectsOffset() +
            objectIndex * sessionWebGameSceneObjectEntryWidth()
        var kind = words[offset]
        var state = words[offset + 2]
        if (kind < sessionWebGameSceneObjectDoor() ||
            kind > sessionWebGameSceneObjectLootBeam() ||
            words[offset + 1] <= 0 ||
            words[offset + 3] < sessionWebGameWorldMinimumX() ||
            words[offset + 3] > sessionWebGameWorldMaximumX() ||
            words[offset + 4] < sessionWebGameWorldMinimumY() ||
            words[offset + 4] > sessionWebGameWorldMaximumY() ||
            words[offset + 5] < sessionWebGameWorldMinimumZ() ||
            words[offset + 5] > sessionWebGameWorldMaximumZ() ||
            words[offset + 6] <= 0 || words[offset + 6] > 32 ||
            words[offset + 7] <= 0 || words[offset + 7] > 32 ||
            words[offset + 8] <= 0 || words[offset + 8] > 32) {
            return false
        }
        if (kind == sessionWebGameSceneObjectLootBeam()) {
            if (state < 1 || state > 3) { return false }
        } else if (state < 0 || state > 1) {
            return false
        }
    }
    for (var labelIndex = 0; labelIndex < labelCount;
         labelIndex = labelIndex + 1) {
        var labelOffset = labelsOffset + 1 +
            labelIndex * sessionWebSceneLabelEntryWidth()
        if (words[labelOffset] <= 0 ||
            words[labelOffset + 1] <
                sessionWebGameSceneLabelLocal() ||
            words[labelOffset + 1] >
                sessionWebGameSceneLabelPond() ||
            words[labelOffset + 2] < sessionWebGameWorldMinimumX() ||
            words[labelOffset + 2] > sessionWebGameWorldMaximumX() ||
            words[labelOffset + 3] < sessionWebGameWorldMinimumY() ||
            words[labelOffset + 3] > sessionWebGameWorldMaximumY() ||
            words[labelOffset + 4] < sessionWebGameWorldMinimumZ() ||
            words[labelOffset + 4] > sessionWebGameWorldMaximumZ() ||
            words[labelOffset + 5] < 0 ||
            words[labelOffset + 5] > 1) {
            return false
        }
    }
    return words[words.length - 1] ==
        sessionWebMessageChecksum(words, words.length - 1)
}

Int[] newSessionWebGameSnapshot(
    Int sequence, Int tick, Int position, Int health,
    Int stamina, Int combo, Int vfx
) {
    if (sequence <= 0 || sequence > 1000000 ||
        tick < 0 || tick > sessionWebGameMaximumTick() ||
        position < sessionWebGameMinimumPosition() ||
        position > sessionWebGameMaximumPosition() ||
        health < 0 || health > sessionWebGameMaximumHealth() ||
        stamina < 0 || stamina > sessionWebGameMaximumStamina() ||
        combo < 0 || combo > sessionWebGameMaximumCombo() ||
        vfx < 0 || vfx > sessionWebGameMaximumVfx()) {
        return new Int[0]
    }
    var words = new Int[11]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebGameKind()
    words[2] = sequence
    words[3] = sessionWebGameSnapshotMarker()
    words[4] = tick
    words[5] = position
    words[6] = health
    words[7] = stamina
    words[8] = combo
    words[9] = vfx
    words[10] = sessionWebMessageChecksum(words, 10)
    return words
}

Bool validSessionWebGameSnapshot(Int[] words) {
    return words.length == 11 &&
        words[0] == sessionWebGameProtocolVersion() &&
        words[1] == sessionWebGameKind() &&
        words[2] > 0 && words[2] <= 1000000 &&
        words[3] == sessionWebGameSnapshotMarker() &&
        words[4] >= 0 && words[4] <= sessionWebGameMaximumTick() &&
        words[5] >= sessionWebGameMinimumPosition() &&
        words[5] <= sessionWebGameMaximumPosition() &&
        words[6] >= 0 && words[6] <= sessionWebGameMaximumHealth() &&
        words[7] >= 0 && words[7] <= sessionWebGameMaximumStamina() &&
        words[8] >= 0 && words[8] <= sessionWebGameMaximumCombo() &&
        words[9] >= 0 && words[9] <= sessionWebGameMaximumVfx() &&
        words[10] == sessionWebMessageChecksum(words, 10)
}
