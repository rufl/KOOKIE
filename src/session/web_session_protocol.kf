        words[31] >= sessionWebGameWorldMinimumY() &&
        words[31] <= sessionWebGameWorldMaximumY() &&
        words[32] >= sessionWebGameWorldMinimumZ() &&
        words[32] <= sessionWebGameWorldMaximumZ() &&
        words[33] >= 0 && words[33] <= sessionWebGameMaximumHealth() &&
        words[34] >= 1 && words[34] <= 4 &&
        words[35] >= 1 && words[35] <= 2 &&
        words[36] >= 0 && words[36] <= 359 &&
        words[38] >= sessionWebGameWorldMinimumX() &&
        words[38] <= sessionWebGameWorldMaximumX() &&
        words[39] >= sessionWebGameWorldMinimumY() &&
        words[39] <= sessionWebGameWorldMaximumY() &&
        words[40] >= sessionWebGameWorldMinimumZ() &&
