        words[50] >= 1 && words[50] <= 4 &&
        words[51] >= 1 && words[51] <= 2 &&
        words[52] >= 0 && words[52] <= 359 &&
        words[53] >= 0 && words[53] <= 1 &&
        ((words[54] == 0 && words[55] == 0 &&
            words[56] == 0 && words[57] == 0 && words[58] == 0) ||
            (words[54] == 1 &&
