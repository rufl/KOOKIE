        words[16] <= sessionWebGameWorldMaximumY() + 16 &&
        words[17] >= sessionWebGameWorldMinimumZ() - 16 &&
        words[17] <= sessionWebGameWorldMaximumZ() &&
        words[18] >= 0 && words[18] <= 359 &&
        words[19] >= -90 && words[19] <= 90 &&
        words[20] == 4 &&
        words[22] >= sessionWebGameWorldMinimumX() &&
        words[22] <= sessionWebGameWorldMaximumX() &&
        words[24] >= sessionWebGameWorldMinimumZ() &&
        words[24] <= sessionWebGameWorldMaximumZ() &&
        words[25] >= 0 && words[25] <= sessionWebGameMaximumHealth() &&
        words[26] >= 1 && words[26] <= 4 &&
        words[27] >= 1 && words[27] <= 2 &&
        words[29] >= sessionWebGameWorldMinimumX() &&
        words[29] <= sessionWebGameWorldMaximumX() &&
        words[31] >= sessionWebGameWorldMinimumZ() &&
        words[31] <= sessionWebGameWorldMaximumZ() &&
        words[32] >= 0 && words[32] <= sessionWebGameMaximumHealth() &&
        words[33] >= 1 && words[33] <= 4 &&
        words[34] >= 1 && words[34] <= 2 &&
        words[36] >= sessionWebGameWorldMinimumX() &&
        words[36] <= sessionWebGameWorldMaximumX() &&
        words[38] >= sessionWebGameWorldMinimumZ() &&
        words[38] <= sessionWebGameWorldMaximumZ() &&
        words[39] >= 0 && words[39] <= sessionWebGameMaximumHealth() &&
        words[40] >= 1 && words[40] <= 4 &&
        words[41] >= 1 && words[41] <= 2 &&
        words[43] >= sessionWebGameWorldMinimumX() &&
        words[43] <= sessionWebGameWorldMaximumX() &&
        words[45] >= sessionWebGameWorldMinimumZ() &&
        words[45] <= sessionWebGameWorldMaximumZ() &&
        words[46] >= 0 && words[46] <= sessionWebGameMaximumHealth() &&
        words[47] >= 1 && words[47] <= 4 &&
        words[48] >= 1 && words[48] <= 2 &&
        words[49] >= 0 && words[49] <= 1 &&
        ((words[50] == 0 && words[51] == 0 && words[52] == 0 &&
            words[53] == 0 && words[54] == 0) ||
            (words[50] == 1 &&
                words[51] >= sessionWebGameWorldMinimumX() &&
                words[51] <= sessionWebGameWorldMaximumX() &&
                words[52] >= sessionWebGameWorldMinimumY() &&
                words[52] <= sessionWebGameWorldMaximumY() &&
                words[53] >= sessionWebGameWorldMinimumZ() &&
                words[53] <= sessionWebGameWorldMaximumZ() &&
                words[54] >= 1 && words[54] <= 10)) &&
        (words[55] == 0 || words[55] == 1) &&
        words[56] >= 0 && words[56] <= sessionWebGameMaximumPickupKind() &&
        words[57] >= sessionWebGameWorldMinimumX() &&
        words[57] <= sessionWebGameWorldMaximumX() &&
        words[58] >= sessionWebGameWorldMinimumY() &&
        words[58] <= sessionWebGameWorldMaximumY() &&
        words[59] >= sessionWebGameWorldMinimumZ() &&
        words[59] <= sessionWebGameWorldMaximumZ() &&
        words[60] == sessionWebMessageChecksum(words, 60)
}

Int[] newSessionWebGameSnapshot(
    Int sequence, Int tick, Int position, Int health,
    Int stamina, Int combo, Int vfx
) {
    if (sequence <= 0 || sequence > 1000000 ||
        tick < 0 || tick > sessionWebGameMaximumTick() ||
        position < sessionWebGameMinimumPosition() ||
        position > sessionWebGameMaximumPosition() ||
        health < 0 || health > sessionWebGameMaximumHealth() ||
        stamina < 0 || stamina > sessionWebGameMaximumStamina() ||
        combo < 0 || combo > sessionWebGameMaximumCombo() ||
        vfx < 0 || vfx > sessionWebGameMaximumVfx()) {
        return new Int[0]
    }
    var words = new Int[11]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebGameKind()
    words[2] = sequence
    words[3] = sessionWebGameSnapshotMarker()
    words[4] = tick
    words[5] = position
    words[6] = health
    words[7] = stamina
    words[8] = combo
    words[9] = vfx
    words[10] = sessionWebMessageChecksum(words, 10)
    return words
}

Bool validSessionWebGameSnapshot(Int[] words) {
    return words.length == 11 &&
        words[0] == sessionWebGameProtocolVersion() &&
        words[1] == sessionWebGameKind() &&
        words[2] > 0 && words[2] <= 1000000 &&
        words[3] == sessionWebGameSnapshotMarker() &&
        words[4] >= 0 && words[4] <= sessionWebGameMaximumTick() &&
        words[5] >= sessionWebGameMinimumPosition() &&
        words[5] <= sessionWebGameMaximumPosition() &&
        words[6] >= 0 && words[6] <= sessionWebGameMaximumHealth() &&
        words[7] >= 0 && words[7] <= sessionWebGameMaximumStamina() &&
        words[8] >= 0 && words[8] <= sessionWebGameMaximumCombo() &&
        words[9] >= 0 && words[9] <= sessionWebGameMaximumVfx() &&
        words[10] == sessionWebMessageChecksum(words, 10)
}
