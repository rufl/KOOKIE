Int[] newSessionWebGameInput(
    Int sequence, Int tick, Int moveX, Int moveZ,
    Int lookYaw, Int lookPitch, Int heldActions, Int edgeActions
) {
    if (sequence <= 0 || sequence > 1000000 ||
        tick < 0 || tick > sessionWebGameMaximumTick() ||
        moveX < -sessionWebGameMaximumInputAxis() ||
        moveX > sessionWebGameMaximumInputAxis() ||
        moveZ < -sessionWebGameMaximumInputAxis() ||
        moveZ > sessionWebGameMaximumInputAxis() ||
        lookYaw < -sessionWebGameMaximumLookDelta() ||
        lookYaw > sessionWebGameMaximumLookDelta() ||
        lookPitch < -sessionWebGameMaximumLookDelta() ||
        lookPitch > sessionWebGameMaximumLookDelta() ||
        heldActions < 0 || heldActions > 511 ||
        edgeActions < 0 || edgeActions > 511) {
        return new Int[0]
    }
    var words = new Int[12]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebGameKind()
    words[2] = sequence
    words[3] = sessionWebGameInputMarker()
    words[4] = tick
    words[5] = moveX
    words[6] = moveZ
    words[7] = lookYaw
    words[8] = lookPitch
    words[9] = heldActions
    words[10] = edgeActions
    words[11] = sessionWebMessageChecksum(words, 11)
    return words
}

Bool validSessionWebGameInput(Int[] words) {
    return words.length == 12 &&
        words[0] == sessionWebGameProtocolVersion() &&
        words[1] == sessionWebGameKind() &&
        words[2] > 0 && words[2] <= 1000000 &&
        words[3] == sessionWebGameInputMarker() &&
        words[4] >= 0 && words[4] <= sessionWebGameMaximumTick() &&
        words[5] >= -sessionWebGameMaximumInputAxis() &&
        words[5] <= sessionWebGameMaximumInputAxis() &&
        words[6] >= -sessionWebGameMaximumInputAxis() &&
        words[6] <= sessionWebGameMaximumInputAxis() &&
        words[7] >= -sessionWebGameMaximumLookDelta() &&
        words[7] <= sessionWebGameMaximumLookDelta() &&
        words[8] >= -sessionWebGameMaximumLookDelta() &&
        words[8] <= sessionWebGameMaximumLookDelta() &&
        words[9] >= 0 && words[9] <= 511 &&
        words[10] >= 0 && words[10] <= 511 &&
        words[11] == sessionWebMessageChecksum(words, 11)
}

