Int sessionWebChecksumMix(Int state, Int value) {
    var normalized = value % 1000003
    if (normalized < 0) { normalized = normalized + 1000003 }
    return (state * 31 + normalized) % 1000003
}

Int sessionWebMessageChecksum(Int[] words, Int length) {
    if (length <= 0 || length > words.length) { return -1 }
    var result = 53
    for (var index = 0; index < length; index = index + 1) {
        result = sessionWebChecksumMix(result, words[index])
    }
    return result
}

Int[] newSessionWebHello(Int sequence) {
    if (sequence <= 0 || sequence > 1000000) {
        return new Int[0]
    }
    var words = new Int[8]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebHelloKind()
    words[2] = sequence
    words[3] = sessionClientTargetBrowser()
    words[4] = sessionAuthorityRemote()
    words[5] = sessionGameWebSocket()
    words[6] = sessionWebBrowserCapability()
    words[7] = sessionWebMessageChecksum(words, 7)
    return words
}

Int[] newSessionWebNativeDesktopHello(Int sequence) {
    if (sequence <= 0 || sequence > 1000000) {
        return new Int[0]
    }
    var words = new Int[8]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebHelloKind()
    words[2] = sequence
    words[3] = sessionClientTargetNativeDesktop()
    words[4] = sessionAuthorityRemote()
    words[5] = sessionGameWebSocket()
    words[6] = sessionWebNativeDesktopCapability()
    words[7] = sessionWebMessageChecksum(words, 7)
    return words
}

Bool validSessionWebHello(Int[] words) {
    if (words.length != 8 ||
        words[0] != sessionWebGameProtocolVersion() ||
        words[1] != sessionWebHelloKind() ||
        words[2] <= 0 || words[2] > 1000000 ||
        words[4] != sessionAuthorityRemote() ||
        words[5] != sessionGameWebSocket() ||
        words[7] != sessionWebMessageChecksum(words, 7)) {
        return false
    }
    return (words[3] == sessionClientTargetBrowser() &&
            words[6] == sessionWebBrowserCapability()) ||
        (words[3] == sessionClientTargetNativeDesktop() &&
            words[6] == sessionWebNativeDesktopCapability())
}

Int[] newSessionWebAck(Int sequence, Bool accepted) {
    if (sequence <= 0 || sequence > 1000000) {
        return new Int[0]
    }
    var acceptedValue = 0
    if (accepted) { acceptedValue = 1 }
    var words = new Int[7]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebAckKind()
    words[2] = sequence
    words[3] = acceptedValue
    words[4] = sessionGameWebSocket()
    words[5] = sessionWebServerCapability()
    words[6] = sessionWebMessageChecksum(words, 6)
    return words
}

Bool validSessionWebAck(Int[] words) {
    return words.length == 7 &&
        words[0] == sessionWebGameProtocolVersion() &&
        words[1] == sessionWebAckKind() &&
        words[2] > 0 && words[2] <= 1000000 &&
        (words[3] == 0 || words[3] == 1) &&
        words[4] == sessionGameWebSocket() &&
        words[5] == sessionWebServerCapability() &&
        words[6] == sessionWebMessageChecksum(words, 6)
}

Int[] newSessionWebPing(Int kind, Int sequence) {
    if ((kind != sessionWebPingKind() && kind != sessionWebPongKind()) ||
        sequence <= 0 || sequence > 1000000) {
        return new Int[0]
    }
    var words = new Int[4]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = kind
    words[2] = sequence
    words[3] = sessionWebMessageChecksum(words, 3)
    return words
}

Bool validSessionWebPing(Int[] words, Int kind) {
    return words.length == 4 &&
        (kind == sessionWebPingKind() || kind == sessionWebPongKind()) &&
        words[0] == sessionWebGameProtocolVersion() &&
        words[1] == kind && words[2] > 0 && words[2] <= 1000000 &&
        words[3] == sessionWebMessageChecksum(words, 3)
}

Int[] newSessionWebGameCommand(Int sequence, Int command) {
    if (sequence <= 0 || sequence > 1000000 ||
        (command < sessionWebGameMoveLeftCommand() ||
            command > sessionWebGameLookDownCommand())) {
    }
    var words = new Int[7]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebGameKind()
    words[2] = sequence
    words[3] = sessionWebGameCommandMarker()
    words[4] = command
    words[5] = 0
    if (command == sessionWebGameMoveLeftCommand() ||
        command == sessionWebGameStrafeLeftCommand() ||
        command == sessionWebGameMoveBackCommand()) {
        words[5] = -8
    } else if (command == sessionWebGameMoveRightCommand() ||
        command == sessionWebGameMoveForwardCommand() ||
        command == sessionWebGameStrafeRightCommand()) {
        words[5] = 8
    } else if (command == sessionWebGameLookLeftCommand()) {
        words[5] = -15
    } else if (command == sessionWebGameLookRightCommand() ||
        command == sessionWebGameLookUpCommand()) {
        words[5] = 15
    } else if (command == sessionWebGameLookDownCommand()) {
        words[5] = -15
    }
    words[6] = sessionWebMessageChecksum(words, 6)
    return words
}

Int[] newSessionWebGameSceneProbe(Int sequence) {
    return newSessionWebGameCommand(sequence, sessionWebGameSceneProbeCommand())
}

Int[] newSessionWebGameFullSceneProbe(Int sequence) {
    return newSessionWebGameCommand(
        sequence, sessionWebGameFullSceneProbeCommand()
    )
}

Int[] newSessionWebGameJoinRequest(Int sequence, Int role) {
    if (sequence <= 0 || sequence > 1000000 ||
        (role != sessionWebRolePlayer() &&
            role != sessionWebRoleSpectator() &&
            role != sessionWebRoleTraining())) {
        return new Int[0]
    }
    var words = new Int[6]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebGameKind()
    words[2] = sequence
    words[3] = sessionWebGameJoinRequestMarker()
    words[4] = role
    words[5] = sessionWebMessageChecksum(words, 5)
    return words
}

Bool validSessionWebGameJoinRequest(Int[] words) {
    if ((words.length != 6 && words.length != 7) ||
        words[0] != sessionWebGameProtocolVersion() ||
        words[1] != sessionWebGameKind() ||
        words[2] <= 0 || words[2] > 1000000 ||
        words[3] != sessionWebGameJoinRequestMarker() ||
        (words[4] != sessionWebRolePlayer() &&
            words[4] != sessionWebRoleSpectator() &&
            words[4] != sessionWebRoleTraining())) {
        return false
    }
    if (words.length == 6) {
        return words[5] == sessionWebMessageChecksum(words, 5)
    }
    return words[4] == sessionWebRolePlayer() &&
        words[5] >= 0 && words[5] <= 2 &&
        words[6] == sessionWebMessageChecksum(words, 6)
}

Int[] newSessionWebGameJoinRequestWithTeam(
    Int sequence, Int role, Int team
) {
    if (sequence <= 0 || sequence > 1000000 ||
        role != sessionWebRolePlayer() || team < 0 || team > 2) {
        return new Int[0]
    }
    var words = new Int[7]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebGameKind()
    words[2] = sequence
    words[3] = sessionWebGameJoinRequestMarker()
    words[4] = role
    words[5] = team
    words[6] = sessionWebMessageChecksum(words, 6)
    return words
}

Int[] newSessionWebGameChat(
    Int sequence, Int channel, Int target, Int[] text
) {
    if (sequence <= 0 || sequence > 1000000 ||
        channel < sessionWebChatGlobal() ||
        channel > sessionWebChatWhisper() || text.length < 1 ||
        text.length > 80 ||
        (channel == sessionWebChatGlobal() && target != 0) ||
        (channel == sessionWebChatTeam() && (target < 1 || target > 2)) ||
        (channel == sessionWebChatWhisper() && (target <= 0 || target > 1000000))) {
        return new Int[0]
    }
    var words = new Int[9 + text.length]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebGameKind()
    words[2] = sequence
    words[3] = sessionWebGameChatMarker()
    words[4] = channel
    words[5] = target
    words[6] = text.length
    words[7] = 0
    for (var index = 0; index < text.length; index = index + 1) {
        if (text[index] < 32 || text[index] > 126) { return new Int[0] }
        words[8 + index] = text[index]
    }
    words[words.length - 1] =
        sessionWebMessageChecksum(words, words.length - 1)
    return words
}

Bool validSessionWebGameChat(Int[] words) {
    if (words.length < 10 || words.length > 89 ||
        words[0] != sessionWebGameProtocolVersion() ||
        words[1] != sessionWebGameKind() ||
        words[2] <= 0 || words[2] > 1000000 ||
        (words[3] != sessionWebGameChatMarker() &&
            words[3] != sessionWebGameChatResponseMarker()) ||
        words[4] < sessionWebChatGlobal() ||
        words[4] > sessionWebChatWhisper() ||
        words[6] < 1 || words[6] > 80 ||
        words.length != 9 + words[6] ||
        (words[3] == sessionWebGameChatMarker() && words[7] != 0) ||
        (words[3] == sessionWebGameChatResponseMarker() &&
            (words[7] <= 0 || words[7] > 1000000))) {
        return false
    }
    if ((words[4] == sessionWebChatGlobal() && words[5] != 0) ||
        (words[4] == sessionWebChatTeam() &&
            (words[5] < 1 || words[5] > 2)) ||
        (words[4] == sessionWebChatWhisper() &&
            (words[5] <= 0 || words[5] > 1000000))) {
        return false
    }
    for (var index = 0; index < words[6]; index = index + 1) {
        if (words[8 + index] < 32 || words[8 + index] > 126) {
            return false
        }
    }
    return words[words.length - 1] ==
        sessionWebMessageChecksum(words, words.length - 1)
}

Int[] newSessionWebGameJoinResponse(
    Int sequence, Bool accepted, Int role, Int playerId,
    Int playerCount, Int spectatorCount
) {
    if (sequence <= 0 || sequence > 1000000 ||
        (role != sessionWebRolePlayer() &&
            role != sessionWebRoleSpectator() &&
            role != sessionWebRoleTraining()) ||
        playerId < 0 || playerId > 1000000 ||
        playerCount < 0 || playerCount > 8 ||
        spectatorCount < 0 || spectatorCount > 4 ||
        (accepted && playerId == 0)) {
        return new Int[0]
    }
    var words = new Int[10]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebGameKind()
    words[2] = sequence
    words[3] = sessionWebGameJoinResponseMarker()
    words[4] = if (accepted) 1 else 0
    words[5] = role
    words[6] = playerId
    words[7] = playerCount
    words[8] = spectatorCount
    words[9] = sessionWebMessageChecksum(words, 9)
    return words
}

Bool validSessionWebGameJoinResponse(Int[] words) {
    return words.length == 10 &&
        words[0] == sessionWebGameProtocolVersion() &&
        words[1] == sessionWebGameKind() &&
        words[2] > 0 && words[2] <= 1000000 &&
        words[3] == sessionWebGameJoinResponseMarker() &&
        (words[4] == 0 || words[4] == 1) &&
        (words[5] == sessionWebRolePlayer() ||
            words[5] == sessionWebRoleSpectator() ||
            words[5] == sessionWebRoleTraining()) &&
        words[6] >= 0 && words[6] <= 1000000 &&
        words[7] >= 0 && words[7] <= 8 &&
        words[8] >= 0 && words[8] <= 4 &&
        (words[4] == 0 || words[6] > 0) &&
        words[9] == sessionWebMessageChecksum(words, 9)
}

Int[] newSessionWebGameMultiplayerSnapshot(
    Int sequence, Int tick, Int role, Int playerId,
    Int playerX, Int playerY, Int playerZ, Int yaw, Int pitch,
    Int playerCount, Int spectatorCount, Int[] actors
) {
    if (sequence <= 0 || sequence > 1000000 ||
        tick < 0 || tick > sessionWebGameMaximumTick() ||
        (role != sessionWebRolePlayer() &&
            role != sessionWebRoleSpectator() &&
            role != sessionWebRoleTraining()) ||
        playerId < 0 || playerId > 1000000 ||
        (role != sessionWebRoleSpectator() && playerId <= 0) ||
        (role == sessionWebRoleSpectator() && playerId != 0) ||
        playerX < sessionWebGameWorldMinimumX() ||
        playerX > sessionWebGameWorldMaximumX() ||
        playerY < sessionWebGameWorldMinimumY() ||
        playerY > sessionWebGameWorldMaximumY() ||
        playerZ < sessionWebGameWorldMinimumZ() ||
        playerZ > sessionWebGameWorldMaximumZ() ||
        yaw < 0 || yaw > 359 || pitch < -90 || pitch > 90 ||
        playerCount < 0 || playerCount > 8 ||
        spectatorCount < 0 || spectatorCount > 4 ||
        actors.length % 8 != 0 || actors.length > 64) {
        return new Int[0]
    }
    var count = actors.length / 8
    var words = new Int[19 + actors.length]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebGameKind()
    words[2] = sequence
    words[3] = sessionWebGameMultiplayerSnapshotMarker()
    words[4] = tick
    words[5] = role
    words[6] = playerId
    words[7] = playerX
    words[8] = playerY
    words[9] = playerZ
    words[10] = yaw
    words[11] = pitch
    words[12] = sessionWebGameMaximumHealth()
    words[13] = sessionWebGameMaximumStamina()
    words[14] = sessionWebGameMaximumAmmo()
    words[15] = playerCount
    words[16] = spectatorCount
    words[17] = count
    for (var index = 0; index < actors.length; index = index + 1) {
        words[18 + index] = actors[index]
    }
    words[words.length - 1] =
        sessionWebMessageChecksum(words, words.length - 1)
    if (!validSessionWebGameMultiplayerSnapshot(words)) {
        return new Int[0]
    }
    return words
}

Bool validSessionWebGameMultiplayerSnapshot(Int[] words) {
    if (words.length < 19 || words.length > sessionWebMaximumWords() ||
        words[0] != sessionWebGameProtocolVersion() ||
        words[1] != sessionWebGameKind() ||
        words[2] <= 0 || words[2] > 1000000 ||
        words[3] != sessionWebGameMultiplayerSnapshotMarker() ||
        words[4] < 0 || words[4] > sessionWebGameMaximumTick() ||
        (words[5] != sessionWebRolePlayer() &&
            words[5] != sessionWebRoleSpectator() &&
            words[5] != sessionWebRoleTraining()) ||
        words[6] < 0 || words[6] > 1000000 ||
        (words[5] != sessionWebRoleSpectator() && words[6] <= 0) ||
        (words[5] == sessionWebRoleSpectator() && words[6] != 0) ||
        words[7] < sessionWebGameWorldMinimumX() ||
        words[7] > sessionWebGameWorldMaximumX() ||
        words[8] < sessionWebGameWorldMinimumY() ||
        words[8] > sessionWebGameWorldMaximumY() ||
        words[9] < sessionWebGameWorldMinimumZ() ||
        words[9] > sessionWebGameWorldMaximumZ() ||
        words[10] < 0 || words[10] > 359 ||
        words[11] < -90 || words[11] > 90 ||
        words[12] < 0 || words[12] > sessionWebGameMaximumHealth() ||
        words[13] < 0 || words[13] > sessionWebGameMaximumStamina() ||
        words[14] < 0 || words[14] > sessionWebGameMaximumAmmo() ||
        words[15] < 0 || words[15] > 8 ||
        words[16] < 0 || words[16] > 4 ||
        words[17] < 0 || words[17] > 8 ||
        words[words.length - 1] !=
            sessionWebMessageChecksum(words, words.length - 1)) {
        return false
    }
    var actorCount = words[17]
    var trailer = 18 + actorCount * 8
    var legacyLength = 19 + actorCount * 8
    var extended = words.length != legacyLength
    var projectileCount = 0
    var throwableCount = 0
    var impactCount = 0
    if (extended) {
        if (words.length < trailer + 5) { return false }
        projectileCount = words[trailer + 1]
        throwableCount = words[trailer + 2]
        impactCount = words[trailer + 3]
        var extendedBaseLength = trailer + 5 + projectileCount * 8 +
            throwableCount * 8 + impactCount * 8
        var suffixLength = words.length - extendedBaseLength
        var validSuffixLength = suffixLength == 0 ||
            suffixLength == actorCount || suffixLength == 6 ||
            suffixLength == actorCount + 6 ||
            (suffixLength >= 10 && suffixLength <= 26 &&
                (suffixLength - 10) % 4 == 0) ||
            (suffixLength >= actorCount + 10 &&
                suffixLength <= actorCount + 26 &&
                (suffixLength - actorCount - 10) % 4 == 0)
        if (words[trailer] < 0 || words[trailer] > 1000000 ||
            projectileCount < 0 || projectileCount > 12 ||
            throwableCount < 0 || throwableCount > 4 ||
            impactCount < 0 || impactCount > 8 ||
            !validSuffixLength) { return false }
    } else if (words.length != legacyLength) {
        return false
    }
    for (var index = 0; index < actorCount; index = index + 1) {
        var offset = 18 + index * 8
        var actorId = words[offset]
        var actorKind = words[offset + 6]
        if ((actorKind == 3 &&
                (actorId >= 0 || actorId < -4)) ||
            (actorKind != 3 &&
                (actorId <= 0 || actorId > 1000000)) ||
            words[offset + 1] < sessionWebGameWorldMinimumX() ||
            words[offset + 1] > sessionWebGameWorldMaximumX() ||
            words[offset + 2] < sessionWebGameWorldMinimumY() ||
            words[offset + 2] > sessionWebGameWorldMaximumY() ||
            words[offset + 3] < sessionWebGameWorldMinimumZ() ||
            words[offset + 3] > sessionWebGameWorldMaximumZ() ||
            words[offset + 4] < 0 ||
            words[offset + 4] > sessionWebGameMaximumHealth() ||
            words[offset + 5] < 0 ||
            words[offset + 5] > sessionWebGameMaximumActorState() ||
            (actorKind != 3 && (actorKind < 1 || actorKind > 2)) ||
            (actorKind == 3 && words[offset + 5] != 0) ||
            words[offset + 7] < 0 || words[offset + 7] > 359) {
            return false
        }
    }
    var cursor = trailer + 4
    if (extended) {
        for (var index = 0; index < projectileCount; index = index + 1) {
            if (words[cursor] <= 0 || words[cursor + 1] <= 0 ||
                words[cursor + 2] < 0 || words[cursor + 3] < 0 ||
                words[cursor + 4] < 0 || words[cursor + 5] < 0 ||
                words[cursor + 6] < 0 ||
                words[cursor + 6] > sessionWebGameMaximumTick() ||
                (words[cursor + 7] != 1 && words[cursor + 7] != 3)) {
                return false
            }
            cursor = cursor + 8
        }
        for (var index = 0; index < throwableCount; index = index + 1) {
            if (words[cursor] <= 0 || words[cursor + 1] <= 0 ||
                words[cursor + 2] < 0 || words[cursor + 3] < 0 ||
                words[cursor + 4] < 0 || words[cursor + 5] < 0 ||
                words[cursor + 6] < 1 || words[cursor + 6] > 5 ||
                words[cursor + 7] < 0 ||
                words[cursor + 7] >
                    sessionWebGameMaximumThrowableFuseTicks()) { return false }
            cursor = cursor + 8
        }
        for (var index = 0; index < impactCount; index = index + 1) {
            if (words[cursor] <= 0 || words[cursor + 1] < 1 ||
                words[cursor + 1] > 8 || words[cursor + 2] <= 0 ||
                words[cursor + 3] < 0 || words[cursor + 4] < 0 ||
                words[cursor + 5] < 0 || words[cursor + 6] < 0 ||
                words[cursor + 7] < 0) { return false }
            cursor = cursor + 8
        }
        var suffix = cursor
        var hasExtendedPickup = false
        var hasLegacyPickup = false
        var directSuffix = -1
        var hasMapState = false
        if (words.length >= cursor + 11) {
            var directSlices = words[cursor + 9]
            if (directSlices >= 0 && directSlices <= 4) {
                if (words.length == cursor + 10 + directSlices * 4 + 1) {
                    directSuffix = cursor
                } else if (words.length ==
                        cursor + 10 + directSlices * 4 + 7) {
                    directSuffix = cursor
                    hasMapState = true
                }
            }
        }
        var shiftedSuffix = cursor + actorCount
        if (directSuffix < 0 &&
            words.length >= shiftedSuffix + 11) {
            var shiftedSlices = words[shiftedSuffix + 9]
            if (shiftedSlices >= 0 && shiftedSlices <= 4) {
                if (words.length ==
                        shiftedSuffix + 10 + shiftedSlices * 4 + 1) {
                    directSuffix = shiftedSuffix
                } else if (words.length ==
                        shiftedSuffix + 10 + shiftedSlices * 4 + 7) {
                    directSuffix = shiftedSuffix
                    hasMapState = true
                }
                if (directSuffix == shiftedSuffix) {
                    for (var index = 0; index < actorCount; index = index + 1) {
                        if (words[cursor + index] < 0 ||
                            words[cursor + index] > 1000000) { return false }
                    }
                }
            }
        }
        if (directSuffix >= 0) {
            suffix = directSuffix
            hasExtendedPickup = true
        } else if (words.length == cursor + actorCount + 6 + 1) {
            for (var index = 0; index < actorCount; index = index + 1) {
                if (words[cursor + index] < 0 ||
                    words[cursor + index] > 1000000) { return false }
            }
            suffix = cursor + actorCount
            hasLegacyPickup = true
        } else if (words.length == cursor + actorCount + 1) {
            for (var index = 0; index < actorCount; index = index + 1) {
                if (words[cursor + index] < 0 ||
                    words[cursor + index] > 1000000) { return false }
            }
        } else if (words.length == cursor + 6 + 1) {
            hasLegacyPickup = true
        } else if (words.length == cursor + 1) {
            return true
        } else {
            return false
        }
        if (hasLegacyPickup) {
            if ((words[suffix] != 0 && words[suffix] != 1) ||
                words[suffix + 1] < sessionWebGameWorldMinimumX() ||
                words[suffix + 1] > sessionWebGameWorldMaximumX() ||
                words[suffix + 2] < sessionWebGameWorldMinimumY() ||
                words[suffix + 2] > sessionWebGameWorldMaximumY() ||
                words[suffix + 3] < sessionWebGameWorldMinimumZ() ||
                words[suffix + 3] > sessionWebGameWorldMaximumZ() ||
                (words[suffix + 4] != 0 && words[suffix + 4] != 1) ||
                words[suffix + 5] < 0 || words[suffix + 5] > 30) {
                return false
            }
        }
        if (hasExtendedPickup) {
            var slices = words[suffix + 9]
            if ((words[suffix] != 0 && words[suffix] != 1) ||
                words[suffix + 1] < sessionWebGameWorldMinimumX() ||
                words[suffix + 1] > sessionWebGameWorldMaximumX() ||
                words[suffix + 2] < sessionWebGameWorldMinimumY() ||
                words[suffix + 2] > sessionWebGameWorldMaximumY() ||
                words[suffix + 3] < sessionWebGameWorldMinimumZ() ||
                words[suffix + 3] > sessionWebGameWorldMaximumZ() ||
                words[suffix + 4] < 0 || words[suffix + 4] > 5 ||
                (words[suffix + 5] != 0 && words[suffix + 5] != 1) ||
                words[suffix + 6] < 0 || words[suffix + 6] > 30 ||
                words[suffix + 7] < 0 || words[suffix + 7] > 5 ||
                words[suffix + 8] < 0 || words[suffix + 8] > 30 ||
                (words[suffix] == 1 && words[suffix + 4] == 0) ||
                (words[suffix] == 0 && words[suffix + 4] != 0) ||
                (words[suffix + 5] == 0 && words[suffix + 7] != 0) ||
                (words[suffix + 5] == 1 && words[suffix + 7] == 0) ||
                (words[suffix + 5] == 0 && words[suffix + 6] != 0) ||
                (words[5] == sessionWebRoleSpectator() &&
                    (words[suffix + 5] != 0 || words[suffix + 6] != 0))) {
                return false
            }
            var mapState = suffix + 10 + slices * 4
            if (words.length != mapState + (if (hasMapState) 7 else 1) &&
                words.length != mapState + actorCount +
                    (if (hasMapState) 7 else 1)) {
                return false
            }
            for (var slice = 0; slice < slices; slice = slice + 1) {
                var offset = suffix + 10 + slice * 4
                if (words[offset] <= 0 ||
                    words[offset + 1] < sessionWebGameWorldMinimumX() ||
                    words[offset + 1] > sessionWebGameWorldMaximumX() ||
                    words[offset + 2] < sessionWebGameWorldMinimumY() ||
                    words[offset + 2] > sessionWebGameWorldMaximumY() ||
                    words[offset + 3] < sessionWebGameWorldMinimumZ() ||
                    words[offset + 3] > sessionWebGameWorldMaximumZ()) { return false }
            }
            if (hasMapState) {
                var metadata = mapState
                var votes = words[metadata + 3] + words[metadata + 4]
                if ((words[metadata] != sessionWebGameMapOne() &&
                    words[metadata] != sessionWebGameMapTwo()) ||
                    (words[metadata + 1] != sessionWebGameMatchActive() &&
                    words[metadata + 1] != sessionWebGameMatchIntermission()) ||
                    words[metadata + 2] < 0 || words[metadata + 2] > 7200 ||
                    words[metadata + 3] < 0 || words[metadata + 3] > 8 ||
                    words[metadata + 4] < 0 || words[metadata + 4] > 8 ||
                    words[metadata + 5] != votes) { return false }
            }
        }
    }
    return true
}

Bool validSessionWebGameCommand(Int[] words) {
    return words.length == 7 &&
        words[0] == sessionWebGameProtocolVersion() &&
        words[1] == sessionWebGameKind() &&
        words[2] > 0 && words[2] <= 1000000 &&
        words[3] == sessionWebGameCommandMarker() &&
        ((words[4] == sessionWebGameMoveLeftCommand() && words[5] == -8) ||
            (words[4] == sessionWebGameMoveRightCommand() && words[5] == 8) ||
            (words[4] == sessionWebGameMoveBackCommand() &&
                words[5] == -8) ||
            (words[4] == sessionWebGameMoveForwardCommand() &&
                words[5] == 8) ||
            (words[4] == sessionWebGameStrafeLeftCommand() &&
                words[5] == -8) ||
            (words[4] == sessionWebGameStrafeRightCommand() &&
                words[5] == 8) ||
            (words[4] == sessionWebGameLookLeftCommand() &&
                words[5] == -15) ||
            (words[4] == sessionWebGameLookRightCommand() &&
                words[5] == 15) ||
            (words[4] == sessionWebGameLookUpCommand() &&
                words[5] == 15) ||
            (words[4] == sessionWebGameLookDownCommand() &&
                words[5] == -15) ||
            (words[4] >= sessionWebGameMeleeCommand() &&
                words[4] <= sessionWebGameJumpCommand() &&
                words[5] == 0)) &&
        words[6] == sessionWebMessageChecksum(words, 6)
}

Bool validSessionWebGameProbe(Int[] words) {
    return words.length == 5 &&
        words[0] == sessionWebGameProtocolVersion() &&
        words[1] == sessionWebGameKind() &&
        words[2] > 0 && words[2] <= 1000000 &&
        words[3] == sessionWebGameProbePayload() &&
        words[4] == sessionWebMessageChecksum(words, 4)
}

Int[] newSessionWebGameSceneSnapshot(
    Int sequence, Int tick, Int position, Int health,
    Int stamina, Int combo, Int vfx,
    Int actor0Health, Int actor1Health, Int actor2Health,
    Int projectileX, Int projectileZ, Int projectileTtl
) {
    if (sequence <= 0 || sequence > 1000000 ||
        tick < 0 || tick > sessionWebGameMaximumTick() ||
        position < sessionWebGameMinimumPosition() ||
        position > sessionWebGameMaximumPosition() ||
        health < 0 || health > sessionWebGameMaximumHealth() ||
        stamina < 0 || stamina > sessionWebGameMaximumStamina() ||
        combo < 0 || combo > sessionWebGameMaximumCombo() ||
        vfx < 0 || vfx > sessionWebGameMaximumVfx() ||
        actor0Health < 0 || actor0Health > sessionWebGameMaximumHealth() ||
        actor1Health < 0 || actor1Health > sessionWebGameMaximumHealth() ||
        actor2Health < 0 || actor2Health > sessionWebGameMaximumHealth() ||
        projectileX < sessionWebGameMinimumPosition() ||
        projectileX > sessionWebGameMaximumPosition() ||
        projectileZ < sessionWebGameMinimumDepth() ||
        projectileZ > sessionWebGameMaximumDepth() ||
        projectileTtl < 0 || projectileTtl > 6) {
        return new Int[0]
    }
    var words = new Int[30]
    words[0] = sessionWebGameProtocolVersion()
    words[1] = sessionWebGameKind()
    words[2] = sequence
    words[3] = sessionWebGameSceneSnapshotMarker()
    words[4] = tick
    words[5] = position
    words[6] = 0
    words[7] = 0
    words[8] = health
    words[9] = stamina
    words[10] = combo
    words[11] = vfx
    words[12] = 3
    words[13] = 1
    words[14] = -70
    words[15] = 24
    words[16] = actor0Health
    words[17] = 2
    words[18] = 8
    words[19] = -26
    words[20] = actor1Health
    words[21] = 3
    words[22] = 72
    words[23] = 18
    words[24] = actor2Health
    if (projectileTtl > 0) {
        words[25] = 1
        words[26] = projectileX
        words[27] = projectileZ
    } else {
        words[25] = 0
        words[26] = 0
        words[27] = 0
    }
    words[28] = projectileTtl
    words[29] = sessionWebMessageChecksum(words, 29)
    return words
}

Bool validSessionWebGameSceneSnapshot(Int[] words) {
    return words.length == 30 &&
        words[0] == sessionWebGameProtocolVersion() &&
        words[1] == sessionWebGameKind() &&
        words[2] > 0 && words[2] <= 1000000 &&
        words[3] == sessionWebGameSceneSnapshotMarker() &&
        words[4] >= 0 && words[4] <= sessionWebGameMaximumTick() &&
        words[5] >= sessionWebGameMinimumPosition() &&
        words[5] <= sessionWebGameMaximumPosition() &&
        words[6] >= sessionWebGameMinimumDepth() &&
        words[6] <= sessionWebGameMaximumDepth() &&
        words[8] >= 0 && words[8] <= sessionWebGameMaximumHealth() &&
        words[9] >= 0 && words[9] <= sessionWebGameMaximumStamina() &&
        words[10] >= 0 && words[10] <= sessionWebGameMaximumCombo() &&
        words[11] >= 0 && words[11] <= sessionWebGameMaximumVfx() &&
        words[12] == 3 &&
        words[16] >= 0 && words[16] <= sessionWebGameMaximumHealth() &&
        words[20] >= 0 && words[20] <= sessionWebGameMaximumHealth() &&
        words[24] >= 0 && words[24] <= sessionWebGameMaximumHealth() &&
        words[25] >= 0 && words[25] <= 1 &&
        words[26] >= sessionWebGameMinimumPosition() &&
        words[26] <= sessionWebGameMaximumPosition() &&
        words[27] >= sessionWebGameMinimumDepth() &&
        words[27] <= sessionWebGameMaximumDepth() &&
        words[28] >= 0 && words[28] <= 6 &&
