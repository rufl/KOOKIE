Bool webMultiplayerBox3DParityCase(
    G1Arena arena, Int startX, Int startY, Int startZ,
    Int moveX, Int moveZ, Int ticks, Bool jumpAtStart
) {
    var reference = FpsMovementController(1)
    var candidate = FpsMovementController(1)
    var authored = arena.authoredCollision()
    if (!reference.configure(authored) || !candidate.configure(authored) ||
        !candidate.setExternalCollisionMode(true) ||
        !reference.addActor(1, startX, startY, startZ) ||
        !candidate.addActor(1, startX, startY, startZ)) { return false }
    for (var tick = 0; tick < ticks; tick = tick + 1) {
        var jump = jumpAtStart && tick == 0
        var wasGrounded = candidate.grounded(1)
        var startFixedX = candidate.positionXFixed(1)
        var startFixedY = candidate.positionYFixed(1)
        var startFixedZ = candidate.positionZFixed(1)
        if (!reference.step(1, moveX, moveZ, jump, false) ||
            !candidate.step(1, moveX, moveZ, jump, false)) { return false }
        var desiredX = candidate.positionXFixed(1)
        var desiredY = candidate.positionYFixed(1)
        var desiredZ = candidate.positionZFixed(1)
        if (kookie_box3d_move_fixed(
                startFixedX, startFixedY, startFixedZ,
                desiredX, desiredY, desiredZ, fpsMovementCapsuleRadius(),
                fpsMovementCapsuleHeight(), wasGrounded) != 0 ||
            !candidate.applyExternalCollision(
                1, kookie_box3d_result_x_fixed(),
                kookie_box3d_result_y_fixed(), kookie_box3d_result_z_fixed(),
                kookie_box3d_result_grounded(), wasGrounded, false)) {
            return false
        }
        if (webMultiplayerAbs(
                candidate.positionXFixed(1) - reference.positionXFixed(1)) > 12 ||
            webMultiplayerAbs(
                candidate.positionYFixed(1) - reference.positionYFixed(1)) > 12 ||
            webMultiplayerAbs(
                candidate.positionZFixed(1) - reference.positionZFixed(1)) > 12 ||
            candidate.grounded(1) != reference.grounded(1)) {
            println("Box3D arena parity mismatch start=" + startX + "," +
                startY + "," + startZ + " tick=" + tick + " kof=" +
                reference.positionXFixed(1) + "," +
                reference.positionYFixed(1) + "," +
                reference.positionZFixed(1) + " sweep-start=" +
                startFixedX + "," + startFixedY + "," + startFixedZ +
                " requested=" + desiredX + "," + desiredY + "," +
                desiredZ + " box3d=" + candidate.positionXFixed(1) + "," +
                candidate.positionYFixed(1) + "," +
                candidate.positionZFixed(1) + " velocity=" +
                reference.velocityX(1) + "/" + candidate.velocityX(1) +
                " contacts=" + kookie_box3d_result_contacts() +
                " normal=" + kookie_box3d_result_normal_x_milli() + "," +
                kookie_box3d_result_normal_y_milli() + "," +
                kookie_box3d_result_normal_z_milli() + " plane-offset=" +
                kookie_box3d_result_plane_offset_milli() + " shape=" +
                kookie_box3d_result_shape_index() + " grounded=" +
                reference.grounded(1) + "/" + candidate.grounded(1))
            return false
        }
    }
    return true
}

Int webMultiplayerPlayerCapacity() { return 8 }
Int webMultiplayerTickMillis() { return 17 }
Int webMultiplayerTickNanoseconds() { return 16667000 }
Int webMultiplayerProjectileCapacity() { return 12 }
Int webMultiplayerThrowableCapacity() { return 4 }
Int webMultiplayerImpactCapacity() { return 8 }
Int webMultiplayerProjectileLifetimeTicks() { return 120 }
Int webMultiplayerThrowableFuseTicks() {
    return sessionWebGameMaximumThrowableFuseTicks()
}
Int webMultiplayerFlag(Int flags, Int bit) {
    var divisor = 1
    for (var index = 0; index < bit; index = index + 1) { divisor = divisor * 2 }
    return (flags / divisor) % 2
}
Int webMultiplayerAbs(Int value) { if (value < 0) { return -value }; return value }
Int webMultiplayerExplosionRadius() { return 12 }
Int webMultiplayerBox3DRay(
    Int startX, Int startY, Int startZ,
    Int endX, Int endY, Int endZ
) {
    var scale = fpsMovementCoordinateScale()
    return kookie_box3d_cast_ray_fixed(
        startX * scale, startY * scale, startZ * scale,
        endX * scale, endY * scale, endZ * scale)
}
Int webMultiplayerBox3DActorRay(
    Int ignoredActorSlot,
    Int startX, Int startY, Int startZ, Int endX, Int endY, Int endZ
) {
    var scale = fpsMovementCoordinateScale()
    return kookie_box3d_cast_ray_actors_fixed(
        ignoredActorSlot,
        startX * scale, startY * scale, startZ * scale,
        endX * scale, endY * scale, endZ * scale)
}
Int webMultiplayerSine(Int angle) {
    var normalized = angle % 360
    if (normalized < 0) { normalized = normalized + 360 }
    var signValue = 1
    if (normalized > 180) { normalized = 360 - normalized; signValue = -1 }
    return signValue * normalized * (180 - normalized) * 1000 / 8100
}

Bool webMultiplayerSweptPlayerCollision(
    Int startX, Int startY, Int startZ,
    Int endX, Int endY, Int endZ,
    Int otherX, Int otherY, Int otherZ
) {
    for (var step = 1; step <= 12; step = step + 1) {
        var x = startX + (endX - startX) * step / 12
        var y = startY + (endY - startY) * step / 12
        var z = startZ + (endZ - startZ) * step / 12
        if (webMultiplayerAbs(x - otherX) < 4 &&
            webMultiplayerAbs(y - otherY) < 5 &&
            webMultiplayerAbs(z - otherZ) < 4) { return true }
    }
    return false
}

record WebMultiplayerPlayerState(
    Bool active, Int playerId, Int actorId, Int animal,
    Int x, Int y, Int z, Int yaw, Int pitch, Int health, Int ammo, Int state,
    Bool grounded, Bool gliding, Int oxygen
)
record WebMultiplayerProjectileState(
    Bool active, Int id, Int ownerId, Int targetId,
    Int x, Int y, Int z, Int ttl, Int kind
)
record WebMultiplayerThrowableState(
    Bool active, Int id, Int ownerId, Int x, Int y, Int z,
    Int ttl, Int kind, Int fuseTicks
)
record WebMultiplayerSliceState(Bool active, Int id, Int x, Int y, Int z)
record WebMultiplayerImpactEvent(
    Int sequence, Int tick, Int kind, Int sourceId, Int targetId,
    Int x, Int y, Int z, Int damage
)

