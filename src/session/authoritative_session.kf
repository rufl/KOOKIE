    Bool encodeLevelProgression(
        BoundedSaveSections target, Int levelId, Int contentVersion
    ) {
        return started && worldInteractions.encodeLevelProgression(target, levelId, contentVersion)
    }

    Bool restoreLevelProgression(
        BoundedSaveSections source, Int levelId, Int contentVersion
    ) {
        if (!started || inputReplayEnabled ||
            !worldInteractions.restoreLevelProgression(source, levelId, contentVersion)) {
            return false
        }
        for (var player = 1; player <= 2; player = player + 1) {
            interactionTicks[player] = 0
            interactionTargets[player] = 0
            interactionResultTicks[player] = 0
            interactionResultTargets[player] = 0
            interactionResults[player] = false
        }
        interactionReplay.reset()
        return publishWorldInteractions()
    }

