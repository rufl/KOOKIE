    Bool stepPlayerWeaponPresentationCaptured(
        Int actorId, Int tick, InputEdges edges
    ) {
        if (!playerCombat.isAlive(actorId)) {
            return false
        }
        var before = playerWeaponPresentations.pending()
        if (!playerWeaponPresentations.step(
                playerCombat, actorId, tick, edges)) {
            return false
        }
        if (playerWeaponPresentations.pending() == before) {
            return true
        }
        var published = playerWeaponPresentations.lastPublished()
        var fired = 0
        if (published.kind() == 1) {
            fired = 1
        }
        return recordReplayPresentation(
            tick, published.kind(), published.sequence(), published.actorId(), 0,
            published.shotId(), published.weaponId(), published.magazine(),
            published.reserve(), published.nextReadyTick(), 0, fired)
    }

    Bool stepPlayerWeaponPresentation(Int actorId, Int tick, InputEdges edges) {
        return stepPlayerWeaponPresentationCaptured(actorId, tick, edges)
    }

    Bool setPaused(Int active) {
        if (!started || (active != 0 && active != 1)) {
            return false
        }
        paused = active == 1
        if (paused) {
            clock.resetDebt()
            playerOneInputs.clearPending()
            playerTwoInputs.clearPending()
            playerOneEdges.clearHeld()
            playerTwoEdges.clearHeld()
            interactionTargets[1] = 0
            interactionTargets[2] = 0
            interactionTicks[1] = 0
            interactionTicks[2] = 0
        }
        return true
    }

    Bool isPaused() {
        return paused
    }

    Bool applyPlayerFocus(Int player, Int active) {
        if ((active != 0 && active != 1) || !started) {
            return false
        }
        if (player == 1 && playerOneConnected) {
            playerOneFocused = active == 1
            if (active == 0) {
                playerOneInputs.clearPending()
                playerOneEdges.clearHeld()
                interactionTargets[1] = 0
                interactionTicks[1] = 0
            }
            return true
        }
        if (player == 2 && playerTwoConnected) {
            playerTwoFocused = active == 1
            if (active == 0) {
                playerTwoInputs.clearPending()
                playerTwoEdges.clearHeld()
                interactionTargets[2] = 0
                interactionTicks[2] = 0
            }
            return true
        }
        return false
    }

    Bool playerFocused(Int player) {
        if (player == 1 && playerOneConnected) {
            return playerOneFocused
        }
        if (player == 2 && playerTwoConnected) {
            return playerTwoFocused
        }
        return false
    }

    Bool setInputReplayEnabled(Bool enabled) {
        if (!started) {
