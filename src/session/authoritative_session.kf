    Bool pickupPlayerLoot(Int player, Int stableId) {
        if (!playerConnected(player)) {
            return false
        }
        var index = worldLoot.find(stableId)
        if (index < 0) {
            return false
        }
        var distanceX = worldLoot.positionX(index) -
            serverMovement.position(player)
        var distanceY = worldLoot.positionY(index)
        var distanceZ = worldLoot.positionZ(index)
        if (distanceX < 0) {
            distanceX = -distanceX
        }
        if (distanceY < 0) {
            distanceY = -distanceY
        }
        if (distanceZ < 0) {
            distanceZ = -distanceZ
        }
        if (distanceX > 4 || distanceY > 4 || distanceZ > 4) {
            return false
        }
        if (player == 1) {
            return worldLoot.pickup(stableId, playerOneInventory)
        }
        return worldLoot.pickup(stableId, playerTwoInventory)
    }

