    Bool setPaused(Int active) {
        if (!started || (active != 0 && active != 1)) {
            return false
        }
        paused = active == 1
        if (paused) {
            clock.resetDebt()
            playerOneInputs.clearPending()
            playerTwoInputs.clearPending()
            playerOneEdges.clearHeld()
            playerTwoEdges.clearHeld()
        }
        return true
    }

    Bool isPaused() {
        return paused
    }

    Bool applyPlayerFocus(Int player, Int active) {
        if ((active != 0 && active != 1) || !started) {
            return false
        }
        if (player == 1 && playerOneConnected) {
            playerOneFocused = active == 1
            if (active == 0) {
                playerOneInputs.clearPending()
                playerOneEdges.clearHeld()
            }
            return true
        }
        if (player == 2 && playerTwoConnected) {
            playerTwoFocused = active == 1
            if (active == 0) {
                playerTwoInputs.clearPending()
                playerTwoEdges.clearHeld()
            }
            return true
        }
        return false
    }

    Bool playerFocused(Int player) {
        if (player == 1 && playerOneConnected) {
            return playerOneFocused
        }
        if (player == 2 && playerTwoConnected) {
            return playerTwoFocused
        }
        return false
    }

    Bool setInputReplayEnabled(Bool enabled) {
        if (!started) {
            return false
        }
        inputReplayEnabled = enabled
        playerOneReplay.reset()
        playerTwoReplay.reset()
        return true
    }

    Bool inputReplayEnabledValue() {
        return inputReplayEnabled
    }

    Int pendingPlayerReplay(Int player) {
        if (player == 1) {
            return playerOneReplay.pending()
        }
        if (player == 2) {
            return playerTwoReplay.pending()
        }
        return -1
    }

    Bool playPlayerReplay(Int player) {
        if (player == 1) {
            return playerOneReplay.playNext()
        }
        if (player == 2) {
            return playerTwoReplay.playNext()
        }
        return false
    }

    InputCommand lastPlayerReplay(Int player) {
        if (player == 1) {
            return playerOneReplay.lastPlayed()
        }
        return playerTwoReplay.lastPlayed()
    }

    Bool queueReplayCommands(
        Int player, BoundedReplayTimeline timeline, Int targetTick
    ) {
        if (!started || paused || targetTick < 0 ||
            (player != 1 && player != 2)) {
            return false
        }
        var staged = InputReplayRecorder(64)
        if (!timeline.seek(targetTick) ||
            !timeline.stageSeekCommands(staged)) {
            return false
        }
        while (staged.playNext()) {
            var command = staged.lastPlayed()
            if (!receiveInput(
                player, command.tick(), command.sequence(),
                command.moveX(), command.moveY(), command.lookX(), command.lookY(),
                command.fire(), command.jump())) {
                return false
            }
        }
        return true
    }

    Bool receiveInput(
        Int player, Int tick, Int sequence, Int moveX, Int moveY,
        Int lookX, Int lookY, Int fire, Int jump
    ) {
        if (!started || paused) {
            return false
        }
        var command = InputCommand(tick, sequence, moveX, moveY, lookX, lookY, fire, jump)
        if (player == 1 && playerOneConnected && playerOneFocused) {
            return playerOneInputs.queue(command)
        }
        if (player == 2 && playerTwoConnected && playerTwoFocused) {
            return playerTwoInputs.queue(command)
        }
        return false
    }

    Int advance(Int elapsedMicros) {
        if (!started) {
            return -1
        }
        if (paused) {
            return 0
        }
        var steps = clock.advance(elapsedMicros)
        if (steps < 0) {
            return -1
        }
        for (var step = 0; step < steps; step = step + 1) {
            if (playerOneConnected && playerOneInputs.queuedCount() > 0 && playerOneInputs.nextTick() <= clock.tick()) {
                playerOneInputs.dequeue()
                var commandOne = playerOneInputs.lastConsumed()
                playerOneEdges.apply(commandOne.fire(), commandOne.jump())
                if (inputReplayEnabled && !playerOneReplay.append(commandOne)) {
                    return -1
                }
                serverMovement.applyInput(1, commandOne.moveX())
                if (playerCombat.isAlive(1) &&
                    !playerWeaponPresentations.step(
                        playerCombat, 1, clock.tick(), playerOneEdges.lastEdges())) {
                    return -1
                }
            }
            if (playerTwoConnected && playerTwoInputs.queuedCount() > 0 && playerTwoInputs.nextTick() <= clock.tick()) {
                playerTwoInputs.dequeue()
                var commandTwo = playerTwoInputs.lastConsumed()
                if (inputReplayEnabled && !playerTwoReplay.append(commandTwo)) {
                    return -1
                }
                playerTwoEdges.apply(commandTwo.fire(), commandTwo.jump())
                serverMovement.applyInput(2, commandTwo.moveX())
                if (playerCombat.isAlive(2) &&
                    !playerWeaponPresentations.step(
                        playerCombat, 2, clock.tick(), playerTwoEdges.lastEdges())) {
                    return -1
                }
            }
            var enemyTick = clock.tick() - steps + step + 1
            if (!advanceEnemyTick(enemyTick)) {
                return -1
            }
            if (!tickPlayerStatuses()) {
                return -1
            }
        }
        serverTick = clock.tick()
        if (steps > 0) {
            snapshotSequence = snapshotSequence + 1
            if (playerOneConnected) {
                var playerOnePosition = serverMovement.position(1)
                playerOneSnapshots.push(snapshotSequence, serverTick, playerOnePosition)
                playerOnePrediction.reconcile(playerOnePosition, serverTick)
                clientMovement.setPosition(1, playerOnePrediction.predicted())
            }
            if (playerTwoConnected) {
                var playerTwoPosition = serverMovement.position(2)
                playerTwoSnapshots.push(snapshotSequence, serverTick, playerTwoPosition)
                playerTwoPrediction.reconcile(playerTwoPosition, serverTick)
                clientMovement.setPosition(2, playerTwoPrediction.predicted())
            }
            clientTick = serverTick
            if (!publishEnemySnapshots(serverTick)) {
                return -1
            }
        }
        return steps
    }
    Bool applySnapshot(Int sequence, Int tick, Int player, Int position) {
        if (!started || sequence <= snapshotSequence || tick < clientTick) {
            return false
        }
        if (player == 1 && playerOneConnected) {
            if (!playerOneSnapshots.push(sequence, tick, position) ||
                !playerOnePrediction.reconcile(position, tick)) {
                return false
            }
            if (!clientMovement.setPosition(1, playerOnePrediction.predicted())) {
                return false
            }
        } else if (player == 2 && playerTwoConnected) {
            if (!playerTwoSnapshots.push(sequence, tick, position) ||
                !playerTwoPrediction.reconcile(position, tick)) {
                return false
            }
            if (!clientMovement.setPosition(2, playerTwoPrediction.predicted())) {
                return false
            }
        } else {
            return false
        }
        snapshotSequence = sequence
        clientTick = tick
        return true
    }

    Int broadPhaseRevision() {
        return broadPhaseRevisionValue
    }

    Int clientBroadPhaseRevision() {
        return clientBroadPhaseRevisionValue
    }

    Bool configureBroadPhaseBounds(
        Int nextMinX, Int nextMinY, Int nextMinZ,
        Int nextMaxX, Int nextMaxY, Int nextMaxZ
    ) {
        if (!broadPhaseCollection.configureBounds(
            nextMinX, nextMinY, nextMinZ, nextMaxX, nextMaxY, nextMaxZ)) {
            return false
        }
        broadPhaseRevisionValue = broadPhaseCollection.geometryRevision()
        return true
    }

    Bool addBroadPhaseTriangle(
        Int axValue, Int ayValue, Int azValue,
        Int bxValue, Int byValue, Int bzValue,
        Int cxValue, Int cyValue, Int czValue
    ) {
        if (!broadPhaseCollection.addTriangle(
            axValue, ayValue, azValue,
            bxValue, byValue, bzValue,
            cxValue, cyValue, czValue)) {
            return false
        }
        broadPhaseRevisionValue = broadPhaseCollection.geometryRevision()
        return true
    }

    Bool removeBroadPhaseTriangle(Int index) {
        if (!broadPhaseCollection.removeTriangle(index)) {
            return false
        }
        broadPhaseRevisionValue = broadPhaseCollection.geometryRevision()
        return true
    }

    Int broadPhaseTriangleCount() {
        return broadPhaseCollection.triangleCount()
    }
    Int[] broadPhaseSnapshot(Int tick, Int sequence) {
        return newBroadPhaseSnapshot(
            protocolVersion(), tick, sequence,
            broadPhaseRevisionValue, broadPhaseCollection)
    }
    Bool queueBroadPhaseSnapshot(Int tick, Int sequence) {
        return broadPhaseTransport.send(broadPhaseSnapshot(tick, sequence))
    }

    Bool configureRemoteEndpoint(
        Int firstOctet, Int secondOctet, Int thirdOctet, Int fourthOctet,
        Int port, Int key0Low, Int key0High, Int key1Low, Int key1High
    ) {
        if (remoteLink.connected() ||
            !remoteEndpoint.setKey(key0Low, key0High, key1Low, key1High) ||
            !remoteEndpoint.setPeer(
                firstOctet, secondOctet, thirdOctet, fourthOctet, port)) {
            return false
        }
        remoteConfigured = remoteEndpoint.valid()
        return remoteConfigured
    }

    Bool openRemoteSession() {
        if (!started || !remoteConfigured) {
            return false
        }
        if (!remoteLink.connect()) {
            return false
        }
        remoteSendSequenceValue = 0
        return true
    }

    Bool closeRemoteSession() {
        return remoteLink.disconnect()
    }

    Bool remoteSessionConnected() {
        return remoteLink.connected()
    }

    Bool queueRemoteBroadPhaseSnapshot(Int tick, Int sequence) {
        if (!started || !remoteLink.connected()) {
            return false
        }
        if (!remoteLink.sendSnapshot(broadPhaseSnapshot(tick, sequence))) {
            return false
        }
        remoteSendSequenceValue = sequence
        return true
    }

    Bool pumpRemoteBroadPhaseSnapshot(Int tick) {
        if (!started || !remoteLink.connected() ||
            remoteSendSequenceValue == 2147483647) {
            return false
        }
        return queueRemoteBroadPhaseSnapshot(
            tick, remoteSendSequenceValue + 1)
    }

    Int remoteSendSequence() {
        return remoteSendSequenceValue
    }

    Bool applyRemoteBroadPhaseSnapshot(Int[] words) {
        if (!started || !remoteLink.canReceiveSnapshot(words) ||
            !applyBroadPhaseSnapshot(words)) {
            return false
        }
        return remoteLink.receiveSnapshot(words)
    }

    Int pendingBroadPhaseSnapshots() {
        return broadPhaseTransport.pending()
    }

    Bool receiveBroadPhaseSnapshot() {
        var words = broadPhaseTransport.receive()
        if (words.length == 0) {
            return false
        }
        return applyBroadPhaseSnapshot(words)
    }


    Bool acceptsBroadPhaseSnapshot(Int[] words) {
        return broadPhaseSnapshotMatches(words, broadPhaseRevisionValue)
    }
    Bool applyBroadPhaseSnapshot(Int[] words) {
        if (!validBroadPhaseSnapshot(words) ||
            words[3] <= clientBroadPhaseSnapshotSequence ||
            words[5] > clientBroadPhaseCollection.triangleCapacity()) {
            return false
        }
        clientBroadPhaseCollection.clearTriangles()
        for (var ordinal = 0; ordinal < words[5]; ordinal = ordinal + 1) {
            var offset = 6 + ordinal * 9
            if (!clientBroadPhaseCollection.addTriangle(
                words[offset], words[offset + 1], words[offset + 2],
                words[offset + 3], words[offset + 4], words[offset + 5],
                words[offset + 6], words[offset + 7], words[offset + 8])) {
                return false
            }
        }
        clientBroadPhaseRevisionValue = words[4]
        clientBroadPhaseSnapshotSequence = words[3]
        return true
    }

    Int clientBroadPhaseTriangleCount() {
        return clientBroadPhaseCollection.triangleCount()
    }

    SegmentCollisionResult queryClientBroadPhase(
        Int geometryRevision,
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ
    ) {
        if (geometryRevision != clientBroadPhaseRevisionValue) {
            return rejectedBroadPhaseQuery(
                startX, startY, startZ, endX, endY, endZ)
        }
        return clientBroadPhaseCollection.query(
            startX, startY, startZ, endX, endY, endZ)
    }



    SegmentCollisionResult rejectedBroadPhaseQuery(
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ
    ) {
        return SegmentCollisionResult(
            false, false, -1,
            startX, startY, startZ, endX, endY, endZ,
            startX, startY, startZ)
    }

    SegmentCollisionResult queryBroadPhase(
        Int geometryRevision,
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ
    ) {
        if (geometryRevision != broadPhaseRevisionValue) {
            return rejectedBroadPhaseQuery(
                startX, startY, startZ, endX, endY, endZ)
        }
        return broadPhaseCollection.query(
            startX, startY, startZ, endX, endY, endZ)
    }

    Bool applyQuerySnapshot(
        Int sequence, Int tick, Int geometryRevision,
        Int player, Int position
    ) {
        if (geometryRevision != broadPhaseRevisionValue) {
            return false
        }
        if (!applySnapshot(sequence, tick, player, position)) {
            return false
        }
        clientBroadPhaseRevisionValue = geometryRevision
        return true
    }

    Bool predictClientInput(Int player, Int requestedStep) {
        if (!started) {
            return false
        }
        if (player == 1 && playerOneConnected) {
            if (!playerOnePrediction.predict(requestedStep)) {
                return false
            }
            return clientMovement.setPosition(1, playerOnePrediction.predicted())
        }
        if (player == 2 && playerTwoConnected) {
            if (!playerTwoPrediction.predict(requestedStep)) {
                return false
            }
            return clientMovement.setPosition(2, playerTwoPrediction.predicted())
        }
        return false
    }

    Int predictedPosition(Int player) {
        if (player == 1) {
            return playerOnePrediction.predicted()
        }
        return playerTwoPrediction.predicted()
    }
    Int authoritativePosition(Int player) {
        if (player == 1) {
            return playerOnePrediction.authoritative()
        }
        return playerTwoPrediction.authoritative()
    }

    Int predictionCorrection(Int player) {
        if (player == 1) {
            return playerOnePrediction.correction()
        }
        return playerTwoPrediction.correction()
    }

    Int pendingPredictionInputs(Int player) {
        if (player == 1) {
            return playerOnePrediction.pendingInputs()
        }
        return playerTwoPrediction.pendingInputs()
    }


    InterpolatedPosition interpolatedPosition(Int player, Int renderTick) {
        if (player == 1) {
            return playerOneSnapshots.interpolate(renderTick)
        }
        return playerTwoSnapshots.interpolate(renderTick)
    }

    Int snapshotCount(Int player) {
        if (player == 1) {
            return playerOneSnapshots.size()
        }
        return playerTwoSnapshots.size()
    }


    Int playerCount() {
        var count = 0
        if (playerOneConnected) {
            count = count + 1
        }
        if (playerTwoConnected) {
            count = count + 1
        }
        return count
    }

    Int serverPosition(Int player) {
        return serverMovement.position(player)
    }

    Int clientPosition(Int player) {
        return clientMovement.position(player)
    }

    Int currentServerTick() {
        return serverTick
    }

    Int currentClientTick() {
        return clientTick
    }

    Int latestSnapshotSequence() {
        return snapshotSequence
    }

    Bool inSync() {
        var synced = serverTick == clientTick
        if (playerOneConnected) {
            synced = synced && serverPosition(1) == clientPosition(1)
        }
        if (playerTwoConnected) {
            synced = synced && serverPosition(2) == clientPosition(2)
        }
        return synced
    }

    InputEdges lastInputEdges(Int player) {
        if (player == 1) {
            return playerOneEdges.lastEdges()
        }
        return playerTwoEdges.lastEdges()
    }
