        }
        return -1
    }

    BoundedItemRoll configuredEnemyLootRoll(Int enemyId) {
        var roll = BoundedItemRoll()
        var slot = enemySlot(enemyId)
        if (slot < 0 || enemyLootStableIds[slot] <= 0) {
            return roll
        }
        lootTable.rollWithAffixPools(
            enemyLootStableIds[slot], enemyLootSeeds[slot],
            enemyLootLevels[slot], lootItemDefinitions,
            lootAffixPools, roll)
        return roll
    }

    Bool canGrantEnemyLootReward(Int player, Int enemyId) {
        var slot = enemySlot(enemyId)
        if (slot < 0 || enemyLootStableIds[slot] <= 0 ||
            enemyLootClaimed[slot]) {
            return true
        }
        var roll = configuredEnemyLootRoll(enemyId)
        if (!roll.accepted() || !worldLoot.canStage(roll)) {
            return false
        }
        var skillId = enemyLootSkillIds[slot]
        var experience = enemyLootSkillExperiences[slot]
        if (experience == 0) {
            return true
        }
        if (enemyLootRanks[slot] != 3 || skillId <= 0) {
            return false
        }
        if (player == 1 && playerOneConnected) {
            return playerOneSkills.canGainExperience(
                skillId, experience, playerSkillDefinitions)
        }
        if (player == 2 && playerTwoConnected) {
            return playerTwoSkills.canGainExperience(
                skillId, experience, playerSkillDefinitions)
        }
        return false
    }

    Bool grantEnemyLootReward(Int player, Int enemyId) {
        var slot = enemySlot(enemyId)
        if (slot < 0 || enemyLootStableIds[slot] <= 0 ||
            enemyLootClaimed[slot]) {
            return true
        }
        var roll = configuredEnemyLootRoll(enemyId)
        if (!roll.accepted() ||
            !worldLoot.stage(
                roll, enemyId, enemyLootRanks[slot],
                SpatialPoint(
                    enemyCombat.enemySpatialPositionX(enemyId),
                    enemyCombat.enemySpatialPositionY(enemyId),
                    enemyCombat.enemySpatialPositionZ(enemyId)))) {
            return false
        }
        var experience = enemyLootSkillExperiences[slot]
        if (experience > 0 &&
            !gainPlayerSkillExperience(
                player, enemyLootSkillIds[slot], experience)) {
            return false
        }
        enemyLootClaimed[slot] = true
        return true
    }

    ResolutionResult resolveEnemyHitscanAt(
        Int sourceId, Int targetId, Int serverTickValue,
        Int shotTick, Int distance, Int critical
    ) {
        if (shotTick < 0 || serverTickValue < shotTick ||
            serverTickValue - shotTick >= netcodeMaximumRewindTicks()) {
            return ResolutionResult(
                false, 0, sourceId, targetId, 0,
                enemyCombat.currentHealth(targetId), false, 0)
        }
        var historicalDistance =
            serverRewindHistory.distance(sourceId, targetId, shotTick)
        var effectiveDistance = distance
        if (historicalDistance >= 0) {
            effectiveDistance = historicalDistance
        }
        return resolveEnemyHitscan(
            sourceId, targetId, serverTickValue,
            effectiveDistance, critical)
    }

    ResolutionResult resolveEnemyHitscan(
        Int sourceId, Int targetId, Int tick, Int distance, Int critical
    ) {
        var reward = combatRewardCurrency(targetId)
        if (!canGrantCombatReward(sourceId, reward) ||
            !canGrantEnemyLootReward(sourceId, targetId)) {
            return ResolutionResult(
                false, 0, sourceId, targetId, 0,
                enemyCombat.currentHealth(targetId), false, 0)
        }
        var result = enemyCombat.playerHitscan(
            sourceId, targetId, tick, distance, critical)
        if (result.accepted() && result.died() &&
            ((!grantEnemyLootReward(sourceId, targetId)) ||
                (reward > 0 &&
                    !grantCombatReward(sourceId, targetId, reward)))) {
            return ResolutionResult(
                false, result.actionId(), sourceId, targetId,
                result.applied(), result.remainingHealth(),
                result.died(), result.eventSequence())
        }
        presentEnemyResolution(result, tick)
        return result
    }
    ResolutionResult resolveEnemyShotgun(
        Int sourceId, Int targetId, Int tick, Int distance, Int critical
    ) {
        var reward = combatRewardCurrency(targetId)
        if (!canGrantCombatReward(sourceId, reward) ||
            !canGrantEnemyLootReward(sourceId, targetId)) {
            return ResolutionResult(
                false, 0, sourceId, targetId, 0,
                enemyCombat.currentHealth(targetId), false, 0)
        }
        var result = enemyCombat.playerShotgun(
            sourceId, targetId, tick, distance, critical)
        if (result.accepted() && result.died() &&
            ((!grantEnemyLootReward(sourceId, targetId)) ||
                (reward > 0 &&
                    !grantCombatReward(sourceId, targetId, reward)))) {
            return ResolutionResult(
                false, result.actionId(), sourceId, targetId,
                result.applied(), result.remainingHealth(),
                result.died(), result.eventSequence())
        }
        presentEnemyResolution(result, tick)
        return result
    }

