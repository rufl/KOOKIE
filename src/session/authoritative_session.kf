    Bool applyPlayerStatus(
        Int player, Int statusId, Int duration, Int stacks
    ) {
        var effects = playerOneStatuses
        if (player == 2 && playerTwoConnected) {
            effects = playerTwoStatuses
        } else if (player != 1 || !playerOneConnected) {
            return false
        }
        var previous = new Int[effects.replayStateLength()]
        if (!effects.encodeReplayState(previous) ||
            !effects.apply(
                statusId, duration, stacks, playerStatusDefinitions)) {
            return false
        }
        if (refreshPlayerCombatModifiers(player)) {
            return true
        }
        effects.restoreReplayState(previous, playerStatusDefinitions)
        refreshPlayerCombatModifiers(player)
        return false
    }

