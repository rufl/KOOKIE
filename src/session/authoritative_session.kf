    Bool predictRemoteGameplayInput(
        Int player, Int tick, Int requestedStep, Int generation
    ) {
        if (!started || !clientRemoteBaselineReadyValue ||
            !clientRemoteConnectedValue ||
            player != clientRemotePlayerValue ||
            generation != clientRemoteConnectionGenerationValue) {
            return false
        }
        var accepted = false
        if (player == 1) {
            accepted = playerOnePrediction.predictAt(
                tick, requestedStep)
            if (accepted) {
                accepted = clientMovement.setPosition(
                    1, playerOnePrediction.predicted())
            }
        } else if (player == 2) {
            accepted = playerTwoPrediction.predictAt(
                tick, requestedStep)
            if (accepted) {
                accepted = clientMovement.setPosition(
                    2, playerTwoPrediction.predicted())
            }
        }
        return accepted
    }

