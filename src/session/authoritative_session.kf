    Bool admitEnemy(
        Int encounterId, Int enemyId, Int health,
        Int armor, Int weaponId
    ) {
        if (!started || enemyCount >= enemyIds.length ||
            !enemyCombat.admitEnemy(
                encounterId, enemyId, health, armor, weaponId)) {
            return false
        }
        enemyIds[enemyCount] = enemyId
        enemyDefinitionNamespaces[enemyCount] = 0
        enemyDefinitionIds[enemyCount] = 0
        enemyKinds[enemyCount] = enemyDefinitionNormalKind()
        enemyEncounterIds[enemyCount] = encounterId
        enemyCount = enemyCount + 1
        return true
    }

    Bool admitEnemyAt(
        Int encounterId, Int enemyId, Int tick,
        Int health, Int armor, Int weaponId,
        Int x, Int y, Int z
    ) {
        if (!started || enemyCount >= enemyIds.length ||
            !enemyCombat.admitEnemyAt(
                encounterId, enemyId, tick, health, armor, weaponId,
                x, y, z)) {
            return false
        }
        enemyIds[enemyCount] = enemyId
        enemyDefinitionNamespaces[enemyCount] = 0
        enemyDefinitionIds[enemyCount] = 0
        enemyKinds[enemyCount] = enemyDefinitionNormalKind()
        enemyEncounterIds[enemyCount] = encounterId
        enemyCount = enemyCount + 1
        return true
    }

    Bool rollbackDefinedEnemy(Int enemyId) {
        var slot = enemySlot(enemyId)
        if (slot < 0 || slot != enemyCount - 1 ||
            !enemyCombat.cancelEnemyAdmission(enemyId)) {
            return false
        }
        if (playerCombatRewardCount > 0 &&
            playerCombatRewardTargets[playerCombatRewardCount - 1] == enemyId) {
            var reward = playerCombatRewardCount - 1
            playerCombatRewardTargets[reward] = 0
            playerCombatRewardCurrencies[reward] = 0
            playerCombatRewardClaimed[reward] = false
            playerCombatRewardCount = reward
        }
        enemyIds[slot] = 0
        enemyDefinitionNamespaces[slot] = 0
        enemyDefinitionIds[slot] = 0
        enemyKinds[slot] = enemyDefinitionNormalKind()
        enemyEncounterIds[slot] = 0
        enemyPerceptionTargets[slot] = 0
        enemyPerceptionDistances[slot] = 0
        enemyPerceptionCriticals[slot] = 0
        enemyPerceptionVisible[slot] = false
        enemyPerceptionActive[slot] = false
        enemySpatialPerceptionActive[slot] = false
        enemyAutonomous[slot] = false
        enemyLootStableIds[slot] = 0
        enemyLootSeeds[slot] = 0
        enemyLootLevels[slot] = 0
        enemyLootRanks[slot] = 0
        enemyLootSkillIds[slot] = 0
        enemyLootSkillExperiences[slot] = 0
        enemyLootClaimed[slot] = false
        enemyCount = enemyCount - 1
        return true
    }

    Bool admitDefinedEnemy(
        Int encounterId, Int enemyId,
        Int namespaceId, Int definitionId
    ) {
        if (!started || !extensionRegistry.validate() ||
            !enemyDefinitions.validate() ||
            enemyDefinitions.find(namespaceId, definitionId) < 0 ||
            enemySlot(enemyId) >= 0 || enemyCount >= enemyIds.length) {
            return false
        }
        var stableId = enemyDefinitions.stableId(
            namespaceId, definitionId, enemyId)
        var seed = enemyDefinitions.seed(
            namespaceId, definitionId, enemyId)
        var level = enemyDefinitions.level(namespaceId, definitionId)
        var rank = enemyDefinitions.rank(namespaceId, definitionId)
        var skillId = enemyDefinitions.skill(namespaceId, definitionId)
        var experience = enemyDefinitions.experience(
            namespaceId, definitionId)
        var currency = enemyDefinitions.currency(namespaceId, definitionId)
        if (stableId <= 0 || seed < 0 ||
            !previewLootRoll(stableId, seed, level).accepted() ||
            (experience > 0 && playerSkillDefinitions.find(skillId) < 0) ||
            (currency > 0 &&
                (playerCombatRewardCount >= playerCombatRewardTargets.length ||
                    playerCombatRewardCount >= 16))) {
            return false
        }
        var configuredLoot = 0
        for (var index = 0; index < enemyCount; index = index + 1) {
            if (enemyLootStableIds[index] > 0) {
                configuredLoot = configuredLoot + 1
            }
            if (enemyLootStableIds[index] == stableId) {
                return false
            }
        }
        if (configuredLoot >= 8 || worldLoot.find(stableId) >= 0) {
            return false
        }
        for (var index = 0;
            index < playerCombatRewardCount;
            index = index + 1) {
            if (playerCombatRewardTargets[index] == enemyId) {
                return false
            }
        }
        if (!admitEnemy(
                encounterId, enemyId,
                enemyDefinitions.health(namespaceId, definitionId),
                enemyDefinitions.armor(namespaceId, definitionId),
                enemyDefinitions.weapon(namespaceId, definitionId))) {
            return false
        }
        var slot = enemyCount - 1
        enemyDefinitionNamespaces[slot] = namespaceId
        enemyDefinitionIds[slot] = definitionId
        enemyKinds[slot] = enemyDefinitions.kind(namespaceId, definitionId)
        var configured = configureEnemyRole(
                enemyId,
                enemyDefinitions.role(namespaceId, definitionId),
                enemyDefinitions.moveStep(namespaceId, definitionId),
                enemyDefinitions.projectileStep(namespaceId, definitionId),
                enemyDefinitions.critical(namespaceId, definitionId)) &&
            defineEnemyLootReward(enemyId, stableId, seed, level, rank)
        if (configured && experience > 0) {
            configured = defineEnemyLootProgressionReward(
                enemyId, skillId, experience)
        }
        if (configured && currency > 0) {
            configured = defineEnemyCombatReward(enemyId, currency)
        }
        if (!configured) {
            rollbackDefinedEnemy(enemyId)
            return false
        }
        return true
    }

    Int enemyKind(Int enemyId) {
        var slot = enemySlot(enemyId)
        if (slot < 0) {
            return 0
        }
        return enemyKinds[slot]
    }

    Int enemyDefinitionNamespace(Int enemyId) {
        var slot = enemySlot(enemyId)
        if (slot < 0) {
            return 0
        }
        return enemyDefinitionNamespaces[slot]
    }

    Int enemyDefinitionId(Int enemyId) {
        var slot = enemySlot(enemyId)
        if (slot < 0) {
            return 0
        }
        return enemyDefinitionIds[slot]
    }

    Int activeEnemyKindCount(Int kind) {
        if (kind < enemyDefinitionEliteKind() ||
            kind > enemyDefinitionBossKind()) {
            return -1
        }
        var result = 0
        for (var index = 0; index < enemyCount; index = index + 1) {
            if (enemyKinds[index] == kind &&
                enemyCombat.enemyState(enemyIds[index]) != 7) {
                result = result + 1
            }
        }
        return result
    }

    Bool configureEnemyRole(
        Int enemyId, Int role, Int moveStep,
        Int projectileStep, Int critical
    ) {
        if (critical < 0 || critical > 1 ||
            !enemyCombat.configureEnemyRole(
                enemyId, role, moveStep, projectileStep)) {
            return false
        }
        for (var index = 0; index < enemyCount; index = index + 1) {
            if (enemyIds[index] == enemyId) {
                enemyPerceptionCriticals[index] = critical
                enemyPerceptionActive[index] = true
                enemySpatialPerceptionActive[index] = true
                enemyAutonomous[index] = true
                return true
            }
        }
        return false
    }

    Bool enemyTargetEligible(Int player) {
        return playerConnected(player) &&
            playerCombat.isAlive(player) &&
            enemyCombat.currentHealth(player) > 0 &&
            enemyCombat.hasSpatialPosition(player)
    }

    Int nearestLiveEnemyTarget(Int enemyId) {
        var targetId = 0
        var targetDistance = 1000001
        for (var player = 1; player <= 2; player = player + 1) {
            if (enemyTargetEligible(player)) {
                var distance = enemyCombat.spatialDistance(
                    enemyId, player)
                if (distance >= 0 &&
                    (distance < targetDistance ||
                        (distance == targetDistance &&
                            (targetId == 0 || player < targetId)))) {
                    targetId = player
                    targetDistance = distance
                }
            }
        }
        return targetId
    }

    Bool configureEnemyPerception(
        Int enemyId, Int targetId, Bool targetVisible,
        Int distance, Int critical
    ) {
        if (distance < 0 || (targetVisible && targetId <= 0) ||
            (critical != 0 && critical != 1)) {
            return false
        }
        for (var index = 0; index < enemyCount; index = index + 1) {
            if (enemyIds[index] == enemyId) {
                enemyPerceptionTargets[index] = targetId
                enemyPerceptionVisible[index] = targetVisible
                enemyPerceptionDistances[index] = distance
                enemyPerceptionCriticals[index] = critical
                enemyPerceptionActive[index] = true
                return true
            }
        }
        return false
    }
    Bool configureEnemySpatialPerception(
        Int enemyId, Int targetId, Int critical
    ) {
        if (targetId <= 0 || (critical != 0 && critical != 1)) {
            return false
        }
        for (var index = 0; index < enemyCount; index = index + 1) {
            if (enemyIds[index] == enemyId) {
                enemyPerceptionTargets[index] = targetId
                enemyPerceptionCriticals[index] = critical
                enemySpatialPerceptionActive[index] = true
                enemyPerceptionActive[index] = true
                return true
            }
        }
        return false
    }


    Bool advanceEnemyTick(Int tick) {
        if (!started || tick < 0) {
            return false
        }
        var accepted = true
        for (var index = 0; index < enemyCount && accepted; index = index + 1) {
            if (enemyCombat.enemyState(enemyIds[index]) == 7) {
                continue
            }
            if (enemyAutonomous[index]) {
                var targetId = nearestLiveEnemyTarget(enemyIds[index])
                if (targetId <= 0) { continue }
                lastEnemyDecision = enemyCombat.stepEnemyRoleSpatial(
                    enemyIds[index], tick, targetId,
                    enemyPerceptionCriticals[index])
                if (accepted && lastEnemyDecision.fired() &&
                    lastEnemyDecision.applied() > 0) {
                    var gain = 70
                    if (lastEnemyDecision.died()) {
                        gain = 100
                    }
                    accepted = recordFeedbackEvent(
                        1, enemyIds[index], targetId,
                        enemyCombat.enemySpatialPositionX(targetId),
                        enemyCombat.enemySpatialPositionY(targetId),
                        enemyCombat.enemySpatialPositionZ(targetId),
                        lastEnemyDecision.applied(),
                        lastEnemyDecision.died(),
                        impactClip(1), gain)
                    if (accepted) {
                        pushImpactPresentation(
                            1, enemyIds[index], targetId,
                            enemyCombat.enemySpatialPositionX(targetId),
                            enemyCombat.enemySpatialPositionY(targetId),
                            enemyCombat.enemySpatialPositionZ(targetId),
                            lastEnemyDecision.applied(),
                            lastEnemyDecision.died(),
                            impactClip(1), gain)
                    }
                }
            } else if (enemyPerceptionActive[index]) {
                if (enemySpatialPerceptionActive[index]) {
                    lastEnemyDecision = enemyCombat.stepEnemySpatial(
                        enemyIds[index], tick,
                        enemyPerceptionTargets[index],
                        enemyPerceptionCriticals[index])
                } else {
                    lastEnemyDecision = enemyCombat.stepEnemy(
                        enemyIds[index], tick,
                        enemyPerceptionTargets[index],
                        enemyPerceptionVisible[index],
                        enemyPerceptionDistances[index],
                        enemyPerceptionCriticals[index])
                }
                accepted = lastEnemyDecision.accepted()
            }
        }
        enemyCombat.consumeCombatEvents(tick)
        enemyCombat.advanceSpatialProjectiles(tick)
        return accepted && publishEnemyImpactSnapshots(tick)
    }

    Bool publishEnemyImpactSnapshots(Int tick) {
        while (enemyCombat.pendingSpatialImpacts() > 0) {
            if (!enemyCombat.dequeueSpatialImpact() ||
                enemyImpactSnapshotSequence >= 1000000) {
                return false
            }
            var impact = enemyCombat.lastSpatialImpact()
            enemyImpactSnapshotSequence =
                enemyImpactSnapshotSequence + 1
            var snapshot = EnemyImpactSnapshot(
                enemyImpactSnapshotSequence, tick,
                impact.kind(), impact.projectileId(),
                impact.sourceId(), impact.targetId(),
                impact.x(), impact.y(), impact.z(),
                impact.applied(), impact.died())
            if (!enemyServerImpactSnapshots.push(snapshot) ||
                !recordFeedbackEvent(
                    impact.kind(), impact.sourceId(), impact.targetId(),
                    impact.x(), impact.y(), impact.z(),
                    impact.applied(), impact.died(),
                    impactClip(impact.kind()),
                    impactGain(impact.kind()))) {
                return false
            }
            pushImpactPresentation(
                impact.kind(), impact.sourceId(), impact.targetId(),
                impact.x(), impact.y(), impact.z(),
                impact.applied(), impact.died(),
                impactClip(impact.kind()),
                impactGain(impact.kind()))
        }
        return true
    }

    Bool publishEnemySnapshots(Int tick) {
        for (var index = 0; index < enemyCount; index = index + 1) {
            enemySnapshotSequence = enemySnapshotSequence + 1
            if (!enemyServerSnapshots.push(
                enemyCombat.snapshotEnemy(
                    enemyIds[index], tick, enemySnapshotSequence))) {
                return false
            }
        }
        return true
    }

    EnemyAuthoritySnapshot latestEnemySnapshot() {
        return enemyServerSnapshots.latest()
    }

    Bool applyEnemySnapshot(EnemyAuthoritySnapshot snapshot) {
        if (!started || snapshot.sequence() <= clientEnemySnapshotSequence ||
            snapshot.tick() < clientTick ||
            enemyCombat.enemyState(snapshot.enemyId()) < 0 ||
            !enemyClientSnapshots.push(snapshot)) {
            return false
        }
        clientEnemySnapshotSequence = snapshot.sequence()
        return true
    }

    EnemyAuthoritySnapshot latestClientEnemySnapshot() {
        return enemyClientSnapshots.latest()
    }
    Int impactClip(Int kind) {
        if (kind == 1) {
            return 201
        }
        if (kind == 2) {
            return 202
        }
        return 203
    }

    Int impactGain(Int kind) {
        if (kind == 1) {
            return 100
        }
        if (kind == 2) {
            return 70
        }
        return 35
    }

    Bool impactPresentationAvailable() {
        return impactPresentations.canPush()
    }

    Bool configureImpactAudioListener(
        Int x, Int y, Int z,
        Int rightX, Int rightZ, Int maxDistance
    ) {
        if (x < -1000000 || x > 1000000 ||
            y < -1000000 || y > 1000000 ||
            z < -1000000 || z > 1000000 ||
            rightX < -100 || rightX > 100 ||
            rightZ < -100 || rightZ > 100 ||
            (rightX == 0 && rightZ == 0) ||
            maxDistance <= 0 || maxDistance > 1000000) {
            return false
        }
        audioListenerX = x
        audioListenerY = y
        audioListenerZ = z
        audioListenerRightX = rightX
        audioListenerRightZ = rightZ
        audioListenerMaxDistance = maxDistance
        return true
    }

    Bool pushImpactPresentation(
        Int kind, Int sourceId, Int targetId,
        Int x, Int y, Int z, Int applied, Bool died,
        Int clip, Int gain
    ) {
        var presented = false
        if (impactPresentations.canPush()) {
            impactPresentationSequence = impactPresentationSequence + 1
            presented = impactPresentations.push(
                impactPresentationSequence, kind, sourceId, targetId,
                x, y, z, applied, died, clip, gain)
        }
        if (!presented) {
            impactPresentationDropCountValue =
                impactPresentationDropCountValue + 1
        }
        if (impactAudio.canQueue()) {
            impactAudio.queueSpatial(
                clip, gain, x, y, z,
                audioListenerX, audioListenerY,
                audioListenerZ, audioListenerRightX,
                audioListenerRightZ, audioListenerMaxDistance)
        }
        return presented
    }

    Bool presentEnemyResolution(ResolutionResult result, Int tick) {
        if (!result.accepted() || result.applied() <= 0) {
            return true
        }
        var gain = 70
        if (result.died()) {
            gain = 100
        }
        var targetId = result.targetId()
        var clip = impactClip(1)
        pushImpactPresentation(
            1, result.sourceId(), targetId,
            enemyCombat.enemySpatialPositionX(targetId),
            enemyCombat.enemySpatialPositionY(targetId),
            enemyCombat.enemySpatialPositionZ(targetId),
            result.applied(), result.died(), clip, gain)
        var died = 0
        if (result.died()) {
            died = 1
        }
        recordReplayPresentation(
            tick, 3, result.eventSequence(), result.sourceId(), targetId,
            enemyCombat.enemySpatialPositionX(targetId),
            enemyCombat.enemySpatialPositionY(targetId),
            enemyCombat.enemySpatialPositionZ(targetId),
            result.applied(), clip, gain, died)
        return true
    }

    Bool presentEnemyImpactSnapshot(EnemyImpactSnapshot snapshot) {
        var clip = impactClip(snapshot.kind())
        var gain = impactGain(snapshot.kind())
        pushImpactPresentation(
            snapshot.kind(), snapshot.sourceId(), snapshot.targetId(),
            snapshot.x(), snapshot.y(), snapshot.z(),
            snapshot.applied(), snapshot.died(), clip, gain)
        var died = 0
        if (snapshot.died()) {
            died = 1
        }
        recordReplayPresentation(
            snapshot.tick(), 3, snapshot.sequence(), snapshot.sourceId(),
            snapshot.targetId(), snapshot.x(), snapshot.y(), snapshot.z(),
            snapshot.applied(), clip, gain, died)
        return true
    }

    EnemyImpactSnapshot latestEnemyImpactSnapshot() {
        return enemyServerImpactSnapshots.latest()
    }

    Bool applyEnemyImpactSnapshot(EnemyImpactSnapshot snapshot) {
        if (!started ||
            snapshot.sequence() <= clientEnemyImpactSnapshotSequence ||
            snapshot.tick() < clientTick ||
            !enemyClientImpactSnapshots.push(snapshot)) {
            return false
        }
        clientEnemyImpactSnapshotSequence = snapshot.sequence()
        presentEnemyImpactSnapshot(snapshot)
        return true
    }

