    ResolutionResult resolvePlayerHitscanAt(
        Int sourceId, Int targetId, Int serverTickValue,
        Int shotTick, Int distance, Int critical
    ) {
        if (shotTick < 0 || serverTickValue < shotTick ||
            serverTickValue - shotTick >= netcodeMaximumRewindTicks()) {
            return ResolutionResult(
                false, 0, sourceId, targetId, 0,
                playerCombat.currentHealth(targetId), false, 0)
        }
        var historicalDistance =
            serverRewindHistory.distance(sourceId, targetId, shotTick)
        var effectiveDistance = distance
        if (historicalDistance >= 0) {
            effectiveDistance = historicalDistance
        }
        return resolvePlayerHitscan(
            sourceId, targetId, serverTickValue,
            effectiveDistance, critical)
    }

    ResolutionResult resolvePlayerHitscan(
        Int sourceId, Int targetId, Int tick, Int distance, Int critical
    ) {
        var reward = combatRewardCurrency(targetId)
        if (!canGrantCombatReward(sourceId, reward)) {
            return ResolutionResult(
                false, 0, sourceId, targetId, 0,
                playerCombat.currentHealth(targetId), false, 0)
        }
        var result = playerCombat.resolveHitscan(
            sourceId, targetId, tick, distance, critical)
        if (result.accepted() && result.died() && reward > 0 &&
            !grantCombatReward(sourceId, targetId, reward)) {
            return ResolutionResult(
                false, result.actionId(), sourceId, targetId,
                result.applied(), result.remainingHealth(),
                result.died(), result.eventSequence())
        }
        return result
    }
