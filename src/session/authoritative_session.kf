    BoundedSkillActivationResult activatePlayerSkill(
        Int player, Int skillId, Int tick
    ) {
        var result = BoundedSkillActivationResult()
        if (player == 1 && playerOneConnected) {
            if (playerOneSkills.activate(
                skillId, tick, playerOneSkillResource,
                playerSkillDefinitions, result)) {
                playerOneSkillResource = playerOneSkillResource - result.resourceCost()
            }
        } else if (player == 2 && playerTwoConnected) {
            if (playerTwoSkills.activate(
                skillId, tick, playerTwoSkillResource,
                playerSkillDefinitions, result)) {
                playerTwoSkillResource = playerTwoSkillResource - result.resourceCost()
            }
        }
        return result
    }

    Bool setPlayerSkillResource(Int player, Int amount) {
        if (amount < 0 || amount > 1000000) {
            return false
        }
        if (player == 1 && playerOneConnected) {
            playerOneSkillResource = amount
            return true
        }
        if (player == 2 && playerTwoConnected) {
            playerTwoSkillResource = amount
            return true
        }
        return false
    }

    Int playerSkillResource(Int player) {
        if (player == 1 && playerOneConnected) {
            return playerOneSkillResource
        }
        if (player == 2 && playerTwoConnected) {
            return playerTwoSkillResource
        }
        return -1
    }

    Int playerSkillCooldown(Int player, Int skillId, Int tick) {
        if (player == 1 && playerOneConnected) {
            return playerOneSkills.cooldownRemaining(skillId, tick)
        }
        if (player == 2 && playerTwoConnected) {
            return playerTwoSkills.cooldownRemaining(skillId, tick)
        }
        return -1
    }

    Bool learnPlayerSkill(Int player, Int skillId) {
        var skills = playerOneSkills
        if (player == 2 && playerTwoConnected) {
            skills = playerTwoSkills
        } else if (player != 1 || !playerOneConnected) {
            return false
        }
        var previous = new Int[skills.replayStateLength()]
        if (!skills.encodeReplayState(previous) ||
            !skills.learn(skillId, playerSkillDefinitions)) {
            return false
        }
        if (refreshPlayerCombatModifiers(player)) {
            return true
        }
        skills.restoreReplayState(previous, playerSkillDefinitions)
        refreshPlayerCombatModifiers(player)
        return false
    }

    Bool gainPlayerSkillExperience(Int player, Int skillId, Int amount) {
        var skills = playerOneSkills
        if (player == 2 && playerTwoConnected) {
            skills = playerTwoSkills
        } else if (player != 1 || !playerOneConnected) {
            return false
        }
        var previous = new Int[skills.replayStateLength()]
        if (!skills.encodeReplayState(previous) ||
            !skills.gainExperience(
                skillId, amount, playerSkillDefinitions)) {
            return false
        }
        if (refreshPlayerCombatModifiers(player)) {
            return true
        }
        skills.restoreReplayState(previous, playerSkillDefinitions)
        refreshPlayerCombatModifiers(player)
        return false
    }

