    Int clampDoorScreen(Int value) {
        if (value < -98) {
            return -98
        }
        if (value > 98) {
            return 98
        }
        return value
    }

    Int projectDoorX(Int x, Int z, CameraState camera) {
        return clampDoorScreen(
            (x - z) * 3 + camera.currentYaw() / 10)
    }

    Int projectDoorY(
        Int x, Int y, Int z, CameraState camera
    ) {
        return clampDoorScreen(
            (x + z) * 2 - y * 6 - 55 -
            camera.currentPitch() / 10)
    }

    Bool pushDoorTriangle(
        FrameStaging target, Int resource,
        Int ax, Int ay, Int az,
        Int bx, Int by, Int bz,
        Int cx, Int cy, Int cz,
        Int stateV, CameraState camera
    ) {
        return target.pushVertex(
                resource, projectDoorX(ax, az, camera),
                projectDoorY(ax, ay, az, camera), 0, stateV) &&
            target.pushVertex(
                resource, projectDoorX(bx, bz, camera),
                projectDoorY(bx, by, bz, camera), 50, stateV) &&
            target.pushVertex(
                resource, projectDoorX(cx, cz, camera),
                projectDoorY(cx, cy, cz, camera), 100, stateV)
    }

    Bool stageWorldInteractionGeometry(
        FrameStaging target, Int frame, Int resource,
        CameraState camera
    ) {
        if (!started || resource <= 0 ||
            target.vertexCapacity() <
                worldInteractions.doorRenderVertexCount() ||
            !target.begin(frame)) {
            return false
        }
        for (var index = 0; index < worldInteractions.size(); index = index + 1) {
            var id = worldInteractions.idAt(index)
            if (worldInteractions.kind(id) != 2) {
                continue
            }
            var x0 = worldInteractions.positionX(id) -
                worldInteractions.doorHalfWidth(id)
            var x1 = worldInteractions.positionX(id) +
                worldInteractions.doorHalfWidth(id)
            var y0 = worldInteractions.positionY(id) -
                worldInteractions.doorHalfHeight(id)
            var y1 = worldInteractions.positionY(id) +
                worldInteractions.doorHalfHeight(id)
            var z0 = worldInteractions.positionZ(id) -
                worldInteractions.doorHalfDepth(id)
            var z1 = worldInteractions.positionZ(id) +
                worldInteractions.doorHalfDepth(id)
            var stateV = 0
            if (clientInteractionFlags[index]) {
                var lift = worldInteractions.doorHalfHeight(id) * 2 + 1
                y0 = y0 + lift
                y1 = y1 + lift
                stateV = 100
            }
            if (!pushDoorTriangle(
                    target, resource,
                    x0, y0, z0, x1, y0, z0, x1, y1, z0,
                    stateV, camera) ||
                !pushDoorTriangle(
                    target, resource,
                    x0, y0, z0, x1, y1, z0, x0, y1, z0,
                    stateV, camera) ||
                !pushDoorTriangle(
                    target, resource,
                    x1, y0, z1, x0, y0, z1, x0, y1, z1,
                    stateV, camera) ||
                !pushDoorTriangle(
                    target, resource,
                    x1, y0, z1, x0, y1, z1, x1, y1, z1,
                    stateV, camera) ||
                !pushDoorTriangle(
                    target, resource,
                    x0, y0, z1, x0, y0, z0, x0, y1, z0,
                    stateV, camera) ||
                !pushDoorTriangle(
                    target, resource,
                    x0, y0, z1, x0, y1, z0, x0, y1, z1,
                    stateV, camera) ||
                !pushDoorTriangle(
                    target, resource,
                    x1, y0, z0, x1, y0, z1, x1, y1, z1,
                    stateV, camera) ||
                !pushDoorTriangle(
                    target, resource,
                    x1, y0, z0, x1, y1, z1, x1, y1, z0,
                    stateV, camera) ||
                !pushDoorTriangle(
                    target, resource,
                    x0, y0, z1, x1, y0, z1, x1, y0, z0,
                    stateV, camera) ||
                !pushDoorTriangle(
                    target, resource,
                    x0, y0, z1, x1, y0, z0, x0, y0, z0,
                    stateV, camera) ||
                !pushDoorTriangle(
                    target, resource,
                    x0, y1, z0, x1, y1, z0, x1, y1, z1,
                    stateV, camera) ||
                !pushDoorTriangle(
                    target, resource,
                    x0, y1, z0, x1, y1, z1, x0, y1, z1,
                    stateV, camera)) {
                target.discard()
                return false
            }
        }
        return target.publish()
    }

