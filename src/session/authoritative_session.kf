    Bool defineEnemyLootReward(
        Int enemyId, Int stableId, Int seed, Int level, Int rank
    ) {
        var slot = enemySlot(enemyId)
        if (slot < 0 || enemyLootStableIds[slot] != 0 ||
            stableId <= 0 || stableId > 1000000 ||
            seed < 0 || seed > 1000000 ||
            level <= 0 || level > 1000000 ||
            rank < 1 || rank > 3 ||
            worldLoot.find(stableId) >= 0) {
            return false
        }
        var configuredCount = 0
        for (var index = 0; index < enemyCount; index = index + 1) {
            if (enemyLootStableIds[index] != 0) {
                configuredCount = configuredCount + 1
            }
            if (enemyLootStableIds[index] == stableId) {
                return false
            }
        }
        if (configuredCount >= 8 ||
            !previewLootRoll(stableId, seed, level).accepted()) {
            return false
        }
        enemyLootStableIds[slot] = stableId
        enemyLootSeeds[slot] = seed
        enemyLootLevels[slot] = level
        enemyLootRanks[slot] = rank
        enemyLootSkillIds[slot] = 0
        enemyLootSkillExperiences[slot] = 0
        enemyLootClaimed[slot] = false
        return true
    }

    Bool defineEnemyLootProgressionReward(
        Int enemyId, Int skillId, Int skillExperience
    ) {
        var slot = enemySlot(enemyId)
        if (slot < 0 || enemyLootStableIds[slot] <= 0 ||
            enemyLootRanks[slot] != 3 || enemyLootClaimed[slot] ||
            enemyLootSkillIds[slot] != 0 ||
            skillId <= 0 || skillId > 1000000 ||
            skillExperience <= 0 || skillExperience > 1000000 ||
            playerSkillDefinitions.find(skillId) < 0) {
            return false
        }
        enemyLootSkillIds[slot] = skillId
        enemyLootSkillExperiences[slot] = skillExperience
        return true
    }

