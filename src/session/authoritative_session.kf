    Bool recordReplayPresentation(
        Int tick, Int kind, Int sequence, Int sourceId, Int targetId,
        Int valueOne, Int valueTwo, Int valueThree, Int valueFour,
        Int valueFive, Int valueSix, Int flag
    ) {
        if (flag != 0 && flag != 1) {
            return false
        }
        return replayPresentationHistory.append(ReplayPresentationEvent(
            tick, kind, sequence, sourceId, targetId,
            valueOne, valueTwo, valueThree, valueFour, valueFive, valueSix,
            flag == 1))
