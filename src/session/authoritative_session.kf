    Bool setEnemySpatialPosition(Int id, Int x, Int y, Int z) {
        if (!enemyCombat.setSpatialPosition(id, x, y, z)) {
            return false
        }
        if (id == 1 && playerOneConnected) {
            return serverMovement.setPosition(1, x) &&
                clientMovement.setPosition(1, x) &&
                playerOnePrediction.restore(x, serverTick)
        }
        if (id == 2 && playerTwoConnected) {
            return serverMovement.setPosition(2, x) &&
                clientMovement.setPosition(2, x) &&
                playerTwoPrediction.restore(x, serverTick)
        }
        return true
    }

