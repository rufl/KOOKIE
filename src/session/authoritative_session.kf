    Int replaySidecarBaseLength() {
        return playerOneInventory.replayStateLength() +
            playerOneEquipment.replayStateLength() +
            playerTwoInventory.replayStateLength() +
            playerTwoEquipment.replayStateLength() +
            broadPhaseCollection.replayStateLength()
    }

    Int replaySidecarLength() {
        return replaySidecarBaseLength() +
            replayPresentationHistory.replayStateLength()
    }

    Bool encodeReplaySidecar(Int[] target) {
        if (target.length != replaySidecarLength() || !started) {
            return false
        }
        var inventoryOne = new Int[playerOneInventory.replayStateLength()]
        var equipmentOne = new Int[playerOneEquipment.replayStateLength()]
        var inventoryTwo = new Int[playerTwoInventory.replayStateLength()]
        var equipmentTwo = new Int[playerTwoEquipment.replayStateLength()]
        var world = new Int[broadPhaseCollection.replayStateLength()]
        if (!playerOneInventory.encodeReplayState(inventoryOne) ||
            !playerOneEquipment.encodeReplayState(equipmentOne) ||
            !playerTwoInventory.encodeReplayState(inventoryTwo) ||
            !playerTwoEquipment.encodeReplayState(equipmentTwo) ||
            !broadPhaseCollection.encodeReplayState(world)) {
            return false
        }
        var offset = 0
        for (var index = 0; index < inventoryOne.length; index = index + 1) {
            target[offset + index] = inventoryOne[index]
        }
        offset = offset + inventoryOne.length
        for (var equipmentOneIndex = 0;
             equipmentOneIndex < equipmentOne.length;
             equipmentOneIndex = equipmentOneIndex + 1) {
            target[offset + equipmentOneIndex] = equipmentOne[equipmentOneIndex]
        }
        offset = offset + equipmentOne.length
        for (var inventoryTwoIndex = 0;
             inventoryTwoIndex < inventoryTwo.length;
             inventoryTwoIndex = inventoryTwoIndex + 1) {
            target[offset + inventoryTwoIndex] = inventoryTwo[inventoryTwoIndex]
        }
        offset = offset + inventoryTwo.length
        for (var equipmentTwoIndex = 0;
             equipmentTwoIndex < equipmentTwo.length;
             equipmentTwoIndex = equipmentTwoIndex + 1) {
            target[offset + equipmentTwoIndex] = equipmentTwo[equipmentTwoIndex]
        }
        offset = offset + equipmentTwo.length
        for (var worldIndex = 0; worldIndex < world.length; worldIndex = worldIndex + 1) {
            target[offset + worldIndex] = world[worldIndex]
        }
        offset = offset + world.length
        var presentation = new Int[replayPresentationHistory.replayStateLength()]
        if (!replayPresentationHistory.encodeReplayState(presentation)) {
            return false
        }
        for (var presentationIndex = 0;
            presentationIndex < presentation.length;
            presentationIndex = presentationIndex + 1) {
            target[offset + presentationIndex] = presentation[presentationIndex]
        }
        return true
    }

    Bool restoreReplaySidecar(Int[] source) {
        if (source.length < replaySidecarBaseLength() + 1) {
            return false
        }
        var offset = 0
        var state = new Int[playerOneInventory.replayStateLength()]
        for (var index = 0; index < state.length; index = index + 1) {
            state[index] = source[offset + index]
        }
        if (!playerOneInventory.restoreReplayState(state)) {
            return false
        }
        offset = offset + state.length
        state = new Int[playerOneEquipment.replayStateLength()]
        for (var equipmentOneIndex = 0; equipmentOneIndex < state.length; equipmentOneIndex = equipmentOneIndex + 1) {
            state[equipmentOneIndex] = source[offset + equipmentOneIndex]
        }
        if (!playerOneEquipment.restoreReplayState(state, playerOneInventory)) {
            return false
        }
        offset = offset + state.length
        state = new Int[playerTwoInventory.replayStateLength()]
        for (var inventoryTwoIndex = 0; inventoryTwoIndex < state.length; inventoryTwoIndex = inventoryTwoIndex + 1) {
            state[inventoryTwoIndex] = source[offset + inventoryTwoIndex]
        }
        if (!playerTwoInventory.restoreReplayState(state)) {
            return false
        }
        offset = offset + state.length
        state = new Int[playerTwoEquipment.replayStateLength()]
        for (var equipmentTwoIndex = 0; equipmentTwoIndex < state.length; equipmentTwoIndex = equipmentTwoIndex + 1) {
            state[equipmentTwoIndex] = source[offset + equipmentTwoIndex]
        }
        if (!playerTwoEquipment.restoreReplayState(state, playerTwoInventory)) {
            return false
        }
        offset = offset + state.length
        state = new Int[broadPhaseCollection.replayStateLength()]
        for (var worldIndex = 0; worldIndex < state.length; worldIndex = worldIndex + 1) {
            state[worldIndex] = source[offset + worldIndex]
        }
        if (!broadPhaseCollection.restoreReplayState(state) ||
            !clientBroadPhaseCollection.restoreReplayState(state)) {
            return false
        }
        broadPhaseRevisionValue = broadPhaseCollection.geometryRevision()
        clientBroadPhaseRevisionValue =
            clientBroadPhaseCollection.geometryRevision()
        offset = offset + state.length
        if (source[offset] < 0 ||
            source[offset] > replayPresentationHistory.capacity()) {
            return false
        }
        var presentationLength = 1 + source[offset] * 12
        if (source.length != offset + presentationLength) {
            return false
        }
        var presentation = new Int[presentationLength]
        for (var presentationIndex = 0;
            presentationIndex < presentationLength;
            presentationIndex = presentationIndex + 1) {
            presentation[presentationIndex] = source[offset + presentationIndex]
        }
        if (!replayPresentationHistory.restoreReplayState(presentation)) {
            return false
        }
        return true
    }

    Int replayCheckpointLength() {
        return 120 + enemyCombat.replayStateLength() + worldInteractions.replayStateLength() + 16
    }

    Int worldInteractionReplayStateLength() {
        return worldInteractions.replayStateLength()
    }

    Bool encodeReplayCheckpoint(Int[] target) {
        if (target.length != replayCheckpointLength() || !started) {
            return false
        }
        var combatState = new Int[46]
        var skillOneState = new Int[19]
        var statusOneState = new Int[15]
        var skillTwoState = new Int[19]
        var statusTwoState = new Int[15]
        var enemyState = new Int[enemyCombat.replayStateLength()]
        var worldState = new Int[worldInteractions.replayStateLength()]
        if (!playerCombat.encodeReplayState(combatState) ||
            !playerOneSkills.encodeReplayState(skillOneState) ||
            !playerOneStatuses.encodeReplayState(statusOneState) ||
            !playerTwoSkills.encodeReplayState(skillTwoState) ||
            !playerTwoStatuses.encodeReplayState(statusTwoState) ||
            !enemyCombat.encodeReplayState(enemyState) ||
            !worldInteractions.encodeReplayState(worldState)) {
            return false
        }
        target[0] = serverTick
        target[1] = serverMovement.position(1)
        target[2] = serverMovement.position(2)
        target[3] = snapshotSequence
        for (var index = 0; index < combatState.length; index = index + 1) {
            target[index + 4] = combatState[index]
        }
        for (var skillIndex = 0; skillIndex < skillOneState.length; skillIndex = skillIndex + 1) {
            target[50 + skillIndex] = skillOneState[skillIndex]
        }
        for (var statusIndex = 0; statusIndex < statusOneState.length; statusIndex = statusIndex + 1) {
            target[69 + statusIndex] = statusOneState[statusIndex]
        }
        for (var skillTwoIndex = 0; skillTwoIndex < skillTwoState.length; skillTwoIndex = skillTwoIndex + 1) {
            target[84 + skillTwoIndex] = skillTwoState[skillTwoIndex]
        }
        for (var statusTwoIndex = 0; statusTwoIndex < statusTwoState.length; statusTwoIndex = statusTwoIndex + 1) {
            target[103 + statusTwoIndex] = statusTwoState[statusTwoIndex]
        }
        target[118] = playerOneSkillResource
        target[119] = playerTwoSkillResource
        for (var enemyIndex = 0; enemyIndex < enemyState.length; enemyIndex = enemyIndex + 1) {
            target[120 + enemyIndex] = enemyState[enemyIndex]
        }
        var worldOffset = 120 + enemyState.length
        for (var worldIndex = 0; worldIndex < worldState.length; worldIndex = worldIndex + 1) {
            target[worldOffset + worldIndex] = worldState[worldIndex]
        }
        for (var player = 1; player <= 2; player = player + 1) {
            var commandOffset = worldOffset + worldState.length + (player - 1) * 6
            target[commandOffset] = interactionSequences[player]
            target[commandOffset + 1] = interactionTicks[player]
            target[commandOffset + 2] = interactionTargets[player]
            target[commandOffset + 3] = interactionResultTicks[player]
            target[commandOffset + 4] = interactionResultTargets[player]
            target[commandOffset + 5] = 0
            if (interactionResults[player]) {
                target[commandOffset + 5] = 1
            }
        }
        target[target.length - 4] = playerOneEdges.fireHeld()
        target[target.length - 3] = playerOneEdges.jumpHeld()
        target[target.length - 2] = playerTwoEdges.fireHeld()
        target[target.length - 1] = playerTwoEdges.jumpHeld()
        return true
    }
    Bool appendReplayCheckpointBundle(
        BoundedReplayTimeline timeline, Int tick, Int hash
    ) {
        if (!started || tick < 0 || tick != serverTick) {
            return false
        }
        var checkpoint = new Int[replayCheckpointLength()]
        var sidecar = new Int[replaySidecarLength()]
        if (!encodeReplayCheckpoint(checkpoint) ||
            !encodeReplaySidecar(sidecar)) {
            return false
        }
        return timeline.appendCheckpointBundle(tick, hash, checkpoint, sidecar)
    }

    Bool applyReplayCheckpointBundle(
        BoundedReplayTimeline timeline, Int targetTick
    ) {
        if (!started || paused || targetTick < 0 ||
            !timeline.seek(targetTick) ||
            timeline.seekSidecarLength() < replaySidecarBaseLength() + 1) {
            return false
        }
        if (!applyReplayCheckpoint(timeline, targetTick)) {
            return false
        }
        var sidecar = new Int[timeline.seekSidecarLength()]
        for (var index = 0; index < sidecar.length; index = index + 1) {
            sidecar[index] = timeline.seekSidecarValue(index)
        }
        return restoreReplaySidecar(sidecar)
    }


    Bool applyReplayCheckpoint(
        BoundedReplayTimeline timeline, Int targetTick
    ) {
        if (!started || paused || targetTick < 0 ||
            !timeline.seek(targetTick)) {
            return false
        }
        var length = timeline.seekSnapshotLength()
        var previousFullLength = 120 + enemyCombat.replayStateLength()
        var hasWorldState = length == replayCheckpointLength() || length == replayCheckpointLength() - 4
        if (!hasWorldState && worldInteractions.size() != 0) {
            return false
        }
        if (length == 0) {
            return true
        }
        if (length != 1 && length != 4 && length != 50 && length != 120 &&
            length != previousFullLength && !hasWorldState) {
            return false
        }
        if (length == 1 && playerTwoConnected) {
            return false
        }
        var restoredTick = 0
        var restoredSequence = 0
        var positionOne = 0
        var positionTwo = 0
        if (length == 1) {
            positionOne = timeline.seekSnapshotValue(0)
        } else {
            restoredTick = timeline.seekSnapshotValue(0)
            positionOne = timeline.seekSnapshotValue(1)
            positionTwo = timeline.seekSnapshotValue(2)
            restoredSequence = timeline.seekSnapshotValue(3)
        }
        if (restoredTick < 0 || restoredTick > targetTick ||
            restoredSequence < 0) {
            return false
        }
        if (length == replayCheckpointLength()) {
            for (var index = length - 4; index < length; index = index + 1) {
                if (timeline.seekSnapshotValue(index) < 0 || timeline.seekSnapshotValue(index) > 1) {
                    return false
                }
            }
        }
        var decodedInteractions = BoundedInteractionWorld(16, 1000000)
        var worldOffset = previousFullLength
        var worldLength = worldInteractions.replayStateLength()
        if (hasWorldState) {
            var currentWorldState = new Int[worldLength]
            var decodedWorldState = new Int[worldLength]
            if (!worldInteractions.encodeReplayState(currentWorldState)) {
                return false
            }
            for (var index = 0; index < worldLength; index = index + 1) {
                decodedWorldState[index] =
                    timeline.seekSnapshotValue(worldOffset + index)
            }
            if (decodedWorldState[0] != currentWorldState[0] ||
                decodedWorldState[1] != currentWorldState[1] ||
                decodedWorldState[2] != currentWorldState[2]) {
                return false
            }
            for (var index = 0; index < 16; index = index + 1) {
                var offset = 3 + index * 12
                if (decodedWorldState[offset] !=
                        currentWorldState[offset] ||
                    decodedWorldState[offset + 1] !=
                        currentWorldState[offset + 1] ||
                    decodedWorldState[offset + 2] !=
                        currentWorldState[offset + 2] ||
                    decodedWorldState[offset + 3] !=
                        currentWorldState[offset + 3] ||
                    decodedWorldState[offset + 4] !=
                        currentWorldState[offset + 4] ||
                    decodedWorldState[offset + 5] !=
                        currentWorldState[offset + 5] ||
                    decodedWorldState[offset + 6] !=
                        currentWorldState[offset + 6] ||
                    decodedWorldState[offset + 7] !=
                        currentWorldState[offset + 7] ||
                    decodedWorldState[offset + 9] !=
                        currentWorldState[offset + 9] ||
                    decodedWorldState[offset + 10] !=
                        currentWorldState[offset + 10] ||
                    decodedWorldState[offset + 11] !=
                        currentWorldState[offset + 11]) {
                    return false
                }
            }
            if (!decodedInteractions.restoreReplayState(
                    decodedWorldState)) {
                return false
            }
            for (var player = 1; player <= 2; player = player + 1) {
                var offset = worldOffset + worldLength + (player - 1) * 6
                var sequence = timeline.seekSnapshotValue(offset)
                var tick = timeline.seekSnapshotValue(offset + 1)
                var target = timeline.seekSnapshotValue(offset + 2)
                var resultTick = timeline.seekSnapshotValue(offset + 3)
                var resultTarget = timeline.seekSnapshotValue(offset + 4)
                var result = timeline.seekSnapshotValue(offset + 5)
                if (sequence < 0 || sequence > 1000000 || tick < 0 ||
                    resultTick < 0 || resultTick > restoredTick || result < 0 || result > 1 ||
                    (target == 0 && tick != 0) ||
                    (target != 0 && (decodedInteractions.kind(target) == 0 ||
                        sequence == 0 || tick <= restoredTick || tick - restoredTick > 4)) ||
                    (resultTarget == 0 && (resultTick != 0 || result != 0)) ||
                    (resultTarget != 0 && (decodedInteractions.kind(resultTarget) == 0 ||
                        resultTick == 0 || sequence == 0)) ||
                    (result == 1 && !decodedInteractions.activated(resultTarget))) {
                    return false
                }
            }
        }
        if (length == 50 || length == 120 ||
            length == previousFullLength || hasWorldState) {
            var combatState = new Int[46]
            for (var index = 0; index < combatState.length; index = index + 1) {
                combatState[index] = timeline.seekSnapshotValue(index + 4)
            }
            if (!playerCombat.restoreReplayState(combatState)) {
                return false
            }
        }
        if (length == 120 || length == previousFullLength || hasWorldState) {
            var skillOneState = new Int[19]
            var statusOneState = new Int[15]
            var skillTwoState = new Int[19]
            var statusTwoState = new Int[15]
            for (var skillOneIndex = 0; skillOneIndex < skillOneState.length; skillOneIndex = skillOneIndex + 1) {
                skillOneState[skillOneIndex] = timeline.seekSnapshotValue(50 + skillOneIndex)
            }
            for (var statusOneIndex = 0; statusOneIndex < statusOneState.length; statusOneIndex = statusOneIndex + 1) {
                statusOneState[statusOneIndex] = timeline.seekSnapshotValue(69 + statusOneIndex)
            }
            for (var skillTwoIndex = 0; skillTwoIndex < skillTwoState.length; skillTwoIndex = skillTwoIndex + 1) {
                skillTwoState[skillTwoIndex] = timeline.seekSnapshotValue(84 + skillTwoIndex)
            }
            for (var statusTwoIndex = 0; statusTwoIndex < statusTwoState.length; statusTwoIndex = statusTwoIndex + 1) {
                statusTwoState[statusTwoIndex] = timeline.seekSnapshotValue(103 + statusTwoIndex)
            }
            var decodedSkillOne = BoundedSkillProgression(4)
            var decodedStatusOne = BoundedStatusEffects(4)
            var decodedSkillTwo = BoundedSkillProgression(4)
            var decodedStatusTwo = BoundedStatusEffects(4)
            if (!decodedSkillOne.restoreReplayState(
                    skillOneState, playerSkillDefinitions) ||
                !decodedStatusOne.restoreReplayState(
                    statusOneState, playerStatusDefinitions) ||
                !decodedSkillTwo.restoreReplayState(
                    skillTwoState, playerSkillDefinitions) ||
                !decodedStatusTwo.restoreReplayState(
                    statusTwoState, playerStatusDefinitions) ||
                timeline.seekSnapshotValue(118) < 0 ||
                timeline.seekSnapshotValue(119) < 0) {
                return false
            }
            playerOneSkills = decodedSkillOne
            playerOneStatuses = decodedStatusOne
            playerTwoSkills = decodedSkillTwo
            playerTwoStatuses = decodedStatusTwo
            playerOneSkillResource = timeline.seekSnapshotValue(118)
            playerTwoSkillResource = timeline.seekSnapshotValue(119)
        }
        if (length == previousFullLength || hasWorldState) {
            var enemyState = new Int[enemyCombat.replayStateLength()]
            for (var enemyIndex = 0; enemyIndex < enemyState.length; enemyIndex = enemyIndex + 1) {
                enemyState[enemyIndex] = timeline.seekSnapshotValue(120 + enemyIndex)
            }
            if (!enemyCombat.restoreReplayState(enemyState) ||
                !impactPresentations.reset() ||
                !impactAudio.reset()) {
                return false
            }
        }
        if (!clock.setState(restoredTick, 0)) {
            return false
        }
        if (playerOneConnected) {
            if (!serverMovement.setPosition(1, positionOne) ||
                !clientMovement.setPosition(1, positionOne) ||
                !playerOneSnapshots.reset() ||
                !playerOnePrediction.restore(positionOne, restoredTick)) {
                return false
            }
        }
        if (playerTwoConnected) {
            if (!serverMovement.setPosition(2, positionTwo) ||
                !clientMovement.setPosition(2, positionTwo) ||
                !playerTwoSnapshots.reset() ||
                !playerTwoPrediction.restore(positionTwo, restoredTick)) {
                return false
            }
        }
        if (length == 120 || length == previousFullLength || hasWorldState) {
            if ((playerOneConnected && !refreshPlayerCombatModifiers(1)) ||
                (playerTwoConnected && !refreshPlayerCombatModifiers(2))) {
                return false
            }
        }
        playerOneInputs.clearPending()
        playerTwoInputs.clearPending()
        playerOneEdges.clearHeld()
        playerTwoEdges.clearHeld()
        if (length == replayCheckpointLength()) {
            playerOneEdges.restoreHeld(timeline.seekSnapshotValue(length - 4), timeline.seekSnapshotValue(length - 3))
            playerTwoEdges.restoreHeld(timeline.seekSnapshotValue(length - 2), timeline.seekSnapshotValue(length - 1))
        }
        if (hasWorldState) {
            worldInteractions = decodedInteractions
            for (var player = 1; player <= 2; player = player + 1) {
                var offset = worldOffset + worldLength + (player - 1) * 6
                interactionSequences[player] = timeline.seekSnapshotValue(offset)
                interactionTicks[player] = timeline.seekSnapshotValue(offset + 1)
                interactionTargets[player] = timeline.seekSnapshotValue(offset + 2)
                interactionResultTicks[player] = timeline.seekSnapshotValue(offset + 3)
                interactionResultTargets[player] = timeline.seekSnapshotValue(offset + 4)
                interactionResults[player] = timeline.seekSnapshotValue(offset + 5) == 1
            }
            publishWorldInteractions()
        }
        serverTick = restoredTick
        clientTick = restoredTick
        snapshotSequence = restoredSequence
        playerOneReplay.reset()
        playerTwoReplay.reset()
        interactionReplay.reset()
        return true
    }

    Bool queueReplayCommands(
        Int player, BoundedReplayTimeline timeline, Int targetTick
    ) {
        if (!started || paused || targetTick < 0 ||
            timeline.interactionCount() != 0 || (player != 1 && player != 2)) {
            return false
        }
        var staged = InputReplayRecorder(64)
        if (!applyReplayCheckpoint(timeline, targetTick) ||
            !timeline.stageSeekCommands(staged)) {
            return false
        }
        while (staged.playNext()) {
            var command = staged.lastPlayed()
            if (!receiveInputCommand(player, command)) {
                return false
            }
        }
        return true
    }

    Bool replayTimelineToTick(
        Int movementPlayer, BoundedReplayTimeline timeline, Int targetTick
    ) {
        if (!started || paused || inputReplayEnabled || !playerFocused(movementPlayer) ||
            targetTick < 0 || targetTick > 1000000 || !timeline.seek(targetTick) ||
            timeline.seekSnapshotLength() != replayCheckpointLength() ||
            timeline.seekSidecarLength() < replaySidecarBaseLength() + 1) {
            return false
        }
        var baseTick = timeline.seekSnapshotValue(0)
        if (baseTick < 0 || baseTick > targetTick || targetTick - baseTick > 4096 ||
            (timeline.seekCheckpointIndex() >= 0 &&
                timeline.checkpointTick(timeline.seekCheckpointIndex()) != baseTick)) {
            return false
        }
        var movements = InputReplayRecorder(64)
        var interactions = InteractionReplayRecorder(64)
        var lastMovementTick = baseTick
        while (timeline.seekNextCommand()) {
            var command = timeline.lastSeekCommand()
            if (command.tick() <= lastMovementTick || !movements.append(command)) {
                return false
            }
            lastMovementTick = command.tick()
        }
        var checkpointSequences = new Int[3]
        var pendingTicks = new Int[3]
        var pendingTargets = new Int[3]
        for (var player = 1; player <= 2; player = player + 1) {
            var offset = timeline.seekSnapshotLength() - 16 + (player - 1) * 6
            checkpointSequences[player] = timeline.seekSnapshotValue(offset)
            pendingTicks[player] = timeline.seekSnapshotValue(offset + 1)
            pendingTargets[player] = timeline.seekSnapshotValue(offset + 2)
        }
        while (timeline.seekNextInteraction()) {
            var command = timeline.lastSeekInteraction()
            var player = command.player()
            if (!playerFocused(player) || worldInteractions.kind(command.targetId()) == 0 ||
                command.sequence() < checkpointSequences[player] ||
                (command.sequence() == checkpointSequences[player] &&
                    (command.targetId() != pendingTargets[player] || command.tick() != pendingTicks[player])) ||
                (command.sequence() > checkpointSequences[player] && pendingTargets[player] != 0 &&
                    command.tick() <= pendingTicks[player]) ||
                !interactions.append(command.tick(), player, command.sequence(), command.targetId())) {
                return false
            }
            checkpointSequences[player] = command.sequence()
            pendingTargets[player] = 0
        }
        if (!applyReplayCheckpointBundle(timeline, targetTick)) {
            return false
        }
        playerOneInputs.resetForReplay()
        playerTwoInputs.resetForReplay()
        var nextPresentationSequence = 1
        for (var index = 0; index < replayPresentationHistory.count(); index = index + 1) {
            var event = replayPresentationHistory.at(index)
            if (event.kind() <= 2 && event.sequence() >= nextPresentationSequence) {
                nextPresentationSequence = event.sequence() + 1
            }
        }
        playerWeaponPresentations.resetForReplay(nextPresentationSequence)
        var hasMovement = movements.playNext()
        var movement = movements.lastPlayed()
        var interactionIndex = 0
        var interaction = interactions.at(interactionIndex)
        while (serverTick < targetTick) {
            var nextTick = serverTick + 1
            if (hasMovement && movement.tick() == nextTick) {
                if (!receiveInputCommand(movementPlayer, movement)) {
                    return false
                }
                hasMovement = movements.playNext()
                movement = movements.lastPlayed()
            }
            while (interactionIndex < interactions.count() && interaction.tick() == nextTick) {
                var player = interaction.player()
                // Recorded commands already passed live admission. Re-run their
                // gameplay checks even when an earlier command completed the level.
                interactionSequences[player] = interaction.sequence()
                interactionTicks[player] = nextTick
                interactionTargets[player] = interaction.targetId()
                interactionIndex = interactionIndex + 1
                interaction = interactions.at(interactionIndex)
            }
            if (advance(16667) != 1) {
                return false
            }
        }
        return true
    }

    Bool receiveInput(
        Int player, Int tick, Int sequence, Int moveX, Int moveY,
        Int lookX, Int lookY, Int fire, Int jump
    ) {
        if (!started || paused) {
            return false
        }
        var command = InputCommand(tick, sequence, moveX, moveY, lookX, lookY, fire, jump)
        return receiveInputCommand(player, command)
    }

    Bool receiveInputCommand(Int player, InputCommand command) {
        if (!started || paused) {
            return false
        }
        if (player == 1 && playerOneConnected && playerOneFocused) {
            return playerOneInputs.queue(command)
        }
        if (player == 2 && playerTwoConnected && playerTwoFocused) {
            return playerTwoInputs.queue(command)
        }
        return false
    }

    Int advance(Int elapsedMicros) {
        if (!started) {
            return -1
        }
        if (paused) {
            return 0
        }
        var steps = clock.advance(elapsedMicros)
        if (steps < 0) {
            return -1
        }
        for (var step = 0; step < steps; step = step + 1) {
            var simulationTick = clock.tick() - steps + step + 1
            if (playerOneConnected && playerOneInputs.queuedCount() > 0 &&
                playerOneInputs.nextTick() <= simulationTick) {
                playerOneInputs.dequeue()
                var commandOne = playerOneInputs.lastConsumed()
                playerOneEdges.apply(commandOne.fire(), commandOne.jump())
                if (inputReplayEnabled && !playerOneReplay.appendAtTick(commandOne, simulationTick)) {
                    return -1
                }
                if (!applyDoorAwareMovement(1, commandOne.moveX())) {
                    return -1
                }
                if (playerCombat.isAlive(1) &&
                    !stepPlayerWeaponPresentationCaptured(
                        1, simulationTick, playerOneEdges.lastEdges())) {
                    return -1
                }
            }
            if (playerTwoConnected && playerTwoInputs.queuedCount() > 0 &&
                playerTwoInputs.nextTick() <= simulationTick) {
                playerTwoInputs.dequeue()
                var commandTwo = playerTwoInputs.lastConsumed()
                if (inputReplayEnabled && !playerTwoReplay.appendAtTick(commandTwo, simulationTick)) {
                    return -1
                }
                playerTwoEdges.apply(commandTwo.fire(), commandTwo.jump())
                if (!applyDoorAwareMovement(2, commandTwo.moveX())) {
                    return -1
                }
                if (playerCombat.isAlive(2) &&
                    !stepPlayerWeaponPresentationCaptured(
                        2, simulationTick, playerTwoEdges.lastEdges())) {
                    return -1
                }
            }
            if (!consumeWorldInteractions(simulationTick)) {
                return -1
            }
            if (!advanceEnemyTick(simulationTick)) {
                return -1
            }
            if (!tickPlayerStatuses()) {
                return -1
            }
        }
        serverTick = clock.tick()
        if (steps > 0) {
            snapshotSequence = snapshotSequence + 1
            if (playerOneConnected) {
                var playerOnePosition = serverMovement.position(1)
                playerOneSnapshots.push(snapshotSequence, serverTick, playerOnePosition)
                playerOnePrediction.reconcile(playerOnePosition, serverTick)
                clientMovement.setPosition(1, playerOnePrediction.predicted())
            }
            if (playerTwoConnected) {
                var playerTwoPosition = serverMovement.position(2)
                playerTwoSnapshots.push(snapshotSequence, serverTick, playerTwoPosition)
                playerTwoPrediction.reconcile(playerTwoPosition, serverTick)
                clientMovement.setPosition(2, playerTwoPrediction.predicted())
            }
            clientTick = serverTick
            if (clientInteractionRevisionValue != worldInteractions.revision()) {
                publishWorldInteractions()
            }
            if (!publishEnemySnapshots(serverTick)) {
                return -1
            }
        }
        return steps
    }

    Bool applyDoorAwareMovement(Int player, Int requestedStep) {
        if (player != 1 && player != 2) {
            return false
        }
        var current = serverMovement.position(player)
        var movement = serverMovement.queryMovement(player, requestedStep)
        if (!movement.accepted()) {
            return false
        }
        if (worldInteractions.blocksScalarMove(current, movement.resolvedPosition())) {
            return true
        }
        if (!serverMovement.applyInput(player, requestedStep)) {
            return false
        }
        if (enemyCombat.hasSpatialPosition(player)) {
            return enemyCombat.setSpatialPosition(
                player, serverMovement.position(player),
                enemyCombat.enemySpatialPositionY(player),
                enemyCombat.enemySpatialPositionZ(player))
        }
        return true
    }
    Bool applySnapshot(Int sequence, Int tick, Int player, Int position) {
        if (!started || sequence <= snapshotSequence || tick < clientTick) {
            return false
        }
        if (player == 1 && playerOneConnected) {
            if (!playerOneSnapshots.push(sequence, tick, position) ||
                !playerOnePrediction.reconcile(position, tick)) {
                return false
            }
            if (!clientMovement.setPosition(1, playerOnePrediction.predicted())) {
                return false
            }
        } else if (player == 2 && playerTwoConnected) {
            if (!playerTwoSnapshots.push(sequence, tick, position) ||
                !playerTwoPrediction.reconcile(position, tick)) {
                return false
            }
            if (!clientMovement.setPosition(2, playerTwoPrediction.predicted())) {
                return false
            }
        } else {
            return false
        }
        snapshotSequence = sequence
        clientTick = tick
        return true
    }

    Int broadPhaseRevision() {
        return broadPhaseRevisionValue
    }

    Int clientBroadPhaseRevision() {
        return clientBroadPhaseRevisionValue
    }

    Bool configureBroadPhaseBounds(
        Int nextMinX, Int nextMinY, Int nextMinZ,
        Int nextMaxX, Int nextMaxY, Int nextMaxZ
    ) {
        if (!broadPhaseCollection.configureBounds(
            nextMinX, nextMinY, nextMinZ, nextMaxX, nextMaxY, nextMaxZ)) {
            return false
        }
        broadPhaseRevisionValue = broadPhaseCollection.geometryRevision()
        return true
    }
    Bool loadAuthoredBroadPhase(BoundedAuthoredCollision authored) {
        if (!broadPhaseCollection.replaceWithAuthored(authored)) {
            return false
        }
        broadPhaseRevisionValue = broadPhaseCollection.geometryRevision()
        return true
    }


    Bool addBroadPhaseTriangle(
        Int axValue, Int ayValue, Int azValue,
        Int bxValue, Int byValue, Int bzValue,
        Int cxValue, Int cyValue, Int czValue
    ) {
        if (!broadPhaseCollection.addTriangle(
            axValue, ayValue, azValue,
            bxValue, byValue, bzValue,
            cxValue, cyValue, czValue)) {
            return false
        }
        broadPhaseRevisionValue = broadPhaseCollection.geometryRevision()
        return true
    }

    Bool removeBroadPhaseTriangle(Int index) {
        if (!broadPhaseCollection.removeTriangle(index)) {
            return false
        }
        broadPhaseRevisionValue = broadPhaseCollection.geometryRevision()
        return true
    }

    Int broadPhaseTriangleCount() {
        return broadPhaseCollection.triangleCount()
    }
    Int broadPhaseTriangleCapacity() {
        return broadPhaseCollection.triangleCapacity()
    }

    Int[] broadPhaseSnapshot(Int tick, Int sequence) {
        return newBroadPhaseSnapshot(
            protocolVersion(), tick, sequence,
            broadPhaseRevisionValue, broadPhaseCollection)
    }
    Bool queueBroadPhaseSnapshot(Int tick, Int sequence) {
        return broadPhaseTransport.send(broadPhaseSnapshot(tick, sequence))
    }

    Bool configureRemoteEndpoint(
        Int firstOctet, Int secondOctet, Int thirdOctet, Int fourthOctet,
        Int port, Int key0Low, Int key0High, Int key1Low, Int key1High
    ) {
        if (remoteLink.connected() ||
            !remoteEndpoint.setKey(key0Low, key0High, key1Low, key1High) ||
            !remoteEndpoint.setPeer(
                firstOctet, secondOctet, thirdOctet, fourthOctet, port)) {
            return false
        }
        remoteConfigured = remoteEndpoint.valid()
        return remoteConfigured
    }

    Bool openRemoteSession() {
        if (!started || !remoteConfigured) {
            return false
        }
        if (!remoteLink.connect()) {
            return false
        }
        remoteSendSequenceValue = remoteLink.sentSequence()
        return true
    }

    Bool closeRemoteSession() {
        return remoteLink.disconnect()
    }

    Bool remoteSessionConnected() {
        return remoteLink.connected()
    }

    Bool queueRemoteBroadPhaseSnapshot(Int tick, Int sequence) {
        if (!started || !remoteLink.connected()) {
            return false
        }
        if (!remoteLink.sendSnapshot(broadPhaseSnapshot(tick, sequence))) {
            return false
        }
        remoteSendSequenceValue = sequence
        return true
    }

    Bool pumpRemoteBroadPhaseSnapshot(Int tick) {
        if (!started || !remoteLink.connected() ||
            tick <= remoteSendSequenceValue) {
            return false
        }
        return queueRemoteBroadPhaseSnapshot(tick, tick)
    }

    Int remoteSendSequence() {
        return remoteSendSequenceValue
    }

    Bool applyRemoteBroadPhaseSnapshot(Int[] words) {
        if (!started || !remoteLink.canReceiveSnapshot(words) ||
            !applyBroadPhaseSnapshot(words)) {
            return false
        }
        return remoteLink.receiveSnapshot(words)
    }

    Int pendingBroadPhaseSnapshots() {
        return broadPhaseTransport.pending()
    }

    Bool receiveBroadPhaseSnapshot() {
        var words = broadPhaseTransport.receive()
        if (words.length == 0) {
            return false
        }
        return applyBroadPhaseSnapshot(words)
    }


    Bool acceptsBroadPhaseSnapshot(Int[] words) {
        return broadPhaseSnapshotMatches(words, broadPhaseRevisionValue)
    }
    Bool applyBroadPhaseSnapshot(Int[] words) {
        if (!validBroadPhaseSnapshot(words) ||
            words[3] <= clientBroadPhaseSnapshotSequence ||
            words[5] > clientBroadPhaseCollection.triangleCapacity() ||
            !clientBroadPhaseCollection.configureBounds(
                words[6], words[7], words[8],
                words[9], words[10], words[11])) {
            return false
        }
        clientBroadPhaseCollection.clearTriangles()
        for (var ordinal = 0; ordinal < words[5]; ordinal = ordinal + 1) {
            var offset = 12 + ordinal * 9
            if (!clientBroadPhaseCollection.addTriangle(
                words[offset], words[offset + 1], words[offset + 2],
                words[offset + 3], words[offset + 4], words[offset + 5],
                words[offset + 6], words[offset + 7], words[offset + 8])) {
                return false
            }
        }
        clientBroadPhaseRevisionValue = words[4]
        clientBroadPhaseSnapshotSequence = words[3]
        return true
    }

    Int clientBroadPhaseTriangleCount() {
        return clientBroadPhaseCollection.triangleCount()
    }

    SegmentCollisionResult queryClientBroadPhase(
        Int geometryRevision,
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ
    ) {
        if (geometryRevision != clientBroadPhaseRevisionValue) {
            return rejectedBroadPhaseQuery(
                startX, startY, startZ, endX, endY, endZ)
        }
        return clientBroadPhaseCollection.query(
            startX, startY, startZ, endX, endY, endZ)
    }
    SegmentCollisionResult queryClientBroadPhasePath(
        Int geometryRevision, SpatialPoint start, SpatialPoint end
    ) {
        if (geometryRevision != clientBroadPhaseRevisionValue) {
            return rejectedBroadPhaseQuery(
                start.x(), start.y(), start.z(),
                end.x(), end.y(), end.z())
        }
        return clientBroadPhaseCollection.query(
            start.x(), start.y(), start.z(),
            end.x(), end.y(), end.z())
    }




    SegmentCollisionResult rejectedBroadPhaseQuery(
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ
    ) {
        return SegmentCollisionResult(
            false, false, -1,
            startX, startY, startZ, endX, endY, endZ,
            startX, startY, startZ)
    }

    SegmentCollisionResult queryBroadPhase(
        Int geometryRevision,
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ
    ) {
        if (geometryRevision != broadPhaseRevisionValue) {
            return rejectedBroadPhaseQuery(
                startX, startY, startZ, endX, endY, endZ)
        }
        return broadPhaseCollection.query(
            startX, startY, startZ, endX, endY, endZ)
    }

    Bool applyQuerySnapshot(
        Int sequence, Int tick, Int geometryRevision,
        Int player, Int position
    ) {
        if (geometryRevision != broadPhaseRevisionValue) {
            return false
        }
        if (!applySnapshot(sequence, tick, player, position)) {
            return false
        }
        clientBroadPhaseRevisionValue = geometryRevision
        return true
    }

    Bool predictClientInput(Int player, Int requestedStep) {
        if (!started) {
            return false
        }
        if (player == 1 && playerOneConnected) {
            if (!playerOnePrediction.predict(requestedStep)) {
                return false
            }
            return clientMovement.setPosition(1, playerOnePrediction.predicted())
        }
        if (player == 2 && playerTwoConnected) {
            if (!playerTwoPrediction.predict(requestedStep)) {
                return false
            }
            return clientMovement.setPosition(2, playerTwoPrediction.predicted())
        }
        return false
    }

    Int predictedPosition(Int player) {
        if (player == 1) {
            return playerOnePrediction.predicted()
        }
        return playerTwoPrediction.predicted()
    }
    Int authoritativePosition(Int player) {
        if (player == 1) {
            return playerOnePrediction.authoritative()
        }
        return playerTwoPrediction.authoritative()
    }

    Int predictionCorrection(Int player) {
        if (player == 1) {
            return playerOnePrediction.correction()
        }
        return playerTwoPrediction.correction()
    }

    Int pendingPredictionInputs(Int player) {
        if (player == 1) {
            return playerOnePrediction.pendingInputs()
        }
        return playerTwoPrediction.pendingInputs()
    }

    Bool playerConnected(Int player) {
        if (player == 1) {
            return playerOneConnected
        }
        if (player == 2) {
            return playerTwoConnected
        }
        return false
    }


    InterpolatedPosition interpolatedPosition(Int player, Int renderTick) {
        if (player == 1) {
            return playerOneSnapshots.interpolate(renderTick)
        }
        return playerTwoSnapshots.interpolate(renderTick)
    }

    Int snapshotCount(Int player) {
        if (player == 1) {
            return playerOneSnapshots.size()
        }
        return playerTwoSnapshots.size()
    }


    Int playerCount() {
        var count = 0
        if (playerOneConnected) {
            count = count + 1
        }
        if (playerTwoConnected) {
            count = count + 1
        }
        return count
    }

    Int serverPosition(Int player) {
        return serverMovement.position(player)
    }

    Int clientPosition(Int player) {
        return clientMovement.position(player)
    }

    Int currentServerTick() {
        return serverTick
    }

    Int currentClientTick() {
        return clientTick
    }

    Int latestSnapshotSequence() {
        return snapshotSequence
    }

    Bool inSync() {
        var synced = serverTick == clientTick
        if (playerOneConnected) {
            synced = synced && serverPosition(1) == clientPosition(1)
        }
        if (playerTwoConnected) {
            synced = synced && serverPosition(2) == clientPosition(2)
        }
        return synced
    }

    InputEdges lastInputEdges(Int player) {
        if (player == 1) {
            return playerOneEdges.lastEdges()
        }
        return playerTwoEdges.lastEdges()
    }
}
