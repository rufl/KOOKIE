    Bool encodePlayerProgression(Int player, BoundedSaveSections target) {
        if (player == 1 && playerOneConnected) {
            return playerOneSkills.encodeInto(target) &&
                playerOneStatuses.encodeInto(target)
        }
        if (player == 2 && playerTwoConnected) {
            return playerTwoSkills.encodeInto(target) &&
                playerTwoStatuses.encodeInto(target)
        }
        return false
    }

    Bool decodePlayerProgression(Int player, BoundedSaveSections source) {
        var decodedSkills = BoundedSkillProgression(4)
        var decodedStatuses = BoundedStatusEffects(4)
        if (!decodedSkills.decodeFrom(source, playerSkillDefinitions) ||
            !decodedStatuses.decodeFrom(source, playerStatusDefinitions)) {
            return false
        }
        if (player == 1 && playerOneConnected) {
            playerOneSkills = decodedSkills
            playerOneStatuses = decodedStatuses
            return true
        }
        if (player == 2 && playerTwoConnected) {
            playerTwoSkills = decodedSkills
            playerTwoStatuses = decodedStatuses
            return true
        }
        return false
    }
    Bool encodePlayerAuthority(Int player, BoundedSaveSections target) {
        if (player == 1 && playerOneConnected) {
            return playerOneInventory.encodeInto(target) &&
                playerOneEquipment.encodeInto(target) &&
                playerOneSkills.encodeInto(target) &&
                playerOneStatuses.encodeInto(target)
        }
        if (player == 2 && playerTwoConnected) {
            return playerTwoInventory.encodeInto(target) &&
                playerTwoEquipment.encodeInto(target) &&
                playerTwoSkills.encodeInto(target) &&
                playerTwoStatuses.encodeInto(target)
        }
        return false
    }

    Bool decodePlayerAuthority(
        Int player, BoundedSaveSections source
    ) {
        if (!playerConnected(player)) {
            return false
        }
        var decodedInventory = BoundedItemInventory(player, 8)
        var decodedEquipment = BoundedEquipmentLoadout(4)
        var decodedSkills = BoundedSkillProgression(4)
        var decodedStatuses = BoundedStatusEffects(4)
        if (!decodedInventory.decodeFrom(source) ||
            !decodedEquipment.decodeFrom(source, decodedInventory) ||
            !decodedSkills.decodeFrom(source, playerSkillDefinitions) ||
            !decodedStatuses.decodeFrom(source, playerStatusDefinitions)) {
            return false
        }
        var previousInventory = playerOneInventory
        var previousEquipment = playerOneEquipment
        var previousSkills = playerOneSkills
        var previousStatuses = playerOneStatuses
        if (player == 2) {
            previousInventory = playerTwoInventory
            previousEquipment = playerTwoEquipment
            previousSkills = playerTwoSkills
            previousStatuses = playerTwoStatuses
            playerTwoInventory = decodedInventory
            playerTwoEquipment = decodedEquipment
            playerTwoSkills = decodedSkills
            playerTwoStatuses = decodedStatuses
        } else {
            playerOneInventory = decodedInventory
            playerOneEquipment = decodedEquipment
            playerOneSkills = decodedSkills
            playerOneStatuses = decodedStatuses
        }
        var previousBonus = playerEquipmentDamageBonuses[player]
        var decodedBonus = computePlayerEquipmentDamageBonus(player)
        if (decodedBonus >= 0) {
            playerEquipmentDamageBonuses[player] = decodedBonus
            if (refreshPlayerCombatModifiers(player)) {
                return true
            }
        }
        if (player == 2) {
            playerTwoInventory = previousInventory
            playerTwoEquipment = previousEquipment
            playerTwoSkills = previousSkills
            playerTwoStatuses = previousStatuses
        } else {
            playerOneInventory = previousInventory
            playerOneEquipment = previousEquipment
            playerOneSkills = previousSkills
            playerOneStatuses = previousStatuses
        }
        playerEquipmentDamageBonuses[player] = previousBonus
        refreshPlayerCombatModifiers(player)
        return false
    }

    Bool sameLootRoll(BoundedItemRoll first, BoundedItemRoll second) {
        return first.accepted() && second.accepted() &&
            first.stableId() == second.stableId() &&
            first.definitionId() == second.definitionId() &&
            first.seed() == second.seed() &&
            first.level() == second.level() &&
            first.rarity() == second.rarity() &&
            first.affixOne() == second.affixOne() &&
            first.affixTwo() == second.affixTwo() &&
            first.condition() == second.condition()
    }

    Bool encodeAuthorityRuntime(
        Int player, BoundedSaveSections target
    ) {
        if (!playerConnected(player)) {
            return false
        }
        var combatClaims = 0
        for (var combat = 0;
            combat < playerCombatRewardCount;
            combat = combat + 1) {
            if (playerCombatRewardClaimed[combat]) {
                combatClaims = combatClaims + 1
            }
        }
        var lootClaims = 0
        for (var enemy = 0; enemy < enemyCount; enemy = enemy + 1) {
            if (enemyLootClaimed[enemy]) {
                lootClaims = lootClaims + 1
            }
        }
        var payloadLength = 6 + worldLoot.count() * 16 +
            combatClaims + lootClaims
        if (payloadLength > 160) {
            return false
        }
        var payload = new Int[payloadLength]
        payload[0] = worldLoot.revision()
        payload[1] = worldLoot.count()
        payload[2] = combatClaims
        payload[3] = lootClaims
        payload[4] = player
        if (player == 1) {
            payload[5] = playerOneInventory.revision()
        } else {
            payload[5] = playerTwoInventory.revision()
        }
        var offset = 6
        for (var drop = 0; drop < worldLoot.count(); drop = drop + 1) {
            var x = worldLoot.positionX(drop)
            var y = worldLoot.positionY(drop)
            var z = worldLoot.positionZ(drop)
            var xSign = 0
            var ySign = 0
            var zSign = 0
            if (x < 0) {
                xSign = 1
                x = -x
            }
            if (y < 0) {
                ySign = 1
                y = -y
            }
            if (z < 0) {
                zSign = 1
                z = -z
            }
            var roll = worldLoot.rollAt(drop)
            payload[offset] = worldLoot.stableId(drop)
            payload[offset + 1] = worldLoot.sourceId(drop)
            payload[offset + 2] = worldLoot.rank(drop)
            payload[offset + 3] = xSign
            payload[offset + 4] = x
            payload[offset + 5] = ySign
            payload[offset + 6] = y
            payload[offset + 7] = zSign
            payload[offset + 8] = z
            payload[offset + 9] = roll.definitionId()
            payload[offset + 10] = roll.seed()
            payload[offset + 11] = roll.level()
            payload[offset + 12] = roll.rarity()
            payload[offset + 13] = roll.affixOne()
            payload[offset + 14] = roll.affixTwo()
            payload[offset + 15] = roll.condition()
            offset = offset + 16
        }
        for (var reward = 0;
            reward < playerCombatRewardCount;
            reward = reward + 1) {
            if (playerCombatRewardClaimed[reward]) {
                payload[offset] = playerCombatRewardTargets[reward]
                offset = offset + 1
            }
        }
        for (var loot = 0; loot < enemyCount; loot = loot + 1) {
            if (enemyLootClaimed[loot]) {
                payload[offset] = enemyIds[loot]
                offset = offset + 1
            }
        }
        return offset == payload.length && target.put(12, 1, payload)
    }

    Bool encodeG3Authority(
        Int player, BoundedSaveSections target
    ) {
        return encodePlayerAuthority(player, target) &&
            encodeAuthorityRuntime(player, target)
    }

    Bool decodeAuthorityRuntime(
        Int player, BoundedSaveSections source
    ) {
        var section = source.find(12)
        if (!playerConnected(player) || section < 0 ||
            source.sectionVersion(section) != 1 ||
            source.sectionLength(section) < 6) {
            return false
        }
        var savedWorldRevision = source.sectionValue(section, 0)
        var dropCount = source.sectionValue(section, 1)
        var combatClaims = source.sectionValue(section, 2)
        var lootClaims = source.sectionValue(section, 3)
        var savedPlayer = source.sectionValue(section, 4)
        var savedInventoryRevision = source.sectionValue(section, 5)
        if (dropCount < 0 || dropCount > 8 ||
            combatClaims < 0 || combatClaims > 16 ||
            lootClaims < 0 || lootClaims > 8 ||
            savedPlayer != player ||
            savedInventoryRevision < 0 ||
            savedInventoryRevision > 1000000 ||
            savedWorldRevision < dropCount ||
            savedWorldRevision > 1000000 ||
            source.sectionLength(section) !=
                6 + dropCount * 16 + combatClaims + lootClaims) {
            return false
        }
        var decodedWorld = BoundedWorldLoot(8)
        var offset = 6
        for (var drop = 0; drop < dropCount; drop = drop + 1) {
            var xSign = source.sectionValue(section, offset + 3)
            var ySign = source.sectionValue(section, offset + 5)
            var zSign = source.sectionValue(section, offset + 7)
            var x = source.sectionValue(section, offset + 4)
            var y = source.sectionValue(section, offset + 6)
            var z = source.sectionValue(section, offset + 8)
            if (xSign < 0 || xSign > 1 ||
                ySign < 0 || ySign > 1 ||
                zSign < 0 || zSign > 1 ||
                (xSign == 1 && x == 0) ||
                (ySign == 1 && y == 0) ||
                (zSign == 1 && z == 0)) {
                return false
            }
            if (xSign == 1) {
                x = -x
            }
            if (ySign == 1) {
                y = -y
            }
            if (zSign == 1) {
                z = -z
            }
            var roll = BoundedItemRoll()
            if (!roll.stage(
                    source.sectionValue(section, offset),
                    source.sectionValue(section, offset + 9),
                    source.sectionValue(section, offset + 10),
                    source.sectionValue(section, offset + 11),
                    source.sectionValue(section, offset + 12),
                    source.sectionValue(section, offset + 13),
                    source.sectionValue(section, offset + 14),
                    source.sectionValue(section, offset + 15)) ||
                !decodedWorld.stage(
                    roll, source.sectionValue(section, offset + 1),
                    source.sectionValue(section, offset + 2),
                    SpatialPoint(x, y, z))) {
                return false
            }
            offset = offset + 16
        }
        var decodedCombatClaims =
            new Bool[playerCombatRewardClaimed.length]
        for (var clearCombat = 0;
            clearCombat < decodedCombatClaims.length;
            clearCombat = clearCombat + 1) {
            decodedCombatClaims[clearCombat] = false
        }
        for (var combat = 0; combat < combatClaims; combat = combat + 1) {
            var combatSlot = combatRewardSlot(
                source.sectionValue(section, offset))
            if (combatSlot < 0 || decodedCombatClaims[combatSlot]) {
                return false
            }
            decodedCombatClaims[combatSlot] = true
            offset = offset + 1
        }
        var decodedLootClaims = new Bool[enemyLootClaimed.length]
        for (var clearLoot = 0;
            clearLoot < decodedLootClaims.length;
            clearLoot = clearLoot + 1) {
            decodedLootClaims[clearLoot] = false
        }
        for (var loot = 0; loot < lootClaims; loot = loot + 1) {
            var lootSlot = enemySlot(source.sectionValue(section, offset))
            if (lootSlot < 0 || enemyLootStableIds[lootSlot] <= 0 ||
                decodedLootClaims[lootSlot]) {
                return false
            }
            decodedLootClaims[lootSlot] = true
            offset = offset + 1
        }
        if (offset != source.sectionLength(section) ||
            !decodedWorld.restoreRevision(savedWorldRevision)) {
            return false
        }
        for (var verify = 0;
            verify < decodedWorld.count();
            verify = verify + 1) {
            var sourceId = decodedWorld.sourceId(verify)
            var sourceSlot = enemySlot(sourceId)
            if (sourceSlot < 0 || !decodedLootClaims[sourceSlot] ||
                enemyLootStableIds[sourceSlot] !=
                    decodedWorld.stableId(verify) ||
                enemyLootRanks[sourceSlot] != decodedWorld.rank(verify) ||
                !sameLootRoll(
                    configuredEnemyLootRoll(sourceId),
                    decodedWorld.rollAt(verify))) {
                return false
            }
        }
        var revisionRestored = false
        if (player == 1) {
            revisionRestored = playerOneInventory.restoreRevision(
                savedInventoryRevision)
        } else {
            revisionRestored = playerTwoInventory.restoreRevision(
                savedInventoryRevision)
        }
        if (!revisionRestored) {
            return false
        }
        worldLoot = decodedWorld
        for (var copyCombat = 0;
            copyCombat < playerCombatRewardClaimed.length;
            copyCombat = copyCombat + 1) {
            playerCombatRewardClaimed[copyCombat] =
                decodedCombatClaims[copyCombat]
        }
        for (var copyLoot = 0;
            copyLoot < enemyLootClaimed.length;
            copyLoot = copyLoot + 1) {
            enemyLootClaimed[copyLoot] = decodedLootClaims[copyLoot]
        }
        return true
    }

    Bool decodeG3Authority(
        Int player, BoundedSaveSections source
    ) {
        if (!playerConnected(player)) {
            return false
        }
        var previousInventory = playerOneInventory
        var previousEquipment = playerOneEquipment
        var previousSkills = playerOneSkills
        var previousStatuses = playerOneStatuses
        if (player == 2) {
            previousInventory = playerTwoInventory
            previousEquipment = playerTwoEquipment
            previousSkills = playerTwoSkills
            previousStatuses = playerTwoStatuses
        }
        var previousBonus = playerEquipmentDamageBonuses[player]
        if (decodePlayerAuthority(player, source) &&
            decodeAuthorityRuntime(player, source)) {
            return true
        }
        if (player == 2) {
            playerTwoInventory = previousInventory
            playerTwoEquipment = previousEquipment
            playerTwoSkills = previousSkills
            playerTwoStatuses = previousStatuses
        } else {
            playerOneInventory = previousInventory
            playerOneEquipment = previousEquipment
            playerOneSkills = previousSkills
            playerOneStatuses = previousStatuses
        }
        playerEquipmentDamageBonuses[player] = previousBonus
        refreshPlayerCombatModifiers(player)
        return false
    }

    Int computePlayerEquipmentDamageBonus(Int player) {
        var inventory = playerOneInventory
        var equipment = playerOneEquipment
        if (player == 2) {
            inventory = playerTwoInventory
            equipment = playerTwoEquipment
        } else if (player != 1) {
            return -1
        }
        var total = 0
        for (var slot = 0; slot < equipment.slotCount(); slot = slot + 1) {
            var itemId = equipment.itemAt(slot)
            if (itemId != 0) {
                var itemIndex = -1
                for (var index = 0;
                    index < inventory.itemCount();
                    index = index + 1) {
                    if (inventory.itemId(index) == itemId) {
                        itemIndex = index
                        break
                    }
                }
                if (itemIndex < 0) {
                    return -1
                }
                var roll = inventory.itemRoll(itemIndex)
                if (roll.accepted()) {
                    var stats = BoundedItemStatResult()
                    if (!lootStatComposer.compose(
                            roll, lootItemDefinitions,
                            lootAffixStats, stats) ||
                        total > 1000000 - stats.finalAmount()) {
                        return -1
                    }
                    total = total + stats.finalAmount()
                }
            }
        }
        return total
    }

    Int playerEquipmentDamageBonus(Int player) {
        if (player < 1 || player > 2) {
            return -1
        }
        return playerEquipmentDamageBonuses[player]
    }


    Bool refreshPlayerCombatModifiers(Int player) {
        var skillPercent = 0
        var statusFlat = 0
        var statusPercent = 0
        var defenseFlat = 0
        var defensePercent = 0
        if (player == 1 && playerOneConnected) {
            skillPercent = playerOneSkills.totalDamagePercent(
                playerSkillDefinitions)
            statusFlat = playerOneStatuses.totalDamageFlat(
                playerStatusDefinitions)
            statusPercent = playerOneStatuses.totalDamagePercent(
                playerStatusDefinitions)
            defenseFlat = playerOneStatuses.totalDefenseFlat(
                playerStatusDefinitions)
            defensePercent = playerOneStatuses.totalDefensePercent(
                playerStatusDefinitions)
        } else if (player == 2 && playerTwoConnected) {
            skillPercent = playerTwoSkills.totalDamagePercent(
                playerSkillDefinitions)
            statusFlat = playerTwoStatuses.totalDamageFlat(
                playerStatusDefinitions)
            statusPercent = playerTwoStatuses.totalDamagePercent(
                playerStatusDefinitions)
            defenseFlat = playerTwoStatuses.totalDefenseFlat(
                playerStatusDefinitions)
            defensePercent = playerTwoStatuses.totalDefensePercent(
                playerStatusDefinitions)
        } else {
            return false
        }
        statusFlat = statusFlat + playerEquipmentDamageBonuses[player]
        if (skillPercent < 0 || statusFlat < 0 || statusFlat > 1000000 ||
            statusPercent < 0 || defenseFlat < 0 || defensePercent < 0 ||
            skillPercent > 1000000 - statusPercent) {
            return false
        }
        if (playerCombat.isAlive(player) &&
            (!playerCombat.setDamageModifier(
                player, statusFlat, skillPercent + statusPercent) ||
             !playerCombat.setDefenseModifier(
                player, defenseFlat, defensePercent))) {
            return false
        }
        if (enemyCombat.currentHealth(player) > 0 &&
            (!enemyCombat.setDamageModifier(
                player, statusFlat, skillPercent + statusPercent) ||
             !enemyCombat.setDefenseModifier(
                player, defenseFlat, defensePercent))) {
            return false
        }
        return true
    }

    Bool applyPeriodicStatusDamage(
        Int player, BoundedStatusEffects effects
    ) {
        if (!playerCombat.isAlive(player)) {
            return true
        }
        for (var index = 0; index < effects.count(); index = index + 1) {
            var damage = effects.periodicDamageAt(
                index, playerStatusDefinitions)
            var channel = effects.periodicChannelAt(
                index, playerStatusDefinitions)
            if (damage < 0 || channel < 0) {
                return false
            }
            if (damage > 0) {
                var result = playerCombat.applyDamage(
                    DamageRequest(0, player, damage, channel, 0))
                if (!result.accepted()) {
                    return false
                }
            }
        }
        return true

    }

    Bool tickPlayerStatuses() {
        if (playerOneConnected &&
            !applyPeriodicStatusDamage(1, playerOneStatuses)) {
            return false
        }
        if (playerTwoConnected &&
            !applyPeriodicStatusDamage(2, playerTwoStatuses)) {
            return false
        }
        if (!playerOneStatuses.tick(1) || !playerTwoStatuses.tick(1)) {
            return false
        }
        if (playerOneConnected && !refreshPlayerCombatModifiers(1)) {
            return false
        }
        if (playerTwoConnected && !refreshPlayerCombatModifiers(2)) {
            return false
        }
        return true
    }



