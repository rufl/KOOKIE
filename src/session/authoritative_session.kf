    AreaDamageResult resolvePlayerSpatialShotgun(
        Int sourceId,
        Int startX, Int startY, Int startZ,
        Int aimEndX, Int aimEndY, Int aimEndZ,
        Int range, Int radius, Int tick, Int critical
    ) {
        var pelletCount = playerCombat.shotgunPelletCount(sourceId)
        if (pelletCount <= 0) {
            return AreaDamageResult(false, 0, 0, 0)
        }
        var selectedTargets = new Int[pelletCount]
        var aim = SpatialAimContract(
            sourceId, startX, startY, startZ,
            aimEndX, aimEndY, aimEndZ, range, radius)
        for (var pellet = 0; pellet < pelletCount; pellet = pellet + 1) {
            var offset = playerCombat.shotgunPelletOffsetForSource(
                sourceId, pellet)
            if (!offset.valid()) {
                return AreaDamageResult(false, 0, 0, 0)
            }
            var target = playerSpatialTargets.queryShotgunPelletAim(
                aim, offset.x(), offset.y())
            selectedTargets[pellet] = 0
            if (target.hit()) {
                selectedTargets[pellet] = target.targetId()
            }
        }
        return playerCombat.resolveShotgunPelletTargets(
            sourceId, selectedTargets, tick, range, critical)
    }



