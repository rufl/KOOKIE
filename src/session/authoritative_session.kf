    Bool consumeWorldInteractions(Int tick) {
        for (var player = 1; player <= 2; player = player + 1) {
            if (interactionTargets[player] != 0 && interactionTicks[player] <= tick) {
                if (inputReplayEnabled && !interactionReplay.append(
                    tick, player, interactionSequences[player], interactionTargets[player])) {
                    return false
                }
                interactionResultTargets[player] = interactionTargets[player]
                interactionResultTicks[player] = tick
                interactionResults[player] = worldInteractions.interact(
                    interactionTargets[player], serverMovement.position(player), 0, 0)
                interactionTargets[player] = 0
                interactionTicks[player] = 0
            }
        }
        return true
    }

    Bool publishWorldInteractions() {
        for (var index = 0; index < clientInteractionFlags.length; index = index + 1) {
            clientInteractionFlags[index] = worldInteractions.activated(worldInteractions.idAt(index))
        }
        clientInteractionRevisionValue = worldInteractions.revision()
        clientSecretCountValue = worldInteractions.secretCount()
        clientLevelCompletedValue = worldInteractions.completed()
        return true
    }

