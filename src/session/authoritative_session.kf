    Bool definePlayerStatus(Int statusId, Int durationCap, Int stackCap) {
        return playerStatusDefinitions.define(
            statusId, durationCap, stackCap)
    }

    Bool applyPlayerStatus(
        Int player, Int statusId, Int duration, Int stacks
    ) {
        var accepted = false
        if (player == 1 && playerOneConnected) {
            accepted = playerOneStatuses.apply(
                statusId, duration, stacks, playerStatusDefinitions)
        } else if (player == 2 && playerTwoConnected) {
            accepted = playerTwoStatuses.apply(
                statusId, duration, stacks, playerStatusDefinitions)
        }
        if (!accepted) {
            return false
        }
        return refreshPlayerCombatModifiers(player)
    }

    Int playerStatusDuration(Int player, Int statusId) {
        if (player == 1 && playerOneConnected) {
            return playerOneStatuses.duration(statusId)
        }
        if (player == 2 && playerTwoConnected) {
            return playerTwoStatuses.duration(statusId)
        }
        return -1
    }

    Int playerStatusStacks(Int player, Int statusId) {
        if (player == 1 && playerOneConnected) {
            return playerOneStatuses.stacks(statusId)
        }
        if (player == 2 && playerTwoConnected) {
            return playerTwoStatuses.stacks(statusId)
        }
        return -1
    }

    Bool encodePlayerProgression(Int player, BoundedSaveSections target) {
        if (player == 1 && playerOneConnected) {
            return playerOneSkills.encodeInto(target) &&
                playerOneStatuses.encodeInto(target)
        }
        if (player == 2 && playerTwoConnected) {
            return playerTwoSkills.encodeInto(target) &&
                playerTwoStatuses.encodeInto(target)
        }
        return false
    }

    Bool decodePlayerProgression(Int player, BoundedSaveSections source) {
        var decodedSkills = BoundedSkillProgression(4)
        var decodedStatuses = BoundedStatusEffects(4)
        if (!decodedSkills.decodeFrom(source, playerSkillDefinitions) ||
            !decodedStatuses.decodeFrom(source, playerStatusDefinitions)) {
            return false
        }
        if (player == 1 && playerOneConnected) {
            playerOneSkills = decodedSkills
            playerOneStatuses = decodedStatuses
            return true
        }
        if (player == 2 && playerTwoConnected) {
            playerTwoSkills = decodedSkills
            playerTwoStatuses = decodedStatuses
            return true
        }
        return false
    }

    Bool refreshPlayerCombatModifiers(Int player) {
        var skillPercent = 0
        var statusFlat = 0
        var statusPercent = 0
        var defenseFlat = 0
        var defensePercent = 0
        if (player == 1 && playerOneConnected) {
            skillPercent = playerOneSkills.totalDamagePercent(
                playerSkillDefinitions)
            statusFlat = playerOneStatuses.totalDamageFlat(
                playerStatusDefinitions)
            statusPercent = playerOneStatuses.totalDamagePercent(
                playerStatusDefinitions)
            defenseFlat = playerOneStatuses.totalDefenseFlat(
                playerStatusDefinitions)
            defensePercent = playerOneStatuses.totalDefensePercent(
                playerStatusDefinitions)
        } else if (player == 2 && playerTwoConnected) {
            skillPercent = playerTwoSkills.totalDamagePercent(
                playerSkillDefinitions)
            statusFlat = playerTwoStatuses.totalDamageFlat(
                playerStatusDefinitions)
            statusPercent = playerTwoStatuses.totalDamagePercent(
                playerStatusDefinitions)
            defenseFlat = playerTwoStatuses.totalDefenseFlat(
                playerStatusDefinitions)
            defensePercent = playerTwoStatuses.totalDefensePercent(
                playerStatusDefinitions)
        } else {
            return false
        }
        if (skillPercent < 0 || statusFlat < 0 || statusPercent < 0 ||
            defenseFlat < 0 || defensePercent < 0 ||
            skillPercent > 1000000 - statusPercent) {
            return false
        }
        if (!playerCombat.isAlive(player)) {
            return true
        }
        return playerCombat.setDamageModifier(
                player, statusFlat, skillPercent + statusPercent) &&
            playerCombat.setDefenseModifier(
                player, defenseFlat, defensePercent)

    }

    Bool tickPlayerStatuses() {
        if (!playerOneStatuses.tick(1) || !playerTwoStatuses.tick(1)) {
            return false
        }
        if (playerOneConnected && !refreshPlayerCombatModifiers(1)) {
            return false
        }
        if (playerTwoConnected && !refreshPlayerCombatModifiers(2)) {
            return false
        }
        return true
    }



