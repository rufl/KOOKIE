package session

import core

class LoopbackSession {
    FixedStepClock clock
    InputCommandBuffer playerOneInputs
    InputCommandBuffer playerTwoInputs
    InputEdgeState playerOneEdges
    InputEdgeState playerTwoEdges
    MovementComponent serverMovement
    MovementComponent clientMovement
    Bool playerOneConnected
    Bool playerTwoConnected
    Int serverTick
    Int clientTick
    Int snapshotSequence
    Bool started
    ClientPredictionState playerOnePrediction
    ClientPredictionState playerTwoPrediction
    SnapshotHistory playerOneSnapshots
    SnapshotHistory playerTwoSnapshots
    BoundedTriangleCollection broadPhaseCollection
    BoundedTriangleCollection clientBroadPhaseCollection
    Int clientBroadPhaseSnapshotSequence
    BroadPhaseTransportQueue broadPhaseTransport
    Int broadPhaseRevisionValue
    Int clientBroadPhaseRevisionValue
    RemoteSessionEndpoint remoteEndpoint
    RemoteSessionLink remoteLink
    Bool remoteConfigured
    Int remoteSendSequenceValue
    AuthoritativeEnemySession enemyCombat
    EnemySnapshotHistory enemyServerSnapshots
    EnemySnapshotHistory enemyClientSnapshots
    EnemyImpactSnapshotHistory enemyServerImpactSnapshots
    EnemyImpactSnapshotHistory enemyClientImpactSnapshots
    ImpactPresentationQueue enemyImpactPresentations
    QueuedAudio enemyImpactAudio
    Int enemyImpactSnapshotSequence
    Int clientEnemyImpactSnapshotSequence
    Int[] enemyIds
    Int[] enemyPerceptionTargets
    Int[] enemyPerceptionDistances
    Int[] enemyPerceptionCriticals
    Bool[] enemyPerceptionVisible
    Bool[] enemyPerceptionActive
    Bool[] enemySpatialPerceptionActive
    Int enemyCount
    Int enemySnapshotSequence
    Int clientEnemySnapshotSequence
    EnemyAttackDecision lastEnemyDecision


    public constructor(Int inputCapacity, Int entityCapacity) {
        clock = FixedStepClock(60, 4)
        playerOneInputs = InputCommandBuffer(inputCapacity)
        playerTwoInputs = InputCommandBuffer(inputCapacity)
        playerOneEdges = InputEdgeState()
        playerTwoEdges = InputEdgeState()
        serverMovement = MovementComponent(entityCapacity, 4)
        clientMovement = MovementComponent(entityCapacity, 4)
        playerOneConnected = false
        playerTwoConnected = false
        serverTick = 0
        clientTick = 0
        snapshotSequence = 0
        started = false
        playerOnePrediction = ClientPredictionState(4)
        playerTwoPrediction = ClientPredictionState(4)
        playerOneSnapshots = SnapshotHistory(8)
        playerTwoSnapshots = SnapshotHistory(8)
        broadPhaseCollection = BoundedTriangleCollection(8, 20)
        broadPhaseCollection.configureBounds(0, 0, 0, 10, 10, 10)
        enemyCombat = AuthoritativeEnemySession(entityCapacity, entityCapacity)
        enemyServerSnapshots = EnemySnapshotHistory(entityCapacity * 8)
        enemyClientSnapshots = EnemySnapshotHistory(entityCapacity * 8)
        enemyServerImpactSnapshots = EnemyImpactSnapshotHistory(entityCapacity * 8)
        enemyClientImpactSnapshots = EnemyImpactSnapshotHistory(entityCapacity * 8)
        enemyImpactPresentations = ImpactPresentationQueue(entityCapacity * 2)
        enemyImpactAudio = QueuedAudio(entityCapacity * 2)
        enemyImpactAudio.open()
        enemyImpactSnapshotSequence = 0
        clientEnemyImpactSnapshotSequence = 0
        enemyIds = new Int[entityCapacity]
        enemyPerceptionTargets = new Int[entityCapacity]
        enemyPerceptionDistances = new Int[entityCapacity]
        enemyPerceptionCriticals = new Int[entityCapacity]
        enemyPerceptionVisible = new Bool[entityCapacity]
        enemyPerceptionActive = new Bool[entityCapacity]
        enemySpatialPerceptionActive = new Bool[entityCapacity]
        enemyCount = 0
        enemySnapshotSequence = 0
        clientEnemySnapshotSequence = 0
        lastEnemyDecision = EnemyAttackDecision(
            false, 0, 0, 0, false, 0, 0, false)
        for (var index = 0; index < entityCapacity; index = index + 1) {
            enemyIds[index] = 0
            enemyPerceptionTargets[index] = 0
            enemyPerceptionDistances[index] = 0
            enemyPerceptionCriticals[index] = 0
            enemyPerceptionVisible[index] = false
            enemyPerceptionActive[index] = false
            enemySpatialPerceptionActive[index] = false
        }
        clientBroadPhaseCollection = BoundedTriangleCollection(8, 20)
        clientBroadPhaseCollection.configureBounds(0, 0, 0, 10, 10, 10)
        broadPhaseTransport = BroadPhaseTransportQueue(4, 8)
        remoteEndpoint = RemoteSessionEndpoint(
            127, 0, 0, 1, 1, 1, 2, 3, 4)
        remoteLink = RemoteSessionLink(remoteEndpoint)
        remoteConfigured = false
        remoteSendSequenceValue = 0
        clientBroadPhaseSnapshotSequence = 0
        broadPhaseRevisionValue = broadPhaseCollection.geometryRevision()
        clientBroadPhaseRevisionValue = broadPhaseRevisionValue
    }

    Bool start() {
        if (started) {
            return false
        }
        started = true
        return true
    }

    Int connectPlayer() {
        if (!started) {
            return 0
        }
        if (!playerOneConnected) {
            playerOneConnected = serverMovement.add(1, 0) && clientMovement.add(1, 0)
            if (playerOneConnected) {
                return 1
            }
            return 0
        }
        if (!playerTwoConnected) {
            playerTwoConnected = serverMovement.add(2, 0) && clientMovement.add(2, 0)
            if (playerTwoConnected) {
                return 2
            }
        }
        return 0
    }

    Bool configureEnemyRules(Int perceptionRange, Int attackRange, Int cooldown) {
        return enemyCombat.configureEnemyRules(
            perceptionRange, attackRange, cooldown)
    }

    Bool configureEnemySpatialBounds(
        Int minX, Int minY, Int minZ,
        Int maxX, Int maxY, Int maxZ
    ) {
        return enemyCombat.configureSpatialBounds(
            minX, minY, minZ, maxX, maxY, maxZ)
    }

    Bool addEnemySpatialObstacle(
        Int ax, Int ay, Int az,
        Int bx, Int by, Int bz,
        Int cx, Int cy, Int cz
    ) {
        return enemyCombat.addSpatialObstacle(
            ax, ay, az, bx, by, bz, cx, cy, cz)
    }

    Bool setEnemySpatialPosition(Int id, Int x, Int y, Int z) {
        return enemyCombat.setSpatialPosition(id, x, y, z)
    }

    SpatialVisibilityResult enemySpatialVisibility(
        Int sourceId, Int targetId, Int range
    ) {
        return enemyCombat.spatialVisibility(sourceId, targetId, range)
    }

    EnemyMoveResult moveEnemyToward(
        Int enemyId, Int targetId, Int step
    ) {
        return enemyCombat.moveEnemyToward(enemyId, targetId, step)
    }
    EnemySteeringResult steerEnemyToward(
        Int enemyId, Int targetId, Int step
    ) {
        return enemyCombat.steerEnemySpatial(enemyId, targetId, step)
    }
    ResolutionResult enemyProjectileAttackSpatial(
        Int sourceId, Int targetId, Int tick, Int range, Int critical
    ) {
        return enemyCombat.projectileAttackSpatial(
            sourceId, targetId, tick, range, critical)
    }
    SpatialProjectileResult spawnEnemyProjectileSpatial(
        Int sourceId, Int targetId, Int tick,
        Int range, Int step, Int critical
    ) {
        return enemyCombat.spawnSpatialProjectile(
            sourceId, targetId, tick, range, step, critical)
    }

    Int advanceEnemyProjectiles(Int tick) {
        return enemyCombat.advanceSpatialProjectiles(tick)
    }

    Int activeEnemyProjectiles() {
        return enemyCombat.activeSpatialProjectiles()
    }

    Int enemyProjectileHits() {
        return enemyCombat.spatialProjectileHits()
    }

    Int enemyProjectilesBlocked() {
        return enemyCombat.spatialProjectileBlocked()
    }

    EnemySteeringResult lastEnemySteering() {
        return enemyCombat.lastEnemySteeringResult()
    }

    Int pendingEnemyImpacts() {
        return enemyCombat.pendingSpatialImpacts()
    }

    Bool dequeueEnemyImpact() {
        return enemyCombat.dequeueSpatialImpact()
    }

    SpatialImpactEvent lastEnemyImpact() {
        return enemyCombat.lastSpatialImpact()
    }



    Bool defineEnemyWeapon(
        Int id, Int magazineSize, Int reserveCapacity,
        Int cooldownTicks, Int damage, Int channel, Int range
    ) {
        return enemyCombat.defineWeapon(
            id, magazineSize, reserveCapacity,
            cooldownTicks, damage, channel, range)
    }

    Bool defineEnemyEncounter(Int id, Int maxActive, Int budget) {
        return enemyCombat.defineEncounter(id, maxActive, budget)
    }
    Bool configureEnemyEncounterZone(
        Int encounterId, Int centerX, Int centerY, Int centerZ, Int radius
    ) {
        return enemyCombat.configureEncounterZone(
            encounterId, centerX, centerY, centerZ, radius)
    }


    Bool addEnemyCombatActor(Int id, Int health, Int armor) {
        return enemyCombat.addActor(id, health, armor)
    }

    Bool equipEnemyCombatWeapon(Int actorId, Int weaponId) {
        return enemyCombat.equipWeapon(actorId, weaponId)
    }

    Bool admitEnemy(
        Int encounterId, Int enemyId, Int tick,
        Int health, Int armor, Int weaponId
    ) {
        if (!started || enemyCount >= enemyIds.length ||
            !enemyCombat.admitEnemy(
                encounterId, enemyId, tick, health, armor, weaponId)) {
            return false
        }
        enemyIds[enemyCount] = enemyId
        enemyCount = enemyCount + 1
        return true
    }

    Bool admitEnemyAt(
        Int encounterId, Int enemyId, Int tick,
        Int health, Int armor, Int weaponId,
        Int x, Int y, Int z
    ) {
        if (!started || enemyCount >= enemyIds.length ||
            !enemyCombat.admitEnemyAt(
                encounterId, enemyId, tick, health, armor, weaponId,
                x, y, z)) {
            return false
        }
        enemyIds[enemyCount] = enemyId
        enemyCount = enemyCount + 1
        return true
    }

    Bool configureEnemyPerception(
        Int enemyId, Int targetId, Bool targetVisible,
        Int distance, Int critical
    ) {
        if (distance < 0 || (targetVisible && targetId <= 0) ||
            (critical != 0 && critical != 1)) {
            return false
        }
        for (var index = 0; index < enemyCount; index = index + 1) {
            if (enemyIds[index] == enemyId) {
                enemyPerceptionTargets[index] = targetId
                enemyPerceptionVisible[index] = targetVisible
                enemyPerceptionDistances[index] = distance
                enemyPerceptionCriticals[index] = critical
                enemyPerceptionActive[index] = true
                return true
            }
        }
        return false
    }
    Bool configureEnemySpatialPerception(
        Int enemyId, Int targetId, Int critical
    ) {
        if (targetId <= 0 || (critical != 0 && critical != 1)) {
            return false
        }
        for (var index = 0; index < enemyCount; index = index + 1) {
            if (enemyIds[index] == enemyId) {
                enemyPerceptionTargets[index] = targetId
                enemyPerceptionCriticals[index] = critical
                enemySpatialPerceptionActive[index] = true
                enemyPerceptionActive[index] = true
                return true
            }
        }
        return false
    }


    Bool advanceEnemyTick(Int tick) {
        if (!started || tick < 0) {
            return false
        }
        var accepted = true
        for (var index = 0; index < enemyCount && accepted; index = index + 1) {
            if (enemyPerceptionActive[index]) {
                if (enemySpatialPerceptionActive[index]) {
                    lastEnemyDecision = enemyCombat.stepEnemySpatial(
                        enemyIds[index], tick,
                        enemyPerceptionTargets[index],
                        enemyPerceptionCriticals[index])
                } else {
                    lastEnemyDecision = enemyCombat.stepEnemy(
                        enemyIds[index], tick,
                        enemyPerceptionTargets[index],
                        enemyPerceptionVisible[index],
                        enemyPerceptionDistances[index],
                        enemyPerceptionCriticals[index])
                }
                accepted = lastEnemyDecision.accepted()
            }
        }
        enemyCombat.advanceSpatialProjectiles(tick)
        return accepted && publishEnemyImpactSnapshots(tick)
    }

    Bool publishEnemyImpactSnapshots(Int tick) {
        while (enemyCombat.pendingSpatialImpacts() > 0) {
            if (!enemyCombat.dequeueSpatialImpact()) {
                return false
            }
            var impact = enemyCombat.lastSpatialImpact()
            var snapshot = EnemyImpactSnapshot(
                impact.sequence(), tick, impact.kind(), impact.projectileId(),
                impact.sourceId(), impact.targetId(),
                impact.x(), impact.y(), impact.z(),
                impact.applied(), impact.died())
            if (!enemyServerImpactSnapshots.push(snapshot)) {
                return false
            }
            enemyImpactSnapshotSequence = snapshot.sequence()
        }
        return true
    }

    Bool publishEnemySnapshots(Int tick) {
        for (var index = 0; index < enemyCount; index = index + 1) {
            enemySnapshotSequence = enemySnapshotSequence + 1
            if (!enemyServerSnapshots.push(
                enemyCombat.snapshotEnemy(
                    enemyIds[index], tick, enemySnapshotSequence))) {
                return false
            }
        }
        return true
    }

    EnemyAuthoritySnapshot latestEnemySnapshot() {
        return enemyServerSnapshots.latest()
    }

    Bool applyEnemySnapshot(EnemyAuthoritySnapshot snapshot) {
        if (!started || snapshot.sequence() <= clientEnemySnapshotSequence ||
            snapshot.tick() < clientTick ||
            enemyCombat.enemyState(snapshot.enemyId()) < 0 ||
            !enemyClientSnapshots.push(snapshot)) {
            return false
        }
        clientEnemySnapshotSequence = snapshot.sequence()
        return true
    }

    EnemyAuthoritySnapshot latestClientEnemySnapshot() {
        return enemyClientSnapshots.latest()
    }
    Int impactClip(Int kind) {
        if (kind == 1) {
            return 201
        }
        if (kind == 2) {
            return 202
        }
        return 203
    }

    Int impactGain(Int kind) {
        if (kind == 1) {
            return 100
        }
        if (kind == 2) {
            return 70
        }
        return 35
    }

    Bool presentEnemyImpactSnapshot(EnemyImpactSnapshot snapshot) {
        var clip = impactClip(snapshot.kind())
        var gain = impactGain(snapshot.kind())
        if (!enemyImpactPresentations.push(
            snapshot.sequence(), snapshot.kind(), snapshot.sourceId(),
            snapshot.targetId(), snapshot.x(), snapshot.y(), snapshot.z(),
            snapshot.applied(), snapshot.died(), clip, gain)) {
            return false
        }
        enemyImpactAudio.queue(clip, gain)
        return true
    }

    EnemyImpactSnapshot latestEnemyImpactSnapshot() {
        return enemyServerImpactSnapshots.latest()
    }

    Bool applyEnemyImpactSnapshot(EnemyImpactSnapshot snapshot) {
        if (!started ||
            snapshot.sequence() <= clientEnemyImpactSnapshotSequence ||
            snapshot.tick() < clientTick ||
            !enemyClientImpactSnapshots.push(snapshot) ||
            !presentEnemyImpactSnapshot(snapshot)) {
            return false
        }
        clientEnemyImpactSnapshotSequence = snapshot.sequence()
        return true
    }

    EnemyImpactSnapshot latestClientEnemyImpactSnapshot() {
        return enemyClientImpactSnapshots.latest()
    }

    Int enemyImpactSnapshotCount() {
        return enemyServerImpactSnapshots.size()
    }

    Int clientEnemyImpactSnapshotCount() {
        return enemyClientImpactSnapshots.size()
    }

    Int pendingEnemyImpactPresentations() {
        return enemyImpactPresentations.pending()
    }

    Bool dequeueEnemyImpactPresentation() {
        return enemyImpactPresentations.dequeue()
    }

    ImpactPresentationEvent lastEnemyImpactPresentation() {
        return enemyImpactPresentations.lastConsumed()
    }

    Int pendingEnemyImpactAudio() {
        return enemyImpactAudio.queuedCount()
    }

    Bool dequeueEnemyImpactAudio() {
        return enemyImpactAudio.dequeue()
    }

    Int consumedEnemyImpactClip() {
        return enemyImpactAudio.consumedClip()
    }

    Int consumedEnemyImpactGain() {
        return enemyImpactAudio.consumedGain()
    }

    Int enemySnapshotCount() {
        return enemyServerSnapshots.size()
    }

    Int clientEnemySnapshotCount() {
        return enemyClientSnapshots.size()
    }

    EnemyAttackDecision lastEnemyAttack() {
        return lastEnemyDecision
    }

    Bool receiveInput(
        Int player, Int tick, Int sequence, Int moveX, Int moveY,
        Int lookX, Int lookY, Int fire, Int jump
    ) {
        if (!started) {
            return false
        }
        var command = InputCommand(tick, sequence, moveX, moveY, lookX, lookY, fire, jump)
        if (player == 1 && playerOneConnected) {
            return playerOneInputs.queue(command)
        }
        if (player == 2 && playerTwoConnected) {
            return playerTwoInputs.queue(command)
        }
        return false
    }

    Int advance(Int elapsedMicros) {
        if (!started) {
            return -1
        }
        var steps = clock.advance(elapsedMicros)
        if (steps < 0) {
            return -1
        }
        for (var step = 0; step < steps; step = step + 1) {
            if (playerOneConnected && playerOneInputs.queuedCount() > 0 && playerOneInputs.nextTick() <= clock.tick()) {
                playerOneInputs.dequeue()
                var commandOne = playerOneInputs.lastConsumed()
                playerOneEdges.apply(commandOne.fire(), commandOne.jump())
                serverMovement.applyInput(1, commandOne.moveX())
            }
            if (playerTwoConnected && playerTwoInputs.queuedCount() > 0 && playerTwoInputs.nextTick() <= clock.tick()) {
                playerTwoInputs.dequeue()
                var commandTwo = playerTwoInputs.lastConsumed()
                playerTwoEdges.apply(commandTwo.fire(), commandTwo.jump())
                serverMovement.applyInput(2, commandTwo.moveX())
            }
            var enemyTick = clock.tick() - steps + step + 1
            if (!advanceEnemyTick(enemyTick)) {
                return -1
            }
        }
        serverTick = clock.tick()
        if (steps > 0) {
            snapshotSequence = snapshotSequence + 1
            if (playerOneConnected) {
                var playerOnePosition = serverMovement.position(1)
                playerOneSnapshots.push(snapshotSequence, serverTick, playerOnePosition)
                playerOnePrediction.reconcile(playerOnePosition, serverTick)
                clientMovement.setPosition(1, playerOnePrediction.predicted())
            }
            if (playerTwoConnected) {
                var playerTwoPosition = serverMovement.position(2)
                playerTwoSnapshots.push(snapshotSequence, serverTick, playerTwoPosition)
                playerTwoPrediction.reconcile(playerTwoPosition, serverTick)
                clientMovement.setPosition(2, playerTwoPrediction.predicted())
            }
            clientTick = serverTick
            if (!publishEnemySnapshots(serverTick)) {
                return -1
            }
        }
        return steps
    }
    Bool applySnapshot(Int sequence, Int tick, Int player, Int position) {
        if (!started || sequence <= snapshotSequence || tick < clientTick) {
            return false
        }
        if (player == 1 && playerOneConnected) {
            if (!playerOneSnapshots.push(sequence, tick, position) ||
                !playerOnePrediction.reconcile(position, tick)) {
                return false
            }
            if (!clientMovement.setPosition(1, playerOnePrediction.predicted())) {
                return false
            }
        } else if (player == 2 && playerTwoConnected) {
            if (!playerTwoSnapshots.push(sequence, tick, position) ||
                !playerTwoPrediction.reconcile(position, tick)) {
                return false
            }
            if (!clientMovement.setPosition(2, playerTwoPrediction.predicted())) {
                return false
            }
        } else {
            return false
        }
        snapshotSequence = sequence
        clientTick = tick
        return true
    }

    Int broadPhaseRevision() {
        return broadPhaseRevisionValue
    }

    Int clientBroadPhaseRevision() {
        return clientBroadPhaseRevisionValue
    }

    Bool configureBroadPhaseBounds(
        Int nextMinX, Int nextMinY, Int nextMinZ,
        Int nextMaxX, Int nextMaxY, Int nextMaxZ
    ) {
        if (!broadPhaseCollection.configureBounds(
            nextMinX, nextMinY, nextMinZ, nextMaxX, nextMaxY, nextMaxZ)) {
            return false
        }
        broadPhaseRevisionValue = broadPhaseCollection.geometryRevision()
        return true
    }

    Bool addBroadPhaseTriangle(
        Int axValue, Int ayValue, Int azValue,
        Int bxValue, Int byValue, Int bzValue,
        Int cxValue, Int cyValue, Int czValue
    ) {
        if (!broadPhaseCollection.addTriangle(
            axValue, ayValue, azValue,
            bxValue, byValue, bzValue,
            cxValue, cyValue, czValue)) {
            return false
        }
        broadPhaseRevisionValue = broadPhaseCollection.geometryRevision()
        return true
    }

    Bool removeBroadPhaseTriangle(Int index) {
        if (!broadPhaseCollection.removeTriangle(index)) {
            return false
        }
        broadPhaseRevisionValue = broadPhaseCollection.geometryRevision()
        return true
    }

    Int broadPhaseTriangleCount() {
        return broadPhaseCollection.triangleCount()
    }
    Int[] broadPhaseSnapshot(Int tick, Int sequence) {
        return newBroadPhaseSnapshot(
            protocolVersion(), tick, sequence,
            broadPhaseRevisionValue, broadPhaseCollection)
    }
    Bool queueBroadPhaseSnapshot(Int tick, Int sequence) {
        return broadPhaseTransport.send(broadPhaseSnapshot(tick, sequence))
    }

    Bool configureRemoteEndpoint(
        Int firstOctet, Int secondOctet, Int thirdOctet, Int fourthOctet,
        Int port, Int key0Low, Int key0High, Int key1Low, Int key1High
    ) {
        if (remoteLink.connected() ||
            !remoteEndpoint.setKey(key0Low, key0High, key1Low, key1High) ||
            !remoteEndpoint.setPeer(
                firstOctet, secondOctet, thirdOctet, fourthOctet, port)) {
            return false
        }
        remoteConfigured = remoteEndpoint.valid()
        return remoteConfigured
    }

    Bool openRemoteSession() {
        if (!started || !remoteConfigured) {
            return false
        }
        if (!remoteLink.connect()) {
            return false
        }
        remoteSendSequenceValue = 0
        return true
    }

    Bool closeRemoteSession() {
        return remoteLink.disconnect()
    }

    Bool remoteSessionConnected() {
        return remoteLink.connected()
    }

    Bool queueRemoteBroadPhaseSnapshot(Int tick, Int sequence) {
        if (!started || !remoteLink.connected()) {
            return false
        }
        if (!remoteLink.sendSnapshot(broadPhaseSnapshot(tick, sequence))) {
            return false
        }
        remoteSendSequenceValue = sequence
        return true
    }

    Bool pumpRemoteBroadPhaseSnapshot(Int tick) {
        if (!started || !remoteLink.connected() ||
            remoteSendSequenceValue == 2147483647) {
            return false
        }
        return queueRemoteBroadPhaseSnapshot(
            tick, remoteSendSequenceValue + 1)
    }

    Int remoteSendSequence() {
        return remoteSendSequenceValue
    }

    Bool applyRemoteBroadPhaseSnapshot(Int[] words) {
        if (!started || !remoteLink.canReceiveSnapshot(words) ||
            !applyBroadPhaseSnapshot(words)) {
            return false
        }
        return remoteLink.receiveSnapshot(words)
    }

    Int pendingBroadPhaseSnapshots() {
        return broadPhaseTransport.pending()
    }

    Bool receiveBroadPhaseSnapshot() {
        var words = broadPhaseTransport.receive()
        if (words.length == 0) {
            return false
        }
        return applyBroadPhaseSnapshot(words)
    }


    Bool acceptsBroadPhaseSnapshot(Int[] words) {
        return broadPhaseSnapshotMatches(words, broadPhaseRevisionValue)
    }
    Bool applyBroadPhaseSnapshot(Int[] words) {
        if (!validBroadPhaseSnapshot(words) ||
            words[3] <= clientBroadPhaseSnapshotSequence ||
            words[5] > clientBroadPhaseCollection.triangleCapacity()) {
            return false
        }
        clientBroadPhaseCollection.clearTriangles()
        for (var ordinal = 0; ordinal < words[5]; ordinal = ordinal + 1) {
            var offset = 6 + ordinal * 9
            if (!clientBroadPhaseCollection.addTriangle(
                words[offset], words[offset + 1], words[offset + 2],
                words[offset + 3], words[offset + 4], words[offset + 5],
                words[offset + 6], words[offset + 7], words[offset + 8])) {
                return false
            }
        }
        clientBroadPhaseRevisionValue = words[4]
        clientBroadPhaseSnapshotSequence = words[3]
        return true
    }

    Int clientBroadPhaseTriangleCount() {
        return clientBroadPhaseCollection.triangleCount()
    }

    SegmentCollisionResult queryClientBroadPhase(
        Int geometryRevision,
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ
    ) {
        if (geometryRevision != clientBroadPhaseRevisionValue) {
            return rejectedBroadPhaseQuery(
                startX, startY, startZ, endX, endY, endZ)
        }
        return clientBroadPhaseCollection.query(
            startX, startY, startZ, endX, endY, endZ)
    }



    SegmentCollisionResult rejectedBroadPhaseQuery(
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ
    ) {
        return SegmentCollisionResult(
            false, false, -1,
            startX, startY, startZ, endX, endY, endZ,
            startX, startY, startZ)
    }

    SegmentCollisionResult queryBroadPhase(
        Int geometryRevision,
        Int startX, Int startY, Int startZ,
        Int endX, Int endY, Int endZ
    ) {
        if (geometryRevision != broadPhaseRevisionValue) {
            return rejectedBroadPhaseQuery(
                startX, startY, startZ, endX, endY, endZ)
        }
        return broadPhaseCollection.query(
            startX, startY, startZ, endX, endY, endZ)
    }

    Bool applyQuerySnapshot(
        Int sequence, Int tick, Int geometryRevision,
        Int player, Int position
    ) {
        if (geometryRevision != broadPhaseRevisionValue) {
            return false
        }
        if (!applySnapshot(sequence, tick, player, position)) {
            return false
        }
        clientBroadPhaseRevisionValue = geometryRevision
        return true
    }

    Bool predictClientInput(Int player, Int requestedStep) {
        if (!started) {
            return false
        }
        if (player == 1 && playerOneConnected) {
            if (!playerOnePrediction.predict(requestedStep)) {
                return false
            }
            return clientMovement.setPosition(1, playerOnePrediction.predicted())
        }
        if (player == 2 && playerTwoConnected) {
            if (!playerTwoPrediction.predict(requestedStep)) {
                return false
            }
            return clientMovement.setPosition(2, playerTwoPrediction.predicted())
        }
        return false
    }

    Int predictedPosition(Int player) {
        if (player == 1) {
            return playerOnePrediction.predicted()
        }
        return playerTwoPrediction.predicted()
    }
    Int authoritativePosition(Int player) {
        if (player == 1) {
            return playerOnePrediction.authoritative()
        }
        return playerTwoPrediction.authoritative()
    }

    Int predictionCorrection(Int player) {
        if (player == 1) {
            return playerOnePrediction.correction()
        }
        return playerTwoPrediction.correction()
    }

    Int pendingPredictionInputs(Int player) {
        if (player == 1) {
            return playerOnePrediction.pendingInputs()
        }
        return playerTwoPrediction.pendingInputs()
    }


    InterpolatedPosition interpolatedPosition(Int player, Int renderTick) {
        if (player == 1) {
            return playerOneSnapshots.interpolate(renderTick)
        }
        return playerTwoSnapshots.interpolate(renderTick)
    }

    Int snapshotCount(Int player) {
        if (player == 1) {
            return playerOneSnapshots.size()
        }
        return playerTwoSnapshots.size()
    }


    Int playerCount() {
        var count = 0
        if (playerOneConnected) {
            count = count + 1
        }
        if (playerTwoConnected) {
            count = count + 1
        }
        return count
    }

    Int serverPosition(Int player) {
        return serverMovement.position(player)
    }

    Int clientPosition(Int player) {
        return clientMovement.position(player)
    }

    Int currentServerTick() {
        return serverTick
    }

    Int currentClientTick() {
        return clientTick
    }

    Int latestSnapshotSequence() {
        return snapshotSequence
    }

    Bool inSync() {
        var synced = serverTick == clientTick
        if (playerOneConnected) {
            synced = synced && serverPosition(1) == clientPosition(1)
        }
        if (playerTwoConnected) {
            synced = synced && serverPosition(2) == clientPosition(2)
        }
        return synced
    }

    InputEdges lastInputEdges(Int player) {
        if (player == 1) {
            return playerOneEdges.lastEdges()
        }
        return playerTwoEdges.lastEdges()
    }
}
