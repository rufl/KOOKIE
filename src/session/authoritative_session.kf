            return refreshPlayerCombatModifiers(actorId)
        }
        return true
    }

    Bool defineCombatReward(
        Int actorId, Int currency, Bool enemyActor
    ) {
        var health = playerCombat.currentHealth(actorId)
        if (enemyActor) {
            health = enemyCombat.currentHealth(actorId)
        }
        if (actorId <= 0 || health <= 0 ||
            currency <= 0 || currency > 1000000 ||
            playerCombatRewardCount >= playerCombatRewardTargets.length ||
            playerCombatRewardCount >= 16) {
            return false
        }
        for (var index = 0;
            index < playerCombatRewardCount;
            index = index + 1) {
            if (playerCombatRewardTargets[index] == actorId) {
                return false
            }
        }
        playerCombatRewardTargets[playerCombatRewardCount] = actorId
        playerCombatRewardCurrencies[playerCombatRewardCount] = currency
        playerCombatRewardClaimed[playerCombatRewardCount] = false
        playerCombatRewardCount = playerCombatRewardCount + 1
        return true
    }

    Bool definePlayerCombatReward(Int actorId, Int currency) {
        return defineCombatReward(actorId, currency, false)
    }

    Bool defineEnemyCombatReward(Int actorId, Int currency) {
        if (enemyCombat.enemyState(actorId) < 0) {
            return false
        }
        return defineCombatReward(actorId, currency, true)
    }

    Int combatRewardSlot(Int actorId) {
        for (var index = 0;
            index < playerCombatRewardCount;
            index = index + 1) {
            if (playerCombatRewardTargets[index] == actorId) {
                return index
            }
        }
        return -1
    }

    Int combatRewardCurrency(Int actorId) {
        var slot = combatRewardSlot(actorId)
        if (slot < 0 || playerCombatRewardClaimed[slot]) {
            return 0
        }
        return playerCombatRewardCurrencies[slot]
    }

    Bool combatRewardClaimed(Int actorId) {
        var slot = combatRewardSlot(actorId)
        return slot >= 0 && playerCombatRewardClaimed[slot]
    }

    Bool canGrantCombatReward(Int sourceId, Int reward) {
        return reward == 0 ||
            (sourceId >= 1 && sourceId <= 2 &&
                playerCurrency(sourceId) <= 1000000 - reward)
    }

    Bool grantCombatReward(Int sourceId, Int targetId, Int reward) {
        if (reward == 0) {
            return true
        }
        var slot = combatRewardSlot(targetId)
        if (slot < 0 || playerCombatRewardClaimed[slot] ||
            playerCombatRewardCurrencies[slot] != reward) {
            return false
        }
        var accepted = false
        if (sourceId == 1) {
            accepted = playerOneInventory.depositCurrency(reward)
        } else if (sourceId == 2) {
            accepted = playerTwoInventory.depositCurrency(reward)
        }
        if (!accepted) {
            return false
        }
        playerCombatRewardClaimed[slot] = true
        return true
    }

