        }
        return true
    }

    Bool defineCombatReward(
        Int actorId, Int currency, Bool enemyActor
    ) {
        var health = playerCombat.currentHealth(actorId)
        if (enemyActor) {
            health = enemyCombat.currentHealth(actorId)
        }
        if (actorId <= 0 || health <= 0 ||
            currency <= 0 || currency > 1000000 ||
            playerCombatRewardCount >= playerCombatRewardTargets.length) {
            return false
        }
        for (var index = 0;
            index < playerCombatRewardCount;
            index = index + 1) {
            if (playerCombatRewardTargets[index] == actorId) {
                return false
            }
        }
        playerCombatRewardTargets[playerCombatRewardCount] = actorId
        playerCombatRewardCurrencies[playerCombatRewardCount] = currency
        playerCombatRewardCount = playerCombatRewardCount + 1
        return true
    }

    Bool definePlayerCombatReward(Int actorId, Int currency) {
        return defineCombatReward(actorId, currency, false)
    }

    Bool defineEnemyCombatReward(Int actorId, Int currency) {
        if (enemyCombat.enemyState(actorId) < 0) {
            return false
        }
        return defineCombatReward(actorId, currency, true)
    }

    Int combatRewardCurrency(Int actorId) {
        for (var index = 0;
            index < playerCombatRewardCount;
            index = index + 1) {
            if (playerCombatRewardTargets[index] == actorId) {
                return playerCombatRewardCurrencies[index]
            }
        }
        return 0
    }

    Bool canGrantCombatReward(Int sourceId, Int reward) {
        return reward == 0 ||
            (sourceId >= 1 && sourceId <= 2 &&
                playerCurrency(sourceId) <= 1000000 - reward)
    }

    Bool grantCombatReward(Int sourceId, Int reward) {
        if (reward == 0) {
            return true
        }
        if (sourceId == 1) {
            return playerOneInventory.depositCurrency(reward)
        }
        if (sourceId == 2) {
            return playerTwoInventory.depositCurrency(reward)
        }
        return false
    }

