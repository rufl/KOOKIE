    Int playerItemQuantity(Int player, Int itemId) {
        if (player == 1) {
            for (var index = 0; index < playerOneInventory.itemCount(); index = index + 1) {
                if (playerOneInventory.itemId(index) == itemId) {
                    return playerOneInventory.itemQuantity(index)
                }
            }
        } else if (player == 2) {
            for (var indexTwo = 0; indexTwo < playerTwoInventory.itemCount(); indexTwo = indexTwo + 1) {
                if (playerTwoInventory.itemId(indexTwo) == itemId) {
                    return playerTwoInventory.itemQuantity(indexTwo)
                }
            }
        }
        return 0
    }

    Bool equipPlayerItem(Int player, Int slot, Int itemId) {
        var equipment = playerOneEquipment
        var inventory = playerOneInventory
        if (player == 2) {
            equipment = playerTwoEquipment
            inventory = playerTwoInventory
        } else if (player != 1) {
            return false
        }
        var previousItem = equipment.itemAt(slot)
        var previousBonus = playerEquipmentDamageBonuses[player]
        if (!equipment.equip(inventory, slot, itemId)) {
            return false
        }
        var nextBonus = computePlayerEquipmentDamageBonus(player)
        if (nextBonus < 0) {
            if (previousItem == 0) {
                equipment.unequip(slot)
            } else {
                equipment.equip(inventory, slot, previousItem)
            }
            return false
        }
        playerEquipmentDamageBonuses[player] = nextBonus
        if (refreshPlayerCombatModifiers(player)) {
            return true
        }
        if (previousItem == 0) {
            equipment.unequip(slot)
        } else {
            equipment.equip(inventory, slot, previousItem)
        }
        playerEquipmentDamageBonuses[player] = previousBonus
        refreshPlayerCombatModifiers(player)
        return false
    }

