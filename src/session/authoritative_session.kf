    public constructor(Int inputCapacity, Int entityCapacity) {
        clock = FixedStepClock(60, 4)
        playerOneInputs = InputCommandBuffer(inputCapacity)
        playerTwoInputs = InputCommandBuffer(inputCapacity)
        playerOneEdges = InputEdgeState()
        playerTwoEdges = InputEdgeState()
        serverMovement = MovementComponent(entityCapacity, 4)
        clientMovement = MovementComponent(entityCapacity, 4)
        fpsMovement = FpsMovementController(entityCapacity)
        fpsMovementEnabledValue = false
        playerOneConnected = false
        playerOneFocused = false
        playerTwoFocused = false
        playerTwoConnected = false
        serverTick = 0
        clientTick = 0
        snapshotSequence = 0
        paused = false
        playerOneReplay = InputReplayRecorder(256)
        playerTwoReplay = InputReplayRecorder(256)
        inputReplayEnabled = false
        started = false
        playerOnePrediction = ClientPredictionState(4)
        playerTwoPrediction = ClientPredictionState(4)
        playerOneSnapshots = SnapshotHistory(8)
        playerTwoSnapshots = SnapshotHistory(8)
        clientRemotePlayerOneSnapshots = NetcodeSnapshotWindow()
        clientRemotePlayerTwoSnapshots = NetcodeSnapshotWindow()
        playerOneCorrectionMetrics = NetcodeCorrectionMetrics()
        playerTwoCorrectionMetrics = NetcodeCorrectionMetrics()
        broadPhaseCollection = BoundedTriangleCollection(192, 64)
        broadPhaseCollection.configureBounds(0, 0, 0, 10, 10, 10)
        serverRewindHistory = NetcodeRewindHistory(
            netcodeMaximumRewindActors(), netcodeMaximumRewindTicks())
        enemyCombat = AuthoritativeEnemySession(entityCapacity, entityCapacity)
        enemyServerSnapshots = EnemySnapshotHistory(entityCapacity * 8)
        enemyClientSnapshots = EnemySnapshotHistory(entityCapacity * 8)
        enemyServerImpactSnapshots = EnemyImpactSnapshotHistory(entityCapacity * 8)
        enemyClientImpactSnapshots = EnemyImpactSnapshotHistory(entityCapacity * 8)
        impactPresentations = ImpactPresentationQueue(entityCapacity * 4)
        feedbackHistory = ImpactPresentationHistory(entityCapacity * 8)
        impactAudio = QueuedAudio(entityCapacity * 4)

        playerCombat = CombatWorld(entityCapacity, entityCapacity)
        playerCombatRewardTargets = new Int[entityCapacity]
        playerCombatRewardCurrencies = new Int[entityCapacity]
        playerCombatRewardClaimed = new Bool[entityCapacity]
        playerCombatRewardCount = 0
        playerSpatialTargets = BoundedRayTargetWorld(entityCapacity, 1000000)
        playerWeaponPresentations = PlayerWeaponPresenter(entityCapacity * 2)
        replayPresentationHistory = BoundedReplayPresentationHistory(entityCapacity * 8)
        worldInteractions = BoundedInteractionWorld(16, 1000000)
        extensionRegistry = BoundedExtensionRegistry(8, 16, 32, 32)
        enemyDefinitions = BoundedEnemyDefinitionRegistry(16)
        interactionReplay = InteractionReplayRecorder(64)
        remoteGameplaySequences = new Int[3]
        gameplayStateSequences = new Int[3]
        connectionGenerations = new Int[3]
        disconnectReasons = new Int[3]
        playerAuthorityStateSequences = new Int[3]
        worldLootStateSequences = new Int[3]
        playerEquipmentDamageBonuses = new Int[3]
        lastRemoteGameplayAcceptedValue = false
        lastRemoteGameplayDiagnosticValue = gameplayRejectedDiagnostic()
        remoteImpactSequenceValue = 0
        lastRemoteImpactValue = ImpactPresentationEvent(
            0, 0, 0, 0, 0, 0, 0, 0, false, 0, 0)
        interactionSequences = new Int[3]
        interactionTicks = new Int[3]
        interactionTargets = new Int[3]
        interactionResultTicks = new Int[3]
        interactionResultTargets = new Int[3]
        interactionResults = new Bool[3]
        clientInteractionFlags = new Bool[16]
        clientRemoteEnemyIds = new Int[entityCapacity]
        clientRemoteEnemyRoles = new Int[entityCapacity]
        clientRemoteEnemyStates = new Int[entityCapacity]
        clientRemoteEnemyTargets = new Int[entityCapacity]
        clientRemoteEnemyHealthValues = new Int[entityCapacity]
        clientRemoteEnemyPositionsX = new Int[entityCapacity]
        clientRemoteEnemyPositionsY = new Int[entityCapacity]
        clientRemoteEnemyPositionsZ = new Int[entityCapacity]
        clientRemoteItemIds = new Int[8]
        clientRemoteItemQuantities = new Int[8]
        clientRemoteItemRolled = new Int[8]
        clientRemoteItemDefinitionIds = new Int[8]
        clientRemoteItemSeeds = new Int[8]
        clientRemoteItemLevels = new Int[8]
        clientRemoteItemRarities = new Int[8]
        clientRemoteItemAffixOnes = new Int[8]
        clientRemoteItemAffixTwos = new Int[8]
        clientRemoteItemConditions = new Int[8]
        clientRemoteEquipmentSlots = new Int[4]
        clientRemoteEquipmentItems = new Int[4]
        clientRemoteSkillIds = new Int[4]
        clientRemoteSkillRanks = new Int[4]
        clientRemoteSkillExperiences = new Int[4]
        clientRemoteSkillCooldowns = new Int[4]
        clientRemoteStatusIds = new Int[4]
        clientRemoteStatusDurations = new Int[4]
        clientRemoteStatusStacks = new Int[4]
        clientRemoteWorldLootStableIds = new Int[8]
        clientRemoteWorldLootSourceIds = new Int[8]
        clientRemoteWorldLootRanks = new Int[8]
        clientRemoteWorldLootPositionsX = new Int[8]
        clientRemoteWorldLootPositionsY = new Int[8]
        clientRemoteWorldLootPositionsZ = new Int[8]
        clientRemoteWorldLootDefinitionIds = new Int[8]
        clientRemoteWorldLootSeeds = new Int[8]
        clientRemoteWorldLootLevels = new Int[8]
        clientRemoteWorldLootRarities = new Int[8]
        clientRemoteWorldLootAffixOnes = new Int[8]
        clientRemoteWorldLootAffixTwos = new Int[8]
        clientRemoteWorldLootConditions = new Int[8]
        // Native array storage may be reused; initialize every observable slot.
        for (var player = 0; player < 3; player = player + 1) {
            interactionSequences[player] = 0
            interactionTicks[player] = 0
            interactionTargets[player] = 0
            interactionResultTicks[player] = 0
            interactionResultTargets[player] = 0
            interactionResults[player] = false
            remoteGameplaySequences[player] = 0
            gameplayStateSequences[player] = 0
            connectionGenerations[player] = 0
            disconnectReasons[player] = 0
            playerAuthorityStateSequences[player] = 0
            worldLootStateSequences[player] = 0
            playerEquipmentDamageBonuses[player] = 0
        }
        for (var index = 0; index < clientInteractionFlags.length; index = index + 1) {
            clientInteractionFlags[index] = false
        }
        clientInteractionRevisionValue = 0
        clientSecretCountValue = 0
        clientLevelCompletedValue = false
        clientRemoteStateSequenceValue = 0
        clientRemotePlayerValue = 0
        clientRemoteBaselineReadyValue = false
        clientRemoteFeedbackStateSequenceValue = 0
        clientRemoteCombatActorValue = 0
        clientRemoteCombatHealthValue = 0
        clientRemotePlayerOnePositionValue = 0
        clientRemotePlayerTwoPositionValue = 0
        clientRemotePlayerOneYValue = 0
        clientRemotePlayerOneZValue = 0
        clientRemotePlayerTwoYValue = 0
        clientRemotePlayerTwoZValue = 0
        clientRemoteCurrencyValue = 0
        clientRemoteConnectedValue = false
        clientRemoteConnectionGenerationValue = 0
        clientRemoteDisconnectReasonValue = 0
        clientRemoteDiagnosticValue = 0
        enemyEncounterStateSequenceValue = 0
        clientRemoteEnemyEncounterSequenceValue = 0
        clientRemoteEncounterIdValue = 0
        clientRemoteEncounterActiveCountValue = 0
        clientRemoteEncounterRemainingBudgetValue = 0
        clientRemoteEnemyCountValue = 0
        clientRemoteImpactSequenceValue = 0
        clientRemoteAuthorityStateSequenceValue = 0
        clientRemoteInventoryRevisionValue = 0
        clientRemoteItemCountValue = 0
        clientRemoteEquipmentCountValue = 0
        clientRemoteSkillCountValue = 0
        clientRemoteStatusCountValue = 0
        clientRemoteWorldLootSequenceValue = 0
        clientRemoteWorldLootRevisionValue = 0
        clientRemoteWorldLootCountValue = 0
        for (var clientItem = 0; clientItem < 8; clientItem = clientItem + 1) {
            clientRemoteItemIds[clientItem] = 0
            clientRemoteItemQuantities[clientItem] = 0
            clientRemoteItemRolled[clientItem] = 0
            clientRemoteItemDefinitionIds[clientItem] = 0
            clientRemoteItemSeeds[clientItem] = 0
            clientRemoteItemLevels[clientItem] = 0
            clientRemoteItemRarities[clientItem] = 0
            clientRemoteItemAffixOnes[clientItem] = 0
            clientRemoteItemAffixTwos[clientItem] = 0
            clientRemoteItemConditions[clientItem] = 0
            clientRemoteWorldLootStableIds[clientItem] = 0
            clientRemoteWorldLootSourceIds[clientItem] = 0
            clientRemoteWorldLootRanks[clientItem] = 0
            clientRemoteWorldLootPositionsX[clientItem] = 0
            clientRemoteWorldLootPositionsY[clientItem] = 0
            clientRemoteWorldLootPositionsZ[clientItem] = 0
            clientRemoteWorldLootDefinitionIds[clientItem] = 0
            clientRemoteWorldLootSeeds[clientItem] = 0
            clientRemoteWorldLootLevels[clientItem] = 0
            clientRemoteWorldLootRarities[clientItem] = 0
            clientRemoteWorldLootAffixOnes[clientItem] = 0
            clientRemoteWorldLootAffixTwos[clientItem] = 0
            clientRemoteWorldLootConditions[clientItem] = 0
        }
        for (var clientProgression = 0;
            clientProgression < 4;
            clientProgression = clientProgression + 1) {
            clientRemoteEquipmentSlots[clientProgression] = 0
            clientRemoteEquipmentItems[clientProgression] = 0
            clientRemoteSkillIds[clientProgression] = 0
            clientRemoteSkillRanks[clientProgression] = 0
            clientRemoteSkillExperiences[clientProgression] = 0
            clientRemoteSkillCooldowns[clientProgression] = 0
            clientRemoteStatusIds[clientProgression] = 0
            clientRemoteStatusDurations[clientProgression] = 0
            clientRemoteStatusStacks[clientProgression] = 0
        }
        playerSkillDefinitions = BoundedSkillDefinitionStore(16)
        playerOneSkills = BoundedSkillProgression(4)
        playerTwoSkills = BoundedSkillProgression(4)
        playerOneSkillResource = 100
        playerOneInventory = BoundedItemInventory(1, 8)
        playerTwoInventory = BoundedItemInventory(2, 8)
        playerOneEquipment = BoundedEquipmentLoadout(4)
        playerTwoEquipment = BoundedEquipmentLoadout(4)
        playerTwoSkillResource = 100
        lootItemDefinitions = BoundedItemDefinitionStore(8)
        lootTable = BoundedLootTable(8)
        lootAffixPools = BoundedAffixPoolStore(8)
        lootAffixStats = BoundedAffixStatStore(32)
        lootStatComposer = BoundedItemStatComposer()
        worldLoot = BoundedWorldLoot(8)
        enemyLootStableIds = new Int[entityCapacity]
        enemyLootSeeds = new Int[entityCapacity]
        enemyLootLevels = new Int[entityCapacity]
        enemyLootRanks = new Int[entityCapacity]
        enemyLootSkillIds = new Int[entityCapacity]
        enemyLootSkillExperiences = new Int[entityCapacity]
        enemyLootClaimed = new Bool[entityCapacity]
        playerStatusDefinitions = BoundedStatusDefinitionStore(16)
        playerOneStatuses = BoundedStatusEffects(4)
        playerTwoStatuses = BoundedStatusEffects(4)
        impactAudio.open()
        enemyImpactSnapshotSequence = 0
        clientEnemyImpactSnapshotSequence = 0
        impactPresentationSequence = 0
        impactPresentationDropCountValue = 0
        feedbackSequenceValue = 0
        feedbackStateSequenceValue = 0
        audioListenerX = 0
        audioListenerY = 0
        audioListenerZ = 0
        audioListenerRightX = 100
        audioListenerRightZ = 0
        audioListenerMaxDistance = 100

        enemyIds = new Int[entityCapacity]
        enemyDefinitionNamespaces = new Int[entityCapacity]
        enemyDefinitionIds = new Int[entityCapacity]
        enemyKinds = new Int[entityCapacity]
        enemyEncounterIds = new Int[entityCapacity]
        enemyPerceptionTargets = new Int[entityCapacity]
        enemyPerceptionDistances = new Int[entityCapacity]
        enemyPerceptionCriticals = new Int[entityCapacity]
        enemyPerceptionVisible = new Bool[entityCapacity]
        enemyPerceptionActive = new Bool[entityCapacity]
        enemySpatialPerceptionActive = new Bool[entityCapacity]
        enemyAutonomous = new Bool[entityCapacity]
        enemyCount = 0
        enemySnapshotSequence = 0
        clientEnemySnapshotSequence = 0
        lastEnemyDecision = EnemyAttackDecision(
            false, 0, 0, 0, false, 0, 0, false)
        for (var index = 0; index < entityCapacity; index = index + 1) {
            enemyIds[index] = 0
            enemyDefinitionNamespaces[index] = 0
            enemyDefinitionIds[index] = 0
            enemyKinds[index] = enemyDefinitionNormalKind()
            enemyEncounterIds[index] = 0
            clientRemoteEnemyIds[index] = 0
            clientRemoteEnemyRoles[index] = 0
            clientRemoteEnemyStates[index] = 0
            clientRemoteEnemyTargets[index] = 0
            clientRemoteEnemyHealthValues[index] = 0
            clientRemoteEnemyPositionsX[index] = 0
            clientRemoteEnemyPositionsY[index] = 0
            clientRemoteEnemyPositionsZ[index] = 0
            enemyPerceptionTargets[index] = 0
            enemyPerceptionDistances[index] = 0
            enemyPerceptionCriticals[index] = 0
            enemyPerceptionVisible[index] = false
            enemyPerceptionActive[index] = false
            enemySpatialPerceptionActive[index] = false
            enemyAutonomous[index] = false
            playerCombatRewardTargets[index] = 0
            playerCombatRewardCurrencies[index] = 0
            playerCombatRewardClaimed[index] = false
            enemyLootStableIds[index] = 0
            enemyLootSeeds[index] = 0
            enemyLootLevels[index] = 0
            enemyLootRanks[index] = 0
            enemyLootSkillIds[index] = 0
            enemyLootSkillExperiences[index] = 0
            enemyLootClaimed[index] = false
        }
        clientBroadPhaseCollection = BoundedTriangleCollection(192, 64)
        clientBroadPhaseCollection.configureBounds(0, 0, 0, 10, 10, 10)
        broadPhaseTransport = BroadPhaseTransportQueue(4, 192)
        remoteEndpoint = RemoteSessionEndpoint(
            127, 0, 0, 1, 1, 1, 2, 3, 4)
        remoteLink = RemoteSessionLink(remoteEndpoint)
        remoteConfigured = false
        remoteSendSequenceValue = 0
        clientBroadPhaseSnapshotSequence = 0
        broadPhaseRevisionValue = broadPhaseCollection.geometryRevision()
        clientBroadPhaseRevisionValue = broadPhaseRevisionValue
    }

    Bool registerExtensionManifest(
        Int namespaceId, Int extensionId,
        Int apiVersion, Int schemaVersion, Int role
    ) {
        return !started && extensionRegistry.registerManifest(
            namespaceId, extensionId, apiVersion, schemaVersion, role)
    }

    Bool configureExtensionLoadOrder(
        Int namespaceId, Int extensionId, Int loadOrder
    ) {
        return !started && extensionRegistry.setLoadOrder(
            namespaceId, extensionId, loadOrder)
    }

    Bool configureExtensionProvenance(
        Int namespaceId, Int extensionId, Int provenanceHash
    ) {
        return !started && extensionRegistry.setProvenance(
            namespaceId, extensionId, provenanceHash)
    }

    Bool configureExtensionSchemas(
        Int namespaceId, Int extensionId,
        Int migrationVersion, Int networkSchema
    ) {
        return !started && extensionRegistry.setSchemas(
            namespaceId, extensionId, migrationVersion, networkSchema)
    }

    Bool addExtensionDependency(
        Int ownerNamespace, Int ownerId,
        Int dependencyNamespace, Int dependencyId
    ) {
        return !started && extensionRegistry.addDependency(
            ownerNamespace, ownerId, dependencyNamespace, dependencyId)
    }

    Bool grantExtensionCapability(
        Int ownerNamespace, Int ownerId, Int capabilityId
    ) {
        return !started && extensionRegistry.grantCapability(
            ownerNamespace, ownerId, capabilityId)
    }

    Bool registerExtensionContribution(
        Int ownerNamespace, Int ownerId,
        Int kind, Int publicId, Int priority
    ) {
        return !started && extensionRegistry.registerContribution(
            ownerNamespace, ownerId, kind, publicId, priority)
    }

    Bool defineEnemyDefinition(
        Int ownerNamespace, Int ownerExtension,
        Int definitionId, Int revision, Int kind
    ) {
        return !started && extensionRegistry.hasContribution(
                ownerNamespace, ownerExtension,
                extensionContributionEnemyDefinitionKind(), definitionId) &&
            enemyDefinitions.define(
                ownerNamespace, definitionId, revision, kind)
    }

    Bool setEnemyDefinitionCombat(
        Int namespaceId, Int definitionId,
        Int health, Int armor, Int weaponId
    ) {
        return !started && enemyDefinitions.setCombat(
            namespaceId, definitionId, health, armor, weaponId)
    }

    Bool setEnemyDefinitionBehavior(
        Int namespaceId, Int definitionId,
        Int role, Int moveStep, Int projectileStep
    ) {
        return !started && enemyDefinitions.setBehavior(
            namespaceId, definitionId, role, moveStep, projectileStep)
    }

    Bool setEnemyDefinitionCritical(
        Int namespaceId, Int definitionId, Int critical
    ) {
        return !started && enemyDefinitions.setCritical(
            namespaceId, definitionId, critical)
    }

    Bool setEnemyDefinitionLoot(
        Int namespaceId, Int definitionId,
        Int stableBase, Int seedSalt, Int level
    ) {
        return !started && enemyDefinitions.setLoot(
            namespaceId, definitionId, stableBase, seedSalt, level)
    }

    Bool setEnemyDefinitionRankCurrency(
        Int namespaceId, Int definitionId, Int rank, Int currency
    ) {
        return !started && enemyDefinitions.setRankCurrency(
            namespaceId, definitionId, rank, currency)
    }

    Bool setEnemyDefinitionProgression(
        Int namespaceId, Int definitionId, Int skillId, Int experience
    ) {
        return !started && enemyDefinitions.setProgression(
            namespaceId, definitionId, skillId, experience)
    }

    Int extensionRegistryChecksum() {
        return extensionRegistry.checksum()
    }

    Int enemyDefinitionChecksum() {
        return enemyDefinitions.checksum()
    }

    Int lastExtensionDiagnostic() {
        return extensionRegistry.lastDiagnostic()
    }

    Int extensionContributionCount() {
        return extensionRegistry.contributionCount()
    }

    Int extensionContributionPublicId(Int position) {
        return extensionRegistry.orderedContributionPublicId(position)
    }

    Int enemyDefinitionCount() {
        return enemyDefinitions.count()
    }
    Bool start() {
        if (started || !extensionRegistry.seal() ||
            !enemyDefinitions.seal() || !worldInteractions.seal()) {
            return false
        }
        serverRewindHistory.clear()
        clientRemotePlayerOneSnapshots.clear()
        clientRemotePlayerTwoSnapshots.clear()
        playerOneCorrectionMetrics.clear()
        playerTwoCorrectionMetrics.clear()
        started = true
        return true
    }

    Bool enableFpsMovement(Bool enabled) {
        if (started) {
            return false
        }
        fpsMovementEnabledValue = enabled
        return true
    }

    Bool fpsMovementEnabled() {
        return fpsMovementEnabledValue
    }

    Int fpsPositionX(Int player) {
        return fpsMovement.positionX(player)
    }

    Int fpsPositionY(Int player) {
        return fpsMovement.positionY(player)
    }

    Int fpsPositionZ(Int player) {
        return fpsMovement.positionZ(player)
    }

    Int fpsVelocityX(Int player) {
        return fpsMovement.velocityX(player)
    }

    Int fpsVelocityY(Int player) {
        return fpsMovement.velocityY(player)
    }

    Int fpsVelocityZ(Int player) {
        return fpsMovement.velocityZ(player)
    }

    Bool fpsGrounded(Int player) {
        return fpsMovement.grounded(player)
    }

    Bool fpsLastJumped() {
        return fpsMovement.lastJumped()
    }

    Bool fpsLastCoyoteJump() {
        return fpsMovement.lastCoyoteJump()
    }

    Bool fpsLastBunnyHop() {
        return fpsMovement.lastBunnyHop()
    }


    Bool connectSpecificPlayer(Int player) {
        if (!started || (player != 1 && player != 2)) {
            return false
        }
        var recovering = connectionGenerations[player] > 0
        if (player == 1) {
            if (playerOneConnected) {
                return false
            }
            var positionOne = serverMovement.position(1)
            var positionOneY = 0
            var positionOneZ = 0
            if (enemyCombat.hasSpatialPosition(1)) {
                positionOneY = enemyCombat.enemySpatialPositionY(1)
                positionOneZ = enemyCombat.enemySpatialPositionZ(1)
            }
            if (!serverMovement.setPosition(1, positionOne) ||
                !clientMovement.setPosition(1, positionOne) ||
                (fpsMovementEnabledValue &&
                    !fpsMovement.addActor(
                        1, positionOne, positionOneY, positionOneZ)) ||
                !playerOnePrediction.restore(positionOne, serverTick) ||
                !playerOneSnapshots.reset() ||
                (recovering && !playerOneInputs.resetForReplay())) {
                return false
            }
            playerOneConnected = true
            playerOneFocused = true
        } else {
            if (playerTwoConnected) {
                return false
            }
            var positionTwo = serverMovement.position(2)
            var positionTwoY = 0
            var positionTwoZ = 0
            if (enemyCombat.hasSpatialPosition(2)) {
                positionTwoY = enemyCombat.enemySpatialPositionY(2)
                positionTwoZ = enemyCombat.enemySpatialPositionZ(2)
            }
            if (!serverMovement.setPosition(2, positionTwo) ||
                !clientMovement.setPosition(2, positionTwo) ||
                (fpsMovementEnabledValue &&
                    !fpsMovement.addActor(
                        2, positionTwo, positionTwoY, positionTwoZ)) ||
                !playerTwoPrediction.restore(positionTwo, serverTick) ||
                !playerTwoSnapshots.reset() ||
                (recovering && !playerTwoInputs.resetForReplay())) {
                return false
            }
            playerTwoConnected = true
            playerTwoFocused = true
        }
        if (recovering) {
            interactionSequences[player] = 0
            interactionTicks[player] = 0
            interactionTargets[player] = 0
            remoteGameplaySequences[player] = 0
        }
        connectionGenerations[player] = connectionGenerations[player] + 1
        disconnectReasons[player] = 0
        return true
    }

    Int connectPlayer() {
        if (!started) {
            return 0
        }
        if (!playerOneConnected) {
            if (connectSpecificPlayer(1)) {
                return 1
            }
            return 0
        }
        if (!playerTwoConnected && connectSpecificPlayer(2)) {
            return 2
        }
        return 0
    }

    Bool reconnectPlayer(Int player) {
        return player >= 1 && player <= 2 &&
            connectionGenerations[player] > 0 &&
            connectSpecificPlayer(player)
    }

    Bool disconnectPlayer(Int player, Int reason) {
        if (!started || (player != 1 && player != 2) ||
            reason < 1 || reason > 4) {
            return false
        }
        if (player == 1 && playerOneConnected) {
            playerOneConnected = false
            playerOneFocused = false
            playerOneInputs.clearPending()
            playerOneEdges.clearHeld()
            interactionTargets[1] = 0
            interactionTicks[1] = 0
            disconnectReasons[1] = reason
            return true
        }
        if (player == 2 && playerTwoConnected) {
            playerTwoConnected = false
            playerTwoFocused = false
            playerTwoInputs.clearPending()
            playerTwoEdges.clearHeld()
            interactionTargets[2] = 0
            interactionTicks[2] = 0
            disconnectReasons[2] = reason
            return true
        }
        return false
    }

    Int playerConnectionGeneration(Int player) {
        if (player < 1 || player > 2) {
            return -1
        }
        return connectionGenerations[player]
    }

    Int playerDisconnectReason(Int player) {
        if (player < 1 || player > 2) {
            return -1
        }
        return disconnectReasons[player]
    }

    Bool defineWorldKey(Int id, Int x, Int y, Int z, Int range) {
        return !started && worldInteractions.defineKey(id, x, y, z, range)
    }

    Bool defineWorldDoor(
        Int id, Int keyId, Int x, Int y, Int z,
        Int halfWidth, Int halfHeight, Int halfDepth, Int range
    ) {
        return !started && worldInteractions.defineDoor(
            id, keyId, x, y, z,
            halfWidth, halfHeight, halfDepth, range)
    }

    SegmentCollisionResult queryWorldDoorPath(
        SpatialPoint start, SpatialPoint end
    ) {
        return worldInteractions.queryDoorSegment(
            start.x(), start.y(), start.z(),
            end.x(), end.y(), end.z())
    }

    Bool defineWorldSecret(Int id, Int x, Int y, Int z, Int range) {
        return !started && worldInteractions.defineSecret(id, x, y, z, range)
    }

    Bool defineWorldExit(
        Int id, Int doorId, Int requiredSecrets, Int x, Int y, Int z, Int range
    ) {
        return !started && worldInteractions.defineExit(
            id, doorId, requiredSecrets, x, y, z, range)
    }

    Bool receiveInteraction(Int player, Int tick, Int sequence, Int targetId) {
        if (!started || paused || player < 1 || player > 2 ||
            tick <= serverTick || tick > 1000000 || tick - serverTick > 4 ||
            sequence <= interactionSequences[player] || sequence > 1000000 ||
            interactionTargets[player] != 0 || worldInteractions.kind(targetId) == 0 ||
            worldInteractions.completed() || !playerFocused(player)) {
            return false
        }
        if (inputReplayEnabled) {
            var reserved = interactionReplay.count()
            for (var pendingPlayer = 1; pendingPlayer <= 2; pendingPlayer = pendingPlayer + 1) {
                if (interactionTargets[pendingPlayer] != 0) {
                    reserved = reserved + 1
                }
            }
            if (reserved >= interactionReplay.capacity()) {
                return false
            }
        }
        interactionSequences[player] = sequence
        interactionTicks[player] = tick
        interactionTargets[player] = targetId
        return true
    }

    Bool recordFeedbackEvent(
        Int kind, Int sourceId, Int targetId,
        Int x, Int y, Int z, Int applied, Bool died,
        Int clip, Int gain
    ) {
        if (feedbackSequenceValue >= 1000000) {
            return false
        }
        var event = ImpactPresentationEvent(
            feedbackSequenceValue + 1, kind,
            sourceId, targetId, x, y, z,
            applied, died, clip, gain)
        if (!feedbackHistory.append(event)) {
            return false
        }
        feedbackSequenceValue = event.sequence()
        remoteImpactSequenceValue = event.sequence()
        lastRemoteImpactValue = event
        return true
    }

    Bool recordRemoteImpact(
        ResolutionResult result, Int x, Int y, Int z
    ) {
        if (!result.accepted() || result.applied() <= 0) {
            return false
        }
        var gain = 70
        if (result.died()) {
            gain = 100
        }
        return recordFeedbackEvent(
            1, result.sourceId(), result.targetId(),
            x, y, z, result.applied(), result.died(),
            impactClip(1), gain)
    }

    Bool applyRemoteGameplayCommand(Int[] words) {
        lastRemoteGameplayAcceptedValue = false
        lastRemoteGameplayDiagnosticValue = gameplayRejectedDiagnostic()
        if (!validGameplayCommandMessage(words)) {
            return false
        }
        var player = gameplayCommandPlayer(words)
        var tick = gameplayCommandTick(words)
        var sequence = gameplayCommandSequence(words)
        var action = gameplayCommandAction(words)
        var generation = gameplayCommandGeneration(words)
        if (generation != connectionGenerations[player]) {
            lastRemoteGameplayDiagnosticValue =
                gameplayGenerationDiagnostic()
            return true
        }
        if (sequence <= remoteGameplaySequences[player]) {
            lastRemoteGameplayDiagnosticValue = gameplayStaleDiagnostic()
            return true
        }
        remoteGameplaySequences[player] = sequence
        if (action == gameplayReconnectAction()) {
            lastRemoteGameplayAcceptedValue = reconnectPlayer(player)
            if (lastRemoteGameplayAcceptedValue) {
                lastRemoteGameplayDiagnosticValue = gameplayReconnectDiagnostic()
            }
            return true
        }
        if (!playerConnected(player)) {
            return true
        }
        if (action == gameplayDisconnectAction()) {
            lastRemoteGameplayAcceptedValue = disconnectPlayer(
                player, gameplayCommandValue(words, 0))
            if (lastRemoteGameplayAcceptedValue) {
                lastRemoteGameplayDiagnosticValue = gameplayDisconnectDiagnostic()
            }
            return true
        }
        if (action == gameplayMoveAction()) {
            if (tick == serverTick + 1 &&
                receiveInput(
                    player, tick, sequence,
                    gameplayCommandValue(words, 0), 0, 0, 0, 0, 0)) {
                lastRemoteGameplayAcceptedValue = advance(16667) == 1
            }
            if (lastRemoteGameplayAcceptedValue) {
                lastRemoteGameplayDiagnosticValue = gameplayMoveDiagnostic()
            }
            return true
        }
        if (action == gameplayFireAction()) {
            if (tick == serverTick + 1 && advance(16667) == 1) {
                var targetId = gameplayCommandValue(words, 0)
                var result = ResolutionResult(
                    false, 0, player, targetId, 0, 0, false, 0)
                if (enemyCombat.enemyState(targetId) >= 0) {
                    result = resolveEnemyHitscan(
                        player, targetId, tick,
                        gameplayCommandValue(words, 1),
                        gameplayCommandValue(words, 2))
                    if (result.accepted()) {
                        recordRemoteImpact(
                            result,
                            enemyCombat.enemySpatialPositionX(targetId),
                            enemyCombat.enemySpatialPositionY(targetId),
                            enemyCombat.enemySpatialPositionZ(targetId))
                    }
                } else {
                    result = resolvePlayerHitscan(
                        player, targetId, tick,
                        gameplayCommandValue(words, 1),
                        gameplayCommandValue(words, 2))
                    if (result.accepted()) {
                        recordRemoteImpact(result, 0, 0, 0)
                    }
                }
                lastRemoteGameplayAcceptedValue = result.accepted()
            }
            if (lastRemoteGameplayAcceptedValue) {
                lastRemoteGameplayDiagnosticValue = gameplayFireDiagnostic()
            }
            return true
        }
        if (action == gameplayPickupAction()) {
            if (tick == serverTick + 1 && advance(16667) == 1) {
                lastRemoteGameplayAcceptedValue = pickupPlayerLoot(
                    player, gameplayCommandValue(words, 0))
            }
            if (lastRemoteGameplayAcceptedValue) {
                lastRemoteGameplayDiagnosticValue = gameplayPickupDiagnostic()
            }
            return true
        }
        if (action == gameplayEquipAction()) {
            if (tick == serverTick + 1 && advance(16667) == 1) {
                lastRemoteGameplayAcceptedValue = equipPlayerItem(
                    player, gameplayCommandValue(words, 0),
                    gameplayCommandValue(words, 1))
            }
            if (lastRemoteGameplayAcceptedValue) {
                lastRemoteGameplayDiagnosticValue = gameplayEquipDiagnostic()
            }
            return true
        }
        if (action == gameplayProgressionAction()) {
            if (tick == serverTick + 1 && advance(16667) == 1) {
                if (gameplayCommandValue(words, 1) == 1) {
                    lastRemoteGameplayAcceptedValue = learnPlayerSkill(
                        player, gameplayCommandValue(words, 0))
                } else {
                    var activation = activatePlayerSkill(
                        player, gameplayCommandValue(words, 0), serverTick)
                    lastRemoteGameplayAcceptedValue = activation.accepted()
                }
            }
            if (lastRemoteGameplayAcceptedValue) {
                lastRemoteGameplayDiagnosticValue =
                    gameplayProgressionDiagnostic()
            }
            return true
        }
        if (tick == serverTick + 1 &&
            receiveInteraction(
                player, tick, sequence, gameplayCommandValue(words, 0)) &&
            advance(16667) == 1) {
            lastRemoteGameplayAcceptedValue = lastInteractionAccepted(player)
        }
        if (lastRemoteGameplayAcceptedValue) {
            lastRemoteGameplayDiagnosticValue = gameplayInteractionDiagnostic()
        }
        return true
    }

    Bool lastRemoteGameplayAccepted() {
        return lastRemoteGameplayAcceptedValue
    }

    Int lastRemoteGameplayDiagnostic() {
        return lastRemoteGameplayDiagnosticValue
    }

    Int[] gameplayStateMessage(Int tick, Int combatActorId, Int player) {
        var health = playerCombatHealth(combatActorId)
        if (enemyCombat.hasSpatialPosition(combatActorId)) {
            health = enemyCombat.currentHealth(combatActorId)
        } else if (enemyCombat.enemyState(combatActorId) >= 0) {
            health = enemyCombat.currentHealth(combatActorId)
        }
        if (!started || tick < 0 || tick > 1000000 ||
            tick != serverTick ||
            health < 0 || player < 1 || player > 2 ||
            connectionGenerations[player] <= 0 ||
            gameplayStateSequences[player] >= 1000000) {
            return new Int[0]
        }
        gameplayStateSequences[player] = gameplayStateSequences[player] + 1
        var state = newGameplayStateMessage(
            tick, gameplayStateSequences[player],
            lastRemoteGameplayAcceptedValue,
            worldInteractions.revision(), combatActorId, health, player)
        var playerOneY = 0
        var playerOneZ = 0
        var playerTwoY = 0
        var playerTwoZ = 0
        if (enemyCombat.hasSpatialPosition(1)) {
            playerOneY = enemyCombat.enemySpatialPositionY(1)
            playerOneZ = enemyCombat.enemySpatialPositionZ(1)
        }
        if (enemyCombat.hasSpatialPosition(2)) {
            playerTwoY = enemyCombat.enemySpatialPositionY(2)
            playerTwoZ = enemyCombat.enemySpatialPositionZ(2)
        }
        if (!setGameplayStateProgression(
                state, worldInteractions.secretCount(),
                worldInteractions.completed(), worldInteractions.activeMask()) ||
            !setGameplayStateReplication(
                state, serverMovement.position(1), serverMovement.position(2),
                playerCurrency(player)) ||
            !setGameplayStateMovement(
                state, playerOneY, playerOneZ, playerTwoY, playerTwoZ) ||
            !setGameplayStateConnection(
                state, playerConnected(player), connectionGenerations[player],
                disconnectReasons[player], lastRemoteGameplayDiagnosticValue) ||
            !sealGameplayStateMessage(state)) {
            return new Int[0]
        }
        return state
    }

    Bool applyRemoteGameplayState(Int[] words) {
        if (!started || !validGameplayStateMessage(words) ||
            words[3] <= clientRemoteStateSequenceValue ||
            gameplayStateInteractionRevision(words) <
                clientInteractionRevisionValue) {
            return false
        }
        var player = gameplayStatePlayer(words)
        var generation = gameplayStateConnectionGeneration(words)
        if ((clientRemoteBaselineReadyValue &&
                player != clientRemotePlayerValue) ||
            (clientRemoteBaselineReadyValue &&
                generation < clientRemoteConnectionGenerationValue)) {
            return false
        }
        var newBaseline = !clientRemoteBaselineReadyValue ||
            generation > clientRemoteConnectionGenerationValue
        var positionOne = gameplayStatePlayerPosition(words, 1)
        var positionTwo = gameplayStatePlayerPosition(words, 2)
        var positionOneY = gameplayStatePlayerY(words, 1)
        var positionOneZ = gameplayStatePlayerZ(words, 1)
        var positionTwoY = gameplayStatePlayerY(words, 2)
        var positionTwoZ = gameplayStatePlayerZ(words, 2)
        if (newBaseline) {
            clientRemotePlayerOneSnapshots.clear()
            clientRemotePlayerTwoSnapshots.clear()
        }
        if (!clientRemotePlayerOneSnapshots.accept(
                words[2], words[3], positionOne) ||
            !clientRemotePlayerTwoSnapshots.accept(
                words[2], words[3], positionTwo)) {
            return false
        }
        var authoritativePosition = positionOne
        if (player == 2) {
            authoritativePosition = positionTwo
        }
        var predictionAccepted = false
        if (player == 1) {
            if (newBaseline) {
                predictionAccepted = playerOnePrediction.restore(
                    authoritativePosition, words[2])
            } else {
                predictionAccepted = playerOnePrediction.reconcile(
                    authoritativePosition, words[2])
            }
        } else {
            if (newBaseline) {
                predictionAccepted = playerTwoPrediction.restore(
                    authoritativePosition, words[2])
            } else {
                predictionAccepted = playerTwoPrediction.reconcile(
                    authoritativePosition, words[2])
            }
        }
        if (!predictionAccepted ||
            !clientMovement.setPosition(1, positionOne) ||
            !clientMovement.setPosition(2, positionTwo)) {
            return false
        }
        if (player == 1 &&
            !clientMovement.setPosition(
                1, playerOnePrediction.predicted())) {
            return false
        }
        if (player == 2 &&
            !clientMovement.setPosition(
                2, playerTwoPrediction.predicted())) {
            return false
        }
        if (newBaseline) {
            clientRemoteImpactSequenceValue = 0
            clientRemoteFeedbackStateSequenceValue = 0
            clientRemoteAuthorityStateSequenceValue = 0
            clientRemoteWorldLootSequenceValue = 0
            clientRemoteItemCountValue = 0
            clientRemoteEquipmentCountValue = 0
            clientRemoteSkillCountValue = 0
            clientRemoteStatusCountValue = 0
            clientRemoteWorldLootCountValue = 0
            impactPresentations.reset()
            impactAudio.reset()
        }
        var mask = gameplayStateInteractionMask(words)
        var divisor = 1
        for (var index = 0;
            index < clientInteractionFlags.length;
            index = index + 1) {
            clientInteractionFlags[index] = (mask / divisor) % 2 == 1
            divisor = divisor * 2
        }
        clientInteractionRevisionValue =
            gameplayStateInteractionRevision(words)
        clientSecretCountValue = gameplayStateSecretCount(words)
        clientLevelCompletedValue = gameplayStateLevelCompleted(words)
        clientRemoteStateSequenceValue = words[3]
        clientRemotePlayerValue = player
        clientRemoteBaselineReadyValue = true
        clientRemoteCombatActorValue = gameplayStateCombatActor(words)
        clientRemoteCombatHealthValue = gameplayStateCombatHealth(words)
        clientRemotePlayerOnePositionValue = positionOne
        clientRemotePlayerTwoPositionValue = positionTwo
        clientRemotePlayerOneYValue = positionOneY
        clientRemotePlayerOneZValue = positionOneZ
        clientRemotePlayerTwoYValue = positionTwoY
        clientRemotePlayerTwoZValue = positionTwoZ
        clientRemoteCurrencyValue = gameplayStateCurrency(words)
        clientRemoteConnectedValue = gameplayStateConnected(words)
        clientRemoteConnectionGenerationValue = generation
        clientRemoteDisconnectReasonValue =
            gameplayStateDisconnectReason(words)
        clientRemoteDiagnosticValue = gameplayStateDiagnostic(words)
        return true
    }

    Int[] playerAuthorityStateMessage(Int tick, Int player) {
        if (!started || tick < 0 || tick > 1000000 ||
            tick != serverTick || player < 1 || player > 2 ||
            !playerConnected(player) ||
            connectionGenerations[player] <= 0 ||
            playerAuthorityStateSequences[player] >= 1000000) {
            return new Int[0]
        }
        var inventory = playerInventory(player)
        var equipment = playerEquipment(player)
        var skills = playerOneSkills
        var statuses = playerOneStatuses
        if (player == 2) {
            skills = playerTwoSkills
            statuses = playerTwoStatuses
        }
        var equipmentCount = 0
        for (var slot = 0; slot < equipment.slotCount(); slot = slot + 1) {
            if (equipment.itemAt(slot) > 0) {
                equipmentCount = equipmentCount + 1
            }
        }
        playerAuthorityStateSequences[player] =
            playerAuthorityStateSequences[player] + 1
        var state = newPlayerAuthorityStateMessage(
            inventory.itemCount(), equipmentCount,
            skills.count(), statuses.count())
        if (!setPlayerAuthorityConnection(
                state, tick, playerAuthorityStateSequences[player],
                player, connectionGenerations[player]) ||
            !setPlayerAuthorityInventory(
                state, inventory.revision(), inventory.currency())) {
            return new Int[0]
        }
        for (var item = 0; item < inventory.itemCount(); item = item + 1) {
            var roll = inventory.itemRoll(item)
            var rolled = 0
            var definitionId = 0
            var seed = 0
            var level = 0
            var rarity = 0
            var affixOne = 0
            var affixTwo = 0
            var condition = 0
            if (roll.accepted()) {
                rolled = 1
                definitionId = roll.definitionId()
                seed = roll.seed()
                level = roll.level()
                rarity = roll.rarity()
                affixOne = roll.affixOne()
                affixTwo = roll.affixTwo()
                condition = roll.condition()
            }
            if (!setPlayerAuthorityItem(
                    state, item, inventory.itemId(item),
                    inventory.itemQuantity(item), rolled) ||
                (rolled == 1 &&
                    (!setPlayerAuthorityItemRoll(
                        state, item, definitionId, seed, level) ||
                    !setPlayerAuthorityItemAffixes(
                        state, item, rarity,
                        affixOne, affixTwo, condition)))) {
                return new Int[0]
            }
        }
        var equipmentIndex = 0
        for (var slot = 0; slot < equipment.slotCount(); slot = slot + 1) {
            var itemId = equipment.itemAt(slot)
            if (itemId > 0) {
                if (!setPlayerAuthorityEquipment(
                        state, equipmentIndex, slot, itemId)) {
                    return new Int[0]
                }
                equipmentIndex = equipmentIndex + 1
            }
        }
        for (var skill = 0; skill < skills.count(); skill = skill + 1) {
            if (!setPlayerAuthoritySkill(
                    state, skill, skills.skillIdAt(skill),
                    skills.rankAt(skill), skills.experienceAt(skill),
                    skills.cooldownUntilAt(skill))) {
                return new Int[0]
            }
        }
        for (var status = 0; status < statuses.count(); status = status + 1) {
            var statusId = statuses.statusIdAt(status)
            if (!setPlayerAuthorityStatus(
                    state, status, statusId,
                    statuses.duration(statusId), statuses.stacks(statusId))) {
                return new Int[0]
            }
        }
        if (!sealPlayerAuthorityStateMessage(state)) {
            return new Int[0]
        }
        return state
    }

    Bool applyRemotePlayerAuthorityState(Int[] words) {
        if (!started || !clientRemoteBaselineReadyValue ||
            !validPlayerAuthorityStateMessage(words) ||
            playerAuthorityStatePlayer(words) != clientRemotePlayerValue ||
            playerAuthorityStateGeneration(words) !=
                clientRemoteConnectionGenerationValue ||
            playerAuthorityStateSequence(words) <=
                clientRemoteAuthorityStateSequenceValue ||
            playerAuthorityStateInventoryRevision(words) <
                clientRemoteInventoryRevisionValue) {
            return false
        }
        var itemCount = playerAuthorityStateItemCount(words)
        var equipmentCount = playerAuthorityStateEquipmentCount(words)
        var skillCount = playerAuthorityStateSkillCount(words)
        var statusCount = playerAuthorityStateStatusCount(words)
        for (var index = 0; index < clientRemoteItemIds.length; index = index + 1) {
            clientRemoteItemIds[index] = 0
            clientRemoteItemQuantities[index] = 0
            clientRemoteItemRolled[index] = 0
            clientRemoteItemDefinitionIds[index] = 0
            clientRemoteItemSeeds[index] = 0
            clientRemoteItemLevels[index] = 0
            clientRemoteItemRarities[index] = 0
            clientRemoteItemAffixOnes[index] = 0
            clientRemoteItemAffixTwos[index] = 0
            clientRemoteItemConditions[index] = 0
            if (index < itemCount) {
                var offset = playerAuthorityItemEntriesOffset() +
                    index * playerAuthorityItemEntryWidth()
                clientRemoteItemIds[index] = words[offset]
                clientRemoteItemQuantities[index] = words[offset + 1]
                clientRemoteItemRolled[index] = words[offset + 2]
                clientRemoteItemDefinitionIds[index] = words[offset + 3]
                clientRemoteItemSeeds[index] = words[offset + 4]
                clientRemoteItemLevels[index] = words[offset + 5]
                clientRemoteItemRarities[index] = words[offset + 6]
                clientRemoteItemAffixOnes[index] = words[offset + 7]
                clientRemoteItemAffixTwos[index] = words[offset + 8]
                clientRemoteItemConditions[index] = words[offset + 9]
            }
        }
        var equipmentOffset = playerAuthorityEquipmentEntriesOffset(words)
        for (var equipment = 0;
            equipment < clientRemoteEquipmentSlots.length;
            equipment = equipment + 1) {
            clientRemoteEquipmentSlots[equipment] = 0
            clientRemoteEquipmentItems[equipment] = 0
            if (equipment < equipmentCount) {
                var offset = equipmentOffset +
                    equipment * playerAuthorityEquipmentEntryWidth()
                clientRemoteEquipmentSlots[equipment] = words[offset]
                clientRemoteEquipmentItems[equipment] = words[offset + 1]
            }
        }
        var skillOffset = playerAuthoritySkillEntriesOffset(words)
        for (var skill = 0;
            skill < clientRemoteSkillIds.length;
            skill = skill + 1) {
            clientRemoteSkillIds[skill] = 0
            clientRemoteSkillRanks[skill] = 0
            clientRemoteSkillExperiences[skill] = 0
            clientRemoteSkillCooldowns[skill] = 0
            if (skill < skillCount) {
                var offset = skillOffset +
                    skill * playerAuthoritySkillEntryWidth()
                clientRemoteSkillIds[skill] = words[offset]
                clientRemoteSkillRanks[skill] = words[offset + 1]
                clientRemoteSkillExperiences[skill] = words[offset + 2]
                clientRemoteSkillCooldowns[skill] = words[offset + 3]
            }
        }
        var statusOffset = playerAuthorityStatusEntriesOffset(words)
        for (var status = 0;
            status < clientRemoteStatusIds.length;
            status = status + 1) {
            clientRemoteStatusIds[status] = 0
            clientRemoteStatusDurations[status] = 0
            clientRemoteStatusStacks[status] = 0
            if (status < statusCount) {
                var offset = statusOffset +
                    status * playerAuthorityStatusEntryWidth()
                clientRemoteStatusIds[status] = words[offset]
                clientRemoteStatusDurations[status] = words[offset + 1]
                clientRemoteStatusStacks[status] = words[offset + 2]
            }
        }
        clientRemoteAuthorityStateSequenceValue =
            playerAuthorityStateSequence(words)
        clientRemoteInventoryRevisionValue =
            playerAuthorityStateInventoryRevision(words)
        clientRemoteCurrencyValue = playerAuthorityStateCurrency(words)
        clientRemoteItemCountValue = itemCount
        clientRemoteEquipmentCountValue = equipmentCount
        clientRemoteSkillCountValue = skillCount
        clientRemoteStatusCountValue = statusCount
        return true
    }

    Int[] worldLootStateMessage(Int tick, Int player) {
        if (!started || tick < 0 || tick > 1000000 ||
            tick != serverTick || player < 1 || player > 2 ||
            !playerConnected(player) ||
            connectionGenerations[player] <= 0 ||
            worldLootStateSequences[player] >= 1000000) {
            return new Int[0]
        }
        worldLootStateSequences[player] =
            worldLootStateSequences[player] + 1
        var state = newWorldLootStateMessage(
            tick, worldLootStateSequences[player],
            player, connectionGenerations[player],
            worldLoot.revision(), worldLoot.count())
        for (var index = 0; index < worldLoot.count(); index = index + 1) {
            if (!setWorldLootStateEntry(state, index, worldLoot, index)) {
                return new Int[0]
            }
        }
        if (!sealWorldLootStateMessage(state)) {
            return new Int[0]
        }
        return state
    }

    Bool applyRemoteWorldLootState(Int[] words) {
        if (!started || !clientRemoteBaselineReadyValue ||
            !validWorldLootStateMessage(words) ||
            worldLootStatePlayer(words) != clientRemotePlayerValue ||
            worldLootStateGeneration(words) !=
                clientRemoteConnectionGenerationValue ||
            worldLootStateSequence(words) <=
                clientRemoteWorldLootSequenceValue ||
            worldLootStateRevision(words) <
                clientRemoteWorldLootRevisionValue) {
            return false
        }
        var count = worldLootStateDropCount(words)
        for (var index = 0;
            index < clientRemoteWorldLootStableIds.length;
            index = index + 1) {
            clientRemoteWorldLootStableIds[index] = 0
            clientRemoteWorldLootSourceIds[index] = 0
            clientRemoteWorldLootRanks[index] = 0
            clientRemoteWorldLootPositionsX[index] = 0
            clientRemoteWorldLootPositionsY[index] = 0
            clientRemoteWorldLootPositionsZ[index] = 0
            clientRemoteWorldLootDefinitionIds[index] = 0
            clientRemoteWorldLootSeeds[index] = 0
            clientRemoteWorldLootLevels[index] = 0
            clientRemoteWorldLootRarities[index] = 0
            clientRemoteWorldLootAffixOnes[index] = 0
            clientRemoteWorldLootAffixTwos[index] = 0
            clientRemoteWorldLootConditions[index] = 0
            if (index < count) {
                var offset = worldLootStateEntriesOffset() +
                    index * worldLootStateEntryWidth()
                clientRemoteWorldLootStableIds[index] = words[offset]
                clientRemoteWorldLootSourceIds[index] = words[offset + 1]
                clientRemoteWorldLootRanks[index] = words[offset + 2]
                clientRemoteWorldLootPositionsX[index] = words[offset + 3]
                clientRemoteWorldLootPositionsY[index] = words[offset + 4]
                clientRemoteWorldLootPositionsZ[index] = words[offset + 5]
                clientRemoteWorldLootDefinitionIds[index] = words[offset + 6]
                clientRemoteWorldLootSeeds[index] = words[offset + 7]
                clientRemoteWorldLootLevels[index] = words[offset + 8]
                clientRemoteWorldLootRarities[index] = words[offset + 9]
                clientRemoteWorldLootAffixOnes[index] = words[offset + 10]
                clientRemoteWorldLootAffixTwos[index] = words[offset + 11]
                clientRemoteWorldLootConditions[index] = words[offset + 12]
            }
        }
        clientRemoteWorldLootSequenceValue =
            worldLootStateSequence(words)
        clientRemoteWorldLootRevisionValue =
            worldLootStateRevision(words)
        clientRemoteWorldLootCountValue = count
        return true
    }

    Int[] enemyEncounterStateMessage(Int tick, Int encounterId) {
        if (!started || tick < 0 || tick > 1000000 ||
            tick != serverTick ||
            encounterId <= 0 || encounterId > 1000000 ||
            enemyEncounterStateSequenceValue >= 1000000) {
            return new Int[0]
        }
        var encounterEnemyCount = 0
        for (var index = 0; index < enemyCount; index = index + 1) {
            if (enemyEncounterIds[index] == encounterId) {
                encounterEnemyCount = encounterEnemyCount + 1
            }
        }
        if (encounterEnemyCount <= 0 ||
            encounterEnemyCount > maximumEnemyEncounterStateEnemies()) {
            return new Int[0]
        }
        enemyEncounterStateSequenceValue =
            enemyEncounterStateSequenceValue + 1
        var state = newEnemyEncounterStateMessage(
            tick, enemyEncounterStateSequenceValue, encounterId,
            enemyCombat.encounterActiveCount(encounterId),
            enemyCombat.encounterRemainingBudget(encounterId),
            encounterEnemyCount)
        var impactBelongs = false
        if (lastRemoteImpactValue.sequence() > 0) {
            for (var index = 0;
                index < enemyCount && !impactBelongs;
                index = index + 1) {
                impactBelongs =
                    enemyEncounterIds[index] == encounterId &&
                    enemyIds[index] == lastRemoteImpactValue.targetId()
            }
        }
        if (impactBelongs && !setEnemyEncounterStateImpact(
                state,
                lastRemoteImpactValue.sequence(),
                lastRemoteImpactValue.kind(),
                lastRemoteImpactValue.sourceId(),
                lastRemoteImpactValue.targetId(),
                lastRemoteImpactValue.x(),
                lastRemoteImpactValue.y(),
                lastRemoteImpactValue.z(),
                lastRemoteImpactValue.applied(),
                lastRemoteImpactValue.died(),
                lastRemoteImpactValue.clip(),
                lastRemoteImpactValue.gain())) {
            return new Int[0]
        }
        var entry = 0
        for (var index = 0; index < enemyCount; index = index + 1) {
            if (enemyEncounterIds[index] == encounterId) {
                var enemyId = enemyIds[index]
                if (!setEnemyEncounterStateEntry(
                        state, entry, enemyId,
                        enemyCombat.enemyRole(enemyId),
                        enemyCombat.enemyState(enemyId),
                        enemyCombat.enemyTarget(enemyId),
                        enemyCombat.currentHealth(enemyId),
                        enemyCombat.enemySpatialPositionX(enemyId),
                        enemyCombat.enemySpatialPositionY(enemyId),
                        enemyCombat.enemySpatialPositionZ(enemyId))) {
                    return new Int[0]
                }
                entry = entry + 1
            }
        }
        if (!sealEnemyEncounterStateMessage(state)) {
            return new Int[0]
        }
        return state
    }

    Bool applyRemoteEnemyEncounterState(Int[] words) {
        if (!started || !validEnemyEncounterStateMessage(words) ||
            enemyEncounterStateSequence(words) <=
                clientRemoteEnemyEncounterSequenceValue ||
            enemyEncounterStateEnemyCount(words) >
                clientRemoteEnemyIds.length) {
            return false
        }
        clientRemoteEnemyEncounterSequenceValue =
            enemyEncounterStateSequence(words)
        clientRemoteEncounterIdValue =
            enemyEncounterStateEncounterId(words)
        clientRemoteEncounterActiveCountValue =
            enemyEncounterStateActiveCount(words)
        clientRemoteEncounterRemainingBudgetValue =
            enemyEncounterStateRemainingBudget(words)
        clientRemoteEnemyCountValue =
            enemyEncounterStateEnemyCount(words)
        for (var index = 0;
            index < clientRemoteEnemyIds.length;
            index = index + 1) {
            clientRemoteEnemyIds[index] = 0
            clientRemoteEnemyRoles[index] = 0
            clientRemoteEnemyStates[index] = 0
            clientRemoteEnemyTargets[index] = 0
            clientRemoteEnemyHealthValues[index] = 0
            clientRemoteEnemyPositionsX[index] = 0
            clientRemoteEnemyPositionsY[index] = 0
            clientRemoteEnemyPositionsZ[index] = 0
            if (index < clientRemoteEnemyCountValue) {
                var offset = enemyEncounterStateEntriesOffset() +
                    index * enemyEncounterStateEntryWidth()
                clientRemoteEnemyIds[index] = words[offset]
                clientRemoteEnemyRoles[index] = words[offset + 1]
                clientRemoteEnemyStates[index] = words[offset + 2]
                clientRemoteEnemyTargets[index] = words[offset + 3]
                clientRemoteEnemyHealthValues[index] = words[offset + 4]
                clientRemoteEnemyPositionsX[index] = words[offset + 5]
                clientRemoteEnemyPositionsY[index] = words[offset + 6]
                clientRemoteEnemyPositionsZ[index] = words[offset + 7]
            }
        }
        var impact = enemyEncounterStateImpact(words)
        if (impact.sequence() > clientRemoteImpactSequenceValue) {
            clientRemoteImpactSequenceValue = impact.sequence()
            if (pushImpactPresentation(
                    impact.kind(), impact.sourceId(), impact.targetId(),
                    impact.x(), impact.y(), impact.z(),
                    impact.applied(), impact.died(),
                    impact.clip(), impact.gain())) {
                var died = 0
                if (impact.died()) {
                    died = 1
                }
                recordReplayPresentation(
                    words[2], 3, impact.sequence(),
                    impact.sourceId(), impact.targetId(),
                    impact.x(), impact.y(), impact.z(),
                    impact.applied(), impact.clip(), impact.gain(), died)
            }
        }
        return true
    }

    Int[] multiplayerFeedbackStateMessage(Int tick) {
        if (!started || tick < 0 || tick > 1000000 ||
            tick != serverTick ||
            feedbackStateSequenceValue >= 1000000) {
            return new Int[0]
        }
        var count = feedbackHistory.size()
        if (count > maximumMultiplayerFeedbackEvents()) {
            count = maximumMultiplayerFeedbackEvents()
        }
        feedbackStateSequenceValue = feedbackStateSequenceValue + 1
        var message = newMultiplayerFeedbackMessage(
            tick, feedbackStateSequenceValue, count)
        var start = feedbackHistory.size() - count
        for (var index = 0; index < count; index = index + 1) {
            if (!setMultiplayerFeedbackEvent(
                    message, index,
                    feedbackHistory.at(start + index))) {
                return new Int[0]
            }
        }
        if (!sealMultiplayerFeedbackMessage(message)) {
            return new Int[0]
        }
        return message
    }

    Bool applyRemoteMultiplayerFeedback(Int[] words) {
        if (!started || !clientRemoteBaselineReadyValue ||
            !validMultiplayerFeedbackMessage(words) ||
            multiplayerFeedbackStateSequence(words) <=
                clientRemoteFeedbackStateSequenceValue) {
            return false
        }
        var expected = clientRemoteImpactSequenceValue
        for (var index = 0;
            index < multiplayerFeedbackEventCount(words);
            index = index + 1) {
            var event = multiplayerFeedbackEventAt(words, index)
            if (event.sequence() > expected) {
                if (expected > 0 &&
                    event.sequence() != expected + 1) {
                    return false
                }
                expected = event.sequence()
            }
        }
        clientRemoteFeedbackStateSequenceValue =
            multiplayerFeedbackStateSequence(words)
        for (var index = 0;
            index < multiplayerFeedbackEventCount(words);
            index = index + 1) {
            var event = multiplayerFeedbackEventAt(words, index)
            if (event.sequence() <=
                clientRemoteImpactSequenceValue) {
                continue
            }
            clientRemoteImpactSequenceValue = event.sequence()
            if (pushImpactPresentation(
                    event.kind(), event.sourceId(), event.targetId(),
                    event.x(), event.y(), event.z(),
                    event.applied(), event.died(),
                    event.clip(), event.gain())) {
                var died = 0
                if (event.died()) {
                    died = 1
                }
                recordReplayPresentation(
                    words[2], 3, event.sequence(),
                    event.sourceId(), event.targetId(),
                    event.x(), event.y(), event.z(),
                    event.applied(), event.clip(), event.gain(), died)
            }
        }
        return true
    }

    Int clientRemoteEnemyIndex(Int enemyId) {
        for (var index = 0;
            index < clientRemoteEnemyCountValue;
            index = index + 1) {
            if (clientRemoteEnemyIds[index] == enemyId) {
                return index
            }
        }
        return -1
    }

