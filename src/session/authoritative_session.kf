    Int interpolatedRemotePlayerPosition(Int player, Int renderTick) {
        if (!clientRemoteBaselineReadyValue || renderTick < 0) {
            return -1000001
        }
        if (player == 1) {
            return clientRemotePlayerOneSnapshots.sample(renderTick)
        }
        if (player == 2) {
            return clientRemotePlayerTwoSnapshots.sample(renderTick)
        }
        return -1000001
    }

