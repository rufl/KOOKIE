package session

import core

class LoopbackSession {
    FixedStepClock clock
    InputCommandBuffer playerOneInputs
    InputCommandBuffer playerTwoInputs
    InputEdgeState playerOneEdges
    InputEdgeState playerTwoEdges
    MovementComponent serverMovement
    MovementComponent clientMovement
    Bool playerOneConnected
    Bool playerTwoConnected
    Int serverTick
    Int clientTick
    Int snapshotSequence
    Bool started
    ClientPredictionState playerOnePrediction
    ClientPredictionState playerTwoPrediction
    SnapshotHistory playerOneSnapshots
    SnapshotHistory playerTwoSnapshots


    public constructor(Int inputCapacity, Int entityCapacity) {
        clock = FixedStepClock(60, 4)
        playerOneInputs = InputCommandBuffer(inputCapacity)
        playerTwoInputs = InputCommandBuffer(inputCapacity)
        playerOneEdges = InputEdgeState()
        playerTwoEdges = InputEdgeState()
        serverMovement = MovementComponent(entityCapacity, 4)
        clientMovement = MovementComponent(entityCapacity, 4)
        playerOneConnected = false
        playerTwoConnected = false
        serverTick = 0
        clientTick = 0
        snapshotSequence = 0
        started = false
        playerOnePrediction = ClientPredictionState(4)
        playerTwoPrediction = ClientPredictionState(4)
        playerOneSnapshots = SnapshotHistory(8)
        playerTwoSnapshots = SnapshotHistory(8)
    }

    Bool start() {
        if (started) {
            return false
        }
        started = true
        return true
    }

    Int connectPlayer() {
        if (!started) {
            return 0
        }
        if (!playerOneConnected) {
            playerOneConnected = serverMovement.add(1, 0) && clientMovement.add(1, 0)
            if (playerOneConnected) {
                return 1
            }
            return 0
        }
        if (!playerTwoConnected) {
            playerTwoConnected = serverMovement.add(2, 0) && clientMovement.add(2, 0)
            if (playerTwoConnected) {
                return 2
            }
        }
        return 0
    }

    Bool receiveInput(
        Int player, Int tick, Int sequence, Int moveX, Int moveY,
        Int lookX, Int lookY, Int fire, Int jump
    ) {
        if (!started) {
            return false
        }
        var command = InputCommand(tick, sequence, moveX, moveY, lookX, lookY, fire, jump)
        if (player == 1 && playerOneConnected) {
            return playerOneInputs.queue(command)
        }
        if (player == 2 && playerTwoConnected) {
            return playerTwoInputs.queue(command)
        }
        return false
    }

    Int advance(Int elapsedMicros) {
        if (!started) {
            return -1
        }
        var steps = clock.advance(elapsedMicros)
        if (steps < 0) {
            return -1
        }
        for (var step = 0; step < steps; step = step + 1) {
            if (playerOneConnected && playerOneInputs.queuedCount() > 0 && playerOneInputs.nextTick() <= clock.tick()) {
                playerOneInputs.dequeue()
                var commandOne = playerOneInputs.lastConsumed()
                playerOneEdges.apply(commandOne.fire(), commandOne.jump())
                serverMovement.applyInput(1, commandOne.moveX())
            }
            if (playerTwoConnected && playerTwoInputs.queuedCount() > 0 && playerTwoInputs.nextTick() <= clock.tick()) {
                playerTwoInputs.dequeue()
                var commandTwo = playerTwoInputs.lastConsumed()
                playerTwoEdges.apply(commandTwo.fire(), commandTwo.jump())
                serverMovement.applyInput(2, commandTwo.moveX())
            }
        }
        serverTick = clock.tick()
        if (steps > 0) {
            snapshotSequence = snapshotSequence + 1
            if (playerOneConnected) {
                var playerOnePosition = serverMovement.position(1)
                playerOneSnapshots.push(snapshotSequence, serverTick, playerOnePosition)
                playerOnePrediction.reconcile(playerOnePosition, serverTick)
                clientMovement.setPosition(1, playerOnePrediction.predicted())
            }
            if (playerTwoConnected) {
                var playerTwoPosition = serverMovement.position(2)
                playerTwoSnapshots.push(snapshotSequence, serverTick, playerTwoPosition)
                playerTwoPrediction.reconcile(playerTwoPosition, serverTick)
                clientMovement.setPosition(2, playerTwoPrediction.predicted())
            }
            clientTick = serverTick
        }
        return steps
    }
    Bool applySnapshot(Int sequence, Int tick, Int player, Int position) {
        if (!started || sequence <= snapshotSequence || tick < clientTick) {
            return false
        }
        if (player == 1 && playerOneConnected) {
            if (!clientMovement.setPosition(1, position) ||
                !playerOneSnapshots.push(sequence, tick, position) ||
                !playerOnePrediction.reconcile(position, tick)) {
                return false
            }
        } else if (player == 2 && playerTwoConnected) {
            if (!clientMovement.setPosition(2, position) ||
                !playerTwoSnapshots.push(sequence, tick, position) ||
                !playerTwoPrediction.reconcile(position, tick)) {
                return false
            }
        } else {
            return false
        }
        snapshotSequence = sequence
        clientTick = tick
        return true
    }

    Bool predictClientInput(Int player, Int requestedStep) {
        if (!started) {
            return false
        }
        if (player == 1 && playerOneConnected) {
            if (!playerOnePrediction.predict(requestedStep)) {
                return false
            }
            return clientMovement.setPosition(1, playerOnePrediction.predicted())
        }
        if (player == 2 && playerTwoConnected) {
            if (!playerTwoPrediction.predict(requestedStep)) {
                return false
            }
            return clientMovement.setPosition(2, playerTwoPrediction.predicted())
        }
        return false
    }

    Int predictedPosition(Int player) {
        if (player == 1) {
            return playerOnePrediction.predicted()
        }
        return playerTwoPrediction.predicted()
    }

    InterpolatedPosition interpolatedPosition(Int player, Int renderTick) {
        if (player == 1) {
            return playerOneSnapshots.interpolate(renderTick)
        }
        return playerTwoSnapshots.interpolate(renderTick)
    }

    Int snapshotCount(Int player) {
        if (player == 1) {
            return playerOneSnapshots.size()
        }
        return playerTwoSnapshots.size()
    }


    Int playerCount() {
        var count = 0
        if (playerOneConnected) {
            count = count + 1
        }
        if (playerTwoConnected) {
            count = count + 1
        }
        return count
    }

    Int serverPosition(Int player) {
        return serverMovement.position(player)
    }

    Int clientPosition(Int player) {
        return clientMovement.position(player)
    }

    Int currentServerTick() {
        return serverTick
    }

    Int currentClientTick() {
        return clientTick
    }

    Int latestSnapshotSequence() {
        return snapshotSequence
    }

    Bool inSync() {
        var synced = serverTick == clientTick
        if (playerOneConnected) {
            synced = synced && serverPosition(1) == clientPosition(1)
        }
        if (playerTwoConnected) {
            synced = synced && serverPosition(2) == clientPosition(2)
        }
        return synced
    }

    InputEdges lastInputEdges(Int player) {
        if (player == 1) {
            return playerOneEdges.lastEdges()
        }
        return playerTwoEdges.lastEdges()
    }
}
