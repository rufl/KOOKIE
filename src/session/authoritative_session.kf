package session

import core

class LoopbackSession {
    FixedStepClock clock
    InputCommandBuffer playerOneInputs
    InputCommandBuffer playerTwoInputs
    InputEdgeState playerOneEdges
    InputEdgeState playerTwoEdges
    CombatWorld playerCombat
    BoundedRayTargetWorld playerSpatialTargets
    PlayerWeaponPresenter playerWeaponPresentations
    BoundedReplayPresentationHistory replayPresentationHistory
    BoundedInteractionWorld worldInteractions
    InteractionReplayRecorder interactionReplay
    Int[] interactionSequences
    Int[] interactionTicks
    Int[] interactionTargets
    Int[] interactionResultTicks
    Int[] interactionResultTargets
    Bool[] interactionResults
    Bool[] clientInteractionFlags
    Int clientInteractionRevisionValue
    Int clientSecretCountValue
    Bool clientLevelCompletedValue
    BoundedSkillDefinitionStore playerSkillDefinitions
    BoundedSkillProgression playerOneSkills
    BoundedSkillProgression playerTwoSkills
    Int playerOneSkillResource
    Int playerTwoSkillResource
    BoundedStatusDefinitionStore playerStatusDefinitions
    BoundedStatusEffects playerOneStatuses
    BoundedStatusEffects playerTwoStatuses
    BoundedItemInventory playerOneInventory
    BoundedItemInventory playerTwoInventory
    BoundedEquipmentLoadout playerOneEquipment
    BoundedEquipmentLoadout playerTwoEquipment
    InputReplayRecorder playerOneReplay
    InputReplayRecorder playerTwoReplay
    MovementComponent serverMovement
    MovementComponent clientMovement
    Bool playerOneConnected
    Bool playerOneFocused
    Bool playerTwoFocused
    Bool playerTwoConnected
    Int serverTick
    Int clientTick
    Int snapshotSequence
    Bool started
    Bool paused
    Bool inputReplayEnabled
    ClientPredictionState playerOnePrediction
    ClientPredictionState playerTwoPrediction
    SnapshotHistory playerOneSnapshots
    SnapshotHistory playerTwoSnapshots
    BoundedTriangleCollection broadPhaseCollection
    BoundedTriangleCollection clientBroadPhaseCollection
    Int clientBroadPhaseSnapshotSequence
    BroadPhaseTransportQueue broadPhaseTransport
    Int broadPhaseRevisionValue
    Int clientBroadPhaseRevisionValue
    RemoteSessionEndpoint remoteEndpoint
    RemoteSessionLink remoteLink
    Bool remoteConfigured
    Int remoteSendSequenceValue
    AuthoritativeEnemySession enemyCombat
    EnemySnapshotHistory enemyServerSnapshots
    EnemySnapshotHistory enemyClientSnapshots
    EnemyImpactSnapshotHistory enemyServerImpactSnapshots
    EnemyImpactSnapshotHistory enemyClientImpactSnapshots
    ImpactPresentationQueue enemyImpactPresentations
    QueuedAudio enemyImpactAudio
    Int enemyImpactSnapshotSequence
    Int clientEnemyImpactSnapshotSequence
    Int[] enemyIds
    Int[] enemyPerceptionTargets
    Int[] enemyPerceptionDistances
    Int[] enemyPerceptionCriticals
    Bool[] enemyPerceptionVisible
    Bool[] enemyPerceptionActive
    Bool[] enemySpatialPerceptionActive
    Int enemyCount
    Int enemySnapshotSequence
    Int clientEnemySnapshotSequence
    EnemyAttackDecision lastEnemyDecision


    public constructor(Int inputCapacity, Int entityCapacity) {
        clock = FixedStepClock(60, 4)
        playerOneInputs = InputCommandBuffer(inputCapacity)
        playerTwoInputs = InputCommandBuffer(inputCapacity)
        playerOneEdges = InputEdgeState()
        playerTwoEdges = InputEdgeState()
        serverMovement = MovementComponent(entityCapacity, 4)
        clientMovement = MovementComponent(entityCapacity, 4)
        playerOneConnected = false
        playerOneFocused = false
        playerTwoFocused = false
        playerTwoConnected = false
        serverTick = 0
        clientTick = 0
        snapshotSequence = 0
        paused = false
        playerOneReplay = InputReplayRecorder(256)
        playerTwoReplay = InputReplayRecorder(256)
        inputReplayEnabled = false
        started = false
        playerOnePrediction = ClientPredictionState(4)
        playerTwoPrediction = ClientPredictionState(4)
        playerOneSnapshots = SnapshotHistory(8)
        playerTwoSnapshots = SnapshotHistory(8)
        broadPhaseCollection = BoundedTriangleCollection(8, 20)
        broadPhaseCollection.configureBounds(0, 0, 0, 10, 10, 10)
        enemyCombat = AuthoritativeEnemySession(entityCapacity, entityCapacity)
        enemyServerSnapshots = EnemySnapshotHistory(entityCapacity * 8)
        enemyClientSnapshots = EnemySnapshotHistory(entityCapacity * 8)
        enemyServerImpactSnapshots = EnemyImpactSnapshotHistory(entityCapacity * 8)
        enemyClientImpactSnapshots = EnemyImpactSnapshotHistory(entityCapacity * 8)
        enemyImpactPresentations = ImpactPresentationQueue(entityCapacity * 2)
        enemyImpactAudio = QueuedAudio(entityCapacity * 2)
        playerCombat = CombatWorld(entityCapacity, entityCapacity)
        playerSpatialTargets = BoundedRayTargetWorld(entityCapacity, 1000000)
        playerWeaponPresentations = PlayerWeaponPresenter(entityCapacity * 2)
        replayPresentationHistory = BoundedReplayPresentationHistory(entityCapacity * 8)
        worldInteractions = BoundedInteractionWorld(16, 1000000)
        interactionReplay = InteractionReplayRecorder(64)
        interactionSequences = new Int[3]
        interactionTicks = new Int[3]
        interactionTargets = new Int[3]
        interactionResultTicks = new Int[3]
        interactionResultTargets = new Int[3]
        interactionResults = new Bool[3]
        clientInteractionFlags = new Bool[16]
        // Native array storage may be reused; initialize every observable slot.
        for (var player = 0; player < 3; player = player + 1) {
            interactionSequences[player] = 0
            interactionTicks[player] = 0
            interactionTargets[player] = 0
            interactionResultTicks[player] = 0
            interactionResultTargets[player] = 0
            interactionResults[player] = false
        }
        for (var index = 0; index < clientInteractionFlags.length; index = index + 1) {
            clientInteractionFlags[index] = false
        }
        clientInteractionRevisionValue = 0
        clientSecretCountValue = 0
        clientLevelCompletedValue = false
        playerSkillDefinitions = BoundedSkillDefinitionStore(16)
        playerOneSkills = BoundedSkillProgression(4)
        playerTwoSkills = BoundedSkillProgression(4)
        playerOneSkillResource = 100
        playerOneInventory = BoundedItemInventory(1, 8)
        playerTwoInventory = BoundedItemInventory(2, 8)
        playerOneEquipment = BoundedEquipmentLoadout(4)
        playerTwoEquipment = BoundedEquipmentLoadout(4)
        playerTwoSkillResource = 100
        playerStatusDefinitions = BoundedStatusDefinitionStore(16)
        playerOneStatuses = BoundedStatusEffects(4)
        playerTwoStatuses = BoundedStatusEffects(4)
        enemyImpactAudio.open()
        enemyImpactSnapshotSequence = 0
        clientEnemyImpactSnapshotSequence = 0
        enemyIds = new Int[entityCapacity]
        enemyPerceptionTargets = new Int[entityCapacity]
        enemyPerceptionDistances = new Int[entityCapacity]
        enemyPerceptionCriticals = new Int[entityCapacity]
        enemyPerceptionVisible = new Bool[entityCapacity]
        enemyPerceptionActive = new Bool[entityCapacity]
        enemySpatialPerceptionActive = new Bool[entityCapacity]
        enemyCount = 0
        enemySnapshotSequence = 0
        clientEnemySnapshotSequence = 0
        lastEnemyDecision = EnemyAttackDecision(
            false, 0, 0, 0, false, 0, 0, false)
        for (var index = 0; index < entityCapacity; index = index + 1) {
            enemyIds[index] = 0
            enemyPerceptionTargets[index] = 0
            enemyPerceptionDistances[index] = 0
            enemyPerceptionCriticals[index] = 0
            enemyPerceptionVisible[index] = false
            enemyPerceptionActive[index] = false
            enemySpatialPerceptionActive[index] = false
        }
        clientBroadPhaseCollection = BoundedTriangleCollection(8, 20)
        clientBroadPhaseCollection.configureBounds(0, 0, 0, 10, 10, 10)
        broadPhaseTransport = BroadPhaseTransportQueue(4, 8)
        remoteEndpoint = RemoteSessionEndpoint(
            127, 0, 0, 1, 1, 1, 2, 3, 4)
        remoteLink = RemoteSessionLink(remoteEndpoint)
        remoteConfigured = false
        remoteSendSequenceValue = 0
        clientBroadPhaseSnapshotSequence = 0
        broadPhaseRevisionValue = broadPhaseCollection.geometryRevision()
        clientBroadPhaseRevisionValue = broadPhaseRevisionValue
    }

    Bool start() {
        if (started || !worldInteractions.seal()) {
            return false
        }
        started = true
        return true
    }

    Int connectPlayer() {
        if (!started) {
            return 0
        }
        if (!playerOneConnected) {
            var positionOne = serverMovement.position(1)
            playerOneConnected = serverMovement.setPosition(1, positionOne) &&
                clientMovement.setPosition(1, positionOne) &&
                playerOnePrediction.restore(positionOne, serverTick) &&
                playerOneSnapshots.reset()
            if (playerOneConnected) {
                playerOneFocused = true
                return 1
            }
            return 0
        }
        if (!playerTwoConnected) {
            var positionTwo = serverMovement.position(2)
            playerTwoConnected = serverMovement.setPosition(2, positionTwo) &&
                clientMovement.setPosition(2, positionTwo) &&
                playerTwoPrediction.restore(positionTwo, serverTick) &&
                playerTwoSnapshots.reset()
            if (playerTwoConnected) {
                playerTwoFocused = true
                return 2
            }
        }
        return 0
    }

    Bool disconnectPlayer(Int player) {
        if (!started || (player != 1 && player != 2)) {
            return false
        }
        if (player == 1 && playerOneConnected) {
            playerOneConnected = false
            playerOneFocused = false
            playerOneInputs.clearPending()
            playerOneEdges.clearHeld()
            interactionTargets[1] = 0
            interactionTicks[1] = 0
            return true
        }
        if (player == 2 && playerTwoConnected) {
            playerTwoConnected = false
            playerTwoFocused = false
            playerTwoInputs.clearPending()
            playerTwoEdges.clearHeld()
            interactionTargets[2] = 0
            interactionTicks[2] = 0
            return true
        }
        return false
    }

    Bool defineWorldKey(Int id, Int x, Int y, Int z, Int range) {
        return !started && worldInteractions.defineKey(id, x, y, z, range)
    }

    Bool defineWorldDoor(Int id, Int keyId, Int x, Int y, Int z, Int range) {
        return !started && worldInteractions.defineDoor(id, keyId, x, y, z, range)
    }

    Bool defineWorldSecret(Int id, Int x, Int y, Int z, Int range) {
        return !started && worldInteractions.defineSecret(id, x, y, z, range)
    }

    Bool defineWorldExit(
        Int id, Int doorId, Int requiredSecrets, Int x, Int y, Int z, Int range
    ) {
        return !started && worldInteractions.defineExit(
            id, doorId, requiredSecrets, x, y, z, range)
    }

    Bool receiveInteraction(Int player, Int tick, Int sequence, Int targetId) {
        if (!started || paused || player < 1 || player > 2 ||
            tick <= serverTick || tick > 1000000 || tick - serverTick > 4 ||
            sequence <= interactionSequences[player] || sequence > 1000000 ||
            interactionTargets[player] != 0 || worldInteractions.kind(targetId) == 0 ||
            worldInteractions.completed() || !playerFocused(player)) {
            return false
        }
        if (inputReplayEnabled) {
            var reserved = interactionReplay.count()
            for (var pendingPlayer = 1; pendingPlayer <= 2; pendingPlayer = pendingPlayer + 1) {
                if (interactionTargets[pendingPlayer] != 0) {
                    reserved = reserved + 1
                }
            }
            if (reserved >= interactionReplay.capacity()) {
                return false
            }
        }
        interactionSequences[player] = sequence
        interactionTicks[player] = tick
        interactionTargets[player] = targetId
        return true
    }

    Bool consumeWorldInteractions(Int tick) {
        for (var player = 1; player <= 2; player = player + 1) {
            if (interactionTargets[player] != 0 && interactionTicks[player] <= tick) {
                if (inputReplayEnabled && !interactionReplay.append(
                    tick, player, interactionSequences[player], interactionTargets[player])) {
                    return false
                }
                interactionResultTargets[player] = interactionTargets[player]
                interactionResultTicks[player] = tick
                interactionResults[player] = worldInteractions.interact(
                    interactionTargets[player], serverMovement.position(player), 0, 0)
                interactionTargets[player] = 0
                interactionTicks[player] = 0
            }
        }
        return true
    }

    Bool publishWorldInteractions() {
        for (var index = 0; index < clientInteractionFlags.length; index = index + 1) {
            clientInteractionFlags[index] = worldInteractions.activated(worldInteractions.idAt(index))
        }
        clientInteractionRevisionValue = worldInteractions.revision()
        clientSecretCountValue = worldInteractions.secretCount()
        clientLevelCompletedValue = worldInteractions.completed()
        return true
    }

    Bool worldInteractionActive(Int id) {
        return worldInteractions.activated(id)
    }

    Bool clientWorldInteractionActive(Int id) {
        if (id <= 0) {
            return false
        }
        for (var index = 0; index < worldInteractions.size(); index = index + 1) {
            if (worldInteractions.idAt(index) == id) {
                return clientInteractionFlags[index]
            }
        }
        return false
    }

    Int worldInteractionRevision() {
        return worldInteractions.revision()
    }

    Int clientWorldInteractionRevision() {
        return clientInteractionRevisionValue
    }

    Int worldSecretCount() {
        return worldInteractions.secretCount()
    }

    Int clientWorldSecretCount() {
        return clientSecretCountValue
    }

    Bool levelCompleted() {
        return worldInteractions.completed()
    }

    Bool clientLevelCompleted() {
        return clientLevelCompletedValue
    }


    Bool stageWorldInteractionGeometry(
        FrameStaging target, Int frame, Int resource
    ) {
        if (!started || resource <= 0 || !target.begin(frame)) {
            return false
        }
        for (var index = 0; index < worldInteractions.size(); index = index + 1) {
            var id = worldInteractions.idAt(index)
            if (worldInteractions.kind(id) != 2) {
                continue
            }
            var x = worldInteractions.positionX(id)
            var y = worldInteractions.positionY(id)
            var active = 0
            if (clientInteractionFlags[index]) {
                active = 100
            }
            if (!target.pushVertex(resource, x - 1, y - 1, active, 0) ||
                !target.pushVertex(resource, x + 1, y - 1, active, 100) ||
                !target.pushVertex(resource, x + 1, y + 1, active, 100) ||
                !target.pushVertex(resource, x - 1, y - 1, active, 0) ||
                !target.pushVertex(resource, x + 1, y + 1, active, 100) ||
                !target.pushVertex(resource, x - 1, y + 1, active, 0)) {
                target.discard()
                return false
            }
        }
        return target.publish()
    }

    Int worldInteractionRenderVertexCount() {
        return worldInteractions.doorRenderVertexCount()
    }
    Bool lastInteractionAccepted(Int player) {
        return player >= 1 && player <= 2 && interactionResults[player]
    }

    Int lastInteractionTarget(Int player) {
        if (player < 1 || player > 2) {
            return 0
        }
        return interactionResultTargets[player]
    }

    Int lastInteractionTick(Int player) {
        if (player < 1 || player > 2) {
            return 0
        }
        return interactionResultTicks[player]
    }

    Int interactionReplayCount() {
        return interactionReplay.count()
    }

    Bool exportInteractionReplay(BoundedReplayTimeline timeline) {
        return started && timeline.appendInteractions(interactionReplay)
    }

    Bool encodeLevelProgression(
        BoundedSaveSections target, Int levelId, Int contentVersion
    ) {
        return started && worldInteractions.encodeLevelProgression(target, levelId, contentVersion)
    }

    Bool restoreLevelProgression(
        BoundedSaveSections source, Int levelId, Int contentVersion
    ) {
        if (!started || inputReplayEnabled ||
            !worldInteractions.restoreLevelProgression(source, levelId, contentVersion)) {
            return false
        }
        for (var player = 1; player <= 2; player = player + 1) {
            interactionTicks[player] = 0
            interactionTargets[player] = 0
            interactionResultTicks[player] = 0
            interactionResultTargets[player] = 0
            interactionResults[player] = false
        }
        interactionReplay.reset()
        return publishWorldInteractions()
    }

