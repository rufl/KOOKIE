        return worldInteractions.activated(id)
    }

    Bool clientWorldInteractionActive(Int id) {
        if (id <= 0) {
            return false
        }
        for (var index = 0; index < worldInteractions.size(); index = index + 1) {
            if (worldInteractions.idAt(index) == id) {
                return clientInteractionFlags[index]
            }
        }
        return false
    }

