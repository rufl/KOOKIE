package ui

Int kutterLevelToolSelect() { return 1 }
Int kutterLevelToolProp() { return 2 }
Int kutterLevelToolPlayerSpawn() { return 3 }
Int kutterLevelToolEnemySpawn() { return 4 }
Int kutterLevelToolEncounter() { return 5 }
Int kutterLevelToolTrigger() { return 6 }
Int kutterLevelToolLight() { return 7 }
Int kutterLevelToolErase() { return 8 }
Int kutterLevelToolCount() { return 8 }
Int kutterLevelNodeGroup() { return 9 }

Int kutterLevelGridSmall() { return 25 }
Int kutterLevelGridMedium() { return 100 }
Int kutterLevelGridLarge() { return 250 }
Int kutterLevelHistoryCapacity() { return 16 }

Int kutterLevelIssueMissingPlayer() { return 1 }
Int kutterLevelIssueMultiplePlayers() { return 2 }
Int kutterLevelIssueMissingGoal() { return 4 }

class BoundedKutterLevelEditor {
    BoundedKutterStudio documentValue
    Int snapshotStrideValue
    Int[] undoSnapshots
    Int[] redoSnapshots
    Int undoCountValue
    Int redoCountValue
    Int toolValue
    Int selectedNodeValue
    Int cursorXValue
    Int cursorZValue
    Int gridSizeValue
    Bool previewActiveValue

    public constructor() {
        documentValue = BoundedKutterStudio(
            kutterStudioNodeCapacity(), kutterStudioAssetCapacity())
        documentValue.configure(1, 1, 1)
        documentValue.addNode(
            1, 0, kutterLevelToolPlayerSpawn(), 0, 0, 0, 0, 1000)
        documentValue.seal()
        snapshotStrideValue = documentValue.wire.length
        undoSnapshots = new Int[
            snapshotStrideValue * kutterLevelHistoryCapacity()]
        redoSnapshots = new Int[
            snapshotStrideValue * kutterLevelHistoryCapacity()]
        undoCountValue = 0
        redoCountValue = 0
        toolValue = kutterLevelToolSelect()
        selectedNodeValue = 1
        cursorXValue = 0
        cursorZValue = 0
        gridSizeValue = kutterLevelGridMedium()
        previewActiveValue = false
    }

    Int absolute(Int value) {
        if (value < 0) { return -value }
        return value
    }

    Int snapValue(Int value) {
        var grid = gridSizeValue
        if (grid <= 0) { grid = kutterLevelGridMedium() }
        if (value >= 0) {
            return ((value + grid / 2) / grid) * grid
        }
        return ((value - grid / 2) / grid) * grid
    }

    Int snapshotOffset(Int slot) { return slot * snapshotStrideValue }

    void copySnapshot(
        Int[] source, Int sourceSlot, Int[] target, Int targetSlot
    ) {
        var sourceOffset = snapshotOffset(sourceSlot)
        var targetOffset = snapshotOffset(targetSlot)
        for (var index = 0; index < snapshotStrideValue; index = index + 1) {
            target[targetOffset + index] = source[sourceOffset + index]
        }
    }

    void shiftSnapshots(Int[] snapshots) {
        for (var slot = 1; slot < kutterLevelHistoryCapacity(); slot = slot + 1) {
            copySnapshot(snapshots, slot, snapshots, slot - 1)
        }
    }

    Bool recordSnapshot(Int[] snapshots, Int slot) {
        if (!documentValue.validate() || !documentValue.encode()) { return false }
        var offset = snapshotOffset(slot)
        for (var index = 0; index < snapshotStrideValue; index = index + 1) {
            snapshots[offset + index] = documentValue.wire[index]
        }
        return true
    }

    Bool pushUndoSnapshot() {
        var slot = undoCountValue
        if (slot >= kutterLevelHistoryCapacity()) {
            shiftSnapshots(undoSnapshots)
            slot = kutterLevelHistoryCapacity() - 1
            undoCountValue = slot
        }
        if (!recordSnapshot(undoSnapshots, slot)) { return false }
        undoCountValue = undoCountValue + 1
        redoCountValue = 0
        return true
    }
    Bool pushUndoSnapshotPreservingRedo() {
        var slot = undoCountValue
        if (slot >= kutterLevelHistoryCapacity()) {
            shiftSnapshots(undoSnapshots)
            slot = kutterLevelHistoryCapacity() - 1
            undoCountValue = slot
        }
        if (!recordSnapshot(undoSnapshots, slot)) { return false }
        undoCountValue = undoCountValue + 1
        return true
    }


    Bool pushRedoSnapshot() {
        var slot = redoCountValue
        if (slot >= kutterLevelHistoryCapacity()) {
            shiftSnapshots(redoSnapshots)
            slot = kutterLevelHistoryCapacity() - 1
            redoCountValue = slot
        }
        if (!recordSnapshot(redoSnapshots, slot)) { return false }
        redoCountValue = redoCountValue + 1
        return true
    }

    Bool restoreSnapshot(Int[] snapshots, Int slot) {
        var offset = snapshotOffset(slot)
        var wordCount = snapshots[offset + 2]
        if (wordCount < 11 || wordCount > snapshotStrideValue) { return false }
        var words = new Int[wordCount]
        for (var index = 0; index < wordCount; index = index + 1) {
            words[index] = snapshots[offset + index]
        }
        return documentValue.decode(words)
    }

    Bool beginMutation() {
        if (!documentValue.validate() || !pushUndoSnapshot() ||
            !documentValue.beginEdit()) {
            return false
        }
        return true
    }

    Bool finishMutation(Bool accepted) {
        if (!accepted || !documentValue.seal()) {
            documentValue.seal()
            if (undoCountValue > 0) { undoCountValue = undoCountValue - 1 }
            return false
        }
        selectedNodeValue = if (documentValue.nodeIndex(selectedNodeValue) >= 0)
            selectedNodeValue else 0
        return true
    }

    Int nextNodeId() {
        if (documentValue.nodeCount() <= 0) { return 1 }
        return documentValue.nodeId(documentValue.nodeCount() - 1) + 1
    }

    Bool cycleTool(Int direction) {
        if (direction != -1 && direction != 1) { return false }
        toolValue = toolValue + direction
        if (toolValue < kutterLevelToolSelect()) {
            toolValue = kutterLevelToolCount()
        }
        if (toolValue > kutterLevelToolCount()) {
            toolValue = kutterLevelToolSelect()
        }
        return true
    }

    Bool selectTool(Int tool) {
        if (tool < kutterLevelToolSelect() ||
            tool > kutterLevelToolCount()) { return false }
        toolValue = tool
        return true
    }

    Bool cycleGrid(Int direction) {
        if (direction != -1 && direction != 1) { return false }
        if (gridSizeValue == kutterLevelGridSmall()) {
            gridSizeValue = if (direction > 0)
                kutterLevelGridMedium() else kutterLevelGridLarge()
        } else if (gridSizeValue == kutterLevelGridMedium()) {
            gridSizeValue = if (direction > 0)
                kutterLevelGridLarge() else kutterLevelGridSmall()
        } else {
            gridSizeValue = if (direction > 0)
                kutterLevelGridSmall() else kutterLevelGridMedium()
        }
        cursorXValue = snapValue(cursorXValue)
        cursorZValue = snapValue(cursorZValue)
        return true
    }

    Bool setGridSize(Int size) {
        if (size != kutterLevelGridSmall() &&
            size != kutterLevelGridMedium() &&
            size != kutterLevelGridLarge()) { return false }
        gridSizeValue = size
        cursorXValue = snapValue(cursorXValue)
        cursorZValue = snapValue(cursorZValue)
        return true
    }

    Bool moveCursor(Int axis, Int direction) {
        if ((axis != 0 && axis != 1) ||
            (direction != -1 && direction != 1)) { return false }
        var next = if (axis == 0) cursorXValue else cursorZValue
        next = next + direction * gridSizeValue
        if (next < -1000000) { next = -1000000 }
        if (next > 1000000) { next = 1000000 }
        if (axis == 0) {
            cursorXValue = snapValue(next)
        } else {
            cursorZValue = snapValue(next)
        }
        return true
    }

    Bool setCursor(Int x, Int z) {
        if (x < -1000000 || x > 1000000 ||
            z < -1000000 || z > 1000000) { return false }
        cursorXValue = snapValue(x)
        cursorZValue = snapValue(z)
        return true
    }

    Bool selectAtCursor() {
        var bestNode = 0
        var bestDistance = 2000000000
        for (var index = 0; index < documentValue.nodeCount(); index = index + 1) {
            var distanceX = absolute(
                documentValue.nodeXValue(index) - cursorXValue)
            var distanceZ = absolute(
                documentValue.nodeZValue(index) - cursorZValue)
            var radiusX = documentValue.nodeScaleXValue(index) / 20
            var radiusZ = documentValue.nodeScaleZValue(index) / 20
            var minimumRadius = gridSizeValue / 2
            if (radiusX < minimumRadius) { radiusX = minimumRadius }
            if (radiusZ < minimumRadius) { radiusZ = minimumRadius }
            if (distanceX <= radiusX && distanceZ <= radiusZ) {
                var distance = distanceX + distanceZ
                if (distance < bestDistance) {
                    bestDistance = distance
                    bestNode = documentValue.nodeId(index)
                }
            }
        }
        if (bestNode <= 0) { return false }
        selectedNodeValue = bestNode
        return true
    }

    Bool addCurrentTool() {
        if (toolValue == kutterLevelToolSelect() ||
            toolValue == kutterLevelToolErase()) { return false }
        if (!beginMutation()) { return false }
        var accepted = documentValue.addNode(
            nextNodeId(), 0, toolValue, cursorXValue, 0, cursorZValue, 0, 1000)
        if (!finishMutation(accepted)) { return false }
        selectedNodeValue = documentValue.nodeId(documentValue.nodeCount() - 1)
        return true
    }
    Bool addAssetAtCursor(Int assetToken) {
        if (assetToken <= 0 || assetToken > 1000000 ||
            !beginMutation()) { return false }
        var nodeId = nextNodeId()
        var accepted = documentValue.addNode(
            nodeId, 0, kutterLevelToolProp(),
            cursorXValue, 0, cursorZValue, 0, 1000) &&
            documentValue.setNodeAssetToken(nodeId, assetToken)
        if (!finishMutation(accepted)) { return false }
        selectedNodeValue = nodeId
        return true
    }
    Bool assignAssetToSelected(Int assetToken) {
        if (assetToken <= 0 || assetToken > 1000000 ||
            selectedNodeValue <= 0) { return false }
        var index = documentValue.nodeIndex(selectedNodeValue)
        if (index < 0 ||
            documentValue.nodeKind(index) != kutterLevelToolProp() ||
            !beginMutation()) { return false }
        return finishMutation(
            documentValue.setNodeAssetToken(selectedNodeValue, assetToken))
    }



    Bool removeSelected() {
        if (selectedNodeValue <= 0 || !beginMutation()) { return false }
        var accepted = true
        var index = documentValue.nodeIndex(selectedNodeValue)
        if (index >= 0 &&
            documentValue.nodeKind(index) == kutterLevelNodeGroup()) {
            while (accepted) {
                var childId = 0
                for (var child = 0;
                     child < documentValue.nodeCount();
                     child = child + 1) {
                    if (documentValue.nodeParent(child) == selectedNodeValue) {
                        childId = documentValue.nodeId(child)
                        break
                    }
                }
                if (childId == 0) { break }
                accepted = documentValue.removeNode(childId)
            }
        }
        if (accepted) {
            accepted = documentValue.removeNode(selectedNodeValue)
        }
        if (!finishMutation(accepted)) { return false }
        selectedNodeValue = 0
        return true
    }

    Bool moveSelectedToCursor() {
        if (selectedNodeValue <= 0) { return false }
        if (!beginMutation()) { return false }
        var index = documentValue.nodeIndex(selectedNodeValue)
        var accepted = index >= 0 && documentValue.moveNode(
            selectedNodeValue, cursorXValue, documentValue.nodeYValue(index), cursorZValue)
        return finishMutation(accepted)
    }

    Bool updateSelectedNode(
        Int x, Int y, Int z, Int rotation,
        Int scaleX, Int scaleY, Int scaleZ, Int color, Int assetToken
    ) {
        if (selectedNodeValue <= 0 || !beginMutation()) { return false }
        var index = documentValue.nodeIndex(selectedNodeValue)
        var accepted = index >= 0 &&
            documentValue.nodeKind(index) != kutterLevelNodeGroup() &&
            documentValue.moveNode(selectedNodeValue, x, y, z) &&
            documentValue.setNodeRotation(selectedNodeValue, rotation) &&
            documentValue.setNodeScale(
                selectedNodeValue, scaleX, scaleY, scaleZ) &&
            documentValue.setNodeColor(selectedNodeValue, color) &&
            documentValue.setNodeAssetToken(selectedNodeValue, assetToken)
        return finishMutation(accepted)
    }
    Bool adjustSelectedHeight(Int direction) {
        if ((direction != -1 && direction != 1) ||
            selectedNodeValue <= 0) { return false }
        var index = documentValue.nodeIndex(selectedNodeValue)
        if (index < 0) { return false }
        var nextY = documentValue.nodeYValue(index) +
            direction * gridSizeValue
        if (nextY < -1000000 || nextY > 1000000 ||
            !beginMutation()) { return false }
        return finishMutation(documentValue.moveNode(
            selectedNodeValue, documentValue.nodeXValue(index), nextY,
            documentValue.nodeZValue(index)))
    }
    Bool duplicateSelected() {
        if (selectedNodeValue <= 0) { return false }
        var sourceIndex = documentValue.nodeIndex(selectedNodeValue)
        if (sourceIndex < 0 ||
            documentValue.nodeKind(sourceIndex) == kutterLevelNodeGroup() ||
            !beginMutation()) { return false }
        var cloneId = nextNodeId()
        var accepted = documentValue.addNode(
            cloneId, 0, documentValue.nodeKind(sourceIndex),
            documentValue.nodeXValue(sourceIndex) + gridSizeValue,
            documentValue.nodeYValue(sourceIndex),
            documentValue.nodeZValue(sourceIndex),
            documentValue.nodeRotationValue(sourceIndex),
            documentValue.nodeScaleXValue(sourceIndex))
        if (accepted) {
            accepted = documentValue.setNodeScale(
                cloneId,
                documentValue.nodeScaleXValue(sourceIndex),
                documentValue.nodeScaleYValue(sourceIndex),
                documentValue.nodeScaleZValue(sourceIndex)) &&
                documentValue.setNodeColor(
                    cloneId, documentValue.nodeColorValue(sourceIndex)) &&
                documentValue.setNodeAssetToken(
                    cloneId, documentValue.nodeAssetToken(sourceIndex))
        }
        if (!finishMutation(accepted)) { return false }
        selectedNodeValue = cloneId
        return true
    }

    Bool rotateSelected(Int direction) {
        if (selectedNodeValue <= 0 ||
            (direction != -1 && direction != 1) ||
            !beginMutation()) { return false }
        var index = documentValue.nodeIndex(selectedNodeValue)
        var accepted = index >= 0 &&
            documentValue.nodeKind(index) != kutterLevelNodeGroup() &&
            documentValue.setNodeRotation(
                selectedNodeValue,
                documentValue.nodeRotationValue(index) + direction * 15000)
        return finishMutation(accepted)
    }

    Bool resizeSelected(Int axis, Int direction) {
        if (selectedNodeValue <= 0 ||
            (axis < 0 || axis > 2) ||
            (direction != -1 && direction != 1)) { return false }
        var index = documentValue.nodeIndex(selectedNodeValue)
        if (index < 0 ||
            documentValue.nodeKind(index) == kutterLevelNodeGroup()) {
            return false
        }
        var scaleX = documentValue.nodeScaleXValue(index)
        var scaleY = documentValue.nodeScaleYValue(index)
        var scaleZ = documentValue.nodeScaleZValue(index)
        if (axis == 0) { scaleX = scaleX + direction * 100 }
        else if (axis == 1) { scaleY = scaleY + direction * 100 }
        else { scaleZ = scaleZ + direction * 100 }
        if (scaleX < 100) { scaleX = 100 }
        if (scaleY < 100) { scaleY = 100 }
        if (scaleZ < 100) { scaleZ = 100 }
        if (scaleX == documentValue.nodeScaleXValue(index) &&
            scaleY == documentValue.nodeScaleYValue(index) &&
            scaleZ == documentValue.nodeScaleZValue(index)) { return false }
        if (!beginMutation()) { return false }
        return finishMutation(documentValue.setNodeScale(
            selectedNodeValue, scaleX, scaleY, scaleZ))
    }

    Bool recolorSelected(Int color) {
        if (selectedNodeValue <= 0 || !beginMutation()) { return false }
        var accepted = documentValue.setNodeColor(selectedNodeValue, color)
        return finishMutation(accepted)
    }

    Bool groupSelectedWith(Int otherNodeId) {
        if (selectedNodeValue <= 0 || otherNodeId <= 0 ||
            selectedNodeValue == otherNodeId) { return false }
        var firstIndex = documentValue.nodeIndex(selectedNodeValue)
        var secondIndex = documentValue.nodeIndex(otherNodeId)
        if (firstIndex < 0 || secondIndex < 0 ||
            documentValue.nodeKind(firstIndex) == kutterLevelNodeGroup() ||
            documentValue.nodeKind(secondIndex) == kutterLevelNodeGroup() ||
            !beginMutation()) { return false }
        var groupId = nextNodeId()
        var accepted = documentValue.addNode(
            groupId, 0, kutterLevelNodeGroup(), 0, 0, 0, 0, 1000) &&
            documentValue.setNodeParent(selectedNodeValue, groupId) &&
            documentValue.setNodeParent(otherNodeId, groupId)
        if (!finishMutation(accepted)) { return false }
        selectedNodeValue = groupId
        return true
    }

    Bool ungroupSelected() {
        if (selectedNodeValue <= 0) { return false }
        var groupId = selectedNodeValue
        var groupIndex = documentValue.nodeIndex(groupId)
        if (groupIndex < 0 ||
            documentValue.nodeKind(groupIndex) != kutterLevelNodeGroup() ||
            !beginMutation()) { return false }
        var accepted = true
        for (var child = 0; child < documentValue.nodeCount(); child = child + 1) {
            if (documentValue.nodeParent(child) == groupId) {
                accepted = documentValue.setNodeParent(
                    documentValue.nodeId(child), 0)
                if (!accepted) { break }
            }
        }
        if (accepted) { accepted = documentValue.removeNode(groupId) }
        if (!finishMutation(accepted)) { return false }
        selectedNodeValue = 0
        return true
    }


    Bool applyTool() {
        if (toolValue == kutterLevelToolSelect()) { return selectAtCursor() }
        if (toolValue == kutterLevelToolErase()) {
            if (selectedNodeValue <= 0 && !selectAtCursor()) { return false }
            return removeSelected()
        }
        return addCurrentTool()
    }

    Bool undo() {
        if (undoCountValue <= 0) { return false }
        if (!pushRedoSnapshot()) { return false }
        var slot = undoCountValue - 1
        if (!restoreSnapshot(undoSnapshots, slot)) { return false }
        undoCountValue = slot
        selectedNodeValue = 0
        return true
    }

    Bool redo() {
        if (redoCountValue <= 0) { return false }
        if (!pushUndoSnapshotPreservingRedo()) { return false }
        var slot = redoCountValue - 1
        if (!restoreSnapshot(redoSnapshots, slot)) { return false }
        redoCountValue = slot
        selectedNodeValue = 0
        return true
    }

    Bool togglePreview() {
        previewActiveValue = !previewActiveValue
        return true
    }

    Int validationMask() {
        var players = 0
        var goals = 0
        for (var index = 0; index < documentValue.nodeCount(); index = index + 1) {
            if (documentValue.nodeKind(index) == kutterLevelToolPlayerSpawn()) {
                players = players + 1
            }
            if (documentValue.nodeKind(index) == kutterLevelToolTrigger()) {
                goals = goals + 1
            }
        }
        var result = 0
        if (players == 0) { result = result + kutterLevelIssueMissingPlayer() }
        if (players > 1) { result = result + kutterLevelIssueMultiplePlayers() }
        if (goals == 0) { result = result + kutterLevelIssueMissingGoal() }
        return result
    }

    Int validationIssueCount() {
        var mask = validationMask()
        var count = 0
        if ((mask & kutterLevelIssueMissingPlayer()) != 0) { count = count + 1 }
        if ((mask & kutterLevelIssueMultiplePlayers()) != 0) { count = count + 1 }
        if ((mask & kutterLevelIssueMissingGoal()) != 0) { count = count + 1 }
        return count
    }

    Bool validLevel() {
        return documentValue.validate() && validationMask() == 0
    }


    Bool selectNode(Int nodeId) {
        if (documentValue.nodeIndex(nodeId) < 0) { return false }
        selectedNodeValue = nodeId
        return true
    }

    Bool importDocument(Int[] words) {
        if (!documentValue.decode(words)) { return false }
        undoCountValue = 0
        redoCountValue = 0
        selectedNodeValue = 0
        cursorXValue = 0
        cursorZValue = 0
        if (documentValue.nodeCount() > 0) {
            selectedNodeValue = documentValue.nodeId(0)
            cursorXValue = documentValue.nodeXValue(0)
            cursorZValue = documentValue.nodeZValue(0)
        }
        toolValue = kutterLevelToolSelect()
        return true
    }

    BoundedKutterStudio document() { return documentValue }
    Int tool() { return toolValue }
    Int selectedNode() { return selectedNodeValue }
    Int cursorX() { return cursorXValue }
    Int cursorZ() { return cursorZValue }
    Int gridSize() { return gridSizeValue }
    Bool previewActive() { return previewActiveValue }
    Int undoCount() { return undoCountValue }
    Int redoCount() { return redoCountValue }
    Int nodeCount() { return documentValue.nodeCount() }
    Int nodeId(Int index) { return documentValue.nodeId(index) }
    Int nodeKind(Int index) { return documentValue.nodeKind(index) }
    Int nodeX(Int index) { return documentValue.nodeXValue(index) }
    Int nodeZ(Int index) { return documentValue.nodeZValue(index) }
    Int generation() { return documentValue.generation() }
    Int checksum() { return documentValue.checksum() }
}
