package ui

import core

class GooseStatusOverlay {
    Int[] actorIds
    Int[] actorXs
    Int[] actorYs
    Int[] actorDepths
    Int[] actorHealths
    Int[] actorMaxHealths
    Int[] actorNameIds
    Bool[] actorBots
    Int actorCountValue

    public constructor(Int capacity) {
        var actualCapacity = capacity
        if (actualCapacity <= 0) {
            actualCapacity = 1
        }
        actorIds = new Int[actualCapacity]
        actorXs = new Int[actualCapacity]
        actorYs = new Int[actualCapacity]
        actorHealths = new Int[actualCapacity]
        actorMaxHealths = new Int[actualCapacity]
        actorNameIds = new Int[actualCapacity]
        actorDepths = new Int[actualCapacity]
        actorBots = new Bool[actualCapacity]
        actorCountValue = 0
    }

    Bool clear() {
        actorCountValue = 0
        return true
    }

    Bool add(
        Int actorId, Int x, Int y, Int health, Int maxHealth,
        Int nameId, Bool bot
    ) {
        return addDepth(actorId, x, y, 0, health, maxHealth, nameId, bot)
    }

    Bool addDepth(
        Int actorId, Int x, Int y, Int depth,
        Int health, Int maxHealth, Int nameId, Bool bot
    ) {
        if (actorCountValue >= actorIds.length || actorId <= 0 ||
            depth < 0 || depth > 100 ||
            health < 0 || maxHealth <= 0 || health > maxHealth ||
            nameId < 1 || nameId > 4) {
            return false
        }
        actorIds[actorCountValue] = actorId
        actorXs[actorCountValue] = x
        actorYs[actorCountValue] = y
        actorDepths[actorCountValue] = depth
        actorHealths[actorCountValue] = health
        actorMaxHealths[actorCountValue] = maxHealth
        actorNameIds[actorCountValue] = nameId
        actorBots[actorCountValue] = bot
        actorCountValue = actorCountValue + 1
        return true
    }

    Int actorCount() { return actorCountValue }
    String actorNameAt(Int index) {
        if (index < 0 || index >= actorCountValue) { return "" }
        if (actorBots[index]) { return "BOT GOOSE" }
        return playerName(actorNameIds[index])
    }

    Bool actorIsBotAt(Int index) {
        return index >= 0 && index < actorCountValue && actorBots[index]
    }

    Int actorMaximumHeartCountAt(Int index) {
        if (index < 0 || index >= actorCountValue) { return 0 }
        var maximumHearts = (actorMaxHealths[index] + 19) / 20
        if (maximumHearts > 5) { maximumHearts = 5 }
        return maximumHearts
    }

    Int heartStateFor(Int health, Int maxHealth, Int maximumHearts, Int heart) {
        if (maxHealth <= 0 || maximumHearts <= 0 ||
            heart < 0 || heart >= maximumHearts) {
            return 0
        }
        var totalQuarterHearts = health * maximumHearts * 4 / maxHealth
        var state = totalQuarterHearts - heart * 4
        if (state < 0) { state = 0 }
        if (state > 4) { state = 4 }
        return state
    }

    Int actorHeartStateAt(Int index, Int heart) {
        if (index < 0 || index >= actorCountValue) { return 0 }
        return heartStateFor(
            actorHealths[index], actorMaxHealths[index],
            actorMaximumHeartCountAt(index), heart)
    }

    Int heartSpriteResourceBase() { return uiFontHeartResourceBase() }

    Int heartSpriteResource(Int state) {
        if (state < 0) { state = 0 }
        if (state > 4) { state = 4 }
        return heartSpriteResourceBase() + state
    }

    Int actorFilledHeartCountAt(Int index) {
        if (index < 0 || index >= actorCountValue) { return 0 }
        var maximumHearts = actorMaximumHeartCountAt(index)
        var filledHearts = (actorHealths[index] + 19) / 20
        if (filledHearts > maximumHearts) { filledHearts = maximumHearts }
        if (filledHearts < 0) { filledHearts = 0 }
        return filledHearts
    }

    Int renderVertexCapacity() { return actorIds.length * 240 }

    Int glyph(Char value) {
        if (value >= 'A' && value <= 'Z') {
            return (value as Int) - ('A' as Int) + 1
        }
        if (value >= '0' && value <= '9') {
            return (value as Int) - ('0' as Int) + 27
        }
        if (value == '.') { return 37 }
        if (value == ':') { return 38 }
        if (value == '-') { return 39 }
        if (value == '/') { return 40 }
        if (value == '%') { return 41 }
        if (value == '>') { return 42 }
        if (value == '+') { return 43 }
        if (value == '?') { return 44 }
        return 0
    }

    Int textResource(Int color, Int glyphValue) {
        return 100 + color * 48 + glyphValue
    }

    Bool pushQuad(
        FrameStaging target, Int resource,
        Int left, Int bottom, Int right, Int top
    ) {
        return target.pushVertex(resource, left, bottom, 0, 100) &&
            target.pushVertex(resource, right, bottom, 100, 100) &&
            target.pushVertex(resource, right, top, 100, 0) &&
            target.pushVertex(resource, left, bottom, 0, 100) &&
            target.pushVertex(resource, right, top, 100, 0) &&
            target.pushVertex(resource, left, top, 0, 0)
    }

    Int textWidth(String text, Int scale) {
        if (text.length() == 0) { return 0 }
        return text.length() * uiFontGlyphAdvance() * scale - scale
    }

    Bool pushText(
        FrameStaging target, String text,
        Int left, Int bottom, Int scale, Int color
    ) {
        if (scale <= 0 || color < 0 || color > 4) { return false }
        var safeLeft = left
        var width = textWidth(text, scale)
        if (safeLeft < -100) { safeLeft = -100 }
        if (safeLeft + width > 100) {
            safeLeft = 100 - width
        }
        var x = safeLeft
        for (var index = 0; index < text.length(); index = index + 1) {
            var glyphValue = glyph(text.charAt(index))
            if (glyphValue > 0 &&
                !pushQuad(target, textResource(color, glyphValue),
                    x, bottom,
                    x + uiFontGlyphWidth() * scale,
                    bottom + uiFontGlyphHeight() * scale)) {
                return false
            }
            x = x + uiFontGlyphAdvance() * scale
        }
        return true
    }

    String playerName(Int nameId) {
        if (nameId == 2) { return "WADDLE" }
        if (nameId == 3) { return "HONK" }
        if (nameId == 4) { return "POND" }
        return "GOOSE"
    }

    Bool pushName(
        FrameStaging target, Int actorId, Int nameId, Bool bot,
        Int centerX, Int bottom
    ) {
        var name = playerName(nameId)
        if (bot) {
            name = "BOT GOOSE"
        }
        return pushText(target, name,
            centerX - textWidth(name, 1) / 2, bottom, 1,
            if (bot) 2 else 1)
    }

    Bool pushHeart(
        FrameStaging target, Int left, Int bottom, Int state
    ) {
        if (state < 0 || state > 4) { return false }
        return pushQuad(target, heartSpriteResource(state),
            left, bottom, left + 4, bottom + 4)
    }

    Bool pushActor(
        FrameStaging target, Int actorId, Int x, Int y,
        Int health, Int maxHealth, Int nameId, Bool bot
    ) {
        var safeX = x
        var safeY = y
        if (safeX < -90) { safeX = -90 }
        if (safeX > 90) { safeX = 90 }
        if (safeY < -95) { safeY = -95 }
        if (safeY > 74) { safeY = 74 }
        var bodyResource = if (bot) 14 else 13
        var beakResource = if (bot) 15 else 12
        if (!pushQuad(target, bodyResource,
                safeX - 5, safeY - 5, safeX + 5, safeY + 4) ||
            !pushQuad(target, bodyResource,
                safeX - 3, safeY + 4, safeX + 3, safeY + 9) ||
            !pushQuad(target, beakResource,
                safeX + 3, safeY + 5, safeX + 7, safeY + 7) ||
            !pushName(target, actorId, nameId, bot, safeX, safeY + 13)) {
            return false
        }
        var maximumHearts = (maxHealth + 19) / 20
        if (maximumHearts > 5) { maximumHearts = 5 }
        for (var heart = 0; heart < maximumHearts; heart = heart + 1) {
            if (!pushHeart(target, safeX - maximumHearts * 2 + heart * 4,
                    safeY + 22,
                    heartStateFor(health, maxHealth, maximumHearts, heart))) {
                return false
            }
        }
        return true
    }

    Bool stage(FrameStaging target, Int frame, Int resourceBase) {
        if (resourceBase <= 0 || actorCountValue <= 0 ||
            target.vertexCapacity() < renderVertexCapacity() ||
            !target.begin(frame)) {
            return false
        }
        for (var index = 0; index < actorCountValue; index = index + 1) {
            var actorStart = target.stagedCount()
            if (!pushActor(target,
                    actorIds[index], actorXs[index], actorYs[index],
                    actorHealths[index], actorMaxHealths[index],
                    actorNameIds[index], actorBots[index])) {
                target.discard()
                return false
            }
            for (var vertex = actorStart;
                vertex < target.stagedCount(); vertex = vertex + 1) {
                if (!target.setDepthAt(vertex, actorDepths[index])) {
                    target.discard()
                    return false
                }
            }
        }
        return target.publish()
    }
}
