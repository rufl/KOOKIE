package ui

Bool kookieUiSoundTextEquals(String actual, String expected) {
    if (actual.length() != expected.length()) { return false }
    for (var index = 0; index < actual.length(); index = index + 1) {
        if ((actual.charAt(index) as Int) != (expected.charAt(index) as Int)) {
            return false
        }
    }
    return true
}

Bool kookieUiPublishedSoundMatch(
    KookieUiSoundCue cue, Int clipId, String source, String checksum
) {
    return cue.accepted() && cue.kind() == kookieUiSoundOgg() &&
        cue.clipId() == clipId &&
        kookieUiSoundTextEquals(cue.source(), source) &&
        kookieUiSoundTextEquals(cue.checksum(), checksum)
}

Bool kookieUiPublishedSoundCue(KookieUiSoundCue cue) {
    if (kookieUiPublishedSoundMatch(
            cue, 1001,
            "assets/audio/ui/JDSherbert - Ultimate UI SFX Pack - Cursor - 1.ogg",
            "5f3d6b0caf71a1321aa9dae650cb0761f5f183e508463343590997e282f74cf7")) {
