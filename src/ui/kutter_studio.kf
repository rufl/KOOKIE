package ui
class BoundedKutterStudio {
    Int nodeCapacityValue
    Int assetCapacityValue
    Int[] nodeIds
    Int[] nodeParents
    Int[] nodeKinds
    Int[] nodeX
    Int[] nodeY
    Int[] nodeZ
    Int[] nodeRotation
    Int[] nodeScaleX
    Int[] nodeScaleY
    Int[] nodeScaleZ
    Int[] nodeColor
    Int[] nodeAssetTokens
    Int[] assetIds
    Int[] assetKinds
    Int[] assetStatuses
    Int[] assetChecksums
    Int[] assetRevisions
    Int projectNamespaceValue
    Int projectIdValue
    Int projectRevisionValue
    Int generationValue
    Int nodeCountValue
    Int assetCountValue
    Int checksumValue
    Int wordCountValue
    Int diagnosticValue
    Bool configuredValue
    Bool sealedValue
    Int[] wire

    public constructor(Int nodeCapacity, Int assetCapacity) {
        nodeCapacityValue = nodeCapacity
        assetCapacityValue = assetCapacity
        if (nodeCapacityValue <= 0) { nodeCapacityValue = 1 }
        if (nodeCapacityValue > kutterStudioNodeCapacity()) {
            nodeCapacityValue = kutterStudioNodeCapacity()
        }
        if (assetCapacityValue <= 0) { assetCapacityValue = 1 }
        if (assetCapacityValue > kutterStudioAssetCapacity()) {
            assetCapacityValue = kutterStudioAssetCapacity()
        }
        nodeIds = new Int[nodeCapacityValue]
        nodeParents = new Int[nodeCapacityValue]
        nodeKinds = new Int[nodeCapacityValue]
        nodeX = new Int[nodeCapacityValue]
        nodeY = new Int[nodeCapacityValue]
        nodeZ = new Int[nodeCapacityValue]
        nodeRotation = new Int[nodeCapacityValue]
        nodeScaleX = new Int[nodeCapacityValue]
        nodeScaleY = new Int[nodeCapacityValue]
        nodeScaleZ = new Int[nodeCapacityValue]
        nodeColor = new Int[nodeCapacityValue]
        nodeAssetTokens = new Int[nodeCapacityValue]
        assetIds = new Int[assetCapacityValue]
        assetKinds = new Int[assetCapacityValue]
        assetStatuses = new Int[assetCapacityValue]
        assetChecksums = new Int[assetCapacityValue]
        assetRevisions = new Int[assetCapacityValue]
        wire = new Int[
            11 + nodeCapacityValue * kutterStudioNodeWords() +
            assetCapacityValue * 5]
        clear()
    }

    Bool clear() {
        projectNamespaceValue = 0
        projectIdValue = 0
        projectRevisionValue = 0
        generationValue = 1
        nodeCountValue = 0
        assetCountValue = 0
        checksumValue = 0
        wordCountValue = 0
        diagnosticValue = kutterStudioDiagnosticNone()
        configuredValue = false
        sealedValue = false
        return true
    }

    Int mix(Int state, Int value) {
        var normalized = value % 1000003
        if (normalized < 0) { normalized = normalized + 1000003 }
        return (state * 31 + normalized) % 1000003
    }

    Int calculateChecksum() {
        var result = 137
        result = mix(result, kutterStudioSchemaVersion())
        result = mix(result, projectNamespaceValue)
        result = mix(result, projectIdValue)
        result = mix(result, projectRevisionValue)
        result = mix(result, generationValue)
        result = mix(result, nodeCountValue)

        for (var index = 0; index < nodeCountValue; index = index + 1) {
            result = mix(result, nodeIds[index])
            result = mix(result, nodeParents[index])
            result = mix(result, nodeKinds[index])
            result = mix(result, nodeX[index])
            result = mix(result, nodeY[index])
            result = mix(result, nodeZ[index])
            result = mix(result, nodeRotation[index])
            result = mix(result, nodeScaleX[index])
            result = mix(result, nodeScaleY[index])
            result = mix(result, nodeScaleZ[index])
            result = mix(result, nodeColor[index])
            result = mix(result, nodeAssetTokens[index])
        }
        result = mix(result, assetCountValue)
        for (var index = 0; index < assetCountValue; index = index + 1) {
            result = mix(result, assetIds[index])
            result = mix(result, assetKinds[index])
            result = mix(result, assetStatuses[index])
            result = mix(result, assetChecksums[index])
            result = mix(result, assetRevisions[index])
        }
        if (result <= 0) { return 1 }
        return result
    }
    Int encodeSigned(Int value) {
        if (value < 0) { return -value * 2 - 1 }
        return value * 2
    }

    Int decodeSigned(Int value) {
        if (value < 0 || value % 2 == 0) { return value / 2 }
        return -(value / 2) - 1
    }


    Bool reject(Int diagnostic) {
        diagnosticValue = diagnostic
        return false
    }

    Int nodeIndex(Int nodeId) {
        for (var index = 0; index < nodeCountValue; index = index + 1) {
            if (nodeIds[index] == nodeId) { return index }
        }
        return -1
    }

    Bool configure(Int projectNamespace, Int projectId, Int projectRevision) {
        if (sealedValue || configuredValue ||
            projectNamespace <= 0 || projectNamespace > 1000000 ||
            projectId <= 0 || projectId > 1000000 ||
            projectRevision <= 0 || projectRevision > 1000000) {
            return reject(kutterStudioDiagnosticIdentity())
        }
        projectNamespaceValue = projectNamespace
        projectIdValue = projectId
        projectRevisionValue = projectRevision
        configuredValue = true
        diagnosticValue = kutterStudioDiagnosticNone()
        return true
    }

    Bool addNode(
        Int nodeId, Int parentId, Int nodeKind,
        Int x, Int y, Int z, Int rotation, Int scale
    ) {
        if (!configuredValue || sealedValue || nodeCountValue >= nodeCapacityValue ||
            nodeId <= 0 || nodeId > 1000000 || nodeKind <= 0 || nodeKind > 1000000 ||
            x < -1000000 || x > 1000000 || y < -1000000 || y > 1000000 ||
            z < -1000000 || z > 1000000 || rotation < -360000 || rotation > 360000 ||
            scale <= 0 || scale > 1000000 || nodeIndex(nodeId) >= 0 ||
            parentId == nodeId) {
            return reject(kutterStudioDiagnosticBounds())
        }
        if (nodeCountValue > 0 && nodeId <= nodeIds[nodeCountValue - 1]) {
            return reject(kutterStudioDiagnosticHierarchy())
        }
        if (parentId < 0 || (parentId > 0 && nodeIndex(parentId) < 0)) {
            return reject(kutterStudioDiagnosticHierarchy())
        }
        var index = nodeCountValue
        nodeIds[index] = nodeId
        nodeParents[index] = parentId
        nodeKinds[index] = nodeKind
        nodeX[index] = x
        nodeY[index] = y
        nodeZ[index] = z
        nodeRotation[index] = rotation
        nodeScaleX[index] = scale
        nodeScaleY[index] = scale
        nodeScaleZ[index] = scale
        nodeColor[index] = kutterStudioDefaultColor()
        nodeAssetTokens[index] = 0
        nodeCountValue = nodeCountValue + 1
        return true
    }

    Bool addAsset(
        Int assetId, Int assetKind, Int status, Int assetChecksum, Int revision
    ) {
        if (!configuredValue || sealedValue || assetCountValue >= assetCapacityValue ||
            assetId <= 0 || assetId > 1000000 || assetKind <= 0 || assetKind > 1000000 ||
            status <= 0 || status > 4 || assetChecksum <= 0 || assetChecksum > 1000002 ||
            revision <= 0 || revision > 1000000) {
            return reject(kutterStudioDiagnosticAsset())
        }
        if (assetCountValue > 0 && assetId <= assetIds[assetCountValue - 1]) {
            return reject(kutterStudioDiagnosticAsset())
        }
        var index = assetCountValue
        assetIds[index] = assetId
        assetKinds[index] = assetKind
        assetStatuses[index] = status
        assetChecksums[index] = assetChecksum
        assetRevisions[index] = revision
        assetCountValue = assetCountValue + 1
        return true
    }

    Bool structuralValid() {
        if (!configuredValue || projectNamespaceValue <= 0 || projectIdValue <= 0 ||
            projectRevisionValue <= 0 || generationValue <= 0 || nodeCountValue <= 0) {
            return false
        }
        for (var index = 0; index < nodeCountValue; index = index + 1) {
            if (nodeIds[index] <= 0 || nodeKinds[index] <= 0 ||
                nodeScaleX[index] <= 0 || nodeScaleY[index] <= 0 ||
                nodeScaleZ[index] <= 0 ||
                nodeScaleX[index] > 1000000 ||
                nodeScaleY[index] > 1000000 ||
                nodeScaleZ[index] > 1000000 ||
                nodeColor[index] < 0 ||
                nodeColor[index] > kutterStudioMaximumColor() ||
                nodeAssetTokens[index] < 0 ||
                nodeAssetTokens[index] > 1000000 ||
                nodeParents[index] == nodeIds[index] ||
                (nodeParents[index] > 0 &&
                    nodeIndex(nodeParents[index]) < 0)) {
                return false
            }
            if (index > 0 && nodeIds[index] <= nodeIds[index - 1]) {
                return false
            }
        }
        for (var index = 0; index < assetCountValue; index = index + 1) {
            if (assetIds[index] <= 0 || assetKinds[index] <= 0 ||
                assetStatuses[index] <= 0 || assetStatuses[index] > 4 ||
                assetChecksums[index] <= 0 || assetRevisions[index] <= 0 ||
                (index > 0 && assetIds[index] <= assetIds[index - 1])) {
                return false
            }
        }
        return true
    }

    Bool encode() {
        if (!sealedValue || !structuralValid() || checksumValue != calculateChecksum()) {
            return false
        }
        wordCountValue = 11 + nodeCountValue * kutterStudioNodeWords() +
            assetCountValue * 5
        wire[0] = kutterStudioMagic()
        wire[1] = kutterStudioSchemaVersion()
        wire[2] = wordCountValue
        wire[3] = checksumValue
        wire[4] = projectNamespaceValue
        wire[5] = projectIdValue
        wire[6] = projectRevisionValue
        wire[7] = nodeCountValue
        wire[8] = assetCountValue
        wire[9] = generationValue
        wire[10] = 0
        var cursor = 11
        for (var index = 0; index < nodeCountValue; index = index + 1) {
            wire[cursor] = nodeIds[index]
            wire[cursor + 1] = nodeParents[index]
            wire[cursor + 2] = nodeKinds[index]
            wire[cursor + 3] = encodeSigned(nodeX[index])
            wire[cursor + 4] = encodeSigned(nodeY[index])
            wire[cursor + 5] = encodeSigned(nodeZ[index])
            wire[cursor + 6] = encodeSigned(nodeRotation[index])
            wire[cursor + 7] = nodeScaleX[index]
            wire[cursor + 8] = nodeScaleY[index]
            wire[cursor + 9] = nodeScaleZ[index]
            wire[cursor + 10] = nodeColor[index]
            wire[cursor + 11] = 0
            wire[cursor + 12] = nodeAssetTokens[index]
            cursor = cursor + kutterStudioNodeWords()
        }
        for (var index = 0; index < assetCountValue; index = index + 1) {
            wire[cursor] = assetIds[index]
            wire[cursor + 1] = assetKinds[index]
            wire[cursor + 2] = assetStatuses[index]
            wire[cursor + 3] = assetChecksums[index]
            wire[cursor + 4] = assetRevisions[index]
            cursor = cursor + 5
        }
        return true
    }

    Bool seal() {
        if (sealedValue || !structuralValid()) {
            return reject(kutterStudioDiagnosticState())
        }
        checksumValue = calculateChecksum()
        sealedValue = checksumValue > 0
        if (!sealedValue || !encode()) {
            sealedValue = false
            return reject(kutterStudioDiagnosticChecksum())
        }
        diagnosticValue = kutterStudioDiagnosticNone()
        return true
    }
    Bool beginEdit() {
        if (!configuredValue || !sealedValue) {
            return reject(kutterStudioDiagnosticState())
        }
        sealedValue = false
        generationValue = generationValue + 1
        wordCountValue = 0
        diagnosticValue = kutterStudioDiagnosticNone()
        return true
    }

    Bool removeNode(Int nodeId) {
        if (!configuredValue || sealedValue || nodeId <= 0) {
            return reject(kutterStudioDiagnosticState())
        }
        var index = nodeIndex(nodeId)
        if (index < 0) { return reject(kutterStudioDiagnosticBounds()) }
        for (var child = 0; child < nodeCountValue; child = child + 1) {
            if (nodeParents[child] == nodeId) {
                return reject(kutterStudioDiagnosticHierarchy())
            }
        }
        for (var cursor = index; cursor < nodeCountValue - 1; cursor = cursor + 1) {
            nodeIds[cursor] = nodeIds[cursor + 1]
            nodeParents[cursor] = nodeParents[cursor + 1]
            nodeKinds[cursor] = nodeKinds[cursor + 1]
            nodeX[cursor] = nodeX[cursor + 1]
            nodeY[cursor] = nodeY[cursor + 1]
            nodeZ[cursor] = nodeZ[cursor + 1]
            nodeRotation[cursor] = nodeRotation[cursor + 1]
            nodeScaleX[cursor] = nodeScaleX[cursor + 1]
            nodeScaleY[cursor] = nodeScaleY[cursor + 1]
            nodeScaleZ[cursor] = nodeScaleZ[cursor + 1]
            nodeColor[cursor] = nodeColor[cursor + 1]
            nodeAssetTokens[cursor] = nodeAssetTokens[cursor + 1]
        }
        nodeCountValue = nodeCountValue - 1
        return true
    }

    Bool moveNode(Int nodeId, Int x, Int y, Int z) {
        if (!configuredValue || sealedValue ||
            x < -1000000 || x > 1000000 ||
            y < -1000000 || y > 1000000 ||
            z < -1000000 || z > 1000000) {
            return reject(kutterStudioDiagnosticBounds())
        }
        var index = nodeIndex(nodeId)
        if (index < 0) { return reject(kutterStudioDiagnosticBounds()) }
        nodeX[index] = x
        nodeY[index] = y
        nodeZ[index] = z
        return true
    }

    Bool setNodeAssetToken(Int nodeId, Int assetToken) {
        if (!configuredValue || sealedValue ||
            assetToken < 0 || assetToken > 1000000) {
            return reject(kutterStudioDiagnosticAsset())
        }
        var index = nodeIndex(nodeId)
        if (index < 0) { return reject(kutterStudioDiagnosticBounds()) }
        nodeAssetTokens[index] = assetToken
        return true
    }
    Bool setNodeRotation(Int nodeId, Int rotation) {
        if (!configuredValue || sealedValue ||
            rotation < -360000 || rotation > 360000) {
            return reject(kutterStudioDiagnosticBounds())
        }
        var index = nodeIndex(nodeId)
        if (index < 0) { return reject(kutterStudioDiagnosticBounds()) }
        nodeRotation[index] = rotation
        return true
    }

    Bool setNodeScale(Int nodeId, Int scaleX, Int scaleY, Int scaleZ) {
        if (!configuredValue || sealedValue ||
            scaleX <= 0 || scaleX > 1000000 ||
            scaleY <= 0 || scaleY > 1000000 ||
            scaleZ <= 0 || scaleZ > 1000000) {
            return reject(kutterStudioDiagnosticBounds())
        }
        var index = nodeIndex(nodeId)
        if (index < 0) { return reject(kutterStudioDiagnosticBounds()) }
        nodeScaleX[index] = scaleX
        nodeScaleY[index] = scaleY
        nodeScaleZ[index] = scaleZ
        return true
    }

    Bool setNodeColor(Int nodeId, Int color) {
        if (!configuredValue || sealedValue ||
            color < 0 || color > kutterStudioMaximumColor()) {
            return reject(kutterStudioDiagnosticBounds())
        }
        var index = nodeIndex(nodeId)
        if (index < 0) { return reject(kutterStudioDiagnosticBounds()) }
        nodeColor[index] = color
        return true
    }

    Bool setNodeParent(Int nodeId, Int parentId) {
        if (!configuredValue || sealedValue ||
            parentId < 0 || parentId == nodeId) {
            return reject(kutterStudioDiagnosticHierarchy())
        }
        var index = nodeIndex(nodeId)
        if (index < 0 || (parentId > 0 && nodeIndex(parentId) < 0)) {
            return reject(kutterStudioDiagnosticHierarchy())
        }
        var parent = parentId
        while (parent > 0) {
            if (parent == nodeId) {
                return reject(kutterStudioDiagnosticHierarchy())
            }
            var parentIndex = nodeIndex(parent)
            if (parentIndex < 0) { return reject(kutterStudioDiagnosticHierarchy()) }
            parent = nodeParents[parentIndex]
        }
        nodeParents[index] = parentId
        return true
    }


    Bool validate() {
        return sealedValue && structuralValid() && checksumValue == calculateChecksum()
    }

    Bool copyFrom(BoundedKutterStudio source) {
        if (!source.validate()) { return false }
        projectNamespaceValue = source.projectNamespaceValue
        projectIdValue = source.projectIdValue
        projectRevisionValue = source.projectRevisionValue
        generationValue = source.generationValue
        nodeCountValue = source.nodeCountValue
        assetCountValue = source.assetCountValue
        checksumValue = source.checksumValue
        wordCountValue = source.wordCountValue
        configuredValue = source.configuredValue
        sealedValue = source.sealedValue
        for (var index = 0; index < nodeCapacityValue; index = index + 1) {
            nodeIds[index] = source.nodeIds[index]
            nodeParents[index] = source.nodeParents[index]
            nodeKinds[index] = source.nodeKinds[index]
            nodeX[index] = source.nodeX[index]
            nodeY[index] = source.nodeY[index]
            nodeZ[index] = source.nodeZ[index]
            nodeRotation[index] = source.nodeRotation[index]
            nodeScaleX[index] = source.nodeScaleX[index]
            nodeScaleY[index] = source.nodeScaleY[index]
            nodeScaleZ[index] = source.nodeScaleZ[index]
            nodeColor[index] = source.nodeColor[index]
            nodeAssetTokens[index] = source.nodeAssetTokens[index]
        }
        for (var index = 0; index < assetCapacityValue; index = index + 1) {
            assetIds[index] = source.assetIds[index]
            assetKinds[index] = source.assetKinds[index]
            assetStatuses[index] = source.assetStatuses[index]
            assetChecksums[index] = source.assetChecksums[index]
            assetRevisions[index] = source.assetRevisions[index]
        }
        for (var index = 0; index < wordCountValue; index = index + 1) {
            wire[index] = source.wire[index]
        }
        diagnosticValue = kutterStudioDiagnosticNone()
        return true
    }

    Int legacyV1Checksum(Int[] source) {
        var result = mix(137, 1)
        result = mix(result, source[4])
        result = mix(result, source[5])
        result = mix(result, source[6])
        result = mix(result, source[9])
        result = mix(result, source[7])
        var cursor = 11
        for (var index = 0; index < source[7]; index = index + 1) {
            result = mix(result, source[cursor])
            result = mix(result, source[cursor + 1])
            result = mix(result, source[cursor + 2])
            result = mix(result, decodeSigned(source[cursor + 3]))
            result = mix(result, decodeSigned(source[cursor + 4]))
            result = mix(result, decodeSigned(source[cursor + 5]))
            result = mix(result, decodeSigned(source[cursor + 6]))
            result = mix(result, source[cursor + 7])
            cursor = cursor + kutterStudioNodeWordsV1()
        }
        result = mix(result, source[8])
        for (var index = 0; index < source[8]; index = index + 1) {
            result = mix(result, source[cursor])
            result = mix(result, source[cursor + 1])
            result = mix(result, source[cursor + 2])
            result = mix(result, source[cursor + 3])
            result = mix(result, source[cursor + 4])
            cursor = cursor + 5
        }
        return if (result <= 0) 1 else result
    }

    Int legacyV2Checksum(Int[] source) {
        var result = mix(137, 2)
        result = mix(result, source[4])
        result = mix(result, source[5])
        result = mix(result, source[6])
        result = mix(result, source[9])
        result = mix(result, source[7])
        var cursor = 11
        for (var index = 0; index < source[7]; index = index + 1) {
            result = mix(result, source[cursor])
            result = mix(result, source[cursor + 1])
            result = mix(result, source[cursor + 2])
            result = mix(result, decodeSigned(source[cursor + 3]))
            result = mix(result, decodeSigned(source[cursor + 4]))
            result = mix(result, decodeSigned(source[cursor + 5]))
            result = mix(result, decodeSigned(source[cursor + 6]))
            result = mix(result, source[cursor + 7])
            result = mix(result, source[cursor + 8])
            result = mix(result, source[cursor + 9])
            result = mix(result, source[cursor + 10])
            if (source[cursor + 11] != 0) { return 0 }
            cursor = cursor + kutterStudioNodeWordsV2()
        }
        result = mix(result, source[8])
        for (var index = 0; index < source[8]; index = index + 1) {
            result = mix(result, source[cursor])
            result = mix(result, source[cursor + 1])
            result = mix(result, source[cursor + 2])
            result = mix(result, source[cursor + 3])
            result = mix(result, source[cursor + 4])
            cursor = cursor + 5
        }
        return if (result <= 0) 1 else result
    }

    Bool decode(Int[] source) {
        if (source.length < 11 || source[0] != kutterStudioMagic() ||
            (source[1] != 1 && source[1] != 2 &&
                source[1] != kutterStudioSchemaVersion()) ||
            source[2] < 11 || source[2] > wire.length ||
            source[3] <= 0 || source[4] <= 0 || source[5] <= 0 ||
            source[6] <= 0 || source[7] <= 0 ||
            source[7] > nodeCapacityValue || source[8] < 0 ||
            source[8] > assetCapacityValue || source[9] <= 0 ||
            source[10] != 0 || source.length != source[2]) {
            return false
        }
        var version = source[1]
        var nodeWords = kutterStudioNodeWords()
        if (version == 1) { nodeWords = kutterStudioNodeWordsV1() }
        if (version == 2) { nodeWords = kutterStudioNodeWordsV2() }
        if (source[2] != 11 + source[7] * nodeWords + source[8] * 5) {
            return false
        }
        if (version == 1 && legacyV1Checksum(source) != source[3]) {
            return false
        }
        if (version == 2 && legacyV2Checksum(source) != source[3]) {
            return false
        }
        var candidate = BoundedKutterStudio(nodeCapacityValue, assetCapacityValue)
        if (!candidate.configure(source[4], source[5], source[6])) {
            return false
        }
        candidate.generationValue = source[9]
        var cursor = 11
        for (var index = 0; index < source[7]; index = index + 1) {
            var scaleX = source[cursor + 7]
            var scaleY = scaleX
            var scaleZ = scaleX
            var color = kutterStudioDefaultColor()
            var assetToken = 0
            if (version >= 2) {
                scaleY = source[cursor + 8]
                scaleZ = source[cursor + 9]
                color = source[cursor + 10]
                if (source[cursor + 11] != 0) { return false }
            }
            if (version >= 3) {
                assetToken = source[cursor + 12]
            }
            if (!candidate.addNode(
                    source[cursor], 0, source[cursor + 2],
                    decodeSigned(source[cursor + 3]),
                    decodeSigned(source[cursor + 4]),
                    decodeSigned(source[cursor + 5]),
                    decodeSigned(source[cursor + 6]), scaleX) ||
                !candidate.setNodeScale(
                    source[cursor], scaleX, scaleY, scaleZ) ||
                !candidate.setNodeColor(source[cursor], color) ||
                !candidate.setNodeAssetToken(source[cursor], assetToken)) {
                return false
            }
            cursor = cursor + nodeWords
        }
        cursor = 11
        for (var index = 0; index < source[7]; index = index + 1) {
            if (source[cursor + 1] > 0 &&
                !candidate.setNodeParent(
                    source[cursor], source[cursor + 1])) {
                return false
            }
            cursor = cursor + nodeWords
        }
        for (var index = 0; index < source[8]; index = index + 1) {
            if (!candidate.addAsset(
                    source[cursor], source[cursor + 1], source[cursor + 2],
                    source[cursor + 3], source[cursor + 4])) {
                return false
            }
            cursor = cursor + 5
        }
        if (!candidate.seal()) { return false }
        if (version == 3 && candidate.checksumValue != source[3]) {
            return false
        }
        return copyFrom(candidate)
    }


    Int encodedCapacity() { return wire.length }

    Bool captureWorkspace(BoundedKutterWorkspace workspace) {
        var candidate = BoundedKutterStudio(nodeCapacityValue, assetCapacityValue)
        if (!candidate.configure(1, workspace.entityId(), workspace.revision()) ||
            !candidate.addNode(
                1, 0, kutterModeEntity(), workspace.entityX(), workspace.entityY(),
                workspace.entityZ(), 0, 1000)) {
            return reject(kutterStudioDiagnosticState())
        }
        if (workspace.assetId() > 0 && !candidate.addAsset(
                workspace.assetId(), 1, 1, workspace.renderChecksum(), workspace.revision())) {
            return reject(kutterStudioDiagnosticAsset())
        }
        if (!candidate.seal() || !copyFrom(candidate)) {
            return reject(kutterStudioDiagnosticChecksum())
        }
        return true
    }

    Int diagnostic() { return diagnosticValue }
    Int generation() { return generationValue }
    Int projectNamespace() { return projectNamespaceValue }
    Int projectId() { return projectIdValue }
    Int projectRevision() { return projectRevisionValue }
    Int nodeCount() { return nodeCountValue }
    Int assetCount() { return assetCountValue }
    Int nodeId(Int index) {
        if (index < 0 || index >= nodeCountValue) { return 0 }
        return nodeIds[index]
    }
    Int nodeKind(Int index) {
        if (index < 0 || index >= nodeCountValue) { return 0 }
        return nodeKinds[index]
    }
    Int nodeParent(Int index) {
        if (index < 0 || index >= nodeCountValue) { return -1 }
        return nodeParents[index]
    }
    Int nodeXValue(Int index) {
        if (index < 0 || index >= nodeCountValue) { return 0 }
        return nodeX[index]
    }
    Int nodeYValue(Int index) {
        if (index < 0 || index >= nodeCountValue) { return 0 }
        return nodeY[index]
    }
    Int nodeZValue(Int index) {
        if (index < 0 || index >= nodeCountValue) { return 0 }
        return nodeZ[index]
    }
    Int nodeScaleValue(Int index) {
        if (index < 0 || index >= nodeCountValue) { return 0 }
        return nodeScaleX[index]
    }
    Int nodeScaleXValue(Int index) {
        if (index < 0 || index >= nodeCountValue) { return 0 }
        return nodeScaleX[index]
    }
    Int nodeScaleYValue(Int index) {
        if (index < 0 || index >= nodeCountValue) { return 0 }
        return nodeScaleY[index]
    }
    Int nodeScaleZValue(Int index) {
        if (index < 0 || index >= nodeCountValue) { return 0 }
        return nodeScaleZ[index]
    }
    Int nodeRotationValue(Int index) {
        if (index < 0 || index >= nodeCountValue) { return 0 }
        return nodeRotation[index]
    }
    Int nodeColorValue(Int index) {
        if (index < 0 || index >= nodeCountValue) { return 0 }
        return nodeColor[index]
    }
    Int nodeAssetToken(Int index) {
        if (index < 0 || index >= nodeCountValue) { return 0 }
        return nodeAssetTokens[index]
    }
    Int assetId(Int index) {
        if (index < 0 || index >= assetCountValue) { return 0 }
        return assetIds[index]
    }
    Int assetStatus(Int index) {
        if (index < 0 || index >= assetCountValue) { return 0 }
        return assetStatuses[index]
    }
    Int assetChecksum(Int index) {
        if (index < 0 || index >= assetCountValue) { return 0 }
        return assetChecksums[index]
    }
    Int checksum() {
        if (!validate()) { return -1 }
        return checksumValue
    }
    Int encodedLength() {
        if (!validate()) { return 0 }
        return wordCountValue
    }
    Int encodedWord(Int index) {
        if (index < 0 || index >= wordCountValue) { return -1 }
        return wire[index]
    }
}
