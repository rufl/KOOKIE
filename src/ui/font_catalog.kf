package ui

Int uiFontJaredLite() { return 0 }
Int uiFontPixand() { return 1 }
Int uiFontCount() { return 2 }
Int uiFontDefaultBody() { return uiFontPixand() }
Int uiFontDefaultDisplay() { return uiFontJaredLite() }

// Native coordinates keep a stable logical advance while the adapter uses
// runtime FreeType metrics and HarfBuzz shaping for the actual glyph pixels.
Int uiFontGlyphWidth() { return 4 }
Int uiFontGlyphHeight() { return 7 }
Int uiFontGlyphAdvance() { return 5 }

// Hearts are authored raster sprites, not font data.
Int uiHeartResourceBase() { return 600 }

String uiFontName(Int font) {
    if (font == uiFontJaredLite()) { return "Jared Lite" }
    if (font == uiFontPixand()) { return "Pixand" }
    return ""
}

String uiGameTitle() { return "GATOGANSO" }
String uiGameDisplayName() { return "GatoGanso" }
