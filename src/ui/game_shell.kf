        if (levelEditorValue.tool() == kutterLevelToolEnemySpawn()) {
            return "ENEMY SPAWN"
        }
        if (levelEditorValue.tool() == kutterLevelToolEncounter()) {
            return "ENCOUNTER"
        }
        if (levelEditorValue.tool() == kutterLevelToolTrigger()) {
            return "TRIGGER"
        }
        if (levelEditorValue.tool() == kutterLevelToolLight()) { return "LIGHT" }
        if (levelEditorValue.tool() == kutterLevelToolErase()) { return "ERASE" }
        return "SELECT"
    }

