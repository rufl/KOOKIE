                mutedTextColor())
    }

    Bool stage(FrameStaging target, Int frame) {
        if (target.vertexCapacity() < renderVertexCapacity() ||
            frame <= 0 || !target.begin(frame)) { return false }
        var staged = false
        if (screenValue == gameShellScreenMain()) {
            staged = stageMain(target)
        } else if (screenValue == gameShellScreenOptions()) {
            staged = stageOptions(target)
        } else if (screenValue == gameShellScreenAccessibility()) {
            staged = stageAccessibility(target)
        } else if (screenValue == gameShellScreenMultiplayer()) {
            staged = stageMultiplayer(target)
        } else if (screenValue == gameShellScreenKutter()) {
            staged = stageKutter(target)
        } else if (screenValue == gameShellScreenKutterLevel()) {
            staged = stageKutterLevel(target)
        }
        if (!staged) {
            target.discard()
            return false
        }
        return target.publish()
    }
}
