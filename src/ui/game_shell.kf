package ui

import session
import world

Int gameShellScreenMain() { return 1 }
Int gameShellScreenOptions() { return 2 }
Int gameShellScreenMultiplayer() { return 3 }
Int gameShellScreenGame() { return 4 }
Int gameShellScreenKutter() { return 5 }
Int gameShellScreenKutterLevel() { return 6 }
Int gameShellScreenAccessibility() { return 7 }

Int gameShellActionUp() { return 1 }
Int gameShellActionDown() { return 2 }
Int gameShellActionLeft() { return 3 }
Int gameShellActionRight() { return 4 }
Int gameShellActionActivate() { return 5 }
Int gameShellActionBack() { return 6 }

Int gameShellNetworkIdle() { return 0 }
Int gameShellNetworkHosting() { return 1 }
Int gameShellNetworkJoining() { return 2 }
Int gameShellNetworkConnected() { return 3 }
Int gameShellNetworkFailed() { return 4 }

Int gameShellNetworkHostRequest() { return 1 }
Int gameShellNetworkJoinRequest() { return 2 }
Int gameShellNetworkLeaveRequest() { return 3 }

class GameShell {
    KookieUiNativeTheme themeValue
    Int screenValue
    Int selectionValue
    Bool quitRequestedValue
    Bool gameplayEntryPendingValue

    Int resolutionValue
    Int displayModeValue
    Int effectsVolumeValue
    Int musicVolumeValue
    Int textSizeValue
    Int hudScaleValue
    Bool tacticalMapValue
    Bool highContrastValue
    Int settingsRevisionValue
    Bool displayApplyPendingValue
    Int displayApplyResultValue

    Int networkStatusValue
    Int networkRequestValue
    Bool networkEditingValue
    Int networkAddressFieldValue
    Int addressOneValue
    Int addressTwoValue
    Int addressThreeValue
    Int addressFourValue
    Int portValue
    MatchLobbyState lobbyValue
    BoundedKutterWorkspace kutterValue
    BoundedKutterGreyboxCatalog greyboxCatalogValue
    BoundedKutterGreyboxLevel greyboxLevelValue
    BoundedKutterLevelEditor levelEditorValue
    Int editorInspectorLeftValue
    Bool editorInspectorResizeActiveValue
    Int editorScaleAxisValue
    Int editorAssetIndexValue
    Bool editorAssetBrowserOpenValue
    Int editorAssetPageValue
    Int editorHierarchyPageValue
    Bool editorHierarchyKeyboardFocusValue
    Bool editorMoveArmedValue
    KutterScenePreview editorScenePreviewValue
    public constructor() {

        themeValue = KookieUiNativeTheme()
        screenValue = gameShellScreenMain()
        selectionValue = 0
        quitRequestedValue = false
        gameplayEntryPendingValue = false
        resolutionValue = 0
        displayModeValue = 0
        effectsVolumeValue = 80
        musicVolumeValue = 60
        textSizeValue = 1
        themeValue.setTextScale(textSizeValue + 1)
        hudScaleValue = 1
        tacticalMapValue = true
        highContrastValue = false
        settingsRevisionValue = 1
        displayApplyPendingValue = false
        displayApplyResultValue = 0
        networkStatusValue = gameShellNetworkIdle()
        networkRequestValue = 0
        networkEditingValue = false
        networkAddressFieldValue = 0
        addressOneValue = 127
        addressTwoValue = 0
        addressThreeValue = 0
        addressFourValue = 1
        portValue = 47101
        lobbyValue = MatchLobbyState()
        kutterValue = BoundedKutterWorkspace()
        greyboxCatalogValue = BoundedKutterGreyboxCatalog(96)
        greyboxCatalogValue.loadRgsdevPack()
        greyboxLevelValue = BoundedKutterGreyboxLevel(128)
        levelEditorValue = BoundedKutterLevelEditor()
        editorInspectorLeftValue = 48
        editorInspectorResizeActiveValue = false
        editorAssetIndexValue = 0
        editorAssetBrowserOpenValue = false
        editorAssetPageValue = 0
        editorHierarchyPageValue = 0
        editorHierarchyKeyboardFocusValue = false
        editorMoveArmedValue = false
        editorScenePreviewValue = KutterScenePreview(1)
        editorScaleAxisValue = 0
    }

    Int screen() { return screenValue }
    Int selection() { return selectionValue }
    Bool quitRequested() { return quitRequestedValue }
    Bool requestQuit() {
        quitRequestedValue = true
        return true
    }
    Bool gameplayVisible() { return screenValue == gameShellScreenGame() }
    Bool gameplayEntryPending() { return gameplayEntryPendingValue }
    Bool consumeGameplayEntry() {
        if (!gameplayEntryPendingValue) { return false }
        gameplayEntryPendingValue = false
        return true
    }

    Bool enterGameplay() {
        if (networkStatusValue != gameShellNetworkConnected() ||
            lobbyValue.phase() != multiplayerLobbyPhaseReady()) {
            return false
        }
        screenValue = gameShellScreenGame()
        selectionValue = 0
        gameplayEntryPendingValue = true
        return true
    }
    Int renderVertexCapacity() { return 2048 }
    BoundedKutterWorkspace kutter() { return kutterValue }
    BoundedKutterGreyboxCatalog greyboxCatalog() {
        return greyboxCatalogValue
    }
    BoundedKutterGreyboxLevel greyboxLevel() {
        return greyboxLevelValue
    }
    BoundedKutterLevelEditor levelEditor() {
        return levelEditorValue
    }
    Int inspectorLeft() { return editorInspectorLeftValue }

    Int editorScaleAxis() { return editorScaleAxisValue }
    Bool cycleEditorScaleAxis() {
        editorScaleAxisValue = editorScaleAxisValue + 1
        if (editorScaleAxisValue > 2) { editorScaleAxisValue = 0 }
        return true
    }
    Bool cycleEditorAsset(Int direction) {
        var count = greyboxCatalogValue.count()
        if (!greyboxCatalogValue.validate() || count <= 0 ||
            (direction != -1 && direction != 1)) {
            return false
        }
        editorAssetIndexValue = editorAssetIndexValue + direction
        if (editorAssetIndexValue < 0) {
            editorAssetIndexValue = count - 1
        } else if (editorAssetIndexValue >= count) {
            editorAssetIndexValue = 0
        }
        editorAssetPageValue = editorAssetIndexValue / 7
        return true
    }
    Bool cycleEditorAssetPage(Int direction) {
        var count = greyboxCatalogValue.count()
        if (!greyboxCatalogValue.validate() || count <= 0 ||
            (direction != -1 && direction != 1)) { return false }
        var pages = (count + 6) / 7
        editorAssetPageValue = editorAssetPageValue + direction
        if (editorAssetPageValue < 0) { editorAssetPageValue = pages - 1 }
        else if (editorAssetPageValue >= pages) { editorAssetPageValue = 0 }
        editorAssetIndexValue = editorAssetPageValue * 7
        return true
    }
    Bool selectEditorAsset(Int index) {
        if (!greyboxCatalogValue.validate() ||
            index < 0 || index >= greyboxCatalogValue.count() ||
            !levelEditorValue.selectTool(kutterLevelToolProp())) {
            return false
        }
        editorAssetIndexValue = index
        editorAssetPageValue = index / 7
        editorAssetBrowserOpenValue = false
        selectionValue = 0
        return true
    }
    Bool focusHierarchySelection() {
        var index = levelEditorValue.document().nodeIndex(
            levelEditorValue.selectedNode())
        if (index < 0) { return false }
        editorHierarchyPageValue = index / 4
        return true
    }
    Bool focusHierarchyAfter(Bool changed) {
        if (changed) { focusHierarchySelection() }
        return changed
    }
    Bool moveHierarchySelection(Int direction) {
        if (direction != -1 && direction != 1) { return false }
        var currentIndex = levelEditorValue.document().nodeIndex(
            levelEditorValue.selectedNode())
        var nextIndex = currentIndex + direction
        if (currentIndex < 0 || nextIndex < 0 ||
            nextIndex >= levelEditorValue.nodeCount()) {
            return false
        }
        if (!levelEditorValue.selectNode(
                levelEditorValue.nodeId(nextIndex))) {
            return false
        }
        return focusHierarchySelection()
    }
    Bool cycleEditorHierarchyPage(Int direction) {
        var count = levelEditorValue.nodeCount()
        if (direction != -1 && direction != 1) { return false }
        var pages = (count + 3) / 4
        if (pages < 1) { pages = 1 }
        editorHierarchyPageValue = editorHierarchyPageValue + direction
        if (editorHierarchyPageValue < 0) {
            editorHierarchyPageValue = pages - 1
        } else if (editorHierarchyPageValue >= pages) {
            editorHierarchyPageValue = 0
        }
        return true
    }
    Bool editorAssetBrowserOpen() { return editorAssetBrowserOpenValue }
    Int selectedEditorAssetToken() {
        return greyboxCatalogValue.assetToken(editorAssetIndexValue)
    }
    Int selectedScaleValue(Int nodeIndex) {
        if (editorScaleAxisValue == 1) {
            return levelEditorValue.document().nodeScaleYValue(nodeIndex)
        }
        if (editorScaleAxisValue == 2) {
            return levelEditorValue.document().nodeScaleZValue(nodeIndex)
        }
        return levelEditorValue.document().nodeScaleXValue(nodeIndex)
    }
    String scaleAxisLabel() {
        if (editorScaleAxisValue == 1) { return "SY" }
        if (editorScaleAxisValue == 2) { return "SZ" }
        return "SX"
    }

    Int resolutionIndex() { return resolutionValue }
    Int displayMode() { return displayModeValue }
    Int effectsVolume() { return effectsVolumeValue }
    Int musicVolume() { return musicVolumeValue }
    Int textSize() { return textSizeValue + 1 }
    Int hudScale() { return hudScaleValue + 1 }
    Int hudScalePercent() {
        if (hudScaleValue == 0) { return 85 }
        if (hudScaleValue == 2) { return 115 }
        return 100
    }
    Bool tacticalMapVisible() { return tacticalMapValue }
    Bool highContrast() { return highContrastValue }
    Int settingsRevision() { return settingsRevisionValue }
    Bool displayApplyPending() { return displayApplyPendingValue }
    Int displayApplyResult() { return displayApplyResultValue }

    Int resolutionWidth() {
        if (resolutionValue == 1) { return 1600 }
        if (resolutionValue == 2) { return 1920 }
        if (resolutionValue == 3) { return 2560 }
        return 1280
    }

    Int resolutionHeight() {
        if (resolutionValue == 1) { return 900 }
        if (resolutionValue == 2) { return 1080 }
        if (resolutionValue == 3) { return 1440 }
        return 720
    }

    Int networkStatus() { return networkStatusValue }
    Int networkRequest() { return networkRequestValue }
    Bool networkEditing() { return networkEditingValue }
    Int networkAddressField() { return networkAddressFieldValue }
    Int addressOne() { return addressOneValue }
    Int addressTwo() { return addressTwoValue }
    Int addressThree() { return addressThreeValue }
    Int addressFour() { return addressFourValue }
    Int port() { return portValue }
    MatchLobbyState lobby() { return lobbyValue }

    Bool configureLobbyIdentity(
        Int localNameId, Int remoteNameId,
        Int localColorId, Int remoteColorId, Int room
    ) {
        return lobbyValue.setIdentity(
            localNameId, remoteNameId, localColorId, remoteColorId, room)
    }
    Bool setRemoteNameId(Int nameId) {
        return lobbyValue.setRemoteNameId(nameId)
    }

    Bool setLocalNickname(String nickname) {
        return lobbyValue.setLocalProfile(
            nickname, lobbyValue.localColorId())
    }

    Bool setLocalColor(Int colorId) {
        return lobbyValue.setLocalProfile(
            lobbyValue.localNickname(), colorId)
    }

    Bool setRemoteProfile(String nickname, Int colorId) {
        return lobbyValue.setRemoteProfile(nickname, colorId)
    }
    Bool setLocalAnimalKind(Int kind) {
        return lobbyValue.setLocalAnimalKind(kind)
    }
    Bool setRemoteAnimalKind(Int kind) {
        return lobbyValue.setRemoteAnimalKind(kind)
    }

    Int localAnimalKind() { return lobbyValue.localAnimalKind() }
    Int remoteAnimalKind() { return lobbyValue.remoteAnimalKind() }


    String localNickname() { return lobbyValue.localNickname() }
    String remoteNickname() { return lobbyValue.remoteNickname() }
    Int localColorId() { return lobbyValue.localColorId() }
    Int remoteColorId() { return lobbyValue.remoteColorId() }

    String lobbyNameLabel(Int nameId) {
        if (nameId == 2) { return "WADDLE" }
        if (nameId == 3) { return "HONK" }
        if (nameId == 4) { return "POND" }
        return "GOOSE"
    }

    String lobbyColorLabel(Int colorId) {
        if (colorId == 0) { return "WHITE" }
        if (colorId == 2) { return "GRAY" }
        if (colorId == 3) { return "RED" }
        if (colorId == 4) { return "GREEN" }
        return "GOLD"
    }
    String lobbyAnimalLabel(Int kind) {
        if (kind == multiplayerAnimalCat()) { return "CAT" }
        return "GOOSE"
    }


    Bool acknowledgeDisplayApply(Bool success) {
        if (!displayApplyPendingValue) { return false }
        displayApplyPendingValue = false
        displayApplyResultValue = if (success) 1 else 2
        return true
    }

    Bool completeNetworkRequest(Int operation, Bool success) {
        if (operation <= 0 || operation != networkRequestValue) { return false }
        networkRequestValue = 0
        if (!success) {
            networkStatusValue = gameShellNetworkFailed()
            lobbyValue.fail(multiplayerLobbyErrorTransport())
            return true
        }
        if (operation == gameShellNetworkHostRequest()) {
            networkStatusValue = gameShellNetworkHosting()
            lobbyValue.markWaiting(lobbyValue.room())
        } else if (operation == gameShellNetworkJoinRequest()) {
            networkStatusValue = gameShellNetworkJoining()
            lobbyValue.markWaiting(lobbyValue.room())
        } else {
            networkStatusValue = gameShellNetworkIdle()
            lobbyValue.leave()
        }
        return true
    }

    Bool markNetworkConnected() {
        if (networkStatusValue != gameShellNetworkHosting() &&
            networkStatusValue != gameShellNetworkJoining()) {
            return false
        }
        networkStatusValue = gameShellNetworkConnected()
        return lobbyValue.markConnected(
            lobbyValue.remoteNameId(), lobbyValue.remoteColorId(),
            lobbyValue.ping())
    }

    Bool markNetworkConnectedProfile(
        String nickname, Int colorId, Int ping
    ) {
        if (!lobbyValue.setRemoteProfile(nickname, colorId) ||
            !lobbyValue.setPing(ping)) {
            return false
        }
        return markNetworkConnected()
    }

    Bool markNetworkDisconnected() {
        if (networkStatusValue == gameShellNetworkIdle()) { return false }
        networkRequestValue = 0
        networkStatusValue = gameShellNetworkIdle()
        lobbyValue.leave()
        return true
    }

    Bool setNetworkAddress(
        Int one, Int two, Int three, Int four, Int nextPort
    ) {
        if (networkRequestValue != 0 ||
            one < 0 || one > 255 || two < 0 || two > 255 ||
            three < 0 || three > 255 || four < 0 || four > 255 ||
            nextPort <= 0 || nextPort > 65535) {
            return false
        }
        addressOneValue = one
        addressTwoValue = two
        addressThreeValue = three
        addressFourValue = four
        portValue = nextPort
        return true
    }

    Int optionCount() {
        if (screenValue == gameShellScreenMain()) { return 6 }
        if (screenValue == gameShellScreenOptions()) { return 10 }
        if (screenValue == gameShellScreenMultiplayer()) { return 7 }
        if (screenValue == gameShellScreenKutter()) { return 10 }
        if (screenValue == gameShellScreenKutterLevel()) { return 10 }
        if (screenValue == gameShellScreenAccessibility()) { return 4 }
        return 0
    }

    Bool moveSelection(Int direction) {
        var count = optionCount()
        if (count <= 0 || (direction != -1 && direction != 1)) { return false }
        selectionValue = selectionValue + direction
        if (selectionValue < 0) { selectionValue = count - 1 }
        if (selectionValue >= count) { selectionValue = 0 }
        return true
    }

    Bool adjustOption(Int direction) {
        if (direction != -1 && direction != 1) { return false }
        if (selectionValue == 0) {
            resolutionValue = resolutionValue + direction
            if (resolutionValue < 0) { resolutionValue = 3 }
            if (resolutionValue > 3) { resolutionValue = 0 }
        } else if (selectionValue == 1) {
            displayModeValue = displayModeValue + direction
            if (displayModeValue < 0) { displayModeValue = 2 }
            if (displayModeValue > 2) { displayModeValue = 0 }
        } else if (selectionValue == 2) {
            effectsVolumeValue = effectsVolumeValue + direction * 10
            if (effectsVolumeValue < 0) { effectsVolumeValue = 0 }
            if (effectsVolumeValue > 100) { effectsVolumeValue = 100 }
        } else if (selectionValue == 3) {
            musicVolumeValue = musicVolumeValue + direction * 10
            if (musicVolumeValue < 0) { musicVolumeValue = 0 }
            if (musicVolumeValue > 100) { musicVolumeValue = 100 }
        } else if (selectionValue == 4) {
            textSizeValue = textSizeValue + direction
            if (textSizeValue < 0) { textSizeValue = 2 }
            if (textSizeValue > 2) { textSizeValue = 0 }
        } else if (selectionValue == 5) {
            var nameId = lobbyValue.localNameId() + direction
            if (nameId < 1) { nameId = 4 }
            if (nameId > 4) { nameId = 1 }
            if (!lobbyValue.setLocalNameId(nameId)) { return false }
        } else if (selectionValue == 6) {
            var colorId = lobbyValue.localColorId() + direction
            if (colorId < 0) { colorId = 4 }
            if (colorId > 4) { colorId = 0 }
            if (!setLocalColor(colorId)) { return false }
        } else if (selectionValue == 7) {
            var kind = lobbyValue.localAnimalKind()
            if (kind == multiplayerAnimalGoose()) {
                kind = multiplayerAnimalCat()
            } else {
                kind = multiplayerAnimalGoose()
            }
            if (!setLocalAnimalKind(kind)) { return false }
        } else {
            return false
        }
        if (!themeValue.setTextScale(textSizeValue + 1)) { return false }
        settingsRevisionValue = settingsRevisionValue + 1
        displayApplyResultValue = 0
        return true
    }
    Bool adjustAccessibilityOption(Int direction) {
        if (direction != -1 && direction != 1) { return false }
        if (selectionValue == 0) {
            hudScaleValue = hudScaleValue + direction
            if (hudScaleValue < 0) { hudScaleValue = 2 }
            if (hudScaleValue > 2) { hudScaleValue = 0 }
        } else if (selectionValue == 1) {
            tacticalMapValue = direction > 0
        } else if (selectionValue == 2) {
            highContrastValue = direction > 0
        } else {
            return false
        }
        if (!themeValue.setHighContrast(highContrastValue)) { return false }
        settingsRevisionValue = settingsRevisionValue + 1
        return true
    }

    Int selectedAddressValue() {
        if (networkAddressFieldValue == 0) { return addressOneValue }
        if (networkAddressFieldValue == 1) { return addressTwoValue }
        if (networkAddressFieldValue == 2) { return addressThreeValue }
        return addressFourValue
    }

    void storeSelectedAddressValue(Int value) {
        if (networkAddressFieldValue == 0) {
            addressOneValue = value
        } else if (networkAddressFieldValue == 1) {
            addressTwoValue = value
        } else if (networkAddressFieldValue == 2) {
            addressThreeValue = value
        } else {
            addressFourValue = value
        }
    }

    Bool editNetworkValue(Int action) {
        if (!networkEditingValue) { return false }
        if (action == gameShellActionActivate() || action == gameShellActionBack()) {
            networkEditingValue = false
            return true
        }
        if (selectionValue == 3) {
            if (action == gameShellActionLeft()) {
                networkAddressFieldValue = networkAddressFieldValue - 1
                if (networkAddressFieldValue < 0) { networkAddressFieldValue = 3 }
                return true
            }
            if (action == gameShellActionRight()) {
                networkAddressFieldValue = networkAddressFieldValue + 1
                if (networkAddressFieldValue > 3) { networkAddressFieldValue = 0 }
                return true
            }
            var nextValue = selectedAddressValue()
            if (action == gameShellActionUp()) { nextValue = nextValue + 1 }
            if (action == gameShellActionDown()) { nextValue = nextValue - 1 }
            if (nextValue < 0) { nextValue = 255 }
            if (nextValue > 255) { nextValue = 0 }
            storeSelectedAddressValue(nextValue)
            return action == gameShellActionUp() || action == gameShellActionDown()
        }
        if (selectionValue == 4) {
            var change = 0
            if (action == gameShellActionLeft()) { change = -100 }
            if (action == gameShellActionRight()) { change = 100 }
            if (action == gameShellActionUp()) { change = 1 }
            if (action == gameShellActionDown()) { change = -1 }
            if (change == 0) { return false }
            portValue = portValue + change
            if (portValue < 1024) { portValue = 65535 }
            if (portValue > 65535) { portValue = 1024 }
            return true
        }
        return false
    }

    Bool activateMain() {
        if (selectionValue == 0) {
            screenValue = gameShellScreenGame()
            selectionValue = 0
            gameplayEntryPendingValue = true
        } else if (selectionValue == 1) {
            screenValue = gameShellScreenMultiplayer()
            selectionValue = 0
        } else if (selectionValue == 2) {
            screenValue = gameShellScreenOptions()
            selectionValue = 0
        } else if (selectionValue == 3) {
            screenValue = gameShellScreenAccessibility()
            selectionValue = 0
        } else if (selectionValue == 4) {
            screenValue = gameShellScreenKutter()
            selectionValue = 0
        } else {
            quitRequestedValue = true
        }
        return true
    }

    Bool activateOptions() {
        if (selectionValue <= 7) { return adjustOption(1) }
        if (selectionValue == 8) {
            if (displayApplyPendingValue) { return false }
            displayApplyPendingValue = true
            displayApplyResultValue = 0
            return true
        }
        screenValue = gameShellScreenMain()
        selectionValue = 0
        return true
    }
    Bool activateAccessibility() {
        if (selectionValue <= 2) { return adjustAccessibilityOption(1) }
        screenValue = gameShellScreenMain()
        selectionValue = 3
        return true
    }

    Bool activateMultiplayer() {
        if (selectionValue == 3 || selectionValue == 4) {
            networkEditingValue = true
            return true
        }
        if (selectionValue == 5) {
            if (networkStatusValue != gameShellNetworkConnected() ||
                !lobbyValue.remoteConnected()) {
                return false
            }
            return lobbyValue.setLocalReady(!lobbyValue.localReady())
        }
        if (selectionValue == 6) {
            screenValue = gameShellScreenMain()
            selectionValue = 1
            return true
        }
        if (networkRequestValue != 0) { return false }
        if (selectionValue == 0) {
            if (networkStatusValue != gameShellNetworkIdle() &&
                networkStatusValue != gameShellNetworkFailed()) { return false }
            if (!lobbyValue.beginHost(
                    lobbyValue.room(), lobbyValue.localNameId())) {
                return false
            }
            networkRequestValue = gameShellNetworkHostRequest()
            return true
        }
        if (selectionValue == 1) {
            if (networkStatusValue != gameShellNetworkIdle() &&
                networkStatusValue != gameShellNetworkFailed()) { return false }
            if (!lobbyValue.beginJoin(
                    lobbyValue.room(), lobbyValue.localNameId())) {
                return false
            }
            networkRequestValue = gameShellNetworkJoinRequest()
            return true
        }
        if (networkStatusValue == gameShellNetworkIdle()) { return false }
        networkRequestValue = gameShellNetworkLeaveRequest()
        return true
    }

    Bool activateKutter() {
        if (selectionValue == 9) {
            screenValue = gameShellScreenMain()
            selectionValue = 4
            return true
        }
        if (selectionValue == 2) {
            screenValue = gameShellScreenKutterLevel()
            selectionValue = 0
            return true
        }
        if (!kutterValue.begin(kutterValue.revision())) { return false }
        var staged = false
        if (selectionValue == 0) {
            staged = kutterValue.stageCollisionVisible(
                !kutterValue.collisionVisible())
        } else if (selectionValue == 1) {
            staged = kutterValue.stageAiVisible(!kutterValue.aiVisible())
        } else if (selectionValue == 2) {
            staged = kutterValue.stageEntity(
                1, kutterValue.revision() * 10, 0, 0)
        } else if (selectionValue == 3) {
            staged = kutterValue.stageSpawn(2001)
        } else if (selectionValue == 4) {
            staged = kutterValue.stageAsset(greyboxCatalogValue.assetToken(0))
        } else if (selectionValue == 5) {
            staged = kutterValue.stageEncounter(
                3001, 10 + kutterValue.revision())
        } else if (selectionValue == 6) {
            staged = kutterValue.stageItem(
                    4001, 20 + kutterValue.revision()) &&
                kutterValue.stageWeapon(5001) &&
                kutterValue.stageLoot(6001)
        } else if (selectionValue == 7) {
            staged = kutterValue.stageSkill(
                7001, 1 + kutterValue.skillRank())
        } else if (selectionValue == 8) {
            staged = kutterValue.stagePlayActive(!kutterValue.playActive())
        }
        if (!staged) {
            kutterValue.discard()
            return false
        }
        return kutterValue.publish()
    }

    Bool handleKutterLevelAction(Int action) {
        if (action < gameShellActionUp() || action > gameShellActionBack()) {
            return false
        }
        if (editorHierarchyKeyboardFocusValue) {
            if (action == gameShellActionBack() ||
                action == gameShellActionActivate()) {
                editorHierarchyKeyboardFocusValue = false
                return true
            }
            if (action == gameShellActionUp()) {
                return moveHierarchySelection(-1)
            }
            if (action == gameShellActionDown()) {
                return moveHierarchySelection(1)
            }
            return false
        }
        if (editorAssetBrowserOpenValue) {
            if (action == gameShellActionBack()) {
                editorAssetBrowserOpenValue = false
                return true
            }
            if (action == gameShellActionUp() ||
                action == gameShellActionDown()) {
                return moveSelection(
                    if (action == gameShellActionUp()) -1 else 1)
            }
            if (action == gameShellActionLeft() ||
                action == gameShellActionRight()) {
                var direction = if (action == gameShellActionLeft()) -1 else 1
                if (selectionValue == 8) { return cycleEditorAssetPage(-1) }
                if (selectionValue == 9) { return cycleEditorAssetPage(1) }
                return cycleEditorAssetPage(direction)
            }
            if (action == gameShellActionActivate()) {
                if (selectionValue == 0) {
                    editorAssetBrowserOpenValue = false
                    return true
                }
                if (selectionValue >= 1 && selectionValue <= 7) {
                    return selectEditorAsset(
                        editorAssetPageValue * 7 + selectionValue - 1)
                }
                if (selectionValue == 8) {
                    return cycleEditorAssetPage(-1)
                }
                if (selectionValue == 9) {
                    return cycleEditorAssetPage(1)
                }
            }
            return false
        }
        if (action == gameShellActionUp() ||
            action == gameShellActionDown()) {
            return moveSelection(
                if (action == gameShellActionUp()) -1 else 1)
        }
        if (action == gameShellActionBack()) {
            if (editorMoveArmedValue) {
                editorMoveArmedValue = false
                return true
            }
            screenValue = gameShellScreenKutter()
            selectionValue = 2
            return true
        }
        if (action == gameShellActionLeft() ||
            action == gameShellActionRight()) {
            var direction = if (action == gameShellActionLeft()) -1 else 1
            if (selectionValue == 0) {
                if (levelEditorValue.tool() == kutterLevelToolProp()) {
                    return cycleEditorAsset(direction)
                }
                return levelEditorValue.cycleTool(direction)
            }
            if (selectionValue == 1) {
                return levelEditorValue.moveCursor(0, direction)
            }
            if (selectionValue == 2) {
                return levelEditorValue.moveCursor(1, direction)
            }
            if (selectionValue == 3) {
                return levelEditorValue.cycleGrid(direction)
            }
            if (selectionValue == 6) {
                return levelEditorValue.undo()
            }
            if (selectionValue == 7) {
                return levelEditorValue.redo()
            }
            if (selectionValue == 5) {
                return levelEditorValue.rotateSelected(direction)
            }
            if (selectionValue == 8) {
                return levelEditorValue.resizeSelected(
                    editorScaleAxisValue, direction)
            }
            return false
        }
        if (action != gameShellActionActivate()) { return false }
        if (selectionValue == 0) {
            return levelEditorValue.assignAssetToSelected(
                selectedEditorAssetToken())
        }
        if (selectionValue == 4) {
            if (levelEditorValue.tool() == kutterLevelToolProp()) {
                return levelEditorValue.addAssetAtCursor(
                    selectedEditorAssetToken())
            }
            return levelEditorValue.applyTool()
        }
        if (selectionValue == 5) {
            editorMoveArmedValue = !editorMoveArmedValue
            return true
        }
        if (selectionValue == 6) { return levelEditorValue.undo() }
        if (selectionValue == 7) { return levelEditorValue.redo() }
        if (selectionValue == 8) { return levelEditorValue.togglePreview() }
        if (selectionValue == 9) {
            screenValue = gameShellScreenKutter()
            selectionValue = 2
            return true
        }
        return false
    }
    Bool handleAccessibilityAction(Int action) {
        if (action < gameShellActionUp() || action > gameShellActionBack()) {
            return false
        }
        if (action == gameShellActionUp() || action == gameShellActionDown()) {
            return moveSelection(
                if (action == gameShellActionUp()) -1 else 1)
        }
        if (action == gameShellActionBack()) {
            screenValue = gameShellScreenMain()
            selectionValue = 3
            return true
        }
        if (action == gameShellActionLeft() ||
            action == gameShellActionRight()) {
            return adjustAccessibilityOption(
                if (action == gameShellActionLeft()) -1 else 1)
        }
        if (action == gameShellActionActivate()) {
            return activateAccessibility()
        }
        return false
    }

    Bool handleAction(Int action) {
        if (action < gameShellActionUp() || action > gameShellActionBack()) {
            return false
        }
        if (screenValue == gameShellScreenGame()) {
            if (action == gameShellActionBack()) {
                screenValue = gameShellScreenMain()
                selectionValue = 0
                gameplayEntryPendingValue = false
                return true
            }
            return false
        }
        if (screenValue == gameShellScreenAccessibility()) {
            return handleAccessibilityAction(action)
        }
        if (screenValue == gameShellScreenKutterLevel()) {
            return handleKutterLevelAction(action)
        }
        if (screenValue == gameShellScreenMultiplayer() && networkEditingValue) {
            return editNetworkValue(action)
        }
        if (action == gameShellActionUp()) { return moveSelection(-1) }
        if (action == gameShellActionDown()) { return moveSelection(1) }
        if (action == gameShellActionBack()) {
            if (screenValue == gameShellScreenMain()) {
                quitRequestedValue = true
            } else {
                var previous = screenValue
                screenValue = gameShellScreenMain()
                if (previous == gameShellScreenKutter()) {
                    selectionValue = 4
                } else {
                    selectionValue = 0
                }
            }
            return true
        }
        if (action == gameShellActionLeft() || action == gameShellActionRight()) {
            if (screenValue == gameShellScreenOptions()) {
                return adjustOption(if (action == gameShellActionLeft()) -1 else 1)
            }
            if (screenValue == gameShellScreenAccessibility()) {
                return adjustAccessibilityOption(
                    if (action == gameShellActionLeft()) -1 else 1)
            }
            if (screenValue == gameShellScreenKutter()) {
                return if (action == gameShellActionLeft())
                    kutterValue.undo() else kutterValue.redo()
            }
            return false
        }
        if (screenValue == gameShellScreenMain()) { return activateMain() }
        if (screenValue == gameShellScreenOptions()) { return activateOptions() }
        if (screenValue == gameShellScreenAccessibility()) {
            return activateAccessibility()
        }
        if (screenValue == gameShellScreenKutter()) { return activateKutter() }
        return activateMultiplayer()
    }

    Bool handlePointerMove(Int x, Int y) {
        if (!editorInspectorResizeActiveValue ||
            screenValue != gameShellScreenKutterLevel()) {
            return false
        }
        var nextLeft = x
        if (nextLeft < 30) { nextLeft = 30 }
        if (nextLeft > 48) { nextLeft = 48 }
        editorInspectorLeftValue = nextLeft
        return true
    }

    Bool endPointerDrag() {
        if (!editorInspectorResizeActiveValue) { return false }
        editorInspectorResizeActiveValue = false
        return true
    }

    Bool handlePointer(Int x, Int y) {
        if (x < -100 || x > 100 || y < -100 || y > 100 ||
            screenValue == gameShellScreenGame()) { return false }
        if (screenValue == gameShellScreenMain()) {
            if (y >= 25 && y <= 45) { selectionValue = 0 }
            else if (y >= 3 && y <= 23) { selectionValue = 1 }
            else if (y >= -19 && y <= 1) { selectionValue = 2 }
            else if (y >= -41 && y <= -21) { selectionValue = 3 }
            else if (y >= -63 && y <= -43) { selectionValue = 4 }
            else if (y >= -85 && y <= -65) { selectionValue = 5 }
            else { return false }
            return activateMain()
        }
        if (screenValue == gameShellScreenOptions()) {
            if (y >= 38 && y <= 50) { selectionValue = 0 }
            else if (y >= 25 && y <= 37) { selectionValue = 1 }
            else if (y >= 12 && y <= 24) { selectionValue = 2 }
            else if (y >= -1 && y <= 11) { selectionValue = 3 }
            else if (y >= -14 && y <= -2) { selectionValue = 4 }
            else if (y >= -27 && y <= -15) { selectionValue = 5 }
            else if (y >= -40 && y <= -28) { selectionValue = 6 }
            else if (y >= -53 && y <= -41) { selectionValue = 7 }
            else if (y >= -66 && y <= -54) { selectionValue = 8 }
            else if (y >= -79 && y <= -67) { selectionValue = 9 }
            else { return false }
            return activateOptions()
        }
        if (screenValue == gameShellScreenAccessibility()) {
            if (y >= 36 && y <= 52) { selectionValue = 0 }
            else if (y >= 16 && y <= 32) { selectionValue = 1 }
            else if (y >= -4 && y <= 12) { selectionValue = 2 }
            else if (y >= -28 && y <= -12) { selectionValue = 3 }
            else { return false }
            return activateAccessibility()
        }
        if (screenValue == gameShellScreenKutter()) {
            if (y >= 38 && y <= 50) { selectionValue = 0 }
            else if (y >= 24 && y <= 36) { selectionValue = 1 }
            else if (y >= 10 && y <= 22) { selectionValue = 2 }
            else if (y >= -4 && y <= 8) { selectionValue = 3 }
            else if (y >= -18 && y <= -6) { selectionValue = 4 }
            else if (y >= -32 && y <= -20) { selectionValue = 5 }
            else if (y >= -46 && y <= -34) { selectionValue = 6 }
            else if (y >= -60 && y <= -48) { selectionValue = 7 }
            else if (y >= -74 && y <= -62) { selectionValue = 8 }
            else if (y >= -88 && y <= -76) { selectionValue = 9 }
            else { return false }
            return activateKutter()
        }
        if (screenValue == gameShellScreenKutterLevel()) {
            editorHierarchyKeyboardFocusValue = false
            if (x >= editorInspectorLeftValue - 2 &&
                x <= editorInspectorLeftValue + 2 &&
                y >= -94 && y <= 44) {
                editorInspectorResizeActiveValue = true
                return true
            }
            if (x < -42) {
                editorMoveArmedValue = false
                if (editorAssetBrowserOpenValue) {
                    if (y >= 30 && y <= 40) {
                        if (x < -68) {
                            editorAssetBrowserOpenValue = false
                            return true
                        }
                        return cycleEditorAssetPage(
                            if (x < -56) -1 else 1)
                    }
                    if (y >= 17 && y <= 27) {
                        return selectEditorAsset(editorAssetPageValue * 7)
                    }
                    if (y >= 4 && y <= 14) {
                        return selectEditorAsset(editorAssetPageValue * 7 + 1)
                    }
                    if (y >= -9 && y <= 1) {
                        return selectEditorAsset(editorAssetPageValue * 7 + 2)
                    }
                    if (y >= -22 && y <= -12) {
                        return selectEditorAsset(editorAssetPageValue * 7 + 3)
                    }
                    if (y >= -35 && y <= -25) {
                        return selectEditorAsset(editorAssetPageValue * 7 + 4)
                    }
                    if (y >= -48 && y <= -38) {
                        return selectEditorAsset(editorAssetPageValue * 7 + 5)
                    }
                    if (y >= -61 && y <= -51) {
                        return selectEditorAsset(editorAssetPageValue * 7 + 6)
                    }
                    if (y >= -74 && y <= -64) {
                        return cycleEditorAssetPage(-1)
                    }
                    if (y >= -87 && y <= -77) {
                        return cycleEditorAssetPage(1)
                    }
                    return false
                }
                if (y >= 30 && y <= 40) { selectionValue = 0 }
                else if (y >= 17 && y <= 27) { selectionValue = 1 }
                else if (y >= 4 && y <= 14) { selectionValue = 2 }
                else if (y >= -9 && y <= 1) { selectionValue = 3 }
                else if (y >= -22 && y <= -12) { selectionValue = 4 }
                else if (y >= -35 && y <= -25) { selectionValue = 5 }
                else if (y >= -48 && y <= -38) { selectionValue = 6 }
                else if (y >= -61 && y <= -51) { selectionValue = 7 }
                else if (y >= -74 && y <= -64) { selectionValue = 8 }
                else if (y >= -87 && y <= -77) { selectionValue = 9 }
                else { return false }
                if (selectionValue == 0) {
                    if (x < -68) {
                        return levelEditorValue.cycleTool(
                            if (x < -78) -1 else 1)
                    }
                    editorAssetBrowserOpenValue = true
                    return true
                }
                return handleKutterLevelAction(gameShellActionActivate())
            }
            if (x >= editorInspectorLeftValue && x <= 89) {
                if (y >= 34 && y <= 44) {
                    if (x >= 84) { return cycleEditorHierarchyPage(1) }
                    if (x <= 73) { return cycleEditorHierarchyPage(-1) }
                    return false
                }
                var row = -1
                if (y >= 22 && y <= 33) { row = 0 }
                else if (y >= 10 && y <= 21) { row = 1 }
                else if (y >= -2 && y <= 9) { row = 2 }
                else if (y >= -14 && y <= -3) { row = 3 }
                if (row >= 0) {
                    var nodeIndex = editorHierarchyPageValue * 4 + row
                    if (nodeIndex >= levelEditorValue.nodeCount()) {
                        return false
                    }
                    editorHierarchyKeyboardFocusValue = true
                    return levelEditorValue.selectNode(
                        levelEditorValue.nodeId(nodeIndex))
                }
                if (y >= -36 && y <= -27) {
                    return levelEditorValue.adjustSelectedHeight(
                        if (x < 70) -1 else 1)
                }
                if (y >= -47 && y <= -38) {
                    return levelEditorValue.rotateSelected(
                        if (x < 70) -1 else 1)
                }
                if (y >= -56 && y <= -47) {
                    if (x >= 82) {
                        var selectedIndex = levelEditorValue.document().nodeIndex(
                            levelEditorValue.selectedNode())
                        if (selectedIndex < 0) { return false }
                        var color = levelEditorValue.document().nodeColorValue(
                            selectedIndex)
                        return levelEditorValue.recolorSelected(
                            if (color == 16711615) 16776960 else 16711615)
                    }
                    if (x < 65) { return cycleEditorScaleAxis() }
                    return levelEditorValue.resizeSelected(
                        editorScaleAxisValue, if (x < 72) -1 else 1)
                }
                if (y >= -68 && y <= -58) {
                    if (x < 69) {
                        return focusHierarchyAfter(
                            levelEditorValue.duplicateSelected())
                    }
                    var otherNode = 0
                    for (var index = 0;
                         index < levelEditorValue.nodeCount();
                         index = index + 1) {
                        if (levelEditorValue.nodeId(index) !=
                            levelEditorValue.selectedNode()) {
                            otherNode = levelEditorValue.nodeId(index)
                            break
                        }
                    }
                    return focusHierarchyAfter(
                        levelEditorValue.groupSelectedWith(otherNode))
                }
                if (y >= -84 && y <= -74) {
                    if (x < 69) {
                        return focusHierarchyAfter(
                            levelEditorValue.ungroupSelected())
                    }
                    return focusHierarchyAfter(
                        levelEditorValue.removeSelected())
                }
                return false
            }
            if (x >= -39 && x < editorInspectorLeftValue &&
                y >= -67 && y <= 37) {
                var worldX = (x + 34) * 25
                var worldZ = (y + 66) * 20
                if (!levelEditorValue.setCursor(worldX, worldZ)) {
                    return false
                }
                if (editorMoveArmedValue) {
                    var moved = levelEditorValue.moveSelectedToCursor()
                    if (moved) {
                        editorMoveArmedValue = false
                        focusHierarchySelection()
                    }
                    return moved
                }
                if (levelEditorValue.tool() == kutterLevelToolSelect()) {
                    var selectedAtCursor = levelEditorValue.selectAtCursor()
                    if (selectedAtCursor) { focusHierarchySelection() }
                    return selectedAtCursor
                }
                selectionValue = 4
                var changed = false
                if (levelEditorValue.tool() == kutterLevelToolProp()) {
                    changed = levelEditorValue.addAssetAtCursor(
                        selectedEditorAssetToken())
                } else {
                    changed = levelEditorValue.applyTool()
                }
                if (changed) { focusHierarchySelection() }
                return changed
            }
            return false
        }
        if (y >= 8 && y <= 20) { selectionValue = 0 }
        else if (y >= -8 && y <= 8) { selectionValue = 1 }
        else if (y >= -24 && y <= -8) { selectionValue = 2 }
        else if (y >= -40 && y <= -24) { selectionValue = 3 }
        else if (y >= -56 && y <= -40) { selectionValue = 4 }
        else if (y >= -72 && y <= -56) { selectionValue = 5 }
        else if (y >= -88 && y <= -72) { selectionValue = 6 }
        else { return false }
        return activateMultiplayer()
    }

    Bool pushQuad(
        FrameStaging target, Int resource,
        Int left, Int bottom, Int right, Int top
    ) {
        return kookieUiNativePushQuad(
            target, resource, left, bottom, right, top)
    }

    Bool pushScreenFrame(FrameStaging target) {
        if (screenValue == gameShellScreenKutterLevel()) { return true }
        return pushQuad(
                target, kookieUiNativeResourceBackground(),
                -100, -100, 100, 100) &&
            pushQuad(
                target, kookieUiNativeResourceSurface(),
                -96, -96, 96, 96) &&
            pushQuad(
                target, kookieUiNativeResourceBackground(),
                -94, -94, 94, 94) &&
            pushQuad(
                target, kookieUiNativeResourceFocus(),
                -94, 88, 94, 90) &&
            pushQuad(
                target, kookieUiNativeResourceFocus(),
                -94, -90, -92, 88) &&
            pushQuad(
                target, kookieUiNativeResourceFocus(),
                92, -90, 94, 88) &&
            pushQuad(
                target, kookieUiNativeResourceBrandMark(),
                78, 70, 90, 82)
    }
    Int menuTitleBottom() { return 72 }
    Int menuSubtitleBottom() { return 57 }
    Int menuStatusBottom() { return 49 }


    Int selectedTextColor() {
        return themeValue.accentColor()
    }
    Int normalTextColor() {
        return themeValue.foregroundColor()
    }
    Int mutedTextColor() {
        return themeValue.mutedColor()
    }

    Int accentTextColor() { return themeValue.accentColor() }
    Int successTextColor() { return themeValue.successColor() }
    Int dangerTextColor() { return themeValue.dangerColor() }


    Int textWidth(String text, Int scale) {
        return kookieUiNativeTextWidth(text, scale)
    }
    Int fittedTextScale(String text, Int desiredScale, Int maxWidth) {
        var scale = desiredScale
        if (scale < 1) { scale = 1 }
        if (maxWidth < uiFontGlyphWidth()) {
            return 1
        }
        while (scale > 1 && textWidth(text, scale) > maxWidth) {
            scale = scale - 1
        }
        return scale
    }
    Int menuRowTextScale(Int desiredScale, Int rowHeight) {
        var scale = desiredScale
        if (scale < 1) { scale = 1 }
        var safeHeight = rowHeight - 2
        if (safeHeight < uiFontGlyphHeight()) {
            safeHeight = uiFontGlyphHeight()
        }
        while (scale > 1 &&
            uiFontGlyphHeight() * scale > safeHeight) {
            scale = scale - 1
        }
        return scale
    }


    Bool pushTextWithFont(
        FrameStaging target, String text,
        Int left, Int bottom, Int scale, Int color, Int font
    ) {
        if (scale <= 0 || color < 0 || color > 4 ||
            font < 0 || font >= uiFontCount()) { return false }
        var safeLeft = left
        var width = textWidth(text, scale)
        if (safeLeft < -100) { safeLeft = -100 }
        if (safeLeft + width > 100) {
            safeLeft = 100 - width
            if (safeLeft < -100) { safeLeft = -100 }
        }
        return kookieUiNativePushTextWithFont(
            target, text, safeLeft, bottom, scale, color, font)
    }
    Bool pushText(
        FrameStaging target, String text,
        Int left, Int bottom, Int scale, Int color
    ) {
        return pushTextWithFont(
            target, text, left, bottom, scale, color,
            uiFontDefaultBody())
    }

    Bool pushCenteredTextWithFont(
        FrameStaging target, String text,
        Int bottom, Int scale, Int color, Int font
    ) {
        return pushTextWithFont(target, text,
            -textWidth(text, scale) / 2,
            bottom, scale, color, font)
    }
    Bool pushCenteredText(
        FrameStaging target, String text,
        Int bottom, Int scale, Int color
    ) {
        return pushCenteredTextWithFont(
            target, text, bottom, scale, color,
            uiFontDefaultBody())
    }
    Bool pushTextFitted(
        FrameStaging target, String text,
        Int left, Int bottom, Int desiredScale, Int color, Int maxWidth
    ) {
        return pushText(
            target, text, left, bottom,
            fittedTextScale(text, desiredScale, maxWidth), color)
    }
    Bool pushCenteredTextFitted(
        FrameStaging target, String text,
        Int bottom, Int desiredScale, Int color, Int maxWidth
    ) {
        var scale = fittedTextScale(text, desiredScale, maxWidth)
        return pushCenteredText(target, text, bottom, scale, color)
    }
    Bool pushCenteredTextWithFontFitted(
        FrameStaging target, String text,
        Int bottom, Int desiredScale, Int color, Int font, Int maxWidth
    ) {
        var scale = fittedTextScale(text, desiredScale, maxWidth)
        return pushCenteredTextWithFont(
            target, text, bottom, scale, color, font)
    }



    Int numberWidth(Int value, Int scale) {
        var digits = 1
        var remaining = value
        while (remaining >= 10) {
            digits = digits + 1
            remaining = remaining / 10
        }
        return digits * uiFontGlyphAdvance() * scale - scale
    }

    String digitText(Int digit) {
        if (digit == 0) { return "0" }
        if (digit == 1) { return "1" }
        if (digit == 2) { return "2" }
        if (digit == 3) { return "3" }
        if (digit == 4) { return "4" }
        if (digit == 5) { return "5" }
        if (digit == 6) { return "6" }
        if (digit == 7) { return "7" }
        if (digit == 8) { return "8" }
        if (digit == 9) { return "9" }
        return ""
    }

    Bool pushNumber(
        FrameStaging target, Int value,
        Int left, Int bottom, Int scale, Int color
    ) {
        if (value < 0) { return false }
        var divisor = 1
        while (value / divisor >= 10) { divisor = divisor * 10 }
        var x = left
        while (divisor > 0) {
            var digit = (value / divisor) % 10
            if (!pushText(target, digitText(digit), x, bottom, scale, color)) {
                return false
            }
            x = x + uiFontGlyphAdvance() * scale
            divisor = divisor / 10
        }
        return true
    }

    Bool pushSignedNumber(
        FrameStaging target, Int value,
        Int left, Int bottom, Int scale, Int color
    ) {
        if (value >= 0) {
            return pushNumber(target, value, left, bottom, scale, color)
        }
        return pushText(target, "-", left, bottom, scale, color) &&
            pushNumber(target, -value,
                left + uiFontGlyphAdvance() * scale, bottom, scale, color)
    }


    Bool pushSelectionPanel(
        FrameStaging target, Int row, Int bottom, Int top
    ) {
        var resource = themeValue.panelResource()
        if (selectionValue == row) {
            resource = themeValue.selectedPanelResource()
        }
        return pushQuad(target, resource, -88, bottom, 88, top) &&
            pushQuad(
                target, kookieUiNativeResourceBackground(),
                -86, bottom + 1, 86, top - 1) &&
            (if (selectionValue == row)
                pushQuad(
                    target, themeValue.focusRailResource(),
                    -88, bottom, -86, top) &&
                    pushQuad(
                        target, themeValue.focusRailResource(),
                        86, bottom, 88, top) &&
                    pushQuad(
                        target, themeValue.focusRailResource(),
                        -86, top - 1, 86, top) &&
                    pushQuad(
                        target, themeValue.focusRailResource(),
                        -86, bottom, 86, bottom + 1)
            else true)

    }


    Bool stageMain(FrameStaging target) {
        var scale = menuRowTextScale(textSize(), 20)
        var itemColor = normalTextColor()
        return pushScreenFrame(target) &&
            pushCenteredTextWithFontFitted(
                target, uiGameTitle(), menuTitleBottom(), 2, accentTextColor(),
                uiFontDefaultDisplay(), 184) &&
            pushCenteredTextFitted(target, "OLD SCHOOL COOP",
                menuSubtitleBottom(), 1, mutedTextColor(), 184) &&
            pushCenteredTextFitted(target, "G1 READY", menuStatusBottom(),
                1, successTextColor(), 184) &&
            pushSelectionPanel(target, 0, 25, 45) &&
            pushCenteredTextFitted(target, "PLAY", 29, scale,
                if (selectionValue == 0) selectedTextColor() else itemColor,
                184) &&
            pushSelectionPanel(target, 1, 3, 23) &&
            pushCenteredTextFitted(target, "MULTIPLAYER", 7, scale,
                if (selectionValue == 1) selectedTextColor() else itemColor,
                184) &&
            pushSelectionPanel(target, 2, -19, 1) &&
            pushCenteredTextFitted(target, "OPTIONS", -15, scale,
                if (selectionValue == 2) selectedTextColor() else itemColor,
                184) &&
            pushSelectionPanel(target, 3, -41, -21) &&
            pushCenteredTextFitted(target, "ACCESSIBILITY", -37, scale,
                if (selectionValue == 3) selectedTextColor() else itemColor,
                184) &&
            pushSelectionPanel(target, 4, -63, -43) &&
            pushCenteredTextFitted(target, "KUTTER", -59, scale,
                if (selectionValue == 4) selectedTextColor() else itemColor,
                184) &&
            pushSelectionPanel(target, 5, -85, -65) &&
            pushCenteredTextFitted(target, "QUIT", -81, scale,
                if (selectionValue == 5) dangerTextColor() else itemColor,
                184) &&
            pushCenteredTextFitted(target, "ARROWS ENTER ESC", -97, 1,
                mutedTextColor(), 184)
    }

    String resolutionLabel() {
        if (resolutionValue == 1) { return "1600X900" }
        if (resolutionValue == 2) { return "1920X1080" }
        if (resolutionValue == 3) { return "2560X1440" }
        return "1280X720"
    }

    String displayModeLabel() {
        if (displayModeValue == 1) { return "BORDERLESS" }
        if (displayModeValue == 2) { return "FULLSCREEN" }
        return "WINDOWED"
    }

    String textSizeLabel() {
        if (textSizeValue == 1) { return "MEDIUM" }
        if (textSizeValue == 2) { return "LARGE" }
        return "SMALL"
    }

    Bool pushVolume(
        FrameStaging target, Int value, Int left, Int bottom, Int color
    ) {
        if (!pushNumber(target, value, left, bottom, 1, color) ||
            !pushText(target, "%", left + numberWidth(value, 1) + 2,
                bottom, 1, color)) { return false }
        var filled = value / 10
        for (var index = 0; index < 10; index = index + 1) {
            var resource = kookieUiNativeResourceMuted()
            if (index < filled) {
                resource = kookieUiNativeResourceFocus()
            }
            if (!pushQuad(target, resource,
                    54 + index * 3, bottom, 56 + index * 3, bottom + 7)) {
                return false
            }
        }
        return true
    }

    Bool stageOptions(FrameStaging target) {
        var scale = menuRowTextScale(textSize(), 12)
        var rowColor = normalTextColor()
        var resultColor = successTextColor()
        var resultText = "APPLY"
        if (displayApplyPendingValue) {
            resultColor = mutedTextColor()
            resultText = "APPLYING"
        } else if (displayApplyResultValue == 1) {
            resultText = "APPLIED"
        } else if (displayApplyResultValue == 2) {
            resultColor = dangerTextColor()
            resultText = "FAILED"
        }
        return pushScreenFrame(target) &&
            pushCenteredTextFitted(target, "OPTIONS",
                menuTitleBottom(), 2, accentTextColor(), 184) &&
            pushCenteredTextFitted(target, "TUNE THE RUN",
                menuSubtitleBottom(), 1, successTextColor(), 184) &&
            pushSelectionPanel(target, 0, 38, 50) &&
            pushTextFitted(target, "RESOLUTION", -84, 40, scale,
                rowColor, 168) &&
            pushTextFitted(target, resolutionLabel(), 20, 40, scale,
                mutedTextColor(), 76) &&
            pushSelectionPanel(target, 1, 25, 37) &&
            pushTextFitted(target, "DISPLAY MODE", -84, 27, scale,
                rowColor, 168) &&
            pushTextFitted(target, displayModeLabel(), 20, 27, scale,
                mutedTextColor(), 76) &&
            pushSelectionPanel(target, 2, 12, 24) &&
            pushTextFitted(target, "FX VOLUME", -84, 14, scale,
                rowColor, 168) &&
            pushVolume(target, effectsVolumeValue, 20, 14, mutedTextColor()) &&
            pushSelectionPanel(target, 3, -1, 11) &&
            pushTextFitted(target, "MUSIC VOLUME", -84, 1, scale,
                rowColor, 168) &&
            pushVolume(target, musicVolumeValue, 20, 1, mutedTextColor()) &&
