    String networkStatusLabel() {
        if (networkStatusValue == gameShellNetworkHosting()) { return "HOSTING" }
        if (networkStatusValue == gameShellNetworkJoining()) { return "CONNECTING" }
        if (networkStatusValue == gameShellNetworkConnected()) { return "CONNECTED" }
        if (networkStatusValue == gameShellNetworkFailed()) { return "FAILED CHECK KEY" }
        return "OFFLINE"
    }

    Int networkStatusColor() {
        if (networkStatusValue == gameShellNetworkConnected()) {
            return successTextColor()
        }
        if (networkStatusValue == gameShellNetworkFailed()) {
            return dangerTextColor()
        }
        if (networkStatusValue == gameShellNetworkHosting() ||
            networkStatusValue == gameShellNetworkJoining()) {
            return mutedTextColor()
        }
        return normalTextColor()
    }

    String lobbyPhaseLabel() {
        if (lobbyValue.phase() == multiplayerLobbyPhaseHosting()) {
            return "HOSTING"
        }
        if (lobbyValue.phase() == multiplayerLobbyPhaseJoining()) {
            return "CONNECTING"
        }
        if (lobbyValue.phase() == multiplayerLobbyPhaseWaiting()) {
            return "WAITING FOR PEER"
        }
        if (lobbyValue.phase() == multiplayerLobbyPhaseReady()) {
            return "READY"
        }
        if (lobbyValue.phase() == multiplayerLobbyPhaseConnected()) {
            return "CONNECTED"
        }
        if (lobbyValue.phase() == multiplayerLobbyPhaseFailed()) {
            return "FAILED"
        }
        return "OFFLINE"
    }

    Int lobbyPhaseColor() {
        if (lobbyValue.phase() == multiplayerLobbyPhaseFailed()) {
            return dangerTextColor()
        }
        if (lobbyValue.phase() == multiplayerLobbyPhaseConnected() ||
            lobbyValue.phase() == multiplayerLobbyPhaseReady()) {
            return successTextColor()
        }
        if (lobbyValue.phase() == multiplayerLobbyPhaseHosting() ||
            lobbyValue.phase() == multiplayerLobbyPhaseJoining() ||
            lobbyValue.phase() == multiplayerLobbyPhaseWaiting()) {
            return mutedTextColor()
        }
        return normalTextColor()
    }

    String lobbyErrorLabel() {
        if (lobbyValue.error() == multiplayerLobbyErrorTransport()) {
            return "TRANSPORT ERROR"
        }
        if (lobbyValue.error() == multiplayerLobbyErrorTimeout()) {
            return "TIMEOUT"
        }
        if (lobbyValue.error() == multiplayerLobbyErrorProtocol()) {
            return "PROTOCOL ERROR"
        }
        if (lobbyValue.error() == multiplayerLobbyErrorFull()) {
            return "SESSION FULL"
        }
        if (lobbyValue.error() == multiplayerLobbyErrorRejected()) {
            return "REJECTED"
        }
        return ""
    }

    Bool pushAddress(FrameStaging target, Int bottom) {
        var cursor = 12
        var color = accentTextColor()
        if (!pushNumber(target, addressOneValue, cursor, bottom, 1,
                if (networkEditingValue && networkAddressFieldValue == 0)
                    mutedTextColor() else color)) {
            return false
        }
        cursor = cursor + numberWidth(addressOneValue, 1) + 2
        if (!pushText(target, ".", cursor, bottom, 1, color)) { return false }
        cursor = cursor + 6
        if (!pushNumber(target, addressTwoValue, cursor, bottom, 1,
                if (networkEditingValue && networkAddressFieldValue == 1)
                    mutedTextColor() else color)) {
            return false
        }
        cursor = cursor + numberWidth(addressTwoValue, 1) + 2
        if (!pushText(target, ".", cursor, bottom, 1, color)) { return false }
        cursor = cursor + 6
        if (!pushNumber(target, addressThreeValue, cursor, bottom, 1,
                if (networkEditingValue && networkAddressFieldValue == 2)
                    mutedTextColor() else color)) {
            return false
        }
        cursor = cursor + numberWidth(addressThreeValue, 1) + 2
        if (!pushText(target, ".", cursor, bottom, 1, color)) { return false }
        cursor = cursor + 6
        return pushNumber(target, addressFourValue, cursor, bottom, 1,
            if (networkEditingValue && networkAddressFieldValue == 3)
                mutedTextColor() else color)
    }

    Bool stageMultiplayer(FrameStaging target) {
        var normal = normalTextColor()
        var pingColor = if (lobbyValue.ping() > 0)
            accentTextColor() else normal
        var errorColor = if (lobbyValue.error() == multiplayerLobbyErrorNone())
            normal else dangerTextColor()
        var pingVisible = lobbyValue.ping() > 0
        return pushScreenFrame(target) &&
            pushCenteredText(target, "MULTIPLAYER",
                menuTitleBottom(), 2, accentTextColor()) &&
            pushCenteredText(target, "TWO PLAYER SESSION",
                menuSubtitleBottom(), 1, successTextColor()) &&
            pushCenteredText(target, lobbyPhaseLabel(),
                menuStatusBottom(), 1, lobbyPhaseColor()) &&
            pushText(target, "LOCAL", -84, 39, 1, normal) &&
            pushTextFitted(target, lobbyValue.localNickname(),
                20, 39, 1, lobbyValue.localColorId(), 76) &&
            pushText(target, "PEER", -84, 31, 1, normal) &&
            pushTextFitted(target, lobbyValue.remoteNickname(),
                20, 31, 1,
                if (lobbyValue.remoteConnected())
                    lobbyValue.remoteColorId() else normal, 76) &&
            pushText(target, "ROOM", -84, 23, 1, normal) &&
            pushNumber(target, lobbyValue.room(), -48, 23, 1,
                accentTextColor()) &&
            pushText(target, "PLAYERS", 8, 23, 1, normal) &&
            pushNumber(target, lobbyValue.playerCount(), 56, 23, 1,
                accentTextColor()) &&
            pushText(target, "/2", 68, 23, 1, normal) &&
            pushText(target, "PING", 8, 31, 1, normal) &&
            (if (pingVisible)
                pushNumber(target, lobbyValue.ping(), 38, 31, 1, pingColor)
            else
                pushText(target, "--", 38, 31, 1, pingColor)) &&
            pushSelectionPanel(target, 0, 8, 20) &&
            pushCenteredText(target, "HOST GAME", 11, 1,
                if (selectionValue == 0) selectedTextColor() else normal) &&
            pushSelectionPanel(target, 1, -8, 4) &&
            pushCenteredText(target, "JOIN GAME", -5, 1,
                if (selectionValue == 1) selectedTextColor() else normal) &&
            pushSelectionPanel(target, 2, -24, -12) &&
            pushCenteredText(target, "LEAVE GAME", -21, 1,
                if (selectionValue == 2) dangerTextColor() else normal) &&
            pushSelectionPanel(target, 3, -40, -28) &&
            pushText(target, "ADDRESS", -84, -37, 1, normal) &&
            pushAddress(target, -37) &&
            pushSelectionPanel(target, 4, -56, -44) &&
            pushText(target, "PORT", -84, -53, 1, normal) &&
            pushNumber(target, portValue, 20, -53, 1,
                if (networkEditingValue && selectionValue == 4)
                    mutedTextColor() else accentTextColor()) &&
            pushSelectionPanel(target, 5, -72, -60) &&
            pushCenteredText(target,
                if (lobbyValue.localReady()) "UNREADY" else "READY",
                -69, 1, if (selectionValue == 5) selectedTextColor() else normal) &&
            pushSelectionPanel(target, 6, -88, -76) &&
            pushCenteredText(target, "BACK", -85, 1,
                if (selectionValue == 6) selectedTextColor() else normal) &&
            pushCenteredText(target, lobbyErrorLabel(), -84, 1, errorColor) &&
            pushCenteredText(target,
                if (networkEditingValue) "ARROWS CHANGE ENTER DONE" else "ENTER SELECT ESC BACK",
                -96, 1, mutedTextColor())
    }

    String levelToolLabel() {
        if (levelEditorValue.tool() == kutterLevelToolProp()) { return "PROP" }
        if (levelEditorValue.tool() == kutterLevelToolPlayerSpawn()) {
            return "PLAYER SPAWN"
        }
        if (levelEditorValue.tool() == kutterLevelToolEnemySpawn()) {
            return "ENEMY SPAWN"
        }
        if (levelEditorValue.tool() == kutterLevelToolEncounter()) {
            return "ENCOUNTER"
        }
        if (levelEditorValue.tool() == kutterLevelToolTrigger()) {
            return "TRIGGER"
        }
        if (levelEditorValue.tool() == kutterLevelToolLight()) { return "LIGHT" }
        if (levelEditorValue.tool() == kutterLevelToolErase()) { return "ERASE" }
        return "SELECT"
    }

    String levelNodeLabel(Int index) {
        var kind = levelEditorValue.document().nodeKind(index)
        if (kind == kutterLevelToolPlayerSpawn()) { return "PLAYER" }
        if (kind == kutterLevelToolEnemySpawn()) { return "ENEMY" }
        if (kind == kutterLevelToolEncounter()) { return "ENCOUNTER" }
        if (kind == kutterLevelToolTrigger()) { return "TRIGGER" }
        if (kind == kutterLevelToolLight()) { return "LIGHT" }
        if (kind == kutterLevelToolProp()) { return "PROP" }
        if (kind == kutterLevelNodeGroup()) { return "GROUP" }
        return "NODE"
    }

    Bool pushKutterDockPanel(
        FrameStaging target, Int left, Int bottom, Int right, Int top,
        Bool selected
    ) {
        var panel = themeValue.panelResource()
        if (selected) { panel = themeValue.selectedPanelResource() }
        return pushQuad(target, panel, left, bottom, right, top) &&
            pushQuad(
                target, kookieUiNativeResourceBackground(),
                left + 1, bottom + 1, right - 1, top - 1)
    }

    Bool stageKutterEditorViewport(FrameStaging target) {
        if (!pushQuad(
                target, themeValue.focusRailResource(),
                -40, -76, 45, -75) ||
            !pushQuad(
                target, themeValue.focusRailResource(),
                -40, 43, 45, 44) ||
            !pushQuad(
                target, themeValue.focusRailResource(),
                -40, -76, -39, 44) ||
            !pushQuad(
                target, themeValue.focusRailResource(),
                44, -76, 45, 44) ||
            !pushText(target, "LEVEL VIEW", -37, 39, 1, accentTextColor())) {
            return false
        }
        for (var grid = 0; grid <= 8; grid = grid + 1) {
            var x = -34 + grid * 9
            var z = -68 + grid * 13
            if (!pushQuad(
                    target, kookieUiNativeResourceFocus(),
                    x, -67, x + 1, 37) ||
                !pushQuad(
                    target, kookieUiNativeResourceFocus(),
                    -34, z, 36, z + 1)) {
                return false
            }
        }
        for (var index = 0; index < levelEditorValue.nodeCount(); index = index + 1) {
            var nodeX = levelEditorValue.nodeX(index)
            var nodeZ = levelEditorValue.nodeZ(index)
            var markerX = -34 + nodeX / 25
            var groundY = -66 + nodeZ / 20
            var heightOffset =
                levelEditorValue.document().nodeYValue(index) / 25
            var markerY = groundY + heightOffset
            var halfX = levelEditorValue.document().nodeScaleXValue(index) / 500
            var halfY = levelEditorValue.document().nodeScaleZValue(index) / 500
            if (halfX < 1) { halfX = 1 }
            if (halfX > 8) { halfX = 8 }
            if (halfY < 1) { halfY = 1 }
            if (halfY > 8) { halfY = 8 }
            var left = markerX - halfX
            var right = markerX + halfX + 1
            var bottom = markerY - halfY
            var top = markerY + halfY + 1
            if (left < -39) { left = -39 }
            if (right > 44) { right = 44 }
            if (bottom < -75) { bottom = -75 }
            if (top > 43) { top = 43 }
            if (left < right && bottom < top) {
                var selected = levelEditorValue.nodeId(index) ==
                    levelEditorValue.selectedNode()
                var color = levelEditorValue.document().nodeColorValue(index)
                var marker = kookieUiNativeResourceMuted()
                if (color == 16711615) {
                    marker = kookieUiNativeResourceDanger()
                } else if (color == 16776960) {
                    marker = kookieUiNativeResourceSuccess()
                }
                if (selected) {
                    marker = themeValue.selectedPanelResource()
                }
                if (heightOffset != 0 && markerX > -39 && markerX < 44) {
                    var stemBottom = groundY
                    var stemTop = markerY
                    if (stemBottom > stemTop) {
                        var swap = stemBottom
                        stemBottom = stemTop
                        stemTop = swap
                    }
                    if (stemBottom < -75) { stemBottom = -75 }
                    if (stemTop > 43) { stemTop = 43 }
                    if (stemBottom < stemTop && !pushQuad(
                            target, themeValue.focusRailResource(),
                            markerX, stemBottom, markerX + 1, stemTop)) {
                        return false
                    }
                }
                if (!pushQuad(
                        target, marker, left, bottom, right, top)) {
                    return false
                }
                if (!editorScenePreviewValue.stageOverviewFootprint(
                        target, levelEditorValue.document(), index,
                        markerX, markerY, -39, -75, 44, 43)) {
                    return false
                }
                if (selected && markerX >= -39 && markerX <= 43 &&
                    markerY >= -75 && markerY <= 42) {
                    var fill = kookieUiNativeResourceMuted()
                    if (color == 16711615) {
                        fill = kookieUiNativeResourceDanger()
                    } else if (color == 16776960) {
                        fill = kookieUiNativeResourceSuccess()
                    }
                    if (!pushQuad(
                            target, fill, markerX, markerY,
                            markerX + 1, markerY + 1)) {
                        return false
                    }
                    var rotation = levelEditorValue.document().nodeRotationValue(index)
                    var direction = (rotation + 7500) / 15000
                    direction = direction % kutterScenePreviewRotationSteps()
                    if (direction < 0) {
                        direction = direction + kutterScenePreviewRotationSteps()
                    }
                    var facingX = editorScenePreviewValue.rotationSine(direction)
                    var facingY = editorScenePreviewValue.rotationCosine(direction)
                    var tipX = markerX + facingX * 5 / 1000
                    var tipY = markerY + facingY * 5 / 1000
                    var baseX = markerX + facingX / 1000
                    var baseY = markerY + facingY / 1000
                    var sideX = editorScenePreviewValue.rotationCosine(direction) * 2 / 1000
                    var sideY = -editorScenePreviewValue.rotationSine(direction) * 2 / 1000
                    var leftX = baseX + sideX
                    var leftY = baseY + sideY
                    var rightX = baseX - sideX
                    var rightY = baseY - sideY
                    if (tipX >= -39 && tipX <= 43 &&
                        tipY >= -75 && tipY <= 42 &&
                        leftX >= -39 && leftX <= 43 &&
                        leftY >= -75 && leftY <= 42 &&
                        rightX >= -39 && rightX <= 43 &&
                        rightY >= -75 && rightY <= 42 &&
                        !target.pushTriangle(
                            kookieUiNativeResourceForeground(),
                            tipX, tipY, leftX, leftY, rightX, rightY)) {
                        return false
                    }
                }
            }
        }
        return true
    }

    Bool stageKutterHierarchyAndInspector(FrameStaging target) {
        var pageCount = (levelEditorValue.nodeCount() + 3) / 4
        if (pageCount < 1) { pageCount = 1 }
        if (editorHierarchyPageValue >= pageCount) {
            editorHierarchyPageValue = pageCount - 1
        }
        if (!pushKutterDockPanel(
                target, editorInspectorLeftValue, -94, 89, 44, false) ||
            !pushQuad(
                target, themeValue.focusRailResource(),
                editorInspectorLeftValue - 1, -94,
                editorInspectorLeftValue, 44) ||
            !pushQuad(
                target, themeValue.selectedPanelResource(),
                editorInspectorLeftValue - 3, 0,
                editorInspectorLeftValue + 2, 1) ||
            !pushQuad(
                target, themeValue.selectedPanelResource(),
                editorInspectorLeftValue - 3, 2,
                editorInspectorLeftValue + 2, 3) ||
            !pushQuad(
                target, themeValue.selectedPanelResource(),
                editorInspectorLeftValue - 3, 4,
                editorInspectorLeftValue + 2, 5) ||
            !pushText(
                target, "HIERARCHY", 51, 39, 1,
                if (editorHierarchyKeyboardFocusValue)
                    selectedTextColor() else accentTextColor()) ||
            !pushText(target, "<", 69, 39, 1, mutedTextColor()) ||
            !pushNumber(
                target, editorHierarchyPageValue + 1, 73, 39, 1,
                mutedTextColor()) ||
            !pushText(target, "/", 76, 39, 1, mutedTextColor()) ||
            !pushNumber(target, pageCount, 79, 39, 1, mutedTextColor()) ||
            !pushText(target, ">", 85, 39, 1, mutedTextColor())) {
            return false
        }
        var firstNode = editorHierarchyPageValue * 4
        var visibleNodes = levelEditorValue.nodeCount() - firstNode
        if (visibleNodes > 4) { visibleNodes = 4 }
        for (var row = 0; row < visibleNodes; row = row + 1) {
            var index = firstNode + row
            var rowY = 28 - row * 12
            var color = normalTextColor()
            if (levelEditorValue.nodeId(index) ==
                levelEditorValue.selectedNode()) {
                color = selectedTextColor()
            }
            if (!pushText(
                    target, levelNodeLabel(index), 51, rowY, 1, color) ||
                !pushNumber(
                    target, levelEditorValue.nodeId(index),
                    75, rowY, 1, color)) {
                return false
            }
        }
        if (!pushQuad(
                target, themeValue.focusRailResource(),
                50, -14, 87, -13) ||
            !pushText(target, "INSPECTOR", 51, -20, 1, accentTextColor())) {
            return false
        }
        var selected = levelEditorValue.document().nodeIndex(
            levelEditorValue.selectedNode())
        if (selected < 0) {
            return pushText(target, "NO SELECTION", 51, -32, 1, mutedTextColor())
        }
        return pushText(target, "HEIGHT", 51, -32, 1, normalTextColor()) &&
            pushSignedNumber(
                target, levelEditorValue.document().nodeYValue(selected),
                78, -32, 1, mutedTextColor()) &&
            pushText(target, "ROT", 51, -42, 1, normalTextColor()) &&
            pushNumber(
                target, levelEditorValue.document().nodeRotationValue(selected),
                68, -42, 1, mutedTextColor()) &&
            pushText(target, scaleAxisLabel(), 51, -52, 1, normalTextColor()) &&
            pushText(target, "-", 67, -52, 1, mutedTextColor()) &&
            pushNumber(
                target, selectedScaleValue(selected),
                71, -52, 1, mutedTextColor()) &&
            pushText(target, "+", 78, -52, 1, mutedTextColor()) &&
            pushKutterDockPanel(target, 81, -56, 88, -47, false) &&
            pushText(target, "C", 83, -54, 1, accentTextColor()) &&
            pushKutterDockPanel(target, 50, -68, 68, -58, false) &&
            pushText(target, "DUP", 53, -66, 1, normalTextColor()) &&
            pushKutterDockPanel(target, 70, -68, 87, -58, false) &&
            pushText(target, "GROUP", 72, -66, 1, normalTextColor()) &&
            pushKutterDockPanel(target, 50, -84, 68, -74, false) &&
            pushText(target, "UNGROUP", 51, -82, 1, normalTextColor()) &&
            pushKutterDockPanel(target, 70, -84, 87, -74, false) &&
            pushText(target, "DELETE", 72, -82, 1, dangerTextColor())
    }

    String editorAssetKindLabel(Int kind) {
        if (kind == kutterGreyboxKindGround()) { return "GROUND" }
        if (kind == kutterGreyboxKindWall()) { return "WALL" }
        if (kind == kutterGreyboxKindDoorway()) { return "DOOR" }
        if (kind == kutterGreyboxKindStairs()) { return "STAIRS" }
        if (kind == kutterGreyboxKindRamp()) { return "RAMP" }
        if (kind == kutterGreyboxKindFence()) { return "FENCE" }
        if (kind == kutterGreyboxKindRailing()) { return "RAIL" }
        if (kind == kutterGreyboxKindLadder()) { return "LADDER" }
        if (kind == kutterGreyboxKindPillar()) { return "PILLAR" }
        if (kind == kutterGreyboxKindWindow()) { return "WINDOW" }
        if (kind == kutterGreyboxKindProp()) { return "PROP" }
        return "UNKNOWN"
    }

    Bool stageKutterAssetBrowser(FrameStaging target) {
        if (!greyboxCatalogValue.validate()) { return false }
        for (var row = 0; row < 10; row = row + 1) {
            var centerY = 35 - row * 13
            if (!pushKutterDockPanel(
                    target, -90, centerY - 5, -45, centerY + 5,
                    selectionValue == row)) {
                return false
            }
            if (row == 0) {
                if (!pushText(target, "TOOLS", -87, centerY - 3, 1,
                        selectedTextColor()) ||
                    !pushText(target, "PG", -66, centerY - 3, 1,
                        mutedTextColor()) ||
                    !pushNumber(target, editorAssetPageValue + 1, -52,
                        centerY - 3, 1, mutedTextColor())) {
                    return false
                }
            } else if (row <= 7) {
                var index = editorAssetPageValue * 7 + row - 1
                if (index < greyboxCatalogValue.count()) {
                    var color = if (index == editorAssetIndexValue)
                        selectedTextColor() else normalTextColor()
                    if (!pushNumber(target, index + 1, -87,
                            centerY - 3, 1, color) ||
                        !pushTextFitted(
                            target, editorAssetKindLabel(
                                greyboxCatalogValue.kind(index)),
                            -68, centerY - 3, 1, color, 22)) {
                        return false
                    }
                }
            } else if (row == 8) {
                if (!pushText(target, "PREVIOUS PAGE", -87,
                        centerY - 3, 1, normalTextColor())) {
                    return false
                }
            } else if (!pushText(
                    target, "NEXT PAGE", -87, centerY - 3, 1,
                    normalTextColor())) {
                return false
            }
        }
        return true
    }

    Bool stageKutterToolsPanel(FrameStaging target, Int normal) {
        for (var row = 0; row < 10; row = row + 1) {
            var centerY = 35 - row * 13
            if (!pushKutterDockPanel(
                    target, -90, centerY - 5, -45, centerY + 5,
                    selectionValue == row)) {
                return false
            }
        }
        return pushText(target, levelToolLabel(), -87, 32, 1,
                if (selectionValue == 0) selectedTextColor() else normal) &&
            pushText(target, "ASSET", -67, 32, 1,
                if (selectionValue == 0) selectedTextColor() else normal) &&
            pushNumber(target, editorAssetIndexValue + 1, -46, 32, 1,
                if (selectionValue == 0) selectedTextColor() else normal) &&
            pushText(target, "CURSOR X", -87, 19, 1,
                if (selectionValue == 1) selectedTextColor() else normal) &&
            pushSignedNumber(target, levelEditorValue.cursorX(), -57, 19, 1,
                if (selectionValue == 1) selectedTextColor() else normal) &&
            pushText(target, "CURSOR Z", -87, 6, 1,
                if (selectionValue == 2) selectedTextColor() else normal) &&
            pushSignedNumber(target, levelEditorValue.cursorZ(), -57, 6, 1,
                if (selectionValue == 2) selectedTextColor() else normal) &&
            pushText(target, "GRID", -87, -7, 1,
                if (selectionValue == 3) selectedTextColor() else normal) &&
            pushNumber(target, levelEditorValue.gridSize(), -57, -7, 1,
                if (selectionValue == 3) selectedTextColor() else normal) &&
            pushText(target, "PLACE TOOL", -87, -20, 1,
                if (selectionValue == 4) selectedTextColor() else normal) &&
            pushText(
                target,
                if (editorMoveArmedValue)
                    "MOVE ARMED: CLICK VIEW" else "MOVE / ROTATE",
                -87, -33, 1,
                if (selectionValue == 5) selectedTextColor() else normal) &&
            pushText(target, "UNDO", -87, -46, 1,
                if (selectionValue == 6) selectedTextColor() else normal) &&
            pushText(target, "REDO", -87, -59, 1,
                if (selectionValue == 7) selectedTextColor() else normal) &&
            pushText(target,
                if (levelEditorValue.previewActive())
                    "PREVIEW ON" else "PREVIEW OFF",
                -87, -72, 1,
                if (selectionValue == 8) selectedTextColor() else normal) &&
            pushText(target, "BACK", -87, -85, 1,
                if (selectionValue == 9) selectedTextColor() else normal) &&
            pushCenteredText(target,
                "HEIGHT/ROT/SCALE +/-; SCALE LABEL XYZ; C COLOR",
                -97, 1, mutedTextColor())
    }

    Bool stageKutterLevel(FrameStaging target) {
        var normal = normalTextColor()
        var issueColor = if (levelEditorValue.validLevel())
            successTextColor() else dangerTextColor()
        if (!pushScreenFrame(target) ||
            !pushCenteredText(target, "KUTTER LEVEL WORKSPACE",
                menuTitleBottom(), 2, accentTextColor()) ||
            !pushText(target, "GEN", -88, menuSubtitleBottom(), 1, normal) ||
            !pushNumber(target, levelEditorValue.generation(), -66,
                menuSubtitleBottom(), 1, mutedTextColor()) ||
            !pushText(target, "NODES", -25, menuSubtitleBottom(), 1, normal) ||
            !pushNumber(target, levelEditorValue.nodeCount(), -3,
                menuSubtitleBottom(), 1, mutedTextColor()) ||
            !pushText(target, "ISSUES", 22, menuSubtitleBottom(), 1, issueColor) ||
            !pushNumber(target, levelEditorValue.validationIssueCount(), 48,
                menuSubtitleBottom(), 1, issueColor) ||
            !pushKutterDockPanel(target, -92, -88, -43, 44, false) ||
            !stageKutterEditorViewport(target) ||
            !stageKutterHierarchyAndInspector(target)) {
            return false
        }
        if (editorAssetBrowserOpenValue) {
            return stageKutterAssetBrowser(target)
        }
        return stageKutterToolsPanel(target, normal)
    }

    Bool stageKutter(FrameStaging target) {
        var normal = normalTextColor()
        return pushScreenFrame(target) &&
            pushCenteredText(target, "KUTTER",
                menuTitleBottom(), 2, accentTextColor()) &&
            pushText(target, "GEN", -84, menuSubtitleBottom(), 1, normal) &&
            pushNumber(target, kutterValue.generation(), -62,
                menuSubtitleBottom(), 1, mutedTextColor()) &&
            pushSelectionPanel(target, 0, 38, 50) &&
            pushCenteredText(target,
                if (kutterValue.collisionVisible())
                    "COLLISION ON" else "COLLISION OFF",
                41, 1, if (selectionValue == 0) selectedTextColor() else normal) &&
            pushSelectionPanel(target, 1, 24, 36) &&
            pushCenteredText(target,
                if (kutterValue.aiVisible()) "AI VISIBLE" else "AI HIDDEN",
                27, 1, if (selectionValue == 1) selectedTextColor() else normal) &&
            pushSelectionPanel(target, 2, 10, 22) &&
            pushCenteredText(target, "LEVEL EDITOR", 13, 1,
                if (selectionValue == 2) selectedTextColor() else normal) &&
            pushSelectionPanel(target, 3, -4, 8) &&
            pushCenteredText(target, "ENTITY SPAWN", -1, 1,
                if (selectionValue == 3) selectedTextColor() else normal) &&
            pushSelectionPanel(target, 4, -18, -6) &&
            pushCenteredText(target, "ASSET BROWSER", -15, 1,
                if (selectionValue == 4) selectedTextColor() else normal) &&
            pushSelectionPanel(target, 5, -32, -20) &&
            pushCenteredText(target, "ENCOUNTER EDITOR", -29, 1,
                if (selectionValue == 5) selectedTextColor() else normal) &&
            pushSelectionPanel(target, 6, -46, -34) &&
            pushCenteredText(target, "ITEM WEAPON LOOT", -43, 1,
                if (selectionValue == 6) selectedTextColor() else normal) &&
            pushSelectionPanel(target, 7, -60, -48) &&
            pushCenteredText(target, "SKILL EDITOR", -57, 1,
                if (selectionValue == 7) selectedTextColor() else normal) &&
            pushSelectionPanel(target, 8, -74, -62) &&
            pushCenteredText(target,
                if (kutterValue.playActive())
                    "STOP PLAY" else "PLAY IN EDITOR",
                -71, 1, if (selectionValue == 8) selectedTextColor() else normal) &&
            pushSelectionPanel(target, 9, -88, -76) &&
            pushCenteredText(target, "BACK", -85, 1,
                if (selectionValue == 9) selectedTextColor() else normal) &&
            pushCenteredText(target, "LEFT UNDO RIGHT REDO", -97, 1,
                mutedTextColor())
    }

    Bool stage(FrameStaging target, Int frame) {
        if (target.vertexCapacity() < renderVertexCapacity() ||
            frame <= 0 || !target.begin(frame)) { return false }
        var staged = false
        if (screenValue == gameShellScreenMain()) {
            staged = stageMain(target)
        } else if (screenValue == gameShellScreenOptions()) {
            staged = stageOptions(target)
        } else if (screenValue == gameShellScreenAccessibility()) {
            staged = stageAccessibility(target)
        } else if (screenValue == gameShellScreenMultiplayer()) {
            staged = stageMultiplayer(target)
        } else if (screenValue == gameShellScreenKutter()) {
            staged = stageKutter(target)
        } else if (screenValue == gameShellScreenKutterLevel()) {
            staged = stageKutterLevel(target)
        }
        if (!staged) {
            target.discard()
            return false
        }
        return target.publish()
    }
}
