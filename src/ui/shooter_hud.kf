package ui

import core

class ShooterHud {
    Int healthValue
    Int maxHealthValue
    Int ammunitionValue
    Int maxAmmunitionValue
    Int enemiesValue
    Int tickValue
    Bool focusedValue
    Bool configuredValue
    Int scalePercentValue
    Int lastImpactSequenceValue
    Int damageFeedbackUntilTick
    Int hitFeedbackUntilTick
    Int killFeedbackUntilTick

    Int encounterRemainingValue
    Bool remoteConnectedValue
    Int remoteGenerationValue
    Int remoteStateSequenceValue
    Int inventoryItemsValue
    Int inventoryCapacityValue
    Bool equipmentReadyValue
    Int skillRankValue
    Int skillExperienceValue
    Int skillGoalValue
    Int worldLootCountValue
    Int worldLootRankValue
    Int eliteThreatsValue
    Int bossThreatsValue
    Int defeatedThreatKindValue
    Int kutterStatusValue
    Int kutterGenerationValue
    Int kutterDiagnosticValue
    Bool kutterCompatibleValue


    public constructor(Int maxHealth, Int maxAmmunition) {
        healthValue = 0
        maxHealthValue = maxHealth
        if (maxHealthValue <= 0) {
            maxHealthValue = 1
        }
        ammunitionValue = 0
        maxAmmunitionValue = maxAmmunition
        if (maxAmmunitionValue <= 0) {
            maxAmmunitionValue = 1
        }
        enemiesValue = 0
        tickValue = 0
        focusedValue = false
        configuredValue = false
        scalePercentValue = 100
        lastImpactSequenceValue = 0
        damageFeedbackUntilTick = -1
        hitFeedbackUntilTick = -1
        killFeedbackUntilTick = -1
        encounterRemainingValue = 0
        remoteConnectedValue = true
        remoteGenerationValue = 1
        remoteStateSequenceValue = 0
        inventoryItemsValue = 0
        inventoryCapacityValue = 1
        equipmentReadyValue = false
        skillRankValue = 0
        skillExperienceValue = 0
        skillGoalValue = 1
        worldLootCountValue = 0
        worldLootRankValue = 0
        eliteThreatsValue = 0
        bossThreatsValue = 0
        defeatedThreatKindValue = 0
        kutterStatusValue = 0
        kutterGenerationValue = 0
        kutterDiagnosticValue = 0
        kutterCompatibleValue = false


    }

    Bool update(
        Int health, Int ammunition,
        Int enemies, Int tick, Bool focused
    ) {
        if (health < 0 || health > maxHealthValue ||
            ammunition < 0 || ammunition > maxAmmunitionValue ||
            enemies < 0 || tick < 0) {
            return false
        }
        healthValue = health
        ammunitionValue = ammunition
        enemiesValue = enemies
        tickValue = tick
        focusedValue = focused
        configuredValue = true
        return true
    }
    Bool setScale(Int percent) {
        if (percent < 80 || percent > 120) { return false }
        scalePercentValue = percent
        return true
    }
    Int scaleCoordinate(Int value) {
        var scaled = value * scalePercentValue / 100
        if (scaled < -100) { return -100 }
        if (scaled > 100) { return 100 }
        return scaled
    }
    Bool updateEncounterReplication(
        Int activeEnemies, Int remainingBudget,
        Bool connected, Int generation, Int sequence
    ) {
        if (activeEnemies < 0 || activeEnemies > 32 ||
            remainingBudget < 0 || remainingBudget > 1000000 ||
            generation <= 0 || generation > 1000000 ||
            sequence <= remoteStateSequenceValue || sequence > 1000000) {
            return false
        }
        enemiesValue = activeEnemies
        encounterRemainingValue = remainingBudget
        remoteConnectedValue = connected
        remoteGenerationValue = generation
        remoteStateSequenceValue = sequence
        return true
    }
    Bool updateInventoryStatus(
        Int itemCount, Int itemCapacity, Bool equipped
    ) {
        if (itemCount < 0 || itemCapacity <= 0 ||
            itemCapacity > 8 || itemCount > itemCapacity) {
            return false
        }
        inventoryItemsValue = itemCount
        inventoryCapacityValue = itemCapacity
        equipmentReadyValue = equipped
        return true
    }

    Bool updateSkillStatus(
        Int rank, Int experience, Int experienceGoal
    ) {
        if (rank < 0 || rank > 1000000 ||
            experience < 0 || experience > 1000000 ||
            experienceGoal <= 0 || experienceGoal > 1000000) {
            return false
        }
        skillRankValue = rank
        skillExperienceValue = experience
        skillGoalValue = experienceGoal
        return true
    }

    Bool updateWorldLootStatus(Int count, Int highestRank) {
        if (count < 0 || count > 8 ||
            (count == 0 && highestRank != 0) ||
            (count > 0 && (highestRank < 1 || highestRank > 3))) {
            return false
        }
        worldLootCountValue = count
        worldLootRankValue = highestRank
        return true
    }
    Bool updateThreatStatus(
        Int eliteCount, Int bossCount, Int defeatedKind
    ) {
        if (eliteCount < 0 || eliteCount > 32 ||
            bossCount < 0 || bossCount > 32 ||
            (defeatedKind != 0 &&
                defeatedKind != enemyDefinitionEliteKind() &&
                defeatedKind != enemyDefinitionBossKind())) {
            return false
        }
        eliteThreatsValue = eliteCount
        bossThreatsValue = bossCount
        defeatedThreatKindValue = defeatedKind
        return true
    }
    Bool updateKutterPublication(
        Int status, Int generation, Int diagnostic, Bool compatible
    ) {
        if (status < 0 || status > 4 ||
            generation < 0 || generation > 1000000 ||
            diagnostic < 0 || diagnostic > 10 ||
            (status == 0 &&
                (generation != 0 || diagnostic != 0 || compatible)) ||
            ((status == 1 || status == 2) &&
                (diagnostic != 0 || compatible)) ||
            (status == 3 &&
                (generation <= 0 || diagnostic != 0 || !compatible)) ||
            (status == 4 && (diagnostic <= 0 || compatible))) {
            return false
        }
        kutterStatusValue = status
        kutterGenerationValue = generation
        kutterDiagnosticValue = diagnostic
        kutterCompatibleValue = compatible
        return true
    }



    Bool presentImpact(
        Int localActorId, ImpactPresentationEvent impact, Int tick
    ) {
        if (localActorId <= 0 || tick < 0 ||
            impact.sequence() <= lastImpactSequenceValue) {
            return false
        }
        lastImpactSequenceValue = impact.sequence()
        if (impact.kind() == 1 && impact.applied() > 0) {
            if (impact.targetId() == localActorId) {
                damageFeedbackUntilTick = tick + 10
            }
            if (impact.sourceId() == localActorId) {
                hitFeedbackUntilTick = tick + 6
                if (impact.died()) {
                    killFeedbackUntilTick = tick + 15
                }
            }
        }
        return true
    }


    Int renderVertexCount() {
        return 372
    }


    Bool pushQuad(
        FrameStaging target, Int resource,
        Int left, Int bottom, Int right, Int top
    ) {
        var safeLeft = scaleCoordinate(left)
        var safeBottom = scaleCoordinate(bottom)
        var safeRight = scaleCoordinate(right)
        var safeTop = scaleCoordinate(top)
        return target.pushVertex(resource, safeLeft, safeBottom, 0, 100) &&
            target.pushVertex(resource, safeRight, safeBottom, 100, 100) &&
            target.pushVertex(resource, safeRight, safeTop, 100, 0) &&
            target.pushVertex(resource, safeLeft, safeBottom, 0, 100) &&
            target.pushVertex(resource, safeRight, safeTop, 100, 0) &&
            target.pushVertex(resource, safeLeft, safeTop, 0, 0)
    }
    Bool pushTriangle(
        FrameStaging target, Int resource,
        Int ax, Int ay, Int bx, Int by, Int cx, Int cy
    ) {
        return target.pushVertex(
                resource, scaleCoordinate(ax), scaleCoordinate(ay), 50, 0) &&
            target.pushVertex(
                resource, scaleCoordinate(bx), scaleCoordinate(by), 100, 50) &&
            target.pushVertex(
                resource, scaleCoordinate(cx), scaleCoordinate(cy), 50, 100)
    }

    Bool pushVitalPanels(
        FrameStaging target, Int resourceBase,
        Int healthRight, Int ammunitionRight,
        Int healthResource, Int ammunitionResource
    ) {
        return pushQuad(target, resourceBase, -98, -98, -20, -70) &&
            pushQuad(target, resourceBase + 1, -96, -96, -22, -72) &&
            pushQuad(target, resourceBase + 2, -82, -91, -28, -81) &&
            pushQuad(target, healthResource, -82, -91, healthRight, -81) &&
            pushQuad(target, resourceBase + 7, -92, -92, -88, -80) &&
            pushQuad(target, resourceBase + 7, -96, -88, -84, -84) &&
            pushQuad(target, resourceBase, 20, -98, 98, -70) &&
            pushQuad(target, resourceBase + 1, 22, -96, 96, -72) &&
            pushQuad(target, resourceBase + 2, 28, -91, 82, -81) &&
            pushQuad(target, ammunitionResource, 28, -91, ammunitionRight, -81) &&
            pushQuad(target, ammunitionResource, 85, -92, 87, -81) &&
            pushQuad(target, ammunitionResource, 89, -92, 91, -81) &&
            pushQuad(target, ammunitionResource, 93, -92, 95, -81)
    }

    Bool pushCrosshair(
        FrameStaging target, Int resource,
        Int gap, Int reach, Int thickness
    ) {
        return pushQuad(target, resource, -reach, -thickness, -gap, thickness) &&
            pushQuad(target, resource, gap, -thickness, reach, thickness) &&
            pushQuad(target, resource, -thickness, -reach, thickness, -gap) &&
            pushQuad(target, resource, -thickness, gap, thickness, reach)
    }
    Bool pushDiamond(
        FrameStaging target, Int resource,
        Int centerX, Int centerY, Int radius
    ) {
        return pushTriangle(target, resource,
                centerX, centerY + radius,
                centerX + radius, centerY,
                centerX, centerY - radius) &&
            pushTriangle(target, resource,
                centerX, centerY + radius,
                centerX, centerY - radius,
                centerX - radius, centerY)
    }

    Bool pushBuildStatus(FrameStaging target, Int resourceBase) {
        var inventoryRight = -14 +
            (inventoryItemsValue * 28) / inventoryCapacityValue
        var inventoryResource = resourceBase + 5
        if (inventoryItemsValue == inventoryCapacityValue) {
            inventoryResource = resourceBase + 3
        }
        var experience = skillExperienceValue
        if (experience > skillGoalValue) {
            experience = skillGoalValue
        }
        var skillRight = -14 + (experience * 28) / skillGoalValue

        var bladeRight = -10
        var guardLeft = -10
        var guardRight = -10
        if (equipmentReadyValue) {
            bladeRight = -8
            guardLeft = -12
            guardRight = -6
        }

        var skillPipOneRight = -3
        var skillPipTwoRight = 0
        var skillPipThreeRight = 3
        if (skillRankValue >= 1) {
            skillPipOneRight = -1
        }
        if (skillRankValue >= 2) {
            skillPipTwoRight = 2
        }
        if (skillRankValue >= 3) {
            skillPipThreeRight = 5
        }

        var lootResource = resourceBase + 6
        if (worldLootRankValue == 2) {
            lootResource = resourceBase + 5
        } else if (worldLootRankValue == 3) {
            lootResource = resourceBase + 4
        }
        var lootRadius = 0
        if (worldLootCountValue > 0) {
            lootRadius = 3
        }
        var lootPipOneRight = 9
        var lootPipTwoRight = 12
        var lootPipThreeRight = 15
        if (worldLootRankValue >= 1) {
            lootPipOneRight = 11
        }
        if (worldLootRankValue >= 2) {
            lootPipTwoRight = 14
        }
        if (worldLootRankValue >= 3) {
            lootPipThreeRight = 17
        }

        return pushQuad(target, resourceBase, -18, -98, 18, -70) &&
            pushQuad(target, resourceBase + 1, -16, -96, 16, -72) &&
            pushQuad(target, resourceBase + 2, -14, -94, 14, -90) &&
            pushQuad(
                target, inventoryResource,
                -14, -94, inventoryRight, -90) &&
            pushQuad(target, resourceBase + 2, -14, -77, 14, -73) &&
            pushQuad(
                target, resourceBase + 6,
                -14, -77, skillRight, -73) &&
            pushQuad(
                target, resourceBase + 7,
                -10, -88, bladeRight, -80) &&
            pushQuad(
                target, resourceBase + 7,
                guardLeft, -85, guardRight, -83) &&
            pushQuad(
                target, resourceBase + 6,
                -3, -86, skillPipOneRight, -84) &&
            pushQuad(
                target, resourceBase + 6,
                0, -86, skillPipTwoRight, -84) &&
            pushQuad(
                target, resourceBase + 6,
                3, -86, skillPipThreeRight, -84) &&
            pushDiamond(target, lootResource, 12, -84, lootRadius) &&
            pushQuad(
                target, lootResource,
                9, -89, lootPipOneRight, -88) &&
            pushQuad(
                target, lootResource,
                12, -89, lootPipTwoRight, -88) &&
            pushQuad(
                target, lootResource,
                15, -89, lootPipThreeRight, -88)
    }


    Bool pushEncounterStatus(
        FrameStaging target, Int resourceBase
    ) {
        var connectionResource = resourceBase + 6
        var connectionLeft = -36
        var connectionBottom = 88
        var connectionRight = -32
        var connectionTop = 96
        if (!remoteConnectedValue) {
            connectionResource = resourceBase + 4
            connectionLeft = -38
            connectionBottom = 90
            connectionRight = -30
            connectionTop = 94
        }
        var loadRight = -22
        var encounterTotal = enemiesValue + encounterRemainingValue
        if (encounterTotal > 0) {
            loadRight = -22 + (enemiesValue * 50) / encounterTotal
        }
        var reserveResource = resourceBase + 3
        var reserveLeft = 32
        var reserveBottom = 91
        var reserveRight = 38
        var reserveTop = 93
        if (encounterRemainingValue > 0) {
            reserveResource = resourceBase + 5
            reserveLeft = 33
            reserveBottom = 88
            reserveRight = 37
            reserveTop = 96
        }
        return pushQuad(target, resourceBase, -42, 84, 42, 98) &&
            pushQuad(target, resourceBase + 1, -40, 86, 40, 96) &&
            pushQuad(
                target, connectionResource,
                connectionLeft, connectionBottom,
                connectionRight, connectionTop) &&
            pushQuad(target, resourceBase + 2, -22, 89, 28, 95) &&
            pushQuad(target, resourceBase + 3, -22, 89, loadRight, 95) &&
            pushQuad(
                target, reserveResource,
                reserveLeft, reserveBottom, reserveRight, reserveTop)
    }
    Bool pushKutterPublicationCap(
        FrameStaging target, Int resource, Bool visible
    ) {
        if (!visible) {
            return pushQuad(target, resource, 0, 0, 0, 0)
        }
        if (kutterGenerationValue >= 3) {
            return pushQuad(target, resource, -64, 75, -58, 77)
        }
        if (kutterGenerationValue >= 2) {
            return pushQuad(target, resource, -63, 75, -59, 77)
        }
        return pushQuad(target, resource, -62, 75, -60, 77)
    }

    Bool pushKutterPublicationPanel(
        FrameStaging target, Int resourceBase
    ) {
        if (kutterStatusValue <= 0) {
            return pushQuad(target, resourceBase, 0, 0, 0, 0) &&
                pushQuad(target, resourceBase + 1, 0, 0, 0, 0)
        }
        return pushQuad(target, resourceBase, -96, 66, -26, 80) &&
            pushQuad(target, resourceBase + 1, -94, 68, -28, 78)
    }

    Bool pushKutterPublicationSource(
        FrameStaging target, Int resourceBase
    ) {
        if (kutterStatusValue < 1) {
            return pushQuad(target, resourceBase + 5, 0, 0, 0, 0)
        }
        return pushQuad(target, resourceBase + 5, -91, 70, -87, 76)
    }

    Bool pushKutterPublicationValidation(
        FrameStaging target, Int resourceBase
    ) {
        var resource = resourceBase + 4
        if (kutterStatusValue == 3) {
            resource = resourceBase + 6
        } else if (kutterStatusValue == 4) {
            resource = resourceBase + 3
        }
        var reached = kutterStatusValue >= 2 && kutterStatusValue <= 3
        if (kutterStatusValue == 4 && kutterDiagnosticValue >= 5) {
            reached = true
        }
        if (!reached) {
            return pushQuad(target, resource, 0, 0, 0, 0) &&
                pushDiamond(target, resource, -79, 73, 0)
        }
        return pushQuad(target, resource, -87, 72, -80, 74) &&
            pushDiamond(target, resource, -79, 73, 4)
    }

    Bool pushKutterPublicationProduct(
        FrameStaging target, Int resourceBase
    ) {
        var resource = resourceBase + 6
        if (kutterStatusValue == 4) {
            resource = resourceBase + 3
        }
        var reached = kutterStatusValue == 3
        if (kutterStatusValue == 4 && kutterDiagnosticValue >= 9) {
            reached = true
        }
        if (!reached) {
            return pushQuad(target, resource, 0, 0, 0, 0) &&
                pushQuad(target, resource, 0, 0, 0, 0) &&
                pushKutterPublicationCap(target, resource, false)
        }
        return pushQuad(target, resource, -72, 72, -67, 74) &&
            pushQuad(target, resource, -66, 70, -56, 75) &&
            pushKutterPublicationCap(target, resource, true)
    }

    Bool pushKutterPublicationResult(
        FrameStaging target, Int resourceBase
    ) {
        if (kutterStatusValue == 3 && kutterCompatibleValue) {
            return pushQuad(target, resourceBase + 6, -48, 72, -34, 74) &&
                pushQuad(target, resourceBase + 6, -42, 68, -40, 78)
        }
        if (kutterStatusValue == 4) {
            return pushQuad(target, resourceBase + 3, -42, 70, -40, 77) &&
                pushQuad(target, resourceBase + 3, -42, 67, -40, 69)
        }
        return pushQuad(target, resourceBase + 6, 0, 0, 0, 0) &&
            pushQuad(target, resourceBase + 6, 0, 0, 0, 0)
    }

    Bool pushKutterPublicationStatus(
        FrameStaging target, Int resourceBase
    ) {
        return pushKutterPublicationPanel(target, resourceBase) &&
            pushKutterPublicationSource(target, resourceBase) &&
            pushKutterPublicationValidation(target, resourceBase) &&
            pushKutterPublicationProduct(target, resourceBase) &&
            pushKutterPublicationResult(target, resourceBase)
    }

    Bool threatVisible() {
        return eliteThreatsValue > 0 || bossThreatsValue > 0 ||
            defeatedThreatKindValue > 0
    }

    Bool pushThreatPanel(FrameStaging target, Int resourceBase) {
        if (!threatVisible()) {
            return pushQuad(target, resourceBase, 0, 0, 0, 0) &&
                pushQuad(target, resourceBase + 1, 0, 0, 0, 0)
        }
        return pushQuad(target, resourceBase, -26, 66, 26, 80) &&
            pushQuad(target, resourceBase + 1, -24, 68, 24, 78)
    }

    Bool pushEliteThreatShape(FrameStaging target, Int resourceBase) {
        var resource = resourceBase + 5
        if (defeatedThreatKindValue == enemyDefinitionEliteKind()) {
            resource = resourceBase + 3
        }
        if (eliteThreatsValue > 0 ||
            defeatedThreatKindValue == enemyDefinitionEliteKind()) {
            return pushDiamond(target, resource, -14, 73, 4)
        }
        return pushDiamond(target, resource, -14, 73, 0)
    }

    Bool pushBossThreatShape(FrameStaging target, Int resourceBase) {
        var resource = resourceBase + 4
        if (defeatedThreatKindValue == enemyDefinitionBossKind()) {
            resource = resourceBase + 3
        }
        if (bossThreatsValue <= 0 &&
            defeatedThreatKindValue != enemyDefinitionBossKind()) {
            return pushQuad(target, resource, 0, 0, 0, 0) &&
                pushQuad(target, resource, 0, 0, 0, 0) &&
                pushQuad(target, resource, 0, 0, 0, 0)
        }
        return pushQuad(target, resource, 10, 69, 18, 72) &&
            pushQuad(target, resource, 10, 72, 13, 78) &&
            pushQuad(target, resource, 15, 72, 18, 78)
    }

    Bool pushThreatPips(FrameStaging target, Int resourceBase) {
        var eliteRight = -22
        if (eliteThreatsValue >= 3) {
            eliteRight = -16
        } else if (eliteThreatsValue == 2) {
            eliteRight = -18
        } else if (eliteThreatsValue == 1) {
            eliteRight = -20
        }
        var bossLeft = 22
        if (bossThreatsValue >= 3) {
            bossLeft = 16
        } else if (bossThreatsValue == 2) {
            bossLeft = 18
        } else if (bossThreatsValue == 1) {
            bossLeft = 20
        }
        var eliteResource = resourceBase + 5
        if (defeatedThreatKindValue == enemyDefinitionEliteKind()) {
            eliteResource = resourceBase + 3
        }
        var bossResource = resourceBase + 4
        if (defeatedThreatKindValue == enemyDefinitionBossKind()) {
            bossResource = resourceBase + 3
        }
        return pushQuad(
                target, eliteResource, -22, 68, eliteRight, 70) &&
            pushQuad(target, bossResource, bossLeft, 77, 22, 79)
    }

    Bool pushThreatStatus(
        FrameStaging target, Int resourceBase
    ) {
        return pushThreatPanel(target, resourceBase) &&
            pushEliteThreatShape(target, resourceBase) &&
            pushBossThreatShape(target, resourceBase) &&
            pushThreatPips(target, resourceBase)
    }

    Bool pushCombatFeedback(FrameStaging target, Int resourceBase) {
        var damageLeftRight = -100
        var damageRightLeft = 100
        if (damageFeedbackActive()) {
            damageLeftRight = -96
            damageRightLeft = 96
        }
        var markerResource = resourceBase + 7
        var markerGap = 0
        var markerReach = 0
        var markerThickness = 0
        if (hitFeedbackActive()) {
            markerGap = 11
            markerReach = 18
            markerThickness = 1
        }
        if (killFeedbackActive()) {
            markerResource = resourceBase + 4
            markerGap = 10
            markerReach = 24
            markerThickness = 2
        }
        return pushQuad(
                target, resourceBase + 3,
                -100, -48, damageLeftRight, 48) &&
            pushQuad(
                target, resourceBase + 3,
                damageRightLeft, -48, 100, 48) &&
            pushCrosshair(
                target, markerResource,
                markerGap, markerReach, markerThickness)
    }


    Bool stage(FrameStaging target, Int frame, Int resourceBase) {
        if (!configuredValue || resourceBase <= 0 ||
            target.vertexCapacity() < renderVertexCount() ||
            !target.begin(frame)) {
            return false
        }
        var healthRight = -82 +
            (healthValue * 54) / maxHealthValue
        var ammunitionRight = 28 +
            (ammunitionValue * 54) / maxAmmunitionValue
        var healthResource = resourceBase + 3
        if (healthValue * 4 <= maxHealthValue) {
            healthResource = resourceBase + 4
        }
        var ammunitionResource = resourceBase + 5
        if (ammunitionValue * 4 <= maxAmmunitionValue) {
            ammunitionResource = resourceBase + 4
        }
        var crosshairResource = resourceBase + 7
        var crosshairGap = 3
        var crosshairReach = 9
        var crosshairThickness = 1
        if (!focusedValue) {
            crosshairResource = resourceBase + 4
            crosshairGap = 7
            crosshairReach = 13
            crosshairThickness = 2
        }
        if (!pushVitalPanels(
                target, resourceBase, healthRight, ammunitionRight,
                healthResource, ammunitionResource) ||
            !pushCrosshair(
                target, crosshairResource,
                crosshairGap, crosshairReach, crosshairThickness) ||
            !pushEncounterStatus(target, resourceBase) ||
            !pushKutterPublicationStatus(target, resourceBase) ||
            !pushThreatStatus(target, resourceBase) ||
            !pushCombatFeedback(target, resourceBase) ||
            !pushBuildStatus(target, resourceBase)) {

            target.discard()
            return false
        }
        return target.publish()
    }

    Int health() {
        return healthValue
    }

    Int ammunition() {
        return ammunitionValue
    }

    Int enemies() {
        return enemiesValue
    }

    Int encounterRemaining() {
        return encounterRemainingValue
    }

    Bool remoteConnected() {
        return remoteConnectedValue
    }

    Int remoteGeneration() {
        return remoteGenerationValue
    }

    Int remoteStateSequence() {
        return remoteStateSequenceValue
    }

    Int tick() {
        return tickValue
    }

    Bool focused() {
        return focusedValue
    }
    Int scalePercent() {
        return scalePercentValue
    }

    Int lastImpactSequence() {
        return lastImpactSequenceValue
    }

    Bool damageFeedbackActive() {
        return tickValue <= damageFeedbackUntilTick
    }

    Bool hitFeedbackActive() {
        return tickValue <= hitFeedbackUntilTick
    }

    Bool killFeedbackActive() {
        return tickValue <= killFeedbackUntilTick
    }

    Int inventoryItems() {
        return inventoryItemsValue
    }

    Int inventoryCapacity() {
        return inventoryCapacityValue
    }

    Bool equipmentReady() {
        return equipmentReadyValue
    }

    Int skillRank() {
        return skillRankValue
    }

    Int skillExperience() {
        return skillExperienceValue
    }

    Int skillGoal() {
        return skillGoalValue
    }

    Int worldLootCount() {
        return worldLootCountValue
    }

    Int worldLootRank() {
        return worldLootRankValue
    }

    Int eliteThreats() {
        return eliteThreatsValue
    }

    Int bossThreats() {
        return bossThreatsValue
    }

    Int defeatedThreatKind() {
        return defeatedThreatKindValue
    }
    Int kutterStatus() {
        return kutterStatusValue
    }

    Int kutterGeneration() {
        return kutterGenerationValue
    }

    Int kutterDiagnostic() {
        return kutterDiagnosticValue
    }

    Bool kutterCompatible() {
        return kutterCompatibleValue
    }

}
