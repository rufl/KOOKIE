        if (!addModule(41002, 51002, kutterGreyboxKindProp(), kutterGreyboxCollisionSolid(), kutterGreyboxTexturePolicyFree(), 1, 1000, 1000, 1000, 1000, 1000, 1000, kutterGreyboxRuntimeReady())) { return false }
        if (!addModule(41003, 51003, kutterGreyboxKindProp(), kutterGreyboxCollisionDecorative(), kutterGreyboxTexturePolicyFree(), 1, 1000, 1000, 1000, 1000, 1000, 1000, kutterGreyboxRuntimeReady())) { return false }
