Int kutterGreyboxCollisionDecorative() { return 2 }
Int kutterGreyboxTexturePolicyDefault() { return 1 }
Int kutterGreyboxTexturePolicyFree() { return 2 }
Int kutterGreyboxRuntimeReady() { return 1 }
Int kutterGreyboxRuntimeMissing() { return 2 }
