        if (!addModule(41067, 51067, kutterGreyboxKindWall(), kutterGreyboxCollisionSolid(), kutterGreyboxTexturePolicyFree(), 1, 1000, 1000, 1000, 1000, 1000, 1000, kutterGreyboxRuntimeReady())) { return false }
