class BoundedKutterGreyboxCatalog {
    Int[] moduleIds
    Int[] assetTokens
    Int[] kinds
    Int[] collisionModes
    Int[] texturePolicies
    Int[] materialSlots
    Int[] snapX
    Int[] snapY
    Int[] snapZ
    Int[] boundsX
    Int[] boundsY
    Int[] boundsZ
    Int[] runtimeStatuses
    Int countValue

    public constructor(Int capacity) {
        var actualCapacity = capacity
        if (actualCapacity <= 0) { actualCapacity = 1 }
        if (actualCapacity > kutterGreyboxCatalogCapacity()) {
            actualCapacity = kutterGreyboxCatalogCapacity()
        }
        moduleIds = new Int[actualCapacity]
        assetTokens = new Int[actualCapacity]
        kinds = new Int[actualCapacity]
        collisionModes = new Int[actualCapacity]
        texturePolicies = new Int[actualCapacity]
        materialSlots = new Int[actualCapacity]
        snapX = new Int[actualCapacity]
        snapY = new Int[actualCapacity]
        snapZ = new Int[actualCapacity]
        boundsX = new Int[actualCapacity]
        boundsY = new Int[actualCapacity]
        boundsZ = new Int[actualCapacity]
        runtimeStatuses = new Int[actualCapacity]
        clear()
    }

    Bool clear() {
        countValue = 0
        return true
    }

    Int moduleIndex(Int moduleId) {
        for (var index = 0; index < countValue; index = index + 1) {
            if (moduleIds[index] == moduleId) { return index }
        }
        return -1
    }

    Bool addModule(
        Int moduleId, Int assetToken, Int kind, Int collisionMode,
        Int texturePolicy, Int materialSlotCount,
        Int moduleSnapX, Int moduleSnapY, Int moduleSnapZ,
        Int moduleBoundsX, Int moduleBoundsY, Int moduleBoundsZ,
        Int runtimeStatus
    ) {
        if (countValue >= moduleIds.length || moduleId <= 0 ||
            assetToken <= 0 || kind <= 0 || kind > kutterGreyboxKindProp() ||
            collisionMode < kutterGreyboxCollisionSolid() ||
            collisionMode > kutterGreyboxCollisionDecorative() ||
            texturePolicy < kutterGreyboxTexturePolicyDefault() ||
            texturePolicy > kutterGreyboxTexturePolicyFree() ||
            materialSlotCount <= 0 || materialSlotCount > 4 ||
            moduleSnapX <= 0 || moduleSnapY <= 0 || moduleSnapZ <= 0 ||
            moduleBoundsX <= 0 || moduleBoundsY <= 0 || moduleBoundsZ <= 0 ||
            runtimeStatus < kutterGreyboxRuntimeReady() ||
            runtimeStatus > kutterGreyboxRuntimeMissing() ||
            moduleIndex(moduleId) >= 0 ||
            (countValue > 0 && moduleId <= moduleIds[countValue - 1])) {
            return false
        }
        moduleIds[countValue] = moduleId
        assetTokens[countValue] = assetToken
        kinds[countValue] = kind
        collisionModes[countValue] = collisionMode
        texturePolicies[countValue] = texturePolicy
        materialSlots[countValue] = materialSlotCount
        snapX[countValue] = moduleSnapX
        snapY[countValue] = moduleSnapY
        snapZ[countValue] = moduleSnapZ
        boundsX[countValue] = moduleBoundsX
        boundsY[countValue] = moduleBoundsY
        boundsZ[countValue] = moduleBoundsZ
        runtimeStatuses[countValue] = runtimeStatus
        countValue = countValue + 1
        return true
    }

