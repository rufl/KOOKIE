package ui

import core
import session

class MultiplayerScoreboard {
    Bool visibleValue

    public constructor() {
        visibleValue = false
    }

    Bool visible() { return visibleValue }
    Bool setVisible(Bool visible) {
        visibleValue = visible
        return true
    }
    Bool toggle() {
        visibleValue = !visibleValue
        return visibleValue
    }
    Int renderVertexCapacity() { return 900 }

    Int glyph(Char value) {
        if (value >= 'A' && value <= 'Z') {
            return (value as Int) - ('A' as Int) + 1
        }
        if (value >= '0' && value <= '9') {
            return (value as Int) - ('0' as Int) + 27
        }
        if (value == '.') { return 37 }
        if (value == ':') { return 38 }
        if (value == '-') { return 39 }
        if (value == '/') { return 40 }
        if (value == '%') { return 41 }
        if (value == '>') { return 42 }
        if (value == '+') { return 43 }
        if (value == '?') { return 44 }
        return 0
    }

    Int textResource(Int color, Int glyphValue) {
        return 100 + color * 48 + glyphValue
    }

    Bool pushQuad(
        FrameStaging target, Int resource,
        Int left, Int bottom, Int right, Int top
    ) {
        return target.pushVertex(resource, left, bottom, 0, 100) &&
            target.pushVertex(resource, right, bottom, 100, 100) &&
            target.pushVertex(resource, right, top, 100, 0) &&
            target.pushVertex(resource, left, bottom, 0, 100) &&
            target.pushVertex(resource, right, top, 100, 0) &&
            target.pushVertex(resource, left, top, 0, 0)
    }

    Int textWidth(String text) {
        if (text.length() == 0) { return 0 }
        return text.length() * 6 - 1
    }

    Bool pushText(
        FrameStaging target, String text,
        Int left, Int bottom, Int color
    ) {
        if (color < 0 || color > 4) { return false }
        var x = left
        for (var index = 0; index < text.length(); index = index + 1) {
            var glyphValue = glyph(text.charAt(index))
            if (glyphValue > 0 &&
                !pushQuad(target, textResource(color, glyphValue),
                    x, bottom, x + 5, bottom + 7)) {
                return false
            }
            x = x + 6
        }
        return true
    }

    Bool pushCenteredText(
        FrameStaging target, String text, Int bottom, Int color
    ) {
        return pushText(target, text, -textWidth(text) / 2, bottom, color)
    }

    Int numberWidth(Int value) {
        var digits = 1
        var remaining = value
        while (remaining >= 10) {
            digits = digits + 1
            remaining = remaining / 10
        }
        return digits * 6 - 1
    }

    Bool pushNumber(
        FrameStaging target, Int value,
        Int left, Int bottom, Int color
    ) {
        if (value < 0) { return false }
        var divisor = 1
        while (value / divisor >= 10) { divisor = divisor * 10 }
        var x = left
        while (divisor > 0) {
            var digit = (value / divisor) % 10
            if (!pushQuad(target, textResource(color, 27 + digit),
                    x, bottom, x + 5, bottom + 7)) {
                return false
            }
            x = x + 6
            divisor = divisor / 10
        }
        return true
    }

    String playerName(Int nameId) {
        if (nameId == 2) { return "WADDLE" }
        if (nameId == 3) { return "HONK" }
        if (nameId == 4) { return "POND" }
        return "GOOSE"
    }

    String statusLabel(Int flags) {
        if ((flags & multiplayerScoreboardFlagConnected()) == 0) {
            return "LEFT"
        }
        if ((flags & multiplayerScoreboardFlagAlive()) == 0) {
            return "DOWN"
        }
        if ((flags & multiplayerScoreboardFlagReady()) != 0) {
            return "READY"
        }
        return "LIVE"
    }

    Int statusColor(Int flags) {
        if ((flags & multiplayerScoreboardFlagConnected()) == 0 ||
            (flags & multiplayerScoreboardFlagAlive()) == 0) {
            return 3
        }
        if ((flags & multiplayerScoreboardFlagReady()) != 0) {
            return 4
        }
        return 2
    }

    Bool pushHealth(
        FrameStaging target, MatchScoreboardState state,
        Int index, Int left, Int bottom, Int color
    ) {
        return pushNumber(target, state.healthAt(index), left, bottom, color) &&
            pushText(target, "/",
                left + numberWidth(state.healthAt(index)) + 2, bottom, color) &&
            pushNumber(target, state.maximumHealthAt(index),
                left + numberWidth(state.healthAt(index)) + 8, bottom, color)
    }

    Bool pushKillsDeaths(
        FrameStaging target, MatchScoreboardState state,
        Int index, Int left, Int bottom, Int color
    ) {
        return pushNumber(target, state.killsAt(index), left, bottom, color) &&
            pushText(target, "/",
                left + numberWidth(state.killsAt(index)) + 2, bottom, color) &&
            pushNumber(target, state.deathsAt(index),
                left + numberWidth(state.killsAt(index)) + 8, bottom, color)
    }

    Bool pushPing(
        FrameStaging target, MatchScoreboardState state,
        Int index, Int left, Int bottom, Int color
    ) {
        if (state.pingAt(index) == 0) {
            return pushText(target, "--", left, bottom, color)
        }
        return pushNumber(target, state.pingAt(index), left, bottom, color)
    }

    Bool pushRow(
        FrameStaging target, MatchScoreboardState state,
        Int index, Int bottom
    ) {
        var flags = state.flagsAt(index)
        var color = statusColor(flags)
        return pushQuad(target, 11, -88, bottom, 88, bottom + 24) &&
            pushQuad(target, 10, -86, bottom + 2, 86, bottom + 22) &&
            pushText(target, playerName(state.nameIdAt(index)),
                -82, bottom + 12,
                if ((flags & multiplayerScoreboardFlagHost()) != 0) 4 else 1) &&
            pushText(target, statusLabel(flags), -82, bottom + 3, color) &&
            pushNumber(target, state.scoreAt(index), -43, bottom + 12, 1) &&
            pushHealth(target, state, index, -3, bottom + 12, 1) &&
            pushKillsDeaths(target, state, index, 40, bottom + 12, 1) &&
            pushPing(target, state, index, 68, bottom + 12, color)
    }

    Bool stage(
        FrameStaging target, Int frame, MatchScoreboardState state
    ) {
        if (!visibleValue || frame <= 0 || !state.valid() ||
            target.vertexCapacity() < renderVertexCapacity() ||
            !target.begin(frame)) {
            return false
        }
        var staged = pushQuad(target, 10, -94, -72, 94, 72) &&
            pushQuad(target, 11, -92, -70, 92, 70) &&
            pushCenteredText(target, "SCOREBOARD", 55, 1) &&
            pushText(target, "PLAYER", -82, 35, 0) &&
            pushText(target, "SCORE", -43, 35, 0) &&
            pushText(target, "HP", -3, 35, 0) &&
            pushText(target, "K/D", 40, 35, 0) &&
            pushText(target, "PING", 65, 35, 0)
        if (staged && state.count() == 0) {
            staged = pushCenteredText(target, "NO PLAYERS", 4, 3)
        }
        for (var index = 0; staged && index < state.count(); index = index + 1) {
            staged = pushRow(target, state, index, 4 - index * 34)
        }
        if (staged) {
            staged = pushCenteredText(target, "TAB CLOSE", -62, 0)
        }
        if (!staged) {
            target.discard()
            return false
        }
        return target.publish()
    }
}
