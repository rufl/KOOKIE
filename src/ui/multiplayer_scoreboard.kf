package ui

import core
import session

class MultiplayerScoreboard {
    KookieUiNativeTheme themeValue
    Bool visibleValue

    public constructor() {
        themeValue = KookieUiNativeTheme()
        visibleValue = false
    }

    Bool visible() { return visibleValue }
    Bool setVisible(Bool visible) {
        visibleValue = visible
        return true
    }
    Bool toggle() {
        visibleValue = !visibleValue
        return visibleValue
    }
    Bool setHighContrast(Bool enabled) {
        return themeValue.setHighContrast(enabled)
    }

    Bool highContrast() {
        return themeValue.highContrast()
    }
    Int renderVertexCapacity() { return 900 }

    Bool pushQuad(
        FrameStaging target, Int resource,
        Int left, Int bottom, Int right, Int top
    ) {
        return kookieUiNativePushQuad(
            target, resource, left, bottom, right, top)
    }

    Int textWidth(String text) {
        return kookieUiNativeTextWidth(text, 1)
    }

    Bool pushText(
        FrameStaging target, String text,
        Int left, Int bottom, Int color
    ) {
        return kookieUiNativePushText(
            target, text, left, bottom, 1, color)
    }
    Bool pushCenteredText(
        FrameStaging target, String text, Int bottom, Int color
    ) {
        return pushText(
            target, text, -textWidth(text) / 2, bottom, color)
    }

    Int numberWidth(Int value) {
        var digits = 1
        var remaining = value
        while (remaining >= 10) {
            digits = digits + 1
            remaining = remaining / 10
        }
        return digits * uiFontGlyphAdvance() - 1
    }


    String digitText(Int digit) {
        if (digit == 0) { return "0" }
        if (digit == 1) { return "1" }
        if (digit == 2) { return "2" }
        if (digit == 3) { return "3" }
        if (digit == 4) { return "4" }
        if (digit == 5) { return "5" }
        if (digit == 6) { return "6" }
        if (digit == 7) { return "7" }
        if (digit == 8) { return "8" }
        if (digit == 9) { return "9" }
        return ""
    }

    Bool pushNumber(
        FrameStaging target, Int value,
        Int left, Int bottom, Int color
    ) {
        if (value < 0) { return false }
        var divisor = 1
        while (value / divisor >= 10) { divisor = divisor * 10 }
        var x = left
        while (divisor > 0) {
            var digit = (value / divisor) % 10
            if (!pushText(target, digitText(digit), x, bottom, color)) {
                return false
            }
            x = x + uiFontGlyphAdvance()
            divisor = divisor / 10
        }
        return true
    }

    String playerName(Int nameId) {
        if (nameId == 2) { return "WADDLE" }
        if (nameId == 3) { return "HONK" }
        if (nameId == 4) { return "POND" }
        return "GOOSE"
    }

    String statusLabel(Int flags) {
        if ((flags & multiplayerScoreboardFlagConnected()) == 0) {
            return "LEFT"
        }
        if ((flags & multiplayerScoreboardFlagAlive()) == 0) {
            return "DOWN"
        }
        if ((flags & multiplayerScoreboardFlagReady()) != 0) {
            return "READY"
        }
        return "LIVE"
    }

    Int statusColor(Int flags) {
        if ((flags & multiplayerScoreboardFlagConnected()) == 0 ||
            (flags & multiplayerScoreboardFlagAlive()) == 0) {
            return themeValue.dangerColor()
        }
        if ((flags & multiplayerScoreboardFlagReady()) != 0) {
            return themeValue.successColor()
        }
        return themeValue.mutedColor()
    }

    Bool pushHealth(
        FrameStaging target, MatchScoreboardState state,
        Int index, Int left, Int bottom, Int color
    ) {
        return pushNumber(target, state.healthAt(index), left, bottom, color) &&
            pushText(target, "/",
                left + numberWidth(state.healthAt(index)) + 2, bottom, color) &&
            pushNumber(target, state.maximumHealthAt(index),
                left + numberWidth(state.healthAt(index)) +
                    uiFontGlyphAdvance() + 1, bottom, color)
    }

    Bool pushKillsDeaths(
        FrameStaging target, MatchScoreboardState state,
        Int index, Int left, Int bottom, Int color
    ) {
        return pushNumber(target, state.killsAt(index), left, bottom, color) &&
            pushText(target, "/",
                left + numberWidth(state.killsAt(index)) + 2, bottom, color) &&
            pushNumber(target, state.deathsAt(index),
                left + numberWidth(state.killsAt(index)) +
                    uiFontGlyphAdvance() + 1, bottom, color)
    }

    Bool pushPing(
        FrameStaging target, MatchScoreboardState state,
        Int index, Int left, Int bottom, Int color
    ) {
        if (state.pingAt(index) == 0) {
            return pushText(target, "--", left, bottom, color)
        }
        return pushNumber(target, state.pingAt(index), left, bottom, color)
    }

    Bool pushRow(
        FrameStaging target, MatchScoreboardState state,
        Int index, Int bottom
    ) {
        var flags = state.flagsAt(index)
        var color = statusColor(flags)
        return pushQuad(
                target, kookieUiNativeResourceSurface(),
                -88, bottom, 88, bottom + 24) &&
            pushQuad(
                target, kookieUiNativeResourceBackground(),
                -86, bottom + 2, 86, bottom + 22) &&
            pushText(target, playerName(state.nameIdAt(index)),
                -82, bottom + 12,
                if ((flags & multiplayerScoreboardFlagHost()) != 0)
                    themeValue.successColor() else themeValue.accentColor()) &&
            pushText(target, statusLabel(flags), -82, bottom + 3, color) &&
            pushNumber(target, state.scoreAt(index), -43, bottom + 12, 1) &&
            pushHealth(target, state, index, -3, bottom + 12, 1) &&
            pushKillsDeaths(target, state, index, 40, bottom + 12, 1) &&
            pushPing(target, state, index, 68, bottom + 12, color)
    }

    Bool stage(
        FrameStaging target, Int frame, MatchScoreboardState state
    ) {
        if (!visibleValue || frame <= 0 || !state.valid() ||
            target.vertexCapacity() < renderVertexCapacity() ||
            !target.begin(frame)) {
            return false
        }
        var staged =
            pushQuad(
                target, kookieUiNativeResourceBackground(),
                -94, -72, 94, 72) &&
            pushQuad(
                target, kookieUiNativeResourceSurface(),
                -92, -70, 92, 70) &&
            pushCenteredText(
                target, "SCOREBOARD", 55, themeValue.accentColor()) &&
            pushText(
                target, "PLAYER", -82, 35, themeValue.mutedColor()) &&
            pushText(
                target, "SCORE", -43, 35, themeValue.mutedColor()) &&
            pushText(
                target, "HP", -3, 35, themeValue.mutedColor()) &&
            pushText(
                target, "K/D", 40, 35, themeValue.mutedColor()) &&
            pushText(
                target, "PING", 65, 35, themeValue.mutedColor())
        if (staged && state.count() == 0) {
            staged = pushCenteredText(target, "NO PLAYERS", 4, 3)
        }
        for (var index = 0; staged && index < state.count(); index = index + 1) {
            staged = pushRow(target, state, index, 4 - index * 34)
        }
        if (staged) {
            staged = pushCenteredText(
                target, "TAB CLOSE", -62, themeValue.mutedColor())
        }
        if (!staged) {
            target.discard()
            return false
        }
        return target.publish()
    }
}
