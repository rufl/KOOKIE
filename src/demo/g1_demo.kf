package demo

import content
import session
import world
import ui

class G1Demo {
    G1Arena arena
    CameraState camera
    BoundedG3Config g3Config
    Bool g3ConfigLoadedValue
    LoopbackSession loopback
    ShooterHud hud
    FrameStaging worldFrame
    FrameStaging hudFrame
    Int failureStepValue
    Int worldCapacityValue
    Int hudCapacityValue
    Int worldChecksumValue
    Int hudChecksumValue

    public constructor() {
        g3Config = BoundedG3Config()
        g3ConfigLoadedValue = g3Config.load("config/g3/demo.json")
        loopback = LoopbackSession(
            g3Config.value("sessionEnemyCapacity"),
            g3Config.value("sessionPlayerCapacity"))
        arena = G1Arena()
        camera = CameraState(-450, 450)
        hud = ShooterHud(
            g3Config.value("playerActorHealth"),
            g3Config.value("playerWeaponMagazineSize"))
        worldFrame = FrameStaging(arena.renderVertexCount())
        hudFrame = FrameStaging(hud.renderVertexCount())
        failureStepValue = 0
        worldCapacityValue = worldFrame.vertexCapacity()
        hudCapacityValue = hudFrame.vertexCapacity()
        worldChecksumValue = 0
        hudChecksumValue = 0
    }

    Bool failAt(Int step) {
        failureStepValue = step
        return false
    }

    Bool prepareSession() {
        if (!g3ConfigLoadedValue || !arena.ready() ||
            arena.vertexCount() != 142 ||
            arena.triangleCount() != 178 || arena.authoredChecksum() <= 0) {
            return failAt(1)
        }
        if (!loopback.loadAuthoredBroadPhase(arena.authoredCollision()) ||
            loopback.broadPhaseTriangleCount() != arena.triangleCount() ||
            loopback.broadPhaseTriangleCapacity() != arena.triangleCapacity()) {
            return failAt(2)
        }
        if (!loopback.configureEnemyRules(
                g3Config.value("enemyRuleActorCapacity"),
                g3Config.value("enemyRuleMaxDistance"),
                g3Config.value("enemyRuleMaxProjectiles")) ||
            !loopback.defineEnemyWeapon(
                g3Config.value("enemyWeaponId"),
                g3Config.value("enemyWeaponMagazineSize"),
                g3Config.value("enemyWeaponReserveCapacity"),
                g3Config.value("enemyWeaponDamage"),
                g3Config.value("enemyWeaponChannel")) ||
            !loopback.setEnemyWeaponRange(
                g3Config.value("enemyWeaponId"),
                g3Config.value("enemyWeaponRange")) ||
            !loopback.defineEnemyEncounter(
                g3Config.value("encounterId"),
                g3Config.value("encounterMaxActive"),
                g3Config.value("encounterBudget")) ||
            !loopback.addEnemyCombatActor(
                g3Config.value("enemyActorId"),
                g3Config.value("enemyActorHealth"),
                g3Config.value("enemyActorArmor")) ||
            !loopback.equipEnemyCombatWeapon(
                g3Config.value("enemyActorId"),
                g3Config.value("enemyWeaponId"))) {
            return failAt(3)
        }
        if (!loopback.registerExtensionManifest(
                g3Config.value("extensionNamespace"),
                g3Config.value("extensionOwner"),
                g3Config.value("extensionApiVersion"),
                g3Config.value("extensionSchemaVersion"),
                g3Config.value("extensionRole")) ||
            !loopback.configureExtensionLoadOrder(
                g3Config.value("extensionNamespace"),
                g3Config.value("extensionOwner"),
                g3Config.value("extensionLoadOrder")) ||
            !loopback.configureExtensionProvenance(
                g3Config.value("extensionNamespace"),
                g3Config.value("extensionOwner"),
                g3Config.value("extensionProvenance")) ||
            !loopback.configureExtensionSchemas(
                g3Config.value("extensionNamespace"),
                g3Config.value("extensionOwner"),
                g3Config.value("extensionMigrationVersion"),
                g3Config.value("extensionNetworkSchema")) ||
            !loopback.grantExtensionCapability(
                g3Config.value("extensionNamespace"),
                g3Config.value("extensionOwner"),
                extensionContributionEnemyDefinitionKind()) ||
            !loopback.registerExtensionContribution(
                g3Config.value("extensionNamespace"),
                g3Config.value("extensionOwner"),
                extensionContributionEnemyDefinitionKind(),
                g3Config.value("enemyDefinitionId"),
                g3Config.value("enemyDefinitionPriority")) ||
            !loopback.defineEnemyDefinition(
                g3Config.value("extensionNamespace"),
                g3Config.value("extensionOwner"),
                g3Config.value("enemyDefinitionId"),
                g3Config.value("enemyDefinitionRevision"),
                g3Config.value("enemyKind")) ||
            !loopback.setEnemyDefinitionCombat(
                g3Config.value("extensionNamespace"),
                g3Config.value("enemyDefinitionId"),
                g3Config.value("enemyHealth"),
                g3Config.value("enemyArmor"),
                g3Config.value("enemyWeaponId")) ||
            !loopback.setEnemyDefinitionBehavior(
                g3Config.value("extensionNamespace"),
                g3Config.value("enemyDefinitionId"),
                g3Config.value("enemyRole"),
                g3Config.value("enemyMoveStep"),
                g3Config.value("enemyProjectileStep")) ||
            !loopback.setEnemyDefinitionCritical(
                g3Config.value("extensionNamespace"),
                g3Config.value("enemyDefinitionId"),
                g3Config.value("enemyCritical")) ||
            !loopback.setEnemyDefinitionLoot(
                g3Config.value("extensionNamespace"),
                g3Config.value("enemyDefinitionId"),
                g3Config.value("enemyLootStableBase"),
                g3Config.value("enemyLootSeedSalt"),
                g3Config.value("enemyLootLevel")) ||
            !loopback.setEnemyDefinitionRankCurrency(
                g3Config.value("extensionNamespace"),
                g3Config.value("enemyDefinitionId"),
                g3Config.value("enemyLootRank"),
                g3Config.value("enemyCurrency")) ||
            !loopback.setEnemyDefinitionProgression(
                g3Config.value("extensionNamespace"),
                g3Config.value("enemyDefinitionId"),
                g3Config.value("enemySkillId"),
                g3Config.value("enemyExperience"))) {
            return failAt(4)
        }
        if (!loopback.definePlayerWeapon(
                g3Config.value("playerWeaponId"),
                g3Config.value("playerWeaponMagazineSize"),
                g3Config.value("playerWeaponReserveCapacity"),
                g3Config.value("playerWeaponDamage"),
                g3Config.value("playerWeaponChannel")) ||
            !loopback.setPlayerWeaponRange(
                g3Config.value("playerWeaponId"),
                g3Config.value("playerWeaponRange")) ||
            !loopback.start() || loopback.connectPlayer() != 1 ||
            loopback.connectPlayer() != 2 || loopback.playerCount() != 2) {
            return failAt(5)
        }
        if (!loopback.defineLootAffixPool(
                g3Config.value("affixPoolId")) ||
            !loopback.addLootAffix(
                g3Config.value("affixPoolId"),
                g3Config.value("affixId"),
                g3Config.value("affixWeight")) ||
            !loopback.defineLootAffixStat(
                g3Config.value("affixId"),
                g3Config.value("affixFlatValue"),
                g3Config.value("affixAdditivePercent"),
                g3Config.value("affixMultiplicativePercent")) ||
            !loopback.defineLootItem(
                g3Config.value("lootItemDefinitionId"),
                g3Config.value("lootItemBaseValue"),
                g3Config.value("lootItemMinimumLevel"),
                g3Config.value("lootItemMaximumLevel"),
                g3Config.value("lootItemAffixPool")) ||
            !loopback.addLootTableEntry(
                g3Config.value("lootItemDefinitionId"),
                g3Config.value("lootTableWeight")) ||
            !loopback.definePlayerSkill(
                g3Config.value("playerSkillId"),
                g3Config.value("playerSkillMaximumRank"),
                g3Config.value("playerSkillExperienceCost")) ||
            !loopback.setPlayerSkillDamagePercent(
                g3Config.value("playerSkillId"),
                g3Config.value("playerSkillDamagePercent")) ||
            !loopback.definePlayerStatus(
                g3Config.value("playerStatusId"),
                g3Config.value("playerStatusDurationCap"),
                g3Config.value("playerStatusStackCap")) ||
            !loopback.setPlayerStatusDamageModifier(
                g3Config.value("playerStatusId"),
                g3Config.value("playerStatusDamageFlat"),
                g3Config.value("playerStatusDamagePercent")) ||
            !loopback.setPlayerStatusDefenseModifier(
                g3Config.value("playerStatusId"),
                g3Config.value("playerStatusDefenseFlat"),
                g3Config.value("playerStatusDefensePercent")) ||
            !loopback.setPlayerStatusPeriodicDamage(
                g3Config.value("playerStatusId"),
                g3Config.value("playerStatusPeriodicDamage"),
                g3Config.value("playerStatusPeriodicChannel")) ||
            !loopback.learnPlayerSkill(
                g3Config.value("playerActorId"),
                g3Config.value("playerSkillId"))) {
            return failAt(6)
        }
        if (!loopback.addPlayerCombatActor(
                g3Config.value("playerActorId"),
                g3Config.value("playerActorHealth"),
                g3Config.value("playerActorArmor")) ||
            !loopback.equipPlayerCombatWeapon(
                g3Config.value("playerActorId"),
                g3Config.value("playerWeaponId")) ||
            !loopback.applyPlayerStatus(
                g3Config.value("playerActorId"),
                g3Config.value("playerStatusId"),
                g3Config.value("playerStatusDuration"),
                g3Config.value("playerStatusStacks")) ||
            !loopback.admitDefinedEnemy(
                g3Config.value("encounterId"),
                g3Config.value("admittedEnemyId"),
                g3Config.value("extensionNamespace"),
                g3Config.value("enemyDefinitionId")) ||
            loopback.enemyKind(g3Config.value("admittedEnemyId")) !=
                g3Config.value("enemyKind") ||
            !loopback.configureEnemyPerception(
                g3Config.value("admittedEnemyId"),
                g3Config.value("playerActorId"),
                g3Config.value("enemyPerceptionVisible") == 1,
                g3Config.value("enemyPerceptionDistance"),
                g3Config.value("enemyCritical"))) {
            return failAt(7)
        }
        if (!loopback.queueBroadPhaseSnapshot(0, 1) ||
            !loopback.receiveBroadPhaseSnapshot() ||
            loopback.clientBroadPhaseTriangleCount() != arena.triangleCount()) {
            return failAt(8)
        }
        var wallStart = SpatialPoint(140, 10, 20)
        var wallEnd = SpatialPoint(180, 10, 20)
        var clientWall = loopback.queryClientBroadPhasePath(
            loopback.clientBroadPhaseRevision(), wallStart, wallEnd)
        if (!clientWall.accepted() || !clientWall.collided()) {
            return failAt(9)
        }
        return true
    }

    Bool runAuthoritativeSession() {
        var playerId = g3Config.value("playerActorId")
        var secondaryPlayerId = g3Config.value("secondaryPlayerId")
        var enemyId = g3Config.value("admittedEnemyId")
        var encounterId = g3Config.value("encounterId")
        var skillId = g3Config.value("playerSkillId")
        if (!loopback.predictClientInput(playerId, 4) ||
            !loopback.applySnapshot(playerId, 0, 1, 0) ||
            loopback.predictedPosition(playerId) != 4 ||
            loopback.predictionCorrection(playerId) != 4 ||
            loopback.pendingPredictionInputs(playerId) != 1) {
            return failAt(10)
        }
        var firstCommand = InputCommand(1, 1, 3, 0, 0, 0, 1, 0)
        var secondCommand = InputCommand(1, 1, 2, 0, 0, 0, 0, 1)
        var staleCommand = InputCommand(1, 1, 4, 0, 0, 0, 1, 0)
        if (!loopback.receiveInputCommand(playerId, firstCommand) ||
            !loopback.receiveInputCommand(secondaryPlayerId, secondCommand) ||
            loopback.receiveInputCommand(playerId, staleCommand) ||
            loopback.advance(16667) != 1) {
            return failAt(11)
        }
        if (loopback.serverPosition(playerId) != 3 ||
            loopback.serverPosition(secondaryPlayerId) != 2 ||
            loopback.pendingPredictionInputs(playerId) != 0 ||
            !loopback.inSync()) {
            return failAt(12)
        }
        if (loopback.lastInputEdges(playerId).firePressed() != 1 ||
            loopback.playerWeaponPresentationCount() != 1 ||
            !loopback.dequeuePlayerWeaponPresentation() ||
            loopback.lastPlayerWeaponPresentation().actorId() != playerId) {
            return failAt(13)
        }
        var enemyHit = loopback.resolveEnemyHitscan(
            playerId, enemyId, 1,
            g3Config.value("playerAttackDistance"),
            g3Config.value("playerAttackCritical"))
        if (!enemyHit.accepted() || !enemyHit.died() ||
            loopback.enemyState(enemyId) != 7 ||
            loopback.enemyEncounterActiveCount(encounterId) != 0 ||
            loopback.pendingImpactPresentations() != 1 ||
            loopback.pendingImpactAudio() != 1 ||
            loopback.impactPresentationDrops() != 0 ||
            !loopback.dequeueImpactPresentation()) {
            return failAt(14)
        }
        if (loopback.playerCurrency(playerId) !=
                g3Config.value("enemyCurrency") ||
            loopback.playerSkillRank(playerId, skillId) < 1 ||
            loopback.worldLootCount() != 1 ||
            loopback.worldLootStableId(0) <= 0 ||
            loopback.worldLootRank(0) !=
                g3Config.value("enemyLootRank")) {
            return failAt(14)
        }
        var impact = loopback.lastImpactPresentation()
        var encounter = loopback.enemyEncounterStateMessage(
            loopback.currentServerTick(), encounterId)
        if (impact.sourceId() != playerId ||
            impact.targetId() != enemyId ||
            impact.applied() != enemyHit.applied() || !impact.died() ||
            impact.clip() <= 0 || impact.gain() <= 0 ||
            !hud.presentImpact(
                playerId, impact, loopback.currentClientTick()) ||
            !loopback.applyRemoteEnemyEncounterState(encounter) ||
            loopback.clientRemoteEnemyState(enemyId) != 7 ||
            loopback.clientRemoteEnemyHealth(enemyId) != 0 ||
            loopback.clientRemoteEncounterActiveCount() != 0 ||
            loopback.clientRemoteEncounterRemainingBudget() !=
                g3Config.value("encounterBudget") - 1) {
            return failAt(14)
        }
        return true
    }

    Bool verifyFocusRecovery() {
        var playerId = g3Config.value("playerActorId")
        var position = loopback.serverPosition(playerId)
        var pending = InputCommand(2, 2, 4, 0, 0, 0, 1, 0)
        if (!loopback.receiveInputCommand(playerId, pending) ||
            !loopback.applyPlayerFocus(playerId, 0) ||
            loopback.playerFocused(playerId) ||
            loopback.lastInputEdges(playerId).fireReleased() != 1) {
            return failAt(15)
        }
        var unfocused = InputCommand(3, 3, 4, 0, 0, 0, 1, 0)
        if (loopback.advance(16667) != 1 ||
            loopback.serverPosition(playerId) != position ||
            loopback.playerWeaponPresentationCount() != 0 ||
            loopback.receiveInputCommand(playerId, unfocused)) {
            return failAt(16)
        }
        var resumed = InputCommand(3, 3, 2, 0, 0, 0, 1, 0)
        if (!loopback.applyPlayerFocus(playerId, 1) ||
            !loopback.receiveInputCommand(playerId, resumed) ||
            loopback.advance(16667) != 1 ||
            loopback.serverPosition(playerId) != position + 2 ||
            loopback.playerWeaponPresentationCount() != 1 ||
            !loopback.inSync()) {
            return failAt(17)
        }
        return true
    }


    Bool verifyArenaContact() {
        var floorProbe = arena.queryPath(
            SpatialPoint(40, 5, 60), SpatialPoint(40, -2, 60))
        if (!floorProbe.accepted() || !floorProbe.collided() ||
            arena.lastHitSurface() != 6) {
            return failAt(18)
        }
        var wallProbe = arena.queryPath(
            SpatialPoint(140, 10, 20), SpatialPoint(180, 10, 20))
        if (!wallProbe.accepted() || !wallProbe.collided() ||
            arena.lastHitSurface() != 3) {
            return failAt(19)
        }
        var corridorProbe = arena.queryPath(
            SpatialPoint(140, 10, 140), SpatialPoint(180, 10, 140))
        if (!corridorProbe.accepted() || corridorProbe.collided()) {
            return failAt(20)
        }
        var pillarProbe = arena.queryPath(
            SpatialPoint(100, 6, 118), SpatialPoint(150, 6, 118))
        if (!pillarProbe.accepted() || !pillarProbe.collided() ||
            arena.lastHitSurface() != 2) {
            return failAt(21)
        }
        var skyProbe = arena.queryPath(
            SpatialPoint(40, 5, 60), SpatialPoint(40, 23, 60))
        if (!skyProbe.accepted() || skyProbe.collided()) {
            return failAt(22)
        }
        return true
    }

    Bool verifyPresentation() {
        if (!camera.applyLook(20, -20) ||
            camera.currentYaw() != 20 || camera.currentPitch() != -20) {
            return failAt(23)
        }
        var playerId = g3Config.value("playerActorId")
        var skillId = g3Config.value("playerSkillId")
        var enemyId = g3Config.value("admittedEnemyId")
        var health = loopback.playerCombatHealth(playerId)
        var ammunition = loopback.playerCombatMagazine(playerId)
        var enemies = loopback.clientRemoteEncounterActiveCount()
        var tick = loopback.currentClientTick()
        var focused = loopback.playerFocused(playerId)
        var inventory = loopback.playerInventory(playerId)
        var lootRank = 0
        if (loopback.worldLootCount() > 0) {
            lootRank = loopback.worldLootRank(0)
        }
        if (!hud.update(health, ammunition, enemies, tick, focused) ||
            !hud.updateEncounterReplication(
                enemies,
                loopback.clientRemoteEncounterRemainingBudget(),
                loopback.playerConnected(playerId),
                loopback.playerConnectionGeneration(playerId),
                loopback.clientRemoteEnemyEncounterSequence()) ||
            !hud.updateInventoryStatus(
                inventory.itemCount(), inventory.itemCapacity(),
                loopback.playerEquipmentItem(playerId, 0) > 0) ||
            !hud.updateSkillStatus(
                loopback.playerSkillRank(playerId, skillId),
                loopback.playerSkillExperience(playerId, skillId),
                g3Config.value("playerSkillExperienceCost")) ||
            !hud.updateWorldLootStatus(
                loopback.worldLootCount(), lootRank) ||
            !hud.updateThreatStatus(
                loopback.activeEnemyKindCount(enemyDefinitionEliteKind()),
                loopback.activeEnemyKindCount(enemyDefinitionBossKind()),
                loopback.enemyKind(enemyId))) {
            return failAt(24)
        }

        for (var frame = 1; frame <= 64; frame = frame + 1) {
            if (!arena.stage(worldFrame, frame, 1, camera) ||
                !hud.stage(hudFrame, frame, 9) ||
                worldFrame.stagedCount() != arena.renderVertexCount() ||
                hudFrame.stagedCount() != hud.renderVertexCount()) {
                return failAt(25)
            }
            if (frame == 1) {
                worldChecksumValue = worldFrame.checksum()
                hudChecksumValue = hudFrame.checksum()
            } else if (worldFrame.checksum() != worldChecksumValue ||
                hudFrame.checksum() != hudChecksumValue) {
                return failAt(26)
            }
            if (!worldFrame.retire(frame) || !hudFrame.retire(frame)) {
                return failAt(27)
            }
        }
        if (worldFrame.vertexCapacity() != worldCapacityValue ||
            hudFrame.vertexCapacity() != hudCapacityValue ||
            worldFrame.scalarBudget() != worldCapacityValue * 5 ||
            hudFrame.scalarBudget() != hudCapacityValue * 5) {
            return failAt(28)
        }
        return true
    }

    Bool run() {
        return prepareSession() && runAuthoritativeSession() &&
            verifyFocusRecovery() && verifyArenaContact() &&
            verifyPresentation()
    }

    Int failureStep() {
        return failureStepValue
    }

    G1Arena authoredArena() {
        return arena
    }

    ShooterHud shooterHud() {
        return hud
    }

    Bool dequeueCombatFeedbackAudio() {
        return loopback.dequeueImpactAudio()
    }

    Int combatFeedbackClip() {
        return loopback.consumedImpactClip()
    }

    Int combatFeedbackGain() {
        return loopback.consumedImpactGain()
    }

    Int combatFeedbackLeftGain() {
        return loopback.consumedImpactLeftGain()
    }

    Int combatFeedbackRightGain() {
        return loopback.consumedImpactRightGain()
    }
}
