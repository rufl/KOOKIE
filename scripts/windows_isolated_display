#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
powershell='/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe'
[[ -x "$powershell" ]] || {
  echo 'windows-isolated-display: Windows PowerShell 5 is required' >&2
  exit 2
}
MSYS_NO_PATHCONV=1 exec "$powershell" -NoLogo -NoProfile -NonInteractive \
  -ExecutionPolicy Bypass -File \
  "$(cygpath -w "$script_dir/windows_isolated_display.ps1")" "$@"
