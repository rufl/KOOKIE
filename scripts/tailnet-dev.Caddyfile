{
  admin off
  auto_https off
}

http://:{$KOOKIE_TAILNET_PORT} {
  bind {$KOOKIE_TAILNET_IP}
  @kutter_ws path /kutter/session
  handle @kutter_ws {
    rewrite * /session
    reverse_proxy 127.0.0.1:{$KOOKIE_KUTTER_PORT}
  }
  handle /bugfeed* {
    reverse_proxy 127.0.0.1:{$KOOKIE_BUGFEED_PORT}
  }
  @kof_backend path /session /session/goose /session/cat /spectate /healthz /metrics
  reverse_proxy @kof_backend 127.0.0.1:{$KOOKIE_WEB_PORT}

  root * {$KOOKIE_WEB_ALPHA_ROOT}
  @web_assets path / /index.html /kookie-session.js /kookie-webgl-renderer.js
  header @web_assets Cache-Control "no-cache"
  file_server
}
